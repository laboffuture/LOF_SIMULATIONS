<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Invisible UV Path Tracking Simulation</title>
    <link rel="icon" type="image/png" href="../../../assets/logo.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Orbitron:wght@600;700;800&family=Rajdhani:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <style>
      :root {
        --bg: #eef3fb;
        --panel: #ffffff;
        --panel2: #f3f8ff;
        --line: #dce6f5;
        --txt: #18233a;
        --mut: #5a6d8c;
        --dim: #95a7c4;
        --accent: #2563eb;
        --accent2: #38bdf8;
        --uv: #8b5cf6;
        --uv2: #c4b5fd;
        --warn: #f7a23b;
        --danger: #ff5470;
        --ok: #22c55e;
        --shadow: 0 12px 34px rgba(40, 70, 140, 0.14);
        --r: 20px;
        --head: "Orbitron", sans-serif;
        --body: "Rajdhani", sans-serif;
      }
      * {
        box-sizing: border-box;
      }
      html,
      body {
        margin: 0;
        height: 100%;
      }
      body {
        font-family: var(--body);
        font-size: 15.5px;
        font-weight: 500;
        color: var(--txt);
        background:
          radial-gradient(900px 500px at 6% -8%, #e3edff 0, transparent 60%),
          radial-gradient(900px 600px at 102% 0%, #efe7ff 0, transparent 55%),
          linear-gradient(180deg, #f3f7fd, #e9f0fb);
        height: 100vh;
        overflow: hidden;
        padding: 10px clamp(10px, 2vw, 26px);
        display: flex;
        flex-direction: column;
      }
      h1,
      h3,
      h4,
      .chip,
      .cmdbtn,
      .modebanner .lab {
        font-family: var(--head);
      }
      header.top {
        display: flex;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap;
        margin-bottom: 6px;
        flex: 0 0 auto;
        position: relative;
      }
      .logo {
        width: 42px;
        height: 42px;
        border-radius: 13px;
        display: grid;
        place-items: center;
        font-size: 22px;
        background: linear-gradient(145deg, #fff, #ece3ff);
        border: 1px solid var(--line);
        box-shadow: var(--shadow);
      }
      .title h1 {
        margin: 0;
        font-size: 19px;
        font-weight: 800;
        letter-spacing: 1px;
        color: #12213f;
      }
      .title p {
        margin: 2px 0 0;
        font-size: 11px;
        font-weight: 500;
        letter-spacing: 0.5px;
        color: var(--mut);
      }
      .helpbtns {
        margin-left: auto;
        display: flex;
        gap: 8px;
      }
      .helpbtn {
        cursor: pointer;
        font-weight: 700;
        color: #fff;
        font-family: var(--head);
        font-size: 12.5px;
        letter-spacing: 0.3px;
        background: linear-gradient(145deg, var(--uv2), var(--uv));
        border: none;
        padding: 10px 16px;
        border-radius: 12px;
        box-shadow: 0 8px 18px rgba(139, 92, 246, 0.32);
        transition: 0.15s;
      }
      .helpbtn:hover {
        transform: translateY(-2px);
      }
      .helpbtn.on {
        box-shadow:
          inset 0 0 0 2px #fff,
          0 8px 18px rgba(139, 92, 246, 0.32);
      }
      .helpbar {
        display: none;
        background: var(--panel);
        border: 1px solid var(--line);
        border-radius: 16px;
        box-shadow: var(--shadow);
        padding: 14px 16px;
        font-size: 14.5px;
        line-height: 1.55;
        color: var(--txt);
        position: absolute;
        right: 0;
        top: 56px;
        width: 380px;
        max-width: min(380px, 90vw);
        max-height: 75vh;
        overflow-y: auto;
        z-index: 40;
      }
      .helpbar.show {
        display: block;
      }
      @media (max-width: 1280px) {
        .helpbar {
          position: static;
          width: auto;
          max-width: none;
          margin-top: 8px;
        }
      }
      .tabpanel {
        display: none;
      }
      .tabpanel.on {
        display: block;
      }
      .tabpanel ol,
      .tabpanel ul {
        margin: 0;
        padding-left: 20px;
      }
      .tabpanel li {
        margin-bottom: 5px;
      }

      .grid {
        display: grid;
        grid-template-columns: 300px 1fr 340px;
        gap: 12px;
        align-items: stretch;
        flex: 1 1 auto;
        min-height: 0;
      }
      @media (max-width: 1280px) {
        body {
          overflow: auto;
        }
        .grid {
          grid-template-columns: 1fr;
          flex: 0 0 auto;
        }
      }
      .card {
        background: var(--panel);
        border: 1px solid var(--line);
        border-radius: var(--r);
        box-shadow: var(--shadow);
        padding: 14px;
        overflow-y: auto;
        overflow-x: hidden;
        min-height: 0;
      }
      .card.stage {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        padding: 12px;
      }
      .card h3 {
        margin: 0 0 3px;
        font-size: 14.5px;
        font-weight: 700;
        letter-spacing: 0.7px;
        text-transform: uppercase;
        color: #12213f;
      }
      .card .sub {
        font-size: 12.5px;
        color: var(--mut);
        margin: 0 0 8px;
        line-height: 1.4;
      }

      .cmdgroup {
        margin-bottom: 14px;
      }
      .cmdgroup h4 {
        margin: 0 0 6px;
        font-size: 11px;
        letter-spacing: 0.6px;
        color: var(--uv);
        text-transform: uppercase;
      }
      .toggle {
        display: flex;
        gap: 8px;
        margin-bottom: 8px;
      }
      .toggle button {
        flex: 1;
        cursor: pointer;
        border: 2px solid var(--line);
        background: #fff;
        color: var(--mut);
        padding: 8px 6px;
        border-radius: 11px;
        font-size: 12.5px;
        font-weight: 700;
        transition: 0.15s;
        font-family: var(--body);
      }
      .toggle button.on {
        color: #fff;
        border-color: transparent;
        background: linear-gradient(145deg, var(--uv2), var(--uv));
        box-shadow: 0 8px 18px rgba(139, 92, 246, 0.35);
      }

      .ctrl {
        margin: 10px 0;
      }
      .ctrl .row {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        margin-bottom: 5px;
      }
      .ctrl label {
        font-size: 13px;
        font-weight: 600;
        color: var(--txt);
      }
      .ctrl .val {
        font-family: var(--head);
        font-size: 12px;
        color: var(--accent);
        font-weight: 700;
        font-variant-numeric: tabular-nums;
      }
      input[type="range"] {
        -webkit-appearance: none;
        width: 100%;
        height: 9px;
        border-radius: 10px;
        outline: none;
        background: linear-gradient(90deg, var(--accent2), var(--accent))
          no-repeat;
        background-size: var(--fill, 50%) 100%;
        box-shadow: inset 0 0 0 2px var(--line);
        cursor: pointer;
      }
      input[type="range"]::-webkit-slider-thumb {
        -webkit-appearance: none;
        width: 19px;
        height: 19px;
        border-radius: 50%;
        background: #fff;
        border: 4px solid var(--accent);
        box-shadow: 0 3px 8px rgba(0, 0, 0, 0.18);
        cursor: grab;
      }
      input[type="range"]::-moz-range-thumb {
        width: 17px;
        height: 17px;
        border-radius: 50%;
        background: #fff;
        border: 4px solid var(--accent);
        cursor: grab;
      }
      .hint {
        font-size: 11.5px;
        color: var(--dim);
        margin-top: 4px;
        line-height: 1.35;
      }
      .manualbox {
        display: none;
        padding-top: 6px;
      }
      .manualbox.show {
        display: block;
      }

      canvas {
        max-width: 100%;
        max-height: 100%;
        width: auto;
        height: auto;
        display: block;
        border-radius: 14px;
        background: #eef3fb;
        cursor: default;
        flex: 0 1 auto;
        min-height: 0;
      }
      #stage {
        cursor: crosshair;
        touch-action: none;
      }
      #stage.chaser-cursor {
        cursor: none;
      }
      .modebanner {
        width: 100%;
        max-width: 820px;
        margin-top: 8px;
        padding: 9px 14px;
        border-radius: 14px;
        background: linear-gradient(145deg, #f2edff, #e6ddff);
        border: 2px solid #d9cbfb;
        display: flex;
        flex: 0 0 auto;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
      }
      .modebanner .lab {
        font-size: 11px;
        color: var(--uv);
        letter-spacing: 0.5px;
        font-weight: 700;
      }
      .modebanner .txt {
        font-size: 14px;
        font-weight: 700;
        color: #2a1f45;
        margin-top: 2px;
      }
      .modebanner .chip {
        font-family: var(--head);
        font-size: 11px;
        color: #fff;
        font-weight: 800;
        white-space: nowrap;
        padding: 6px 12px;
        border-radius: 9px;
        background: linear-gradient(145deg, var(--accent2), var(--accent));
      }
      .modebanner .chip.patrol {
        background: linear-gradient(145deg, var(--uv2), var(--uv));
      }
      .modebanner .chip.caught {
        background: linear-gradient(145deg, #6ee7b7, var(--ok));
      }
      .stage-foot {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
        margin-top: 8px;
        justify-content: center;
        flex: 0 0 auto;
      }
      .btn {
        cursor: pointer;
        border: 2px solid var(--line);
        background: #fff;
        color: var(--txt);
        padding: 8px 13px;
        border-radius: 11px;
        font-size: 13.5px;
        font-weight: 600;
        transition: 0.15s;
        font-family: var(--body);
      }
      .btn:hover {
        transform: translateY(-2px);
        border-color: var(--accent2);
      }
      .btn.start.on {
        background: linear-gradient(145deg, #54c48a, #3fb87a);
        border-color: transparent;
        color: #fff;
        box-shadow: 0 8px 18px rgba(84, 196, 138, 0.4);
      }
      .btn.pause.on {
        background: linear-gradient(145deg, var(--uv2), var(--uv));
        border-color: transparent;
        color: #fff;
        box-shadow: 0 8px 18px rgba(139, 92, 246, 0.35);
      }

      .gearwrap {
        margin-top: 10px;
        display: flex;
        gap: 10px;
        align-items: center;
        background: var(--panel2);
        border: 1px solid var(--line);
        border-radius: 14px;
        padding: 8px 10px;
        width: 100%;
        max-width: 820px;
      }
      .gearwrap canvas {
        border-radius: 10px;
        background: #fff;
        flex: 0 0 auto;
      }
      .gearwrap p {
        margin: 0;
        font-size: 12px;
        color: var(--mut);
        line-height: 1.45;
      }

      .sgrid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 6px;
        margin-top: 4px;
      }
      .reading {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 7px 0;
        border-bottom: 1.5px dashed var(--line);
        font-size: 13px;
      }
      .reading:last-child {
        border-bottom: none;
      }
      .reading .k {
        color: var(--mut);
      }
      .reading .v {
        font-family: var(--body);
        font-weight: 700;
        font-size: 13px;
      }

      .hbar {
        height: 14px;
        border-radius: 8px;
        background: var(--panel2);
        border: 1.5px solid var(--line);
        position: relative;
        overflow: hidden;
        margin: 4px 0 8px;
      }
      .hbar .fill {
        position: absolute;
        inset: 0 auto 0 0;
        width: 0;
        border-radius: 7px;
        transition:
          width 0.12s,
          background 0.2s;
      }
      .hbar .thr {
        position: absolute;
        top: -3px;
        bottom: -3px;
        width: 2.5px;
        background: var(--danger);
        border-radius: 2px;
      }

      .compare {
        padding: 10px;
        border-radius: 12px;
        background: var(--panel2);
        border: 1.5px solid var(--line);
        text-align: center;
        font-weight: 700;
        font-size: 13.5px;
        margin: 8px 0;
        color: var(--txt);
      }

      .statusgrid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 6px;
        margin-top: 8px;
      }
      .stat {
        background: var(--panel2);
        border: 1.5px solid var(--line);
        border-radius: 10px;
        padding: 6px 8px;
      }
      .stat .k {
        font-size: 10.5px;
        color: var(--dim);
        text-transform: uppercase;
        letter-spacing: 0.4px;
        font-weight: 700;
      }
      .stat .v {
        font-size: 14px;
        font-weight: 700;
        margin-top: 2px;
      }
      .stat .v.g {
        color: var(--ok);
      }
      .stat .v.u {
        color: var(--uv);
      }
      .stat .v.n {
        color: var(--mut);
      }
      .stat .v.a {
        color: var(--accent);
      }
    </style>
  </head>
  <body>
    <header class="top">
      <div class="logo">🔦</div>
      <div class="title">
        <h1>INVISIBLE UV PATH TRACKING</h1>
        <p>UV SENSOR COMPARISON · GEAR-DRIVEN WALKING · LOF ROBOTICS</p>
      </div>
      <div class="helpbtns">
        <button type="button" class="helpbtn" data-tab="use">How To Use</button>
        <button type="button" class="helpbtn" data-tab="learn">
          What You'll Learn
        </button>
      </div>
      <div class="helpbar" id="helpbar">
        <div class="tabpanel" data-panel="use">
          <ol>
            <li>
              Pick a mode: <b>Pre-Programmed Route</b> or
              <b>UV Light Chaser</b>
            </li>
            <li>
              Route mode: click and drag anywhere on the floor to draw your own
              invisible UV path
            </li>
            <li>
              Chaser mode: point your mouse anywhere on the floor — that's the
              UV light the bot will chase
            </li>
            <li>Press <b>Start</b> when you're ready to let the bot go</li>
            <li>
              Watch the sensor readings and mode banner explain every decision
              it makes
            </li>
            <li>
              Try <b>Manual Motor Test</b> to control both motors yourself and
              see how a speed difference alone causes a turn
            </li>
          </ol>
        </div>
        <div class="tabpanel" data-panel="learn">
          <ul>
            <li>How UV sensors detect an invisible path or light source</li>
            <li>How left/right sensor readings are compared</li>
            <li>How comparison logic decides direction</li>
            <li>How a bot can actively chase a moving light in real time</li>
            <li>How motor speed difference makes it turn</li>
            <li>How gears &amp; linkages create walking motion</li>
            <li>How patrol mode searches when the signal is lost</li>
          </ul>
        </div>
      </div>
    </header>

    <div class="grid">
      <section class="card">
        <h3>Controls</h3>
        <p class="sub">
          The bot can't see anything directly — only its two UV sensors can.
          Pick a mode below, then watch it react.
        </p>

        <div class="cmdgroup">
          <h4>Simulation Mode</h4>
          <div class="toggle">
            <button id="modeRouteBtn" class="modepill on" data-mode="route">
              Pre-Programmed Route
            </button>
            <button id="modeChaserBtn" class="modepill" data-mode="chaser">
              UV Light Chaser
            </button>
          </div>
          <p class="hint" id="modeDescHint" style="margin-top: 6px">
            Draw an invisible path on the floor and the bot follows it using
            only its two UV sensors.
          </p>
        </div>

        <div class="cmdgroup" id="routeControls">
          <h4>UV Path</h4>
          <p class="hint" style="margin: -2px 0 8px">
            Click and drag anywhere on the floor to draw your own invisible path
            — the bot restarts from wherever it begins.
          </p>
          <div class="toggle">
            <button id="pathToggle" class="on">Show UV Path</button>
          </div>
          <div class="toggle">
            <button id="clearPathBtn">Clear Path</button>
          </div>
        </div>

        <div class="cmdgroup" id="chaserControls" style="display: none">
          <h4>UV Light Chaser</h4>
          <p class="hint" style="margin: -2px 0 8px">
            Start the simulation, then point your mouse anywhere on the floor
            — that becomes a live UV light source, and the bot chases it in
            real time, same as the Heat Seeker Rover. Move the light away and
            the bot spiral-searches until it finds it again. Use the UV
            Intensity slider below to make the light stronger or weaker.
          </p>
        </div>

        <div class="cmdgroup">
          <h4>UV Signal</h4>
          <div class="ctrl">
            <div class="row">
              <label>UV Intensity</label
              ><span class="val" id="v_intensity">80%</span>
            </div>
            <input
              type="range"
              id="r_intensity"
              min="20"
              max="100"
              step="2"
              value="80"
            />
            <div class="hint">How strong the UV signal is at the path.</div>
          </div>
          <div class="ctrl">
            <div class="row">
              <label>Sensor Threshold</label
              ><span class="val" id="v_threshold">40%</span>
            </div>
            <input
              type="range"
              id="r_threshold"
              min="10"
              max="90"
              step="2"
              value="40"
            />
            <div class="hint">
              Reading must cross this to count as "detected".
            </div>
          </div>
        </div>

        <div class="cmdgroup">
          <h4>Motors</h4>
          <div class="ctrl">
            <div class="row">
              <label>Walking Speed</label
              ><span class="val" id="v_speed">35</span>
            </div>
            <input
              type="range"
              id="r_speed"
              min="15"
              max="70"
              step="1"
              value="35"
            />
            <div class="hint">Base leg speed when both sensors agree.</div>
          </div>
          <div class="toggle">
            <button id="manualToggle">Manual Motor Test</button>
          </div>
          <div class="manualbox" id="manualBox">
            <div class="ctrl">
              <div class="row">
                <label>Left Motor</label><span class="val" id="v_manL">35</span>
              </div>
              <input
                type="range"
                id="r_manL"
                min="0"
                max="70"
                step="1"
                value="35"
              />
            </div>
            <div class="ctrl">
              <div class="row">
                <label>Right Motor</label
                ><span class="val" id="v_manR">35</span>
              </div>
              <input
                type="range"
                id="r_manR"
                min="0"
                max="70"
                step="1"
                value="35"
              />
            </div>
            <div class="hint">
              Overrides the sensors — set the two speeds directly and watch the
              turn.
            </div>
          </div>
        </div>

        <div class="cmdgroup">
          <h4>Patrol Mode</h4>
          <div class="ctrl">
            <div class="row">
              <label>Spiral Search Radius</label
              ><span class="val" id="v_radius">90</span>
            </div>
            <input
              type="range"
              id="r_radius"
              min="40"
              max="160"
              step="5"
              value="90"
            />
            <div class="hint">
              How wide it searches when neither sensor sees UV.
            </div>
          </div>
        </div>
      </section>

      <section class="card stage">
        <canvas id="stage" width="820" height="520"></canvas>
        <div class="modebanner">
          <div>
            <div class="lab">BOT MODE</div>
            <div class="txt" id="modeTxt">Following the UV path</div>
          </div>
          <div class="chip" id="modeChip">FORWARD</div>
        </div>
        <div class="gearwrap">
          <canvas id="gearStage" width="150" height="90"></canvas>
          <p>
            Motor rotation turns the gear. The gear moves the linkage. The
            linkage moves the legs. This creates the walking motion of the bot.
          </p>
        </div>
        <div class="stage-foot">
          <button class="btn start" id="startBtn">▶ Start</button>
          <button class="btn pause on" id="pauseBtn">⏸ Pause</button>
          <button class="btn" id="resetBtn">↺ Reset Simulation</button>
        </div>
      </section>

      <section class="card">
        <h3>Sensor Telemetry</h3>
        <p class="sub">
          Live readings from both UV sensors and what the comparison decides.
        </p>

        <div class="reading">
          <span class="k">Left UV Sensor</span
          ><span class="v" id="leftVal">0%</span>
        </div>
        <div class="hbar">
          <div class="fill" id="leftFill"></div>
          <div class="thr" id="leftThr"></div>
        </div>
        <div class="reading">
          <span class="k">Right UV Sensor</span
          ><span class="v" id="rightVal">0%</span>
        </div>
        <div class="hbar">
          <div class="fill" id="rightFill"></div>
          <div class="thr" id="rightThr"></div>
        </div>

        <div class="compare" id="compareTxt">Comparing…</div>

        <div class="reading">
          <span class="k">Left Motor Speed</span
          ><span class="v" id="lMotorVal">0</span>
        </div>
        <div class="hbar"><div class="fill" id="lMotorFill"></div></div>
        <div class="reading">
          <span class="k">Right Motor Speed</span
          ><span class="v" id="rMotorVal">0</span>
        </div>
        <div class="hbar"><div class="fill" id="rMotorFill"></div></div>

        <div class="statusgrid">
          <div class="stat">
            <div class="k">Bot Mode</div>
            <div class="v" id="statMode">Forward</div>
          </div>
          <div class="stat">
            <div class="k">Search Pattern</div>
            <div class="v" id="statPattern">Idle</div>
          </div>
          <div class="stat">
            <div class="k">Distance Walked</div>
            <div class="v" id="statDist">0 u</div>
          </div>
          <div class="stat">
            <div class="k">Gear Rotation</div>
            <div class="v" id="statGear">0°</div>
          </div>
        </div>
      </section>
    </div>

    <script>
      (() => {
        "use strict";
        const DEG = Math.PI / 180;
        const clamp = (v, a, b) => Math.max(a, Math.min(b, v));

        /* =================== CANVAS =================== */
        const cv = document.getElementById("stage"),
          ctx = cv.getContext("2d");
        const W = cv.width,
          H = cv.height;
        const gv = document.getElementById("gearStage"),
          gctx = gv.getContext("2d");
        const GW = gv.width,
          GH = gv.height;

        const SENSOR_SPACING = 14,
          FRONT_OFFSET = 18,
          SIGMA = 22,
          // A drawn path is a thin line — SIGMA=22 means "basically on top of it".
          // A chased cursor can be anywhere on the whole floor, so it needs a much
          // wider falloff or the bot would never register the light until it
          // stumbled almost exactly onto the mouse position.
          CHASER_SIGMA = 250,
          WHEELBASE = 28;
        const LEG_RATE = 0.16,
          GEAR_RATIO = 1.4,
          MAX_SPEED = 70,
          // How close the bot's body has to get to the cursor light before it
          // counts as "caught" and the run auto-stops.
          CATCH_RADIUS = 26;

        /* =================== STATE =================== */
        // 'route' = draw a fixed path, bot follows it. 'chaser' = the mouse
        // cursor itself is a live UV light source the bot chases in real time.
        let simMode = "route";
        const FAR_AWAY = { x: -9999, y: -9999 };
        let cursorPos = { x: FAR_AWAY.x, y: FAR_AWAY.y };
        let lightCaught = false;
        let showPath = true;
        let uvIntensity = 80,
          threshold = 40,
          walkSpeed = 35,
          spiralMax = 90;
        let manualMode = false,
          manL = 35,
          manR = 35;

        // The path is whatever the student has drawn: a polyline of canvas points.
        // The bot is a real 2D point with a heading, driven by differential-drive
        // kinematics from the left/right "motor" speeds — no more fake scrolling world.
        let pathPoints = [];
        let bot = { x: 410, y: 260, heading: Math.PI / 2 };
        let distance = 0,
          walkPhase = 0;
        let mode = "forward",
          prevMode = "forward";
        let patrolTime = 0,
          patrolAngle = 0,
          patrolRadius = 0,
          patrolCenter = { x: 410, y: 260 };
        let leftReading = 0,
          rightReading = 0,
          leftSpeed = 0,
          rightSpeed = 0;
        let paused = true,
          started = false;
        // Hysteresis (separate on/off thresholds) plus a short hold-time before a new
        // mode is accepted — without these, a reading sitting right at the threshold
        // line flips detection every frame and the mode banner flickers constantly.
        let detLState = false,
          detRState = false,
          candidateMode = "forward",
          candidateTime = 0;
        const MODE_HOLD = 0.15;

        /* =================== PATH / SENSOR MODEL =================== */
        // Distance from a point to the nearest point of the hand-drawn path.
        // Distance from (px,py) to the nearest point ON the segment a→b, not just to
        // its endpoints — a fast mouse drag can leave big gaps between captured
        // points, and measuring to the nearest vertex alone creates dead zones the
        // sensors "lose" even though the visible line drawn between them is unbroken.
        function distToSegment(px, py, ax, ay, bx, by) {
          const abx = bx - ax,
            aby = by - ay;
          const len2 = abx * abx + aby * aby;
          let t = len2 > 0 ? ((px - ax) * abx + (py - ay) * aby) / len2 : 0;
          t = Math.max(0, Math.min(1, t));
          return Math.hypot(px - (ax + abx * t), py - (ay + aby * t));
        }
        // How far along the drawn path (as a segment index) the bot currently believes
        // it is. Searches for the nearest point are kept to a small window around this
        // instead of the whole path — otherwise, wherever a loop or switchback brings
        // the path physically close to an earlier/later part of itself, the sensors
        // would get pulled toward that other strand instead of the segment actually
        // ahead, and the bot yanks toward it like a sharp U-turn.
        let pathProgress = 0;
        const PROGRESS_BACK = 6,
          PROGRESS_FWD = 30;
        function nearestPathWindowed(px, py) {
          if (pathPoints.length < 2) return { dist: Infinity, idx: 0 };
          const lo = Math.max(0, Math.floor(pathProgress) - PROGRESS_BACK);
          const hi = Math.min(
            pathPoints.length - 2,
            Math.floor(pathProgress) + PROGRESS_FWD,
          );
          let best = Infinity,
            bestIdx = lo;
          for (let i = lo; i <= hi; i++) {
            const a = pathPoints[i],
              b = pathPoints[i + 1];
            const d = distToSegment(px, py, a.x, a.y, b.x, b.y);
            if (d < best) {
              best = d;
              bestIdx = i;
            }
          }
          // Nothing nearby in the local window (e.g. mid-patrol, far from where the
          // path was lost) — fall back to a full-path search so it can still re-sync
          // onto whichever part of the path it actually wanders back to.
          if (best > 120) {
            for (let i = 0; i < pathPoints.length - 1; i++) {
              const a = pathPoints[i],
                b = pathPoints[i + 1];
              const d = distToSegment(px, py, a.x, a.y, b.x, b.y);
              if (d < best) {
                best = d;
                bestIdx = i;
              }
            }
          }
          return { dist: best, idx: bestIdx };
        }
        function nearestPathDist(px, py) {
          return nearestPathWindowed(px, py).dist;
        }
        // In chaser mode the "path" is a single point — wherever the mouse
        // currently is — so the same Gaussian falloff used for path distance
        // works unchanged, just measured against the live cursor instead.
        function uvReadingAt(px, py) {
          if (simMode === "chaser") {
            const d = Math.hypot(px - cursorPos.x, py - cursorPos.y);
            const raw =
              uvIntensity *
              Math.exp(-(d * d) / (2 * CHASER_SIGMA * CHASER_SIGMA));
            // A real forward-facing sensor can't see a light behind the bot —
            // gate the reading out once the light is more than ~90° off the
            // bot's heading. This must be a narrow on/off gate around that
            // boundary, NOT a gradual taper across the whole front half —
            // tapering scaled left and right down by the same shrinking
            // factor as the light swung toward either side, which flattens
            // exactly the L/R difference the steering compares to turn
            // toward it, making a light dead to one side read as "straight
            // ahead, both sides equal" instead of triggering a turn.
            const toLightX = cursorPos.x - bot.x,
              toLightY = cursorPos.y - bot.y;
            const facingDot =
              toLightX * Math.cos(bot.heading) + toLightY * Math.sin(bot.heading);
            const BEHIND_SOFTEN = 20; // world units of blur right at the ±90° line, just to avoid flicker
            const gate = clamp(facingDot / BEHIND_SOFTEN + 0.5, 0, 1);
            return raw * gate;
          }
          const d = nearestPathDist(px, py);
          return uvIntensity * Math.exp(-(d * d) / (2 * SIGMA * SIGMA));
        }
        function resamplePath(pts) {
          // Keep drawn points reasonably spaced so nearestPathDist stays fast and smooth.
          const out = [];
          let last = null;
          for (const p of pts) {
            if (!last || Math.hypot(p.x - last.x, p.y - last.y) >= 5) {
              out.push(p);
              last = p;
            }
          }
          return out;
        }
        function startBotAtPathHead() {
          pathProgress = 0;
          if (pathPoints.length < 2) return;
          const a = pathPoints[0],
            b = pathPoints[Math.min(3, pathPoints.length - 1)];
          bot = { x: a.x, y: a.y, heading: Math.atan2(b.y - a.y, b.x - a.x) };
        }

        /* =================== DOM =================== */
        const els = {
          leftVal: document.getElementById("leftVal"),
          leftFill: document.getElementById("leftFill"),
          leftThr: document.getElementById("leftThr"),
          rightVal: document.getElementById("rightVal"),
          rightFill: document.getElementById("rightFill"),
          rightThr: document.getElementById("rightThr"),
          compareTxt: document.getElementById("compareTxt"),
          lMotorVal: document.getElementById("lMotorVal"),
          lMotorFill: document.getElementById("lMotorFill"),
          rMotorVal: document.getElementById("rMotorVal"),
          rMotorFill: document.getElementById("rMotorFill"),
          statMode: document.getElementById("statMode"),
          statPattern: document.getElementById("statPattern"),
          statDist: document.getElementById("statDist"),
          statGear: document.getElementById("statGear"),
          modeTxt: document.getElementById("modeTxt"),
          modeChip: document.getElementById("modeChip"),
        };

        /* =================== HELP BUTTONS =================== */
        // Two independent buttons, each its own toggle: click one to show just its
        // panel; click the same one again (or click outside) to close it.
        const helpbar = document.getElementById("helpbar");
        const helpBtns = document.querySelectorAll(".helpbtn");
        function closeHelp() {
          helpbar.classList.remove("show");
          helpBtns.forEach((b) => b.classList.remove("on"));
        }
        helpBtns.forEach((btn) => {
          btn.addEventListener("click", () => {
            const alreadyOpen = btn.classList.contains("on");
            closeHelp();
            if (alreadyOpen) return;
            btn.classList.add("on");
            document
              .querySelectorAll(".tabpanel")
              .forEach((p) =>
                p.classList.toggle("on", p.dataset.panel === btn.dataset.tab),
              );
            helpbar.classList.add("show");
          });
        });
        document.addEventListener("click", (e) => {
          if (!helpbar.classList.contains("show")) return;
          if (
            helpbar.contains(e.target) ||
            e.target.classList.contains("helpbtn")
          )
            return;
          closeHelp();
        });

        /* =================== CONTROLS WIRING =================== */
        function bindSlider(id, valId, fmt, onChange) {
          const inp = document.getElementById(id),
            val = document.getElementById(valId);
          const min = +inp.min,
            max = +inp.max;
          const fill = () =>
            inp.style.setProperty(
              "--fill",
              ((inp.value - min) / (max - min)) * 100 + "%",
            );
          fill();
          inp.addEventListener("input", () => {
            const v = parseFloat(inp.value);
            val.textContent = fmt(v);
            fill();
            onChange(v);
          });
          val.textContent = fmt(parseFloat(inp.value));
        }
        bindSlider(
          "r_intensity",
          "v_intensity",
          (v) => Math.round(v) + "%",
          (v) => {
            uvIntensity = v;
          },
        );
        bindSlider(
          "r_threshold",
          "v_threshold",
          (v) => Math.round(v) + "%",
          (v) => {
            threshold = v;
          },
        );
        bindSlider(
          "r_speed",
          "v_speed",
          (v) => Math.round(v),
          (v) => {
            walkSpeed = v;
          },
        );
        bindSlider(
          "r_radius",
          "v_radius",
          (v) => Math.round(v),
          (v) => {
            spiralMax = v;
          },
        );
        bindSlider(
          "r_manL",
          "v_manL",
          (v) => Math.round(v),
          (v) => {
            manL = v;
          },
        );
        bindSlider(
          "r_manR",
          "v_manR",
          (v) => Math.round(v),
          (v) => {
            manR = v;
          },
        );

        const pathToggle = document.getElementById("pathToggle");
        pathToggle.addEventListener("click", () => {
          showPath = !showPath;
          pathToggle.classList.toggle("on", showPath);
          pathToggle.textContent = showPath
            ? "Show UV Path"
            : "Hide UV Path (still active)";
        });
        const manualToggle = document.getElementById("manualToggle"),
          manualBox = document.getElementById("manualBox");
        manualToggle.addEventListener("click", () => {
          manualMode = !manualMode;
          manualToggle.classList.toggle("on", manualMode);
          manualBox.classList.toggle("show", manualMode);
        });

        /* =================== SIMULATION MODE =================== */
        const MODE_DESC = {
          route:
            "Draw an invisible path on the floor and the bot follows it using only its two UV sensors.",
          chaser:
            "Press Start, then move your mouse over the floor — the bot's UV sensors pick up the light at your cursor and chase it live.",
        };
        const routeControls = document.getElementById("routeControls"),
          chaserControls = document.getElementById("chaserControls"),
          modeDescHint = document.getElementById("modeDescHint"),
          modeRouteBtn = document.getElementById("modeRouteBtn"),
          modeChaserBtn = document.getElementById("modeChaserBtn");
        function setSimMode(m) {
          simMode = m;
          modeRouteBtn.classList.toggle("on", m === "route");
          modeChaserBtn.classList.toggle("on", m === "chaser");
          routeControls.style.display = m === "route" ? "" : "none";
          chaserControls.style.display = m === "chaser" ? "" : "none";
          modeDescHint.textContent = MODE_DESC[m];
          cv.classList.toggle("chaser-cursor", m === "chaser");
          resetMotionState();
          started = false;
          setPaused(true);
        }
        modeRouteBtn.addEventListener("click", () => setSimMode("route"));
        modeChaserBtn.addEventListener("click", () => setSimMode("chaser"));

        function resetMotionState() {
          distance = 0;
          walkPhase = 0;
          mode = "forward";
          prevMode = "forward";
          patrolTime = 0;
          patrolAngle = 0;
          patrolRadius = 0;
          detLState = false;
          detRState = false;
          candidateMode = "forward";
          candidateTime = 0;
          lightCaught = false;
          if (simMode === "chaser") {
            bot = { x: 410, y: 260, heading: Math.PI / 2 };
            cursorPos = { x: FAR_AWAY.x, y: FAR_AWAY.y };
          } else {
            startBotAtPathHead();
          }
        }
        document.getElementById("resetBtn").addEventListener("click", () => {
          resetMotionState();
          started = false;
          setPaused(true);
        });
        document
          .getElementById("clearPathBtn")
          .addEventListener("click", () => {
            pathPoints = [];
            resetMotionState();
          });

        const startBtn = document.getElementById("startBtn"),
          pauseBtn = document.getElementById("pauseBtn");
        function setPaused(v) {
          paused = v;
          startBtn.classList.toggle("on", !paused);
          pauseBtn.classList.toggle("on", paused);
        }
        startBtn.addEventListener("click", () => {
          started = true;
          lightCaught = false;
          setPaused(false);
        });
        pauseBtn.addEventListener("click", () => setPaused(true));

        /* =================== PATH DRAWING (mouse/touch) =================== */
        let drawingPath = false,
          drawBuffer = [];
        const pointerPos = (e) => {
          const r = cv.getBoundingClientRect();
          return {
            x: (e.clientX - r.left) * (W / r.width),
            y: (e.clientY - r.top) * (H / r.height),
          };
        };
        cv.addEventListener("pointerdown", (e) => {
          if (simMode !== "route") return;
          // Freeze the bot the instant a new drag starts — it must not react to the
          // old path (or move at all) while a new one is still being sketched.
          setPaused(true);
          started = false;
          drawingPath = true;
          drawBuffer = [pointerPos(e)];
          cv.setPointerCapture(e.pointerId);
        });
        cv.addEventListener("pointermove", (e) => {
          if (simMode === "chaser") {
            // The cursor itself IS the UV light source in this mode — no drag
            // needed, just live tracking every frame the pointer is over the floor.
            cursorPos = pointerPos(e);
            return;
          }
          if (!drawingPath) return;
          const p = pointerPos(e);
          const last = drawBuffer[drawBuffer.length - 1];
          if (Math.hypot(p.x - last.x, p.y - last.y) >= 4) drawBuffer.push(p);
        });
        cv.addEventListener("pointerup", () => {
          if (simMode !== "route") return;
          if (!drawingPath) return;
          drawingPath = false;
          const len = drawBuffer.reduce(
            (s, p, i) =>
              i === 0
                ? 0
                : s +
                  Math.hypot(
                    p.x - drawBuffer[i - 1].x,
                    p.y - drawBuffer[i - 1].y,
                  ),
            0,
          );
          if (len >= 20) {
            pathPoints = resamplePath(drawBuffer);
            resetMotionState();
          }
          // Stay paused/ready regardless — drawing never auto-starts the bot.
          setPaused(true);
          started = false;
        });
        cv.addEventListener("pointerleave", () => {
          if (simMode === "chaser") {
            // The light STAYS exactly where it last was — stepping off the
            // floor to reach a slider shouldn't make the bot instantly lose
            // its target. It only clears on Reset / switching modes.
            return;
          }
          drawingPath = false;
        });

        /* =================== DRAWING: MAIN STAGE =================== */
        function drawBackdrop() {
          const chaser = simMode === "chaser";
          const g = ctx.createLinearGradient(0, 0, 0, H);
          if (chaser) {
            // A dimmed "blacklight room" floor — the UV beam glow reads far more
            // clearly against it, and it's a much better sell that this is UV
            // light than a bright daylit grid ever was.
            g.addColorStop(0, "#2a2440");
            g.addColorStop(1, "#181528");
          } else {
            g.addColorStop(0, "#f3f8ff");
            g.addColorStop(1, "#dfe9f7");
          }
          ctx.fillStyle = g;
          ctx.fillRect(0, 0, W, H);
          ctx.strokeStyle = chaser ? "rgba(196,181,253,.09)" : "rgba(40,70,140,.07)";
          ctx.lineWidth = 1;
          for (let x = 0; x < W; x += 40) {
            ctx.beginPath();
            ctx.moveTo(x, 0);
            ctx.lineTo(x, H);
            ctx.stroke();
          }
          for (let y = 0; y < H; y += 40) {
            ctx.beginPath();
            ctx.moveTo(0, y);
            ctx.lineTo(W, y);
            ctx.stroke();
          }
        }
        function drawPath() {
          if (pathPoints.length < 2) {
            ctx.save();
            ctx.fillStyle = "rgba(90,109,140,.6)";
            ctx.font = '600 15px "Rajdhani",sans-serif';
            ctx.textAlign = "center";
            ctx.fillText(
              "Click and drag on the floor to draw an invisible UV path",
              W / 2,
              H / 2,
            );
            ctx.restore();
            return;
          }
          if (!showPath) return;
          ctx.save();
          ctx.strokeStyle = "rgba(139,92,246,.55)";
          ctx.lineWidth = 10;
          ctx.lineCap = "round";
          ctx.lineJoin = "round";
          ctx.shadowColor = "rgba(139,92,246,.7)";
          ctx.shadowBlur = 16;
          ctx.beginPath();
          pathPoints.forEach((p, i) => {
            if (i === 0) ctx.moveTo(p.x, p.y);
            else ctx.lineTo(p.x, p.y);
          });
          ctx.stroke();
          ctx.shadowBlur = 0;
          ctx.strokeStyle = "rgba(196,181,253,.9)";
          ctx.lineWidth = 2.5;
          ctx.setLineDash([3, 7]);
          ctx.beginPath();
          pathPoints.forEach((p, i) => {
            if (i === 0) ctx.moveTo(p.x, p.y);
            else ctx.lineTo(p.x, p.y);
          });
          ctx.stroke();
          ctx.setLineDash([]);
          ctx.restore();
        }
        // The line the student is actively dragging out — shown live so they can see
        // what they're drawing instead of only finding out once they let go.
        function drawLivePreview() {
          if (!drawingPath || drawBuffer.length < 2) return;
          ctx.save();
          ctx.strokeStyle = "rgba(124,58,237,.85)";
          ctx.lineWidth = 4;
          ctx.lineCap = "round";
          ctx.lineJoin = "round";
          ctx.setLineDash([2, 6]);
          ctx.beginPath();
          drawBuffer.forEach((p, i) => {
            if (i === 0) ctx.moveTo(p.x, p.y);
            else ctx.lineTo(p.x, p.y);
          });
          ctx.stroke();
          ctx.setLineDash([]);
          ctx.restore();
        }
        function drawPatrolSpiral() {
          if (mode !== "patrol") return;
          ctx.save();
          ctx.strokeStyle = "rgba(139,92,246,.4)";
          ctx.lineWidth = 1.5;
          ctx.setLineDash([5, 5]);
          ctx.beginPath();
          ctx.arc(
            patrolCenter.x,
            patrolCenter.y,
            18 + patrolRadius,
            0,
            Math.PI * 2,
          );
          ctx.stroke();
          ctx.setLineDash([]);
          ctx.restore();
        }
        // Legs are drawn in the bot's own local frame (local +x = forward, the same
        // convention used for the sensor positions), inside the translate+rotate in
        // drawBot() — so they automatically follow the bot's real heading.
        function drawLegs() {
          const stride = 9,
            ext = 9;
          const hips = [
            { lx: 15, ly: -13, phase: 0 },
            { lx: 15, ly: 13, phase: Math.PI },
            { lx: -15, ly: -13, phase: Math.PI },
            { lx: -15, ly: 13, phase: 0 },
          ];
          ctx.strokeStyle = "#2c4d78";
          ctx.lineWidth = 4;
          ctx.lineCap = "round";
          hips.forEach((h) => {
            const s = Math.sin(walkPhase + h.phase);
            const footLx = h.lx + s * stride,
              footLy = h.ly + Math.sign(h.ly) * (ext + Math.abs(s) * 3);
            ctx.beginPath();
            ctx.moveTo(h.lx, h.ly);
            ctx.lineTo(footLx, footLy);
            ctx.stroke();
            ctx.fillStyle = "#12213f";
            ctx.beginPath();
            ctx.arc(footLx, footLy, 3, 0, 7);
            ctx.fill();
          });
        }
        function drawBot() {
          ctx.save();
          ctx.translate(bot.x, bot.y);
          ctx.rotate(bot.heading);
          drawLegs();
          const bodyGrad = ctx.createLinearGradient(-25, 0, 25, 0);
          bodyGrad.addColorStop(0, "#1c395a");
          bodyGrad.addColorStop(1, "#3b6ea5");
          ctx.fillStyle = bodyGrad;
          ctx.strokeStyle = "#16263f";
          ctx.lineWidth = 2;
          ctx.beginPath();
          ctx.roundRect(-25, -17, 50, 34, 14);
          ctx.fill();
          ctx.stroke();

          // sensor glow indicators, at the same local offsets used for the real reading
          const ls = leftReading / 100,
            rs = rightReading / 100;
          // In chaser mode, light up whichever eye currently reads STRONGER —
          // a direct, comparative "this way" indicator — rather than gating on
          // the absolute threshold, which could leave both eyes dark even while
          // one side clearly has more signal than the other.
          const chaserEyes = simMode === "chaser";
          const anySignal = ls + rs > 0.015;
          // Three-way, not just "whichever is bigger": left-only when the light
          // is clearly off to the left, right-only when clearly off to the
          // right, and BOTH eyes when it's roughly centered/aligned ahead.
          // Reuses the same debounced `mode` the bot's own steering already
          // settled on, so the eyes and the actual turn never disagree or
          // flicker independently of each other.
          [
            [FRONT_OFFSET, -SENSOR_SPACING, ls, "left"],
            [FRONT_OFFSET, SENSOR_SPACING, rs, "right"],
          ].forEach(([lx, ly, s, side]) => {
            const on = chaserEyes
              ? anySignal && (mode === "forward" || mode === side)
              : s * 100 >= threshold;
            ctx.fillStyle = on
              ? `rgba(139,92,246,${0.45 + s * 0.5})`
              : "rgba(150,160,180,.35)";
            ctx.beginPath();
            ctx.arc(lx, ly, 7 + s * 4, 0, 7);
            ctx.fill();
            ctx.fillStyle = on ? "#7c3aed" : "#8a97ab";
            ctx.beginPath();
            ctx.arc(lx, ly, 4, 0, 7);
            ctx.fill();
          });

          // heading indicator (nose tip)
          ctx.fillStyle = "#ffb02e";
          ctx.beginPath();
          ctx.moveTo(30, 0);
          ctx.lineTo(21, -6);
          ctx.lineTo(21, 6);
          ctx.closePath();
          ctx.fill();
          ctx.restore();
        }
        // A soft glowing halo at the live cursor position, standing in for the
        // UV flashlight the mouse is carrying — sized and brightened with the
        // same UV Intensity slider used for the reading itself, so a stronger
        // setting visibly looks like a stronger light, not just a bigger number.
        function drawUVBeam() {
          if (cursorPos.x < -1000) return;
          const amt = clamp(uvIntensity / 100, 0.2, 1);
          const r = 55 + uvIntensity * 0.55;
          ctx.save();
          const g = ctx.createRadialGradient(
            cursorPos.x,
            cursorPos.y,
            0,
            cursorPos.x,
            cursorPos.y,
            r,
          );
          g.addColorStop(0, `rgba(196,181,253,${0.6 * amt})`);
          g.addColorStop(0.45, `rgba(139,92,246,${0.28 * amt})`);
          g.addColorStop(1, "rgba(139,92,246,0)");
          ctx.fillStyle = g;
          ctx.beginPath();
          ctx.arc(cursorPos.x, cursorPos.y, r, 0, Math.PI * 2);
          ctx.fill();
          ctx.fillStyle = `rgba(233,225,255,${0.95 * amt})`;
          ctx.shadowColor = "rgba(139,92,246,.9)";
          ctx.shadowBlur = 14;
          ctx.beginPath();
          ctx.arc(cursorPos.x, cursorPos.y, 5, 0, Math.PI * 2);
          ctx.fill();
          ctx.restore();
        }
        function draw() {
          drawBackdrop();
          if (simMode === "chaser") {
            drawUVBeam();
          } else {
            drawPath();
            drawLivePreview();
          }
          drawPatrolSpiral();
          drawBot();
        }

        /* =================== DRAWING: GEAR MECHANISM INSET =================== */
        function drawGear(cx, cy, r, angle, teeth) {
          gctx.save();
          gctx.translate(cx, cy);
          gctx.rotate(angle);
          gctx.fillStyle = "#3b6ea5";
          gctx.strokeStyle = "#16263f";
          gctx.lineWidth = 1.4;
          gctx.beginPath();
          for (let i = 0; i < teeth; i++) {
            const a0 = (i / teeth) * Math.PI * 2,
              a1 = ((i + 0.5) / teeth) * Math.PI * 2;
            gctx.lineTo(Math.cos(a0) * (r + 5), Math.sin(a0) * (r + 5));
            gctx.lineTo(Math.cos(a1) * (r + 5), Math.sin(a1) * (r + 5));
          }
          gctx.closePath();
          gctx.fill();
          gctx.stroke();
          gctx.fillStyle = "#e8940f";
          gctx.beginPath();
          gctx.arc(0, 0, r * 0.4, 0, 7);
          gctx.fill();
          gctx.restore();
        }
        function drawGearMechanism() {
          gctx.clearRect(0, 0, GW, GH);
          const gearAngle = walkPhase * GEAR_RATIO;
          const cx = 34,
            cy = 48,
            r = 20;
          drawGear(cx, cy, r, gearAngle, 10);
          // crank pin on the gear
          const pinX = cx + Math.cos(gearAngle) * r * 0.85,
            pinY = cy + Math.sin(gearAngle) * r * 0.85;
          // linkage arm to a swinging leg pivot
          const pivotX = 100,
            pivotY = 48;
          gctx.strokeStyle = "#8a97ab";
          gctx.lineWidth = 3;
          gctx.lineCap = "round";
          gctx.beginPath();
          gctx.moveTo(pinX, pinY);
          gctx.lineTo(pivotX, pivotY);
          gctx.stroke();
          gctx.fillStyle = "#e8940f";
          gctx.beginPath();
          gctx.arc(pinX, pinY, 3, 0, 7);
          gctx.fill();
          // leg swinging from the pivot based on linkage angle
          const legAngle = Math.sin(gearAngle) * 0.5;
          const footX = pivotX + Math.sin(legAngle) * 36,
            footY = pivotY + Math.cos(legAngle) * 36;
          gctx.strokeStyle = "#2c4d78";
          gctx.lineWidth = 4;
          gctx.beginPath();
          gctx.moveTo(pivotX, pivotY);
          gctx.lineTo(footX, footY);
          gctx.stroke();
          gctx.fillStyle = "#16263f";
          gctx.beginPath();
          gctx.arc(pivotX, pivotY, 4, 0, 7);
          gctx.fill();
          gctx.fillStyle = "#12213f";
          gctx.beginPath();
          gctx.arc(footX, footY, 3.5, 0, 7);
          gctx.fill();
        }

        /* =================== SIMULATION STEP =================== */
        // A local point (lx forward, ly sideways) converted to world (canvas) coords
        // using the bot's real position and heading — the same convention used inside
        // the translate+rotate block in drawBot(), so sensor glow lines up with the
        // sensor's real detection point.
        function localToWorld(lx, ly) {
          const c = Math.cos(bot.heading),
            s = Math.sin(bot.heading);
          return { x: bot.x + lx * c - ly * s, y: bot.y + lx * s + ly * c };
        }
        function step(dt) {
          if (simMode === "route") {
            if (pathPoints.length < 2) {
              leftReading = 0;
              rightReading = 0;
              return;
            }
            // Advance the bot's own tracked progress along the path first, so the
            // sensor readings below search a window anchored to where it actually is.
            pathProgress = nearestPathWindowed(bot.x, bot.y).idx;
          }
          const leftPos = localToWorld(FRONT_OFFSET, -SENSOR_SPACING),
            rightPos = localToWorld(FRONT_OFFSET, SENSOR_SPACING);
          leftReading = uvReadingAt(leftPos.x, leftPos.y);
          rightReading = uvReadingAt(rightPos.x, rightPos.y);

          // Reaching the light is the "win" condition in chaser mode — freeze
          // right there (readings/eyes already reflect standing on it) instead
          // of endlessly circling on top of it.
          if (simMode === "chaser" && cursorPos.x > -1000 && !manualMode) {
            const distToLight = Math.hypot(
              bot.x - cursorPos.x,
              bot.y - cursorPos.y,
            );
            if (distToLight <= CATCH_RADIUS) {
              lightCaught = true;
              mode = "forward";
              leftSpeed = 0;
              rightSpeed = 0;
              setPaused(true);
              return;
            }
          }
          // Once a light exists in chaser mode, steer continuously toward whichever
          // sensor reads stronger instead of gating behind an absolute detection
          // threshold — an absolute threshold means "close but not quite there"
          // readings get ignored entirely and it falls back to random patrol, which
          // reads as "not detecting" even though the sensors clearly see a gradient.
          // This is what makes it track smoothly from any distance, like a real
          // heat-seeking comparison.
          const chaserHoming = simMode === "chaser" && cursorPos.x > -1000;

          if (leftReading >= threshold) detLState = true;
          else if (leftReading < threshold * 0.75) detLState = false;
          if (rightReading >= threshold) detRState = true;
          else if (rightReading < threshold * 0.75) detRState = false;
          const detL = detLState,
            detR = detRState;

          prevMode = mode;
          if (manualMode) {
            mode =
              manL > manR + 1 ? "left" : manR > manL + 1 ? "right" : "forward";
          } else if (chaserHoming) {
            const diff = rightReading - leftReading;
            const cand = Math.abs(diff) < 2 ? "forward" : diff > 0 ? "right" : "left";
            if (cand === candidateMode) candidateTime += dt;
            else {
              candidateMode = cand;
              candidateTime = 0;
            }
            if (candidateTime >= MODE_HOLD) mode = candidateMode;
          } else {
            let cand;
            if (detL && detR) cand = "forward";
            else if (detL && !detR) cand = "left";
            else if (!detL && detR) cand = "right";
            else cand = "patrol";
            if (cand === candidateMode) candidateTime += dt;
            else {
              candidateMode = cand;
              candidateTime = 0;
            }
            if (candidateTime >= MODE_HOLD) mode = candidateMode;
          }

          if (manualMode) {
            leftSpeed = manL;
            rightSpeed = manR;
          } else if (chaserHoming) {
            // Continuous proportional turn — NOT threshold-gated — so even a
            // subtle left/right difference biases the heading immediately.
            // Same inverted convention as the discrete "left"/"right" cases
            // above: the STRONGER side's motor runs faster, not slower.
            const diff = rightReading - leftReading;
            const turnGain = 1.1;
            leftSpeed = clamp(walkSpeed - diff * turnGain, 10, MAX_SPEED);
            rightSpeed = clamp(walkSpeed + diff * turnGain, 10, MAX_SPEED);
          } else if (mode === "forward") {
            leftSpeed = walkSpeed;
            rightSpeed = walkSpeed;
          } else if (mode === "left") {
            // Canvas Y is flipped vs. standard math axes, so — unlike the usual
            // "outer wheel faster" rule of thumb — turning toward the LEFT sensor
            // here means the LEFT side needs to be the faster one, not the slower.
            leftSpeed = walkSpeed * 1.4;
            rightSpeed = walkSpeed * 0.4;
          } else if (mode === "right") {
            leftSpeed = walkSpeed * 0.4;
            rightSpeed = walkSpeed * 1.4;
          } else {
            leftSpeed = walkSpeed * 0.4;
            rightSpeed = walkSpeed * 0.4;
          }

          if (!manualMode && mode === "patrol" && prevMode !== "patrol") {
            patrolTime = 0;
            patrolAngle = 0;
            patrolRadius = 0;
            patrolCenter = { x: bot.x, y: bot.y };
          }

          if (!manualMode && mode === "patrol") {
            // A real widening spiral, centred where the signal was lost — radius grows
            // over ~5s up to spiralMax, tracing an actual outward search on screen.
            patrolTime += dt;
            patrolAngle += dt * 1.6;
            patrolRadius = Math.min(spiralMax, spiralMax * (patrolTime / 5));
            bot.x = patrolCenter.x + Math.cos(patrolAngle) * patrolRadius;
            bot.y = patrolCenter.y + Math.sin(patrolAngle) * patrolRadius;
            bot.heading = patrolAngle + Math.PI / 2;
          } else {
            const angularVel = (rightSpeed - leftSpeed) / WHEELBASE;
            bot.heading += angularVel * dt;
            const fwd = (leftSpeed + rightSpeed) / 2;
            bot.x += Math.cos(bot.heading) * fwd * dt;
            bot.y += Math.sin(bot.heading) * fwd * dt;

            // Bounce off the wall instead of just clamping position — clamping
            // alone left the heading unchanged, so the bot kept re-aiming into
            // the same wall every frame and scraped along it (worse in a
            // corner, where it could get stuck grinding against both walls).
            // Reflecting whichever axis actually hit turns it back into the
            // floor; hitting both axes at once (a corner) turns it fully around.
            const preClampX = bot.x,
              preClampY = bot.y;
            bot.x = clamp(bot.x, 20, W - 20);
            bot.y = clamp(bot.y, 20, H - 20);
            const hitX = bot.x !== preClampX,
              hitY = bot.y !== preClampY;
            if (hitX || hitY) {
              let vx = Math.cos(bot.heading),
                vy = Math.sin(bot.heading);
              if (hitX) vx = -vx;
              if (hitY) vy = -vy;
              bot.heading = Math.atan2(vy, vx);
            }
          }
          bot.x = clamp(bot.x, 20, W - 20);
          bot.y = clamp(bot.y, 20, H - 20);

          distance += ((leftSpeed + rightSpeed) / 2) * dt;
          walkPhase += ((leftSpeed + rightSpeed) / 2) * dt * LEG_RATE;
        }

        /* =================== DASHBOARD =================== */
        const MODE_TEXT = {
          forward: "Both sensors see UV — moving forward",
          left: "Left sensor sees UV — turning left",
          right: "Right sensor sees UV — turning right",
          patrol: "Signal lost — spiral patrol searching",
        };
        function renderDash() {
          const lp = clamp(leftReading, 0, 100),
            rp = clamp(rightReading, 0, 100);
          els.leftVal.textContent = Math.round(lp) + "%";
          els.leftFill.style.width = lp + "%";
          els.leftFill.style.background =
            lp >= threshold
              ? "linear-gradient(90deg,#c4b5fd,#8b5cf6)"
              : "linear-gradient(90deg,#cbd5e1,#94a3b8)";
          els.leftThr.style.left = threshold + "%";
          els.rightVal.textContent = Math.round(rp) + "%";
          els.rightFill.style.width = rp + "%";
          els.rightFill.style.background =
            rp >= threshold
              ? "linear-gradient(90deg,#c4b5fd,#8b5cf6)"
              : "linear-gradient(90deg,#cbd5e1,#94a3b8)";
          els.rightThr.style.left = threshold + "%";

          const noPath =
            simMode === "route"
              ? pathPoints.length < 2
              : cursorPos.x < -1000;
          const detL = lp >= threshold,
            detR = rp >= threshold;
          const lw = detL ? "High" : "Low",
            rw = detR ? "High" : "Low";
          els.compareTxt.textContent = noPath
            ? simMode === "route"
              ? "No path drawn yet"
              : "No UV light detected — move your mouse over the floor"
            : manualMode
              ? "Manual override active — sensors ignored"
              : `Left ${lw} · Right ${rw} → ${MODE_TEXT[mode].split("—")[1]?.trim() || MODE_TEXT[mode]}`;

          els.lMotorVal.textContent = Math.round(leftSpeed);
          els.lMotorFill.style.width = (leftSpeed / MAX_SPEED) * 100 + "%";
          els.lMotorFill.style.background =
            "linear-gradient(90deg,#93c5fd,#2563eb)";
          els.rMotorVal.textContent = Math.round(rightSpeed);
          els.rMotorFill.style.width = (rightSpeed / MAX_SPEED) * 100 + "%";
          els.rMotorFill.style.background =
            "linear-gradient(90deg,#93c5fd,#2563eb)";

          const modeLabel = {
            forward: "Forward",
            left: "Turning Left",
            right: "Turning Right",
            patrol: "Patrol Mode",
          }[mode];
          els.statMode.textContent = lightCaught
            ? "Caught!"
            : noPath
              ? simMode === "route"
                ? "No Path"
                : "No Light"
              : modeLabel;
          els.statMode.className =
            "v " +
            (lightCaught
              ? "g"
              : noPath
              ? "n"
              : mode === "forward"
                ? "a"
                : mode === "patrol"
                  ? "u"
                  : "g");
          els.statPattern.textContent = noPath
            ? "Idle"
            : mode === "patrol"
              ? "Spiral Scanning"
              : "Idle";
          els.statPattern.className =
            "v " + (!noPath && mode === "patrol" ? "u" : "n");
          els.statDist.textContent = Math.round(distance) + " u";
          els.statGear.textContent =
            Math.round(((walkPhase * GEAR_RATIO * 180) / Math.PI) % 360) + "°";

          if (lightCaught) {
            els.modeTxt.textContent =
              "UV light reached! Press Start to chase it again.";
            els.modeChip.textContent = "LIGHT CAUGHT";
            els.modeChip.className = "chip caught";
          } else if (noPath) {
            els.modeTxt.textContent =
              simMode === "route"
                ? "Draw a path on the floor to begin"
                : "Move your mouse over the floor to create a UV light";
            els.modeChip.textContent =
              simMode === "route" ? "NO PATH" : "NO LIGHT";
            els.modeChip.className = "chip";
          } else if (paused) {
            els.modeTxt.textContent = started
              ? "Paused"
              : "Ready — press Start";
            els.modeChip.textContent = started ? "PAUSED" : "READY";
            els.modeChip.className = "chip";
          } else {
            els.modeTxt.textContent = manualMode
              ? "Manual motor test — direction from speed difference"
              : MODE_TEXT[mode];
            els.modeChip.textContent = modeLabel.toUpperCase();
            els.modeChip.className =
              "chip" + (mode === "patrol" ? " patrol" : "");
          }
        }

        /* =================== MAIN LOOP =================== */
        let last = performance.now();
        function frame(now) {
          const dt = Math.min(0.05, (now - last) / 1000);
          last = now;
          if (!paused) step(dt);
          draw();
          drawGearMechanism();
          renderDash();
          requestAnimationFrame(frame);
        }
        requestAnimationFrame(frame);
      })();
    </script>
  </body>
</html>
