<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Heartbeat DJ Bot — Crew Calmness Music Simulation</title>
    <link rel="icon" type="image/png" href="../../../assets/logo.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Orbitron:wght@600;700;800&family=Rajdhani:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <style>
      :root {
        --bg: #eef3fb;
        --panel: #ffffff;
        --panel2: #f3f8ff;
        --line: #dce6f5;
        --txt: #18233a;
        --mut: #5a6d8c;
        --dim: #95a7c4;
        --accent: #2563eb;
        --accent2: #38bdf8;
        --hr: #ff4d6d;
        --hr2: #ffa8b8;
        --snd: #f59e0b;
        --snd2: #fcd34d;
        --mus: #8b5cf6;
        --mus2: #c4b5fd;
        --warn: #f7a23b;
        --danger: #ff5470;
        --ok: #22c55e;
        --shadow: 0 12px 34px rgba(40, 70, 140, 0.14);
        --r: 20px;
        --head: "Orbitron", sans-serif;
        --body: "Rajdhani", sans-serif;
      }
      * {
        box-sizing: border-box;
      }
      html,
      body {
        margin: 0;
        height: 100%;
      }
      body {
        font-family: var(--body);
        font-size: 15.5px;
        font-weight: 500;
        color: var(--txt);
        background:
          radial-gradient(900px 500px at 6% -8%, #ffe9ef 0, transparent 60%),
          radial-gradient(900px 600px at 102% 0%, #efe7ff 0, transparent 55%),
          linear-gradient(180deg, #f3f7fd, #e9f0fb);
        height: 100vh;
        overflow: hidden;
        padding: 10px clamp(10px, 2vw, 26px);
        display: flex;
        flex-direction: column;
      }
      h1,
      h3,
      h4,
      .chip,
      .modebanner .lab,
      .glab,
      .mx-h,
      .mx-v,
      .frame {
        font-family: var(--head);
      }
      /* Title dead centre, help buttons right. Column 1 is an empty 1fr that
         mirrors column 3, so the middle column stays on the header's true
         midpoint instead of being pushed left by the buttons. */
      header.top {
        display: grid;
        grid-template-columns: 1fr auto 1fr;
        align-items: center;
        gap: 12px;
        margin-bottom: 6px;
        flex: 0 0 auto;
        position: relative;
      }
      .title {
        grid-column: 2;
        text-align: center;
        min-width: 0;
      }
      .title h1 {
        margin: 0;
        font-size: 19px;
        font-weight: 800;
        letter-spacing: 1px;
        color: #12213f;
      }
      .helpbtns {
        grid-column: 3;
        justify-self: end;
        display: flex;
        gap: 8px;
      }
      /* Narrow: buttons on their own row, title centred beneath them. */
      @media (max-width: 760px) {
        header.top {
          grid-template-columns: 1fr;
        }
        .helpbtns {
          grid-row: 1;
          grid-column: 1;
        }
        .title {
          grid-row: 2;
          grid-column: 1;
        }
      }
      .helpbtn {
        cursor: pointer;
        font-weight: 700;
        color: #fff;
        font-family: var(--head);
        font-size: 12.5px;
        letter-spacing: 0.3px;
        background: linear-gradient(145deg, #ff7d95, var(--hr));
        border: none;
        padding: 10px 16px;
        border-radius: 12px;
        box-shadow: 0 8px 18px rgba(255, 77, 109, 0.32);
        transition: 0.15s;
      }
      .helpbtn:hover {
        transform: translateY(-2px);
      }
      .helpbtn.on {
        box-shadow:
          inset 0 0 0 2px #fff,
          0 8px 18px rgba(255, 77, 109, 0.32);
      }
      .helpbar {
        display: none;
        background: var(--panel);
        border: 1px solid var(--line);
        border-radius: 16px;
        box-shadow: var(--shadow);
        padding: 14px 16px;
        font-size: 14.5px;
        line-height: 1.55;
        color: var(--txt);
        position: absolute;
        right: 0;
        top: 56px;
        width: 430px;
        max-width: min(430px, 90vw);
        max-height: 75vh;
        overflow-y: auto;
        z-index: 40;
      }
      .helpbar.show {
        display: block;
      }
      @media (max-width: 1280px) {
        .helpbar {
          position: static;
          width: auto;
          max-width: none;
          margin-top: 8px;
          /* No longer absolutely positioned, so it is a grid item now and has
             to span the full header instead of dropping into a side column. */
          grid-column: 1 / -1;
        }
      }
      .tabpanel {
        display: none;
      }
      .tabpanel.on {
        display: block;
      }
      .tabpanel ol,
      .tabpanel ul {
        margin: 0;
        padding-left: 20px;
      }
      .tabpanel li {
        margin-bottom: 5px;
      }

      .grid {
        display: grid;
        grid-template-columns: 316px 1fr 352px;
        gap: 12px;
        align-items: stretch;
        flex: 1 1 auto;
        min-height: 0;
      }
      @media (max-width: 1280px) {
        body {
          overflow: auto;
        }
        .grid {
          grid-template-columns: 1fr;
          flex: 0 0 auto;
        }
        /* Single-column: the stage card is no longer height-bounded, so the pod
           needs an explicit height instead of "whatever is left over". */
        .stagewrap {
          flex: 0 0 auto;
          height: clamp(300px, 52vw, 440px);
        }
      }
      .card {
        background: var(--panel);
        border: 1px solid var(--line);
        border-radius: var(--r);
        box-shadow: var(--shadow);
        padding: 14px;
        overflow-y: auto;
        overflow-x: hidden;
        min-height: 0;
      }
      .card.stage {
        display: flex;
        flex-direction: column;
        align-items: stretch;
        justify-content: flex-start;
        overflow: hidden;
        padding: 10px;
        gap: 8px;
      }
      .card h3 {
        margin: 0 0 3px;
        font-size: 14.5px;
        font-weight: 700;
        letter-spacing: 0.7px;
        text-transform: uppercase;
        color: #12213f;
      }
      .card .sub {
        font-size: 12.5px;
        color: var(--mut);
        margin: 0 0 8px;
        line-height: 1.4;
      }

      .cmdgroup {
        margin-bottom: 14px;
      }
      .cmdgroup h4 {
        margin: 0 0 6px;
        font-size: 11px;
        letter-spacing: 0.6px;
        color: var(--accent);
        text-transform: uppercase;
      }
      .cmdgroup.hr h4 {
        color: var(--hr);
      }
      .cmdgroup.sn h4 {
        color: #c2740a;
      }
      .cmdgroup.mu h4 {
        color: var(--mus);
      }
      .seg {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 6px;
        margin-bottom: 6px;
      }
      .seg.three {
        grid-template-columns: 1fr 1fr 1fr;
      }
      .seg button {
        cursor: pointer;
        border: 2px solid var(--line);
        background: #fff;
        color: var(--mut);
        padding: 8px 6px;
        border-radius: 11px;
        font-size: 12.5px;
        font-weight: 700;
        transition: 0.15s;
        font-family: var(--body);
      }
      .seg button:hover {
        border-color: var(--accent2);
      }
      .seg button.on {
        color: #fff;
        border-color: transparent;
        background: linear-gradient(145deg, #93c5fd, var(--accent));
        box-shadow: 0 8px 18px rgba(37, 99, 235, 0.3);
      }
      .seg.hr button.on {
        background: linear-gradient(145deg, var(--hr2), var(--hr));
        box-shadow: 0 8px 18px rgba(255, 77, 109, 0.35);
      }
      .seg.sn button.on {
        background: linear-gradient(145deg, var(--snd2), var(--snd));
        box-shadow: 0 8px 18px rgba(245, 158, 11, 0.35);
      }
      .seg.mu button.on {
        background: linear-gradient(145deg, var(--mus2), var(--mus));
        box-shadow: 0 8px 18px rgba(139, 92, 246, 0.35);
      }
      .toggle {
        display: flex;
        gap: 8px;
        margin-bottom: 8px;
      }
      .toggle button {
        flex: 1;
        cursor: pointer;
        border: 2px solid var(--line);
        background: #fff;
        color: var(--mut);
        padding: 8px 6px;
        border-radius: 11px;
        font-size: 12.5px;
        font-weight: 700;
        transition: 0.15s;
        font-family: var(--body);
      }
      .toggle button.on {
        color: #fff;
        border-color: transparent;
        background: linear-gradient(145deg, #54c48a, #3fb87a);
        box-shadow: 0 8px 18px rgba(84, 196, 138, 0.35);
      }

      .ctrl {
        margin: 10px 0;
      }
      .ctrl .row {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        margin-bottom: 5px;
      }
      .ctrl label {
        font-size: 13px;
        font-weight: 600;
        color: var(--txt);
      }
      .ctrl .val {
        font-family: var(--head);
        font-size: 12px;
        color: var(--accent);
        font-weight: 700;
        font-variant-numeric: tabular-nums;
      }
      input[type="range"] {
        -webkit-appearance: none;
        width: 100%;
        height: 9px;
        border-radius: 10px;
        outline: none;
        background: linear-gradient(90deg, var(--accent2), var(--accent))
          no-repeat;
        background-size: var(--fill, 50%) 100%;
        box-shadow: inset 0 0 0 2px var(--line);
        cursor: pointer;
      }
      input[type="range"].hrr {
        background: linear-gradient(90deg, var(--hr2), var(--hr)) no-repeat;
        background-size: var(--fill, 50%) 100%;
      }
      input[type="range"].snr {
        background: linear-gradient(90deg, var(--snd2), var(--snd)) no-repeat;
        background-size: var(--fill, 50%) 100%;
      }
      input[type="range"].mur {
        background: linear-gradient(90deg, var(--mus2), var(--mus)) no-repeat;
        background-size: var(--fill, 50%) 100%;
      }
      input[type="range"]::-webkit-slider-thumb {
        -webkit-appearance: none;
        width: 19px;
        height: 19px;
        border-radius: 50%;
        background: #fff;
        border: 4px solid var(--accent);
        box-shadow: 0 3px 8px rgba(0, 0, 0, 0.18);
        cursor: grab;
      }
      input[type="range"].hrr::-webkit-slider-thumb {
        border-color: var(--hr);
      }
      input[type="range"].snr::-webkit-slider-thumb {
        border-color: var(--snd);
      }
      input[type="range"].mur::-webkit-slider-thumb {
        border-color: var(--mus);
      }
      input[type="range"]::-moz-range-thumb {
        width: 17px;
        height: 17px;
        border-radius: 50%;
        background: #fff;
        border: 4px solid var(--accent);
        cursor: grab;
      }
      input[type="range"].hrr::-moz-range-thumb {
        border-color: var(--hr);
      }
      input[type="range"].snr::-moz-range-thumb {
        border-color: var(--snd);
      }
      input[type="range"].mur::-moz-range-thumb {
        border-color: var(--mus);
      }
      .hint {
        font-size: 11.5px;
        color: var(--dim);
        margin-top: 4px;
        line-height: 1.35;
      }

      canvas {
        max-width: 100%;
        display: block;
      }
      /* The pod owns every pixel the graphs and banner don't need. Its backing
         store is re-cut to match, so stretching never distorts the drawing. */
      .stagewrap {
        flex: 1 1 auto;
        width: 100%;
        min-height: 190px;
        border-radius: 14px;
        overflow: hidden;
      }
      #pod {
        width: 100%;
        height: 100%;
        border-radius: 14px;
        background: #070c1a;
        touch-action: none;
        box-shadow: inset 0 0 0 1px #1d2a44;
      }

      .graphrow {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 8px;
        flex: 0 0 auto;
      }
      @media (max-width: 620px) {
        .graphrow {
          grid-template-columns: 1fr;
        }
      }
      .gcard {
        background: linear-gradient(160deg, #101a30, #0a1122);
        border: 1.5px solid #24314e;
        border-radius: 13px;
        padding: 5px 7px 4px;
        flex: 0 0 auto;
        min-width: 0;
      }
      .glab {
        display: block;
        font-size: 9px;
        letter-spacing: 0.7px;
        color: #7d93bb;
        font-weight: 700;
        text-transform: uppercase;
        margin-bottom: 2px;
      }
      .gcard canvas {
        width: 100%;
        height: clamp(60px, 9vh, 96px);
        border-radius: 7px;
        display: block;
      }

      .modebanner {
        width: 100%;
        padding: 9px 14px;
        border-radius: 14px;
        background: linear-gradient(145deg, #f4efff, #e9e0fb);
        border: 2px solid #ddd0f7;
        display: flex;
        flex: 0 0 auto;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        transition:
          background 0.35s,
          border-color 0.35s;
      }
      .modebanner .lab {
        font-size: 11px;
        color: var(--mus);
        letter-spacing: 0.5px;
        font-weight: 700;
      }
      .modebanner .txt {
        font-size: 14px;
        font-weight: 700;
        color: #2a1f45;
        margin-top: 2px;
      }
      .modebanner .chip {
        font-size: 11px;
        color: #fff;
        font-weight: 800;
        white-space: nowrap;
        padding: 6px 12px;
        border-radius: 9px;
        background: linear-gradient(145deg, var(--mus2), var(--mus));
        transition: background 0.35s;
      }

      .stage-foot {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
        justify-content: center;
        flex: 0 0 auto;
      }
      .btn {
        cursor: pointer;
        border: 2px solid var(--line);
        background: #fff;
        color: var(--txt);
        padding: 8px 13px;
        border-radius: 11px;
        font-size: 13.5px;
        font-weight: 600;
        transition: 0.15s;
        font-family: var(--body);
      }
      .btn:hover {
        transform: translateY(-2px);
        border-color: var(--accent2);
      }
      .btn.startstop {
        background: linear-gradient(145deg, #4ade80, #16a34a);
        border-color: transparent;
        color: #fff;
        font-weight: 800;
        min-width: 150px;
        box-shadow: 0 8px 18px rgba(22, 163, 74, 0.3);
      }
      .btn.startstop.on {
        background: linear-gradient(145deg, #f87171, #dc2626);
        box-shadow: 0 8px 18px rgba(220, 38, 38, 0.3);
      }
      .btn:disabled {
        opacity: 0.45;
        cursor: not-allowed;
        transform: none;
        border-color: var(--line);
      }
      .btn.pause.on {
        background: linear-gradient(145deg, #93c5fd, var(--accent));
        border-color: transparent;
        color: #fff;
        box-shadow: 0 8px 18px rgba(37, 99, 235, 0.35);
      }

      /* ---------- situation matrix ---------- */
      .matrix {
        display: grid;
        grid-template-columns: 46px 1fr 1fr;
        gap: 5px;
        margin: 6px 0 5px;
      }
      .mx-h,
      .mx-v {
        font-size: 8.5px;
        letter-spacing: 0.4px;
        color: var(--dim);
        font-weight: 700;
        display: grid;
        place-items: center;
        text-align: center;
        line-height: 1.25;
      }
      .quad {
        background: var(--panel2);
        border: 1.5px solid var(--line);
        border-radius: 11px;
        padding: 7px 8px;
        transition: 0.25s;
      }
      .quad .qm {
        font-size: 12.5px;
        font-weight: 700;
        color: var(--mut);
      }
      .quad .qd {
        font-size: 10.5px;
        color: var(--dim);
        line-height: 1.3;
        margin-top: 2px;
      }
      .quad.on {
        border-color: transparent;
        box-shadow: 0 8px 18px rgba(40, 70, 140, 0.2);
        transform: translateY(-1px);
      }
      .quad.on .qm,
      .quad.on .qd {
        color: #fff;
      }
      .quad.recov {
        margin-top: 5px;
        display: flex;
        align-items: center;
        gap: 8px;
        justify-content: space-between;
      }

      .reading {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 6px 0;
        border-bottom: 1.5px dashed var(--line);
        font-size: 13px;
      }
      .reading:last-child {
        border-bottom: none;
      }
      .reading .k {
        color: var(--mut);
      }
      .reading .v {
        font-weight: 700;
        font-size: 13px;
      }
      .hbar {
        height: 14px;
        border-radius: 8px;
        background: var(--panel2);
        border: 1.5px solid var(--line);
        position: relative;
        overflow: hidden;
        margin: 4px 0 8px;
      }
      .hbar .fill {
        position: absolute;
        inset: 0 auto 0 0;
        width: 0;
        border-radius: 7px;
        transition:
          width 0.12s,
          background 0.2s;
      }
      .hbar .mark {
        position: absolute;
        top: -2px;
        bottom: -2px;
        width: 2px;
        background: #34405c;
        opacity: 0.75;
      }

      .statusgrid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 6px;
        margin-top: 8px;
      }
      .stat {
        background: var(--panel2);
        border: 1.5px solid var(--line);
        border-radius: 10px;
        padding: 6px 8px;
      }
      .stat .k {
        font-size: 10.5px;
        color: var(--dim);
        text-transform: uppercase;
        letter-spacing: 0.4px;
        font-weight: 700;
      }
      .stat .v {
        font-size: 14px;
        font-weight: 700;
        margin-top: 2px;
      }
      .stat .v.g {
        color: var(--ok);
      }
      .stat .v.u {
        color: var(--mus);
      }
      .stat .v.n {
        color: var(--mut);
      }
      .stat .v.a {
        color: var(--accent);
      }
      .stat .v.w {
        color: var(--warn);
      }
      .stat .v.d {
        color: var(--danger);
      }
      .stat .v.h {
        color: var(--hr);
      }

      /* ---------- DFPlayer + SD card ---------- */
      .module {
        background: linear-gradient(160deg, #1c2740, #111a2e);
        border: 2px solid #2b3a58;
        border-radius: 14px;
        padding: 9px 11px;
        margin-top: 6px;
      }
      .module .mrow {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        font-size: 12.5px;
        padding: 3px 0;
        gap: 8px;
      }
      .module .mk {
        color: #7d93bb;
        font-weight: 600;
      }
      .module .mv {
        color: #e6f0ff;
        font-weight: 700;
        text-align: right;
        word-break: break-all;
      }
      .module .mv.play {
        color: #6ee7b7;
      }
      .module .mv.chg {
        color: #fcd34d;
      }
      .module .mv.stop {
        color: #94a3b8;
      }
      .frame {
        margin-top: 7px;
        background: #05090f;
        border: 1.5px solid #1d2a44;
        border-radius: 9px;
        padding: 7px 8px;
        font-size: 12px;
        letter-spacing: 1.2px;
        color: #7fe3c2;
        font-weight: 700;
        text-align: center;
        word-spacing: 3px;
      }
      .frame b {
        color: #ffd166;
      }
      .frame i {
        color: #ff8fa6;
        font-style: normal;
      }
      .framenote {
        font-size: 10.5px;
        color: #7d93bb;
        text-align: center;
        margin-top: 4px;
        line-height: 1.35;
      }

      .sd {
        margin-top: 7px;
        border-radius: 10px;
        overflow: hidden;
        border: 1.5px solid #24314e;
      }
      .sdf {
        display: flex;
        align-items: center;
        gap: 7px;
        padding: 5px 8px;
        font-size: 11.5px;
        color: #9fb4d8;
        background: #0d1526;
        border-bottom: 1px solid #1a2439;
        transition: 0.2s;
      }
      .sdf:last-child {
        border-bottom: none;
      }
      .sdf .no {
        font-family: var(--head);
        font-size: 9.5px;
        color: #64789e;
        flex: 0 0 auto;
      }
      .sdf .fn {
        flex: 1 1 auto;
        min-width: 0;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
      }
      .sdf .tag {
        font-size: 9px;
        letter-spacing: 0.3px;
        color: #64789e;
        flex: 0 0 auto;
      }
      .sdf.on {
        background: #16233d;
        color: #e6f0ff;
      }
      .sdf.on .no,
      .sdf.on .tag {
        color: #ffd166;
      }

      /* ---------- speaker ---------- */
      .spk {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-top: 6px;
      }
      .spk canvas {
        flex: 0 0 auto;
        width: 72px;
        height: 72px;
        border-radius: 12px;
        background: #0d1526;
        border: 2px solid #24314e;
      }
      .spk .swave {
        flex: 1 1 auto;
        min-width: 0;
      }
      .spk .swave canvas {
        width: 100%;
        height: 46px;
        border-radius: 9px;
        background: #0d1526;
        border: 1.5px solid #24314e;
      }
      .spk .sinfo {
        font-size: 10.5px;
        color: var(--dim);
        margin-top: 4px;
        line-height: 1.3;
      }

      /* ---------- feedback log ---------- */
      .log {
        margin-top: 6px;
        display: flex;
        flex-direction: column;
        gap: 5px;
      }
      .logline {
        background: var(--panel2);
        border: 1.5px solid var(--line);
        border-left: 4px solid var(--accent);
        border-radius: 9px;
        padding: 6px 9px;
        font-size: 12.5px;
        line-height: 1.35;
        color: var(--txt);
      }
      .logline .t {
        font-family: var(--head);
        font-size: 9.5px;
        color: var(--dim);
        margin-right: 6px;
      }
      .logline.ok {
        border-left-color: var(--ok);
        background: #f0fbf5;
      }
      .logline.warn {
        border-left-color: var(--warn);
        background: #fff8ec;
      }
      .logline.bad {
        border-left-color: var(--danger);
        background: #fff1f4;
      }
      .logline.mus {
        border-left-color: var(--mus);
        background: #f7f3ff;
      }
      .logline.fade {
        opacity: 0.55;
      }
    
      /* Floating, draggable & resizable Guide / How to Use window */
      .helpwrap {
        position: fixed;
        top: 14px;
        right: clamp(12px, 2.4vw, 30px);
        z-index: 40;
        display: flex;
        flex-direction: column;
        align-items: center;
      }
      .helpbtns {
        display: flex;
        gap: 8px;
        justify-content: center;
        flex-wrap: wrap;
      }
      .helpbtn {
        appearance: none;
        cursor: pointer;
        font-family: var(--head, "Orbitron", sans-serif);
        font-weight: 700;
        font-size: 12px;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: #fff;
        background: var(--sky, #2a78d6);
        border: 1px solid var(--sky, #2a78d6);
        border-radius: 8px;
        padding: 8px 14px;
        box-shadow: 0 6px 14px rgba(42, 120, 214, 0.24);
        transition: transform 0.15s ease, background 0.15s ease;
      }
      .helpbtn:hover {
        transform: translateY(-1px);
      }
      .helpbtn:focus-visible {
        outline: 2px solid var(--txt, #17293b);
        outline-offset: 2px;
      }
      .helpbtn.on {
        background: var(--accent, #e8590c) !important;
        border-color: var(--accent, #e8590c) !important;
        box-shadow: 0 6px 14px rgba(232, 89, 12, 0.26);
      }
      .helpbar.floatwin {
        position: fixed !important;
        z-index: 10000 !important;
        display: none;
        flex-direction: column !important;
        background: var(--panel, #fcfdfe) !important;
        border: 1px solid var(--line, #dbe2e8) !important;
        border-radius: var(--r, 10px) !important;
        box-shadow: 0 18px 45px rgba(23, 41, 59, 0.28) !important;
        overflow: hidden !important;
        min-width: 280px !important;
        min-height: 200px !important;
        margin: 0 !important;
        padding: 0 !important;
        max-width: calc(100vw - 16px) !important;
        max-height: calc(100vh - 16px) !important;
      }
      .helpbar.floatwin.show {
        display: flex !important;
      }
      .fw-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
        padding: 8px 12px;
        background: var(--panel2, #f3f6f8);
        border-bottom: 1px solid var(--line, #dbe2e8);
        cursor: move;
        user-select: none;
        -webkit-user-select: none;
        touch-action: none;
        flex: 0 0 auto;
      }
      .fw-title {
        font-family: var(--head, "Orbitron", sans-serif);
        font-size: 11.5px;
        font-weight: 700;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--mut, #4c5c6b);
        display: flex;
        align-items: center;
        gap: 6px;
      }
      .fw-title::before {
        content: "⠿";
        font-size: 13px;
        color: var(--dim, #8a949d);
      }
      .fw-head-actions {
        display: flex;
        align-items: center;
        gap: 6px;
      }
      .fw-tab-btn {
        appearance: none;
        cursor: pointer;
        font-family: var(--head, "Orbitron", sans-serif);
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        padding: 4px 8px;
        border-radius: 5px;
        border: 1px solid var(--line, #dbe2e8);
        background: var(--panel, #fff);
        color: var(--mut, #4c5c6b);
        transition: 0.15s ease;
      }
      .fw-tab-btn:hover {
        border-color: var(--dim, #8a949d);
        color: var(--txt, #17293b);
      }
      .fw-tab-btn.on {
        background: var(--accent, #e8590c) !important;
        border-color: var(--accent, #e8590c) !important;
        color: #fff !important;
      }
      .fw-close {
        cursor: pointer;
        width: 24px;
        height: 24px;
        border-radius: 6px;
        border: 1px solid var(--line, #dbe2e8);
        background: var(--panel, #fff);
        color: var(--mut, #4c5c6b);
        font-size: 12px;
        font-weight: 700;
        line-height: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: 0.15s ease;
      }
      .fw-close:hover {
        background: #fbe7e7;
        border-color: #f0c4c4;
        color: #8a1f1f;
      }
      .fw-body {
        flex: 1 1 auto;
        min-height: 0;
        padding: 14px 16px;
        overflow-y: auto;
        font-size: 13px;
        line-height: 1.5;
        color: var(--txt, #17293b);
      }
      .fw-body ol, .fw-body ul {
        margin: 0;
        padding-left: 20px;
      }
      .fw-body li {
        margin-bottom: 6px;
      }
      .fw-body li:last-child {
        margin-bottom: 0;
      }
      .fw-body b {
        color: var(--sky, #2a78d6);
      }
      .fw-grip {
        position: absolute;
        right: 0;
        bottom: 0;
        width: 16px;
        height: 16px;
        cursor: nwse-resize;
        touch-action: none;
        background: linear-gradient(135deg, transparent 50%, var(--dim, #8a949d) 50%, var(--dim, #8a949d) 58%, transparent 58%, transparent 70%, var(--dim, #8a949d) 70%, var(--dim, #8a949d) 78%, transparent 78%);
      }
      .floatwin.dragging {
        opacity: 0.94;
      }
      .tabpanel {
        display: none;
      }
      .tabpanel.on {
        display: block;
      }
      .tabpanel ol, .tabpanel ul {
        margin: 0;
        padding-left: 20px;
      }
      .tabpanel li {
        margin-bottom: 6px;
      }
      .tabpanel li:last-child {
        margin-bottom: 0;
      }
      .tabpanel b {
        color: var(--sky, #2a78d6);
      }
      @media (max-width: 900px) {
        .helpwrap {
          position: static;
          align-items: stretch;
          margin-bottom: 10px;
          flex: 0 0 auto;
        }
      }
      @media (prefers-reduced-motion: reduce) {
        .helpbtn {
          transition: none;
        }
      }

    </style>

  <style id="lof-bg">
    /* Module theme: the embedded background sheet is the page and module background.
       Module text is recoloured through the sim's own variables; buttons keep their original palette. */
    :root { --bp: url("data:image/jpeg;base64,"); }
    html { background: #1c2249; }
    body { background: #1c2249 var(--bp) center / cover no-repeat fixed !important; }

    /* title sits on the sheet */
    .title h1 {
      color: #eef2ff !important;
      text-shadow: 0 1px 3px rgba(0, 0, 0, .45);
    }
    .title p { color: rgba(214, 224, 255, .82) !important; }

    /* modules: the same sheet seen through a tint so text stays readable */
    .card {
      background:
        linear-gradient(rgba(14, 17, 44, .74), rgba(14, 17, 44, .74)) fixed,
        #1c2249 var(--bp) center / cover no-repeat fixed !important;
      border-color: rgba(140, 160, 255, .3) !important;
      box-shadow: 0 10px 28px rgba(0, 0, 0, .35) !important;
      --txt: #e8ecff;
      --mut: rgba(220,228,255,.8);
      --dim: rgba(220,228,255,.56);
      --line: rgba(140,160,255,.25);
      --panel2: rgba(8,10,30,.45);
      --accent: #7ea6ff;
      color: var(--txt);
    }
    .card::-webkit-scrollbar { width: 8px; }
    .card::-webkit-scrollbar-thumb { background: rgba(232, 220, 192, .25); border-radius: 4px; }

    /* buttons keep the original light palette inside the dark modules */
    .card button,
    .card .btn {
      --txt: #18233a;
      --mut: #5a6d8c;
      --dim: #95a7c4;
      --line: #dce6f5;
      --panel2: #f3f8ff;
      --accent: #2563eb;
      --panel: #ffffff;
    }
    .card h3 { color: var(--txt) !important; }
    .logline, #banner {
      --txt: #18233a;
      --mut: #5a6d8c;
      --dim: #95a7c4;
      --line: #dce6f5;
      --panel2: #f3f8ff;
      --accent: #2563eb;
      --panel: #ffffff;
      color: #18233a;
    }
    #banner { background-color: #ffffff !important; }
  </style>
  <style id="lof-guide">
    /* guide pop-up: tabs centred in the header, grip pinned left, close button pinned right */
    .fw-head { position: relative; }
    .fw-head-actions { flex: 1; justify-content: center; }
    .fw-head .fw-title { position: absolute; left: 12px; }
    .fw-head .fw-close { position: absolute; right: 12px; top: 50%; transform: translateY(-50%); }
    /* when the window is dragged very narrow there is no room to centre: sit the tabs beside the grip */
    .helpbar.floatwin { container-type: inline-size; }
    @container (max-width: 340px) {
      .fw-head-actions { justify-content: flex-start; min-width: 0; padding: 0 32px 0 20px; }
    }
  </style>
  <style id="lof-revamp">
    /* ---------- dark controls: buttons sit on the glass cards ---------- */
    .card .seg button,
    .card .toggle button,
    .card .btn:not(.startstop) {
      background: rgba(10, 14, 38, 0.55) !important;
      border: 1.5px solid rgba(140, 160, 255, 0.28) !important;
      color: rgba(226, 232, 255, 0.86) !important;
      box-shadow: none !important;
    }
    .card .seg button:hover,
    .card .toggle button:hover,
    .card .btn:not(.startstop):not(:disabled):hover {
      border-color: rgba(170, 190, 255, 0.65) !important;
      color: #fff !important;
    }
    .card .seg button.on {
      background: linear-gradient(145deg, #3b82f6, #1d4ed8) !important;
      border-color: transparent !important;
      color: #fff !important;
      box-shadow: 0 6px 16px rgba(37, 99, 235, 0.35) !important;
    }
    .card .seg.mu button.on {
      background: linear-gradient(145deg, #8b5cf6, #6d28d9) !important;
      box-shadow: 0 6px 16px rgba(139, 92, 246, 0.35) !important;
    }
    .card .toggle button.on {
      background: linear-gradient(145deg, #2fae6e, #1f8a55) !important;
      border-color: transparent !important;
      color: #fff !important;
      box-shadow: 0 6px 16px rgba(84, 196, 138, 0.3) !important;
    }
    .card .btn.pause.on {
      background: linear-gradient(145deg, #3b82f6, #1d4ed8) !important;
      border-color: transparent !important;
      color: #fff !important;
    }
    .card .btn:disabled { opacity: 0.4; }
    .card button:focus-visible,
    .card .btn:focus-visible,
    .rp button:focus-visible,
    .ov button:focus-visible {
      outline: 2px solid #9db8ff;
      outline-offset: 2px;
    }

    /* ---------- readable type ---------- */
    .card .sub { font-size: 13.5px; }
    .hint { font-size: 12.5px; color: var(--mut); }
    .ctrl label { font-size: 14px; }
    .quad .qm { font-size: 13px; }
    .quad .qd { font-size: 11.5px; }
    .mx-h, .mx-v { font-size: 9.5px; }
    .glab { font-size: 10px; }
    .stat .k { font-size: 11px; }
    .reading, .reading .v { font-size: 13.5px; }
    .stat .v, .reading .v, .ctrl .val, .module .mv, .frame {
      font-variant-numeric: tabular-nums;
    }

    /* ---------- log + banner on the dark theme ---------- */
    .logline {
      background: rgba(8, 10, 30, 0.5) !important;
      color: #e8ecff !important;
      border-top-color: rgba(140, 160, 255, 0.2) !important;
      border-right-color: rgba(140, 160, 255, 0.2) !important;
      border-bottom-color: rgba(140, 160, 255, 0.2) !important;
      font-size: 13px;
    }
    .logline.ok { background: rgba(34, 197, 94, 0.13) !important; }
    .logline.warn { background: rgba(247, 162, 59, 0.13) !important; }
    .logline.bad { background: rgba(255, 84, 112, 0.14) !important; }
    .logline.mus { background: rgba(139, 92, 246, 0.14) !important; }
    .logline .t { color: rgba(220, 228, 255, 0.55) !important; }
    #banner { background-color: rgba(10, 14, 38, 0.6) !important; }
    #banner .txt { color: #eef2ff !important; }
    #banner .lab { color: #c4b5fd !important; }


    /* ---------- start / stopped overlay on the pod ---------- */
    .stagewrap { position: relative; }
    .ov {
      position: absolute;
      inset: 0;
      display: none;
      align-items: center;
      justify-content: center;
      background: radial-gradient(circle at 50% 50%, rgba(6, 9, 24, 0.55), rgba(6, 9, 24, 0.82));
      backdrop-filter: blur(1.5px);
      border-radius: 14px;
      z-index: 5;
      padding: 16px;
    }
    .ov.show { display: flex; }
    .ov .ovbox { text-align: center; max-width: 420px; }
    .ov h2 {
      font-family: var(--head);
      font-size: clamp(14px, 2vw, 19px);
      letter-spacing: 1.5px;
      margin: 0 0 6px;
      color: #eef2ff;
    }
    .ov p {
      margin: 0 0 14px;
      color: rgba(220, 228, 255, 0.85);
      font-size: 14.5px;
      line-height: 1.4;
    }
    .ov .ovgo {
      font-family: var(--head);
      font-size: 14px;
      letter-spacing: 1px;
      font-weight: 800;
      color: #fff;
      cursor: pointer;
      border: none;
      border-radius: 14px;
      padding: 13px 26px;
      background: linear-gradient(145deg, #4ade80, #16a34a);
      box-shadow: 0 0 0 0 rgba(74, 222, 128, 0.5), 0 10px 26px rgba(22, 163, 74, 0.4);
      animation: ovpulse 2s infinite;
    }
    .ov .ovgo:hover { transform: translateY(-2px); }
    .ov .ovlink[hidden] { display: none; }
    .ov .ovlink {
      display: block;
      margin: 10px auto 0;
      background: none;
      border: none;
      color: #9db8ff;
      font-family: var(--body);
      font-size: 14px;
      font-weight: 700;
      cursor: pointer;
      text-decoration: underline;
    }
    @keyframes ovpulse {
      0% { box-shadow: 0 0 0 0 rgba(74, 222, 128, 0.55), 0 10px 26px rgba(22, 163, 74, 0.4); }
      70% { box-shadow: 0 0 0 16px rgba(74, 222, 128, 0), 0 10px 26px rgba(22, 163, 74, 0.4); }
      100% { box-shadow: 0 0 0 0 rgba(74, 222, 128, 0), 0 10px 26px rgba(22, 163, 74, 0.4); }
    }

    /* ---------- run report ---------- */
    .rpback {
      position: fixed;
      inset: 0;
      z-index: 9000;
      display: none;
      align-items: center;
      justify-content: center;
      background: rgba(4, 6, 18, 0.66);
      padding: 16px;
    }
    .rpback.show { display: flex; }
    .rp {
      width: min(780px, 100%);
      max-height: calc(100vh - 32px);
      overflow-y: auto;
      background: linear-gradient(160deg, #161d44, #0b1030);
      border: 1px solid rgba(140, 160, 255, 0.32);
      border-radius: 18px;
      box-shadow: 0 24px 60px rgba(0, 0, 0, 0.55);
      padding: 18px 20px 16px;
      color: #e8ecff;
      font-family: var(--body);
    }
    .rp-top {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      gap: 12px;
      flex-wrap: wrap;
    }
    .rp h2 {
      font-family: var(--head);
      font-size: 17px;
      letter-spacing: 1.4px;
      margin: 0;
    }
    .rp .rp-sit { color: rgba(220, 228, 255, 0.7); font-size: 14px; margin-top: 2px; }
    .rp-stars { font-size: 30px; letter-spacing: 3px; line-height: 1; white-space: nowrap; }
    .rp-stars .on { color: #ffd166; text-shadow: 0 0 12px rgba(255, 209, 102, 0.55); }
    .rp-stars .off { color: rgba(220, 228, 255, 0.18); }
    .rp-verdict { font-size: 16px; font-weight: 700; margin: 10px 0 12px; }
    .rp-tiles {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(130px, 1fr));
      gap: 8px;
    }
    .rp-tile {
      background: rgba(8, 10, 30, 0.5);
      border: 1px solid rgba(140, 160, 255, 0.22);
      border-radius: 12px;
      padding: 8px 10px;
    }
    .rp-tile .k {
      font-family: var(--head);
      font-size: 9.5px;
      letter-spacing: 0.6px;
      color: rgba(220, 228, 255, 0.6);
      text-transform: uppercase;
    }
    .rp-tile .v {
      font-size: 18px;
      font-weight: 700;
      margin-top: 3px;
      white-space: nowrap;
      font-variant-numeric: tabular-nums;
    }
    .rp-tile .v small { font-size: 13px; font-weight: 600; }
    .up { color: #ff7a93; }
    .dn { color: #4ade80; }
    .good { color: #4ade80; }
    .bad { color: #ff7a93; }
    .rp-chartwrap {
      margin-top: 12px;
      background: #080e1c;
      border: 1px solid #24314e;
      border-radius: 12px;
      padding: 6px 8px 4px;
    }
    .rp-chartwrap .glab { margin-bottom: 4px; }
    #rpChart { width: 100%; height: 130px; display: block; }
    .rp-legend { display: flex; flex-wrap: wrap; gap: 10px; font-size: 12.5px; margin: 5px 2px 2px; color: rgba(220, 228, 255, 0.8); }
    .rp-legend i { display: inline-block; width: 10px; height: 10px; border-radius: 3px; margin-right: 4px; vertical-align: -1px; }
    .rp-note {
      margin-top: 10px;
      padding: 9px 12px;
      border-radius: 11px;
      font-size: 14px;
      line-height: 1.4;
      background: rgba(8, 10, 30, 0.5);
      border-left: 4px solid #7ea6ff;
    }
    .rp-note.tip { border-left-color: #ffd166; }
    .rp-note.fair { border-left-color: #4ade80; }
    .rp-note.unfair { border-left-color: #f7a23b; }
    .rp h3 {
      font-family: var(--head);
      font-size: 11.5px;
      letter-spacing: 1px;
      margin: 14px 0 6px;
      color: rgba(220, 228, 255, 0.75);
    }
    .rp-tablewrap { overflow-x: auto; }
    .rp table { width: 100%; border-collapse: collapse; font-size: 13px; white-space: nowrap; }
    .rp th {
      font-family: var(--head);
      font-size: 9px;
      letter-spacing: 0.5px;
      text-align: left;
      color: rgba(220, 228, 255, 0.6);
      padding: 5px 6px;
      border-bottom: 1px solid rgba(140, 160, 255, 0.25);
    }
    .rp td { padding: 6px; border-bottom: 1px solid rgba(140, 160, 255, 0.12); font-variant-numeric: tabular-nums; }
    .rp tr.cur td { background: rgba(126, 166, 255, 0.1); }
    .rp td.chg { background: rgba(247, 162, 59, 0.2); color: #ffd9a3; font-weight: 700; border-radius: 6px; }
    .rp td .st { color: #ffd166; }
    .rp-key { font-size: 12px; color: rgba(220, 228, 255, 0.6); margin-top: 5px; }
    .rp-key b { color: #ffd9a3; }
    .rp-actions { display: flex; gap: 8px; justify-content: flex-end; margin-top: 14px; flex-wrap: wrap; }
    .rp-actions button {
      cursor: pointer;
      font-family: var(--body);
      font-size: 14.5px;
      font-weight: 700;
      border-radius: 11px;
      padding: 9px 16px;
      border: 1.5px solid rgba(140, 160, 255, 0.3);
      background: rgba(10, 14, 38, 0.6);
      color: #e8ecff;
    }
    .rp-actions button.go {
      border-color: transparent;
      background: linear-gradient(145deg, #4ade80, #16a34a);
      color: #fff;
    }
    @media (prefers-reduced-motion: reduce) {
      .ov .ovgo { animation: none; }
    }

    /* ---------- backdrop: the sheet's pulse monitor, bar chart and robot art
       used to show through the cards and the gaps between them, looking like
       UI stuck behind the panels. Blur and dim it so it reads as scenery. ---- */
    body { background: transparent !important; }
    body::before {
      content: "";
      position: fixed;
      inset: -30px;
      z-index: -1;
      pointer-events: none;
      background: #1c2249 var(--bp) center / cover no-repeat;
      filter: blur(12px) brightness(0.45) saturate(0.85);
    }
    .card {
      background: rgba(13, 16, 42, 0.94) !important;
      backdrop-filter: blur(8px);
    }

    /* ---------- tablet / small laptop: stage on top, the two panels side by
       side underneath instead of one very wide column ---------- */
    @media (max-width: 1280px) {
      .grid {
        grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
        grid-template-areas: "stage stage" "ctrl info";
        align-items: start;
      }
      .grid > section:nth-of-type(1) { grid-area: ctrl; }
      .grid > section:nth-of-type(2) { grid-area: stage; }
      .grid > section:nth-of-type(3) { grid-area: info; }
    }
    @media (max-width: 760px) {
      .grid {
        grid-template-columns: minmax(0, 1fr);
        grid-template-areas: "stage" "ctrl" "info";
      }
    }


    /* ---------- help window + scrollbars on the dark theme ---------- */
    * { scrollbar-color: rgba(140, 160, 255, 0.35) transparent; scrollbar-width: thin; }
    ::-webkit-scrollbar { width: 8px; height: 8px; }
    ::-webkit-scrollbar-track { background: transparent; }
    ::-webkit-scrollbar-thumb { background: rgba(140, 160, 255, 0.3); border-radius: 4px; }
    .helpbar.floatwin {
      background: #10163a !important;
      border-color: rgba(140, 160, 255, 0.32) !important;
      box-shadow: 0 18px 45px rgba(0, 0, 0, 0.55) !important;
    }
    .helpbar.floatwin .fw-head { background: rgba(8, 10, 30, 0.6) !important; border-bottom-color: rgba(140, 160, 255, 0.25) !important; }
    .helpbar.floatwin .fw-title { color: rgba(220, 228, 255, 0.75) !important; }
    .helpbar.floatwin .fw-tab-btn,
    .helpbar.floatwin .fw-close {
      background: rgba(10, 14, 38, 0.7) !important;
      border-color: rgba(140, 160, 255, 0.3) !important;
      color: rgba(226, 232, 255, 0.85) !important;
    }
    .helpbar.floatwin .fw-tab-btn.on { background: linear-gradient(145deg, #3b82f6, #1d4ed8) !important; border-color: transparent !important; color: #fff !important; }
    .helpbar.floatwin .fw-close:hover { background: rgba(239, 68, 68, 0.25) !important; color: #fff !important; }
    .helpbar.floatwin .fw-body, .helpbar.floatwin .tabpanel { color: #e8ecff !important; }
    .helpbar.floatwin .fw-body b, .helpbar.floatwin .tabpanel b { color: #7dd3fc !important; }
  </style>
</head>
  <body>
    <header class="top">
      <div class="title">
        <h1>HEARTBEAT DJ BOT</h1>
      </div>
      <div class="helpbtns">
        <button type="button" class="helpbtn" data-tab="use">How To Use</button>
        <button type="button" class="helpbtn" data-tab="learn">
          What You'll Learn
        </button>
      </div>
      <div class="helpbar" id="helpbar">
        <div class="tabpanel" data-panel="use">
          <ol>
            <li>
              Pick a <b>Crew Situation</b> — <b>Rest Period</b>,
              <b>Routine Ops</b>, <b>Comms Check</b>, <b>EVA Prep Stress</b>,
              <b>Equipment Alarm</b> or <b>Post-Exercise</b>. Each one sets the
              crew member's heart rate and how noisy the room is.
            </li>
            <li>
              Drag <b>Heart Rate</b> (45–175 BPM) up. Watch the PPG wave beat
              faster, the detected BPM climb past the threshold line, and the
              bot switch to a calming track.
            </li>
            <li>
              Move the <b>Heart Rate Threshold</b> (70–150 BPM). Put it right
              on top of the current reading and the bot starts flapping
              between modes — that is the "too sensitive" lesson.
            </li>
            <li>
              Set <b>Sensor Averaging</b> (1–16 samples). At 1 the BPM reading
              is jumpy. At 16 it is smooth, but it reacts late.
            </li>
            <li>
              Watch the <b>Situation Analysis</b> matrix. Heart rate (normal or
              high) and room sound (low or high) split it into four boxes —
              <b>Calm</b>, <b>Focus</b>, <b>Relax</b> and <b>Deep Calm</b>. The
              lit box <i>is</i> the bot's decision. Nothing is random.
            </li>
            <li>
              Read the readings under the matrix: <b>Heart Rate</b>,
              <b>HR Status</b>, <b>Sound Level</b>, <b>Sound Status</b>, the
              <b>raw beat reading</b>, the <b>BPM trend</b>, the thresholds and
              how many times the mode has changed.
            </li>
            <li>
              Check the <b>DFPlayer Mini &amp; SD Card</b> panel to see the
              mode the bot chose, the track number and the file it plays from
              the SD card.
            </li>
            <li>
              Under <b>Bot Response</b>, keep <b>Biofeedback</b> <b>On</b> so
              the music calms the crew. Leave it running: the heart rate drops,
              the bot sees it falling, and <b>Recovery Mode</b> appears on its
              own.
            </li>
            <li>
              Switch <b>Playback Source</b> to <b>Manual Preview</b> to hear
              each mode yourself. Use <b>Sound On</b> / <b>Mute</b> and the
              <b>Volume</b> (0–30) on the <b>Mini Speaker</b>.
            </li>
            <li>
              Watch the <b>crew member</b>: posture, breathing and face show
              how calm they are, and the <b>Calmness ring</b> on the stage
              shows the score and how it moved in the last 30 seconds.
            </li>
            <li>
              Press <b>Stop Simulation</b> to get a <b>Run Report</b> with
              stars, a heart-rate chart and a comparison with earlier runs.
            </li>
            <li>
              Press <b>Start Simulation</b> to begin and
              <b>Stop Simulation</b> to halt everything (readings, music and
              animation). While running, press <b>Pause</b> to freeze the
              readings, or <b>Reset</b> to start again. Change <b>one</b> setting at a time and compare.
            </li>
          </ol>
        </div>
        <div class="tabpanel" data-panel="learn">
          <ul>
            <li>
              <b>Optical heart sensing:</b> a MAX30102 reads your pulse from a
              light wave (PPG) bouncing off blood, not from a ready-made BPM
              number.
            </li>
            <li>
              <b>Working out BPM:</b> heart rate is calculated from the time
              <i>between</i> beats, and averaging smooths it but makes it
              slower to react.
            </li>
            <li>
              <b>Sound sensing:</b> a sound sensor reports how noisy the room
              is as a level from 0 to 1023.
            </li>
            <li>
              <b>Thresholds:</b> two thresholds turn two changing readings into
              four clear situations, and the bot picks music for each one.
            </li>
            <li>
              <b>Too sensitive:</b> a threshold set too close to the reading
              makes a robot flap back and forth between states.
            </li>
            <li>
              <b>Sending commands:</b> the controller sends a real serial
              command to the DFPlayer to pick a track off the SD card.
            </li>
            <li>
              <b>Feedback loops:</b> calming music lowers the heart rate, which
              changes the very reading that chose the music.
            </li>
            <li>
              <b>Fair testing:</b> change one setting at a time and keep the
              others the same, so you know what caused the difference.
            </li>
          </ul>
        </div>
      </div>
    </header>

    <div class="grid">
      <!-- ================= CONTROLS ================= -->
      <section class="card">
        <h3>Controls</h3>
        <p class="sub">
          Set the crew member's condition and the room around them. The bot
          reads only what its two sensors report.
        </p>

        <div class="cmdgroup">
          <h4>Crew Situation</h4>
          <div class="seg" id="segScenario">
            <button data-sc="rest" class="on">Rest Period</button>
            <button data-sc="ops">Routine Ops</button>
            <button data-sc="comms">Comms Check</button>
            <button data-sc="eva">EVA Prep Stress</button>
            <button data-sc="alarm">Equipment Alarm</button>
            <button data-sc="exercise">Post-Exercise</button>
          </div>
          <div class="hint" id="scHint">
            Crew member resting in the pod. Low heart rate, near-silent cabin.
          </div>
        </div>

        <div class="cmdgroup hr">
          <h4>MAX30102 — Heart Rate Sensor</h4>
          <div class="ctrl">
            <div class="row">
              <label>Heart Rate</label
              ><span class="val" id="v_bpm">66 BPM</span>
            </div>
            <input
              type="range"
              class="hrr"
              id="r_bpm"
              min="45"
              max="175"
              step="1"
              value="66"
            />
            <div class="hint">
              The crew member's true pulse. The sensor has to measure it.
            </div>
          </div>
          <div class="ctrl">
            <div class="row">
              <label>Heart Rate Threshold</label
              ><span class="val" id="v_hrth">100 BPM</span>
            </div>
            <input
              type="range"
              class="hrr"
              id="r_hrth"
              min="70"
              max="150"
              step="1"
              value="100"
            />
            <div class="hint">Above this, the bot calls the crew agitated.</div>
          </div>
          <div class="ctrl">
            <div class="row">
              <label>Sensor Averaging</label
              ><span class="val" id="v_avg">6 samples</span>
            </div>
            <input
              type="range"
              class="hrr"
              id="r_avg"
              min="1"
              max="16"
              step="1"
              value="6"
            />
            <div class="hint">
              How many beats are averaged. Low = jumpy, high = smooth but slow.
            </div>
          </div>
        </div>

        <div class="cmdgroup mu">
          <h4>Bot Response</h4>
          <div class="ctrl" style="margin-top: 0">
            <div class="row"><label>Biofeedback — music calms crew</label></div>
            <div class="toggle" id="tgBio">
              <button data-bio="on" class="on">On</button>
              <button data-bio="off">Off</button>
            </div>
            <div class="hint">
              Off breaks the loop, so heart rate ignores the music.
            </div>
          </div>
          <div class="ctrl">
            <div class="row"><label>Playback Source</label></div>
            <div class="toggle" id="tgSrc">
              <button data-src="bot" class="on">Bot Decision</button>
              <button data-src="manual">Manual Preview</button>
            </div>
          </div>
          <div id="manualWrap" style="display: none">
            <div class="seg mu three" id="segManual">
              <button data-mode="calm" class="on">Calm</button>
              <button data-mode="focus">Focus</button>
              <button data-mode="relax">Relax</button>
              <button data-mode="deep">Deep Calm</button>
              <button data-mode="recovery">Recovery</button>
            </div>
            <div class="hint">
              Preview any track. The bot keeps analysing underneath.
            </div>
          </div>
        </div>

        <div class="cmdgroup mu">
          <h4>Mini Speaker</h4>
          <div class="toggle" id="tgAudio">
            <button data-aud="on" class="on">Sound On</button>
            <button data-aud="off">Mute</button>
          </div>
          <div class="ctrl">
            <div class="row">
              <label>Volume</label><span class="val" id="v_vol">18 / 30</span>
            </div>
            <input
              type="range"
              class="mur"
              id="r_vol"
              min="0"
              max="30"
              step="1"
              value="18"
            />
            <div class="hint">
              DFPlayer volume runs 0–30. Music starts when you press Start.
              Tracks are CC0 (public domain) from OpenGameArt.
            </div>
          </div>
        </div>
      </section>

      <!-- ================= STAGE ================= -->
      <section class="card stage">
        <div class="modebanner" id="banner">
          <div>
            <div class="lab">SELECTED MUSIC MODE</div>
            <div class="txt" id="bannerTxt">Calm Mode — soft ambient music</div>
          </div>
          <div class="chip" id="bannerChip">CALM</div>
        </div>

        <div class="stagewrap">
          <canvas id="pod" width="860" height="380"></canvas>
          <div class="ov show" id="startOv">
            <div class="ovbox">
              <h2 id="ovTitle">CREW POD STANDING BY</h2>
              <p id="ovText">
                Pick a Crew Situation, then start the simulation to watch the
                bot read the crew and choose the music.
              </p>
              <button type="button" class="ovgo" id="ovGo">
                ▶ START SIMULATION
              </button>
              <button type="button" class="ovlink" id="ovReport" hidden>
                View last run report
              </button>
            </div>
          </div>
        </div>

        <div class="graphrow">
          <div class="gcard">
            <span class="glab">MAX30102 · PPG Pulse Wave</span>
            <canvas id="ppg" width="760" height="150"></canvas>
          </div>
          <div class="gcard">
            <span class="glab">BPM Trend · Zones &amp; Threshold</span>
            <canvas id="trend" width="760" height="150"></canvas>
          </div>
        </div>
        <div class="stage-foot">
          <button type="button" class="btn startstop" id="btnRun">
            ▶ Start Simulation
          </button>
          <button type="button" class="btn pause" id="btnPause" disabled>
            Pause
          </button>
          <button type="button" class="btn" id="btnReset">Reset</button>
        </div>
      </section>

      <!-- ================= TELEMETRY ================= -->
      <section class="card">
        <h3>Situation Analysis</h3>
        <p class="sub">
          Two readings, two thresholds, four boxes. The lit box is the decision.
        </p>

        <div class="matrix">
          <div class="mx-corner"></div>
          <div class="mx-h">SOUND<br />LOW</div>
          <div class="mx-h">SOUND<br />HIGH</div>
          <div class="mx-v">BPM<br />NORMAL</div>
          <div class="quad" id="q_calm">
            <div class="qm">Calm Mode</div>
            <div class="qd">Calm condition · soft ambient</div>
          </div>
          <div class="quad" id="q_focus">
            <div class="qm">Focus Mode</div>
            <div class="qd">Noisy room · steady rhythm</div>
          </div>
          <div class="mx-v">BPM<br />HIGH</div>
          <div class="quad" id="q_relax">
            <div class="qm">Relax Mode</div>
            <div class="qd">Crew agitated · calming</div>
          </div>
          <div class="quad" id="q_deep">
            <div class="qm">Deep Calm</div>
            <div class="qd">High stress · slow relaxing</div>
          </div>
        </div>
        <div class="quad recov" id="q_recovery">
          <div>
            <div class="qm">Recovery Mode</div>
            <div class="qd">Heart rate falling after agitation, room quiet</div>
          </div>
        </div>

        <div class="statusgrid">
          <div class="stat">
            <div class="k">Heart Rate</div>
            <div class="v h" id="st_bpm">66 BPM</div>
          </div>
          <div class="stat">
            <div class="k">HR Status</div>
            <div class="v g" id="st_bpmStat">Calm</div>
          </div>
          <div class="stat">
            <div class="k">Sound Level</div>
            <div class="v a" id="st_snd">64</div>
          </div>
          <div class="stat">
            <div class="k">Sound Status</div>
            <div class="v g" id="st_sndStat">Quiet</div>
          </div>
        </div>

        <div style="margin-top: 10px">
          <div class="reading">
            <span class="k">Raw beat reading</span
            ><span class="v" id="st_raw">66.4 BPM</span>
          </div>
          <div class="reading">
            <span class="k">BPM trend</span
            ><span class="v" id="st_slope">steady</span>
          </div>
          <div class="reading">
            <span class="k">Thresholds (HR / sound)</span
            ><span class="v" id="st_th">100 / 650</span>
          </div>
          <div class="reading">
            <span class="k">Mode changes</span
            ><span class="v" id="st_changes">0 / min</span>
          </div>
        </div>

        <h3 style="margin-top: 14px">DFPlayer Mini &amp; SD Card</h3>
        <div class="module">
          <div class="mrow">
            <span class="mk">Selected mode</span
            ><span class="mv" id="dfMode">Calm Mode</span>
          </div>
          <div class="mrow">
            <span class="mk">DFPlayer track</span
            ><span class="mv" id="dfTrack">Track 01</span>
          </div>
          <div class="mrow">
            <span class="mk">SD card file</span
            ><span class="mv" id="dfFile">calm_ambient_01.mp3</span>
          </div>
          <div class="mrow">
            <span class="mk">Playback</span
            ><span class="mv play" id="dfState">Playing</span>
          </div>
          <div class="frame" id="dfFrame"></div>
          <div class="framenote" id="dfNote">
            Serial frame sent to the DFPlayer on pin TX.
          </div>
          <div class="sd" id="sdList">
            <div class="sdf" id="sd_calm">
              <span class="no">001</span
              ><span class="fn">calm_ambient_01.mp3</span
              ><span class="tag">CALM</span>
            </div>
            <div class="sdf" id="sd_focus">
              <span class="no">002</span
              ><span class="fn">focus_rhythm_02.mp3</span
              ><span class="tag">FOCUS</span>
            </div>
            <div class="sdf" id="sd_relax">
              <span class="no">003</span
              ><span class="fn">calm_music_03.mp3</span
              ><span class="tag">RELAX</span>
            </div>
            <div class="sdf" id="sd_deep">
              <span class="no">004</span
              ><span class="fn">deep_relax_04.mp3</span
              ><span class="tag">DEEP</span>
            </div>
            <div class="sdf" id="sd_recovery">
              <span class="no">005</span
              ><span class="fn">recovery_gentle_05.mp3</span
              ><span class="tag">RECOV</span>
            </div>
          </div>
        </div>

        <h3 style="margin-top: 14px">Mini Speaker Output</h3>
        <div class="spk">
          <canvas id="spkCone" width="144" height="144"></canvas>
          <div class="swave">
            <canvas id="spkWave" width="560" height="92"></canvas>
            <div class="sinfo" id="spkInfo">Volume 18/30 · 60 BPM pad</div>
          </div>
        </div>

        <h3 style="margin-top: 14px">Crew Calmness</h3>
        <div class="hbar">
          <div class="fill" id="calmFill"></div>
        </div>
        <div class="reading">
          <span class="k" id="calmStat">Crew is settled</span
          ><span class="v" id="calmVal">78%</span>
        </div>

        <h3 style="margin-top: 14px">Bot Feedback</h3>
        <div class="log" id="logBox"></div>
      </section>
    </div>

    <div class="rpback" id="rpBack">
      <div class="rp" role="dialog" aria-modal="true" aria-labelledby="rpTitle">
        <div class="rp-top">
          <div>
            <h2 id="rpTitle">RUN REPORT</h2>
            <div class="rp-sit" id="rpSit"></div>
          </div>
          <div class="rp-stars" id="rpStars"></div>
        </div>
        <div class="rp-verdict" id="rpVerdict"></div>
        <div class="rp-tiles" id="rpTiles"></div>
        <div class="rp-chartwrap">
          <span class="glab">Heart rate during the run · background = music mode playing</span>
          <canvas id="rpChart"></canvas>
          <div class="rp-legend" id="rpLegend"></div>
        </div>
        <div class="rp-note tip" id="rpTip"></div>
        <div class="rp-note" id="rpFair"></div>
        <div id="rpCompare">
          <h3>COMPARE RUNS</h3>
          <div class="rp-tablewrap">
            <table>
              <thead>
                <tr>
                  <th>RUN</th><th>SITUATION</th><th>THRESHOLD</th><th>AVERAGING</th>
                  <th>BIOFEEDBACK</th><th>TIME</th><th>HEART RATE</th><th>END CALM</th>
                  <th>CHANGES</th><th>RESULT</th>
                </tr>
              </thead>
              <tbody id="rpRows"></tbody>
            </table>
          </div>
          <div class="rp-key">
            <b>Orange</b> cells are settings that changed from the run before.
          </div>
        </div>
        <div class="rp-actions">
          <button type="button" id="rpClose">Close</button>
          <button type="button" class="go" id="rpNext">▶ Start next run</button>
        </div>
      </div>
    </div>

    <script>
      (() => {
        "use strict";

        /* =================== HELPERS =================== */
        const clamp = (v, a, b) => Math.max(a, Math.min(b, v));
        const lerp = (a, b, t) => a + (b - a) * t;
        const TAU = Math.PI * 2;
        const $ = (id) => document.getElementById(id);
        // Exponential smoothing that behaves the same at any frame rate.
        const approach = (cur, tgt, tau, dt) =>
          tgt + (cur - tgt) * Math.exp(-dt / tau);
        function rr(c, x, y, w, h, r) {
          r = Math.min(r, w / 2, h / 2);
          c.beginPath();
          c.moveTo(x + r, y);
          c.arcTo(x + w, y, x + w, y + h, r);
          c.arcTo(x + w, y + h, x, y + h, r);
          c.arcTo(x, y + h, x, y, r);
          c.arcTo(x, y, x + w, y, r);
          c.closePath();
        }
        function heart(c, cx, cy, s) {
          c.beginPath();
          c.moveTo(cx, cy + s * 0.78);
          c.bezierCurveTo(
            cx - s * 1.12,
            cy - s * 0.08,
            cx - s * 0.56,
            cy - s * 0.98,
            cx,
            cy - s * 0.34,
          );
          c.bezierCurveTo(
            cx + s * 0.56,
            cy - s * 0.98,
            cx + s * 1.12,
            cy - s * 0.08,
            cx,
            cy + s * 0.78,
          );
          c.closePath();
        }
        const hex2rgb = (h) => {
          const n = parseInt(h.slice(1), 16);
          return [(n >> 16) & 255, (n >> 8) & 255, n & 255];
        };
        const rgba = (h, a) => {
          const [r, g, b] = hex2rgb(h);
          return `rgba(${r},${g},${b},${a})`;
        };

        /* =================== CANVASES =================== */
        const pod = $("pod"),
          px = pod.getContext("2d");
        let W = pod.width,
          H = pod.height;
        const ppg = $("ppg"),
          gx = ppg.getContext("2d");
        const trend = $("trend"),
          tx = trend.getContext("2d");
        const cone = $("spkCone"),
          cx2 = cone.getContext("2d");
        const swave = $("spkWave"),
          wx = swave.getContext("2d");

        // Graph canvases keep drawing in their fixed design space; only the
        // transform changes, so no layout maths has to move when they resize.
        const dpr = () => Math.min(window.devicePixelRatio || 1, 2);
        function fitFixed(cv, ctx, DW, DH) {
          const r = cv.getBoundingClientRect();
          if (!r.width || !r.height) return;
          const k = dpr();
          const bw = Math.max(1, Math.round(r.width * k)),
            bh = Math.max(1, Math.round(r.height * k));
          if (cv.width === bw && cv.height === bh) return;
          cv.width = bw;
          cv.height = bh;
          ctx.setTransform(bw / DW, 0, 0, bh / DH, 0, 0);
        }
        const D = {
          ppg: [760, 150],
          trend: [760, 150],
          cone: [144, 144],
          swave: [560, 92],
        };
        let fitted = false;
        function fitPod() {
          const r = pod.getBoundingClientRect();
          if (!r.width || !r.height) return;
          const cw = Math.round(r.width),
            ch = Math.round(r.height);
          if (fitted && cw === W && ch === H) return;
          const k = dpr();
          pod.width = Math.round(cw * k);
          pod.height = Math.round(ch * k);
          px.setTransform(k, 0, 0, k, 0, 0);
          const fxr = cw / W,
            fyr = ch / H;
          for (const s of stars) {
            s.x *= fxr;
            s.y *= fyr;
          }
          W = cw;
          H = ch;
          fitted = true;
        }
        function refit() {
          fitPod();
          fitFixed(ppg, gx, D.ppg[0], D.ppg[1]);
          fitFixed(trend, tx, D.trend[0], D.trend[1]);
          fitFixed(cone, cx2, D.cone[0], D.cone[1]);
          fitFixed(swave, wx, D.swave[0], D.swave[1]);
        }

        /* =================== MODE TABLE =================== */
        // One row per music mode: what the bot calls it, which file the DFPlayer
        // pulls off the SD card, how hard that music pulls the heart rate down,
        // and how the pad is synthesised.
        const MODES = {
          calm: {
            name: "Calm Mode",
            desc: "soft ambient music",
            chip: "CALM",
            col: "#34d399",
            track: 1,
            file: "calm_ambient_01.mp3",
            pull: 0.55,
            floor: 62,
            tempo: 60,
            root: 174.61,
            chord: [0, 7, 12, 16],
            arp: [12, 16, 19, 16],
            lp: 950,
            lfo: 0.11,
            gain: 0.5,
            situation: "Calm condition",
          },
          focus: {
            name: "Focus Mode",
            desc: "focus / steady rhythm music",
            chip: "FOCUS",
            col: "#38bdf8",
            track: 2,
            file: "focus_rhythm_02.mp3",
            pull: 0.3,
            floor: 68,
            tempo: 82,
            root: 220.0,
            chord: [0, 7, 12, 19],
            arp: [12, 19, 24, 19],
            lp: 1750,
            lfo: 0.3,
            gain: 0.44,
            situation: "Noisy environment",
          },
          relax: {
            name: "Relax Mode",
            desc: "calming music",
            chip: "RELAX",
            col: "#a78bfa",
            track: 3,
            file: "calm_music_03.mp3",
            pull: 2.1,
            floor: 64,
            tempo: 52,
            root: 146.83,
            chord: [0, 5, 12, 17],
            arp: [12, 17, 12, 5],
            lp: 720,
            lfo: 0.08,
            gain: 0.54,
            situation: "Crew member agitated",
          },
          deep: {
            name: "Deep Calm Mode",
            desc: "slow relaxing music",
            chip: "DEEP CALM",
            col: "#6366f1",
            track: 4,
            file: "deep_relax_04.mp3",
            pull: 3.0,
            floor: 60,
            tempo: 42,
            root: 110.0,
            chord: [0, 7, 12, 14],
            arp: [12, 14, 7, 12],
            lp: 500,
            lfo: 0.05,
            gain: 0.6,
            situation: "High stress condition",
          },
          recovery: {
            name: "Recovery Mode",
            desc: "gentle recovery track",
            chip: "RECOVERY",
            col: "#fb923c",
            track: 5,
            file: "recovery_gentle_05.mp3",
            pull: 1.35,
            floor: 66,
            tempo: 56,
            root: 196.0,
            chord: [0, 4, 7, 12],
            arp: [12, 16, 19, 24],
            lp: 1150,
            lfo: 0.16,
            gain: 0.5,
            situation: "Recovery condition",
          },
        };
        const MODE_KEYS = ["calm", "focus", "relax", "deep", "recovery"];

        /* =================== SOUND TYPES =================== */
        // Each type is a *character*, not a loudness: env() returns 0..1 and the
        // Ambient Level slider scales it. That separation is the whole point of
        // the sensitivity lesson — same room, different number.
        const SOUNDS = {
          silence: {
            name: "Silence",
            hint: "Near-silent cabin. Only the faint electrical floor of the sensor.",
            floor: 0.035,
            env: (t, rnd) => 0.035 + rnd() * 0.03,
          },
          conv: {
            name: "Talking",
            hint: "Two crew talking. Syllable bursts with gaps between phrases.",
            floor: 0.06,
            env: (t) => {
              // Syllables inside phrases, with a breath gap every few seconds.
              const phrase = Math.sin(t * 0.55) > -0.35 ? 1 : 0.12;
              const syl =
                0.5 + 0.5 * Math.sin(t * 17 + Math.sin(t * 3.1) * 2.2);
              return 0.06 + phrase * syl * 0.55;
            },
          },
          alarm: {
            name: "Alarm",
            hint: "Equipment alarm. Sharp periodic bursts with silence between.",
            floor: 0.05,
            env: (t) => {
              const p = (t * 1.6) % 1;
              const burst =
                p < 0.34 ? Math.pow(Math.sin((p / 0.34) * Math.PI), 0.4) : 0;
              return 0.05 + burst * 0.95;
            },
          },
          crowd: {
            name: "Crowd",
            hint: "Busy crew module. Dense, random, never quite quiet.",
            floor: 0.3,
            // Babble is many voices summed, so it is steadier than one talker —
            // a slow swell rather than the syllable gaps of a conversation.
            env: (t, rnd) =>
              0.54 +
              0.1 * Math.sin(t * 1.3) +
              0.06 * Math.sin(t * 0.47) +
              (rnd() - 0.5) * 0.13,
          },
          machinery: {
            name: "Machinery",
            hint: "Pump running. Steady and loud, with a low mechanical beat.",
            floor: 0.45,
            env: (t, rnd) =>
              0.62 +
              0.1 * Math.sin(t * 11.5) +
              0.05 * Math.sin(t * 0.7) +
              (rnd() - 0.5) * 0.05,
          },
          vent: {
            name: "Vent Hum",
            hint: "Air handler. A soft constant hum the sensor never stops hearing.",
            floor: 0.12,
            env: (t, rnd) =>
              0.2 + 0.035 * Math.sin(t * 4.2) + (rnd() - 0.5) * 0.04,
          },
        };

        /* =================== SCENARIOS =================== */
        const SCENARIOS = {
          rest: {
            hint: "Crew member resting in the pod. Low heart rate, near-silent cabin.",
            bpm: 66,
            amb: 15,
            snd: "silence",
          },
          ops: {
            hint: "Routine work shift. Normal pulse, low chatter in the module.",
            bpm: 84,
            amb: 42,
            snd: "conv",
          },
          comms: {
            hint: "Comms check with a full module. Calm crew, very loud room.",
            bpm: 84,
            amb: 86,
            snd: "crowd",
          },
          eva: {
            hint: "Waiting to step outside. Pulse is up, but the pod is silent.",
            bpm: 118,
            amb: 18,
            snd: "silence",
          },
          alarm: {
            hint: "Alarm on a failed unit. Pulse spikes and the cabin is loud.",
            bpm: 130,
            amb: 92,
            snd: "alarm",
          },
          exercise: {
            hint: "Just off the treadmill. Pulse high but already falling on its own.",
            bpm: 144,
            amb: 26,
            snd: "vent",
            decayTo: 72,
            decayRate: 2.4,
          },
        };

        /* =================== STATE =================== */
        const S = {
          bpmTarget: 66, // the crew member's true pulse
          bpmActual: 66, // after the music's biofeedback pull
          bpmRaw: 66, // what one beat measurement reported
          bpmDisp: 66, // the averaged reading the bot actually decides on
          hrTh: 100,
          avgN: 6,
          amb: 15,
          sndType: "silence",
          snTh: 650,
          sens: 1.0,
          sndRaw: 0,
          sndDisp: 0,
          bio: true,
          src: "bot",
          manualMode: "calm",
          audioOn: true,
          vol: 18,
          paused: false,
          running: false, // Start/Stop: nothing moves until Start is pressed
          mode: "calm", // committed mode (what the DFPlayer is playing)
          candidate: "calm", // what the logic wants right now
          candSince: 0,
          calmness: 78,
          wasAgitated: false,
          agitatedAt: -99,
          decayTo: null,
          decayRate: 0,
          changeTimes: [],
          candFlips: [],
          dfState: "Playing",
          dfChangedAt: -99,
          lastFeedback: "",
          flapWarnAt: -99,
          volFrameUntil: 0,
          scKey: "rest",
          flashAt: -99, // mode-change ripple from the bot
          flashCol: "#34d399",
        };

        // Outcome visuals
        let breathPh = 0; // crew breathing, faster under stress
        let calmHist = []; // {t, c} for the calmness ring's change arrow
        let modeMarks = []; // {t, k} flags on the BPM trend graph
        let run = null; // stats for the run in progress (Start → Stop)
        const runs = []; // finished runs, newest first
        let runCount = 0;

        let tNow = 0;
        let beatPhase = 0; // 0..1 through the current cardiac cycle
        let lastBeatT = 0;
        let ibiHist = [];
        let bpmHist = []; // {t, bpm} for slope + trend graph
        let ppgBuf = new Array(420).fill(0);
        let beatMarks = new Array(420).fill(0);
        let trendBuf = []; // {t, bpm}
        let trendClock = 0;
        const stars = [];
        let rndSeed = 12345;
        const rnd = () => {
          // Deterministic-ish noise so the sensor floor doesn't crawl between frames.
          rndSeed = (rndSeed * 1664525 + 1013904223) >>> 0;
          return rndSeed / 4294967296;
        };
        function seedStars() {
          stars.length = 0;
          for (let i = 0; i < 60; i++)
            stars.push({
              x: rnd() * W,
              y: rnd() * H,
              r: 0.5 + rnd() * 1.3,
              tw: rnd() * TAU,
            });
        }

        /* =================== AUDIO ENGINE =================== */
        // One pad that is *retuned* between modes rather than five pads that
        // crossfade: the chord, filter and LFO all glide, so a mode change is a
        // musical morph and the browser only ever runs eight oscillators.
        const A = {
          ctx: null,
          ok: false,
          master: null,
          padGain: null,
          filter: null,
          lfo: null,
          lfoGain: null,
          analyser: null,
          data: null,
          voices: [],
          pulseBus: null,
          nextPulse: 0,
          pulseIdx: 0,
        };
        function initAudio() {
          if (A.ctx) return;
          const AC = window.AudioContext || window.webkitAudioContext;
          if (!AC) return;
          const c = new AC();
          A.ctx = c;

          A.master = c.createGain();
          A.master.gain.value = 0;
          A.analyser = c.createAnalyser();
          A.analyser.fftSize = 1024;
          A.analyser.smoothingTimeConstant = 0.5;
          A.data = new Uint8Array(A.analyser.fftSize);
          A.master.connect(A.analyser);
          A.analyser.connect(c.destination);

          A.filter = c.createBiquadFilter();
          A.filter.type = "lowpass";
          A.filter.frequency.value = MODES.calm.lp;
          A.filter.Q.value = 0.8;
          A.filter.connect(A.master);

          A.padGain = c.createGain();
          A.padGain.gain.value = MODES.calm.gain;
          A.padGain.connect(A.filter);

          // Slow filter sweep — what makes a static chord sound like it breathes.
          A.lfo = c.createOscillator();
          A.lfo.type = "sine";
          A.lfo.frequency.value = MODES.calm.lfo;
          A.lfoGain = c.createGain();
          A.lfoGain.gain.value = 260;
          A.lfo.connect(A.lfoGain);
          A.lfoGain.connect(A.filter.frequency);
          A.lfo.start();

          // Four chord tones, each a detuned pair, for a wide pad.
          const m = MODES.calm;
          for (let i = 0; i < 4; i++) {
            for (let d = 0; d < 2; d++) {
              const o = c.createOscillator();
              o.type = i === 0 ? "sine" : "triangle";
              o.frequency.value = m.root * Math.pow(2, m.chord[i] / 12);
              o.detune.value = d === 0 ? -6 : 6;
              const g = c.createGain();
              g.gain.value = (i === 0 ? 0.34 : 0.2) / 2;
              o.connect(g);
              g.connect(A.padGain);
              o.start();
              A.voices.push({ o, g, i });
            }
          }

          // A short feedback delay gives the pulses a room to sit in.
          A.pulseBus = c.createGain();
          A.pulseBus.gain.value = 0.9;
          const dl = c.createDelay(1.0);
          dl.delayTime.value = 0.29;
          const fb = c.createGain();
          fb.gain.value = 0.33;
          const wet = c.createGain();
          wet.gain.value = 0.42;
          A.pulseBus.connect(A.filter);
          A.pulseBus.connect(dl);
          dl.connect(fb);
          fb.connect(dl);
          dl.connect(wet);
          wet.connect(A.filter);

          A.ok = true;
          retuneAudio(playingMode(), 0.05);
        }
        // Sound is switched off in this version: the audio engine is never
        // started, and the speaker visuals use their synthesised stand-in.
        // Real music: five short CC0 tracks, embedded in this file so the sim
        // works as a single page (no audio folder needed). All CC0 / public
        // domain from OpenGameArt.org, no vocals:
        //   Calm      "Ambient Relaxing Loop" by isaiah658
        //   Focus     "Lofi Hip Hop Loop" by omfgdude (first ~32 s)
        //   Relax     "Freame" by cinameng
        //   Deep Calm "Distortion prototype" by Centurion_of_war
        //   Recovery  "Calm Ambient 1 (Synthwave 4k)" by cynicmusic (first ~42 s)
        // One track per
        // mode. Plain <audio> elements, crossfaded each frame. The browser only
        // lets audio start after a click, so the first Start press unlocks it.
        const TRACKS = {
          calm: { src: "data:audio/ogg;base64,", gain: 0.75 },
          focus: { src: "data:audio/ogg;base64,", gain: 0.7, end: 30 },
          relax: { src: "data:audio/mpeg;base64,", gain: 0.7 },
          deep: { src: "data:audio/ogg;base64,", gain: 1.0 },
          recovery: { src: "data:audio/mpeg;base64,", gain: 0.8, end: 40 },
        };
        const P = { ready: false, el: {}, lvl: {} };
        function unlockAudio() {
          if (P.ready) return;
          P.ready = true;
          for (const key in TRACKS) {
            const el = new Audio(TRACKS[key].src);
            el.loop = !TRACKS[key].end;
            el.preload = "auto";
            el.volume = 0;
            P.el[key] = el;
            P.lvl[key] = 0;
          }
        }
        function trackTick(dt) {
          if (!P.ready) return;
          const live = S.audioOn && !frozen();
          const cur = playingMode();
          for (const key in TRACKS) {
            const el = P.el[key],
              tr = TRACKS[key];
            const on = live && key === cur;
            // crossfade ~0.8 s between tracks
            P.lvl[key] = approach(P.lvl[key], on ? 1 : 0, 0.25, dt);
            // a long track plays only its first `end` seconds, fading at the seam
            let seam = 1;
            if (tr.end) {
              const t = el.currentTime;
              if (t >= tr.end) el.currentTime = 0;
              seam = clamp((tr.end - t) / 1.2, 0, 1) * clamp(t / 0.6, 0, 1);
            }
            const v = clamp((S.vol / 30) * tr.gain * P.lvl[key] * seam, 0, 1);
            el.volume = v;
            if (on && el.paused) el.play().catch(() => {});
            else if (!on && P.lvl[key] < 0.01 && !el.paused) el.pause();
          }
        }
        function retuneAudio(key, glide) {
          if (!A.ok) return;
          const m = MODES[key],
            t = A.ctx.currentTime,
            g = glide === undefined ? 1.1 : glide;
          for (const v of A.voices)
            v.o.frequency.setTargetAtTime(
              m.root * Math.pow(2, m.chord[v.i] / 12),
              t,
              g,
            );
          A.filter.frequency.setTargetAtTime(m.lp, t, g);
          A.lfo.frequency.setTargetAtTime(m.lfo, t, g);
          A.padGain.gain.setTargetAtTime(m.gain, t, g);
          A.pulseIdx = 0;
        }
        function pulseAt(t, m) {
          const semi = m.arp[A.pulseIdx++ % m.arp.length];
          const o = A.ctx.createOscillator();
          o.type = "sine";
          o.frequency.value = m.root * Math.pow(2, semi / 12) * 2;
          const g = A.ctx.createGain();
          g.gain.setValueAtTime(0.0001, t);
          g.gain.linearRampToValueAtTime(0.17, t + 0.014);
          g.gain.exponentialRampToValueAtTime(0.0008, t + 1.1);
          o.connect(g);
          g.connect(A.pulseBus);
          o.start(t);
          o.stop(t + 1.2);
        }
        function audioTick() {
          if (!A.ok) return;
          const c = A.ctx,
            t = c.currentTime;
          const live = S.audioOn && !frozen() && A.ctx.state === "running";
          // DFPlayer volume is 0..30; keep the top end civil for headphones.
          const target = live ? (S.vol / 30) * 0.55 : 0;
          A.master.gain.setTargetAtTime(target, t, 0.12);
          if (!live) {
            A.nextPulse = t + 0.1;
            return;
          }
          const m = MODES[playingMode()];
          const beat = 60 / m.tempo;
          if (A.nextPulse < t) A.nextPulse = t + 0.05;
          while (A.nextPulse < t + 0.35) {
            pulseAt(A.nextPulse, m);
            A.nextPulse += beat;
          }
        }
        // What the speaker is actually reproducing right now.
        function playingMode() {
          return S.src === "manual" ? S.manualMode : S.mode;
        }

        /* =================== SENSOR MODELS =================== */
        // MAX30102: the sensor sees an optical waveform, not a number. A beat is
        // a systolic peak plus a smaller dicrotic notch, riding on a slow
        // respiration wander. BPM has to be *derived* from the gaps between peaks.
        // One PPG sample. The pulse is not a copy-paste: each beat has its own
        // height, stress narrows and shrinks the pulse (vessels tighten) and
        // hides the dicrotic notch, and the baseline rides the crew member's
        // actual breathing — slow and deep when calm, fast and shallow when not.
        function ppgSample(phase, t, artifact) {
          const st = crewStress();
          const amp = S.beatAmp || 1;
          const sys = amp * Math.exp(-Math.pow((phase - 0.13) / lerp(0.085, 0.058, st), 2));
          const dic = amp * lerp(0.34, 0.08, st) * Math.exp(-Math.pow((phase - 0.37) / 0.09, 2));
          const resp = lerp(0.14, 0.05, st) * Math.sin(breathPh);
          const noise = (rnd() - 0.5) * artifact;
          return sys + dic + resp + noise;
        }

        function soundEnvelope(t) {
          const type = SOUNDS[S.sndType];
          const raw = clamp(type.env(t, rnd), 0, 1.4);
          // Ambient Level is how loud the room is; sensitivity is gain on the
          // microphone. The bot only ever sees the product of the two.
          const gain = 0.12 + (S.amb / 100) * 1.5;
          return clamp(raw * gain * S.sens, 0, 1) * 1023;
        }

        /* =================== DECISION LOGIC =================== */
        function bpmSlope() {
          // BPM change per second, measured across the last ~5 s of readings.
          if (bpmHist.length < 2) return 0;
          const now = bpmHist[bpmHist.length - 1];
          let old = bpmHist[0];
          for (const h of bpmHist) {
            if (now.t - h.t <= 5) {
              old = h;
              break;
            }
          }
          const dt = now.t - old.t;
          if (dt < 1.2) return 0;
          return (now.bpm - old.bpm) / dt;
        }

        function decide() {
          const hrHigh = S.bpmDisp > S.hrTh;
          const noiseHigh = S.sndDisp > S.snTh;
          const slope = bpmSlope();

          if (hrHigh) {
            S.wasAgitated = true;
            S.agitatedAt = tNow;
          } else if (
            S.wasAgitated &&
            S.bpmDisp < S.hrTh - 12 &&
            Math.abs(slope) < 0.12
          ) {
            // Settled well below the line and no longer moving: recovery is over.
            S.wasAgitated = false;
          }

          // Recovery is its own situation, not a sub-case of "high": the crew
          // member is on the way down and the room is quiet enough to leave them
          // on a gentle track instead of yanking them onto a deep calm one.
          // Hysteresis: enter Recovery when the fall is clear (< -0.35 BPM/s),
          // stay in it until the fall has really stopped (> -0.15 BPM/s). A
          // single cut-off made a gentle cool-down flip Relax <-> Recovery on
          // every wobble of the slope estimate and set off the flapping warning.
          const slopeOk = S.recovHold ? slope < -0.15 : slope < -0.35;
          const recovering =
            S.wasAgitated &&
            slopeOk &&
            S.bpmDisp <= S.hrTh + 5 &&
            tNow - S.agitatedAt < 90;
          S.recovHold = recovering;

          if (recovering && !noiseHigh) return "recovery";
          if (hrHigh && noiseHigh) return "deep";
          if (hrHigh) return "relax";
          if (noiseHigh) return "focus";
          return "calm";
        }

        /* =================== STEP =================== */
        function step(dt) {
          // --- scenario-driven cool-down (post-exercise) ---
          if (S.decayTo !== null) {
            S.bpmTarget = Math.max(S.decayTo, S.bpmTarget - S.decayRate * dt);
            if (S.bpmTarget <= S.decayTo + 0.05) S.decayTo = null;
            const rb = $("r_bpm");
            rb.value = Math.round(S.bpmTarget);
            rangeFill(rb);
            $("v_bpm").textContent = Math.round(S.bpmTarget) + " BPM";
          }

          // --- true heart rate: drifts toward the crew member's own rate, and
          //     the music pulls it down against that. ---
          S.bpmActual = approach(S.bpmActual, S.bpmTarget, 6, dt);
          const m = MODES[playingMode()];
          const playing = S.dfState !== "Paused" && !frozen();
          if (S.bio && playing && S.bpmActual > m.floor) {
            // Calming works less well in a loud room — that is why Focus Mode
            // exists at all.
            const eff = 1 - 0.45 * clamp(S.sndDisp / 1023, 0, 1);
            S.bpmActual -= m.pull * eff * dt;
          }
          S.bpmActual = clamp(S.bpmActual, 40, 200);

          // --- PPG waveform + beat detection ---
          // Motion artifact grows with effort, so a fast pulse is also a dirtier
          // signal: exactly the case where averaging starts to matter.
          const artifact = 0.05 + 0.16 * clamp((S.bpmActual - 80) / 90, 0, 1);
          // A real heart never holds one number. On top of the crew member's
          // rate: slow drifts (a few BPM over tens of seconds), the breathing
          // ripple (bigger when relaxed), and sudden surges that come more
          // often and harder under stress — plus a startle jump each time a
          // loud burst (like the alarm) hits.
          {
            const st = crewStress();
            S.hrvT = (S.hrvT || 0) + dt;
            const wander =
              Math.sin(S.hrvT * 0.55) * 2.0 + Math.sin(S.hrvT * 0.23 + 1) * 2.6 + Math.sin(S.hrvT * 0.09 + 2) * 1.6;
            S.surge = approach(S.surge || 0, 0, lerp(7, 3.5, st), dt);
            if (rnd() < dt * lerp(0.05, 0.22, st)) S.surge += lerp(3, 6, st) * (0.5 + rnd());
            const loud = S.sndRaw > S.snTh;
            if (loud && !S.wasLoud && tNow - (S.startleAt || -99) > 5) {
              S.surge += lerp(1.5, 3, st);
              S.startleAt = tNow;
            }
            S.wasLoud = loud;
            S.surge = Math.min(S.surge, 12);
            S.hrvOff = wander * lerp(1, 1.3, st) + S.surge;
          }
          const hz = ((S.bpmActual + S.hrvOff) / 60) * (1 + 0.08 * (1 - crewStress()) * Math.sin(breathPh));
          beatPhase += hz * dt;
          while (beatPhase >= 1) {
            beatPhase -= 1;
            const ibi = tNow - lastBeatT;
            lastBeatT = tNow;
            if (ibi > 0.2 && ibi < 2.5) {
              // One measurement of one gap, with the jitter a real optical
              // reading carries.
              const jitter = 1 + (rnd() - 0.5) * (0.03 + artifact * 0.25);
              S.bpmRaw = clamp((60 / ibi) * jitter, 35, 210);
              ibiHist.push(S.bpmRaw);
              while (ibiHist.length > 16) ibiHist.shift();
            }
            beatMarks[beatMarks.length - 1] = 1;
            // next beat's own pulse height
            S.beatAmp = lerp(1.05, 0.62, crewStress()) * (1 + (rnd() - 0.5) * 0.16);
          }
          // The averaging window is what the learner is moving.
          const n = Math.min(S.avgN, ibiHist.length);
          if (n > 0) {
            let sum = 0;
            for (let i = ibiHist.length - n; i < ibiHist.length; i++)
              sum += ibiHist[i];
            S.bpmDisp = sum / n;
          }

          ppgBuf.push(ppgSample(beatPhase, tNow, artifact));
          ppgBuf.shift();
          beatMarks.push(0);
          beatMarks.shift();

          bpmHist.push({ t: tNow, bpm: S.bpmDisp });
          while (bpmHist.length && tNow - bpmHist[0].t > 12) bpmHist.shift();

          trendClock += dt;
          if (trendClock >= 0.1) {
            trendClock = 0;
            trendBuf.push({ t: tNow, bpm: S.bpmDisp });
            while (trendBuf.length && tNow - trendBuf[0].t > 30)
              trendBuf.shift();
          }

          // --- sound sensor ---
          S.sndRaw = soundEnvelope(tNow);
          // The module's envelope detector, not a plain average: it grabs a peak
          // almost instantly and bleeds off slowly. That is why a burst-train
          // alarm reads as sustained loud instead of averaging away to nothing.
          S.sndDisp = approach(
            S.sndDisp,
            S.sndRaw,
            S.sndRaw > S.sndDisp ? 0.05 : 0.55,
            dt,
          );

          // --- mode selection, with a short commit delay so the DFPlayer is not
          //     asked to restart a track sixty times a second ---
          const want = decide();
          if (want !== S.candidate) {
            S.candidate = want;
            S.candSince = tNow;
            // Every flip of the raw decision is recorded, even the ones the
            // commit delay below absorbs: a threshold sitting on top of a live
            // reading is worth warning about whether or not the track survives.
            S.candFlips.push(tNow);
            while (S.candFlips.length && tNow - S.candFlips[0] > 10)
              S.candFlips.shift();
          }
          if (want !== S.mode && tNow - S.candSince >= 0.35) {
            commitMode(want);
          }

          // --- crew calmness ---
          const bpmStress = clamp(
            (S.bpmDisp - 62) / Math.max(20, S.hrTh + 28 - 62),
            0,
            1,
          );
          const noiseStress = clamp(S.sndDisp / 1023, 0, 1);
          let ideal = 100 * (1 - (0.62 * bpmStress + 0.38 * noiseStress));
          if (playing && S.audioOn) ideal += 8;
          S.calmness = approach(S.calmness, clamp(ideal, 0, 100), 3.2, dt);

          // --- outcome tracking ---
          const stress = crewStress();
          breathPh += lerp(0.8, 3.2, stress) * dt;
          if (!calmHist.length || tNow - calmHist[calmHist.length - 1].t >= 0.5) {
            calmHist.push({ t: tNow, c: S.calmness });
            while (calmHist.length && tNow - calmHist[0].t > 31) calmHist.shift();
          }
          while (modeMarks.length && tNow - modeMarks[0].t > 31) modeMarks.shift();
          if (run) trackRun(dt);

          // --- DFPlayer status settles back to Playing after a track change ---
          if (S.dfState === "Changed" && tNow - S.dfChangedAt > 1.3)
            S.dfState = "Playing";

          checkFlapping();
        }

        /* =================== MODE COMMIT + FEEDBACK =================== */
        function commitMode(key) {
          const prev = S.mode;
          S.mode = key;
          S.dfState = "Changed";
          S.dfChangedAt = tNow;
          S.changeTimes.push(tNow);
          while (S.changeTimes.length && tNow - S.changeTimes[0] > 60)
            S.changeTimes.shift();
          if (S.src === "bot") retuneAudio(key);
          modeMarks.push({ t: tNow, k: key });
          S.flashAt = tNow;
          S.flashCol = MODES[key].col;
          if (key === "recovery" || (key === "calm" && prev && prev !== "focus")) S.sighAt = tNow; // relieved sigh
          if (run) run.changes++;
          announce(key, prev);
        }

        // The six messages from the spec, each tied to the condition that fires it.
        function announce(key) {
          const hrHigh = S.bpmDisp > S.hrTh;
          const noiseHigh = S.sndDisp > S.snTh;
          if (key === "recovery")
            log("Recovery detected. Continuing gentle music.", "ok");
          else if (key === "deep")
            log(
              "High stress condition detected. Deep calm track selected.",
              "bad",
            );
          else if (key === "relax")
            log("Elevated BPM detected. Switching to calming music.", "warn");
          else if (key === "focus")
            log("Ambient sound is high. Adjusting music mode.", "warn");
          else if (key === "calm" && !hrHigh && !noiseHigh)
            log("Crew status is stable.", "ok");
          else log(MODES[key].name + " selected.", "mus");
        }

        function checkFlapping() {
          // More than three track changes in ten seconds means a threshold is
          // sitting right on top of a live reading — as does a raw decision that
          // keeps flipping even while the commit delay holds the track steady.
          const recent = S.changeTimes.filter((t) => tNow - t <= 10).length;
          if (
            (recent > 3 || S.candFlips.length > 6) &&
            tNow - S.flapWarnAt > 12
          ) {
            S.flapWarnAt = tNow;
            if (run) run.flaps++;
            log("Threshold too sensitive. Music changes too quickly.", "bad");
          }
        }

        const logBox = $("logBox");
        function log(msg, cls) {
          if (msg === S.lastFeedback && logBox.firstChild) return;
          S.lastFeedback = msg;
          const el = document.createElement("div");
          el.className = "logline " + (cls || "");
          const mm = Math.floor(tNow / 60),
            ss = Math.floor(tNow % 60);
          el.innerHTML =
            '<span class="t">' +
            String(mm).padStart(2, "0") +
            ":" +
            String(ss).padStart(2, "0") +
            "</span>" +
            msg;
          logBox.insertBefore(el, logBox.firstChild);
          while (logBox.children.length > 6)
            logBox.removeChild(logBox.lastChild);
          [...logBox.children].forEach((c, i) =>
            c.classList.toggle("fade", i > 2),
          );
        }

        /* =================== DOM SYNC =================== */
        function setFill(el, pct, color) {
          el.style.width = clamp(pct, 0, 100) + "%";
          if (color) el.style.background = color;
        }
        function rangeFill(el) {
          const p = ((el.value - el.min) / (el.max - el.min)) * 100;
          el.style.setProperty("--fill", p + "%");
        }
        const hex = (n) => n.toString(16).toUpperCase().padStart(2, "0");

        function hrStatus() {
          const slope = bpmSlope();
          if (S.bpmDisp > S.hrTh) return ["Agitated", "d"];
          if (S.wasAgitated && slope < -0.35) return ["Recovering", "w"];
          if (S.bpmDisp > S.hrTh - 15) return ["Active", "w"];
          return ["Calm", "g"];
        }
        function sndStatus() {
          if (S.sndDisp > S.snTh) return ["Loud", "d"];
          if (S.sndDisp > S.snTh * 0.55) return ["Moderate", "w"];
          return ["Quiet", "g"];
        }

        function updateDOM() {
          const play = playingMode(),
            m = MODES[play];

          // --- banner ---
          $("bannerTxt").textContent =
            m.name +
            " — " +
            m.desc +
            (S.src === "manual" ? " (manual preview)" : "");
          const chip = $("bannerChip");
          chip.textContent = m.chip;
          chip.style.background = `linear-gradient(145deg, ${rgba(m.col, 0.75)}, ${m.col})`;
          const bn = $("banner");
          bn.style.background = `linear-gradient(145deg, ${rgba(m.col, 0.1)}, ${rgba(m.col, 0.2)})`;
          bn.style.borderColor = rgba(m.col, 0.42);

          // --- situation matrix: the bot's own decision, not the preview ---
          for (const k of MODE_KEYS) {
            const q = $("q_" + k),
              on = S.mode === k;
            q.classList.toggle("on", on);
            q.style.background = on
              ? `linear-gradient(145deg, ${rgba(MODES[k].col, 0.85)}, ${MODES[k].col})`
              : "";
          }

          // --- readings ---
          const [hs, hc] = hrStatus(),
            [ss2, sc] = sndStatus();
          $("st_bpm").textContent = Math.round(S.bpmDisp) + " BPM";
          $("st_bpmStat").textContent = hs;
          $("st_bpmStat").className = "v " + hc;
          $("st_snd").textContent = Math.round(S.sndDisp);
          $("st_sndStat").textContent = ss2;
          $("st_sndStat").className = "v " + sc;
          $("st_raw").textContent = S.bpmRaw.toFixed(1) + " BPM";
          const sl = bpmSlope();
          $("st_slope").textContent =
            Math.abs(sl) < 0.12
              ? "steady"
              : (sl < 0 ? "falling " : "rising ") +
                Math.abs(sl * 60).toFixed(0) +
                " BPM/min";
          $("st_th").textContent = S.hrTh + " / " + S.snTh;
          const cpm = S.changeTimes.length;
          $("st_changes").textContent = cpm + " / min";

          // --- DFPlayer + SD card ---
          $("dfMode").textContent = m.name;
          $("dfTrack").textContent =
            "Track " + String(m.track).padStart(2, "0");
          $("dfFile").textContent = m.file;
          const st = $("dfState");
          st.textContent = !S.running
            ? "Stopped"
            : S.paused
              ? "Paused"
            : S.src === "manual"
              ? "Playing (manual)"
              : S.dfState;
          st.className =
            "mv " +
            (frozen() ? "stop" : S.dfState === "Changed" ? "chg" : "play");
          // Real DFPlayer Mini frame: 7E FF 06 <cmd> 00 <param hi> <param lo> EF
          // A volume change sends its own command, so the learner sees the bus
          // carry more than one kind of instruction.
          if (tNow < S.volFrameUntil) {
            $("dfFrame").innerHTML =
              "7E FF 06 <b>06</b> 00 00 <i>" + hex(S.vol) + "</i> EF";
            $("dfNote").innerHTML =
              "<b>06</b> = set volume · <i>" +
              hex(S.vol) +
              "</i> = volume " +
              S.vol +
              " of 30";
          } else {
            $("dfFrame").innerHTML =
              "7E FF 06 <b>03</b> 00 00 <i>" + hex(m.track) + "</i> EF";
            $("dfNote").innerHTML =
              "<b>03</b> = play track · <i>" +
              hex(m.track) +
              "</i> = track " +
              String(m.track).padStart(2, "0") +
              " on the SD card";
          }
          for (const k of MODE_KEYS)
            $("sd_" + k).classList.toggle("on", k === play);

          // --- speaker info ---
          $("spkInfo").textContent =
            "Volume " +
            S.vol +
            "/30 · " +
            m.tempo +
            " BPM pad" +
            (!S.audioOn ? " · muted" : "");

          // --- calmness ---
          const c = S.calmness;
          const col = c > 70 ? "#22c55e" : c > 45 ? "#f7a23b" : "#ff5470";
          setFill(
            $("calmFill"),
            c,
            `linear-gradient(90deg, ${rgba(col, 0.6)}, ${col})`,
          );
          $("calmVal").textContent = Math.round(c) + "%";
          $("calmStat").textContent =
            c > 78
              ? "Crew is settled"
              : c > 55
                ? "Crew is stabilising"
                : c > 35
                  ? "Crew is unsettled"
                  : "Crew is under stress";
        }

        /* =================== AUDIO SAMPLING FOR VISUALS =================== */
        // The speaker animation is driven by the real output when the browser has
        // let audio start, and by a synthesised stand-in before that, so the
        // visuals never sit dead waiting for a click.
        const waveArr = new Float32Array(256);
        let spkLevel = 0;
        function sampleAudio() {
          const live = S.audioOn && !frozen();
          if (!live) {
            waveArr.fill(0);
            spkLevel = approach(spkLevel, 0, 0.12, 0.016);
            return;
          }
          const m = MODES[playingMode()];
          if (A.ok && A.ctx.state === "running") {
            A.analyser.getByteTimeDomainData(A.data);
            const stp = A.data.length / 256;
            let sum = 0;
            for (let i = 0; i < 256; i++)
              waveArr[i] = (A.data[Math.floor(i * stp)] - 128) / 128;
            for (let i = 0; i < A.data.length; i++) {
              const v = (A.data[i] - 128) / 128;
              sum += v * v;
            }
            spkLevel = clamp(Math.sqrt(sum / A.data.length) * 3.4, 0, 1);
          } else {
            const f = m.tempo / 60,
              amp = (S.vol / 30) * 0.8;
            const beat =
              0.45 +
              0.55 * Math.pow(Math.max(0, Math.sin(tNow * Math.PI * f)), 2);
            for (let i = 0; i < 256; i++) {
              const t = tNow + (i / 256) * 0.04;
              waveArr[i] =
                amp *
                beat *
                (Math.sin(t * TAU * m.root * 0.06) * 0.6 +
                  Math.sin(t * TAU * m.root * 0.1) * 0.4);
            }
            spkLevel = clamp(amp * beat, 0, 1);
          }
        }

        /* =================== POD SCENE =================== */
        function drawPod() {
          const m = MODES[playingMode()];
          const k = clamp(Math.min(W / 860, H / 380), 0.42, 1.5);
          const floorY = H * 0.8;
          const crewX = W * 0.29,
            botX = W * 0.72;

          px.clearRect(0, 0, W, H);
          const bg = px.createLinearGradient(0, 0, 0, H);
          bg.addColorStop(0, "#101a33");
          bg.addColorStop(0.6, "#0a1020");
          bg.addColorStop(1, "#060a16");
          px.fillStyle = bg;
          px.fillRect(0, 0, W, H);

          drawDeck(k, floorY);

          // Floor
          const fg = px.createLinearGradient(0, floorY, 0, H);
          fg.addColorStop(0, "#16213a");
          fg.addColorStop(1, "#0b1223");
          px.fillStyle = fg;
          px.fillRect(0, floorY, W, H - floorY);
          px.strokeStyle = "rgba(140,170,230,0.12)";
          px.lineWidth = 1.5;
          px.beginPath();
          px.moveTo(0, floorY);
          px.lineTo(W, floorY);
          px.stroke();

          // Mode wash: the pod lighting takes the colour of whatever is playing.
          const wash = px.createRadialGradient(
            botX,
            floorY - 70 * k,
            10,
            botX,
            floorY - 70 * k,
            W * 0.62,
          );
          wash.addColorStop(0, rgba(m.col, 0.2 + spkLevel * 0.16));
          wash.addColorStop(1, "rgba(0,0,0,0)");
          px.fillStyle = wash;
          px.fillRect(0, 0, W, H);

          drawSoundSource(k, floorY);
          drawMusicWaves(m, botX, floorY, k, crewX);
          drawAura(crewX, floorY, k);
          drawCrew(crewX, floorY, k);
          drawBot(botX, floorY, k, m);
          drawFloaters(k, floorY);
          drawModeRipple(botX, floorY, k);
          drawCalmRing(k);
        }


        // Observation deck: the whole back wall is window, cupola-style — tall
        // panes between struts that fan out toward the ceiling. Outside, Earth
        // turns below (day side with clouds, night side with city lights and an
        // aurora), the Moon hangs in the dark, the Sun flares in the corner and
        // a satellite drifts past now and then.
        const EARTH = (() => {
          let sd = 917;
          const r = () => ((sd = (sd * 16807) % 2147483647) / 2147483647);
          const land = [],
            clouds = [],
            cities = [];
          for (let i = 0; i < 10; i++) land.push({ a: r(), d: 0.12 + r() * 0.8, w: 0.04 + r() * 0.07, h: 0.02 + r() * 0.05, rot: r() * 3 });
          for (let i = 0; i < 26; i++) clouds.push({ a: r(), d: 0.05 + r() * 0.9, w: 0.015 + r() * 0.05, h: 0.006 + r() * 0.016, rot: r() * 3 });
          for (let i = 0; i < 70; i++) cities.push({ a: r(), d: 0.1 + r() * 0.85, s: 0.6 + r() * 1.4 });
          return { land, clouds, cities };
        })();
        function drawOutside(k, top, bot) {
          const wh = bot - top;
          const sp = px.createLinearGradient(0, top, 0, bot);
          sp.addColorStop(0, "#00020a");
          sp.addColorStop(1, "#040a1c");
          px.fillStyle = sp;
          px.fillRect(0, top, W, wh);
          // stars drift as the station moves
          for (const s2 of stars) {
            const sx = (((s2.x - tNow * 5) % W) + W) % W;
            const sy = top + (s2.y % wh);
            px.globalAlpha = 0.3 + 0.55 * Math.abs(Math.sin(tNow * 0.7 + s2.tw));
            px.fillStyle = "#dce9ff";
            px.beginPath();
            px.arc(sx, sy, s2.r * 0.8, 0, TAU);
            px.fill();
          }
          px.globalAlpha = 1;
          // Moon
          const mx = W * 0.2 - ((tNow * 1.2) % (W * 0.3)) * 0.05,
            my = top + wh * 0.2,
            mr = 13 * k;
          const mg = px.createRadialGradient(mx - mr * 0.3, my - mr * 0.3, 1, mx, my, mr);
          mg.addColorStop(0, "#f1f1ea");
          mg.addColorStop(1, "#9a9a92");
          px.fillStyle = mg;
          px.beginPath();
          px.arc(mx, my, mr, 0, TAU);
          px.fill();
          px.fillStyle = "rgba(90,90,85,0.35)";
          [[-0.3, -0.1, 0.22], [0.25, 0.25, 0.16], [0.1, -0.35, 0.12]].forEach(([dx, dy, rr2]) => {
            px.beginPath();
            px.arc(mx + dx * mr, my + dy * mr, rr2 * mr, 0, TAU);
            px.fill();
          });
          // satellite crossing high up every ~45 s
          const sat = (tNow % 45) / 45;
          if (sat < 0.5) {
            const sx = -40 + (W + 80) * (sat / 0.5),
              sy = top + wh * 0.32 - sat * wh * 0.1;
            px.save();
            px.translate(sx, sy);
            px.rotate(-0.15);
            px.fillStyle = "#c9d2e3";
            px.fillRect(-4 * k, -3 * k, 8 * k, 6 * k);
            px.fillStyle = "#2c4d8a";
            px.fillRect(-18 * k, -2 * k, 12 * k, 4 * k);
            px.fillRect(6 * k, -2 * k, 12 * k, 4 * k);
            px.restore();
          }
          // Earth
          const R = W * 1.35;
          const ecx = W * 0.4,
            ecy = bot + R - wh * 0.36;
          const eg = px.createRadialGradient(ecx - R * 0.25, ecy - R * 0.92, R * 0.05, ecx, ecy, R);
          eg.addColorStop(0, "#3a86d0");
          eg.addColorStop(0.6, "#15497f");
          eg.addColorStop(1, "#0a2a55");
          px.fillStyle = eg;
          px.beginPath();
          px.arc(ecx, ecy, R, 0, TAU);
          px.fill();
          px.save();
          px.beginPath();
          px.arc(ecx, ecy, R, 0, TAU);
          px.clip();
          const capTop = ecy - R;
          const span = W * 1.6;
          const place = (it, speed) => {
            const u = (((it.a - tNow * speed) % 1) + 1) % 1;
            return [-W * 0.3 + u * span, capTop + it.d * wh * 0.42];
          };
          for (const l of EARTH.land) {
            const [lx, ly] = place(l, 0.0035);
            px.fillStyle = "rgba(70,110,72,0.6)";
            px.beginPath();
            px.ellipse(lx, ly, l.w * W, l.h * W * 0.55, l.rot, 0, TAU);
            px.fill();
            px.fillStyle = "rgba(150,130,90,0.3)";
            px.beginPath();
            px.ellipse(lx + l.w * W * 0.3, ly, l.w * W * 0.45, l.h * W * 0.28, l.rot, 0, TAU);
            px.fill();
          }
          for (const c of EARTH.clouds) {
            const [cx3, cy3] = place(c, 0.0055);
            px.fillStyle = "rgba(240,246,255,0.5)";
            px.beginPath();
            px.ellipse(cx3, cy3, c.w * W, c.h * W, c.rot * 0.2, 0, TAU);
            px.fill();
          }
          // night side to the right, with city lights
          const ns = px.createLinearGradient(0, 0, W, 0);
          ns.addColorStop(0, "rgba(0,0,0,0)");
          ns.addColorStop(0.55, "rgba(0,0,12,0.2)");
          ns.addColorStop(0.75, "rgba(0,2,14,0.8)");
          ns.addColorStop(1, "rgba(0,2,14,0.92)");
          px.fillStyle = ns;
          px.fillRect(0, top, W, wh);
          for (const c of EARTH.cities) {
            const [cx3, cy3] = place(c, 0.0035);
            if (cx3 < W * 0.7) continue;
            px.globalAlpha = clamp((cx3 - W * 0.7) / (W * 0.08), 0, 1) * (0.6 + 0.4 * Math.sin(tNow * 3 + c.a * 50));
            px.fillStyle = "#ffd88a";
            px.beginPath();
            px.arc(cx3, cy3, c.s * k, 0, TAU);
            px.fill();
          }
          px.globalAlpha = 1;
          px.restore();
          // atmosphere
          px.strokeStyle = "rgba(120,190,255,0.55)";
          px.lineWidth = 5 * k;
          px.beginPath();
          px.arc(ecx, ecy, R + 2 * k, 0, TAU);
          px.stroke();
          px.strokeStyle = "rgba(170,220,255,0.16)";
          px.lineWidth = 16 * k;
          px.beginPath();
          px.arc(ecx, ecy, R + 9 * k, 0, TAU);
          px.stroke();
          // aurora over the night side
          px.save();
          for (let j = 0; j < 3; j++) {
            px.beginPath();
            for (let i = 0; i <= 40; i++) {
              const xx = W * 0.68 + (W * 0.34 * i) / 40;
              const ang = Math.asin(clamp((xx - ecx) / (R + 14 * k), -1, 1));
              const yy = ecy - Math.cos(ang) * (R + 14 * k) - (6 + j * 5) * k - Math.sin(i * 0.5 + tNow * 1.1 + j) * 4 * k;
              i ? px.lineTo(xx, yy) : px.moveTo(xx, yy);
            }
            px.strokeStyle = j === 2 ? "rgba(190,110,255,0.18)" : "rgba(90,255,170," + (0.28 - j * 0.08) + ")";
            px.lineWidth = (7 - j * 1.5) * k;
            px.stroke();
          }
          px.restore();
          // Sun glare from the top-right corner
          const sx0 = W * 0.985,
            sy0 = top + wh * 0.05;
          const sg = px.createRadialGradient(sx0, sy0, 0, sx0, sy0, 120 * k);
          sg.addColorStop(0, "rgba(255,255,240,0.95)");
          sg.addColorStop(0.12, "rgba(255,240,200,0.55)");
          sg.addColorStop(1, "rgba(255,220,160,0)");
          px.fillStyle = sg;
          px.beginPath();
          px.arc(sx0, sy0, 120 * k, 0, TAU);
          px.fill();
        }
        function drawDeck(k, floorY) {
          const ceil = 16 * k,
            sill = floorY - 26 * k;
          // struts: bottom positions across the wall, fanning out at the top
          const bx = [0.0, 0.17, 0.355, 0.5, 0.645, 0.83, 1.0];
          const struts = bx.map((f) => {
            const xb = W * f;
            return [xb, W / 2 + (xb - W / 2) * 1.12];
          });
          drawOutside(k, ceil, sill);
          // glass: each pane gets its own slow reflection and edge tint
          for (let i = 0; i < struts.length - 1; i++) {
            const [b0, t0] = struts[i],
              [b1, t1] = struts[i + 1];
            px.save();
            px.beginPath();
            px.moveTo(t0, ceil);
            px.lineTo(t1, ceil);
            px.lineTo(b1, sill);
            px.lineTo(b0, sill);
            px.closePath();
            px.clip();
            const pw = Math.max(b1 - b0, t1 - t0);
            const off = ((tNow * 7 + i * 61) % (pw * 2.4)) - pw * 0.7;
            px.globalAlpha = 0.06;
            px.fillStyle = "#ffffff";
            px.beginPath();
            px.moveTo(Math.min(t0, b0) + off, ceil);
            px.lineTo(Math.min(t0, b0) + off + pw * 0.12, ceil);
            px.lineTo(Math.min(t0, b0) + off - pw * 0.25, sill);
            px.lineTo(Math.min(t0, b0) + off - pw * 0.37, sill);
            px.closePath();
            px.fill();
            px.globalAlpha = 1;
            const eg2 = px.createLinearGradient(0, ceil, 0, sill);
            eg2.addColorStop(0, "rgba(120,160,230,0.08)");
            eg2.addColorStop(0.2, "rgba(0,0,0,0)");
            eg2.addColorStop(0.85, "rgba(0,0,0,0)");
            eg2.addColorStop(1, "rgba(120,160,230,0.1)");
            px.fillStyle = eg2;
            px.fillRect(0, ceil, W, sill - ceil);
            px.restore();
          }
          // struts
          px.lineCap = "butt";
          for (const [b, t] of struts) {
            px.strokeStyle = "#1a243d";
            px.lineWidth = 15 * k;
            px.beginPath();
            px.moveTo(t, ceil);
            px.lineTo(b, sill);
            px.stroke();
            px.strokeStyle = "#3a4b72";
            px.lineWidth = 2 * k;
            px.beginPath();
            px.moveTo(t - 5 * k, ceil);
            px.lineTo(b - 5 * k, sill);
            px.stroke();
            px.fillStyle = "#5b6f9c";
            for (let i = 1; i < 6; i++) {
              const f = i / 6;
              px.beginPath();
              px.arc(lerp(t, b, f) + 2 * k, lerp(ceil, sill, f), 1.6 * k, 0, TAU);
              px.fill();
            }
          }
          // ceiling beam with a light strip
          px.fillStyle = "#141d33";
          px.fillRect(0, 0, W, ceil);
          px.fillStyle = "rgba(170,210,255,0.55)";
          px.fillRect(W * 0.08, ceil - 4 * k, W * 0.84, 2 * k);
          // sill console with status LEDs
          px.fillStyle = "#161f37";
          px.fillRect(0, sill, W, floorY - sill);
          px.fillStyle = "#24315a";
          px.fillRect(0, sill, W, 3 * k);
          for (let i = 0; i < 24; i++) {
            const lx = W * 0.03 + (W * 0.94 * i) / 23;
            const on = Math.sin(tNow * 1.7 + i * 2.3) > 0.4;
            px.fillStyle = on ? (i % 5 === 0 ? "#f59e0b" : "#34d399") : "rgba(120,150,210,0.25)";
            px.fillRect(lx, sill + 10 * k, 4 * k, 2.5 * k);
          }
        }

        // Only things that belong in a rest pod float here: the crew member's
        // drink pouch and stray water from it, a sweat towel, the headphones
        // (this is a DJ pod) and a photo from home. Each drifts on its own
        // slow loop and tumbles, staying clear of the floor.
        const FLOATERS = [
          { t: "pouch", fx: 0.43, fy: 0.42, ax: 0.03, ay: 0.05, sx: 0.31, sy: 0.43, ph: 0.2, vr: 0.3 },
          { t: "water", fx: 0.63, fy: 0.3, ax: 0.03, ay: 0.05, sx: 0.21, sy: 0.35, ph: 1.9, vr: 0 },
          { t: "towel", fx: 0.15, fy: 0.44, ax: 0.03, ay: 0.04, sx: 0.17, sy: 0.23, ph: 0.7, vr: 0.08 },
          { t: "headphones", fx: 0.88, fy: 0.52, ax: 0.02, ay: 0.04, sx: 0.21, sy: 0.29, ph: 2.4, vr: 0.18 },
          { t: "photo", fx: 0.08, fy: 0.22, ax: 0.02, ay: 0.03, sx: 0.15, sy: 0.19, ph: 1.1, vr: 0.1 },
          { t: "drops", fx: 0.56, fy: 0.36, ax: 0.02, ay: 0.03, sx: 0.27, sy: 0.33, ph: 3.3, vr: 0.05 },
        ];
        function drawFloaters(k, floorY) {
          // a cable tethered to the ceiling, swaying
          {
            const ax2 = W * 0.22,
              ay2 = 16 * k;
            const sw = Math.sin(tNow * 0.6) * 22 * k;
            px.strokeStyle = "#e0a63a";
            px.lineWidth = 2.4 * k;
            px.lineCap = "round";
            px.beginPath();
            px.moveTo(ax2, ay2);
            px.bezierCurveTo(ax2 + sw, ay2 + 40 * k, ax2 - sw * 1.4, ay2 + 70 * k, ax2 + sw * 0.6, ay2 + 96 * k);
            px.stroke();
            px.fillStyle = "#9aa9c4";
            px.fillRect(ax2 + sw * 0.6 - 3 * k, ay2 + 94 * k, 6 * k, 8 * k);
          }
          for (const f of FLOATERS) {
            const x = W * (f.fx + f.ax * Math.sin(tNow * f.sx + f.ph)),
              y = Math.min(H * (f.fy + f.ay * Math.sin(tNow * f.sy + f.ph * 1.3)), floorY - 30 * k);
            px.save();
            px.translate(x, y);
            px.rotate(f.ph + tNow * f.vr);
            const kk = k * 1.6;
            switch (f.t) {
              case "pouch":
                px.fillStyle = "#cfd8e8";
                rr(px, -6 * kk, -9 * kk, 12 * kk, 18 * kk, 3 * kk);
                px.fill();
                px.fillStyle = "#38bdf8";
                rr(px, -6 * kk, -1 * kk, 12 * kk, 6 * kk, 1 * kk);
                px.fill();
                px.fillStyle = "#7d93bb";
                rr(px, -1.5 * kk, -13 * kk, 3 * kk, 5 * kk, 1 * kk);
                px.fill();
                break;
              case "pen":
                px.fillStyle = "#2563eb";
                rr(px, -12 * kk, -1.6 * kk, 20 * kk, 3.2 * kk, 1.5 * kk);
                px.fill();
                px.fillStyle = "#e5e7eb";
                px.beginPath();
                px.moveTo(8 * kk, -1.6 * kk);
                px.lineTo(13 * kk, 0);
                px.lineTo(8 * kk, 1.6 * kk);
                px.fill();
                break;
              case "tablet":
                px.fillStyle = "#1f2937";
                rr(px, -12 * kk, -8 * kk, 24 * kk, 16 * kk, 2.5 * kk);
                px.fill();
                px.fillStyle = "#38bdf8";
                px.globalAlpha = 0.7;
                rr(px, -10 * kk, -6 * kk, 20 * kk, 12 * kk, 1.5 * kk);
                px.fill();
                px.globalAlpha = 1;
                px.fillStyle = "#e0f2fe";
                for (let i = 0; i < 3; i++) px.fillRect(-8 * kk, (-4 + i * 3.5) * kk, (14 - i * 4) * kk, 1.2 * kk);
                break;
              case "wrench":
                px.fillStyle = "#9ca3af";
                rr(px, -10 * kk, -1.8 * kk, 16 * kk, 3.6 * kk, 1.5 * kk);
                px.fill();
                px.beginPath();
                px.arc(8 * kk, 0, 4.5 * kk, 0.6, TAU - 0.6);
                px.lineTo(8 * kk, 0);
                px.fill();
                break;
              case "orange":
                px.fillStyle = "#fb923c";
                px.beginPath();
                px.arc(0, 0, 6 * kk, 0, TAU);
                px.fill();
                px.fillStyle = "rgba(255,255,255,0.35)";
                px.beginPath();
                px.arc(-2 * kk, -2 * kk, 1.8 * kk, 0, TAU);
                px.fill();
                px.fillStyle = "#16a34a";
                px.beginPath();
                px.ellipse(2 * kk, -6 * kk, 2.5 * kk, 1.2 * kk, 0.5, 0, TAU);
                px.fill();
                break;
              case "water": {
                // a wobbling ball of water, the classic microgravity sight
                const wb = Math.sin(tNow * 3.2) * 0.12;
                px.scale(1 + wb, 1 - wb);
                const wg = px.createRadialGradient(-2 * kk, -2 * kk, 1, 0, 0, 8 * kk);
                wg.addColorStop(0, "rgba(220,240,255,0.9)");
                wg.addColorStop(0.5, "rgba(120,190,255,0.45)");
                wg.addColorStop(1, "rgba(80,150,230,0.25)");
                px.fillStyle = wg;
                px.beginPath();
                px.arc(0, 0, 8 * kk, 0, TAU);
                px.fill();
                px.strokeStyle = "rgba(200,230,255,0.6)";
                px.lineWidth = 1 * kk;
                px.stroke();
                break;
              }
              case "towel": {
                // a soft cloth that ripples as it drifts
                px.fillStyle = "#f8fafc";
                px.beginPath();
                const tw = 22 * kk,
                  th = 13 * kk;
                px.moveTo(-tw / 2, -th / 2);
                for (let i = 0; i <= 8; i++) px.lineTo(-tw / 2 + (tw * i) / 8, -th / 2 + Math.sin(tNow * 2 + i) * 1.4 * kk);
                for (let i = 8; i >= 0; i--) px.lineTo(-tw / 2 + (tw * i) / 8, th / 2 + Math.sin(tNow * 2 + i + 1) * 1.4 * kk);
                px.closePath();
                px.fill();
                px.fillStyle = "#38bdf8";
                px.fillRect(-tw / 2 + 2 * kk, -th / 2 + 2.5 * kk, tw - 4 * kk, 1.6 * kk);
                px.fillRect(-tw / 2 + 2 * kk, th / 2 - 4 * kk, tw - 4 * kk, 1.6 * kk);
                break;
              }
              case "headphones":
                px.strokeStyle = "#475569";
                px.lineWidth = 2.4 * kk;
                px.beginPath();
                px.arc(0, 0, 8 * kk, Math.PI * 1.1, Math.PI * 1.9);
                px.stroke();
                px.fillStyle = "#1f2937";
                rr(px, -10 * kk, -2 * kk, 5 * kk, 8 * kk, 2 * kk);
                px.fill();
                rr(px, 5 * kk, -2 * kk, 5 * kk, 8 * kk, 2 * kk);
                px.fill();
                px.fillStyle = "#8b5cf6";
                px.fillRect(-9 * kk, 0, 3 * kk, 4 * kk);
                px.fillRect(6 * kk, 0, 3 * kk, 4 * kk);
                break;
              case "photo":
                px.fillStyle = "#f8fafc";
                rr(px, -8 * kk, -10 * kk, 16 * kk, 20 * kk, 1.5 * kk);
                px.fill();
                {
                  const pg = px.createLinearGradient(0, -8 * kk, 0, 4 * kk);
                  pg.addColorStop(0, "#7dd3fc");
                  pg.addColorStop(1, "#86efac");
                  px.fillStyle = pg;
                  px.fillRect(-6.5 * kk, -8.5 * kk, 13 * kk, 13 * kk);
                }
                px.fillStyle = "#fbbf24";
                px.beginPath();
                px.arc(3 * kk, -5 * kk, 1.8 * kk, 0, TAU);
                px.fill();
                px.fillStyle = "#475569";
                px.fillRect(-5 * kk, 6.5 * kk, 10 * kk, 1 * kk);
                break;
              case "drops":
                [[0, 0, 2.6], [7, -4, 1.6], [-6, 5, 1.9], [4, 7, 1.2]].forEach(([dx, dy, r2], i) => {
                  const wob = Math.sin(tNow * 3 + i) * 0.12;
                  px.save();
                  px.translate(dx * kk, dy * kk);
                  px.scale(1 + wob, 1 - wob);
                  px.fillStyle = "rgba(140,200,255,0.55)";
                  px.beginPath();
                  px.arc(0, 0, r2 * kk, 0, TAU);
                  px.fill();
                  px.fillStyle = "rgba(255,255,255,0.8)";
                  px.beginPath();
                  px.arc(-r2 * 0.35 * kk, -r2 * 0.35 * kk, r2 * 0.3 * kk, 0, TAU);
                  px.fill();
                  px.restore();
                });
                break;
              case "food":
                px.fillStyle = "#d1d5db";
                rr(px, -9 * kk, -7 * kk, 18 * kk, 14 * kk, 2 * kk);
                px.fill();
                px.fillStyle = "#ef4444";
                px.fillRect(-9 * kk, -2 * kk, 18 * kk, 4 * kk);
                px.fillStyle = "#6b7280";
                px.fillRect(-9 * kk, -7 * kk, 18 * kk, 2 * kk);
                break;
              case "candy":
                ["#ef4444", "#facc15", "#22c55e", "#3b82f6", "#a855f7"].forEach((c, i) => {
                  px.fillStyle = c;
                  px.beginPath();
                  px.arc(Math.cos(i * 1.3) * 8 * kk, Math.sin(i * 2.1) * 6 * kk, 2.4 * kk, 0, TAU);
                  px.fill();
                });
                break;
              case "sock":
                px.fillStyle = "#e5e7eb";
                rr(px, -4 * kk, -10 * kk, 8 * kk, 14 * kk, 3 * kk);
                px.fill();
                rr(px, -4 * kk, 0, 13 * kk, 7 * kk, 3.5 * kk);
                px.fill();
                px.fillStyle = "#3b82f6";
                px.fillRect(-4 * kk, -10 * kk, 8 * kk, 2.5 * kk);
                break;
            }
            px.restore();
          }
        }

        /* =================== OUTCOME VISUALS =================== */
        // 0 = settled, 1 = under stress. Driven by the same calmness score the
        // bar shows, so the body language never disagrees with the numbers.
        function crewStress() {
          return clamp((80 - S.calmness) / 50, 0, 1);
        }
        // What kind of stress it is decides how it shows. A high pulse after a
        // workout is tiredness, not fear; a loud room is irritation.
        //   tired   — Post-Exercise: slumped back, panting, flushed, wipes brow
        //   panic   — Equipment Alarm: startled, shaking, hand on chest
        //   anxious — EVA Prep: nervous fidgeting, worried brows
        //   noise   — loud room (Comms Check): squint, grimace, hand to ear
        //   tense   — high pulse set by hand: tense, no shaking
        //   calm    — everything else
        function crewMood() {
          const st = crewStress();
          const loud = S.sndDisp > S.snTh;
          if (st < 0.22) return loud ? "noise" : "calm";
          switch (S.scKey) {
            case "exercise":
              return "tired";
            case "alarm":
              return "panic";
            case "comms":
              return "noise";
            case "eva":
              return "anxious";
          }
          return loud ? "noise" : "tense";
        }
        function crewSleepy() {
          return clamp((S.calmness - 86) / 9, 0, 1);
        }
        function mixCol(a, b, t) {
          const A1 = hex2rgb(a),
            B1 = hex2rgb(b);
          return A1.map((v, i) => Math.round(lerp(v, B1[i], t)));
        }
        const rgbA = (c, a) => `rgba(${c[0]},${c[1]},${c[2]},${a})`;
        function calmCol(c) {
          return c > 70 ? "#22c55e" : c > 45 ? "#f7a23b" : "#ff5470";
        }

        // A halo round the crew member: soft teal when settled, a jagged red
        // flare under stress.
        function drawAura(cx, floorY, k) {
          const st = crewStress();
          const mood = crewMood();
          // red spikes for fright, warm orange for exertion, amber for noise
          const hot = mood === "tired" ? "#fb923c" : mood === "noise" ? "#f59e0b" : "#ff5470";
          const col = mixCol("#5eead4", hot, st);
          const spiky = mood === "panic" ? 1 : mood === "anxious" || mood === "tense" ? 0.6 : 0.25;
          const ox = cx - 2 * k,
            oy = floorY - 92 * k;
          const R = (76 + Math.sin(breathPh) * 4) * k;
          const g = px.createRadialGradient(ox, oy, 8 * k, ox, oy, R * 1.25);
          g.addColorStop(0, rgbA(col, 0.16 + st * 0.18));
          g.addColorStop(1, rgbA(col, 0));
          px.fillStyle = g;
          px.beginPath();
          px.arc(ox, oy, R * 1.25, 0, TAU);
          px.fill();
          if (st > 0.05) {
            px.strokeStyle = rgbA(col, 0.25 + st * 0.45);
            px.lineWidth = (1.5 + st * 1.5) * k;
            px.beginPath();
            for (let i = 0; i <= 64; i++) {
              const a = (i / 64) * TAU;
              const n =
                Math.sin(a * 7 + tNow * 9) * 0.5 +
                Math.sin(a * 13 - tNow * 6.5) * 0.5;
              const r = R * (0.92 + st * 0.13 * spiky * n);
              const x = ox + Math.cos(a) * r,
                y = oy + Math.sin(a) * r * 0.92;
              i ? px.lineTo(x, y) : px.moveTo(x, y);
            }
            px.closePath();
            px.stroke();
          }
        }

        function drawModeRipple(bx, floorY, k) {
          const age = tNow - S.flashAt;
          if (age < 0 || age > 1.3) return;
          const ph = age / 1.3;
          px.save();
          px.globalAlpha = (1 - ph) * 0.8;
          px.strokeStyle = S.flashCol;
          px.lineWidth = (5 - ph * 3) * k;
          px.shadowColor = S.flashCol;
          px.shadowBlur = 16 * k;
          px.beginPath();
          px.arc(bx, floorY - 90 * k, (30 + ph * 260) * k, 0, TAU);
          px.stroke();
          px.restore();
        }

        // Calmness as a ring gauge on the stage, with how it moved in 30 s.
        function drawCalmRing(k) {
          const c = S.calmness;
          const col = calmCol(c);
          const R = Math.max(22, Math.min(34 * k, H * 0.12));
          const x = W * 0.5,
            y = R + Math.max(12, H * 0.05);
          px.save();
          px.fillStyle = "rgba(5,8,22,0.7)";
          px.beginPath();
          px.arc(x, y, R + 6, 0, TAU);
          px.fill();
          px.lineCap = "round";
          px.lineWidth = Math.max(5, R * 0.2);
          px.strokeStyle = "rgba(140,160,255,0.16)";
          px.beginPath();
          px.arc(x, y, R, 0, TAU);
          px.stroke();
          px.strokeStyle = col;
          px.shadowColor = col;
          px.shadowBlur = 12;
          px.beginPath();
          px.arc(x, y, R, -Math.PI / 2, -Math.PI / 2 + TAU * clamp(c / 100, 0.001, 1));
          px.stroke();
          px.shadowBlur = 0;
          px.textAlign = "center";
          px.textBaseline = "middle";
          px.fillStyle = "#eef2ff";
          px.font = "800 " + Math.round(R * 0.5) + "px Orbitron, sans-serif";
          px.fillText(Math.round(c) + "%", x, y - R * 0.08);
          px.fillStyle = "rgba(220,228,255,0.65)";
          px.font = "700 " + Math.max(8, Math.round(R * 0.22)) + "px Orbitron, sans-serif";
          px.fillText("CALM", x, y + R * 0.38);

          // Change over the last 30 s
          let d = 0;
          if (calmHist.length > 1) {
            const old = calmHist.find((h) => h.t >= tNow - 30) || calmHist[0];
            d = c - old.c;
          }
          const fs = Math.max(11, Math.round(R * 0.36));
          px.font = "700 " + fs + "px Rajdhani, sans-serif";
          px.textBaseline = "top";
          const ty = y + R + 10;
          let txt, tc;
          if (Math.abs(d) < 2) {
            txt = "● steady";
            tc = "rgba(220,228,255,0.7)";
          } else if (d > 0) {
            txt = "▲ +" + Math.round(d) + "% in 30 s";
            tc = "#4ade80";
          } else {
            txt = "▼ " + Math.round(d) + "% in 30 s";
            tc = "#ff7a93";
          }
          const label = "CREW CALMNESS  " + txt;
          const tw = px.measureText(label).width;
          px.fillStyle = "rgba(5,8,22,0.7)";
          rr(px, x - tw / 2 - 8, ty - 3, tw + 16, fs + 7, 7);
          px.fill();
          px.fillStyle = "rgba(220,228,255,0.75)";
          px.textAlign = "left";
          const lw = px.measureText("CREW CALMNESS  ").width;
          px.fillText("CREW CALMNESS  ", x - tw / 2, ty);
          px.fillStyle = tc;
          px.fillText(txt, x - tw / 2 + lw, ty);
          px.restore();
        }

        // Two-bone IK: joint position for a limb from P to target T.
        // bend = +1 / -1 picks which side the elbow or knee folds to.
        function ik(px1, py1, tx, ty, l1, l2, bend) {
          let dx = tx - px1,
            dy = ty - py1;
          let d = Math.hypot(dx, dy) || 0.001;
          const maxd = (l1 + l2) * 0.999;
          if (d > maxd) {
            dx *= maxd / d;
            dy *= maxd / d;
            d = maxd;
          }
          const base = Math.atan2(dy, dx);
          const c = clamp((l1 * l1 + d * d - l2 * l2) / (2 * l1 * d), -1, 1);
          const ang = base + bend * Math.acos(c);
          return [px1 + Math.cos(ang) * l1, py1 + Math.sin(ang) * l1, px1 + dx, py1 + dy];
        }
        // A limb segment: dark outline, then the suit colour on top.
        function limb(x1, y1, x2, y2, w, fill, line, k) {
          px.lineCap = "round";
          px.strokeStyle = line;
          px.lineWidth = w + 3 * k;
          px.beginPath();
          px.moveTo(x1, y1);
          px.lineTo(x2, y2);
          px.stroke();
          px.strokeStyle = fill;
          px.lineWidth = w;
          px.beginPath();
          px.moveTo(x1, y1);
          px.lineTo(x2, y2);
          px.stroke();
        }
        const smooth = (x) => {
          const t = clamp(x, 0, 1);
          return t * t * (3 - 2 * t);
        };

        // The crew member inside the station: no spacesuit, just the on-board
        // clothes (crew polo, cargo trousers, socks and soft shoes). They sit
        // in a rest seat held by a lap strap; their hair floats a little in
        // microgravity. Everything about the pose comes from the calmness score:
        //   stressed — sits forward off the backrest, hand on the chest, heels
        //              bouncing, fingers drumming, head darting about
        //   settled  — leans back, hand resting on the thigh, nods to the music
        //   asleep   — head droops onto the headrest, z z z
        // The MAX30102 is a band on the wrist resting on the armrest.
        function drawCrew(cx, floorY, k) {
          const st = crewStress(),
            zz = crewSleepy();
          const mood = crewMood();
          const panic = mood === "panic",
            tired = mood === "tired",
            nervy = mood === "anxious" || mood === "tense";
          // only real fright shakes the body; nerves just fidget
          const shake = panic ? smooth((st - 0.45) / 0.5) : nervy ? 0.4 * smooth((st - 0.2) / 0.5) : 0;
          const tiredAmt = tired ? smooth((st - 0.15) / 0.5) : 0;
          const m = MODES[playingMode()];
          const music = spkLevel > 0.02 ? clamp(spkLevel * 1.6, 0, 1) : 0;
          const nod = Math.sin(tNow * TAU * (m.tempo / 60) * 0.5) * music * (1 - st) * (1 - zz);

          const SHIRT = "#2f5d9e",
            SHIRT_L = "#1b365f",
            SHIRT_F = "#264c83",
            PANTS = "#8c7f5e",
            PANTS_L = "#5c5340",
            PANTS_F = "#73684d",
            SKIN = "#f1c7a3",
            SKIN_L = "#bf8f6a",
            SKIN_F = "#d9ac88",
            SHOE = "#2a3346",
            SEAT = "#22304f",
            SEAT2 = "#2c3d63";

          // --- seat ---------------------------------------------------------
          const hipX = cx - 8 * k,
            hipY = floorY - 62 * k;
          const BACK = -0.26; // backrest recline
          px.fillStyle = "#18223a";
          rr(px, cx - 22 * k, floorY - 44 * k, 22 * k, 44 * k, 5 * k);
          px.fill();
          px.fillStyle = "#1f2b47";
          px.beginPath();
          px.ellipse(cx - 11 * k, floorY - 2 * k, 38 * k, 6 * k, 0, 0, TAU);
          px.fill();
          px.save();
          px.translate(hipX - 21 * k, hipY + 6 * k);
          px.rotate(BACK);
          px.fillStyle = SEAT;
          rr(px, -11 * k, -84 * k, 22 * k, 88 * k, 10 * k);
          px.fill();
          px.strokeStyle = SEAT2;
          px.lineWidth = 2 * k;
          rr(px, -11 * k, -84 * k, 22 * k, 88 * k, 10 * k);
          px.stroke();
          px.fillStyle = SEAT2;
          rr(px, -9 * k, -104 * k, 24 * k, 20 * k, 9 * k);
          px.fill();
          px.restore();
          px.fillStyle = SEAT;
          rr(px, hipX - 26 * k, hipY + 4 * k, 64 * k, 13 * k, 6 * k);
          px.fill();
          // footrest bar on a strut
          px.strokeStyle = "#18223a";
          px.lineWidth = 4 * k;
          px.beginPath();
          px.moveTo(hipX + 30 * k, hipY + 16 * k);
          px.lineTo(hipX + 50 * k, floorY - 8 * k);
          px.stroke();
          px.fillStyle = SEAT2;
          rr(px, hipX + 36 * k, floorY - 10 * k, 32 * k, 6 * k, 3 * k);
          px.fill();

          // --- body frame -----------------------------------------------------
          // Torso shape in its own frame (x = forward, y up is negative),
          // rotated by `lean` about the hip. Joints are points on that shape.
          const breath = Math.sin(breathPh);
          const lean = tired
            ? BACK - 0.06 * tiredAmt // slumped right back into the seat
            : panic || nervy
              ? lerp(BACK, 0.07, st)
              : mood === "noise"
                ? lerp(BACK, BACK + 0.12, st)
                : BACK - 0.04 * zz;
          const cl = Math.cos(lean),
            sl = Math.sin(lean);
          const jx = panic ? Math.sin(tNow * 17) * Math.sin(tNow * 3.1) * 0.9 * k * shake : 0;
          const hop = (panic || mood === "noise") && S.startleAt !== undefined && tNow - S.startleAt < 0.7 ? Math.sin(((tNow - S.startleAt) / 0.7) * Math.PI) : 0;
          const Hx = hipX + jx,
            Hy = hipY - hop * 4 * k; // startle: jolts up off the seat
          // panting after exercise: deep, heaving breaths
          const heave = 1 + 0.9 * tiredAmt;
          const chest = 1 + breath * lerp(0.02, 0.05, st) * heave;
          const lift = breath * lerp(0.6, 1.6, st) * k * heave;
          const toW = (lx, ly) => [Hx + lx * cl - ly * sl, Hy + lx * sl + ly * cl];
          const [Sx, Sy] = toW(-2 * k, -44 * k - lift);
          const [FSx, FSy] = toW(-6 * k, -44 * k - lift);
          const [Nx, Ny] = toW(1 * k, -49 * k - lift);
          const [HPx, HPy] = toW(5 * k, -2 * k);
          const [FHx, FHy] = toW(-1 * k, -4 * k);

          // short-lived reactions on top of the mood
          const since = (t0) => (t0 === undefined ? 99 : tNow - t0);
          const glance = since(S.flashAt) < 2.6 ? Math.sin(clamp(since(S.flashAt) / 2.6, 0, 1) * Math.PI) : 0; // looks at the bot when the music changes
          const startle = (panic || mood === "noise") && since(S.startleAt) < 0.7 ? Math.sin((since(S.startleAt) / 0.7) * Math.PI) : 0;
          const sigh = since(S.sighAt) < 2.8 ? Math.sin((since(S.sighAt) / 2.8) * Math.PI) : 0;
          // a yawn every ~14 s while drifting off
          const yc = (tNow % 14) / 14;
          const yawn = mood === "calm" && st < 0.2 && zz > 0.02 && zz < 0.6 && yc < 0.16 ? Math.sin((yc / 0.16) * Math.PI) : 0;
          S.face = { glance, startle, sigh, yawn };
          const look = panic || nervy ? (Math.sin(tNow * 2.3) * 0.7 + Math.sin(tNow * 5.1) * 0.3) * 0.08 * (panic ? shake : 0.7) : 0;
          const headRot = tired
            ? lean * 0.6 - 0.14 * tiredAmt + Math.sin(breathPh) * 0.03 * tiredAmt // head back, bobbing with each breath
            : lean * 0.6 + lerp(-0.04, panic || nervy ? 0.08 : 0.02, st) + zz * 0.2 + nod * 0.05 + look + glance * 0.07 - yawn * 0.12 - sigh * 0.05;

          // Limb segments drawn as one piece: all outlines, then all fills.
          function limbs(segs, fill, line) {
            px.lineCap = "round";
            px.lineJoin = "round";
            px.strokeStyle = line;
            for (const g of segs) {
              px.lineWidth = g[4] + 2.6 * k;
              px.beginPath();
              px.moveTo(g[0], g[1]);
              px.lineTo(g[2], g[3]);
              px.stroke();
            }
            px.strokeStyle = fill;
            for (const g of segs) {
              px.lineWidth = g[4];
              px.beginPath();
              px.moveTo(g[0], g[1]);
              px.lineTo(g[2], g[3]);
              px.stroke();
            }
          }
          function shoe(ax, ay, kx, ky, col) {
            const ang = Math.atan2(ay - ky, ax - kx) - Math.PI / 2;
            px.save();
            px.translate(ax, ay);
            px.rotate(ang);
            px.fillStyle = "#cfd6e4"; // sock cuff
            rr(px, -6 * k, -5 * k, 12 * k, 5 * k, 2 * k);
            px.fill();
            px.fillStyle = col;
            rr(px, -7 * k, -1 * k, 22 * k, 9 * k, 4.5 * k);
            px.fill();
            px.fillStyle = "#cfd6e4"; // sole
            rr(px, -7 * k, 6 * k, 22 * k, 2.5 * k, 1.2 * k);
            px.fill();
            px.fillStyle = "rgba(255,255,255,0.35)"; // laces
            for (let i = 0; i < 3; i++) px.fillRect((1 + i * 3) * k, 0.5 * k, 1.6 * k, 1.2 * k);
            px.restore();
          }
          // An arm with a short sleeve: skin limb, sleeve with a hem over the top.
          function arm(sx, sy, ex, ey, wx, wy, sleeve, sleeveL, skin, skinL) {
            limbs(
              [
                [sx, sy, ex, ey, 11 * k],
                [ex, ey, wx, wy, 10 * k],
              ],
              skin,
              skinL,
            );
            const mx = lerp(sx, ex, 0.55),
              my = lerp(sy, ey, 0.55);
            limbs([[sx, sy, mx, my, 15 * k]], sleeve, sleeveL);
            px.fillStyle = sleeve;
            px.beginPath();
            px.arc(sx, sy, 7.6 * k, 0, TAU);
            px.fill();
            // sleeve hem
            const ang = Math.atan2(my - sy, mx - sx);
            px.strokeStyle = sleeveL;
            px.lineWidth = 2.2 * k;
            px.beginPath();
            px.moveTo(mx - Math.sin(ang) * 7.4 * k, my + Math.cos(ang) * 7.4 * k);
            px.lineTo(mx + Math.sin(ang) * 7.4 * k, my - Math.cos(ang) * 7.4 * k);
            px.stroke();
          }

          // --- far leg (behind) -------------------------------------------------
          const bounce = Math.abs(Math.sin(tNow * 11)) * 3 * k * shake;
          const footX = lerp(hipX + 52 * k, hipX + 40 * k, panic || nervy ? st : 0),
            footY = lerp(floorY - 14 * k, floorY - 16 * k, st);
          const [fkx, fky, fax, fay] = ik(FHx, FHy, footX - 6 * k, footY - 1 * k, 40 * k, 42 * k, -1);
          limbs(
            [
              [FHx, FHy, fkx, fky, 17 * k],
              [fkx, fky, fax, fay, 13 * k],
            ],
            PANTS_F,
            PANTS_L,
          );
          shoe(fax, fay, fkx, fky, "#232b3d");

          // --- far arm: rests on the thigh, clutches the chest under stress -----
          const restX = Hx + 15 * k,
            restY = Hy - 8 * k;
          const hc = [Nx + Math.sin(headRot) * 22 * k, Ny - Math.cos(headRot) * 22 * k];
          const inHead = (a2, b2) => [hc[0] + a2 * Math.cos(headRot) - b2 * Math.sin(headRot), hc[1] + a2 * Math.sin(headRot) + b2 * Math.cos(headRot)];
          let tgt = toW(15 * k, -30 * k - lift),
            grab = 0;
          if (panic) grab = smooth((st - 0.5) / 0.35); // hand clutches the chest
          else if (tired) {
            // every few seconds the back of the hand wipes the brow
            const c = (tNow % 7) / 7;
            grab = (c < 0.28 ? Math.sin((c / 0.28) * Math.PI) : 0) * tiredAmt;
            tgt = inHead(9 * k, -9 * k);
          } else if (mood === "noise") {
            S.earAmt = approach(S.earAmt || 0, S.sndDisp > S.snTh ? 1 : 0.15, 0.3, 1 / 60);
            grab = S.earAmt;
            tgt = inHead(-13 * k, 4 * k); // hand cupped over the ear, at the side of the head
          }
          const [fex, fey, fwx, fwy] = ik(
            FSx,
            FSy,
            lerp(restX, tgt[0], grab),
            lerp(restY, tgt[1], grab),
            25 * k,
            24 * k,
            1,
          );
          // A hand as one simple mitten with a thumb — no separate fingers.
          function hand(hx2, hy2, ang, skin, skinL) {
            px.save();
            px.translate(hx2, hy2);
            px.rotate(ang);
            px.fillStyle = skin;
            px.strokeStyle = skinL;
            px.lineWidth = 1.2 * k;
            px.beginPath();
            px.ellipse(4.5 * k, 0, 6.2 * k, 4.6 * k, 0, 0, TAU);
            px.fill();
            px.stroke();
            px.beginPath();
            px.ellipse(3 * k, -4 * k, 2.6 * k, 1.8 * k, -0.6, 0, TAU);
            px.fill();
            px.stroke();
            px.restore();
          }
          const farArm = () => {
            arm(FSx, FSy, fex, fey, fwx, fwy, SHIRT_F, SHIRT_L, SKIN_F, SKIN_L);
            hand(fwx, fwy, Math.atan2(fwy - fey, fwx - fex), SKIN_F, SKIN_L);
          };
          if (grab < 0.5 || mood === "noise") farArm(); // far hand to far ear stays behind the head

          // --- torso + near leg: one outline pass, one fill pass -----------------
          const [nkx, nky, nax, nay] = ik(HPx, HPy, footX, footY - bounce, 40 * k, 42 * k, -1);
          const torsoPath = () => {
            px.save();
            px.translate(Hx, Hy);
            px.rotate(lean);
            px.scale(chest, 1);
            const t = -lift;
            px.beginPath();
            px.moveTo(-15 * k, 8 * k);
            px.lineTo(-16 * k, -22 * k);
            px.quadraticCurveTo(-18 * k, -46 * k + t, -7 * k, -50 * k + t);
            px.lineTo(8 * k, -50 * k + t);
            px.quadraticCurveTo(20 * k, -48 * k + t, 19 * k, -33 * k);
            px.quadraticCurveTo(16 * k, -18 * k, 17 * k, -4 * k);
            px.quadraticCurveTo(17 * k, 9 * k, 3 * k, 9 * k);
            px.quadraticCurveTo(-13 * k, 9 * k, -15 * k, 8 * k);
            px.closePath();
            px.restore();
          };
          const nearLeg = [
            [HPx, HPy, nkx, nky, 19 * k],
            [nkx, nky, nax, nay, 15 * k],
          ];
          px.lineWidth = 2.6 * k;
          px.strokeStyle = SHIRT_L;
          torsoPath();
          px.stroke();
          px.lineCap = "round";
          px.strokeStyle = PANTS_L;
          for (const g of nearLeg) {
            px.lineWidth = g[4] + 2.6 * k;
            px.beginPath();
            px.moveTo(g[0], g[1]);
            px.lineTo(g[2], g[3]);
            px.stroke();
          }
          px.fillStyle = SHIRT;
          torsoPath();
          px.fill();
          // trousers up to the waist
          px.save();
          torsoPath();
          px.clip();
          px.translate(Hx, Hy);
          px.rotate(lean);
          px.fillStyle = PANTS;
          px.fillRect(-30 * k, -10 * k, 60 * k, 30 * k);
          px.fillStyle = "rgba(0,0,0,0.12)"; // shade down the back
          px.fillRect(-30 * k, -60 * k, 14 * k, 80 * k);
          const sh = px.createLinearGradient(-16 * k, 0, 20 * k, 0); // soft light on the chest
          sh.addColorStop(0, "rgba(255,255,255,0)");
          sh.addColorStop(0.75, "rgba(255,255,255,0.1)");
          sh.addColorStop(1, "rgba(255,255,255,0)");
          px.fillStyle = sh;
          px.fillRect(-20 * k, -55 * k, 40 * k, 45 * k);
          // shirt placket with two buttons, and a fold line
          px.strokeStyle = "rgba(15,30,60,0.45)";
          px.lineWidth = 1.2 * k;
          px.beginPath();
          px.moveTo(13 * k, -48 * k - lift);
          px.lineTo(13 * k, -40 * k - lift);
          px.moveTo(-6 * k, -20 * k);
          px.quadraticCurveTo(2 * k, -16 * k, 12 * k, -19 * k);
          px.stroke();
          px.fillStyle = "#dbe4f3";
          [-46, -42].forEach((yy) => {
            px.beginPath();
            px.arc(14.5 * k, yy * k - lift, 0.9 * k, 0, TAU);
            px.fill();
          });
          px.restore();
          px.strokeStyle = PANTS;
          for (const g of nearLeg) {
            px.lineWidth = g[4];
            px.beginPath();
            px.moveTo(g[0], g[1]);
            px.lineTo(g[2], g[3]);
            px.stroke();
          }
          // crease down the shin
          px.strokeStyle = "rgba(255,255,255,0.12)";
          px.lineWidth = 1.4 * k;
          px.beginPath();
          px.moveTo(lerp(nkx, nax, 0.1), lerp(nky, nay, 0.1));
          px.lineTo(lerp(nkx, nax, 0.85), lerp(nky, nay, 0.85));
          px.stroke();
          // cargo pocket on the thigh
          px.save();
          px.translate(lerp(HPx, nkx, 0.55), lerp(HPy, nky, 0.55));
          px.rotate(Math.atan2(nky - HPy, nkx - HPx));
          px.fillStyle = PANTS_F;
          rr(px, -6 * k, -1 * k, 12 * k, 8 * k, 2 * k);
          px.fill();
          px.restore();
          shoe(nax, nay, nkx, nky, SHOE);

          // shirt details, lap strap, heartbeat glow on the chest
          px.save();
          px.translate(Hx, Hy);
          px.rotate(lean);
          px.fillStyle = "#f4c95d"; // mission patch
          px.beginPath();
          px.arc(9 * k, -36 * k - lift, 3.6 * k, 0, TAU);
          px.fill();
          px.fillStyle = SHIRT_L;
          px.beginPath();
          px.arc(9 * k, -36 * k - lift, 1.8 * k, 0, TAU);
          px.fill();
          px.fillStyle = "#1b2540"; // lap strap + buckle
          rr(px, -16 * k, -9 * k, 34 * k, 5 * k, 2 * k);
          px.fill();
          px.fillStyle = "#9aa9c4";
          rr(px, 5 * k, -10 * k, 6 * k, 7 * k, 1.5 * k);
          px.fill();
          const beat = Math.exp(-Math.pow((beatPhase - 0.13) / 0.1, 2));
          px.globalAlpha = 0.35 + beat * 0.55;
          px.shadowColor = "rgba(255,77,109,0.9)";
          px.shadowBlur = (4 + beat * 10) * k;
          px.fillStyle = "#ff4d6d";
          heart(px, 2 * k, -30 * k - lift, (3.6 + beat * 1.6) * k);
          px.fill();
          px.restore();

          // --- armrest ---------------------------------------------------------------
          const armTop = hipY - 20 * k;
          px.fillStyle = "#18223a";
          rr(px, hipX + 24 * k, armTop + 6 * k, 6 * k, 18 * k, 2 * k);
          px.fill();
          px.fillStyle = SEAT2;
          rr(px, hipX - 20 * k, armTop, 60 * k, 8 * k, 4 * k);
          px.fill();

          // --- neck + head (turns about the neck) --------------------------------------
          px.save();
          px.translate(Nx, Ny);
          px.rotate(headRot);
          px.lineCap = "round";
          px.strokeStyle = SKIN_L;
          px.lineWidth = 11.5 * k;
          px.beginPath();
          px.moveTo(0, 2 * k);
          px.lineTo(1 * k, -12 * k);
          px.stroke();
          px.strokeStyle = SKIN;
          px.lineWidth = 9 * k;
          px.stroke();
          px.restore();
          // shirt collar over the base of the neck
          px.save();
          px.translate(Nx, Ny);
          px.rotate(lean);
          px.fillStyle = SHIRT_L;
          px.beginPath();
          px.moveTo(-8 * k, -1 * k);
          px.quadraticCurveTo(0, 5 * k, 9 * k, -1 * k);
          px.lineTo(9 * k, 3 * k);
          px.quadraticCurveTo(0, 9 * k, -8 * k, 3 * k);
          px.closePath();
          px.fill();
          // polo collar flaps
          px.fillStyle = "#3a6db3";
          px.beginPath();
          px.moveTo(2 * k, 2 * k);
          px.lineTo(11 * k, 0);
          px.lineTo(9 * k, 7 * k);
          px.closePath();
          px.moveTo(-1 * k, 2 * k);
          px.lineTo(-8 * k, 0);
          px.lineTo(-6 * k, 6 * k);
          px.closePath();
          px.fill();
          px.restore();
          px.save();
          px.translate(Nx, Ny);
          px.rotate(headRot);
          px.translate(0, -22 * k);
          drawHead(0, 0, k, st, zz, mood);
          px.restore();

          if (grab >= 0.5 && mood !== "noise") farArm();

          // --- near arm: elbow on the armrest, forearm along it, band on the wrist ----
          {
            const tap = Math.sin(tNow * 14) * 1.1 * k * shake;
            const ex = hipX - 13 * k + jx,
              ey = armTop - 3 * k;
            const fa = -0.05 - st * 0.22;
            const wx = ex + Math.cos(fa) * 26 * k,
              wy = ey + Math.sin(fa) * 26 * k;
            arm(Sx, Sy, ex, ey, wx, wy, SHIRT, SHIRT_L, SKIN, SKIN_L);

            const da = Math.atan2(wy - ey, wx - ex);
            px.save();
            px.translate(wx, wy);
            px.rotate(da);
            // hand: a mitten that taps on the armrest when nervous
            px.save();
            px.rotate(tap * 0.05);
            px.fillStyle = SKIN;
            px.strokeStyle = SKIN_L;
            px.lineWidth = 1.2 * k;
            px.beginPath();
            px.ellipse(6 * k, 0, 7 * k, 5 * k, 0, 0, TAU);
            px.fill();
            px.stroke();
            px.beginPath();
            px.ellipse(4 * k, -4.4 * k, 2.8 * k, 1.9 * k, -0.5, 0, TAU);
            px.fill();
            px.stroke();
            px.restore();

            // MAX30102 wristband: strap round the wrist, sensor pod on top
            px.fillStyle = "#1b2540";
            rr(px, -3.5 * k, -6.5 * k, 7 * k, 13 * k, 2.5 * k);
            px.fill();
            px.fillStyle = "#2a3a5e";
            rr(px, -5.5 * k, -10.5 * k, 11 * k, 5.5 * k, 2 * k);
            px.fill();
            px.strokeStyle = "#5b78b0";
            px.lineWidth = 1 * k;
            rr(px, -5.5 * k, -10.5 * k, 11 * k, 5.5 * k, 2 * k);
            px.stroke();
            const beat2 = Math.exp(-Math.pow((beatPhase - 0.13) / 0.11, 2));
            px.shadowColor = "rgba(255,60,90,0.95)";
            px.shadowBlur = (6 + beat2 * 12) * k;
            px.fillStyle = "#ff3b5c";
            px.beginPath();
            px.arc(0, -7.8 * k, (1.6 + beat2 * 1.1) * k, 0, TAU);
            px.fill();
            px.restore();

            const lx = wx + 32 * k,
              ly = wy - 28 * k;
            px.strokeStyle = "rgba(125,147,187,0.7)";
            px.lineWidth = 1.2 * k;
            px.beginPath();
            px.moveTo(wx + 2 * k, wy - 9 * k);
            px.lineTo(lx - 4 * k, ly + 3 * k);
            px.stroke();
            px.fillStyle = "#9fb4d8";
            px.font = "700 " + 9 * k + "px Orbitron, sans-serif";
            px.textAlign = "left";
            px.fillText("MAX30102", lx, ly);
            px.fillStyle = "#7d93bb";
            px.font = "600 " + 8 * k + "px Orbitron, sans-serif";
            px.fillText("WRIST SENSOR", lx, ly + 10 * k);
          }

        }

        // Head with floating hair and a face. The face is the outcome: wide
        // eyes and a tight mouth under stress, a smile when settled, eyes
        // closed and drifting off when fully calm.
        function drawHead(hx, hy, k, st, zz, mood) {
          mood = mood || "calm";
          const HAIR = "#3a2a22",
            SKIN = "#f1c7a3",
            SKIN_L = "#bf8f6a";
          // back of the hair, and a few strands floating up in microgravity
          px.fillStyle = HAIR;
          px.beginPath();
          px.ellipse(hx - 3 * k, hy - 2 * k, 16.5 * k, 16.5 * k, 0, 0, TAU);
          px.fill();
          px.beginPath(); // volume at the crown
          px.ellipse(hx - 1 * k, hy - 11 * k, 13 * k, 7 * k, -0.1, 0, TAU);
          px.fill();
          px.strokeStyle = HAIR;
          px.lineCap = "round";
          px.lineWidth = 2.4 * k;
          for (let i = 0; i < 3; i++) {
            const a0 = -2.2 + i * 0.4;
            const bx = hx - 3 * k + Math.cos(a0) * 13 * k,
              by = hy - 2 * k + Math.sin(a0) * 13 * k;
            const sw = Math.sin(tNow * 1.1 + i * 1.9) * 1.6 * k;
            px.beginPath();
            px.moveTo(bx, by);
            px.quadraticCurveTo(bx - 4 * k, by - 3 * k + sw, bx - 7 * k, by - 2 * k + sw);
            px.stroke();
          }
          // face
          px.fillStyle = SKIN;
          px.strokeStyle = SKIN_L;
          px.lineWidth = 1.2 * k;
          px.beginPath();
          px.ellipse(hx + 1 * k, hy + 1 * k, 14 * k, 15.5 * k, 0, 0, TAU);
          px.fill();
          px.beginPath();
          px.ellipse(hx + 1 * k, hy + 1 * k, 14 * k, 15.5 * k, 0, -0.9, 1.9);
          px.stroke();
          // nose
          px.beginPath();
          px.moveTo(hx + 14.5 * k, hy - 1 * k);
          px.quadraticCurveTo(hx + 18 * k, hy + 4 * k, hx + 14 * k, hy + 5 * k);
          px.fill();
          px.stroke();
          // hair over the top and back of the head
          px.save();
          px.beginPath();
          px.ellipse(hx + 1 * k, hy + 1 * k, 14.6 * k, 16 * k, 0, 0, TAU);
          px.clip();
          px.fillStyle = HAIR;
          px.beginPath();
          px.moveTo(hx - 20 * k, hy + 8 * k);
          px.lineTo(hx - 6 * k, hy + 6 * k);
          px.quadraticCurveTo(hx - 6 * k, hy - 7 * k, hx + 6 * k, hy - 8 * k);
          px.quadraticCurveTo(hx + 13 * k, hy - 9 * k, hx + 17 * k, hy - 5 * k);
          px.lineTo(hx + 17 * k, hy - 22 * k);
          px.lineTo(hx - 20 * k, hy - 22 * k);
          px.closePath();
          px.fill();
          px.restore();

          // cheeks: flushed after exercise, pale-pink when relaxed
          const blush =
            mood === "tired"
              ? rgba("#ff5470", 0.3 + st * 0.25)
              : st > 0.5
                ? rgba("#ff5470", 0.22 + st * 0.18)
                : rgba("#ff8fa6", 0.18 * (1 - st));
          px.fillStyle = blush;
          px.beginPath();
          px.ellipse(hx + 4 * k, hy + 6 * k, 2.8 * k, 1.9 * k, 0, 0, TAU);
          px.moveTo(hx + 14.6 * k, hy + 6 * k);
          px.ellipse(hx + 12 * k, hy + 6 * k, 2.6 * k, 1.9 * k, 0, 0, TAU);
          px.fill();

          // fringe falling over the forehead
          px.fillStyle = HAIR;
          px.beginPath();
          px.moveTo(hx + 2 * k, hy - 13 * k);
          px.quadraticCurveTo(hx + 12 * k, hy - 12 * k, hx + 15 * k, hy - 5 * k);
          px.quadraticCurveTo(hx + 9 * k, hy - 8 * k, hx + 4 * k, hy - 7 * k);
          px.closePath();
          px.fill();

          const F = S.face || { glance: 0, startle: 0, sigh: 0, yawn: 0 };
          const ink = "#2a2140";
          px.strokeStyle = ink;
          px.fillStyle = ink;
          px.lineCap = "round";
          px.lineWidth = 1.5 * k;
          const gx2 = F.glance * 1.1 * k; // eyes slide toward the bot
          const eyes = [hx + 4 * k + gx2, hx + 11.5 * k + gx2],
            ey = hy + 0.5 * k;
          const closed = F.yawn > 0.35 || F.sigh > 0.3;
          const blinking = (tNow * (0.25 + st * 0.5)) % 1 > 0.965;
          for (const ex of eyes) {
            if (zz > 0.35 || closed) {
              px.beginPath();
              px.arc(ex, ey - 1 * k, 2.2 * k, 0.15 * Math.PI, 0.85 * Math.PI);
              px.stroke();
            } else if (blinking) {
              px.beginPath();
              px.moveTo(ex - 2 * k, ey);
              px.lineTo(ex + 2 * k, ey);
              px.stroke();
            } else if (mood === "tired") {
              // heavy, half-closed lids
              px.beginPath();
              px.arc(ex, ey, 2.1 * k, 0, Math.PI);
              px.fill();
              px.beginPath();
              px.moveTo(ex - 2.6 * k, ey - 0.2 * k);
              px.lineTo(ex + 2.6 * k, ey - 0.2 * k);
              px.stroke();
            } else if (mood === "noise" && st >= 0.0 && S.sndDisp > S.snTh * 0.8) {
              // squinting at the racket
              px.beginPath();
              px.moveTo(ex - 2.4 * k, ey - 1.2 * k);
              px.lineTo(ex + 2.4 * k, ey + 0.6 * k);
              px.stroke();
            } else if ((mood === "panic" && st > 0.5) || F.startle > 0.3) {
              px.fillStyle = "#ffffff";
              px.beginPath();
              px.arc(ex, ey, 2.6 * k, 0, TAU);
              px.fill();
              px.stroke();
              px.fillStyle = ink;
              px.beginPath();
              px.arc(ex + 0.7 * k, ey, 1.1 * k, 0, TAU);
              px.fill();
            } else if (st < 0.25) {
              px.beginPath();
              px.arc(ex, ey + 1 * k, 2.2 * k, 1.15 * Math.PI, 1.85 * Math.PI);
              px.stroke();
            } else {
              px.beginPath();
              px.arc(ex, ey, 1.5 * k, 0, TAU);
              px.fill();
            }
          }
          if (mood === "noise" && S.sndDisp > S.snTh * 0.8) {
            // brows pulled down in irritation
            px.beginPath();
            px.moveTo(eyes[0] - 2.5 * k, ey - 4.5 * k);
            px.lineTo(eyes[0] + 2.2 * k, ey - 3 * k);
            px.moveTo(eyes[1] - 2.2 * k, ey - 3 * k);
            px.lineTo(eyes[1] + 2.5 * k, ey - 4.5 * k);
            px.stroke();
          } else if (F.startle > 0.3 || F.glance > 0.3) {
            const up = (F.startle * 2.4 + F.glance * 1.2) * k;
            px.beginPath();
            px.moveTo(eyes[0] - 2.5 * k, ey - 4.2 * k - up);
            px.quadraticCurveTo(eyes[0], ey - 5.6 * k - up, eyes[0] + 2.5 * k, ey - 4.2 * k - up);
            px.moveTo(eyes[1] - 2.5 * k, ey - 4.2 * k - up);
            px.quadraticCurveTo(eyes[1], ey - 5.6 * k - up, eyes[1] + 2.5 * k, ey - 4.2 * k - up);
            px.stroke();
          } else if (st <= 0.3 || mood === "tired") {
            // relaxed brows (droop a little when tired)
            px.lineWidth = 1.2 * k;
            const dr = mood === "tired" ? 0.8 * k : 0;
            px.beginPath();
            px.moveTo(eyes[0] - 2.4 * k, ey - 4.4 * k);
            px.lineTo(eyes[0] + 2.2 * k, ey - 4.6 * k + dr);
            px.moveTo(eyes[1] - 2.2 * k, ey - 4.6 * k + dr);
            px.lineTo(eyes[1] + 2.4 * k, ey - 4.4 * k);
            px.stroke();
            px.lineWidth = 1.5 * k;
          } else if (zz < 0.35) {
            const tilt = (st - 0.3) * 3.5 * k;
            px.beginPath();
            px.moveTo(eyes[0] - 2.5 * k, ey - 4 * k);
            px.lineTo(eyes[0] + 2 * k, ey - 4 * k - tilt);
            px.moveTo(eyes[1] - 2 * k, ey - 4 * k - tilt);
            px.lineTo(eyes[1] + 2.5 * k, ey - 4 * k);
            px.stroke();
          }
          const mx = hx + 8.5 * k,
            my = hy + 9 * k;
          px.beginPath();
          if (F.yawn > 0.15) {
            // big yawn
            px.ellipse(mx, my + 1 * k, 2.8 * k, (1.5 + 3 * F.yawn) * k, 0, 0, TAU);
            px.fill();
          } else if (F.sigh > 0.15) {
            // relieved "phew": small round exhale, with a soft puff of breath
            px.ellipse(mx + 1 * k, my, 1.6 * k, 1.9 * k, 0, 0, TAU);
            px.fill();
            px.strokeStyle = "rgba(200,230,255," + (0.5 * F.sigh).toFixed(3) + ")";
            px.lineWidth = 1.2 * k;
            for (let i = 0; i < 3; i++) {
              px.beginPath();
              px.arc(mx + (6 + i * 3) * k, my, (1.5 + i) * k, -0.9, 0.9);
              px.stroke();
            }
            px.strokeStyle = ink;
            px.lineWidth = 1.5 * k;
          } else if (mood === "tired" && st > 0.2) {
            // panting: mouth open, opening wider on each breath
            px.ellipse(mx, my, 2.4 * k, (1.4 + 1.4 * Math.abs(Math.sin(breathPh))) * k, 0, 0, TAU);
            px.fill();
          } else if (mood === "noise" && S.sndDisp > S.snTh * 0.8) {
            // gritted-teeth grimace
            px.fillStyle = "#ffffff";
            rr(px, mx - 4 * k, my - 1.6 * k, 8 * k, 3.2 * k, 1.2 * k);
            px.fill();
            px.lineWidth = 1 * k;
            px.stroke();
            px.beginPath();
            px.moveTo(mx - 4 * k, my);
            px.lineTo(mx + 4 * k, my);
            px.stroke();
            px.fillStyle = ink;
          } else if (mood === "panic" && st > 0.8) {
            px.ellipse(mx, my, 2 * k, 2.6 * k, 0, 0, TAU);
            px.fill();
          } else if (st > 0.5 && mood !== "tired") {
            px.moveTo(mx - 4 * k, my);
            for (let i = 1; i <= 6; i++)
              px.lineTo(mx - 4 * k + i * 1.35 * k, my + (i % 2 ? -1 : 1) * k);
            px.stroke();
          } else if (st > 0.25) {
            px.moveTo(mx - 3.5 * k, my);
            px.lineTo(mx + 3.5 * k, my);
            px.stroke();
          } else {
            px.arc(mx, my - 2.5 * k, 4 * k, 0.2 * Math.PI, 0.8 * Math.PI);
            px.stroke();
          }

          // sweat: pouring after exercise, some in a fright or nerves, none from noise
          const sweat =
            mood === "tired"
              ? clamp((st - 0.15) / 0.3, 0, 1)
              : mood === "noise"
                ? 0
                : clamp((st - 0.45) / 0.4, 0, 1);
          // In microgravity sweat does not run down: it beads on the skin and
          // little spheres slowly float away.
          if (sweat > 0) {
            px.fillStyle = "rgba(170,225,255,0.9)";
            [[6, -10], [11, -9], [15, -6]].forEach(([bx2, by2], i) => {
              px.globalAlpha = sweat * (0.6 + 0.4 * Math.sin(tNow * 2 + i));
              px.beginPath();
              px.arc(hx + bx2 * k, hy + by2 * k, 1.3 * k, 0, TAU);
              px.fill();
            });
            for (let i = 0; i < 4; i++) {
              const ph = (tNow * 0.22 + i * 0.25) % 1;
              const dx = hx + (12 + ph * 26 + i * 2) * k,
                dy = hy - (8 + ph * 20 + Math.sin(ph * 6 + i) * 3) * k;
              px.globalAlpha = (1 - ph) * sweat * 0.85;
              px.beginPath();
              px.arc(dx, dy, (1.1 + 0.5 * (i % 2)) * k, 0, TAU);
              px.fill();
              px.strokeStyle = "rgba(255,255,255,0.6)";
              px.lineWidth = 0.6 * k;
              px.stroke();
            }
            px.globalAlpha = 1;
          }

          if (zz > 0.05) {
            px.fillStyle = "#c4b5fd";
            px.textAlign = "center";
            for (let i = 0; i < 3; i++) {
              const ph = (tNow * 0.35 + i / 3) % 1;
              px.globalAlpha = Math.sin(ph * Math.PI) * zz;
              px.font = "800 " + (8 + ph * 6) * k + "px Orbitron, sans-serif";
              px.fillText("z", hx + (12 + ph * 20) * k, hy - (18 + ph * 30) * k);
            }
            px.globalAlpha = 1;
          }
        }

        function drawBot(bx, floorY, k, m) {
          const bob = Math.sin(tNow * 1.15) * 2.4 * k;
          const baseY = floorY - 8 * k;
          const bodyH = 104 * k,
            bodyW = 96 * k;
          const bodyY = baseY - 26 * k - bodyH + bob;

          // Hover glow under the chassis
          px.save();
          px.globalAlpha = 0.5;
          const hg = px.createRadialGradient(bx, baseY, 2, bx, baseY, 54 * k);
          hg.addColorStop(0, rgba(m.col, 0.55));
          hg.addColorStop(1, "rgba(0,0,0,0)");
          px.fillStyle = hg;
          px.beginPath();
          px.ellipse(bx, baseY, 54 * k, 13 * k, 0, 0, TAU);
          px.fill();
          px.restore();

          // Chassis
          px.fillStyle = "#26344f";
          rr(px, bx - 40 * k, baseY - 30 * k + bob, 80 * k, 22 * k, 9 * k);
          px.fill();

          // Body
          const bgd = px.createLinearGradient(0, bodyY, 0, bodyY + bodyH);
          bgd.addColorStop(0, "#3b4e73");
          bgd.addColorStop(1, "#1e2b45");
          px.fillStyle = bgd;
          rr(px, bx - bodyW / 2, bodyY, bodyW, bodyH, 24 * k);
          px.fill();
          px.strokeStyle = rgba(m.col, 0.55);
          px.lineWidth = 2 * k;
          rr(px, bx - bodyW / 2, bodyY, bodyW, bodyH, 24 * k);
          px.stroke();

          // Headphone cups + band — this bot is a DJ
          px.strokeStyle = "#4a5f88";
          px.lineWidth = 6 * k;
          px.beginPath();
          px.arc(bx, bodyY + 16 * k, 44 * k, Math.PI * 1.12, Math.PI * 1.88);
          px.stroke();
          px.fillStyle = "#33456a";
          rr(px, bx - 56 * k, bodyY + 10 * k, 16 * k, 30 * k, 7 * k);
          px.fill();
          rr(px, bx + 40 * k, bodyY + 10 * k, 16 * k, 30 * k, 7 * k);
          px.fill();

          // Face screen
          const fw = 66 * k,
            fh = 40 * k,
            fx2 = bx - fw / 2,
            fy2 = bodyY + 14 * k;
          px.fillStyle = "#080e1c";
          rr(px, fx2, fy2, fw, fh, 12 * k);
          px.fill();
          drawFace(fx2, fy2, fw, fh, k, m);

          // Warning when its decision keeps flipping between modes
          if (S.flapWarnAt > 0 && tNow - S.flapWarnAt < 6) {
            const age = tNow - S.flapWarnAt;
            const txt = "Switching modes too often";
            const sub = "threshold too close to the reading";
            px.save();
            px.globalAlpha = clamp(Math.min(age / 0.25, (6 - age) / 0.5), 0, 1);
            px.font = "800 " + 10.5 * k + "px Orbitron, sans-serif";
            const tw = Math.max(px.measureText(txt).width, 150 * k) + 20 * k;
            const bw2 = tw,
              bh2 = 36 * k;
            const qx = clamp(bx - bw2 / 2, 8, W - bw2 - 8),
              qy = bodyY - 62 * k + Math.sin(tNow * 4) * 2 * k;
            px.fillStyle = "rgba(40,24,6,0.92)";
            px.strokeStyle = "#ffd166";
            px.lineWidth = 1.6 * k;
            rr(px, qx, qy, bw2, bh2, 8 * k);
            px.fill();
            px.stroke();
            px.beginPath();
            px.moveTo(bx - 7 * k, qy + bh2);
            px.lineTo(bx, qy + bh2 + 8 * k);
            px.lineTo(bx + 7 * k, qy + bh2);
            px.closePath();
            px.fillStyle = "rgba(40,24,6,0.92)";
            px.fill();
            px.textAlign = "center";
            px.textBaseline = "alphabetic";
            px.fillStyle = "#ffd166";
            px.fillText("⚠ " + txt, qx + bw2 / 2, qy + 15 * k);
            px.fillStyle = "rgba(255,230,180,0.85)";
            px.font = "600 " + 9.5 * k + "px Rajdhani, sans-serif";
            px.fillText(sub, qx + bw2 / 2, qy + 28 * k);
            px.restore();
          }

          // Sound sensor microphone on top
          const mx = bx + 24 * k,
            my = bodyY - 2 * k;
          px.strokeStyle = "#4a5f88";
          px.lineWidth = 3 * k;
          px.beginPath();
          px.moveTo(mx, bodyY + 6 * k);
          px.lineTo(mx, my - 8 * k);
          px.stroke();
          px.fillStyle = "#2b3a58";
          px.beginPath();
          px.arc(mx, my - 12 * k, 8 * k, 0, TAU);
          px.fill();
          const lvl = clamp(S.sndDisp / 1023, 0, 1);
          px.strokeStyle =
            S.sndDisp > S.snTh
              ? "#ff5470"
              : "rgba(245,158,11," + (0.35 + lvl) + ")";
          px.lineWidth = 2.5 * k;
          px.beginPath();
          px.arc(mx, my - 12 * k, (10 + lvl * 8) * k, 0, TAU);
          px.stroke();

          // Speaker grille — the cone rides the real audio level
          const spx = bx - 4 * k,
            spy = bodyY + bodyH - 32 * k;
          px.fillStyle = "#101a2e";
          px.beginPath();
          px.arc(spx, spy, 24 * k, 0, TAU);
          px.fill();
          px.strokeStyle = "#3d5178";
          px.lineWidth = 1.5 * k;
          for (let r = 7; r <= 21; r += 7) {
            px.beginPath();
            px.arc(spx, spy, r * k, 0, TAU);
            px.stroke();
          }
          px.save();
          px.shadowColor = rgba(m.col, 0.85);
          px.shadowBlur = (6 + spkLevel * 20) * k;
          px.fillStyle = m.col;
          px.beginPath();
          px.arc(spx, spy, (7 + spkLevel * 6) * k, 0, TAU);
          px.fill();
          px.restore();

          px.fillStyle = "#7d93bb";
          px.font = "700 " + 9 * k + "px Orbitron, sans-serif";
          px.textAlign = "center";
          px.fillText("DFPLAYER + SPEAKER", bx, baseY + 4 * k);
        }

        function drawFace(x, y, w, h, k, m) {
          const cxf = x + w / 2,
            cyf = y + h / 2;
          const ex = 14 * k;
          px.strokeStyle = m.col;
          px.fillStyle = m.col;
          px.lineWidth = 3 * k;
          px.lineCap = "round";
          const key = playingMode();
          const blink = Math.sin(tNow * 0.9) > 0.985 ? 0.12 : 1;

          if (key === "relax" || key === "deep") {
            // Eyes closed
            for (const s of [-1, 1]) {
              px.beginPath();
              px.arc(
                cxf + s * ex,
                cyf - 3 * k,
                6 * k,
                Math.PI * 0.15,
                Math.PI * 0.85,
              );
              px.stroke();
            }
          } else if (key === "recovery") {
            // Happy arcs
            for (const s of [-1, 1]) {
              px.beginPath();
              px.arc(
                cxf + s * ex,
                cyf + 1 * k,
                6 * k,
                Math.PI * 1.15,
                Math.PI * 1.85,
              );
              px.stroke();
            }
          } else {
            for (const s of [-1, 1]) {
              px.beginPath();
              px.ellipse(
                cxf + s * ex,
                cyf - 3 * k,
                4.5 * k,
                5.5 * k * blink,
                0,
                0,
                TAU,
              );
              px.fill();
            }
          }
          // Mouth
          px.beginPath();
          if (key === "focus")
            px.arc(cxf, cyf + 6 * k, 8 * k, Math.PI * 0.08, Math.PI * 0.92);
          else if (key === "deep") px.arc(cxf, cyf + 9 * k, 3.2 * k, 0, TAU);
          else px.arc(cxf, cyf + 4 * k, 9 * k, Math.PI * 0.12, Math.PI * 0.88);
          px.stroke();
        }

        function drawSoundSource(k, floorY) {
          const sxp = W * 0.93,
            syp = H * 0.2;
          const lvl = clamp(S.sndDisp / 1023, 0, 1);
          const loud = S.sndDisp > S.snTh;
          px.fillStyle = "#1a2540";
          rr(px, sxp - 26 * k, syp - 20 * k, 46 * k, 40 * k, 8 * k);
          px.fill();
          px.strokeStyle = loud ? "#ff5470" : "#3a4d72";
          px.lineWidth = 2 * k;
          rr(px, sxp - 26 * k, syp - 20 * k, 46 * k, 40 * k, 8 * k);
          px.stroke();
          px.strokeStyle = "rgba(150,180,230,0.3)";
          px.lineWidth = 1.4 * k;
          for (let i = 0; i < 4; i++) {
            px.beginPath();
            px.moveTo(sxp - 20 * k, syp - 12 * k + i * 8 * k);
            px.lineTo(sxp + 14 * k, syp - 12 * k + i * 8 * k);
            px.stroke();
          }
          px.save();
          px.shadowColor = loud
            ? "rgba(255,84,112,0.9)"
            : "rgba(245,158,11,0.7)";
          px.shadowBlur = (4 + lvl * 16) * k;
          px.fillStyle = loud ? "#ff5470" : "#f59e0b";
          px.beginPath();
          px.arc(sxp - 6 * k, syp + 26 * k, (3 + lvl * 3) * k, 0, TAU);
          px.fill();
          px.restore();
          px.fillStyle = "#7d93bb";
          px.font = "700 " + 8.5 * k + "px Orbitron, sans-serif";
          px.textAlign = "center";
          px.fillText(
            SOUNDS[S.sndType].name.toUpperCase(),
            sxp - 4 * k,
            syp + 42 * k,
          );

          // Noise rolling toward the bot's microphone
          const col = loud ? "#ff5470" : "#f59e0b";
          for (let i = 0; i < 4; i++) {
            const ph = (tNow * 0.85 + i * 0.25) % 1;
            const r = (18 + ph * 92) * k;
            px.globalAlpha = (1 - ph) * lvl * 0.75;
            px.strokeStyle = col;
            px.lineWidth = 2.4 * k;
            px.beginPath();
            px.arc(sxp - 6 * k, syp + 4 * k, r, Math.PI * 0.55, Math.PI * 1.35);
            px.stroke();
          }
          px.globalAlpha = 1;
        }

        function drawMusicWaves(m, bx, floorY, k, crewX) {
          if (spkLevel < 0.02) return;
          const ox = bx - 4 * k,
            oy = floorY - 8 * k - 26 * k - 104 * k + 72 * k;
          const reach = Math.abs(ox - crewX) * 1.05;
          for (let i = 0; i < 5; i++) {
            const ph = (tNow * (m.tempo / 60) * 0.5 + i * 0.2) % 1;
            const r = 26 * k + ph * reach;
            px.globalAlpha = (1 - ph) * clamp(spkLevel * 1.4, 0, 1) * 0.7;
            px.strokeStyle = m.col;
            px.lineWidth = (3.2 - ph * 1.6) * k;
            px.beginPath();
            px.arc(ox, oy, r, Math.PI * 0.62, Math.PI * 1.38);
            px.stroke();
          }
          px.globalAlpha = 1;
        }

        /* =================== GRAPHS =================== */
        function gridBg(c, w, h) {
          c.clearRect(0, 0, w, h);
          c.fillStyle = "#080e1c";
          c.fillRect(0, 0, w, h);
          c.strokeStyle = "rgba(120,150,210,0.09)";
          c.lineWidth = 1;
          for (let i = 1; i < 8; i++) {
            const x = (w / 8) * i;
            c.beginPath();
            c.moveTo(x, 0);
            c.lineTo(x, h);
            c.stroke();
          }
          for (let i = 1; i < 4; i++) {
            const y = (h / 4) * i;
            c.beginPath();
            c.moveTo(0, y);
            c.lineTo(w, y);
            c.stroke();
          }
        }

        function drawPPG() {
          const [w, h] = D.ppg;
          gridBg(gx, w, h);
          const n = ppgBuf.length;
          // Trace
          gx.strokeStyle = "#ff4d6d";
          gx.lineWidth = 2.2;
          gx.lineJoin = "round";
          gx.beginPath();
          for (let i = 0; i < n; i++) {
            const x = (i / (n - 1)) * w;
            const y = h - 14 - clamp(ppgBuf[i], -0.4, 1.5) * (h - 30) * 0.66;
            i ? gx.lineTo(x, y) : gx.moveTo(x, y);
          }
          gx.stroke();
          // Beat markers
          gx.fillStyle = "rgba(255,168,184,0.9)";
          for (let i = 0; i < n; i++) {
            if (!beatMarks[i]) continue;
            const x = (i / (n - 1)) * w;
            gx.fillRect(x - 1, 4, 2, 12);
          }
          gx.fillStyle = "#ffa8b8";
          gx.font = "700 15px Orbitron, sans-serif";
          gx.textAlign = "right";
          gx.fillText(Math.round(S.bpmDisp) + " BPM", w - 8, 20);
          gx.fillStyle = "#64789e";
          gx.font = "600 11px Rajdhani, sans-serif";
          gx.textAlign = "left";
          gx.fillText("IR reflectance · beat = systolic peak", 8, h - 6);
        }

        function drawTrend() {
          const [w, h] = D.trend;
          // The scale zooms to the heart-rate data, so a swing of a few BPM is
          // visible instead of a flat line. The threshold is drawn at the edge
          // with an arrow when it is off the scale.
          let dLo = Infinity,
            dHi = -Infinity;
          for (const p of trendBuf) {
            if (p.bpm < dLo) dLo = p.bpm;
            if (p.bpm > dHi) dHi = p.bpm;
          }
          if (!isFinite(dLo)) {
            dLo = S.bpmDisp;
            dHi = S.bpmDisp;
          }
          // pull the threshold in only when it is close to the data
          if (S.hrTh > dHi && S.hrTh - dHi < 12) dHi = S.hrTh;
          if (S.hrTh < dLo && dLo - S.hrTh < 12) dLo = S.hrTh;
          let tLo = dLo - 5,
            tHi = dHi + 5;
          if (tHi - tLo < 24) {
            const mid = (tHi + tLo) / 2;
            tLo = mid - 12;
            tHi = mid + 12;
          }
          S.trLo = S.trLo === undefined ? tLo : approach(S.trLo, tLo, 0.6, 1 / 60);
          S.trHi = S.trHi === undefined ? tHi : approach(S.trHi, tHi, 0.6, 1 / 60);
          const LO = S.trLo,
            HI = S.trHi;
          const yOf = (b) =>
            h - 10 - ((clamp(b, LO, HI) - LO) / (HI - LO)) * (h - 20);
          tx.clearRect(0, 0, w, h);
          tx.fillStyle = "#080e1c";
          tx.fillRect(0, 0, w, h);

          // Zone bands are defined *by the threshold*, so moving the slider
          // visibly redraws what counts as normal.
          const yTh = yOf(S.hrTh),
            yEl = yOf(S.hrTh - 15);
          tx.fillStyle = "rgba(34,197,94,0.13)";
          tx.fillRect(0, yEl, w, h - yEl);
          tx.fillStyle = "rgba(247,162,59,0.15)";
          tx.fillRect(0, yTh, w, yEl - yTh);
          tx.fillStyle = "rgba(255,84,112,0.16)";
          tx.fillRect(0, 0, w, yTh);

          tx.strokeStyle = "rgba(120,150,210,0.1)";
          tx.lineWidth = 1;
          for (let i = 1; i < 6; i++) {
            const x = (w / 6) * i;
            tx.beginPath();
            tx.moveTo(x, 0);
            tx.lineTo(x, h);
            tx.stroke();
          }

          // Threshold marker
          tx.strokeStyle = "#ff8fa6";
          tx.lineWidth = 1.8;
          tx.setLineDash([7, 5]);
          tx.beginPath();
          tx.moveTo(0, yTh);
          tx.lineTo(w, yTh);
          tx.stroke();
          tx.setLineDash([]);
          tx.fillStyle = "#ff8fa6";
          tx.font = "700 11px Orbitron, sans-serif";
          tx.textAlign = "left";
          const thOff = S.hrTh > HI ? "↑" : S.hrTh < LO ? "↓" : "";
          tx.fillText("THRESHOLD " + S.hrTh + (thOff ? " " + thOff : ""), 8, thOff === "↓" ? h - 16 : thOff ? 14 : yTh - 5);
          // scale labels down the right edge
          tx.font = "600 10px Consolas, monospace";
          tx.textAlign = "right";
          tx.fillStyle = "rgba(160,180,230,0.7)";
          const stepB = HI - LO > 70 ? 20 : 10;
          for (let b = Math.ceil(LO / stepB) * stepB; b <= HI; b += stepB) {
            const yy = yOf(b);
            if (yy < 12 || yy > h - 22 || Math.abs(yy - yTh) < 9) continue;
            tx.fillText(b, w - 6, yy + 3);
          }

          // Trend line
          if (trendBuf.length > 1) {
            const t0 = tNow - 30;
            tx.strokeStyle = "#ffd166";
            tx.lineWidth = 2.4;
            tx.lineJoin = "round";
            tx.beginPath();
            trendBuf.forEach((p, i) => {
              const x = clamp((p.t - t0) / 30, 0, 1) * w;
              const y = yOf(p.bpm);
              i ? tx.lineTo(x, y) : tx.moveTo(x, y);
            });
            tx.stroke();
            const last = trendBuf[trendBuf.length - 1];
            tx.fillStyle = "#ffd166";
            tx.beginPath();
            tx.arc(
              clamp((last.t - t0) / 30, 0, 1) * w,
              yOf(last.bpm),
              3.6,
              0,
              TAU,
            );
            tx.fill();
          }
          // Mode-change flags: music switched here → watch the line respond
          {
            const t0 = tNow - 30;
            tx.font = "700 10px Orbitron, sans-serif";
            tx.textAlign = "center";
            tx.textBaseline = "top";
            for (const mk of modeMarks) {
              if (mk.t < t0) continue;
              const x = clamp((mk.t - t0) / 30, 0, 1) * w;
              const col = MODES[mk.k].col;
              tx.strokeStyle = rgba(col, 0.75);
              tx.lineWidth = 1.5;
              tx.setLineDash([3, 3]);
              tx.beginPath();
              tx.moveTo(x, 20);
              tx.lineTo(x, h);
              tx.stroke();
              tx.setLineDash([]);
              const lab = MODES[mk.k].chip;
              const lw = tx.measureText(lab).width + 10;
              const lx = clamp(x, lw / 2 + 2, w - lw / 2 - 2);
              tx.fillStyle = col;
              rr(tx, lx - lw / 2, 4, lw, 15, 5);
              tx.fill();
              tx.fillStyle = "#0b1030";
              tx.fillText(lab, lx, 6.5);
            }
            tx.textBaseline = "alphabetic";
          }
          tx.fillStyle = "#64789e";
          tx.font = "600 11px Rajdhani, sans-serif";
          tx.textAlign = "right";
          tx.fillText("last 30 s", w - 8, h - 6);
        }

        function drawSpeaker() {
          const m = MODES[playingMode()];
          // Cone
          const [cw, ch] = D.cone;
          cx2.clearRect(0, 0, cw, ch);
          cx2.fillStyle = "#0d1526";
          cx2.fillRect(0, 0, cw, ch);
          const c0 = cw / 2,
            c1 = ch / 2;
          for (let i = 3; i >= 1; i--) {
            const r = 22 + i * 14 + spkLevel * 8;
            cx2.globalAlpha = 0.13 + spkLevel * 0.25;
            cx2.strokeStyle = m.col;
            cx2.lineWidth = 2.4;
            cx2.beginPath();
            cx2.arc(c0, c1, r, 0, TAU);
            cx2.stroke();
          }
          cx2.globalAlpha = 1;
          cx2.fillStyle = "#16233d";
          cx2.beginPath();
          cx2.arc(c0, c1, 34, 0, TAU);
          cx2.fill();
          cx2.strokeStyle = "#2b3a58";
          cx2.lineWidth = 2;
          cx2.beginPath();
          cx2.arc(c0, c1, 34, 0, TAU);
          cx2.stroke();
          cx2.save();
          cx2.shadowColor = rgba(m.col, 0.9);
          cx2.shadowBlur = 8 + spkLevel * 26;
          cx2.fillStyle = m.col;
          cx2.beginPath();
          cx2.arc(c0, c1, 12 + spkLevel * 11, 0, TAU);
          cx2.fill();
          cx2.restore();

          // Waveform
          const [ww, wh] = D.swave;
          wx.clearRect(0, 0, ww, wh);
          wx.fillStyle = "#0d1526";
          wx.fillRect(0, 0, ww, wh);
          wx.strokeStyle = "rgba(120,150,210,0.16)";
          wx.lineWidth = 1;
          wx.beginPath();
          wx.moveTo(0, wh / 2);
          wx.lineTo(ww, wh / 2);
          wx.stroke();
          wx.strokeStyle = m.col;
          wx.lineWidth = 2;
          wx.lineJoin = "round";
          wx.beginPath();
          for (let i = 0; i < 256; i++) {
            const x = (i / 255) * ww;
            const y = wh / 2 - waveArr[i] * (wh / 2 - 4);
            i ? wx.lineTo(x, y) : wx.moveTo(x, y);
          }
          wx.stroke();
        }

        /* =================== CONTROL WIRING =================== */
        function setRange(id, val, fmt, vid) {
          const el = $(id);
          el.value = val;
          rangeFill(el);
          if (vid) $(vid).textContent = fmt(val);
        }
        function pickSeg(boxId, attr, val) {
          [...$(boxId).children].forEach((b) =>
            b.classList.toggle("on", b.dataset[attr] === val),
          );
        }
        function bindGroup(id, attr, onPick) {
          const box = $(id);
          box.addEventListener("click", (e) => {
            const b = e.target.closest("button");
            if (!b || !box.contains(b)) return;
            unlockAudio();
            [...box.children].forEach((c) => c.classList.remove("on"));
            b.classList.add("on");
            onPick(b.dataset[attr]);
          });
        }
        function bindRange(id, vid, fmt, onSet) {
          const el = $(id);
          el.addEventListener("input", () => {
            rangeFill(el);
            const v = +el.value;
            $(vid).textContent = fmt(v);
            onSet(v);
          });
        }

        function applyScenario(key) {
          const s = SCENARIOS[key];
          S.scKey = key;
          if (run) run.scenarios.add(key);
          $("scHint").textContent = s.hint;
          S.bpmTarget = s.bpm;
          setRange("r_bpm", s.bpm, (v) => v + " BPM", "v_bpm");
          S.amb = s.amb;
          S.sndType = s.snd;
          S.decayTo = s.decayTo === undefined ? null : s.decayTo;
          S.decayRate = s.decayRate || 0;
          // A scenario loads a situation, so the body is already there — the
          // sensor's averaged reading still has to catch up on its own.
          S.bpmActual = s.bpm;
        }

        bindGroup("segScenario", "sc", (k) => applyScenario(k));
        bindGroup("tgBio", "bio", (v) => {
          S.bio = v === "on";
          log(
            S.bio
              ? "Biofeedback on — music now affects the crew member."
              : "Biofeedback off — heart rate ignores the music.",
            "mus",
          );
        });
        bindGroup("tgSrc", "src", (v) => {
          S.src = v;
          $("manualWrap").style.display = v === "manual" ? "" : "none";
          retuneAudio(playingMode());
          log(
            v === "manual"
              ? "Manual preview — bot decision overridden."
              : "Bot decision restored.",
            "mus",
          );
        });
        bindGroup("segManual", "mode", (v) => {
          S.manualMode = v;
          retuneAudio(v);
        });

        bindRange(
          "r_bpm",
          "v_bpm",
          (v) => v + " BPM",
          (v) => {
            S.bpmTarget = v;
            S.decayTo = null; // taking the slider cancels a scripted cool-down
          },
        );
        bindRange(
          "r_hrth",
          "v_hrth",
          (v) => v + " BPM",
          (v) => (S.hrTh = v),
        );
        bindRange(
          "r_avg",
          "v_avg",
          (v) => v + (v === 1 ? " sample" : " samples"),
          (v) => (S.avgN = v),
        );
        bindGroup("tgAudio", "aud", (v) => {
          S.audioOn = v === "on";
        });

        bindRange(
          "r_vol",
          "v_vol",
          (v) => v + " / 30",
          (v) => {
            S.vol = v;
            S.volFrameUntil = tNow + 1.8;
          },
        );

        // Stopped or paused: the sim clock, heart model, music and animation
        // all hold still.
        function frozen() {
          return !S.running || S.paused;
        }
        function setRunning(on) {
          if (on && !S.running) beginRun();
          else if (!on && S.running) endRun();
          S.running = on;
          const b = $("btnRun");
          b.classList.toggle("on", on);
          b.textContent = on ? "■ Stop Simulation" : "▶ Start Simulation";
          // Pause only makes sense while the simulation is running.
          S.paused = false;
          $("btnPause").disabled = !on;
          $("btnPause").classList.remove("on");
          $("btnPause").textContent = "Pause";
          log(
            on ? "Simulation started." : "Simulation stopped.",
            on ? "ok" : "warn",
          );
          syncOverlay();
        }
        $("btnRun").addEventListener("click", () => {
          unlockAudio();
          setRunning(!S.running);
        });
        $("ovGo").addEventListener("click", () => {
          unlockAudio();
          closeReport();
          setRunning(true);
        });
        $("ovReport").addEventListener("click", () => openReport());
        $("rpClose").addEventListener("click", closeReport);
        $("rpNext").addEventListener("click", () => {
          unlockAudio();
          closeReport();
          setRunning(true);
        });
        $("rpBack").addEventListener("click", (e) => {
          if (e.target === e.currentTarget) closeReport();
        });
        document.addEventListener("keydown", (e) => {
          if (e.key === "Escape") closeReport();
        });

        /* =================== RUN REPORT =================== */
        const scName = (key) => {
          const b = document.querySelector('[data-sc="' + key + '"]');
          return b ? b.textContent.trim() : key;
        };
        function settingsNow() {
          return { sc: S.scKey, hrTh: S.hrTh, avgN: S.avgN, bio: S.bio };
        }
        function beginRun() {
          run = {
            t0: tNow,
            scenarios: new Set([S.scKey]),
            set0: settingsNow(),
            bpm0: S.bpmDisp,
            calm0: S.calmness,
            peak: S.bpmDisp,
            lastLow: S.calmness < 70 ? 0 : null, // last time calm was below 70%
            changes: 0,
            flaps: 0,
            samples: [],
            sClock: 1,
          };
        }
        function trackRun(dt) {
          run.peak = Math.max(run.peak, S.bpmDisp);
          if (S.calmness < 70) run.lastLow = tNow - run.t0;
          run.sClock += dt;
          if (run.sClock >= 0.25) {
            run.sClock = 0;
            run.samples.push({ t: tNow - run.t0, b: S.bpmDisp, m: S.mode });
            if (run.samples.length > 2400)
              run.samples = run.samples.filter((_, i) => i % 2 === 0);
          }
        }
        function endRun() {
          const r = run;
          run = null;
          if (!r) return;
          const dur = tNow - r.t0;
          if (dur < 0.5) return; // a stray double-click is not a run
          const set1 = settingsNow();
          const calm1 = S.calmness;
          let stars = 1;
          if (calm1 >= 75 && r.flaps === 0 && r.changes <= 4) stars = 3;
          else if (calm1 >= 55 && r.flaps <= 1) stars = 2;
          runCount++;
          runs.unshift({
            n: runCount,
            dur,
            sc: [...r.scenarios],
            set: set1,
            midChange:
              r.set0.hrTh !== set1.hrTh ||
              r.set0.avgN !== set1.avgN ||
              r.set0.bio !== set1.bio ||
              r.scenarios.size > 1,
            bpm0: r.bpm0,
            bpm1: S.bpmDisp,
            peak: r.peak,
            calm0: r.calm0,
            calm1,
            calmOk: calm1 >= 70,
            calmAt: r.lastLow, // null = never dropped below 70%
            changes: r.changes,
            flaps: r.flaps,
            samples: r.samples,
            stars,
          });
          if (runs.length > 5) runs.pop();
          $("ovReport").hidden = false;
          openReport();
        }

        const fmtT = (sec) => {
          const m = Math.floor(sec / 60),
            s2 = Math.round(sec % 60);
          return m ? m + "m " + String(s2).padStart(2, "0") + "s" : s2 + " s";
        };
        const starStr = (n) =>
          [1, 2, 3].map((i) => '<span class="' + (i <= n ? "on" : "off") + '">★</span>').join("");

        function openReport() {
          const r = runs[0];
          if (!r) return;
          const prev = runs[1];
          $("rpTitle").textContent = "RUN " + r.n + " REPORT";
          $("rpSit").textContent =
            r.sc.map(scName).join(" → ") +
            " · threshold " + r.set.hrTh + " BPM · averaging " + r.set.avgN +
            " · biofeedback " + (r.set.bio ? "on" : "off");
          $("rpStars").innerHTML = starStr(r.stars);
          $("rpVerdict").textContent =
            r.stars === 3
              ? "Mission success: the crew settled smoothly."
              : r.stars === 2
                ? "Crew stabilising, with room to improve."
                : r.flaps > 1
                  ? "The music kept flipping, so the crew couldn't settle."
                  : "The crew is still stressed at the end of the run.";

          const dB = r.bpm1 - r.bpm0,
            dC = r.calm1 - r.calm0;
          const arrow = (d, goodDown) => {
            if (Math.abs(d) < 1) return '<small>(no change)</small>';
            const good = goodDown ? d < 0 : d > 0;
            return '<small class="' + (good ? "dn" : "up") + '">' + (d < 0 ? "▼" : "▲") + " " + Math.abs(Math.round(d)) + "</small>";
          };
          const tiles = [
            ["Run time", fmtT(r.dur)],
            ["Heart rate", Math.round(r.bpm0) + " → " + Math.round(r.bpm1) + " " + arrow(dB, true)],
            ["Crew calm", Math.round(r.calm0) + "% → " + Math.round(r.calm1) + "% " + arrow(dC, false)],
            [
              "Time to calm",
              !r.calmOk
                ? '<span class="bad">Not reached</span>'
                : r.calmAt === null
                  ? '<span class="good">Stayed calm</span>'
                  : fmtT(r.calmAt),
            ],
            ["Peak heart rate", Math.round(r.peak) + " BPM"],
            ["Mode changes", '<span class="' + (r.changes > 4 ? "bad" : "") + '">' + r.changes + "</span>"],
            ["Flapping warnings", '<span class="' + (r.flaps ? "bad" : "good") + '">' + r.flaps + "</span>"],
          ];
          $("rpTiles").innerHTML = tiles
            .map((t) => '<div class="rp-tile"><div class="k">' + t[0] + '</div><div class="v">' + t[1] + "</div></div>")
            .join("");

          // Tip: the most likely reason for the result
          let tip;
          if (r.flaps > 0)
            tip = "Tip: a reading kept crossing a threshold, so the decision flipped back and forth. Move the Heart Rate Threshold further from the heart rate, and remember a loud, bursty room (like the alarm) can cause it too.";
          else if (!r.set.bio)
            tip = "Tip: Biofeedback was off, so the music could not lower the heart rate. Turn it on and compare.";
          else if (r.calm1 < 55 && r.dur < 40)
            tip = "Tip: calming takes time. Let the next run go a little longer before you stop it.";
          else if (r.set.avgN <= 2 && r.changes > 3)
            tip = "Tip: with very little Sensor Averaging the reading is jumpy. Try more samples.";
          else if (r.set.avgN >= 13)
            tip = "Tip: heavy averaging is smooth but slow to react. Try fewer samples and see whether the bot responds sooner.";
          else if (r.stars === 3)
            tip = "Great run. Try a harder situation, such as Equipment Alarm, with the same settings.";
          else tip = "Tip: try a different Heart Rate Threshold and compare the two runs.";
          $("rpTip").textContent = tip;

          // Fair test check against the run before
          const fair = $("rpFair");
          if (!prev) {
            fair.className = "rp-note";
            fair.textContent = "This is your first run. Change one setting and run again to compare.";
          } else {
            const diffs = [];
            if (prev.sc.join() !== r.sc.join()) diffs.push("Crew Situation");
            if (prev.set.hrTh !== r.set.hrTh) diffs.push("Heart Rate Threshold");
            if (prev.set.avgN !== r.set.avgN) diffs.push("Sensor Averaging");
            if (prev.set.bio !== r.set.bio) diffs.push("Biofeedback");
            if (r.midChange) {
              fair.className = "rp-note unfair";
              fair.textContent = "Settings changed during this run, so the result mixes two set-ups. Change settings while stopped for a fair test.";
            } else if (diffs.length === 0) {
              fair.className = "rp-note fair";
              fair.textContent = "Same settings as run " + prev.n + ". Repeating a test checks your result is reliable.";
            } else if (diffs.length === 1) {
              fair.className = "rp-note fair";
              fair.textContent = "Fair test: you changed only the " + diffs[0] + " since run " + prev.n + ", so any difference came from it.";
            } else {
              fair.className = "rp-note unfair";
              fair.textContent = "You changed " + diffs.length + " settings since run " + prev.n + " (" + diffs.join(", ") + "). Change just one next time to know which one mattered.";
            }
          }

          // Comparison table
          $("rpCompare").style.display = runs.length > 1 ? "" : "none";
          $("rpRows").innerHTML = runs
            .map((x, i) => {
              const o = runs[i + 1];
              const c = (diff) => (o && diff ? ' class="chg"' : "");
              return (
                '<tr class="' + (i === 0 ? "cur" : "") + '">' +
                "<td>" + x.n + "</td>" +
                "<td" + c(o && o.sc.join() !== x.sc.join()) + ">" + x.sc.map(scName).join(" → ") + "</td>" +
                "<td" + c(o && o.set.hrTh !== x.set.hrTh) + ">" + x.set.hrTh + " BPM</td>" +
                "<td" + c(o && o.set.avgN !== x.set.avgN) + ">" + x.set.avgN + "</td>" +
                "<td" + c(o && o.set.bio !== x.set.bio) + ">" + (x.set.bio ? "On" : "Off") + "</td>" +
                "<td>" + fmtT(x.dur) + "</td>" +
                "<td>" + Math.round(x.bpm0) + " → " + Math.round(x.bpm1) + "</td>" +
                "<td>" + Math.round(x.calm1) + "%</td>" +
                "<td>" + x.changes + "</td>" +
                '<td><span class="st">' + "★".repeat(x.stars) + "</span></td>" +
                "</tr>"
              );
            })
            .join("");

          $("rpBack").classList.add("show");
          drawReportChart(r);
          $("rpNext").focus();
        }
        function closeReport() {
          $("rpBack").classList.remove("show");
        }

        function drawReportChart(r) {
          const cv = $("rpChart");
          const box = cv.getBoundingClientRect();
          const w = box.width || 700,
            h = box.height || 130;
          const kk = dpr();
          cv.width = Math.round(w * kk);
          cv.height = Math.round(h * kk);
          const c = cv.getContext("2d");
          c.setTransform(kk, 0, 0, kk, 0, 0);
          c.clearRect(0, 0, w, h);
          const sm = r.samples;
          if (sm.length < 2) return;
          const T = Math.max(sm[sm.length - 1].t, 1);
          let lo = Math.min(r.set.hrTh, ...sm.map((p) => p.b)) - 8,
            hi = Math.max(r.set.hrTh, ...sm.map((p) => p.b)) + 8;
          const xOf = (t) => (t / T) * w,
            yOf = (b) => h - 14 - ((b - lo) / (hi - lo)) * (h - 22);
          // Mode bands
          const used = new Set();
          let s0 = 0;
          for (let i = 1; i <= sm.length; i++) {
            if (i === sm.length || sm[i].m !== sm[s0].m) {
              const col = MODES[sm[s0].m].col;
              used.add(sm[s0].m);
              c.fillStyle = rgba(col, 0.22);
              const x0 = xOf(sm[s0].t),
                x1 = i === sm.length ? w : xOf(sm[i].t);
              c.fillRect(x0, 0, x1 - x0, h - 12);
              s0 = i;
            }
          }
          // Threshold
          c.strokeStyle = "#ff8fa6";
          c.setLineDash([6, 4]);
          c.lineWidth = 1.5;
          c.beginPath();
          c.moveTo(0, yOf(r.set.hrTh));
          c.lineTo(w, yOf(r.set.hrTh));
          c.stroke();
          c.setLineDash([]);
          c.fillStyle = "#ff8fa6";
          c.font = "700 10px Orbitron, sans-serif";
          c.textAlign = "left";
          c.fillText("THRESHOLD " + r.set.hrTh, 6, yOf(r.set.hrTh) - 4);
          // BPM line
          c.strokeStyle = "#ffd166";
          c.lineWidth = 2.4;
          c.lineJoin = "round";
          c.beginPath();
          sm.forEach((p, i) => (i ? c.lineTo(xOf(p.t), yOf(p.b)) : c.moveTo(xOf(p.t), yOf(p.b))));
          c.stroke();
          // Time axis
          c.fillStyle = "#7d93bb";
          c.font = "600 11px Rajdhani, sans-serif";
          c.textAlign = "left";
          c.fillText("0 s", 2, h - 1);
          c.textAlign = "right";
          c.fillText(fmtT(T), w - 2, h - 1);
          $("rpLegend").innerHTML =
            '<span><i style="background:#ffd166"></i>Heart rate (BPM)</span>' +
            [...used].map((k) => '<span><i style="background:' + MODES[k].col + '"></i>' + MODES[k].name + "</span>").join("");
        }

        function syncOverlay() {
          const ov = $("startOv");
          ov.classList.toggle("show", !S.running);
          if (!S.running) {
            const first = runCount === 0;
            $("ovTitle").textContent = first ? "CREW POD STANDING BY" : "SIMULATION STOPPED";
            $("ovText").textContent = first
              ? "Pick a Crew Situation, then start the simulation to watch the bot read the crew and choose the music."
              : "Change one setting, then start the next run and compare the reports.";
            $("ovGo").textContent = first ? "▶ START SIMULATION" : "▶ START NEXT RUN";
          }
        }

        $("btnPause").addEventListener("click", (e) => {
          S.paused = !S.paused;
          e.currentTarget.classList.toggle("on", S.paused);
          e.currentTarget.textContent = S.paused ? "Resume" : "Pause";
        });
        $("btnReset").addEventListener("click", reset);

        function reset() {
          S.hrTh = 100;
          setRange("r_hrth", 100, (v) => v + " BPM", "v_hrth");
          S.avgN = 6;
          setRange("r_avg", 6, (v) => v + " samples", "v_avg");
          S.snTh = 650;
          S.sens = 1;
          S.vol = 18;
          setRange("r_vol", 18, (v) => v + " / 30", "v_vol");
          S.bio = true;
          pickSeg("tgBio", "bio", "on");
          S.src = "bot";
          pickSeg("tgSrc", "src", "bot");
          $("manualWrap").style.display = "none";
          S.manualMode = "calm";
          pickSeg("segManual", "mode", "calm");
          S.audioOn = true;
          pickSeg("tgAudio", "aud", "on");
          S.paused = false;
          $("btnPause").classList.remove("on");
          $("btnPause").textContent = "Pause";

          S.calmness = 78;
          S.wasAgitated = false;
          S.agitatedAt = -99;
          S.changeTimes = [];
          S.candFlips = [];
          S.mode = "calm";
          S.candidate = "calm";
          S.candSince = 0;
          S.dfState = "Playing";
          S.dfChangedAt = -99;
          S.lastFeedback = "";
          S.flapWarnAt = -99;
          S.volFrameUntil = 0;

          ibiHist = [];
          bpmHist = [];
          trendBuf = [];
          calmHist = [];
          modeMarks = [];
          breathPh = 0;
          S.flashAt = -99;
          ppgBuf.fill(0);
          beatMarks.fill(0);
          tNow = 0;
          trendClock = 0;
          lastBeatT = 0;
          beatPhase = 0;
          logBox.innerHTML = "";

          pickSeg("segScenario", "sc", "rest");
          applyScenario("rest");
          S.bpmActual = S.bpmTarget;
          S.bpmDisp = S.bpmTarget;
          S.bpmRaw = S.bpmTarget;
          S.sndDisp = 0;
          retuneAudio("calm", 0.25);
          if (S.running) beginRun();
          log("Simulation reset. Crew status is stable.", "ok");
        }

        /* =================== HELP TABS =================== */
        const helpbar = $("helpbar");
        document.querySelectorAll(".helpbtn").forEach((btn) => {
          btn.addEventListener("click", () => {
            const tab = btn.dataset.tab;
            const already =
              btn.classList.contains("on") &&
              helpbar.classList.contains("show");
            document
              .querySelectorAll(".helpbtn")
              .forEach((b) => b.classList.remove("on"));
            document
              .querySelectorAll(".tabpanel")
              .forEach((p) => p.classList.remove("on"));
            if (already) {
              helpbar.classList.remove("show");
              return;
            }
            btn.classList.add("on");
            document
              .querySelector(`.tabpanel[data-panel="${tab}"]`)
              .classList.add("on");
            helpbar.classList.add("show");
          });
        });

        /* =================== LOOP =================== */
        let last = performance.now();
        function loop(now) {
          let dt = (now - last) / 1000;
          last = now;
          dt = Math.min(dt, 0.05); // a backgrounded tab must not fast-forward the crew
          if (!frozen()) {
            tNow += dt;
            step(dt);
          }
          sampleAudio();
          audioTick();
          trackTick(Math.min((now - (loop.prev || now)) / 1000, 0.1));
          loop.prev = now;
          drawPod();
          drawPPG();
          drawTrend();
          drawSpeaker();
          updateDOM();
          requestAnimationFrame(loop);
        }

        /* =================== BOOT =================== */
        refit();
        seedStars();
        if (typeof ResizeObserver !== "undefined") {
          const ro = new ResizeObserver(refit);
          [pod, ppg, trend, cone, swave].forEach((c) => ro.observe(c));
        }
        window.addEventListener("resize", refit);
        ["r_bpm", "r_hrth", "r_avg", "r_vol"].forEach((id) =>
          rangeFill($(id)),
        );
        applyScenario("rest");
        S.bpmActual = S.bpmTarget;
        S.bpmDisp = S.bpmTarget;
        S.bpmRaw = S.bpmTarget;
        log("Crew status is stable.", "ok");
        log("Press Start Simulation to begin.", "mus");
        document.addEventListener("pointerdown", unlockAudio, { once: true });
        document.addEventListener("keydown", unlockAudio, { once: true });
        requestAnimationFrame(loop);
      })();
    </script>
  
    <script>
      /* Universal Floating, Draggable & Resizable How-to-Use & Guide System */
      (function initUniversalHelpFloatwin() {
        var bar = document.getElementById("helpbar");
        if (!bar) return;

        // Ensure floatwin markup structure
        if (!bar.classList.contains("floatwin")) {
          bar.classList.add("floatwin");
          bar.setAttribute("role", "dialog");
          bar.setAttribute("aria-label", "Help Guide");

          var head = document.createElement("div");
          head.className = "fw-head";

          var title = document.createElement("span");
          title.className = "fw-title"; // drag grip only — the tab buttons already name the panel
          head.appendChild(title);

          var actions = document.createElement("div");
          actions.className = "fw-head-actions";

          var tabBtns = [];
          var origPanels = bar.querySelectorAll(".tabpanel");
          if (origPanels.length > 1) {
            origPanels.forEach(function (p) {
              var t = p.dataset.panel;
              var b = document.createElement("button");
              b.type = "button";
              b.className = "fw-tab-btn";
              b.dataset.tab = t;
              b.textContent = t === "use" ? "How To Use" : (t === "learn" ? "What You'll Learn" : t);
              actions.appendChild(b);
              tabBtns.push(b);
            });
          }

          var closeBtn = document.createElement("button");
          closeBtn.type = "button";
          closeBtn.className = "fw-close";
          closeBtn.title = "Close Guide";
          closeBtn.setAttribute("aria-label", "Close");
          closeBtn.textContent = "✕";
          actions.appendChild(closeBtn);
          head.appendChild(actions);

          var body = document.createElement("div");
          body.className = "fw-body";
          while (bar.firstChild) {
            body.appendChild(bar.firstChild);
          }

          var grip = document.createElement("div");
          grip.className = "fw-grip";
          grip.title = "Drag to resize";

          bar.appendChild(head);
          bar.appendChild(body);
          bar.appendChild(grip);

          document.body.appendChild(bar);
        }

        var btns = document.querySelectorAll(".helpbtn");
        var tabBtns = bar.querySelectorAll(".fw-tab-btn");
        var closeBtn = bar.querySelector(".fw-close");
        var headEl = bar.querySelector(".fw-head");
        var gripEl = bar.querySelector(".fw-grip");
        var topZ = 10000;
        var posInit = false;
        var userSized = false;

        function toFront() {
          bar.style.zIndex = ++topZ;
        }

        function closeAll() {
          bar.classList.remove("show");
          btns.forEach(function (b) { b.classList.remove("on"); });
          tabBtns.forEach(function (b) { b.classList.remove("on"); });
        }

        function openTab(tab) {
          toFront();
          if (!posInit) {
            var w = Math.min(440, window.innerWidth - 32);
            bar.style.width = w + "px";
            bar.style.top = "65px";
            bar.style.left = Math.max(12, window.innerWidth - w - 24) + "px";
            posInit = true;
          }
          bar.classList.add("show");
          btns.forEach(function (b) {
            b.classList.toggle("on", b.dataset.tab === tab);
          });
          tabBtns.forEach(function (b) {
            b.classList.toggle("on", b.dataset.tab === tab);
          });
          var panels = bar.querySelectorAll(".tabpanel");
          panels.forEach(function (p) {
            p.classList.toggle("on", p.dataset.panel === tab);
          });
          fitHeight();
        }

        // The window is as tall as its text needs, capped so it never runs off the
        // bottom of the screen. Once the user drags the resize grip, their size is kept.
        function fitHeight() {
          if (userSized) return;
          bar.style.height = "auto";
          var r = bar.getBoundingClientRect();
          var maxH = window.innerHeight - r.top - 12;
          if (r.height > maxH) bar.style.height = Math.max(200, maxH) + "px";
        }

        // Rotating a phone or resizing the window: keep the guide on screen and re-fit it.
        window.addEventListener("resize", function () {
          if (!bar.classList.contains("show")) return;
          var w = Math.min(bar.offsetWidth, window.innerWidth - 16);
          if (!userSized) w = Math.min(440, window.innerWidth - 32);
          bar.style.width = w + "px";
          var r = bar.getBoundingClientRect();
          bar.style.left = Math.max(8, Math.min(window.innerWidth - w - 8, r.left)) + "px";
          bar.style.top = Math.max(8, Math.min(window.innerHeight - 60, r.top)) + "px";
          fitHeight();
        });

        btns.forEach(function (btn) {
          var newBtn = btn.cloneNode(true);
          btn.parentNode.replaceChild(newBtn, btn);
          newBtn.addEventListener("click", function () {
            var tab = newBtn.dataset.tab || "use";
            if (bar.classList.contains("show") && newBtn.classList.contains("on")) {
              closeAll();
            } else {
              openTab(tab);
            }
          });
        });

        // re-query cloned buttons
        btns = document.querySelectorAll(".helpbtn");

        tabBtns.forEach(function (tb) {
          tb.addEventListener("click", function (e) {
            e.stopPropagation();
            openTab(tb.dataset.tab);
          });
        });

        if (closeBtn) closeBtn.addEventListener("click", closeAll);
        bar.addEventListener("pointerdown", toFront);

        document.addEventListener("keydown", function (e) {
          if (e.key === "Escape" && bar.classList.contains("show")) closeAll();
        });

        // Dragging by header
        if (headEl) {
          headEl.addEventListener("pointerdown", function (e) {
            if (e.target.closest(".fw-head-actions")) return;
            e.preventDefault();
            toFront();
            headEl.setPointerCapture(e.pointerId);
            var r = bar.getBoundingClientRect();
            var dx = e.clientX - r.left;
            var dy = e.clientY - r.top;
            bar.classList.add("dragging");
            function onMove(ev) {
              var nx = Math.max(8, Math.min(window.innerWidth - bar.offsetWidth - 8, ev.clientX - dx));
              var ny = Math.max(8, Math.min(window.innerHeight - 40, ev.clientY - dy));
              bar.style.left = nx + "px";
              bar.style.top = ny + "px";
            }
            function onUp(ev) {
              bar.classList.remove("dragging");
              headEl.removeEventListener("pointermove", onMove);
              headEl.removeEventListener("pointerup", onUp);
              headEl.removeEventListener("pointercancel", onUp);
            }
            headEl.addEventListener("pointermove", onMove);
            headEl.addEventListener("pointerup", onUp);
            headEl.addEventListener("pointercancel", onUp);
          });
        }

        // Resizing by grip
        if (gripEl) {
          gripEl.addEventListener("pointerdown", function (e) {
            e.preventDefault();
            e.stopPropagation();
            toFront();
            gripEl.setPointerCapture(e.pointerId);
            var r = bar.getBoundingClientRect();
            var startX = e.clientX;
            var startY = e.clientY;
            var startW = r.width;
            var startH = r.height;
            function onMove(ev) {
              var nw = Math.max(280, Math.min(window.innerWidth - r.left - 8, startW + (ev.clientX - startX)));
              var nh = Math.max(200, Math.min(window.innerHeight - r.top - 8, startH + (ev.clientY - startY)));
              bar.style.width = nw + "px";
              userSized = true;
              bar.style.height = nh + "px";
            }
            function onUp(ev) {
              gripEl.removeEventListener("pointermove", onMove);
              gripEl.removeEventListener("pointerup", onUp);
              gripEl.removeEventListener("pointercancel", onUp);
            }
            gripEl.addEventListener("pointermove", onMove);
            gripEl.addEventListener("pointerup", onUp);
            gripEl.addEventListener("pointercancel", onUp);
          });
        }
      })();
    </script>

  </body>
</html>
