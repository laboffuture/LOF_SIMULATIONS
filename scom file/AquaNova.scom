<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>AquaNova Alert Station — IoT Motion &amp; Water Rover</title>
    <link rel="icon" type="image/png" href="../../../assets/logo.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Orbitron:wght@600;700;800&family=Rajdhani:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <style>
      :root {
        --bg: #eef3fb;
        --panel: #ffffff;
        --panel2: #f3f8ff;
        --line: #dce6f5;
        --txt: #18233a;
        --mut: #5a6d8c;
        --dim: #95a7c4;
        --accent: #2563eb;
        --accent2: #38bdf8;
        --aqua: #06b6d4;
        --water: #38bdf8;
        --motion: #f59e0b;
        --warn: #f7a23b;
        --danger: #ff5470;
        --ok: #22c55e;
        --shadow: 0 12px 34px rgba(40, 70, 140, 0.14);
        --r: 20px;
        --head: "Orbitron", sans-serif;
        --body: "Rajdhani", sans-serif;
      }
      * {
        box-sizing: border-box;
      }
      html,
      body {
        margin: 0;
        height: 100%;
      }
      body {
        font-family: var(--body);
        font-size: 15.5px;
        font-weight: 500;
        color: var(--txt);
        background:
          radial-gradient(900px 500px at 6% -8%, #e0f4fb 0, transparent 60%),
          radial-gradient(900px 600px at 102% 0%, #e6f7ee 0, transparent 55%),
          linear-gradient(180deg, #f3f7fd, #e9f0fb);
        height: 100vh;
        overflow: hidden;
        padding: 10px clamp(10px, 2vw, 26px);
        display: flex;
        flex-direction: column;
      }
      h1,
      h3,
      h4,
      .chip,
      .bars-title {
        font-family: var(--head);
      }
      header.top {
        display: flex;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap;
        margin-bottom: 6px;
        flex: 0 0 auto;
        position: relative;
      }
      .logo {
        width: 42px;
        height: 42px;
        border-radius: 13px;
        display: grid;
        place-items: center;
        font-size: 22px;
        background: linear-gradient(145deg, #fff, #d9f5ef);
        border: 1px solid var(--line);
        box-shadow: var(--shadow);
      }
      .title h1 {
        margin: 0;
        font-size: 19px;
        font-weight: 800;
        letter-spacing: 1px;
        color: #12213f;
      }
      .title p {
        margin: 2px 0 0;
        font-size: 11px;
        font-weight: 500;
        letter-spacing: 0.5px;
        color: var(--mut);
      }
      .helpbtns {
        margin-left: auto;
        display: flex;
        gap: 8px;
      }
      .helpbtn {
        cursor: pointer;
        font-weight: 700;
        color: #fff;
        font-family: var(--head);
        font-size: 12.5px;
        letter-spacing: 0.3px;
        background: linear-gradient(145deg, #22d3ee, var(--aqua));
        border: none;
        padding: 10px 16px;
        border-radius: 12px;
        box-shadow: 0 8px 18px rgba(6, 182, 212, 0.32);
        transition: 0.15s;
      }
      .helpbtn:hover {
        transform: translateY(-2px);
      }
      .helpbtn.on {
        box-shadow:
          inset 0 0 0 2px #fff,
          0 8px 18px rgba(6, 182, 212, 0.32);
      }
      .helpbar {
        display: none;
        background: var(--panel);
        border: 1px solid var(--line);
        border-radius: 16px;
        box-shadow: var(--shadow);
        padding: 14px 16px;
        font-size: 14.5px;
        line-height: 1.55;
        color: var(--txt);
        position: absolute;
        right: 0;
        top: 56px;
        width: 410px;
        max-width: min(410px, 90vw);
        max-height: 75vh;
        overflow-y: auto;
        z-index: 40;
      }
      .helpbar.show {
        display: block;
      }
      @media (max-width: 1280px) {
        .helpbar {
          position: static;
          width: auto;
          max-width: none;
          margin-top: 8px;
        }
      }
      .tabpanel {
        display: none;
      }
      .tabpanel.on {
        display: block;
      }
      .tabpanel ol,
      .tabpanel ul {
        margin: 0;
        padding-left: 20px;
      }
      .tabpanel li {
        margin-bottom: 5px;
      }

      .shell {
        display: grid;
        grid-template-columns: minmax(0, 1fr) clamp(330px, 24vw, 420px);
        grid-template-rows: minmax(0, 1fr);
        gap: 12px;
        flex: 1 1 auto;
        min-height: 0;
      }
      /* One scrolling column for the screen, the readouts and every control, so
         the habitat itself keeps the rest of the window. */
      .rail {
        display: flex;
        flex-direction: column;
        gap: 12px;
        min-height: 0;
        overflow-y: auto;
        overscroll-behavior: contain;
        padding-right: 4px;
      }
      .rail::-webkit-scrollbar {
        width: 9px;
      }
      .rail::-webkit-scrollbar-track {
        background: transparent;
      }
      .rail::-webkit-scrollbar-thumb {
        background: #c3d3ea;
        border-radius: 6px;
      }
      .rail::-webkit-scrollbar-thumb:hover {
        background: #a7bcd9;
      }
      .card {
        background: var(--panel);
        border: 2px solid var(--line);
        border-radius: var(--r);
        box-shadow: var(--shadow);
        padding: 12px 14px;
        min-height: 0;
        display: flex;
        flex-direction: column;
      }

      /* ---- hero: the habitat is the whole point, so it gets the room ---- */
      .hero {
        position: relative;
        min-height: 0;
        border-radius: var(--r);
        border: 2px solid #14324a;
        box-shadow: var(--shadow);
        background: #07202b;
        overflow: hidden;
      }
      .hud {
        position: absolute;
        z-index: 3;
        display: flex;
        gap: 8px;
        pointer-events: none;
      }
      .hud-left {
        left: 12px;
        top: calc(13% + 38px);
        flex-direction: column;
      }
      .hud-right {
        right: 12px;
        top: calc(13% + 38px);
        flex-direction: column;
        align-items: flex-end;
      }
      .hud-msg {
        left: 12px;
        right: 12px;
        bottom: 32px;
        align-items: flex-end;
        justify-content: space-between;
      }
      .hud-foot {
        right: 12px;
        bottom: 10px;
        pointer-events: auto;
      }
      .hudpill {
        display: flex;
        align-items: center;
        gap: 9px;
        background: rgba(6, 26, 35, 0.74);
        border: 1px solid rgba(90, 190, 220, 0.26);
        border-radius: 12px;
        padding: 6px 11px 6px 9px;
      }
      .hudpill .bulb {
        width: 15px;
        height: 15px;
        border-radius: 50%;
        background: #22384a;
        box-shadow: inset 0 0 0 2px #0a1a24;
        flex: 0 0 auto;
        transition: 0.12s;
      }
      .hudpill .bulb.hot {
        background: var(--motion);
        box-shadow: 0 0 13px rgba(245, 158, 11, 0.9);
      }
      .hudpill .bulb.wet {
        background: #f97316;
        box-shadow: 0 0 13px rgba(249, 115, 22, 0.9);
      }
      .hudpill .k {
        font-size: 8.5px;
        letter-spacing: 0.7px;
        color: #8fb0c4;
        font-weight: 700;
        text-transform: uppercase;
      }
      .hudpill .v {
        font-size: 12.5px;
        font-weight: 700;
        color: #e6f2f8;
        font-family: var(--head);
        line-height: 1.2;
      }
      .hudchip {
        font-family: var(--head);
        font-weight: 800;
        font-size: 11.5px;
        letter-spacing: 1px;
        padding: 7px 12px;
        border-radius: 11px;
        background: rgba(34, 197, 94, 0.16);
        color: #4ade80;
        border: 1px solid rgba(74, 222, 128, 0.45);
        white-space: nowrap;
      }
      .hudchip.alarm {
        background: rgba(255, 84, 112, 0.18);
        color: #ff8098;
        border-color: rgba(255, 128, 152, 0.5);
      }
      .hudchip.mode {
        background: rgba(56, 189, 248, 0.14);
        color: #7dd3fc;
        border-color: rgba(125, 211, 252, 0.4);
      }
      .hudchip.mode.manual {
        background: rgba(245, 158, 11, 0.16);
        color: #fbbf24;
        border-color: rgba(251, 191, 36, 0.45);
      }
      .hudtext {
        background: rgba(6, 26, 35, 0.74);
        border: 1px solid rgba(90, 190, 220, 0.22);
        border-radius: 11px;
        padding: 7px 11px;
        font-size: 12.5px;
        font-weight: 600;
        color: #bfe0ee;
        max-width: 62%;
        line-height: 1.3;
      }
      .hudtext.alarm {
        border-color: rgba(255, 128, 152, 0.55);
        color: #ffd3dc;
        background: rgba(60, 12, 24, 0.78);
      }

      /* ---- device strip ---- */
      .devices {
        display: grid;
        grid-template-columns: 1fr;
        gap: 12px;
        flex: 0 0 auto;
      }

      /* ---- control dock ---- */
      .dock {
        display: grid;
        grid-template-columns: 1fr;
        gap: 12px;
        flex: 0 0 auto;
      }
      .dockgroup {
        background: var(--panel);
        border: 2px solid var(--line);
        border-radius: 16px;
        box-shadow: var(--shadow);
        padding: 9px 11px 11px;
        display: flex;
        flex-direction: column;
        gap: 7px;
      }
      .dockgroup h4 {
        font-size: 10.5px;
        letter-spacing: 1.1px;
        text-transform: uppercase;
        color: var(--accent);
        margin-bottom: 1px;
      }
      .dockgroup.drive h4 {
        color: var(--aqua);
      }
      .dockgroup.pipes h4 {
        color: #0284c7;
      }
      .dockgroup.life h4 {
        color: #16a34a;
      }
      .dockgroup.sensors h4 {
        color: var(--motion);
      }

      .keys {
        display: flex;
        align-items: center;
        gap: 6px;
        flex-wrap: wrap;
      }
      kbd {
        font-family: var(--head);
        font-size: 11px;
        font-weight: 700;
        min-width: 27px;
        text-align: center;
        padding: 5px 7px;
        border-radius: 7px;
        background: #0e2233;
        color: #bfe6f5;
        border: 1px solid #2a4d66;
        border-bottom-width: 3px;
        transition: 0.08s;
      }
      kbd.hot {
        background: var(--aqua);
        color: #04222b;
        border-color: #0e7490;
        transform: translateY(1px);
        border-bottom-width: 1px;
      }
      .keys .sep {
        font-size: 11.5px;
        color: var(--mut);
        font-weight: 600;
      }

      .pipegrid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 6px;
      }
      .pipebtn {
        font-family: var(--head);
        font-weight: 700;
        font-size: 13px;
        padding: 9px 0 7px;
        border-radius: 10px;
        border: 2px solid var(--line);
        background: var(--panel2);
        color: var(--mut);
        cursor: pointer;
        transition: 0.13s;
        line-height: 1.15;
      }
      .pipebtn small {
        display: block;
        font-family: var(--body);
        font-size: 8.5px;
        letter-spacing: 0.6px;
        font-weight: 700;
        text-transform: uppercase;
        opacity: 0.8;
      }
      .pipebtn:hover {
        border-color: var(--accent2);
      }
      .pipebtn.on {
        background: linear-gradient(145deg, #38bdf8, #0284c7);
        border-color: transparent;
        color: #fff;
        box-shadow: 0 7px 16px rgba(2, 132, 199, 0.34);
      }
      .btnrow {
        display: flex;
        gap: 6px;
      }
      .btnrow .btn {
        flex: 1 1 0;
        justify-content: center;
      }
      .count {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
        font-size: 11.5px;
        font-weight: 600;
        color: var(--mut);
        background: var(--panel2);
        border-radius: 9px;
        padding: 7px 10px;
        white-space: nowrap;
      }
      .count b {
        font-family: var(--head);
        font-size: 12.5px;
        color: var(--accent);
      }

      .card h3 {
        margin: 0 0 3px;
        font-size: 14.5px;
        font-weight: 700;
        letter-spacing: 0.7px;
        text-transform: uppercase;
        color: #12213f;
      }
      .card .sub {
        font-size: 12.5px;
        color: var(--mut);
        margin: 0 0 8px;
        line-height: 1.4;
      }

      .cmdgroup {
        margin-bottom: 14px;
      }
      .cmdgroup h4 {
        margin: 0 0 6px;
        font-size: 11px;
        letter-spacing: 0.6px;
        color: var(--aqua);
        text-transform: uppercase;
      }
      .cmdgroup.motion h4 {
        color: var(--motion);
      }
      .cmdgroup.blynk h4 {
        color: #16a34a;
      }
      .seg {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 6px;
        margin-bottom: 6px;
      }
      .seg button {
        cursor: pointer;
        border: 2px solid var(--line);
        background: #fff;
        color: var(--mut);
        padding: 8px 6px;
        border-radius: 11px;
        font-size: 12.5px;
        font-weight: 700;
        transition: 0.15s;
        font-family: var(--body);
      }
      .seg button:hover {
        border-color: var(--accent2);
      }
      .seg button.on {
        color: #fff;
        border-color: transparent;
        background: linear-gradient(145deg, #22d3ee, var(--aqua));
        box-shadow: 0 8px 18px rgba(6, 182, 212, 0.35);
      }
      .toggle {
        display: flex;
        gap: 8px;
        margin-bottom: 8px;
      }
      .toggle button {
        flex: 1;
        cursor: pointer;
        border: 2px solid var(--line);
        background: #fff;
        color: var(--mut);
        padding: 8px 6px;
        border-radius: 11px;
        font-size: 12.5px;
        font-weight: 700;
        transition: 0.15s;
        font-family: var(--body);
      }
      .toggle button.on {
        color: #fff;
        border-color: transparent;
        background: linear-gradient(145deg, #54c48a, #3fb87a);
        box-shadow: 0 8px 18px rgba(84, 196, 138, 0.35);
      }

      .ctrl {
        margin: 10px 0;
      }
      .ctrl .row {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        margin-bottom: 5px;
      }
      .ctrl label {
        font-size: 13px;
        font-weight: 600;
        color: var(--txt);
      }
      .ctrl .val {
        font-family: var(--head);
        font-size: 12px;
        color: var(--accent);
        font-weight: 700;
        font-variant-numeric: tabular-nums;
      }
      input[type="range"] {
        -webkit-appearance: none;
        width: 100%;
        height: 9px;
        border-radius: 10px;
        outline: none;
        background: linear-gradient(90deg, var(--accent2), var(--accent))
          no-repeat;
        background-size: var(--fill, 50%) 100%;
        box-shadow: inset 0 0 0 2px var(--line);
        cursor: pointer;
      }
      input[type="range"]::-webkit-slider-thumb {
        -webkit-appearance: none;
        width: 19px;
        height: 19px;
        border-radius: 50%;
        background: #fff;
        border: 4px solid var(--accent);
        box-shadow: 0 3px 8px rgba(0, 0, 0, 0.18);
        cursor: grab;
      }
      input[type="range"]::-moz-range-thumb {
        width: 17px;
        height: 17px;
        border-radius: 50%;
        background: #fff;
        border: 4px solid var(--accent);
        cursor: grab;
      }
      .hint {
        font-size: 11.5px;
        color: var(--dim);
        margin-top: 4px;
        line-height: 1.35;
      }

      canvas {
        max-width: 100%;
        display: block;
      }
      .stagewrap {
        position: absolute;
        inset: 0;
      }
      #zone {
        width: 100%;
        height: 100%;
        display: block;
        cursor: grab;
        touch-action: none;
      }
      #zone.drag {
        cursor: grabbing;
      }

      .screenwrap {
        background: #04140d;
        border: 2px solid #16543c;
        border-radius: 12px;
        padding: 6px;
        box-shadow:
          inset 0 0 26px rgba(62, 242, 165, 0.12),
          var(--shadow);
        flex: 1 1 auto;
        min-height: 0;
        display: flex;
      }
      #oled {
        width: 100%;
        height: 100%;
        min-height: 150px;
        display: block;
        border-radius: 7px;
      }
      .uplink {
        font-size: 11.5px;
        color: var(--mut);
        font-weight: 600;
        margin-top: 8px;
      }
      .uplink b {
        font-family: var(--head);
        color: var(--aqua);
        letter-spacing: 0.5px;
      }

      .btn {
        cursor: pointer;
        border: 2px solid var(--line);
        background: #fff;
        color: var(--txt);
        padding: 8px 13px;
        border-radius: 11px;
        font-size: 13.5px;
        font-weight: 600;
        transition: 0.15s;
        font-family: var(--body);
      }
      .btn:hover {
        transform: translateY(-2px);
        border-color: var(--accent2);
      }
      .btn.pause.on {
        background: linear-gradient(145deg, #22d3ee, var(--aqua));
        border-color: transparent;
        color: #fff;
        box-shadow: 0 8px 18px rgba(6, 182, 212, 0.35);
      }

      .reading {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 7px 0;
        border-bottom: 1.5px dashed var(--line);
        font-size: 13px;
      }
      .reading:last-child {
        border-bottom: none;
      }
      .reading .k {
        color: var(--mut);
      }
      .reading .v {
        font-weight: 700;
        font-size: 13px;
      }
      .hbar {
        height: 14px;
        border-radius: 8px;
        background: var(--panel2);
        border: 1.5px solid var(--line);
        position: relative;
        overflow: hidden;
        margin: 4px 0 8px;
      }
      .hbar .fill {
        position: absolute;
        inset: 0 auto 0 0;
        width: 0;
        border-radius: 7px;
        transition:
          width 0.12s,
          background 0.2s;
      }
      .hbar .thr {
        position: absolute;
        top: -3px;
        bottom: -3px;
        width: 2.5px;
        background: var(--danger);
        border-radius: 2px;
      }

      .verdict {
        padding: 10px;
        border-radius: 12px;
        background: var(--panel2);
        border: 1.5px solid var(--line);
        text-align: center;
        font-weight: 700;
        font-size: 13.5px;
        margin: 8px 0;
        color: var(--txt);
        line-height: 1.45;
      }
      .verdict.ok {
        background: #e9fbf1;
        border-color: #bfeed3;
        color: #12643a;
      }
      .verdict.warn {
        background: #fff6e6;
        border-color: #fadfb1;
        color: #8a5a08;
      }
      .verdict.bad {
        background: #ffeef1;
        border-color: #ffcdd6;
        color: #8f1e33;
      }

      .statusgrid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 6px;
        margin-top: 8px;
      }
      .stat {
        background: var(--panel2);
        border: 1.5px solid var(--line);
        border-radius: 10px;
        padding: 6px 8px;
      }
      .stat .k {
        font-size: 10.5px;
        color: var(--dim);
        text-transform: uppercase;
        letter-spacing: 0.4px;
        font-weight: 700;
      }
      .stat .v {
        font-size: 14px;
        font-weight: 700;
        margin-top: 2px;
      }
      .stat .v.g {
        color: var(--ok);
      }
      .stat .v.a {
        color: var(--accent);
      }
      .stat .v.n {
        color: var(--mut);
      }
      .stat .v.w {
        color: var(--warn);
      }
      .stat .v.d {
        color: var(--danger);
      }
      .stat .v.b {
        color: var(--water);
      }

      /* ---- responsive: below a comfortable width the rail drops underneath ---- */
      @media (max-width: 1100px) {
        body {
          overflow: auto;
        }
        .shell {
          grid-template-columns: 1fr;
          grid-template-rows: auto auto;
          flex: 0 0 auto;
        }
        .hero {
          height: clamp(320px, 56vw, 520px);
        }
        .rail {
          overflow: visible;
          padding-right: 0;
        }
        .devices {
          grid-template-columns: 1fr 1fr;
        }
        .dock {
          grid-template-columns: repeat(2, 1fr);
        }
      }
      @media (max-width: 820px) {
        .devices {
          grid-template-columns: 1fr;
        }
        .hudtext {
          max-width: 100%;
        }
      }
      @media (max-width: 560px) {
        .dock {
          grid-template-columns: 1fr;
        }
        .hud-msg {
          display: none;
        }
      }
    </style>
  </head>
  <body>
    <header class="top">
      <div class="logo">🌊</div>
      <div class="title">
        <h1>AQUANOVA ALERT STATION</h1>
        <p>DRIVE THE ROVER · PIR MOTION · WATER LEAKS · LOF ROBOTICS</p>
      </div>
      <div class="helpbtns">
        <button type="button" class="helpbtn" data-tab="use">How To Use</button>
        <button type="button" class="helpbtn" data-tab="learn">
          What You'll Learn
        </button>
      </div>
      <div class="helpbar" id="helpbar">
        <div class="tabpanel" data-panel="use">
          <ol>
            <li>
              <b>Drive the rover.</b> Hold <b>◀ / A</b> and <b>D / ▶</b> to move
              it along the floor. It starts on auto-patrol; the moment you press
              a drive key you take the wheel. Press <b>P</b> to hand it back.
            </li>
            <li>
              <b>Spring a leak.</b> Four pipes run across the ceiling —
              <b>A B C D</b>. Open any of them from the dock or by clicking the
              pipe itself, then raise <b>Drip Rate</b>. Each open pipe grows its
              own puddle in its own part of the habitat.
            </li>
            <li>
              <b>Go and find the water.</b> The rover only reads the puddle it is
              standing in, so open a far pipe and drive over to it. A dry floor
              between two puddles reads dry.
            </li>
            <li>
              <b>Fill the habitat.</b> Press <b>＋ Add</b> for more creatures,
              up to six. Any one of them moving inside the cone trips the PIR —
              so a crowded habitat is much harder to keep quiet.
            </li>
            <li>
              Drop <b>Movement</b> to <b>0</b>. The creatures stay put and the
              PIR goes silent, even with six of them standing in the beam.
            </li>
            <li>
              Watch <b>Alerts Sent</b> and <b>Throttled</b> climb. The station
              reports on its own — nobody pressed anything.
            </li>
          </ol>
        </div>
        <div class="tabpanel" data-panel="learn">
          <ul>
            <li>
              Why a PIR sensor detects <b>motion</b>, not presence — a creature
              holding still is invisible to it
            </li>
            <li>
              Why a PIR output stays HIGH for a few seconds after the movement
              stops
            </li>
            <li>
              How sensor sensitivity trades detection range against false alarms
            </li>
            <li>
              How an analog water sensor is turned into a yes/no answer by a
              threshold
            </li>
            <li>
              Why a sensor reads its <b>own location</b> — four leaking pipes
              still read dry if the rover is standing between the puddles
            </li>
            <li>
              Why IoT alerts are rate-limited instead of firing continuously
            </li>
            <li>
              How a device sends remote warnings with no human in the loop
            </li>
          </ul>
        </div>
      </div>
    </header>

    <main class="shell">
      <!-- ================= HERO: THE HABITAT ================= -->
      <section class="hero">
        <div class="stagewrap">
          <canvas id="zone" width="820" height="360"></canvas>
        </div>

        <div class="hud hud-left">
          <div class="hudpill">
            <div class="bulb" id="lampMotion"></div>
            <div>
              <div class="k">PIR Motion</div>
              <div class="v" id="lampMotionV">CLEAR</div>
            </div>
          </div>
          <div class="hudpill">
            <div class="bulb" id="lampWater"></div>
            <div>
              <div class="k">Water Level</div>
              <div class="v" id="lampWaterV">DRY</div>
            </div>
          </div>
        </div>

        <div class="hud hud-right">
          <div class="hudchip" id="hudChip">SAFE</div>
          <div class="hudchip mode" id="hudMode">PATROL</div>
        </div>

        <div class="hud hud-msg">
          <div class="hudtext" id="hudMsg">
            All clear — patrolling the habitat.
          </div>
        </div>

        <div class="hud hud-foot">
          <button class="btn pause" id="pauseBtn">⏸ Pause</button>
          <button class="btn" id="resetBtn">↺ Reset</button>
        </div>
      </section>

      <!-- ================= SIDE RAIL: EVERYTHING ELSE ================= -->
      <aside class="rail">
        <section class="devices">
        <div class="card">
          <h3>Rover OLED</h3>
          <div class="screenwrap">
            <canvas id="oled" width="700" height="228"></canvas>
          </div>
          <div class="seg" id="segOled" style="margin-top: 9px">
            <button data-oled="status" class="on">Status</button>
            <button data-oled="sensors">Sensors</button>
            <button data-oled="alert">Alert</button>
            <button data-oled="net">Network</button>
          </div>
          <div class="toggle" style="margin-top: 2px">
            <button id="oledBtn" class="on">🖥 Display ON</button>
          </div>
        </div>

        <div class="card">
          <h3>Sensor Telemetry</h3>
          <div class="verdict ok" id="verdictBox">
            Both sensors quiet. Nothing to report.
          </div>
          <div class="uplink">
            ☁ UPLINK <b id="uplinkTxt">IDLE</b> ·
            <span id="uplinkNote">Waiting for a trigger.</span>
          </div>

          <div class="reading">
            <span class="k">Water Sensor (analog)</span
            ><span class="v" id="waterVal">0</span>
          </div>
          <div class="hbar">
            <div
              class="fill"
              id="waterFill"
              style="background: linear-gradient(90deg, #fbbf24, #f97316)"
            ></div>
            <div class="thr" id="waterThr"></div>
          </div>
          <div class="reading">
            <span class="k">Nearest Creature</span
            ><span class="v" id="distVal">—</span>
          </div>
          <div class="reading">
            <span class="k">Fastest Creature</span
            ><span class="v" id="speedVal">0 px/s</span>
          </div>

          <div class="statusgrid">
            <div class="stat">
              <div class="k">PIR Output</div>
              <div class="v n" id="statPir">LOW</div>
            </div>
            <div class="stat">
              <div class="k">PIR Hold Left</div>
              <div class="v n" id="statHold">0.0 s</div>
            </div>
            <div class="stat">
              <div class="k">PIR Range</div>
              <div class="v a" id="statRange">0 px</div>
            </div>
            <div class="stat">
              <div class="k">Pipes Leaking</div>
              <div class="v b" id="statPipes">0 / 4</div>
            </div>
            <div class="stat">
              <div class="k">Alerts Sent</div>
              <div class="v g" id="statSent">0</div>
            </div>
            <div class="stat">
              <div class="k">Throttled</div>
              <div class="v w" id="statThrottled">0</div>
            </div>
          </div>
        </div>
      </section>

        <section class="dock">
        <div class="dockgroup drive">
          <h4>Drive</h4>
          <div class="keys">
            <kbd id="keyLeft">◀ A</kbd><kbd id="keyRight">D ▶</kbd>
            <span class="sep">drive</span>
          </div>
          <div class="keys">
            <kbd id="keyPatrol">P</kbd><span class="sep">hand it back</span>
          </div>
          <div class="toggle">
            <button id="patrolBtn" class="on">▶ Patrol Mode</button>
          </div>
          <div class="hint" id="driveHint">
            The rover sweeps the habitat on its own. Press a drive key to take
            the wheel.
          </div>
        </div>

        <div class="dockgroup pipes">
          <h4>Ceiling Pipes</h4>
          <div class="pipegrid" id="pipeGrid"></div>
          <div class="ctrl">
            <div class="row">
              <label>Drip Rate</label><span class="val" id="v_leak">0%</span>
            </div>
            <input
              type="range"
              id="r_leak"
              min="0"
              max="100"
              step="1"
              value="0"
            />
          </div>
          <div class="hint" id="pipeHint">
            All four pipes are sealed. Open one — or click it on the ceiling.
          </div>
        </div>

        <div class="dockgroup life">
          <h4>Habitat</h4>
          <div class="btnrow">
            <button class="btn" id="addCreatureBtn">＋ Add</button>
            <button class="btn" id="clearCreatureBtn">✕ Clear</button>
          </div>
          <div class="count" id="creatureCount">
            <span>Creatures</span><b>1 / 6</b>
          </div>
          <div class="ctrl">
            <div class="row">
              <label>Movement</label><span class="val" id="v_move">55</span>
            </div>
            <input
              type="range"
              id="r_move"
              min="0"
              max="100"
              step="1"
              value="55"
            />
          </div>
          <div class="hint">
            Movement drives every creature. Wind it to <b>0</b> and they stand
            still — invisible to a PIR.
          </div>
        </div>

        <div class="dockgroup sensors">
          <h4>Sensors</h4>
          <div class="ctrl">
            <div class="row">
              <label>PIR Sensitivity</label
              ><span class="val" id="v_pir">55%</span>
            </div>
            <input
              type="range"
              id="r_pir"
              min="0"
              max="100"
              step="1"
              value="55"
            />
          </div>
          <div class="ctrl">
            <div class="row">
              <label>Water Threshold</label
              ><span class="val" id="v_thr">30%</span>
            </div>
            <input
              type="range"
              id="r_thr"
              min="0"
              max="100"
              step="1"
              value="30"
            />
          </div>
          <div class="hint">
            Sensitivity trades detection range against false alarms. The
            threshold turns an analog reading into a yes/no answer.
          </div>
        </div>
        </section>
      </aside>
    </main>

    <script>
      (() => {
        "use strict";

        /* =================== HELPERS =================== */
        const clamp = (v, a, b) => Math.max(a, Math.min(b, v));
        const lerp = (a, b, t) => a + (b - a) * t;
        const TAU = Math.PI * 2;
        const $ = (id) => document.getElementById(id);

        /* =================== CANVASES =================== */
        const zone = $("zone"),
          zx = zone.getContext("2d");
        let W = zone.width,
          H = zone.height; // live CSS-pixel size, updated on resize
        const oled = $("oled"),
          ox = oled.getContext("2d");
        const OW = oled.width,
          OH = oled.height; // fixed logical screen space

        // The habitat stretches to fill the stage, so the backing store is re-cut on
        // resize. Drawing stays in CSS pixels (the transform carries devicePixelRatio)
        // so every hand-tuned offset keeps meaning the same thing.
        const dprOf = () => Math.min(window.devicePixelRatio || 1, 2);
        let fitted = false;
        function fitZone() {
          const r = zone.getBoundingClientRect();
          if (!r.width || !r.height) return;
          const cw = Math.round(r.width),
            ch = Math.round(r.height);
          if (fitted && cw === W && ch === H) return;
          const k = dprOf(),
            fx = cw / W,
            fy = ch / H;
          zone.width = Math.round(cw * k);
          zone.height = Math.round(ch * k);
          zx.setTransform(k, 0, 0, k, 0, 0);
          W = cw;
          H = ch;
          // Rescale the scene instead of re-rolling it, so a resize never teleports
          // the rover or re-grows the puddle somewhere else.
          rover.x *= fx;
          for (const c of creatures) {
            c.x *= fx;
            c.tx *= fx;
          }
          for (const p of pipes) {
            p.x *= fx;
            p.cx *= fx;
          }
          for (const p of plants) {
            p.x *= fx;
          }
          for (const d of drops) {
            d.x *= fx;
            d.y *= fy;
          }
          layout();
          fitted = true;
        }
        function fitOled() {
          const r = oled.getBoundingClientRect();
          if (!r.width || !r.height) return;
          const k = dprOf();
          const bw = Math.max(1, Math.round(r.width * k)),
            bh = Math.max(1, Math.round(r.height * k));
          if (oled.width === bw && oled.height === bh) return;
          oled.width = bw;
          oled.height = bh;
          ox.setTransform(bw / OW, 0, 0, bh / OH, 0, 0); // keep drawing in 700x228 space
        }
        const refit = () => {
          fitZone();
          fitOled();
        };

        /* =================== MODEL CONSTANTS =================== */
        const PIR_HOLD = 3.0; // seconds the PIR output latches after motion stops
        const ALERT_COOLDOWN = 5.0; // cloud-style rate limit between notifications
        const DROP_SPEED = 250; // px/s a falling drop travels
        const MAX_ANALOG = 1023; // what a real 10-bit ADC would report
        const DRIVE_SPEED = 130; // px/s while the student is driving by hand
        const PATROL_SPEED = 52; // px/s of the unattended auto-sweep
        const MAX_CREATURES = 6; // how full the habitat is allowed to get

        // Four pipes are plumbed across the ceiling at fixed points. Each one leaks
        // independently, so the habitat can be dry in one place and flooded in another
        // — which is the whole reason the rover has to go and look.
        const PIPE_SPOTS = [
          { label: "A", fx: 0.16 },
          { label: "B", fx: 0.38 },
          { label: "C", fx: 0.62 },
          { label: "D", fx: 0.84 },
        ];

        // The alarm rule is fixed at "either" — the picker is gone, but the table
        // still drives evaluate() and the OLED network readout.
        const CONDITIONS = {
          motion: { label: "Motion Only" },
          water: { label: "Water Only" },
          both: { label: "Motion + Water" },
          either: { label: "Either One" },
        };
        const ALERT_TYPES = {
          push: {
            label: "Push Alert",
            icon: "🔔",
            note: "Pushed the moment the rule is met.",
          },
          email: {
            label: "Email",
            icon: "✉",
            note: "Queued to the account inbox.",
          },
          log: {
            label: "Event Log",
            icon: "📋",
            note: "Recorded quietly, no buzz.",
          },
          none: {
            label: "Widgets Only",
            icon: "📊",
            note: "Dashboard updates, nothing sent.",
          },
        };

        /* =================== STATE =================== */
        let moveLevel = 55,
          leakLevel = 0;
        let patrol = true,
          pirSens = 55,
          waterThr = 30;
        let oledOn = true,
          oledMode = "status";
        let notifyOn = true,
          alertType = "push",
          condition = "either";
        let paused = false;

        let floorY = 0,
          ceilY = 0;
        // How big everything in the habitat is drawn. A short, wide stage keeps the
        // original 1:1 sizes; a tall one scales the rover, creatures, plants and
        // puddles up together so the scene fills the space it has been given.
        let S = 1;
        const edgeX = () => 30 * S + 16; // how close the rover may get to a wall
        let rover = { x: 420, dir: 1 };
        // Which drive keys are held right now. Movement is applied in step(), not in
        // the key handler, so it stays frame-rate independent like everything else.
        const keysDown = new Set();

        let creatures = [];
        let pipes = PIPE_SPOTS.map((p) => ({
          label: p.label,
          fx: p.fx,
          x: 0, // filled in by layout(), which knows the canvas width
          on: false,
          t: 0, // countdown to the next drop
          vol: 0, // how much water its puddle is holding
          cx: 0, // where that puddle has settled
        }));
        let drops = [],
          ripples = [],
          plants = [];

        let pirRaw = false,
          pirOut = false,
          pirHold = 0,
          pirRange = 0;
        let waterRaw = 0,
          waterWet = false,
          splashBoost = 0;
        let alarm = false,
          prevAlarm = false,
          alarmKind = "none";
        let cooldown = 0,
          sentCount = 0,
          throttledCount = 0,
          uptime = 0;
        let lastAlertAt = -999,
          uplinkFlash = 0;
        // Kept for the OLED alert log: newest entry first.
        let feedItems = [];
        let tNow = 0;

        /* =================== LAYOUT / SCENERY =================== */
        function layout() {
          floorY = H * 0.8;
          ceilY = H * 0.13;
          S = clamp((floorY - ceilY) / 300, 1, 2);
          rover.x = clamp(rover.x, edgeX(), W - edgeX());
          for (const p of pipes) {
            p.x = p.fx * W;
            if (!p.cx) p.cx = p.x;
            p.cx = clamp(p.cx, 20, W - 20);
          }
          for (const c of creatures) {
            c.x = clamp(c.x, 26, W - 26);
            c.tx = clamp(c.tx, 30, W - 30);
          }
        }
        function newPlant(x) {
          return {
            x: x === undefined ? Math.random() * W : clamp(x, 12, W - 12),
            h: 16 + Math.random() * 30,
            w: 10 + Math.random() * 16,
            hue: Math.random(),
          };
        }
        function seedScenery() {
          plants = [];
          for (let i = 0; i < 7; i++) plants.push(newPlant());
        }

        /* =================== HABITAT POPULATION =================== */
        function newCreature(x) {
          const px = x === undefined ? 30 + Math.random() * (W - 60) : x;
          return {
            x: px,
            tx: 30 + Math.random() * (W - 60),
            dir: Math.random() < 0.5 ? -1 : 1,
            speed: 0,
            wait: Math.random() * 0.8,
            legPhase: Math.random() * TAU,
          };
        }
        // Every creature arrives with a little greenery around it, so a busy habitat
        // looks lived-in rather than just crowded.
        function addCreature() {
          if (creatures.length >= MAX_CREATURES) return false;
          const c = newCreature();
          creatures.push(c);
          plants.push(newPlant(c.x - 30 + Math.random() * 60));
          plants.push(newPlant(c.x - 60 + Math.random() * 120));
          return true;
        }
        function clearCreatures() {
          creatures = [];
        }

        /* =================== WATER MODEL =================== */
        // Every open pipe drips at the shared rate. Drops fall, land, and feed the
        // puddle belonging to the pipe they came from — each puddle spreads outward and
        // drains away once its pipe is shut. The rover's reading therefore depends on
        // *where it is standing*, not on how many pipes happen to be leaking.
        const puddleRadius = (p) =>
          Math.min(W * 0.34, Math.sqrt(p.vol) * 7.5 * S);
        const puddleDepth = (p) => clamp(p.vol / 260, 0, 1);

        // Depth profile of one puddle: deepest at the centre, tapering to nothing at
        // the rim. Returns 0..1.
        function depthAt(p, x) {
          const R = puddleRadius(p);
          if (R <= 0) return 0;
          return Math.max(0, 1 - Math.abs(x - p.cx) / R) * puddleDepth(p);
        }
        // Overlapping puddles must not stack into an impossible reading, so the probe
        // reports the deepest water under it rather than the sum.
        function waterDepthAt(x) {
          let d = 0;
          for (const p of pipes) d = Math.max(d, depthAt(p, x));
          return d;
        }
        const openPipes = () => pipes.filter((p) => p.on).length;

        function stepWater(dt) {
          const rate = leakLevel / 100;
          const interval = lerp(0.55, 0.045, rate);
          for (const p of pipes) {
            if (!p.on || rate <= 0) {
              p.t = 0;
              continue;
            }
            p.t -= dt;
            if (p.t <= 0) {
              p.t = interval;
              drops.push({
                pipe: p,
                x: p.x + (Math.random() - 0.5) * 3,
                y: ceilY + 26,
                vy: 0,
              });
            }
          }

          for (const d of drops) {
            d.vy += 520 * dt;
            d.y += d.vy * dt;
          }
          const roverTop = floorY - 30 * S;
          const survivors = [];
          for (const d of drops) {
            // A drop landing on the rover's probe gives the sensor a direct spike.
            const onRover = d.y >= roverTop && Math.abs(d.x - rover.x) < 24 * S;
            if (onRover) {
              splashBoost = Math.min(1, splashBoost + 0.42);
              ripples.push({ x: d.x, y: roverTop, r: 2, life: 0, onBot: true });
              continue;
            }
            if (d.y >= floorY) {
              d.pipe.vol += 1.0;
              d.pipe.cx = lerp(d.pipe.cx, d.x, 0.06);
              ripples.push({ x: d.x, y: floorY, r: 2, life: 0, onBot: false });
              continue;
            }
            survivors.push(d);
          }
          drops = survivors;

          for (const p of pipes) p.vol = Math.max(0, p.vol - dt * 3.2); // drainage
          splashBoost = Math.max(0, splashBoost - dt * 0.85);

          for (const r of ripples) {
            r.r += 52 * dt;
            r.life += dt;
          }
          ripples = ripples.filter((r) => r.life < 0.85);

          const target = clamp(
            waterDepthAt(rover.x) * 100 + splashBoost * 45,
            0,
            100,
          );
          waterRaw = lerp(waterRaw, target, 1 - Math.pow(0.02, dt)); // sensors settle, they don't snap
          waterWet = waterRaw > waterThr;
        }

        /* =================== CREATURES + PIR =================== */
        function stepCreature(dt) {
          const maxSpeed = (moveLevel / 100) * 90;
          for (const c of creatures) {
            if (maxSpeed < 0.5) {
              c.speed = 0;
              continue;
            } // present, but standing still
            if (c.wait > 0) {
              c.wait -= dt;
              c.speed = 0;
              continue;
            }
            const dx = c.tx - c.x;
            if (Math.abs(dx) < 6) {
              c.tx = 30 + Math.random() * (W - 60);
              c.wait = Math.random() * 1.4;
              c.speed = 0;
              continue;
            }
            c.dir = Math.sign(dx);
            c.speed = maxSpeed;
            c.x = clamp(c.x + c.dir * maxSpeed * dt, 26, W - 26);
            c.legPhase += dt * maxSpeed * 0.13;
          }
        }

        // A PIR does not see warm bodies — it sees *changes* in infrared. Something
        // inside the cone that is not moving produces no change and no trigger, which
        // is the single most misunderstood thing about these sensors. With several
        // creatures about, any one of them moving in the cone is enough to trip it.
        function stepPIR(dt) {
          pirRange = (90 + pirSens * 1.7) * S;
          const minSpeed = lerp(34, 3, pirSens / 100);
          let seen = false;
          for (const c of creatures) {
            const dx = c.x - rover.x;
            const inFront = Math.sign(dx) === rover.dir || Math.abs(dx) < 12;
            if (inFront && Math.abs(dx) < pirRange && c.speed > minSpeed) {
              seen = true;
              break;
            }
          }
          pirRaw = seen;

          // Real modules hold their output HIGH for a set time after the last trigger.
          if (pirRaw) pirHold = PIR_HOLD;
          else pirHold = Math.max(0, pirHold - dt);
          pirOut = pirRaw || pirHold > 0;
        }

        // Distance to whichever creature is closest, for the telemetry readout.
        function nearestCreatureDist() {
          let best = null;
          for (const c of creatures) {
            const d = Math.abs(c.x - rover.x);
            if (best === null || d < best) best = d;
          }
          return best;
        }

        /* =================== ROVER =================== */
        // Held keys steer by hand; with none held the rover either resumes its
        // unattended sweep or sits parked, depending on the patrol switch.
        function driveInput() {
          const left = keysDown.has("left") ? -1 : 0;
          const right = keysDown.has("right") ? 1 : 0;
          return left + right;
        }
        function stepRover(dt) {
          if (dragging) return;
          const drive = driveInput();
          const e = edgeX();
          if (drive !== 0) {
            rover.dir = drive;
            rover.x = clamp(rover.x + drive * DRIVE_SPEED * S * dt, e, W - e);
            return;
          }
          if (!patrol) return;
          rover.x += rover.dir * PATROL_SPEED * S * dt;
          if (rover.x > W - e) {
            rover.x = W - e;
            rover.dir = -1;
          }
          if (rover.x < e) {
            rover.x = e;
            rover.dir = 1;
          }
        }

        /* =================== ALERT ENGINE =================== */
        function evaluate() {
          switch (condition) {
            case "motion":
              return pirOut;
            case "water":
              return waterWet;
            case "both":
              return pirOut && waterWet;
            default:
              return pirOut || waterWet;
          }
        }
        function alertMessage() {
          if (pirOut && waterWet)
            return {
              kind: "crit",
              icon: "🚨",
              head: "CRITICAL — Motion + Water",
              msg: "Movement detected while the habitat is flooding. Send help to AquaNova.",
            };
          if (waterWet)
            return {
              kind: "water",
              icon: "💧",
              head: "Water leak detected",
              msg: `Water sensor reads ${Math.round(waterRaw)}% (threshold ${waterThr}%). The rover is standing in water.`,
            };
          if (pirOut)
            return {
              kind: "motion",
              icon: "⚠",
              head: "Motion detected",
              msg: `Something is moving ${Math.round(nearestCreatureDist() ?? 0)} px from the rover.`,
            };
          return {
            kind: "crit",
            icon: "🚨",
            head: "Alert",
            msg: "Emergency condition met.",
          };
        }
        function stepAlerts(dt) {
          cooldown = Math.max(0, cooldown - dt);
          uplinkFlash = Math.max(0, uplinkFlash - dt);

          prevAlarm = alarm;
          alarm = evaluate();
          alarmKind = alarm ? alertMessage().kind : "none";

          // Only the *rising edge* dispatches. A sensor sitting HIGH must not spam the
          // cloud — that is exactly why real IoT platforms rate-limit notifications.
          if (alarm && !prevAlarm) {
            if (!notifyOn) return; // muted: nothing leaves the device
            if (alertType === "none") return; // dashboard-only: widgets update, no delivery
            if (cooldown > 0) {
              throttledCount++;
              return;
            }
            dispatch(alertMessage());
          }
        }
        function dispatch(a) {
          cooldown = ALERT_COOLDOWN;
          lastAlertAt = uptime;
          uplinkFlash = 0.7;
          sentCount++;
          feedItems.unshift({
            kind: a.kind,
            head: (alertType === "email" ? "✉ " : "") + a.head,
            msg: a.msg,
            t: uptime,
          });
          if (feedItems.length > 14) feedItems.pop();
        }

        /* =================== SIM STEP =================== */
        function step(dt) {
          uptime += dt;
          stepCreature(dt);
          stepRover(dt);
          stepWater(dt);
          stepPIR(dt);
          stepAlerts(dt);
        }

        /* =================== HABITAT RENDER =================== */
        function roundRect(c, x, y, w, h, r) {
          c.beginPath();
          c.moveTo(x + r, y);
          c.arcTo(x + w, y, x + w, y + h, r);
          c.arcTo(x + w, y + h, x, y + h, r);
          c.arcTo(x, y + h, x, y, r);
          c.arcTo(x, y, x + w, y, r);
          c.closePath();
        }
        function drawZone() {
          // --- habitat shell ---
          const g = zx.createLinearGradient(0, 0, 0, H);
          g.addColorStop(0, "#07202b");
          g.addColorStop(0.6, "#0a2733");
          g.addColorStop(1, "#08202a");
          zx.fillStyle = g;
          zx.fillRect(0, 0, W, H);

          // dome glass
          zx.strokeStyle = "rgba(90,190,220,.20)";
          zx.lineWidth = 2;
          zx.beginPath();
          zx.moveTo(0, ceilY);
          zx.lineTo(W, ceilY);
          zx.stroke();
          zx.fillStyle = "rgba(60,150,180,.07)";
          zx.fillRect(0, 0, W, ceilY);
          for (let x = 40; x < W; x += 110) {
            zx.strokeStyle = "rgba(90,190,220,.13)";
            zx.lineWidth = 1.4;
            zx.beginPath();
            zx.moveTo(x, 0);
            zx.lineTo(x + 26, ceilY);
            zx.stroke();
          }

          // back wall grid
          zx.strokeStyle = "rgba(70,150,175,.10)";
          zx.lineWidth = 1;
          for (let y = ceilY + 30; y < floorY; y += 32) {
            zx.beginPath();
            zx.moveTo(0, y);
            zx.lineTo(W, y);
            zx.stroke();
          }

          drawPlants();
          drawPipes();

          // --- floor ---
          const fg = zx.createLinearGradient(0, floorY, 0, H);
          fg.addColorStop(0, "#123340");
          fg.addColorStop(1, "#0a1f28");
          zx.fillStyle = fg;
          zx.fillRect(0, floorY, W, H - floorY);
          zx.strokeStyle = "rgba(120,210,235,.22)";
          zx.lineWidth = 2;
          zx.beginPath();
          zx.moveTo(0, floorY);
          zx.lineTo(W, floorY);
          zx.stroke();

          drawPuddles();
          drawRipples();
          drawDrops();
          for (const c of creatures) drawCreature(c);
          drawPIRCone();
          drawRover();
          drawHUD();
          if (alarm) drawAlarmVignette();
        }

        function drawPlants() {
          for (const p of plants) {
            const x = p.x,
              base = floorY;
            zx.strokeStyle =
              p.hue > 0.5 ? "rgba(52,180,140,.55)" : "rgba(90,190,120,.45)";
            zx.lineWidth = 3 * S;
            zx.lineCap = "round";
            const ph = p.h * S,
              pw = p.w * S;
            for (let i = -1; i <= 1; i++) {
              zx.beginPath();
              zx.moveTo(x, base);
              zx.quadraticCurveTo(
                x + i * pw,
                base - ph * 0.6,
                x + i * pw * 1.6,
                base - ph,
              );
              zx.stroke();
            }
          }
        }
        function drawPipes() {
          const y = ceilY + 16 * S;
          zx.fillStyle = "#2b4a56";
          zx.strokeStyle = "#54808f";
          zx.lineWidth = 2;
          roundRect(zx, 0, y - 9 * S, W, 18 * S, 4);
          zx.fill();
          zx.stroke();

          for (const p of pipes) {
            const live = p.on && leakLevel > 0;
            // the joint itself — lit when it is running
            zx.fillStyle = p.on ? "#4d7f93" : "#3d6272";
            zx.strokeStyle = live ? "#7fd4f0" : "#54808f";
            zx.lineWidth = 2;
            roundRect(zx, p.x - 15 * S, y - 13 * S, 30 * S, 26 * S, 5);
            zx.fill();
            zx.stroke();
            if (live) {
              zx.fillStyle =
                "rgba(56,189,248," +
                (0.35 + 0.4 * Math.sin(tNow * 7 + p.fx * 9) * 0.5 + 0.2) +
                ")";
              zx.beginPath();
              zx.arc(p.x, y + 11 * S, 3.4 * S, 0, TAU);
              zx.fill();
            }
            zx.fillStyle = p.on
              ? "rgba(125,211,252,.95)"
              : "rgba(150,205,225,.5)";
            zx.font = `700 ${Math.round(11 * S)}px "Orbitron",sans-serif`;
            zx.textAlign = "center";
            zx.fillText(p.label, p.x, y + 4 * S);
            zx.font = `600 ${Math.round(9 * S)}px "Rajdhani",sans-serif`;
            zx.fillText(p.on ? "LEAKING" : "SEALED", p.x, y - 19 * S);
            zx.textAlign = "left";
          }
        }
        function drawDrops() {
          zx.fillStyle = "#7dd3fc";
          for (const d of drops) {
            zx.beginPath();
            zx.ellipse(
              d.x,
              d.y,
              2.6 * S,
              (4.6 + Math.min(4, d.vy * 0.012)) * S,
              0,
              0,
              TAU,
            );
            zx.fill();
          }
        }
        function drawPuddles() {
          for (const p of pipes) {
            const R = puddleRadius(p);
            if (R < 2) continue;
            const depth = puddleDepth(p);
            const grd = zx.createLinearGradient(
              0,
              floorY - 4 * S,
              0,
              floorY + 12 * S,
            );
            grd.addColorStop(0, `rgba(56,189,248,${0.3 + 0.45 * depth})`);
            grd.addColorStop(1, `rgba(14,116,180,${0.2 + 0.4 * depth})`);
            zx.fillStyle = grd;
            zx.beginPath();
            zx.ellipse(p.cx, floorY + 3 * S, R, (4 + 9 * depth) * S, 0, 0, TAU);
            zx.fill();
            // surface shimmer
            zx.strokeStyle = `rgba(190,235,255,${0.2 + 0.25 * depth})`;
            zx.lineWidth = 1.4 * S;
            zx.beginPath();
            for (let i = 0; i <= 26; i++) {
              const t = i / 26,
                x = p.cx - R + 2 * R * t;
              const y = floorY + (1 + Math.sin(t * 9 + tNow * 2.4) * 1.7) * S;
              i === 0 ? zx.moveTo(x, y) : zx.lineTo(x, y);
            }
            zx.stroke();
          }
        }
        function drawRipples() {
          for (const r of ripples) {
            const a = 1 - r.life / 0.85;
            zx.strokeStyle = `rgba(160,225,255,${a * 0.7})`;
            zx.lineWidth = 1.6 * S;
            zx.beginPath();
            zx.ellipse(r.x, r.y + 2 * S, r.r * S, r.r * 0.32 * S, 0, 0, TAU);
            zx.stroke();
          }
        }

        function drawCreature(c) {
          const walk = c.speed > 0.5;
          const bob = walk ? Math.sin(c.legPhase * 2) * 1.6 : 0;
          const bodyY = -17 + bob; // relative to the creature's feet on the floor

          zx.save();
          zx.translate(c.x, floorY);
          zx.scale(S, S);

          zx.save();
          zx.scale(c.dir || 1, 1);
          // legs
          zx.strokeStyle = "#2f9e6b";
          zx.lineWidth = 2.6;
          zx.lineCap = "round";
          for (let i = -1; i <= 1; i += 2) {
            const ph = walk
              ? Math.sin(c.legPhase + (i > 0 ? 0 : Math.PI)) * 4
              : 0;
            zx.beginPath();
            zx.moveTo(i * 5, bodyY + 7);
            zx.lineTo(i * 5 + ph, 0);
            zx.stroke();
          }
          // body
          zx.fillStyle = "#37b87d";
          zx.strokeStyle = "#1f7a52";
          zx.lineWidth = 2;
          zx.beginPath();
          zx.ellipse(0, bodyY, 14, 9, 0, 0, TAU);
          zx.fill();
          zx.stroke();
          // head
          zx.beginPath();
          zx.ellipse(12, bodyY - 5, 7.5, 6, 0, 0, TAU);
          zx.fill();
          zx.stroke();
          // eye
          zx.fillStyle = "#06232a";
          zx.beginPath();
          zx.arc(15, bodyY - 6.5, 1.8, 0, TAU);
          zx.fill();
          // tail
          zx.strokeStyle = "#2f9e6b";
          zx.lineWidth = 3;
          zx.beginPath();
          zx.moveTo(-13, bodyY);
          zx.quadraticCurveTo(
            -24,
            bodyY - 4 - (walk ? Math.sin(c.legPhase * 2) * 3 : 0),
            -30,
            bodyY + 3,
          );
          zx.stroke();
          zx.restore();

          // "moving" marker so a still creature is visibly different
          if (walk) {
            zx.strokeStyle = "rgba(245,158,11,.75)";
            zx.lineWidth = 2;
            for (let i = 1; i <= 2; i++) {
              const off = -c.dir * (18 + i * 7);
              zx.beginPath();
              zx.moveTo(off, bodyY - 6);
              zx.lineTo(off - c.dir * 5, bodyY);
              zx.lineTo(off, bodyY + 6);
              zx.stroke();
            }
          } else {
            zx.fillStyle = "rgba(150,190,205,.8)";
            zx.font = '600 11px "Rajdhani",sans-serif';
            zx.textAlign = "center";
            zx.fillText("(still)", 0, bodyY - 18);
            zx.textAlign = "left";
          }
          zx.restore();
        }

        function drawPIRCone() {
          const y = floorY - 30 * S;
          const half = 0.62; // ~70 degrees total, like a real lens
          zx.save();
          zx.translate(rover.x, y);
          zx.scale(rover.dir, 1);
          const grd = zx.createRadialGradient(0, 0, 6, 0, 0, pirRange);
          const hot = pirOut;
          grd.addColorStop(
            0,
            hot ? "rgba(245,158,11,.34)" : "rgba(120,200,225,.20)",
          );
          grd.addColorStop(1, "rgba(120,200,225,0)");
          zx.fillStyle = grd;
          zx.beginPath();
          zx.moveTo(0, 0);
          zx.arc(0, 0, pirRange, -half, half);
          zx.closePath();
          zx.fill();
          zx.strokeStyle = hot
            ? "rgba(245,158,11,.65)"
            : "rgba(120,200,225,.35)";
          zx.lineWidth = 1.5 * S;
          zx.beginPath();
          zx.moveTo(0, 0);
          zx.arc(0, 0, pirRange, -half, half);
          zx.closePath();
          zx.stroke();
          zx.restore();
        }

        function drawRover() {
          const wet = waterWet;
          zx.save();
          zx.translate(rover.x, floorY);
          zx.scale(S, S); // everything below is in the rover's own 1:1 units

          // wheels
          zx.fillStyle = "#12333f";
          zx.strokeStyle = "#4f93a8";
          zx.lineWidth = 2;
          for (const wx of [-15, 15]) {
            zx.beginPath();
            zx.arc(wx, -8, 8, 0, TAU);
            zx.fill();
            zx.stroke();
            zx.strokeStyle = "#2b6274";
            zx.lineWidth = 1.5;
            zx.beginPath();
            zx.moveTo(wx, -8);
            zx.lineTo(
              wx + Math.cos(rover.x * 0.06) * 5,
              -8 + Math.sin(rover.x * 0.06) * 5,
            );
            zx.stroke();
            zx.strokeStyle = "#4f93a8";
            zx.lineWidth = 2;
          }
          // chassis
          zx.fillStyle = "#17414f";
          zx.strokeStyle = "#5cc0d8";
          zx.lineWidth = 2.5;
          roundRect(zx, -26, -34, 52, 24, 7);
          zx.fill();
          zx.stroke();

          // PIR dome on top
          zx.fillStyle = pirOut ? "#f6c76a" : "#cfe6ee";
          zx.beginPath();
          zx.arc(rover.dir * 8, -36, 7, Math.PI, 0);
          zx.fill();
          zx.strokeStyle = "#8fb9c6";
          zx.lineWidth = 1.5;
          zx.stroke();
          if (pirOut) {
            zx.shadowColor = "#f59e0b";
            zx.shadowBlur = 14;
            zx.beginPath();
            zx.arc(rover.dir * 8, -36, 7, Math.PI, 0);
            zx.fill();
            zx.shadowBlur = 0;
          }

          // status LED
          zx.fillStyle = alarm
            ? Math.sin(tNow * 9) > 0
              ? "#ff5470"
              : "#4a1526"
            : "#22c55e";
          zx.beginPath();
          zx.arc(-16, -30, 3, 0, TAU);
          zx.fill();

          // water probe hanging to the floor
          zx.strokeStyle = "#8fb9c6";
          zx.lineWidth = 2;
          zx.beginPath();
          zx.moveTo(-rover.dir * 14, -14);
          zx.lineTo(-rover.dir * 14, -2);
          zx.stroke();
          zx.fillStyle = wet ? "#38bdf8" : "#39606e";
          roundRect(zx, -rover.dir * 14 - 3.5, -6, 7, 7, 2);
          zx.fill();
          if (wet) {
            zx.shadowColor = "#38bdf8";
            zx.shadowBlur = 12;
            roundRect(zx, -rover.dir * 14 - 3.5, -6, 7, 7, 2);
            zx.fill();
            zx.shadowBlur = 0;
          }

          zx.fillStyle = "#9fd6e6";
          zx.font = '700 10px "Orbitron",sans-serif';
          zx.textAlign = "center";
          zx.fillText("AQUANOVA", 0, -42);
          zx.textAlign = "left";
          zx.restore();
        }

        function drawHUD() {
          zx.font = '700 11px "Orbitron",sans-serif';
          zx.textAlign = "left";
          zx.fillStyle = "rgba(140,215,235,.85)";
          zx.fillText(
            "HABITAT ZONE A · " + (patrol ? "AUTO PATROL" : "MANUAL DRIVE"),
            14,
            22,
          );
          zx.font = '600 11px "Rajdhani",sans-serif';
          zx.fillStyle = "rgba(150,190,205,.7)";
          zx.fillText(
            "◀ A / D ▶ drive · P patrol · click a ceiling pipe to open or seal it",
            14,
            H - 12,
          );

          zx.textAlign = "right";
          zx.font = '800 13px "Orbitron",sans-serif';
          zx.fillStyle = alarm ? "#ff8098" : "#4ade80";
          zx.fillText(alarm ? "ALARM" : "ALL CLEAR", W - 14, 24);
          zx.textAlign = "left";
        }
        function drawAlarmVignette() {
          const a = 0.1 + 0.1 * Math.sin(tNow * 8);
          const grd = zx.createRadialGradient(
            W / 2,
            H / 2,
            Math.min(W, H) * 0.28,
            W / 2,
            H / 2,
            Math.max(W, H) * 0.72,
          );
          grd.addColorStop(0, "rgba(255,60,90,0)");
          grd.addColorStop(1, `rgba(255,40,80,${a})`);
          zx.fillStyle = grd;
          zx.fillRect(0, 0, W, H);
        }

        /* =================== OLED RENDER =================== */
        const ON = "#3ef2a5",
          DIM = "#136b4a",
          HOT = "#f2c14e",
          WET = "#63d3f5",
          BAD = "#ef6a6a";
        function drawOled() {
          ox.fillStyle = "#04140d";
          ox.fillRect(0, 0, OW, OH);
          if (!oledOn) {
            ox.fillStyle = "#0a2018";
            ox.font = '700 26px "Orbitron",sans-serif';
            ox.textAlign = "center";
            ox.fillText("DISPLAY OFF", OW / 2, OH / 2 + 8);
            ox.textAlign = "left";
          } else {
            if (oledMode === "status") oledStatus();
            if (oledMode === "sensors") oledSensors();
            if (oledMode === "alert") oledAlert();
            if (oledMode === "net") oledNet();
          }
          ox.globalAlpha = 0.2;
          ox.fillStyle = "#000";
          for (let y = 0; y < OH; y += 4) ox.fillRect(0, y, OW, 1.6);
          ox.globalAlpha = 1;
          ox.strokeStyle = "rgba(62,242,165,.25)";
          ox.lineWidth = 2;
          ox.strokeRect(1, 1, OW - 2, OH - 2);
        }
        function oledHeader(label, right) {
          ox.fillStyle = DIM;
          ox.font = '700 26px "Orbitron",sans-serif';
          ox.textAlign = "left";
          ox.fillText(label, 16, 32);
          if (right) {
            ox.textAlign = "right";
            ox.fillText(right, OW - 16, 32);
            ox.textAlign = "left";
          }
          ox.fillStyle = DIM;
          ox.fillRect(16, 40, OW - 32, 2);
        }
        function oledStatus() {
          oledHeader("AQUANOVA", alarm ? "! ALARM" : "OK");
          ox.font = '700 34px "Courier New",monospace';
          ox.textAlign = "left";
          ox.fillStyle = DIM;
          ox.fillText("MOTION", 20, 96);
          ox.fillStyle = pirOut ? HOT : ON;
          ox.textAlign = "right";
          ox.fillText(pirOut ? "DETECTED" : "CLEAR", OW - 20, 96);
          ox.textAlign = "left";
          ox.fillStyle = DIM;
          ox.fillText("WATER", 20, 146);
          ox.fillStyle = waterWet ? WET : ON;
          ox.textAlign = "right";
          ox.fillText(waterWet ? "WET" : "DRY", OW - 20, 146);

          ox.textAlign = "center";
          ox.font = '700 27px "Rajdhani",sans-serif';
          ox.fillStyle = alarm ? BAD : DIM;
          ox.fillText(
            alarm ? alertMessage().head.toUpperCase() : "ZONE SECURE",
            OW / 2,
            196,
          );
          ox.textAlign = "left";
        }
        function oledSensors() {
          oledHeader("SENSORS");
          ox.font = '700 27px "Courier New",monospace';
          ox.fillStyle = DIM;
          ox.fillText("PIR", 20, 86);
          ox.fillStyle = pirOut ? HOT : ON;
          ox.fillText(pirOut ? "HIGH" : "LOW ", 120, 86);
          ox.fillStyle = DIM;
          ox.fillText("HOLD", 300, 86);
          ox.fillStyle = ON;
          ox.fillText(pirHold.toFixed(1) + "s", 420, 86);

          ox.fillStyle = DIM;
          ox.fillText("H2O", 20, 132);
          ox.fillStyle = WET;
          ox.fillText(
            String(Math.round((waterRaw / 100) * MAX_ANALOG)).padStart(4, " "),
            120,
            132,
          );
          ox.fillStyle = DIM;
          ox.fillText("THR", 300, 132);
          ox.fillStyle = ON;
          ox.fillText(
            String(Math.round((waterThr / 100) * MAX_ANALOG)),
            420,
            132,
          );

          // analog bar with the threshold marked on it
          const bx = 20,
            by = 158,
            bw = OW - 40,
            bh = 26;
          ox.fillStyle = "#0e3a29";
          ox.fillRect(bx, by, bw, bh);
          ox.fillStyle = waterWet ? WET : "#1c6f52";
          ox.fillRect(bx, by, bw * clamp(waterRaw / 100, 0, 1), bh);
          ox.fillStyle = BAD;
          ox.fillRect(bx + bw * (waterThr / 100) - 2, by - 4, 4, bh + 8);
          ox.fillStyle = DIM;
          ox.font = '600 21px "Rajdhani",sans-serif';
          ox.fillText("0", bx, by + bh + 20);
          ox.textAlign = "right";
          ox.fillText(String(MAX_ANALOG), bx + bw, by + bh + 20);
          ox.textAlign = "left";
        }
        function oledAlert() {
          oledHeader("ALERT LOG");
          if (!alarm && !feedItems.length) {
            ox.textAlign = "center";
            ox.font = '700 30px "Orbitron",sans-serif';
            ox.fillStyle = DIM;
            ox.fillText("NO ALERTS", OW / 2, 120);
            ox.font = '600 24px "Rajdhani",sans-serif';
            ox.fillText("Station is quiet", OW / 2, 160);
            ox.textAlign = "left";
            return;
          }
          const a = alarm
            ? alertMessage()
            : { icon: "·", head: feedItems[0].head, kind: feedItems[0].kind };
          ox.textAlign = "center";
          ox.font = '800 34px "Orbitron",sans-serif';
          ox.fillStyle = alarm
            ? Math.sin(tNow * 6) > -0.3
              ? BAD
              : "#7a2030"
            : DIM;
          ox.fillText(
            a.kind === "crit"
              ? "CRITICAL"
              : a.kind === "water"
                ? "WATER LEAK"
                : "MOTION",
            OW / 2,
            100,
          );
          ox.font = '700 26px "Rajdhani",sans-serif';
          ox.fillStyle = ON;
          ox.fillText(
            `SENT ${sentCount}   HELD ${throttledCount}`,
            OW / 2,
            148,
          );
          ox.font = '600 24px "Rajdhani",sans-serif';
          ox.fillStyle = DIM;
          ox.fillText(
            cooldown > 0
              ? `Next alert in ${cooldown.toFixed(1)}s`
              : "Ready to send",
            OW / 2,
            190,
          );
          ox.textAlign = "left";
        }
        function oledNet() {
          oledHeader("NETWORK");
          ox.font = '700 27px "Courier New",monospace';
          ox.fillStyle = DIM;
          ox.fillText("BLYNK", 20, 88);
          ox.fillStyle = notifyOn ? ON : BAD;
          ox.textAlign = "right";
          ox.fillText(notifyOn ? "ONLINE" : "MUTED", OW - 20, 88);
          ox.textAlign = "left";
          ox.fillStyle = DIM;
          ox.fillText("MODE", 20, 132);
          ox.fillStyle = ON;
          ox.textAlign = "right";
          ox.fillText(ALERT_TYPES[alertType].label.toUpperCase(), OW - 20, 132);
          ox.textAlign = "left";
          ox.fillStyle = DIM;
          ox.fillText("RULE", 20, 176);
          ox.fillStyle = ON;
          ox.textAlign = "right";
          ox.fillText(CONDITIONS[condition].label.toUpperCase(), OW - 20, 176);
          ox.textAlign = "left";
          ox.font = '600 22px "Rajdhani",sans-serif';
          ox.fillStyle = uplinkFlash > 0 ? ON : DIM;
          ox.fillText(
            uplinkFlash > 0 ? ">> UPLINK SENDING" : "uplink idle",
            20,
            214,
          );
        }

        /* =================== DOM SYNC =================== */
        function setFill(el, pct, color) {
          el.style.width = clamp(pct, 0, 100) + "%";
          if (color) el.style.background = color;
        }
        function rangeFill(el) {
          const p = ((el.value - el.min) / (el.max - el.min)) * 100;
          el.style.setProperty("--fill", p + "%");
        }

        // Fastest thing moving in the habitat right now, for the readout.
        function creatureTopSpeed() {
          let v = 0;
          for (const c of creatures) v = Math.max(v, c.speed);
          return v;
        }

        function updateDOM() {
          // --- hero HUD ---
          const chip = $("hudChip");
          chip.className = "hudchip" + (alarm ? " alarm" : "");
          chip.textContent = alarm ? "ALARM" : "SAFE";
          const mode = $("hudMode");
          mode.className = "hudchip mode" + (patrol ? "" : " manual");
          mode.textContent = patrol ? "PATROL" : "MANUAL";

          const msg = $("hudMsg");
          msg.classList.toggle("alarm", alarm);
          msg.textContent = alarm
            ? alertMessage().msg
            : !creatures.length
              ? "All clear — the habitat is empty."
              : creatureTopSpeed() < 0.5
                ? "All clear — the creatures are present but holding still, so the PIR sees nothing."
                : patrol
                  ? "All clear — patrolling the habitat."
                  : "All clear — you have the wheel.";

          $("lampMotion").className = "bulb" + (pirOut ? " hot" : "");
          $("lampMotionV").textContent = pirOut ? "DETECTED" : "CLEAR";
          $("lampWater").className = "bulb" + (waterWet ? " wet" : "");
          $("lampWaterV").textContent = waterWet ? "WET" : "DRY";

          // --- uplink ---
          $("uplinkTxt").textContent = !notifyOn
            ? "MUTED"
            : uplinkFlash > 0
              ? "SENDING"
              : cooldown > 0
                ? "COOLDOWN"
                : "READY";
          $("uplinkNote").textContent = !notifyOn
            ? "Notifications are switched off."
            : uplinkFlash > 0
              ? "Pushing an alert to the cloud."
              : cooldown > 0
                ? `Rate limited for ${cooldown.toFixed(1)}s.`
                : ALERT_TYPES[alertType].note;

          // --- telemetry ---
          $("waterVal").textContent =
            Math.round((waterRaw / 100) * MAX_ANALOG) +
            "  (" +
            Math.round(waterRaw) +
            "%)";
          setFill($("waterFill"), waterRaw);
          $("waterThr").style.left = waterThr + "%";
          const d = nearestCreatureDist();
          $("distVal").textContent =
            d === null ? "— (habitat empty)" : Math.round(d) + " px";
          $("speedVal").textContent =
            Math.round(creatureTopSpeed()) + " px/s";

          $("statPir").textContent = pirOut
            ? pirRaw
              ? "HIGH"
              : "HOLD"
            : "LOW";
          $("statPir").className = "v " + (pirOut ? "w" : "n");
          $("statHold").textContent = pirHold.toFixed(1) + " s";
          $("statRange").textContent = Math.round(pirRange) + " px";
          $("statPipes").textContent = openPipes() + " / " + pipes.length;
          $("statSent").textContent = sentCount;
          $("statThrottled").textContent = throttledCount;

          // --- dock state that several things can change ---
          syncPipeButtons();
          $("creatureCount").innerHTML =
            "<span>Creatures</span><b>" +
            creatures.length +
            " / " +
            MAX_CREATURES +
            "</b>";
          $("keyLeft").classList.toggle("hot", keysDown.has("left"));
          $("keyRight").classList.toggle("hot", keysDown.has("right"));
          $("driveHint").textContent = patrol
            ? "The rover sweeps the habitat on its own. Press a drive key to take the wheel."
            : "You have the wheel. Press P to hand it back to the auto-sweep.";

          // --- verdict ---
          const v = $("verdictBox");
          if (alarm) {
            v.className = "verdict bad";
            v.innerHTML =
              `<b>${alertMessage().head}</b>. ` +
              (notifyOn
                ? "An alert went out."
                : "But notifications are OFF, so nothing was sent.");
          } else if (pirOut || waterWet) {
            v.className = "verdict warn";
            const which = pirOut ? "motion" : "water";
            v.innerHTML = `The <b>${which}</b> sensor is triggered, but the alert rule is not satisfied — no alarm.`;
          } else if (creatures.length && creatureTopSpeed() < 0.5) {
            v.className = "verdict warn";
            v.innerHTML =
              "Creatures are inside the cone but <b>not moving</b>. A PIR sensor reads change in infrared, so it stays silent.";
          } else if (openPipes() > 0 && !waterWet) {
            v.className = "verdict warn";
            v.innerHTML =
              "Water is on the floor, but the probe is <b>not standing in it</b>. Drive the rover over a puddle to read it.";
          } else {
            v.className = "verdict ok";
            v.textContent = "Both sensors quiet. Nothing to report.";
          }
        }

        /* =================== INTERACTION =================== */
        let dragging = false;
        function zonePos(e) {
          const r = zone.getBoundingClientRect();
          return {
            x: (e.clientX - r.left) * (W / r.width),
            y: (e.clientY - r.top) * (H / r.height),
          };
        }
        // A click up on the ceiling rail belongs to a pipe; anywhere else it is the
        // student grabbing the rover.
        function pipeAt(p) {
          if (p.y > ceilY + 36) return null;
          for (const pipe of pipes)
            if (Math.abs(p.x - pipe.x) < 24) return pipe;
          return null;
        }
        zone.addEventListener("pointerdown", (e) => {
          const p = zonePos(e);
          const pipe = pipeAt(p);
          if (pipe) {
            pipe.on = !pipe.on;
            refreshPipeHint();
            return;
          }
          dragging = true;
          zone.classList.add("drag");
          zone.setPointerCapture(e.pointerId);
          moveRover(p.x);
        });
        zone.addEventListener("pointermove", (e) => {
          if (dragging) moveRover(zonePos(e).x);
        });
        zone.addEventListener("pointerup", () => {
          dragging = false;
          zone.classList.remove("drag");
        });
        zone.addEventListener("pointercancel", () => {
          dragging = false;
          zone.classList.remove("drag");
        });
        function moveRover(x) {
          const nx = clamp(x, edgeX(), W - edgeX());
          if (Math.abs(nx - rover.x) > 0.6)
            rover.dir = Math.sign(nx - rover.x) || rover.dir;
          rover.x = nx;
        }

        /* --------- keyboard: hold to drive, P to hand back the wheel --------- */
        const DRIVE_KEYS = {
          ArrowLeft: "left",
          ArrowRight: "right",
          a: "left",
          A: "left",
          d: "right",
          D: "right",
        };
        // Typing in a slider or activating a button must keep working normally.
        const inControl = (t) =>
          t &&
          (t.tagName === "INPUT" ||
            t.tagName === "TEXTAREA" ||
            t.tagName === "SELECT");

        window.addEventListener("keydown", (e) => {
          if (inControl(e.target)) return;
          const dir = DRIVE_KEYS[e.key];
          if (dir) {
            e.preventDefault();
            keysDown.add(dir);
            if (patrol) setPatrol(false); // taking the wheel drops the auto-sweep
            return;
          }
          const k = e.key.toLowerCase();
          if (k === "p") {
            e.preventDefault();
            setPatrol(!patrol);
            return;
          }
          if (e.key === " " && e.target.tagName !== "BUTTON") {
            e.preventDefault();
            setPaused(!paused);
          }
        });
        window.addEventListener("keyup", (e) => {
          const dir = DRIVE_KEYS[e.key];
          if (dir) keysDown.delete(dir);
        });
        // A key held while the tab loses focus would otherwise stay stuck down.
        window.addEventListener("blur", () => keysDown.clear());

        /* --------- dock wiring --------- */
        function bindRange(id, valId, fn, fmt) {
          const el = $(id);
          el.addEventListener("input", (e) => {
            rangeFill(el);
            fn(+el.value);
            $(valId).textContent = fmt ? fmt(+el.value) : el.value;
          });
        }
        bindRange("r_move", "v_move", (v) => (moveLevel = v));
        bindRange(
          "r_leak",
          "v_leak",
          (v) => {
            leakLevel = v;
            refreshPipeHint();
          },
          (v) => v + "%",
        );
        bindRange(
          "r_pir",
          "v_pir",
          (v) => (pirSens = v),
          (v) => v + "%",
        );
        bindRange(
          "r_thr",
          "v_thr",
          (v) => (waterThr = v),
          (v) => v + "%",
        );

        function segBind(id, attr, onPick) {
          const box = $(id);
          box.addEventListener("click", (e) => {
            const b = e.target.closest("button");
            if (!b) return;
            [...box.children].forEach((c) => c.classList.remove("on"));
            b.classList.add("on");
            onPick(b.dataset[attr]);
          });
        }
        segBind("segOled", "oled", (k) => (oledMode = k));

        // One button per pipe, built from the model so the two can never drift apart.
        function buildPipeButtons() {
          const grid = $("pipeGrid");
          grid.innerHTML = "";
          pipes.forEach((p, idx) => {
            const b = document.createElement("button");
            b.type = "button";
            b.className = "pipebtn";
            b.dataset.pipe = idx;
            b.innerHTML = p.label + "<small>sealed</small>";
            b.addEventListener("click", () => {
              p.on = !p.on;
              refreshPipeHint();
            });
            grid.appendChild(b);
          });
        }
        function syncPipeButtons() {
          const kids = $("pipeGrid").children;
          for (let i = 0; i < kids.length; i++) {
            const p = pipes[i];
            kids[i].classList.toggle("on", p.on);
            const tag = p.on ? (leakLevel > 0 ? "leaking" : "open") : "sealed";
            const small = kids[i].querySelector("small");
            if (small.textContent !== tag) small.textContent = tag;
          }
        }
        function refreshPipeHint() {
          const n = openPipes();
          $("pipeHint").innerHTML =
            n === 0
              ? "All four pipes are sealed. Open one — or click it on the ceiling."
              : leakLevel === 0
                ? `<b>${n}</b> pipe${n > 1 ? "s" : ""} open, but the drip rate is 0 — nothing is coming out yet.`
                : `<b>${n}</b> of ${pipes.length} pipes leaking. Each grows its own puddle.`;
        }

        function toggleBind(id, get, set, onTxt, offTxt) {
          $(id).addEventListener("click", (e) => {
            set(!get());
            e.currentTarget.classList.toggle("on", get());
            e.currentTarget.textContent = get() ? onTxt : offTxt;
          });
        }
        // Patrol is switched from three places (button, P key, driving away), so it
        // gets one setter that also repaints the button.
        function setPatrol(v) {
          patrol = v;
          const b = $("patrolBtn");
          b.classList.toggle("on", patrol);
          b.textContent = patrol ? "▶ Patrol Mode" : "⏹ Manual Drive";
        }
        $("patrolBtn").addEventListener("click", () => setPatrol(!patrol));
        toggleBind(
          "oledBtn",
          () => oledOn,
          (v) => (oledOn = v),
          "🖥 Display ON",
          "🌑 Display OFF",
        );

        $("addCreatureBtn").addEventListener("click", () => addCreature());
        $("clearCreatureBtn").addEventListener("click", clearCreatures);

        function setPaused(v) {
          paused = v;
          const b = $("pauseBtn");
          b.classList.toggle("on", paused);
          b.textContent = paused ? "▶ Resume" : "⏸ Pause";
        }
        $("pauseBtn").addEventListener("click", () => setPaused(!paused));
        $("resetBtn").addEventListener("click", resetAll);

        function resetAll() {
          moveLevel = 55;
          leakLevel = 0;
          pirSens = 55;
          waterThr = 30;
          oledOn = true;
          oledMode = "status";
          notifyOn = true;
          alertType = "push";
          condition = "either";

          rover = { x: W * 0.55, dir: 1 };
          keysDown.clear();
          for (const p of pipes) {
            p.on = false;
            p.t = 0;
            p.vol = 0;
            p.cx = p.x;
          }
          seedScenery();
          creatures = [newCreature(W * 0.22)];
          drops = [];
          ripples = [];
          pirRaw = false;
          pirOut = false;
          pirHold = 0;
          waterRaw = 0;
          waterWet = false;
          splashBoost = 0;
          alarm = false;
          prevAlarm = false;
          cooldown = 0;
          sentCount = 0;
          throttledCount = 0;
          uptime = 0;
          uplinkFlash = 0;
          feedItems = [];

          $("r_move").value = 55;
          $("v_move").textContent = "55";
          $("r_leak").value = 0;
          $("v_leak").textContent = "0%";
          $("r_pir").value = 55;
          $("v_pir").textContent = "55%";
          $("r_thr").value = 30;
          $("v_thr").textContent = "30%";
          ["r_move", "r_leak", "r_pir", "r_thr"].forEach((id) =>
            rangeFill($(id)),
          );
          [...$("segOled").children].forEach((b) =>
            b.classList.toggle("on", b.dataset.oled === "status"),
          );
          $("oledBtn").classList.add("on");
          $("oledBtn").textContent = "🖥 Display ON";
          setPatrol(true);
          setPaused(false);
          refreshPipeHint();
          layout();
        }

        /* help tabs */
        const helpbar = $("helpbar");
        document.querySelectorAll(".helpbtn").forEach((btn) => {
          btn.addEventListener("click", () => {
            const tab = btn.dataset.tab,
              already = btn.classList.contains("on");
            document
              .querySelectorAll(".helpbtn")
              .forEach((b) => b.classList.remove("on"));
            document
              .querySelectorAll(".tabpanel")
              .forEach((p) => p.classList.remove("on"));
            if (already) {
              helpbar.classList.remove("show");
              return;
            }
            btn.classList.add("on");
            document
              .querySelector(`.tabpanel[data-panel="${tab}"]`)
              .classList.add("on");
            helpbar.classList.add("show");
          });
        });

        /* =================== LOOP =================== */
        let last = performance.now();
        function loop(now) {
          let dt = (now - last) / 1000;
          last = now;
          dt = Math.min(dt, 0.05); // a backgrounded tab must not fast-forward
          if (!paused) {
            tNow += dt;
            step(dt);
          }
          drawZone();
          drawOled();
          updateDOM();
          requestAnimationFrame(loop);
        }

        /* =================== BOOT =================== */
        layout();
        seedScenery();
        refit();
        if (typeof ResizeObserver !== "undefined") {
          // refit() resizes the very canvases being observed, so it has to run
          // outside the observation callback or the browser reports an
          // undelivered-notification loop.
          let refitQueued = false;
          const ro = new ResizeObserver(() => {
            if (refitQueued) return;
            refitQueued = true;
            requestAnimationFrame(() => {
              refitQueued = false;
              refit();
            });
          });
          ro.observe(zone);
          ro.observe(oled);
        }
        window.addEventListener("resize", refit);
        rover.x = W * 0.55;
        creatures = [newCreature(W * 0.22)];
        layout(); // pipes need the real width before anything is drawn
        buildPipeButtons();
        refreshPipeHint();
        ["r_move", "r_leak", "r_pir", "r_thr"].forEach((id) =>
          rangeFill($(id)),
        );
        requestAnimationFrame(loop);
      })();
    </script>
  </body>
</html>
