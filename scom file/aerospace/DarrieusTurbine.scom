<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Darrieus Turbine · Wind to Watts</title>
    <link rel="icon" type="image/png" href="../../../assets/logo.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Orbitron:wght@600;700;800&family=Rajdhani:wght@400;500;600;700&family=IBM+Plex+Mono:wght@500;600&display=swap"
      rel="stylesheet"
    />
    <style>
      :root {
        --bg: #eef1f4;
        --panel: #fcfdfe;
        --panel2: #f3f6f8;
        --line: #dbe2e8;
        --txt: #17293b;
        --mut: #4c5c6b;
        --dim: #8a949d;
        --accent: #e8590c;
        --accent-press: #c94a08;
        --sky: #2a78d6;
        --sky-soft: #e3eefb;
        --volt: #fab219;
        --curr: #2a78d6;
        --warn: #fab219;
        --danger: #d03b3b;
        --ok: #0ca30c;
        --ok-ink: #006300;
        --shadow: 0 1px 2px rgba(23, 41, 59, 0.08);
        --r: 10px;
        --head: "Orbitron", sans-serif;
        --body: "Rajdhani", sans-serif;
        --mono: "IBM Plex Mono", Consolas, monospace;
      }
      * {
        box-sizing: border-box;
      }
      html,
      body {
        margin: 0;
        height: 100%;
      }
      body {
        font-family: var(--body);
        font-size: 15px;
        font-weight: 500;
        color: var(--txt);
        background: var(--bg);
        height: 100vh;
        overflow: hidden;
        padding: 12px clamp(12px, 2.4vw, 30px);
        display: flex;
        flex-direction: column;
      }
      h1,
      h3,
      .badge {
        font-family: var(--head);
      }
      header.top {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 12px;
        flex-wrap: wrap;
        margin-bottom: 10px;
        flex: 0 0 auto;
      }
      .logo {
        font-size: 26px;
        line-height: 1;
      }
      .title h1 {
        margin: 0;
        font-size: 24px;
        font-weight: 700;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        color: var(--txt);
      }
      .grid {
        display: grid;
        grid-template-columns: 290px 1fr 300px;
        gap: 14px;
        align-items: stretch;
        flex: 1 1 auto;
        min-height: 0;
      }
      @media (max-width: 1180px) {
        body {
          overflow: auto;
          height: auto;
        }
        .grid {
          grid-template-columns: 1fr;
          flex: 0 0 auto;
        }
        .card.controls,
        .card.readings {
          width: 100%;
        }
        /* Single-column: the stage card is no longer height-bounded by the grid
           row, and its canvas is width:100%/height:100% — without an explicit
           height here the canvas collapses to 0px tall on mobile. */
        .card.stage {
          width: 100%;
          flex: 0 0 auto;
          height: clamp(280px, 78vw, 460px);
        }
      }
      .card {
        background: var(--panel);
        border: 1px solid var(--line);
        border-radius: var(--r);
        box-shadow: var(--shadow);
        padding: 16px;
        overflow-y: auto;
        overflow-x: hidden;
        min-height: 0;
      }
      .card.stage {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        overflow: hidden;
      }
      .card.stage canvas {
        flex: 1 1 auto;
        min-height: 0;
        display: block;
        width: 100%;
        height: 100%;
      }
      .card h3 {
        margin: 0 0 3px;
        font-size: 12px;
        font-weight: 600;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--mut);
      }
      .card .sub {
        font-size: 12.5px;
        color: var(--mut);
        margin: 0 0 10px;
        line-height: 1.45;
      }

      .ctrl {
        margin: 14px 0;
      }
      .ctrl .row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 5px;
      }
      .ctrl label {
        font-size: 13.5px;
        font-weight: 600;
        color: var(--txt);
      }
      .ctrl .val {
        font-family: var(--head);
        font-size: 12px;
        color: var(--accent);
        font-weight: 700;
      }

      .toggle {
        display: flex;
        gap: 8px;
        margin-top: 5px;
      }
      .toggle button {
        flex: 1;
        cursor: pointer;
        border: 1px solid var(--line);
        background: var(--panel);
        color: var(--mut);
        padding: 8px 6px;
        border-radius: 8px;
        font-size: 12.5px;
        font-weight: 600;
        transition: 0.15s;
        font-family: var(--body);
      }
      .toggle button:hover {
        border-color: var(--dim);
        color: var(--txt);
      }
      .toggle button.on {
        color: var(--txt);
        border-color: var(--sky);
        background: var(--sky-soft);
        font-weight: 700;
      }
      .hint {
        font-size: 11.5px;
        color: var(--dim);
        margin-top: 6px;
        line-height: 1.4;
      }

      .fixedchip {
        display: inline-block;
        padding: 8px 12px;
        border-radius: 8px;
        font-size: 12.5px;
        font-weight: 700;
        background: var(--sky-soft);
        color: var(--sky);
        border: 1px solid var(--line);
        margin-top: 5px;
      }

      .stage-foot {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
        margin-top: 12px;
        justify-content: center;
        flex: 0 0 auto;
      }
      .btn {
        cursor: pointer;
        border: 1px solid var(--line);
        background: var(--panel);
        color: var(--txt);
        padding: 10px 16px;
        border-radius: 8px;
        font-size: 12.5px;
        font-weight: 700;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        transition: 0.15s;
        font-family: var(--head);
        display: flex;
        gap: 7px;
        align-items: center;
      }
      .btn:hover {
        border-color: var(--dim);
      }
      .btn.start {
        background: var(--accent);
        border-color: var(--accent);
        color: #fff;
      }
      .btn.start:hover {
        background: var(--accent-press);
        border-color: var(--accent-press);
      }
      .btn.start.on {
        background: var(--ok);
        border-color: var(--ok);
        color: #fff;
      }
      .btn.reset {
        background: var(--panel);
        border-color: var(--line);
        color: var(--mut);
      }

      canvas {
        width: 100%;
        height: 100%;
        aspect-ratio: 640 / 520;
        object-fit: contain;
        display: block;
        border-radius: 8px;
        background: var(--panel2);
      }
      .modechip {
        display: inline-block;
        margin-top: 10px;
        padding: 6px 14px;
        border-radius: 8px;
        font-family: var(--mono);
        font-size: 11px;
        font-weight: 500;
        letter-spacing: 0.03em;
        background: var(--panel2);
        color: var(--mut);
        border: 1px solid var(--line);
      }
      .modechip.run {
        background: #e9f7e9;
        color: var(--ok-ink);
        border-color: #bfe3bb;
      }

      .reading {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 9px 0;
        border-bottom: 1px solid var(--line);
      }
      .reading:last-child {
        border-bottom: none;
      }
      .reading .k {
        font-size: 13px;
        color: var(--mut);
      }
      .reading .v {
        font-family: var(--mono);
        font-size: 14px;
        font-weight: 600;
        color: var(--txt);
      }
      .reading .v small {
        font-family: var(--body);
        font-weight: 600;
        color: var(--mut);
        font-size: 10.5px;
        margin-left: 5px;
      }

      .meter {
        height: 10px;
        border-radius: 5px;
        background: var(--panel2);
        position: relative;
        overflow: hidden;
        margin: 6px 0 4px;
        border: 1px solid var(--line);
      }
      .meter .fill {
        position: absolute;
        inset: 0 auto 0 0;
        width: 0;
        border-radius: 5px;
        transition:
          width 0.15s,
          background 0.25s;
      }
      .meterlabels {
        display: flex;
        justify-content: space-between;
        font-size: 10px;
        color: var(--dim);
        margin-bottom: 10px;
      }

      .badge {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 10px;
        border-radius: 8px;
        font-size: 13.5px;
        font-weight: 700;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        justify-content: center;
        margin-top: 4px;
        transition: 0.2s;
      }
      .b-off {
        background: var(--panel2);
        color: var(--dim);
        border: 1px solid var(--line);
      }
      .b-on {
        background: #e9f7e9;
        color: var(--ok-ink);
        border: 1px solid #bfe3bb;
      }
      /* An LED does not charge — it just glows, so its three states escalate
         through the amber the lamp itself is drawn in rather than the green
         used for a device that is filling up. */
      .b-dim {
        background: #fdf6e8;
        color: #9a7008;
        border: 1px solid #f2e0b8;
      }
      .b-lit {
        background: #fdeecb;
        color: #7d5a04;
        border: 1px solid #e9cd8a;
      }
      .b-bright {
        background: var(--volt);
        color: #3d2c00;
        border: 1px solid #d99a0a;
      }
      .devnote {
        font-size: 11.5px;
        color: var(--mut);
        text-align: center;
        margin-top: 6px;
        line-height: 1.4;
        min-height: 32px;
      }

      .flow {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-top: 14px;
        padding: 12px 8px;
        border-radius: 8px;
        background: var(--panel2);
        border: 1px solid var(--line);
      }
      .flow .node {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 4px;
        flex: 1;
        opacity: 0.4;
        transition: 0.25s;
      }
      .flow .node.hot {
        opacity: 1;
      }
      .flow .node .ic {
        font-size: 19px;
      }
      .flow .node .lb {
        font-size: 9px;
        font-weight: 700;
        letter-spacing: 0.3px;
        color: var(--mut);
        text-transform: uppercase;
      }
      .flow .arrow {
        color: var(--dim);
        font-size: 13px;
        flex: 0 0 auto;
        transition: 0.25s;
      }
      .flow .arrow.hot {
        color: var(--accent);
      }

      .sect {
        margin-top: 14px;
        padding-top: 12px;
        border-top: 1px solid var(--line);
      }
      .sect-label {
        display: block;
        font-size: 13.5px;
        font-weight: 600;
        color: var(--txt);
        margin-bottom: 8px;
      }

      .helpwrap {
        position: fixed;
        top: 14px;
        right: clamp(12px, 2.4vw, 30px);
        z-index: 40;
        display: flex;
        flex-direction: column;
        align-items: center;
      }
      .helpbtns {
        display: flex;
        gap: 8px;
        justify-content: center;
        flex-wrap: wrap;
      }
      .helpbtn {
        appearance: none;
        cursor: pointer;
        font-family: var(--head);
        font-weight: 700;
        font-size: 12px;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: #fff;
        background: var(--sky);
        border: 1px solid var(--sky);
        border-radius: 8px;
        padding: 8px 14px;
        box-shadow: 0 6px 14px rgba(42, 120, 214, 0.24);
        transition:
          transform 0.15s ease,
          background 0.15s ease;
      }
      .helpbtn:hover {
        transform: translateY(-1px);
      }
      .helpbtn:focus-visible {
        outline: 2px solid var(--txt);
        outline-offset: 2px;
      }
      .helpbtn.on {
        background: var(--accent);
        border-color: var(--accent);
        box-shadow: 0 6px 14px rgba(232, 89, 12, 0.26);
      }
      .helpbar {
        display: none;
        margin-top: 8px;
        width: 380px;
        max-width: min(380px, 88vw);
        max-height: 72vh;
        overflow-y: auto;
        background: var(--panel);
        border: 1px solid var(--line);
        border-radius: var(--r);
        box-shadow: 0 14px 30px rgba(23, 41, 59, 0.16);
        padding: 14px 16px;
        font-size: 13.5px;
        line-height: 1.5;
        color: var(--txt);
      }
      .helpbar.show {
        display: block;
      }
      .tabpanel {
        display: none;
      }
      .tabpanel.on {
        display: block;
      }
      .tabpanel ol,
      .tabpanel ul {
        margin: 0;
        padding-left: 20px;
      }
      .tabpanel li {
        margin-bottom: 6px;
      }
      .tabpanel li:last-child {
        margin-bottom: 0;
      }
      .tabpanel b {
        color: var(--sky);
      }
      @media (max-width: 900px) {
        .helpwrap {
          position: static;
          align-items: stretch;
          margin-bottom: 10px;
          flex: 0 0 auto;
        }
        .helpbar {
          width: 100%;
          max-width: none;
        }
      }
      @media (prefers-reduced-motion: reduce) {
        .helpbtn {
          transition: none;
        }
      }
    </style>
  </head>
  <body>
    <div class="helpwrap">
      <div class="helpbtns">
        <button type="button" class="helpbtn" data-tab="use">How To Use</button>
        <button type="button" class="helpbtn" data-tab="learn">
          What You'll Learn
        </button>
      </div>
      <div class="helpbar" id="helpbar">
        <div class="tabpanel" data-panel="use">
          <ol>
            <li>
              Pick a <b>Blower / Wind Speed</b> — Low, Medium or High. Nothing
              spins until you choose one.
            </li>
            <li>
              Choose the <b>Number of Blades</b> — 2, 3 or 4 — and read the note
              under it.
            </li>
            <li>
              Pick a <b>Load Device</b> — LED, Battery or Small Gadget — for the
              generator to power.
            </li>
            <li>Press <b>Start</b> and watch the rotor spin up.</li>
            <li>
              Read <b>Live Readings</b> — turbine RPM, generator voltage, load
              current, and how the device is doing: an LED reports Off, Dim, On
              or Bright, while a battery or gadget reports its charging status.
            </li>
            <li>
              Watch the <b>Energy Flow</b> strip light up: wind → turbine →
              generator → device.
            </li>
            <li>
              Count the <b>cuts</b> across the rotor to read the blade setting —
              3 blades is one body cut twice. The <b>Top View</b> inset shows the
              curved cross-section those blades are built from.
            </li>
            <li>
              Press <b>Reset</b>, change <b>one</b> setting, and run again to
              compare.
            </li>
          </ol>
        </div>
        <div class="tabpanel" data-panel="learn">
          <ul>
            <li>
              Why a curved Darrieus rotor turns the same way whatever direction
              the wind comes from
            </li>
            <li>How wind speed sets turbine RPM, and RPM sets voltage</li>
            <li>
              Why twisting the blades into a helix spreads the pull evenly over
              the turn instead of letting it arrive in jolts
            </li>
            <li>
              Why fewer blades spin faster but start harder, while more blades
              start easier and run smoother
            </li>
            <li>
              Why every device needs a minimum voltage before any current flows
            </li>
            <li>How a heavier load drags on the shaft and slows the rotor</li>
            <li>
              Why current, not voltage alone, decides how fast a battery charges
            </li>
            <li>How energy changes form at each step of the chain</li>
            <li>How to test a design by changing one variable at a time</li>
          </ul>
        </div>
      </div>
    </div>

    <header class="top">
      <div class="logo">🌀</div>
      <div class="title">
        <h1>DARRIEUS TURBINE</h1>
      </div>
    </header>

    <div class="grid">
      <section class="card controls">
        <h3>Turbine Bench</h3>
        <p class="sub">
          Choose the wind speed and turbine settings, then press Start to begin
          the test.
        </p>

        <div class="ctrl">
          <div class="row">
            <label>Blower / Wind Speed</label
            ><span class="val" id="windVal">Off</span>
          </div>
          <div class="toggle wind" id="windToggle">
            <button data-v="low">Low</button>
            <button data-v="medium">Medium</button>
            <button data-v="high">High</button>
          </div>
          <p class="hint">
            Turns the mini blower on and sets how hard the air hits the blades.
            No speed selected = no wind.
          </p>
        </div>

        <div class="ctrl">
          <div class="row"><label>Rotor Type</label></div>
          <div class="fixedchip">🌀 Helical Darrieus Blades</div>
          <p class="hint">
            Twisted blades wrap around the shaft, so some part of every blade is
            always facing the wind — from any direction, with an even pull.
          </p>
        </div>

        <div class="ctrl">
          <div class="row">
            <label>Number of Blades</label
            ><span class="val" id="bladeVal">3</span>
          </div>
          <div class="toggle blade" id="bladeToggle">
            <button data-v="2">2</button>
            <button data-v="3">3</button>
            <button data-v="4">4</button>
          </div>
          <p class="hint" id="bladeNote">
            Balanced speed with a much smoother pull.
          </p>
        </div>

        <div class="ctrl">
          <div class="row"><label>Load Device</label></div>
          <div class="toggle device" id="loadToggle">
            <button data-v="led">LED</button>
            <button data-v="battery">Battery</button>
            <button data-v="gadget">Gadget</button>
          </div>
          <p class="hint">
            What the generator is powering. Bigger devices need more voltage
            before they'll draw current.
          </p>
        </div>

        <div class="stage-foot">
          <button class="btn start" id="startBtn">▶ Start</button>
          <button class="btn reset" id="resetBtn">↺ Reset</button>
        </div>
        <p class="hint" id="statusHint" style="margin-top: 10px">
          Pick a wind speed, then press Start.
        </p>
      </section>

      <section class="card stage">
        <canvas id="stage" width="640" height="520"></canvas>
        <span class="modechip" id="modeChip">Idle — blower off</span>
      </section>

      <section class="card readings">
        <h3>Live Readings</h3>
        <p class="sub">What the turbine and generator are doing right now.</p>

        <div class="reading">
          <span class="k">Turbine RPM</span
          ><span class="v" id="rpmVal">0 <small>Stopped</small></span>
        </div>
        <div class="reading">
          <span class="k">Generator Voltage</span
          ><span class="v" id="voltVal">0.0 V <small>—</small></span>
        </div>
        <div class="meter">
          <div class="fill" id="voltFill" style="background: var(--volt)"></div>
        </div>
        <div class="meterlabels">
          <span>0V</span><span>7V</span><span>14V+</span>
        </div>

        <div class="reading">
          <span class="k">Load Current</span
          ><span class="v" id="currVal">0.00 A</span>
        </div>
        <div class="meter">
          <div class="fill" id="currFill" style="background: var(--curr)"></div>
        </div>
        <div class="meterlabels">
          <span>0A</span><span>1.5A</span><span>3A+</span>
        </div>

        <div class="sect">
          <label class="sect-label" id="statusLabel">LED Status</label>
          <div class="badge b-off" id="chargeBadge">LED Off</div>
          <p class="devnote" id="devNote">
            Select a wind speed and press Start.
          </p>
        </div>

        <div class="sect">
          <label class="sect-label">Energy Flow</label>
          <div class="flow" id="flowRow">
            <div class="node" data-n="wind">
              <span class="ic">💨</span><span class="lb">Wind</span>
            </div>
            <span class="arrow">→</span>
            <div class="node" data-n="turbine">
              <span class="ic">🌀</span><span class="lb">Turbine</span>
            </div>
            <span class="arrow">→</span>
            <div class="node" data-n="gen">
              <span class="ic">⚡</span><span class="lb">Generator</span>
            </div>
            <span class="arrow">→</span>
            <div class="node" data-n="dev">
              <span class="ic">🔋</span><span class="lb">Device</span>
            </div>
          </div>
        </div>
      </section>
    </div>

    <script>
      (function () {
        var bar = document.getElementById("helpbar");
        var btns = document.querySelectorAll(".helpbtn");
        var panels = document.querySelectorAll(".tabpanel");
        function closeAll() {
          bar.classList.remove("show");
          btns.forEach(function (b) {
            b.classList.remove("on");
          });
          panels.forEach(function (p) {
            p.classList.remove("on");
          });
        }
        btns.forEach(function (btn) {
          btn.addEventListener("click", function () {
            var already = btn.classList.contains("on");
            closeAll();
            if (already) return;
            btn.classList.add("on");
            document
              .querySelector('.tabpanel[data-panel="' + btn.dataset.tab + '"]')
              .classList.add("on");
            bar.classList.add("show");
          });
        });
        document.addEventListener("keydown", function (e) {
          if (e.key === "Escape" && bar.classList.contains("show")) closeAll();
        });
      })();
    </script>

    <script>
      (() => {
        "use strict";

        // Tuned for a slow, high-torque helical rotor: lower RPM than a straight
        // -bladed rotor of the same size, but enough pull to spin up on Low wind.
        const WIND = {
          off: { label: "Off", base: 0 },
          low: { label: "Low", base: 110 },
          medium: { label: "Medium", base: 260 },
          high: { label: "High", base: 450 },
        };
        const BLADE_MOD = {
          2: {
            speed: 1.08,
            note: "Fastest spin, but the pull arrives in pulses.",
          },
          3: {
            speed: 1.0,
            note: "Balanced speed with a much smoother pull.",
          },
          4: {
            speed: 0.93,
            note: "Slowest, steadiest, easiest to get turning.",
          },
        };
        const DEVICES = {
          led: { label: "LED", minV: 2.5, draw: 0.03, iFactor: 0.05 },
          battery: { label: "Battery", minV: 5.0, draw: 0.1, iFactor: 0.15 },
          gadget: {
            label: "Small Gadget",
            minV: 7.0,
            draw: 0.18,
            iFactor: 0.22,
          },
        };
        // A slow, high-torque rotor is geared up (or wound with more poles) to
        // reach a useful voltage, so each RPM buys more volts than on a fast rotor.
        const K_V = 0.029; // volts generated per RPM of the shaft

        const S = {
          wind: "off",
          blades: 3,
          device: "led",
          running: false,
          rpm: 0,
          targetRpm: 0,
          // An off-axis start angle keeps the idle rotor from resting in a
          // symmetric pose where the blades read as a flat, ambiguous outline.
          angle: 20,
          voltage: 0,
          current: 0,
          charging: false,
          chargePct: 0,
          ledBrightness: 0,
          fanAngle: 0,
          fanSpin: 0, // deg/sec — only leaves 0 once Start is pressed
          wireFlow: 0,
          particles: [],
        };

        /* ---------- controls ---------- */
        function wireToggle(id, onPick) {
          const el = document.getElementById(id);
          el.querySelectorAll("button").forEach((b) => {
            b.addEventListener("click", () => {
              el.querySelectorAll("button").forEach((x) =>
                x.classList.remove("on"),
              );
              b.classList.add("on");
              onPick(b.dataset.v);
            });
          });
        }
        wireToggle("windToggle", (v) => {
          S.wind = v;
          document.getElementById("windVal").textContent = WIND[v].label;
        });
        wireToggle("bladeToggle", (v) => {
          S.blades = Number(v);
          document.getElementById("bladeVal").textContent = v;
          document.getElementById("bladeNote").textContent = BLADE_MOD[v].note;
        });
        wireToggle("loadToggle", (v) => {
          S.device = v;
          S.chargePct = 0;
          S.ledBrightness = 0;
          document
            .querySelectorAll("#loadToggle button")
            .forEach((b) => b.classList.toggle("on", b.dataset.v === v));
        });
        document
          .querySelector('#bladeToggle button[data-v="3"]')
          .classList.add("on");
        document
          .querySelector('#loadToggle button[data-v="led"]')
          .classList.add("on");

        const startBtn = document.getElementById("startBtn");
        startBtn.addEventListener("click", () => {
          S.running = !S.running;
          startBtn.classList.toggle("on", S.running);
          startBtn.textContent = S.running ? "⏹ Stop" : "▶ Start";
        });
        document.getElementById("resetBtn").addEventListener("click", () => {
          S.running = false;
          S.rpm = 0;
          S.targetRpm = 0;
          S.voltage = 0;
          S.current = 0;
          S.charging = false;
          S.chargePct = 0;
          S.ledBrightness = 0;
          S.fanSpin = 0;
          S.particles = [];
          startBtn.classList.remove("on");
          startBtn.textContent = "▶ Start";
        });

        /* ---------- physics ---------- */
        function computeTargetRpm() {
          if (!S.running || S.wind === "off") return 0;
          const base = WIND[S.wind].base * BLADE_MOD[S.blades].speed;
          // load only drags the shaft once the generator is actually delivering power to the device
          const dev = DEVICES[S.device];
          const loadFactor = S.voltage >= dev.minV ? 1 - dev.draw : 1;
          return base * loadFactor;
        }

        function rpmWord(r) {
          if (r < 1) return "Stopped";
          if (r < 150) return "Slow";
          if (r < 330) return "Medium";
          return "Fast";
        }
        // An LED does not fill up like a battery, so it reports how hard it is
        // glowing instead of a charge state. The 5V and 10V cuts sit in the gaps
        // between the low, medium and high wind bands at every blade count, so
        // each wind speed lands on its own rung while blade count still counts.
        function ledState(v) {
          if (v < DEVICES.led.minV)
            return {
              text: "LED Off",
              cls: "b-off",
              note: "Not enough voltage to light the LED yet (needs 2.5V+). Try more wind, fewer blades, or a lighter load.",
            };
          if (v < 5)
            return {
              text: "LED Dim",
              cls: "b-dim",
              note: "Low wind produces slow rotation and low power, so the LED glows dimly.",
            };
          if (v < 10)
            return {
              text: "LED On",
              cls: "b-lit",
              note: "Medium wind produces enough voltage to power the LED steadily.",
            };
          return {
            text: "LED Bright",
            cls: "b-bright",
            note: "High wind produces faster rotation and higher voltage, so the LED glows brightly.",
          };
        }

        function voltWord(v) {
          if (v < 0.2) return "—";
          if (v < 4) return "Low";
          if (v < 9) return "Medium";
          return "High";
        }

        function update(dt) {
          S.targetRpm = computeTargetRpm();
          const smooth = 1 - Math.exp(-dt * 2.2);
          S.rpm += (S.targetRpm - S.rpm) * smooth;
          if (Math.abs(S.rpm) < 0.5) S.rpm = 0;
          S.angle = (S.angle + (S.rpm / 60) * 360 * dt) % 360;

          S.voltage = S.rpm * K_V;
          const dev = DEVICES[S.device];
          S.charging = S.running && S.wind !== "off" && S.voltage >= dev.minV;
          S.current = S.voltage > 0.05 ? S.voltage * dev.iFactor : 0;

          if (S.charging) {
            if (S.device === "battery" || S.device === "gadget") {
              S.chargePct = Math.min(100, S.chargePct + S.current * dt * 6);
            } else {
              // The lamp has to visibly match the Dim / On / Bright readout, so
              // it tracks voltage rather than snapping to full the moment it lights.
              const over = (S.voltage - dev.minV) / 9.5;
              const target = 0.3 + 0.7 * Math.min(1, Math.max(0, over));
              S.ledBrightness += (target - S.ledBrightness) * Math.min(1, dt * 3);
            }
          } else if (S.device === "led") {
            S.ledBrightness += (0 - S.ledBrightness) * Math.min(1, dt * 3);
          }

          // Picking a wind speed only arms the blower; it spins up on Start and
          // coasts back down on Stop, the same way the rotor eases into its RPM.
          const fanTarget =
            S.running && S.wind !== "off" ? WIND[S.wind].base * 0.6 : 0;
          S.fanSpin += (fanTarget - S.fanSpin) * smooth;
          if (Math.abs(S.fanSpin) < 0.5) S.fanSpin = 0;
          S.fanAngle = (S.fanAngle + S.fanSpin * dt) % 360;
          if (S.running && S.wind !== "off")
            S.wireFlow = (S.wireFlow + S.current * dt * 60) % 40;

          updateParticles(dt);
          updateUI();
        }

        function updateParticles(dt) {
          const level = WIND[S.wind];
          if (S.running && level.base > 0) {
            const spawnRate = level.base / 155; // particles/sec-ish
            S._spawnAcc = (S._spawnAcc || 0) + spawnRate * dt;
            while (S._spawnAcc >= 1) {
              S._spawnAcc -= 1;
              S.particles.push({
                x: JET_X,
                y: JET_TOP + Math.random() * JET_BAND,
                v: 90 + level.base * 0.42 + Math.random() * 30,
              });
            }
          }
          S.particles.forEach((p) => (p.x += p.v * dt));
          S.particles = S.particles.filter(
            (p) => p.x < JET_END && S.particles.indexOf(p) < 60,
          );
        }

        /* ---------- readouts ---------- */
        function updateUI() {
          document.getElementById("rpmVal").innerHTML =
            `${Math.round(S.rpm)} <small>${rpmWord(S.rpm)}</small>`;
          document.getElementById("voltVal").innerHTML =
            `${S.voltage.toFixed(1)} V <small>${voltWord(S.voltage)}</small>`;
          document.getElementById("voltFill").style.width =
            `${Math.min(100, (S.voltage / 14) * 100)}%`;
          document.getElementById("currVal").textContent =
            `${S.current.toFixed(2)} A`;
          document.getElementById("currFill").style.width =
            `${Math.min(100, (S.current / 3) * 100)}%`;

          const dev = DEVICES[S.device];
          const isLed = S.device === "led";
          const led = isLed ? ledState(S.voltage) : null;
          document.getElementById("statusLabel").textContent = isLed
            ? "LED Status"
            : "Charging Status";

          const badge = document.getElementById("chargeBadge");
          if (isLed) {
            badge.textContent = led.text;
            badge.className = "badge " + led.cls;
          } else {
            badge.textContent = S.charging ? "Charging" : "Not Charging";
            badge.className = "badge " + (S.charging ? "b-on" : "b-off");
          }

          const note = document.getElementById("devNote");
          if (!S.running) {
            note.textContent = "Select a wind speed and press Start.";
          } else if (S.wind === "off") {
            note.textContent =
              "Choose Low, Medium or High to turn the blower on.";
          } else if (isLed) {
            note.textContent = led.note;
          } else if (!S.charging) {
            note.textContent = `Not enough voltage for the ${dev.label} yet (needs ${dev.minV.toFixed(1)}V+). Try more wind, fewer blades, or a lighter load.`;
          } else {
            const slowCut = dev.minV * dev.iFactor * 0.65;
            if (S.current < slowCut) {
              note.textContent = `Charging, but slowly — the ${dev.label} is a heavy load for this wind speed.`;
            } else {
              note.textContent = `${dev.label} charging at ${Math.round(S.chargePct)}%.`;
            }
          }

          const statusHint = document.getElementById("statusHint");
          if (!S.running) {
            statusHint.textContent = "Pick a wind speed, then press Start.";
          } else if (S.wind === "off") {
            statusHint.textContent =
              "Blower armed — choose Low, Medium or High.";
          } else if (!S.charging) {
            statusHint.textContent = `Spinning up on ${WIND[S.wind].label.toLowerCase()} wind — waiting for enough voltage.`;
          } else if (isLed) {
            statusHint.textContent = `Lighting the LED on ${WIND[S.wind].label.toLowerCase()} wind.`;
          } else {
            statusHint.textContent = `Charging the ${dev.label} on ${WIND[S.wind].label.toLowerCase()} wind.`;
          }

          const modeChip = document.getElementById("modeChip");
          if (!S.running) {
            modeChip.textContent = "Idle — blower off";
            modeChip.className = "modechip";
          } else if (S.wind === "off") {
            modeChip.textContent = "Blower armed — pick a wind speed";
            modeChip.className = "modechip";
          } else {
            modeChip.textContent = `Running — ${WIND[S.wind].label} wind`;
            modeChip.className = "modechip run";
          }

          document.querySelectorAll("#flowRow .node").forEach((n) => {
            const k = n.dataset.n;
            let hot = false;
            if (k === "wind") hot = S.running && S.wind !== "off";
            if (k === "turbine") hot = S.rpm > 15;
            if (k === "gen") hot = S.voltage > 0.4;
            if (k === "dev") hot = S.charging;
            n.classList.toggle("hot", hot);
          });
          document.querySelectorAll("#flowRow .arrow").forEach((a, i) => {
            const seq = [
              S.running && S.wind !== "off",
              S.rpm > 15,
              S.voltage > 0.4,
            ];
            a.classList.toggle("hot", seq[i]);
          });
        }

        /* ---------- drawing ---------- */
        const canvas = document.getElementById("stage");
        const ctx = canvas.getContext("2d");
        // The stage card decides how much room the scene gets, so the drawing
        // space is the canvas's own box rather than a fixed 640x520 — nothing is
        // letterboxed and nothing is cropped. A single scale on the context
        // keeps every size, line width and font in design units exactly as
        // written; only the anchors below are placed from W and H, so the scene
        // spreads out to fill whatever shape the card gives it. ENLARGE shrinks
        // the design box against the canvas, which draws the whole scene bigger.
        const DESIGN_W = 640,
          DESIGN_H = 520,
          ENLARGE = 1.22;
        const R = 62;
        let W, H, GROUND, SHAFT_X, SHAFT_TOP, SHAFT_BOT;
        let BLOWER_X, BLOWER_Y, TOP_X, TOP_Y, DEV_X, WIRE_END;
        let JET_X, JET_TOP, JET_BAND, JET_END;

        function layout() {
          const cw = Math.max(360, Math.round(canvas.clientWidth || DESIGN_W));
          const ch = Math.max(300, Math.round(canvas.clientHeight || DESIGN_H));
          // supersample past the CSS box so the canvas still looks sharp
          const dpr = (window.devicePixelRatio || 1) * 1.5;
          canvas.width = Math.round(cw * dpr);
          canvas.height = Math.round(ch * dpr);
          const k = Math.min(cw / DESIGN_W, ch / DESIGN_H) * ENLARGE;
          ctx.setTransform(dpr * k, 0, 0, dpr * k, 0, 0);
          W = cw / k;
          H = ch / k;

          GROUND = H * 0.885;
          SHAFT_X = W * 0.5;
          SHAFT_BOT = GROUND - 26;
          SHAFT_TOP = SHAFT_BOT - H * 0.63;
          BLOWER_X = W * 0.105;
          BLOWER_Y = GROUND - 84;
          TOP_X = W - 62;
          TOP_Y = 66;
          DEV_X = W * 0.845;
          WIRE_END = DEV_X - 10;
          JET_X = BLOWER_X + 40;
          JET_TOP = GROUND - 212;
          JET_BAND = 90;
          JET_END = SHAFT_X - 30;
        }

        function drawSky() {
          ctx.clearRect(0, 0, W, H);
          const g = ctx.createLinearGradient(0, 0, 0, GROUND);
          g.addColorStop(0, "#e3eefb");
          g.addColorStop(1, "#f3f6f8");
          ctx.fillStyle = g;
          ctx.fillRect(0, 0, W, GROUND);
          ctx.fillStyle = "#e4e8eb";
          ctx.fillRect(0, GROUND, W, H - GROUND);
          ctx.strokeStyle = "#c3ccd3";
          ctx.lineWidth = 2;
          ctx.beginPath();
          ctx.moveTo(0, GROUND);
          ctx.lineTo(W, GROUND);
          ctx.stroke();
        }

        function drawBlower() {
          const cx = BLOWER_X,
            cy = BLOWER_Y;
          ctx.fillStyle = "#e3eefb";
          ctx.strokeStyle = "#4c5c6b";
          ctx.lineWidth = 2;
          roundRect(ctx, cx - 46, cy - 40, 92, 96, 12);
          ctx.fill();
          ctx.stroke();
          ctx.beginPath();
          ctx.arc(cx, cy - 2, 30, 0, Math.PI * 2);
          ctx.fillStyle = "#fcfdfe";
          ctx.fill();
          ctx.strokeStyle = "#4c5c6b";
          ctx.stroke();
          ctx.save();
          ctx.translate(cx, cy - 2);
          ctx.rotate((S.fanAngle * Math.PI) / 180);
          ctx.strokeStyle = "#17293b";
          ctx.lineWidth = 4;
          ctx.lineCap = "round";
          for (let i = 0; i < 3; i++) {
            ctx.save();
            ctx.rotate((i * 2 * Math.PI) / 3);
            ctx.beginPath();
            ctx.moveTo(0, 0);
            ctx.quadraticCurveTo(10, -18, 0, -24);
            ctx.stroke();
            ctx.restore();
          }
          ctx.restore();
          ctx.fillStyle = "#4c5c6b";
          ctx.font = "700 10px Rajdhani, sans-serif";
          ctx.textAlign = "center";
          ctx.fillText("MINI BLOWER", cx, cy + 70);
        }

        function drawWindParticles() {
          ctx.strokeStyle = "rgba(42,120,214,.75)";
          ctx.lineWidth = 3;
          ctx.lineCap = "round";
          S.particles.forEach((p) => {
            ctx.beginPath();
            ctx.moveTo(p.x - 16, p.y);
            ctx.lineTo(p.x, p.y);
            ctx.moveTo(p.x - 6, p.y - 5);
            ctx.lineTo(p.x, p.y);
            ctx.lineTo(p.x - 6, p.y + 5);
            ctx.stroke();
          });
        }

        function roundRect(c, x, y, w, h, r) {
          c.beginPath();
          c.moveTo(x + r, y);
          c.arcTo(x + w, y, x + w, y + h, r);
          c.arcTo(x + w, y + h, x, y + h, r);
          c.arcTo(x, y + h, x, y, r);
          c.arcTo(x, y, x + w, y, r);
          c.closePath();
        }

        // Each blade is a half-cylinder: seen from above its cross-section is a
        // semicircle of radius R/2 whose centre sits R/2 off the axis, so the
        // blade's tip reaches R while its root meets the shaft. Sweeping that
        // cross-section up the rotor while rotating it is what wraps the
        // blade into the helix — and what lets the rotor bite wind from any side.
        // The rotor always carries BLADE_COUNT blades. The "Number of Blades"
        // control does not add blades — it divides one rotor into that many
        // stacked segments, so 3 is a single body cut twice. Every segment
        // restarts from the same phase, and because a wrap is half a turn while
        // the blades sit half a turn apart, the segment above opens on exactly
        // the cross-section the one below closed on. The join is continuous —
        // which is why a joint can be drawn as a cut in the skin rather than
        // hidden behind a plate.
        const BLADE_COUNT = 2;
        // Bolting on another segment builds a taller machine, not a fatter one,
        // so the blade count drives height alone and the rotor keeps its
        // diameter: 2 reads as a stubby rotor, 4 as a tall one. SHAFT_TOP is the
        // top at the middle setting; the others work out from it.
        const HEIGHT_MOD = { 2: 0.82, 3: 1, 4: 1.18 };
        const TWIST_PER_STAGE = (2 * Math.PI) / BLADE_COUNT; // one wrap
        const ARC_STEPS = 9; // samples across one blade's curve
        const FACET_DEG = 9; // height sampling, held constant across settings

        // Real helical rotors are not barrels — they pinch in at both caps and
        // carry their full width across the middle, which is what gives them
        // the spindle outline. t is the height fraction over the WHOLE rotor,
        // 0 at the foot — running the profile per segment instead would pinch
        // every joint and break the body into a stack of separate beads.
        function spindle(t) {
          return 0.28 + 0.72 * Math.pow(Math.sin(Math.PI * t), 0.7);
        }

        // A joint is cut square to the blade rather than flat across the rotor,
        // so the seam rides the helix: it sits at the top of a segment, and
        // climbs to meet that edge as it crosses the blade's
        // cross-section. The two blades — half a turn apart — never line their
        // cuts up into one straight bar. SLANT is that climb, as a share of
        // the segment's height. The cut is a band of the skin shaded dark rather
        // than a line stroked afterwards; real geometry stays inside the same
        // depth sort as the rest of the body, where a stroke gets chewed up by
        // whichever patch paints next and comes out blocky.
        const CUT_PX = 3;
        const LIP_PX = 2;
        const SLANT = 0.26;

        // The rows of one segment, given as boundary curves t(u) rather than
        // plain heights — a slanted cut needs its edges to bend with u. Every
        // other row is expressed as a share of the cut's own curve, so no two
        // boundaries can cross and neighbouring quads still tile without gaps.
        function stageBands(st, stages, lifts, stageSpan) {
          const rows = [];
          if (st === stages - 1) {
            // the top segment ends at the open tip, not a joint, so no cut
            for (let h = 0; h <= lifts; h++) {
              const t = h / lifts;
              rows.push({ t: () => t, tone: null });
            }
            return rows;
          }
          const cutT = Math.min(CUT_PX / stageSpan, 0.06);
          const lipT = Math.min(LIP_PX / stageSpan, 0.04);
          // The cut runs out at the segment's top edge and drops away from it
          // across the blade, so it still climbs by SLANT from one side of the
          // cross-section to the other.
          const lip = (u) =>
            1 - cutT - lipT - SLANT * (1 - u / Math.PI);
          const cut = (u) => lip(u) + lipT;
          const top = (u) => cut(u) + cutT;
          const above = Math.max(1, Math.round(lifts * SLANT * 0.5));
          const below = Math.max(1, lifts - above);
          for (let j = 0; j < below; j++) {
            const f = j / below;
            rows.push({ t: (u) => f * lip(u), tone: null });
          }
          // a tone belongs to the band between this boundary and the next
          rows.push({ t: lip, tone: "lip" });
          rows.push({ t: cut, tone: "cut" });
          rows.push({ t: top, tone: null });
          for (let j = 1; j <= above; j++) {
            const f = j / above;
            rows.push({ t: (u) => top(u) + f * (1 - top(u)), tone: null });
          }
          return rows;
        }

        function bladePoint(phase, psi, prof) {
          const a = (R * prof) / 2;
          return {
            x: a * Math.cos(phase) + a * Math.cos(phase + psi),
            d: a * Math.sin(phase) + a * Math.sin(phase + psi), // + is toward the viewer
            nd: Math.sin(phase + psi), // depth part of the surface normal
          };
        }

        // Opaque shading, not alpha: the patches are painted back-to-front and
        // overlap heavily, so translucent fills would compound into mud.
        function shade(r, g, b, k) {
          return `rgb(${Math.round(r * k)},${Math.round(g * k)},${Math.round(b * k)})`;
        }

        function drawTurbine() {
          const stages = S.blades;
          const angleRad = (S.angle * Math.PI) / 180;
          // grown off the base plate, so the foot stays put on the mast
          const span = (SHAFT_BOT - SHAFT_TOP) * HEIGHT_MOD[stages];
          const topY = SHAFT_BOT - span;
          const stageSpan = span / stages;
          const lifts = Math.round(
            (TWIST_PER_STAGE * 180) / Math.PI / FACET_DEG,
          );

          // One strand is one blade of one stage. Flattening the pair keeps the
          // patch loop a single level deep no matter how many stages are stacked.
          const strands = [];
          for (let st = 0; st < stages; st++)
            for (let i = 0; i < BLADE_COUNT; i++) strands.push([st, i]);

          // Once a blade twists it is both in front of and behind the shaft at the
          // same time, so depth-sorting whole blades (which a straight rotor allows)
          // would tear. Sort the individual surface patches instead.
          const patches = [];
          for (const [st, i] of strands) {
            const stageBot = SHAFT_BOT - st * stageSpan;
            const base = angleRad + (i * 2 * Math.PI) / BLADE_COUNT;
            const rows = stageBands(st, stages, lifts, stageSpan);
            // Every corner carries its own height now, so it has to be projected
            // on its own rather than a row at a time.
            const at = (t, u) => {
              const q = bladePoint(
                base + TWIST_PER_STAGE * t,
                u,
                spindle((st + t) / stages),
              );
              return {
                x: SHAFT_X + q.x,
                y: stageBot - t * stageSpan,
                d: q.d,
                nd: q.nd,
              };
            };
            for (let r = 0; r < rows.length - 1; r++) {
              for (let s = 0; s < ARC_STEPS; s++) {
                const u0 = (s / ARC_STEPS) * Math.PI,
                  u1 = ((s + 1) / ARC_STEPS) * Math.PI;
                const q0 = at(rows[r].t(u0), u0),
                  q1 = at(rows[r].t(u1), u1),
                  q2 = at(rows[r + 1].t(u1), u1),
                  q3 = at(rows[r + 1].t(u0), u0);
                patches.push({
                  pts: [
                    [q0.x, q0.y],
                    [q1.x, q1.y],
                    [q2.x, q2.y],
                    [q3.x, q3.y],
                  ],
                  depth: (q0.d + q1.d + q2.d + q3.d) / 4,
                  face: q0.nd + q1.nd + q2.nd + q3.nd,
                  tip: s === 0,
                  tone: rows[r].tone,
                });
              }
            }
          }
          patches.sort((p, q) => p.depth - q.depth);

          const paint = (p) => {
            const k = 0.62 + 0.38 * ((p.depth / R + 1) / 2);
            // the convex skin catches the light; the concave blade face stays in
            // shade; the cut band goes dark and its lower lip catches a highlight
            const fill =
              p.tone === "cut"
                ? shade(18, 32, 46, k)
                : p.tone === "lip"
                  ? p.face >= 0
                    ? shade(255, 255, 255, k)
                    : shade(120, 175, 235, k)
                  : p.face >= 0
                    ? shade(244, 248, 252, k)
                    : shade(42, 120, 214, k);
            ctx.beginPath();
            ctx.moveTo(p.pts[0][0], p.pts[0][1]);
            for (let j = 1; j < 4; j++) ctx.lineTo(p.pts[j][0], p.pts[j][1]);
            ctx.closePath();
            ctx.fillStyle = fill;
            ctx.fill();
            // hairline in the fill colour closes the antialiasing seams between patches
            ctx.strokeStyle = fill;
            ctx.lineWidth = 1;
            ctx.stroke();
            if (p.tip) {
              ctx.beginPath();
              ctx.moveTo(p.pts[0][0], p.pts[0][1]);
              ctx.lineTo(p.pts[3][0], p.pts[3][1]);
              ctx.strokeStyle = "rgba(23,41,59,.5)";
              ctx.lineWidth = 1.5;
              ctx.stroke();
            }
          };

          patches.filter((p) => p.depth < 0).forEach(paint);
          ctx.strokeStyle = "#4c5c6b";
          ctx.lineWidth = 6;
          ctx.lineCap = "round";
          ctx.beginPath();
          ctx.moveTo(SHAFT_X, topY);
          ctx.lineTo(SHAFT_X, SHAFT_BOT);
          ctx.stroke();
          patches.filter((p) => p.depth >= 0).forEach(paint);

          // Base plate: the foot only. It is what the rotor bolts down onto,
          // and it lands where the spindle has pinched to its smallest, so it
          // closes the rotor off without covering blade. Drawn edge-on as a flat
          // bar rather than a tilted disc, so the rotor stays a straight side
          // view. Nothing caps the top — the blades just run out at their tips,
          // and internal joints get a cut rather than a plate, so no disc sits
          // anywhere on the body to break it up.
          const plateR = R * spindle(0) + 2;
          const plateH = 4;
          ctx.fillStyle = "#17293b";
          ctx.fillRect(
            SHAFT_X - plateR,
            SHAFT_BOT - plateH / 2,
            plateR * 2,
            plateH,
          );

          // support struts down to the mast base
          ctx.strokeStyle = "#8a949d";
          ctx.lineWidth = 4;
          ctx.beginPath();
          ctx.moveTo(SHAFT_X, SHAFT_BOT);
          ctx.lineTo(SHAFT_X, GROUND - 6);
          ctx.stroke();
        }

        // A twisted blade wraps around the shaft, so the side view alone never
        // states the blade count plainly — this top-down inset draws the same
        // semicircular cross-section the rotor is built from, which does.
        function drawTopView() {
          const cx = TOP_X,
            cy = TOP_Y,
            ring = 30;
          ctx.beginPath();
          ctx.arc(cx, cy, ring + 14, 0, Math.PI * 2);
          ctx.fillStyle = "rgba(255,255,255,.75)";
          ctx.fill();
          ctx.strokeStyle = "#dbe2e8";
          ctx.lineWidth = 1.5;
          ctx.stroke();

          ctx.beginPath();
          ctx.arc(cx, cy, 3.5, 0, Math.PI * 2);
          ctx.fillStyle = "#17293b";
          ctx.fill();

          // The top cap is the rotor's most-twisted slice, hence the twist offset.
          const angleRad = (S.angle * Math.PI) / 180 + TWIST_PER_STAGE;
          const n = BLADE_COUNT;
          const a = ring / 2;
          ctx.strokeStyle = "#2a78d6";
          ctx.lineWidth = 4;
          ctx.lineCap = "round";
          for (let i = 0; i < n; i++) {
            const phase = angleRad + (i * 2 * Math.PI) / n;
            ctx.beginPath();
            ctx.arc(
              cx + a * Math.cos(phase),
              cy + a * Math.sin(phase),
              a,
              phase,
              phase + Math.PI,
            );
            ctx.stroke();
          }
          ctx.fillStyle = "#4c5c6b";
          ctx.font = "700 9px Rajdhani, sans-serif";
          ctx.textAlign = "center";
          ctx.fillText("TOP VIEW", cx, cy + ring + 26);
        }

        function drawGenerator() {
          const gx = SHAFT_X - 34,
            gy = GROUND - 34,
            gw = 68,
            gh = 36;
          ctx.fillStyle = "#e3eefb";
          ctx.strokeStyle = "#4c5c6b";
          ctx.lineWidth = 2;
          roundRect(ctx, gx, gy, gw, gh, 8);
          ctx.fill();
          ctx.stroke();
          ctx.strokeStyle = S.voltage > 0.4 ? "#fab219" : "#8a949d";
          ctx.lineWidth = 2.5;
          ctx.beginPath();
          for (let i = 0; i < 4; i++)
            ctx.arc(gx + 14 + i * 12, gy + gh / 2, 7, Math.PI, 0, i % 2 === 1);
          ctx.stroke();
          ctx.fillStyle = "#17293b";
          ctx.font = "700 10px Rajdhani, sans-serif";
          ctx.textAlign = "center";
          ctx.fillText("GENERATOR", gx + gw / 2, gy + gh + 14);
        }

        function wirePath() {
          const p = new Path2D();
          p.moveTo(SHAFT_X, GROUND - 16);
          p.bezierCurveTo(
            SHAFT_X + 40,
            GROUND + 6,
            WIRE_END - 40,
            GROUND + 6,
            WIRE_END,
            GROUND - 16,
          );
          return p;
        }

        function drawWire() {
          const p = wirePath();
          ctx.strokeStyle = "#8a949d";
          ctx.lineWidth = 4;
          ctx.stroke(p);
          if (S.current > 0.02) {
            ctx.setLineDash([8, 10]);
            ctx.lineDashOffset = -S.wireFlow;
            ctx.strokeStyle = "#2a78d6";
            ctx.lineWidth = 3;
            ctx.stroke(p);
            ctx.setLineDash([]);
          }
        }

        function drawDevice() {
          const cx = DEV_X,
            base = GROUND - 6;
          if (S.device === "led") {
            const b = S.ledBrightness;
            ctx.beginPath();
            ctx.arc(cx, base - 46, 20 + b * 6, 0, Math.PI * 2);
            ctx.fillStyle = `rgba(250,178,25,${0.15 + b * 0.5})`;
            ctx.fill();
            ctx.beginPath();
            ctx.arc(cx, base - 46, 18, 0, Math.PI * 2);
            ctx.fillStyle =
              b > 0.05 ? `rgba(250,178,25,${0.5 + b * 0.5})` : "#e4e8eb";
            ctx.strokeStyle = "#c98a0a";
            ctx.lineWidth = 2;
            ctx.fill();
            ctx.stroke();
            ctx.fillStyle = "#17293b";
            ctx.fillRect(cx - 8, base - 26, 16, 14);
            ctx.strokeRect(cx - 8, base - 26, 16, 14);
          } else if (S.device === "battery") {
            const bw = 34,
              bh = 58,
              bx = cx - bw / 2,
              by = base - bh - 8;
            ctx.fillStyle = "#fcfdfe";
            ctx.strokeStyle = "#4c5c6b";
            ctx.lineWidth = 2.5;
            roundRect(ctx, bx, by, bw, bh, 6);
            ctx.fill();
            ctx.stroke();
            ctx.fillStyle = "#4c5c6b";
            ctx.fillRect(cx - 7, by - 8, 14, 8);
            const fillH = (S.chargePct / 100) * (bh - 8);
            ctx.fillStyle = S.charging ? "#0ca30c" : "#cfe8cf";
            ctx.fillRect(bx + 4, by + bh - 4 - fillH, bw - 8, fillH);
            ctx.fillStyle = "#17293b";
            ctx.font = "700 11px Rajdhani, sans-serif";
            ctx.textAlign = "center";
            ctx.fillText(`${Math.round(S.chargePct)}%`, cx, by + bh + 18);
          } else {
            const gw = 46,
              gh = 64,
              gx = cx - gw / 2,
              gy = base - gh - 6;
            ctx.fillStyle = "#fcfdfe";
            ctx.strokeStyle = "#4c5c6b";
            ctx.lineWidth = 2.5;
            roundRect(ctx, gx, gy, gw, gh, 9);
            ctx.fill();
            ctx.stroke();
            ctx.fillStyle = S.charging ? "#cfe8cf" : "#e4e8eb";
            roundRect(ctx, gx + 5, gy + 7, gw - 10, gh - 22, 4);
            ctx.fill();
            ctx.fillStyle = S.charging ? "#006300" : "#8a949d";
            ctx.font = "700 10px Rajdhani, sans-serif";
            ctx.textAlign = "center";
            ctx.fillText(
              S.charging ? `${Math.round(S.chargePct)}%` : "OFF",
              cx,
              gy + gh / 2 + 3,
            );
          }
          ctx.fillStyle = "#17293b";
          ctx.font = "700 10px Rajdhani, sans-serif";
          ctx.textAlign = "center";
          ctx.fillText(DEVICES[S.device].label.toUpperCase(), cx, base + 22);
          ctx.fillStyle = "#dbe2e8";
          ctx.fillRect(cx - 26, base - 2, 52, 6);
        }

        function draw() {
          drawSky();
          drawWindParticles();
          drawBlower();
          drawTurbine();
          drawTopView();
          drawGenerator();
          drawWire();
          drawDevice();
        }

        /* ---------- loop ---------- */
        let lastT = null;
        function loop(t) {
          if (lastT == null) lastT = t;
          const dt = Math.min(0.05, (t - lastT) / 1000);
          lastT = t;
          update(dt);
          draw();
          requestAnimationFrame(loop);
        }
        layout();
        updateUI();
        draw();
        requestAnimationFrame(loop);

        // the scene is rebuilt from W and H, so a resize only needs a relayout
        if (window.ResizeObserver) {
          let first = true;
          new ResizeObserver(() => {
            if (first) return void (first = false);
            layout();
            draw();
          }).observe(canvas);
        } else {
          window.addEventListener("resize", () => {
            layout();
            draw();
          });
        }
      })();
    </script>
  </body>
</html>
