<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Autonomous Drone · Sky Parcel</title>
    <link rel="icon" type="image/png" href="../../../assets/logo.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Orbitron:wght@600;700;800&family=Rajdhani:wght@400;500;600;700&family=IBM+Plex+Mono:wght@500;600&display=swap"
      rel="stylesheet"
    />
    <style>
      :root {
        --bg: #0b1220;
        --panel: #121b2e;
        --panel2: #19243c;
        --well: rgba(4, 8, 18, 0.5);
        --line: rgba(190, 205, 255, 0.13);
        --txt: #edf1fb;
        --mut: #a9b4cf;
        --dim: #7f8bab;
        --accent: #5b8cff;
        --accent-press: #4373ec;
        --sky: #7cc4ff;
        --safe: #34d399;
        --warn: #fbbf24;
        --fail: #f87171;
        --thr: #f5b942;
        --elv: #2dd4bf;
        --rud: #a78bfa;
        --ail: #f472b6;
        --shadow: 0 10px 28px rgba(0, 0, 0, 0.35);
        --r: 12px;
        --head: "Orbitron", sans-serif;
        --body: "Rajdhani", sans-serif;
        --mono: "IBM Plex Mono", Consolas, monospace;
      }
      * {
        box-sizing: border-box;
      }
      html,
      body {
        margin: 0;
        height: 100%;
      }
      body {
        font-family: var(--body);
        font-size: 15px;
        font-weight: 500;
        color: var(--txt);
        background-color: var(--bg);
        background-image: radial-gradient(1400px 700px at 50% -15%, #182a4d 0%, rgba(11, 18, 32, 0) 70%);
        background-repeat: no-repeat;
        height: 100vh;
        overflow: hidden;
        padding: 0 clamp(12px, 1.6vw, 24px) 12px;
        display: flex;
        flex-direction: column;
      }
      h1,
      h3 {
        font-family: var(--head);
      }
      button {
        font-family: var(--body);
      }

      /* ---------- header ---------- */
      header.top {
        display: grid;
        grid-template-columns: 1fr auto 1fr;
        align-items: center;
        gap: 12px;
        padding: 10px 0;
        margin-bottom: 10px;
        border-bottom: 1px solid var(--line);
        flex: 0 0 auto;
      }
      header.top .hleft {
        grid-column: 1;
        justify-self: start;
      }
      header.top .title {
        grid-column: 2;
        text-align: center;
      }
      header.top h1 {
        margin: 0;
        font-size: 22px;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }
      header.top .helpbtns {
        grid-column: 3;
        justify-self: end;
      }
      .ghost {
        cursor: pointer;
        border: 1px solid var(--line);
        background: var(--panel2);
        color: var(--mut);
        border-radius: 8px;
        padding: 7px 12px;
        font-size: 14px;
        font-weight: 700;
      }
      .ghost:hover {
        border-color: var(--accent);
        color: var(--txt);
      }
      @media (max-width: 760px) {
        header.top {
          grid-template-columns: minmax(0, 1fr);
          gap: 8px;
        }
        header.top .title {
          grid-row: 3;
          grid-column: 1;
        }
        header.top .hleft {
          grid-row: 2;
          grid-column: 1;
          justify-self: center;
        }
        header.top .helpbtns {
          grid-row: 1;
          grid-column: 1;
          justify-self: center;
        }
        header.top h1 {
          font-size: 16px;
        }
        .helpbtn {
          font-size: 10px;
          padding: 7px 8px;
        }
      }

      /* ---------- layout ---------- */
      .grid {
        display: grid;
        grid-template-columns: 296px minmax(0, 1fr) 318px;
        gap: 14px;
        flex: 1 1 auto;
        min-height: 0;
      }
      .card {
        background: var(--panel);
        border: 1px solid var(--line);
        border-radius: var(--r);
        box-shadow: var(--shadow);
        padding: 14px 16px;
        overflow-y: auto;
        overflow-x: hidden;
        min-height: 0;
      }
      .card::-webkit-scrollbar {
        width: 8px;
      }
      .card::-webkit-scrollbar-thumb {
        background: rgba(255, 255, 255, 0.16);
        border-radius: 4px;
      }
      .card h3 {
        margin: 0 0 8px;
        font-size: 12px;
        font-weight: 600;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--mut);
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        gap: 8px;
      }
      .card h3 em {
        font-style: normal;
        font-family: var(--body);
        font-size: 13px;
        letter-spacing: 0.02em;
        text-transform: none;
        color: var(--dim);
        font-weight: 700;
      }
      .card h3 + * {
        margin-top: 0;
      }
      .sec {
        margin-top: 16px;
      }
      @media (max-width: 1280px) {
        body {
          overflow: auto;
          height: auto;
        }
        .grid {
          grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
          flex: 0 0 auto;
        }
        .card.stage {
          grid-column: 1 / -1;
          order: -1;
          height: min(720px, 78vh);
          min-height: 540px;
        }
      }
      @media (max-width: 760px) {
        .grid {
          grid-template-columns: minmax(0, 1fr);
        }
        .card.stage {
          height: 560px;
          min-height: 0;
        }
      }

      /* ---------- left panel ---------- */
      .ctrl {
        margin-bottom: 12px;
      }
      .ctrl .row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 6px;
        gap: 6px;
      }
      .ctrl label {
        font-size: 14.5px;
        font-weight: 700;
        white-space: nowrap;
      }
      .ctrl .val {
        font-family: var(--head);
        font-size: 11px;
        color: var(--sky);
        font-weight: 700;
        letter-spacing: 0.04em;
        text-align: right;
      }
      kbd {
        font-family: var(--mono);
        font-size: 11px;
        font-weight: 600;
        color: var(--mut);
        border: 1px solid var(--line);
        border-bottom-width: 2px;
        border-radius: 4px;
        padding: 0 4px;
        margin-left: 4px;
        background: rgba(255, 255, 255, 0.03);
      }
      .toggle {
        display: flex;
        gap: 6px;
      }
      .toggle button {
        flex: 1;
        cursor: pointer;
        border: 1px solid var(--line);
        background: var(--panel2);
        color: var(--mut);
        padding: 8px 4px;
        border-radius: 8px;
        font-size: 15px;
        font-weight: 700;
        transition: 0.12s ease;
        user-select: none;
        -webkit-user-select: none;
      }
      .toggle button:hover {
        border-color: var(--accent);
        color: var(--txt);
      }
      .toggle button.on {
        background: rgba(91, 140, 255, 0.2);
        border-color: var(--accent);
        color: #fff;
        box-shadow: inset 0 0 0 1px var(--accent);
      }
      .toggle button:focus-visible,
      .btn:focus-visible,
      .ghost:focus-visible,
      .trim button:focus-visible {
        outline: 2px solid var(--sky);
        outline-offset: 2px;
      }
      .hint {
        font-size: 13px;
        color: var(--mut);
        line-height: 1.38;
        margin: 6px 0 0;
      }

      /* transmitter */
      .tx {
        background: linear-gradient(180deg, #1c2945, #141e33);
        border: 1px solid var(--line);
        border-radius: 14px;
        padding: 10px 10px 8px;
      }
      .sticks {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 12px;
      }
      .stickbox {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 4px;
      }
      .stickbox .sl {
        min-height: 26px;
        display: flex;
        align-items: flex-end;
        text-align: center;
        font-family: var(--head);
        font-size: 10px;
        letter-spacing: 0.12em;
        color: var(--dim);
        text-transform: uppercase;
      }
      .gimbal {
        position: relative;
        width: 100%;
        max-width: 118px;
        aspect-ratio: 1;
        border-radius: 12px;
        background: radial-gradient(circle at 50% 50%, #0d1528 0%, #0a1020 70%);
        border: 1px solid rgba(190, 205, 255, 0.2);
        touch-action: none;
        cursor: grab;
      }
      .gimbal:active {
        cursor: grabbing;
      }
      .gimbal .ax {
        position: absolute;
        pointer-events: none;
      }
      .gimbal .ax.v {
        left: 50%;
        top: 10%;
        bottom: 10%;
        width: 3px;
        transform: translateX(-50%);
        border-radius: 2px;
      }
      .gimbal .ax.h {
        top: 50%;
        left: 10%;
        right: 10%;
        height: 3px;
        transform: translateY(-50%);
        border-radius: 2px;
      }
      .gimbal .tag {
        position: absolute;
        font-size: 11px;
        font-weight: 700;
        color: var(--dim);
        pointer-events: none;
        line-height: 1;
        white-space: nowrap;
      }
      .gimbal .tag.t {
        top: 3px;
        left: 50%;
        transform: translateX(-50%);
      }
      .gimbal .tag.b {
        bottom: 3px;
        left: 50%;
        transform: translateX(-50%);
      }
      .gimbal .tag.l {
        left: 3px;
        top: 50%;
        transform: translateY(-50%);
      }
      .gimbal .tag.r {
        right: 3px;
        top: 50%;
        transform: translateY(-50%);
      }
      .knob {
        position: absolute;
        left: 50%;
        top: 50%;
        width: 30px;
        height: 30px;
        margin: -15px 0 0 -15px;
        border-radius: 50%;
        background: radial-gradient(circle at 35% 30%, #f3f6ff, #8f9bbb 70%, #5d6886);
        box-shadow: 0 3px 8px rgba(0, 0, 0, 0.55), 0 0 0 3px rgba(91, 140, 255, 0.25);
        pointer-events: none;
      }
      .chan {
        margin-top: 10px;
        display: flex;
        flex-direction: column;
        gap: 5px;
      }
      .ch {
        display: grid;
        grid-template-columns: 70px 1fr 92px;
        align-items: center;
        gap: 8px;
        font-size: 13.5px;
        font-weight: 700;
      }
      .ch .nm {
        display: flex;
        align-items: center;
        gap: 6px;
        white-space: nowrap;
      }
      .ch .nm i {
        width: 9px;
        height: 9px;
        border-radius: 2px;
        flex: 0 0 auto;
      }
      .ch .cb {
        position: relative;
        height: 8px;
        border-radius: 4px;
        background: rgba(255, 255, 255, 0.07);
        overflow: hidden;
      }
      .ch .cb i {
        position: absolute;
        top: 0;
        bottom: 0;
        border-radius: 4px;
      }
      .ch .cb u {
        position: absolute;
        left: 50%;
        top: -2px;
        bottom: -2px;
        width: 1px;
        background: rgba(255, 255, 255, 0.3);
      }
      .ch .cv {
        font-family: var(--mono);
        font-size: 12px;
        color: var(--txt);
        text-align: right;
        white-space: nowrap;
      }
      .trim {
        display: grid;
        grid-template-columns: auto 1fr 1fr;
        align-items: center;
        gap: 6px;
        margin-top: 8px;
        font-size: 13.5px;
        font-weight: 700;
      }
      .trim > span:first-child {
        white-space: nowrap;
      }
      .pair {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 10px;
      }
      .pair .ctrl {
        margin-bottom: 0;
      }
      .setnote {
        margin: 6px 0 12px;
      }
      .setnote b,
      .hint b {
        color: var(--txt);
      }
      .ctrl.inline {
        display: grid;
        grid-template-columns: auto 1fr;
        align-items: center;
        gap: 10px;
      }
      .card h3.sec {
        margin-top: 18px;
      }
      .trim button {
        cursor: pointer;
        border: 1px solid var(--line);
        background: var(--panel2);
        color: var(--txt);
        border-radius: 6px;
        padding: 4px 6px;
        font-size: 13px;
        font-weight: 700;
        white-space: nowrap;
      }
      .trim button:hover {
        border-color: var(--elv);
      }
      .trim .tv {
        font-family: var(--mono);
        font-size: 12px;
        color: var(--elv);
        margin-left: 4px;
        display: inline-block;
        min-width: 64px;
      }
      .gpad {
        font-size: 12.5px;
        color: var(--dim);
        margin: 8px 0 0;
      }
      .gpad b {
        color: var(--safe);
      }
      .actions {
        display: grid;
        grid-template-columns: 1.3fr 1fr 1fr;
        gap: 8px;
        margin-top: 8px;
      }
      .btn {
        cursor: pointer;
        border-radius: 8px;
        padding: 11px 6px;
        font-family: var(--head);
        font-size: 11.5px;
        font-weight: 700;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        border: 1px solid transparent;
        transition: 0.12s ease;
        white-space: nowrap;
      }
      .btn.start {
        background: var(--accent);
        color: #fff;
        box-shadow: 0 6px 16px rgba(91, 140, 255, 0.3);
      }
      .btn.start:hover {
        background: var(--accent-press);
      }
      .btn.start.running {
        background: var(--panel2);
        color: var(--txt);
        border-color: var(--line);
        box-shadow: none;
      }
      .btn.reset {
        background: transparent;
        color: var(--txt);
        border-color: var(--line);
      }
      .btn.reset:hover {
        border-color: var(--mut);
      }
      .btn:disabled {
        opacity: 0.4;
        cursor: not-allowed;
      }
      .vol {
        display: flex;
        align-items: center;
        gap: 8px;
      }
      .vol .ghost {
        padding: 5px 9px;
        font-size: 15px;
        line-height: 1;
      }
      .vol .vl {
        font-size: 13.5px;
        font-weight: 700;
        color: var(--mut);
      }
      .vol input[type="range"] {
        width: 110px;
        accent-color: var(--accent);
        cursor: pointer;
      }
      .vol .vv {
        font-family: var(--mono);
        font-size: 12px;
        color: var(--txt);
        min-width: 38px;
      }
      @media (max-width: 760px) {
        .vol .vl {
          display: none;
        }
        .vol input[type="range"] {
          width: 70px;
        }
      }
      .camhint {
        margin: -4px 0 10px;
      }
      .ctrl.inline > label {
        min-width: 62px;
      }
      .kb {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 10px;
      }
      .kbgrp {
        background: var(--well);
        border: 1px solid var(--line);
        border-radius: 10px;
        padding: 8px 6px;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 6px;
      }
      .kbt {
        font-family: var(--head);
        font-size: 9.5px;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--dim);
      }
      .kbpad {
        display: grid;
        grid-template-areas: ". u ." "l d r";
        grid-template-columns: 30px 30px 30px;
        gap: 4px;
      }
      .kc {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 30px;
        height: 28px;
        padding: 0 4px;
        border-radius: 6px;
        border: 1px solid var(--line);
        border-bottom-width: 3px;
        background: var(--panel2);
        color: var(--txt);
        font-family: var(--mono);
        font-size: 13px;
        font-weight: 600;
        transition: background 0.06s, transform 0.06s;
        user-select: none;
      }
      .kc.thr {
        border-color: var(--thr);
      }
      .kc.rud {
        border-color: var(--rud);
      }
      .kc.elv {
        border-color: var(--elv);
      }
      .kc.ail {
        border-color: var(--ail);
      }
      .kc.on {
        background: var(--accent);
        color: #fff;
        transform: translateY(2px);
        border-bottom-width: 1px;
      }
      .kc.sm {
        min-width: 24px;
        height: 22px;
        font-size: 11.5px;
        margin-right: 3px;
        border-bottom-width: 2px;
      }
      .kc.sm.wide {
        min-width: 46px;
      }
      .kbl {
        font-size: 12.5px;
        line-height: 1.4;
        color: var(--mut);
        text-align: center;
      }
      .kbl b {
        font-family: var(--mono);
        font-size: 12px;
      }
      .t-thr {
        color: var(--thr);
      }
      .t-rud {
        color: var(--rud);
      }
      .t-elv {
        color: var(--elv);
      }
      .t-ail {
        color: var(--ail);
      }
      .kbrows {
        margin-top: 8px;
        display: flex;
        flex-direction: column;
        gap: 4px;
        font-size: 13px;
        color: var(--mut);
      }
      .kbrows > div {
        display: grid;
        grid-template-columns: 96px 1fr;
        align-items: center;
        gap: 6px;
      }
      [hidden] {
        display: none !important;
      }
      .gtabs {
        display: grid !important;
        grid-template-columns: repeat(5, minmax(0, 1fr));
      }
      .gtabs button {
        font-size: 12.5px !important;
        padding: 7px 1px !important;
        line-height: 1.1;
      }
      .assistline {
        color: var(--elv) !important;
        min-height: 1.2em;
      }
      .ovbtns {
        display: grid;
        grid-template-columns: 1.4fr 1fr;
        gap: 8px;
      }
      .ovbtns .btn {
        width: 100%;
      }
      .coach {
        position: absolute;
        left: 50%;
        top: 10px;
        transform: translateX(-50%);
        z-index: 4;
        width: min(560px, calc(100% - 230px));
        background: rgba(8, 13, 26, 0.9);
        border: 1px solid rgba(255, 176, 32, 0.6);
        border-radius: 10px;
        padding: 8px 12px 10px;
        box-shadow: 0 10px 26px rgba(0, 0, 0, 0.45);
      }
      .coach-h {
        display: flex;
        justify-content: space-between;
        gap: 8px;
        font-family: var(--head);
        font-size: 10.5px;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: #ffcf70;
      }
      .coach-t {
        font-size: 15px;
        font-weight: 600;
        line-height: 1.4;
        margin: 4px 0 8px;
      }
      .coach-t b {
        color: var(--sky);
      }
      .coach-f {
        display: flex;
        align-items: center;
        gap: 10px;
      }
      .coach-bar {
        flex: 1;
        height: 6px;
        border-radius: 3px;
        background: rgba(255, 255, 255, 0.1);
        overflow: hidden;
      }
      .coach-bar i {
        display: block;
        height: 100%;
        width: 0;
        background: #ffb020;
        transition: width 0.2s;
      }
      #coachSkip {
        cursor: pointer;
        border: 1px solid var(--line);
        background: var(--panel2);
        color: var(--mut);
        border-radius: 6px;
        padding: 3px 9px;
        font-size: 12.5px;
        font-weight: 700;
      }
      #coachSkip:hover {
        color: var(--txt);
        border-color: var(--accent);
      }
      .kc.pulse {
        box-shadow: 0 0 0 2px #ffb020, 0 0 12px rgba(255, 176, 32, 0.8);
        animation: kp 1s infinite;
      }
      @keyframes kp {
        50% {
          box-shadow: 0 0 0 2px #ffb020, 0 0 2px rgba(255, 176, 32, 0.2);
        }
      }
      .gimbal .ax.pulse {
        filter: brightness(1.5) drop-shadow(0 0 6px #ffb020);
        animation: kp2 1s infinite;
      }
      .gimbal .ax.v.pulse {
        width: 7px;
      }
      .gimbal .ax.h.pulse {
        height: 7px;
      }
      @keyframes kp2 {
        50% {
          filter: brightness(1);
        }
      }
      .about {
        background: var(--well);
        border: 1px solid var(--line);
        border-radius: 9px;
        padding: 8px 10px;
        font-size: 13px;
        line-height: 1.4;
        color: var(--mut);
        margin-bottom: 8px;
      }
      .about b {
        color: var(--txt);
      }
      .about div + div {
        margin-top: 3px;
      }
      .demobtn {
        width: 100%;
        margin-top: 8px;
        cursor: pointer;
        border-radius: 8px;
        padding: 8px;
        border: 1px dashed rgba(255, 176, 32, 0.7);
        background: rgba(255, 176, 32, 0.08);
        color: #ffcf70;
        font-weight: 700;
        font-size: 14px;
      }
      .demobtn:hover {
        background: rgba(255, 176, 32, 0.16);
      }
      .gtabs button {
        font-size: 14px;
        padding: 8px 2px;
      }
      .modepanel {
        margin: 8px 0 4px;
      }
      .mlist {
        display: flex;
        flex-direction: column;
        gap: 5px;
        max-height: 268px;
        overflow-y: auto;
        padding-right: 2px;
      }
      .mlist button {
        display: grid;
        grid-template-columns: 26px 1fr auto;
        align-items: center;
        gap: 8px;
        width: 100%;
        text-align: left;
        cursor: pointer;
        padding: 6px 8px;
        border-radius: 8px;
        border: 1px solid var(--line);
        background: var(--panel2);
        color: var(--txt);
        font-size: 14.5px;
        font-weight: 700;
        line-height: 1.15;
      }
      .mlist button:hover:not(:disabled) {
        border-color: var(--accent);
      }
      .mlist button.on {
        border-color: #ffb020;
        box-shadow: inset 0 0 0 1px #ffb020;
        background: rgba(255, 176, 32, 0.1);
      }
      .mlist button:disabled {
        opacity: 0.45;
        cursor: not-allowed;
      }
      .mlist .n {
        font-family: var(--head);
        font-size: 11px;
        color: #ffcf70;
        text-align: center;
        letter-spacing: 0;
      }
      .mlist small {
        display: block;
        font-size: 12.5px;
        color: var(--dim);
        font-weight: 600;
        margin-top: 1px;
      }
      .mlist .st {
        font-size: 12.5px;
        color: var(--warn);
        white-space: nowrap;
      }
      .rank {
        font-size: 13.5px;
        color: var(--mut);
        margin-bottom: 6px;
      }
      .rank b {
        color: #ffcf70;
      }
      .how b {
        color: var(--txt);
      }
      .smk {
        margin-top: 8px;
      }
      .mtask b {
        color: var(--txt);
      }
      .mtask {
        font-size: 13.5px;
        color: var(--mut);
        margin: 0 0 6px;
      }
      .skills li.fail .ck {
        background: var(--fail);
        border-color: var(--fail);
      }
      .skills li.fail .ck::after {
        content: "✕";
        font-weight: 800;
        color: #2a0505;
      }
      .skills li.fail {
        color: var(--fail);
      }
      .tdone {
        display: flex;
        flex-wrap: wrap;
        gap: 5px;
        margin-top: 8px;
      }
      .tdone span {
        font-size: 13px;
        font-weight: 700;
        padding: 3px 8px;
        border-radius: 12px;
        background: rgba(255, 176, 32, 0.12);
        border: 1px solid rgba(255, 176, 32, 0.4);
      }
      .tdone span.empty {
        background: none;
        border: 0;
        color: var(--dim);
        font-weight: 600;
        padding: 0;
      }
      .tdone b {
        color: #ffcf70;
      }
      .keys {
        font-size: 12.5px;
        color: var(--dim);
        line-height: 1.95;
        margin-top: 12px;
        border-top: 1px dashed var(--line);
        padding-top: 8px;
      }
      .keys kbd {
        margin: 0 2px 0 0;
      }

      /* ---------- stage ---------- */
      .card.stage {
        display: flex;
        flex-direction: column;
        padding: 10px;
        overflow: hidden;
      }
      .scene-wrap {
        position: relative;
        flex: 1 1 auto;
        min-height: 0;
        border-radius: 9px;
        overflow: hidden;
        background: #9cc8ec;
      }
      #gl,
      #gl canvas,
      #hud {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        display: block;
      }
      #hud {
        pointer-events: none;
      }
      .scene-wrap::after {
        content: "";
        position: absolute;
        inset: 0;
        border-radius: 9px;
        border: 3px solid transparent;
        pointer-events: none;
        z-index: 6;
      }
      .scene-wrap.al-warn::after {
        border-color: var(--warn);
        animation: flash 0.9s infinite;
      }
      .scene-wrap.al-fail::after {
        border-color: var(--fail);
        animation: flash 0.6s infinite;
      }
      @keyframes flash {
        50% {
          border-color: transparent;
        }
      }
      .ovl {
        position: absolute;
        left: 10px;
        top: 10px;
        display: flex;
        flex-direction: column;
        gap: 6px;
        z-index: 3;
        pointer-events: none;
        max-width: calc(100% - 220px);
      }
      .modechip {
        background: rgba(8, 13, 26, 0.84);
        border: 1px solid var(--line);
        border-radius: 8px;
        padding: 6px 10px;
        font-size: 14px;
        font-weight: 600;
        line-height: 1.3;
        color: var(--txt);
      }
      .modechip b {
        color: var(--sky);
      }
      /* demo flight bar: pause / take control + what the autopilot is doing */
      .demobar {
        pointer-events: auto;
        background: rgba(8, 13, 26, 0.88);
        border: 1px solid var(--line);
        border-left: 4px solid var(--sky);
        border-radius: 8px;
        padding: 7px 10px 8px;
        display: flex;
        flex-direction: column;
        gap: 5px;
        max-width: 520px;
      }
      .demobar[hidden] {
        display: none;
      }
      .db-h {
        display: flex;
        align-items: center;
        gap: 6px;
      }
      .db-t {
        flex: 1;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--sky);
        white-space: nowrap;
      }
      .db-h button {
        font: inherit;
        font-size: 12.5px;
        font-weight: 700;
        color: var(--txt);
        background: rgba(124, 196, 255, 0.14);
        border: 1px solid rgba(124, 196, 255, 0.4);
        border-radius: 6px;
        padding: 3px 9px;
        cursor: pointer;
        white-space: nowrap;
      }
      .db-h button:hover {
        background: rgba(124, 196, 255, 0.26);
      }
      .db-a {
        font-size: 13.5px;
        font-weight: 600;
        line-height: 1.3;
        color: var(--txt);
      }
      .db-g {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 3px 10px;
        font-size: 12px;
        color: var(--mut);
      }
      .db-g span {
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }
      .db-g b {
        color: var(--txt);
        font-variant-numeric: tabular-nums;
      }
      .db-k {
        font-size: 11.5px;
        color: var(--dim);
      }
      .db-h button.rw {
        user-select: none;
        -webkit-user-select: none;
        touch-action: none;
      }
      .db-h button.rw.on {
        background: rgba(255, 196, 74, 0.3);
        border-color: rgba(255, 196, 74, 0.8);
      }
      .db-h button:disabled {
        opacity: 0.45;
        cursor: default;
      }
      .db-b {
        display: flex;
        gap: 12px;
        align-items: center;
      }
      .db-b .db-g {
        flex: 1;
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
      /* keyboard keys the autopilot is "pressing" (the keys players use) */
      .db-c {
        display: flex;
        flex-wrap: wrap;
        align-items: flex-start;
        gap: 10px 14px;
      }
      .kb2 {
        display: flex;
        gap: 18px;
      }
      .kb2 figure {
        margin: 0;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 3px;
      }
      .kb2 figcaption {
        font-size: 10.5px;
        line-height: 1.25;
        text-align: center;
        color: var(--dim);
        white-space: nowrap;
      }
      .kg {
        display: grid;
        grid-template-columns: repeat(3, 24px);
        grid-template-rows: repeat(2, 24px);
        grid-template-areas: ". u ." "l d r";
        gap: 3px;
      }
      .kg span {
        --k: 0;
        display: grid;
        place-items: center;
        border-radius: 5px;
        border: 1px solid rgba(190, 205, 255, 0.28);
        border-bottom-width: 3px;
        font-size: 12px;
        font-weight: 700;
        color: var(--mut);
        background: rgba(91, 140, 255, calc(var(--k) * 0.95));
      }
      .kg span.on {
        color: #fff;
        border-color: rgba(160, 190, 255, 0.9);
        border-bottom-width: 1px;
        transform: translateY(2px);
      }
      .kg .u {
        grid-area: u;
      }
      .kg .l {
        grid-area: l;
      }
      .kg .d {
        grid-area: d;
      }
      .kg .r {
        grid-area: r;
      }
      /* mini Mode 2 transmitter: the two sticks the autopilot is moving */
      .tx2 {
        display: flex;
        gap: 8px;
        flex: none;
      }
      .tx2 figure {
        margin: 0;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 3px;
      }
      .tx2 figcaption {
        font-size: 10.5px;
        color: var(--dim);
        white-space: nowrap;
      }
      .gim2 {
        position: relative;
        width: 51px;
        height: 51px;
        border-radius: 10px;
        background: rgba(255, 255, 255, 0.04);
        border: 1px solid var(--line);
      }
      .gim2::before,
      .gim2::after {
        content: "";
        position: absolute;
        background: rgba(190, 205, 255, 0.18);
      }
      .gim2::before {
        left: 50%;
        top: 6px;
        bottom: 6px;
        width: 1px;
      }
      .gim2::after {
        top: 50%;
        left: 6px;
        right: 6px;
        height: 1px;
      }
      .gim2 i {
        position: absolute;
        left: 50%;
        top: 50%;
        width: 14px;
        height: 14px;
        margin: -7px 0 0 -7px;
        border-radius: 50%;
        background: var(--sky);
        box-shadow: 0 0 0 3px rgba(124, 196, 255, 0.25);
        z-index: 1;
      }
      @media (max-width: 760px) {
        .db-g {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }
      }
      .toasts {
        display: flex;
        flex-direction: column;
        gap: 5px;
      }
      .toast {
        background: rgba(8, 13, 26, 0.88);
        border: 1px solid var(--line);
        border-left: 4px solid var(--warn);
        border-radius: 8px;
        padding: 5px 10px;
        font-size: 13.5px;
        font-weight: 600;
        line-height: 1.3;
        animation: tin 0.25s ease;
      }
      .toast.ok {
        border-left-color: var(--safe);
      }
      .toast.bad {
        border-left-color: var(--fail);
      }
      .toast.info {
        border-left-color: var(--sky);
      }
      @keyframes tin {
        from {
          opacity: 0;
          transform: translateY(-6px);
        }
      }
      .banner {
        position: absolute;
        left: 50%;
        top: 38%;
        transform: translate(-50%, -50%);
        z-index: 4;
        pointer-events: none;
        text-align: center;
        padding: 10px 20px;
        border-radius: 10px;
        background: rgba(60, 10, 14, 0.82);
        border: 2px solid var(--fail);
        color: #fff;
        display: none;
        max-width: 80%;
      }
      .banner.show {
        display: block;
      }
      .banner.warn {
        background: rgba(60, 42, 4, 0.82);
        border-color: var(--warn);
      }
      .banner .bt {
        font-family: var(--head);
        font-size: 20px;
        font-weight: 800;
        letter-spacing: 0.1em;
      }
      .banner .bs {
        font-size: 15px;
        font-weight: 600;
        margin-top: 2px;
        color: #f3e9e9;
      }
      .startov {
        position: absolute;
        inset: 0;
        z-index: 5;
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgba(7, 12, 24, 0.55);
        backdrop-filter: blur(2px);
      }
      .startov[hidden] {
        display: none;
      }
      .startbox {
        background: rgba(14, 21, 38, 0.96);
        border: 1px solid var(--line);
        border-radius: 14px;
        padding: 18px 22px;
        max-width: 470px;
        width: calc(100% - 40px);
        box-shadow: 0 20px 50px rgba(0, 0, 0, 0.5);
      }
      .startbox h2 {
        font-family: var(--head);
        font-size: 16px;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        margin: 0 0 10px;
      }
      .startbox ol {
        margin: 0 0 14px;
        padding-left: 20px;
        font-size: 14.5px;
        line-height: 1.45;
        color: var(--mut);
      }
      .startbox ol b {
        color: var(--txt);
      }
      .startbox .btn {
        width: 100%;
        font-size: 13px;
      }
      .noweb {
        position: absolute;
        inset: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
        padding: 20px;
        font-size: 16px;
        background: #0e1628;
        z-index: 7;
      }

      /* ---------- right panel ---------- */
      .badges {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 8px;
        margin-bottom: 12px;
      }
      .badge {
        background: var(--well);
        border: 1px solid var(--line);
        border-radius: 9px;
        padding: 6px 10px;
      }
      .badge small {
        display: block;
        font-family: var(--head);
        font-size: 9.5px;
        letter-spacing: 0.12em;
        color: var(--dim);
        text-transform: uppercase;
      }
      .badge b {
        display: flex;
        align-items: center;
        gap: 7px;
        font-size: 17px;
        font-weight: 700;
        margin-top: 2px;
      }
      .badge b::before {
        content: "";
        width: 10px;
        height: 10px;
        border-radius: 50%;
        background: currentColor;
        flex: 0 0 auto;
      }
      .c-ok {
        color: var(--safe);
      }
      .c-warn {
        color: var(--warn);
      }
      .c-bad {
        color: var(--fail);
      }
      .c-idle {
        color: var(--mut);
      }
      .c-info {
        color: var(--sky);
      }
      .fd {
        background: var(--well);
        border: 1px solid var(--line);
        border-radius: 9px;
        padding: 6px 10px;
      }
      .fd-row {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        gap: 8px;
        padding: 3px 0;
        font-size: 14px;
        border-bottom: 1px dashed rgba(190, 205, 255, 0.08);
      }
      .fd-row:last-child {
        border-bottom: 0;
      }
      .fd-row span {
        color: var(--mut);
        font-weight: 600;
        white-space: nowrap;
      }
      .fd-row b {
        font-family: var(--mono);
        font-size: 13px;
        font-weight: 600;
        white-space: nowrap;
      }
      .frow {
        display: grid;
        grid-template-columns: 96px 1fr 62px;
        align-items: center;
        gap: 8px;
        font-size: 13.5px;
        font-weight: 600;
        margin: 6px 0;
      }
      .frow span {
        color: var(--mut);
        white-space: nowrap;
      }
      .frow b {
        font-family: var(--mono);
        font-size: 12px;
        text-align: right;
        white-space: nowrap;
      }
      .bar {
        position: relative;
        height: 9px;
        border-radius: 5px;
        background: rgba(255, 255, 255, 0.07);
        overflow: hidden;
      }
      .bar i {
        position: absolute;
        left: 0;
        top: 0;
        bottom: 0;
        border-radius: 5px;
        width: 0;
        transition: width 0.1s linear;
      }
      .bar u {
        position: absolute;
        top: -2px;
        bottom: -2px;
        width: 2px;
        background: #fff;
        opacity: 0.75;
      }
      .formula {
        margin-top: 8px;
        background: var(--well);
        border: 1px solid var(--line);
        border-radius: 8px;
        padding: 6px 10px;
        font-family: var(--mono);
        font-size: 12.5px;
        white-space: nowrap;
        color: var(--txt);
      }
      .formula .fx {
        color: var(--sky);
      }
      .formula div + div {
        margin-top: 3px;
        color: var(--mut);
      }
      .skills {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: 4px;
      }
      .skills li {
        display: grid;
        grid-template-columns: 20px 1fr;
        gap: 6px;
        align-items: start;
        font-size: 14px;
        font-weight: 700;
        line-height: 1.2;
        padding: 4px 6px;
        border-radius: 7px;
      }
      .skills li small {
        display: block;
        font-size: 12.5px;
        font-weight: 600;
        color: var(--dim);
        margin-top: 1px;
      }
      .skills li .ck {
        width: 16px;
        height: 16px;
        border-radius: 50%;
        border: 2px solid var(--dim);
        margin-top: 1px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 10px;
        color: #06281c;
      }
      .skills li.next {
        background: rgba(91, 140, 255, 0.12);
        box-shadow: inset 0 0 0 1px rgba(91, 140, 255, 0.4);
      }
      .skills li.done .ck {
        background: var(--safe);
        border-color: var(--safe);
      }
      .skills li.done .ck::after {
        content: "✓";
        font-weight: 800;
      }
      .skills li.done {
        color: var(--mut);
      }
      .log {
        list-style: none;
        margin: 0;
        padding: 0;
        font-size: 13px;
        line-height: 1.35;
        max-height: 170px;
        overflow-y: auto;
      }
      .log li {
        display: grid;
        grid-template-columns: 42px 1fr;
        gap: 6px;
        padding: 3px 0;
        border-bottom: 1px dashed rgba(190, 205, 255, 0.08);
        color: var(--mut);
      }
      .log li b {
        font-family: var(--mono);
        font-size: 11.5px;
        color: var(--dim);
        font-weight: 600;
      }
      .log li.ok span {
        color: var(--safe);
      }
      .log li.bad span {
        color: var(--fail);
      }
      .log li.warn span {
        color: var(--warn);
      }
      .empty {
        font-size: 13px;
        color: var(--dim);
      }

      /* ---------- report modal ---------- */
      .modal {
        position: fixed;
        inset: 0;
        z-index: 9000;
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgba(3, 6, 14, 0.7);
        backdrop-filter: blur(3px);
        padding: 16px;
      }
      .modal[hidden] {
        display: none;
      }
      .rbox {
        background: var(--panel);
        border: 1px solid var(--line);
        border-radius: 14px;
        box-shadow: 0 24px 60px rgba(0, 0, 0, 0.55);
        width: min(860px, 100%);
        max-height: calc(100vh - 32px);
        overflow-y: auto;
        padding: 18px 20px;
      }
      .rhead {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 16px;
        margin-bottom: 12px;
      }
      .rtitle {
        font-family: var(--head);
        font-size: 19px;
        font-weight: 700;
        letter-spacing: 0.06em;
      }
      .rsub {
        font-size: 15px;
        color: var(--mut);
        margin-top: 4px;
        line-height: 1.35;
      }
      .stars {
        font-size: 30px;
        letter-spacing: 3px;
        white-space: nowrap;
        line-height: 1;
      }
      .stars .on {
        color: var(--warn);
      }
      .stars .off {
        color: #334063;
      }
      .rstats {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 8px;
        margin-bottom: 14px;
      }
      .rstat {
        background: var(--well);
        border: 1px solid var(--line);
        border-radius: 9px;
        padding: 7px 10px;
        min-width: 0;
      }
      .rstat small {
        display: block;
        font-family: var(--head);
        font-size: 9.5px;
        letter-spacing: 0.1em;
        color: var(--dim);
        text-transform: uppercase;
      }
      .rstat b {
        display: block;
        font-size: 17px;
        margin-top: 3px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }
      .rcols {
        display: grid;
        grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
        gap: 14px;
      }
      .rbox h4 {
        font-family: var(--head);
        font-size: 11px;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--mut);
        margin: 0 0 8px;
      }
      .rchart {
        background: var(--well);
        border: 1px solid var(--line);
        border-radius: 9px;
        padding: 8px;
      }
      #rChart {
        width: 100%;
        height: 190px;
        display: block;
      }
      .legend {
        display: flex;
        gap: 14px;
        font-size: 13px;
        color: var(--mut);
        margin-top: 4px;
        font-weight: 600;
      }
      .legend i {
        display: inline-block;
        width: 14px;
        height: 3px;
        border-radius: 2px;
        vertical-align: middle;
        margin-right: 5px;
      }
      .tips {
        list-style: none;
        margin: 0 0 12px;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: 6px;
      }
      .tips li {
        background: var(--well);
        border: 1px solid var(--line);
        border-left: 4px solid var(--warn);
        border-radius: 8px;
        padding: 6px 10px;
        font-size: 14px;
        line-height: 1.35;
      }
      .tips li.ok {
        border-left-color: var(--safe);
      }
      .tips li b {
        display: block;
        color: var(--txt);
      }
      .tips li span {
        color: var(--mut);
        font-size: 13px;
      }
      .rskills {
        display: flex;
        flex-wrap: wrap;
        gap: 5px;
      }
      .rskills span {
        font-size: 13px;
        font-weight: 700;
        padding: 3px 8px;
        border-radius: 12px;
        border: 1px solid var(--line);
        color: var(--dim);
      }
      .rskills span.done {
        color: #052a1d;
        background: var(--safe);
        border-color: var(--safe);
      }
      .runs {
        width: 100%;
        border-collapse: collapse;
        font-size: 13.5px;
        margin-top: 4px;
      }
      .runs th,
      .runs td {
        text-align: left;
        padding: 5px 8px;
        border-bottom: 1px solid var(--line);
        white-space: nowrap;
      }
      .runs th {
        font-family: var(--head);
        font-size: 9.5px;
        letter-spacing: 0.1em;
        color: var(--dim);
        text-transform: uppercase;
        font-weight: 600;
      }
      .runs tr.cur td {
        background: rgba(91, 140, 255, 0.1);
      }
      .runwrap {
        overflow-x: auto;
        margin-top: 14px;
      }
      .ract {
        display: flex;
        gap: 8px;
        justify-content: flex-end;
        margin-top: 14px;
      }
      .ract .btn {
        min-width: 140px;
      }
      @media (max-width: 760px) {
        .rstats {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }
        .rcols {
          grid-template-columns: minmax(0, 1fr);
        }
        .rhead {
          flex-direction: column;
        }
      }

      /* ---------- guide buttons + floating guide window ---------- */
      .helpbtns {
        display: flex;
        gap: 8px;
        justify-content: center;
        flex-wrap: wrap;
      }
      .helpbtn {
        appearance: none;
        cursor: pointer;
        font-family: var(--head);
        font-weight: 700;
        font-size: 11.5px;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: #fff;
        background: var(--accent);
        border: 1px solid var(--accent);
        border-radius: 8px;
        padding: 8px 12px;
        box-shadow: 0 6px 14px rgba(91, 140, 255, 0.25);
        transition: transform 0.15s ease, background 0.15s ease;
      }
      .helpbtn:hover {
        transform: translateY(-1px);
      }
      .helpbtn:focus-visible {
        outline: 2px solid var(--txt);
        outline-offset: 2px;
      }
      .helpbtn.on {
        background: var(--elv) !important;
        border-color: var(--elv) !important;
        color: #04221d !important;
      }
      @media (max-width: 760px) {
        .helpbtns .helpbtn {
          font-size: 9.5px;
          padding: 7px 7px;
          letter-spacing: 0.02em;
          white-space: nowrap;
        }
        .helpbtns {
          flex-wrap: nowrap;
          gap: 6px;
        }
      }
      .helpbar {
        display: none;
      }
      .helpbar.floatwin {
        position: fixed !important;
        z-index: 10000 !important;
        display: none;
        flex-direction: column !important;
        background: var(--panel) !important;
        border: 1px solid var(--line) !important;
        border-radius: var(--r) !important;
        box-shadow: 0 18px 45px rgba(0, 0, 0, 0.5) !important;
        overflow: hidden !important;
        min-width: 280px !important;
        min-height: 200px !important;
        margin: 0 !important;
        padding: 0 !important;
        max-width: calc(100vw - 16px) !important;
        max-height: calc(100vh - 16px) !important;
      }
      .helpbar.floatwin.show {
        display: flex !important;
      }
      .fw-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
        padding: 8px 12px;
        background: var(--panel2);
        border-bottom: 1px solid var(--line);
        cursor: move;
        user-select: none;
        -webkit-user-select: none;
        touch-action: none;
        flex: 0 0 auto;
      }
      .fw-title {
        font-family: var(--head);
        font-size: 11.5px;
        font-weight: 700;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--mut);
        display: flex;
        align-items: center;
        gap: 6px;
      }
      .fw-title::before {
        content: "⠿";
        font-size: 13px;
        color: var(--dim);
      }
      .fw-head-actions {
        display: flex;
        align-items: center;
        gap: 6px;
      }
      .fw-tab-btn {
        appearance: none;
        cursor: pointer;
        font-family: var(--head);
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        padding: 4px 8px;
        border-radius: 5px;
        border: 1px solid var(--line);
        background: var(--panel);
        color: var(--mut);
        transition: 0.15s ease;
      }
      .fw-tab-btn:hover {
        border-color: var(--dim);
        color: var(--txt);
      }
      .fw-tab-btn.on {
        background: var(--accent) !important;
        border-color: var(--accent) !important;
        color: #fff !important;
      }
      .fw-close {
        cursor: pointer;
        width: 24px;
        height: 24px;
        border-radius: 6px;
        border: 1px solid var(--line);
        background: var(--panel);
        color: var(--mut);
        font-size: 12px;
        font-weight: 700;
        line-height: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: 0.15s ease;
      }
      .fw-close:hover {
        background: rgba(248, 113, 113, 0.18);
        border-color: var(--fail);
        color: #fff;
      }
      .fw-body {
        flex: 1 1 auto;
        min-height: 0;
        padding: 14px 16px;
        overflow-y: auto;
        font-size: 14.5px;
        line-height: 1.5;
        color: var(--txt);
      }
      .fw-body ol,
      .fw-body ul {
        margin: 0;
        padding-left: 20px;
      }
      .fw-body li {
        margin-bottom: 6px;
      }
      .fw-body b {
        color: var(--sky);
      }
      .fw-body h4 {
        font-family: var(--head);
        font-size: 11px;
        letter-spacing: 0.1em;
        color: var(--elv);
        margin: 14px 0 6px;
        text-transform: uppercase;
      }
      .fw-body h4:first-child {
        margin-top: 0;
      }
      .fw-body table {
        border-collapse: collapse;
        width: 100%;
        font-size: 13.5px;
        margin: 4px 0 8px;
      }
      .fw-body th,
      .fw-body td {
        border: 1px solid var(--line);
        padding: 4px 6px;
        text-align: left;
        vertical-align: top;
      }
      .fw-body th {
        color: var(--mut);
        font-weight: 700;
      }
      .fw-body .sw {
        display: inline-block;
        width: 10px;
        height: 10px;
        border-radius: 2px;
        margin-right: 4px;
        vertical-align: middle;
      }
      .fw-grip {
        position: absolute;
        right: 0;
        bottom: 0;
        width: 16px;
        height: 16px;
        cursor: nwse-resize;
        touch-action: none;
        background: linear-gradient(135deg, transparent 50%, var(--dim) 50%, var(--dim) 58%, transparent 58%, transparent 70%, var(--dim) 70%, var(--dim) 78%, transparent 78%);
      }
      .floatwin.dragging {
        opacity: 0.94;
      }
      .tabpanel {
        display: none;
      }
      .tabpanel.on {
        display: block;
      }

      /* ================= Autonomous Drone additions ================= */
      :root {
        --accent: #12a594;
        --accent-press: #0e8a7c;
        --route: #7cc4ff;
        --aim: #fde047;
        --nfz: #f87171;
      }
      #gameToggle {
        display: grid;
        grid-template-columns: 1fr 1fr;
      }
      #gameToggle button {
        white-space: nowrap;
        font-size: 14px;
      }
      .zlist {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 6px;
      }
      .zlist button {
        display: flex;
        align-items: center;
        gap: 7px;
        text-align: left;
        cursor: pointer;
        border: 1px solid var(--line);
        background: var(--panel2);
        color: var(--txt);
        border-radius: 8px;
        padding: 6px 8px;
        font: inherit;
        font-size: 13.5px;
        font-weight: 600;
        line-height: 1.15;
      }
      .zlist button:hover:not(:disabled) {
        border-color: var(--accent);
      }
      .zlist button.on {
        border-color: var(--aim);
        background: rgba(253, 224, 71, 0.12);
      }
      .zlist button:disabled {
        opacity: 0.45;
        cursor: not-allowed;
      }
      .zlist .zi {
        font-size: 16px;
        width: 20px;
        text-align: center;
        flex: none;
      }
      .wpbtns {
        display: flex;
        gap: 6px;
      }
      .wpbtns button {
        flex: 1;
        cursor: pointer;
        border: 1px solid var(--line);
        background: var(--panel2);
        color: var(--txt);
        border-radius: 8px;
        padding: 6px 8px;
        font: inherit;
        font-size: 13.5px;
        font-weight: 700;
      }
      .wpbtns button:hover:not(:disabled) {
        border-color: var(--accent);
      }
      .wpbtns button:disabled {
        opacity: 0.45;
        cursor: not-allowed;
      }
      .routechk {
        margin: 4px 0 0;
        font-size: 13.5px;
        font-weight: 600;
        line-height: 1.3;
        color: var(--mut);
      }
      .routechk.ok {
        color: var(--safe);
      }
      .routechk.bad {
        color: var(--fail);
      }
      .routechk.warn {
        color: var(--warn);
      }
      .toggle.dirt {
        margin-top: 6px;
      }
      .toggle button:disabled {
        opacity: 0.4;
        cursor: not-allowed;
      }
      .toggle button.lk.on::after {
        content: " 🔒";
        font-size: 10px;
      }
      #plan {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        display: block;
        cursor: crosshair;
        background: #22341f;
        touch-action: none;
      }
      #plan.hide,
      .mapctl.hide,
      .maplegend.hide {
        display: none;
      }
      #plan.grab {
        cursor: grabbing;
      }
      #plan.over {
        cursor: pointer;
      }
      .mapctl {
        position: absolute;
        right: 10px;
        bottom: 10px;
        z-index: 3;
        display: flex;
        flex-direction: column;
        gap: 5px;
      }
      .mapctl button {
        width: 34px;
        height: 34px;
        cursor: pointer;
        border: 1px solid var(--line);
        background: rgba(8, 13, 26, 0.86);
        color: var(--txt);
        border-radius: 8px;
        font-size: 18px;
        font-weight: 700;
        line-height: 1;
      }
      .mapctl button:hover {
        border-color: var(--accent);
      }
      .maplegend {
        position: absolute;
        left: 10px;
        bottom: 10px;
        z-index: 3;
        display: flex;
        flex-wrap: wrap;
        gap: 4px 11px;
        max-width: calc(100% - 70px);
        background: rgba(8, 13, 26, 0.84);
        border: 1px solid var(--line);
        border-radius: 8px;
        padding: 5px 9px;
        font-size: 12.5px;
        font-weight: 600;
        color: var(--mut);
        pointer-events: none;
      }
      .maplegend i {
        display: inline-block;
        width: 11px;
        height: 11px;
        border-radius: 50%;
        margin-right: 5px;
        vertical-align: -1px;
      }
      .lg-base {
        background: #e8edf5;
        border-radius: 2px !important;
      }
      .lg-zone {
        border: 2px solid #ffb020;
      }
      .lg-wp {
        background: var(--route);
      }
      .lg-aim {
        background: var(--aim);
      }
      .lg-nfz {
        background: rgba(248, 113, 113, 0.7);
      }
      .lg-wind {
        background: #c4b5fd;
        border-radius: 2px !important;
        height: 4px !important;
        vertical-align: 2px !important;
      }
      .dropbtn {
        position: absolute;
        left: 50%;
        bottom: 132px;
        transform: translateX(-50%);
        z-index: 4;
        cursor: pointer;
        border: 0;
        border-radius: 14px;
        padding: 12px 26px;
        background: #e5484d;
        color: #fff;
        font-family: var(--head);
        font-size: 18px;
        font-weight: 800;
        letter-spacing: 0.08em;
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.45);
      }
      .dropbtn:hover {
        background: #f0555a;
      }
      .dropbtn:active {
        transform: translateX(-50%) translateY(2px);
      }
      .dropbtn[hidden] {
        display: none;
      }
      .dropbtn kbd {
        font-family: var(--body);
        font-size: 12px;
        background: rgba(255, 255, 255, 0.2);
        border-radius: 4px;
        padding: 1px 6px;
        margin-left: 6px;
        vertical-align: 2px;
      }
      .startbox .kick {
        font-family: var(--head);
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: var(--accent);
        margin-bottom: 2px;
      }
      .startbox .story {
        color: var(--mut);
        margin: 4px 0 8px;
        line-height: 1.35;
      }
      .acc {
        display: flex;
        gap: 12px;
        align-items: center;
      }
      #accCv {
        width: 120px;
        height: 120px;
        border-radius: 10px;
        background: var(--well);
        flex: none;
      }
      .acctxt b {
        display: block;
        font-family: var(--mono);
        font-size: 22px;
        color: var(--txt);
      }
      .acctxt span {
        font-size: 13.5px;
        color: var(--mut);
        line-height: 1.3;
      }
      .fb {
        margin: 8px 0 0;
        font-size: 14px;
        font-weight: 600;
        line-height: 1.35;
        color: var(--mut);
      }
      .fb.ok {
        color: var(--safe);
      }
      .fb.bad {
        color: var(--fail);
      }
      .fb.warn {
        color: var(--warn);
      }
      .scorebars {
        display: flex;
        flex-direction: column;
        gap: 6px;
      }
      .sbar {
        display: grid;
        grid-template-columns: 118px minmax(0, 1fr) 42px;
        gap: 8px;
        align-items: center;
        font-size: 13.5px;
        font-weight: 600;
        color: var(--mut);
      }
      .sbar .tr {
        height: 8px;
        border-radius: 4px;
        background: rgba(255, 255, 255, 0.08);
        overflow: hidden;
      }
      .sbar .tr i {
        display: block;
        height: 100%;
        border-radius: 4px;
        background: var(--accent);
      }
      .sbar b {
        font-family: var(--mono);
        font-size: 13px;
        text-align: right;
        color: var(--txt);
      }
      .sbar.na {
        opacity: 0.5;
      }
      .sbar small {
        grid-column: 1 / -1;
        margin-top: -3px;
        font-size: 12px;
        color: var(--dim);
        font-weight: 500;
      }
      .rdrop {
        height: 210px;
        border-radius: 10px;
        background: var(--well);
        margin-bottom: 10px;
      }
      #rDrop {
        width: 100%;
        height: 100%;
        display: block;
      }
      .about .req {
        color: var(--aim);
      }
      #demoGrid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
      #demoGrid span:last-child {
        grid-column: 1 / -1;
        white-space: normal;
      }
      @media (max-width: 760px) {
        .ovbtns {
          flex-wrap: wrap;
        }
        .ovbtns .btn {
          flex: 1 1 100%;
        }
      }
      .lockline {
        margin: 6px 0 0;
      }
      /* ARM switch and the arm-gesture progress bar */
      .armrow {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 8px;
      }
      .armsw {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 5px 10px 5px 6px;
        border-radius: 999px;
        border: 1px solid var(--line);
        background: var(--well);
        color: var(--dim);
        font-family: var(--head);
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 0.1em;
        cursor: pointer;
      }
      .armsw .sw {
        position: relative;
        width: 34px;
        height: 18px;
        border-radius: 999px;
        background: #3a4560;
        transition: background 0.15s;
      }
      .armsw .sw i {
        position: absolute;
        top: 2px;
        left: 2px;
        width: 14px;
        height: 14px;
        border-radius: 50%;
        background: #cfd8ee;
        transition: left 0.15s;
      }
      .armsw.on {
        color: #34d399;
        border-color: rgba(52, 211, 153, 0.6);
      }
      .armsw.on .sw {
        background: #1f9d6a;
      }
      .armsw.on .sw i {
        left: 18px;
        background: #fff;
      }
      .armsw:focus-visible {
        outline: 2px solid var(--sky);
        outline-offset: 2px;
      }
      .armbar {
        flex: 1;
        height: 6px;
        border-radius: 999px;
        background: var(--well);
        overflow: hidden;
        opacity: 0;
        transition: opacity 0.15s;
      }
      .armbar.show {
        opacity: 1;
      }
      .armbar i {
        display: block;
        height: 100%;
        width: 0;
        background: #34d399;
      }
      .armbar.dis i {
        background: #f5b942;
      }
      .ctrl.na .toggle {
        opacity: 0.45;
      }
      #gameToggle {
        grid-template-columns: repeat(3, minmax(0, 1fr)) !important;
      }
      /* ---------- step guide: the sequence of operations, the current step and the control to use ---------- */
      .guide {
        pointer-events: auto;
        width: min(600px, 100%);
        background: rgba(8, 13, 26, 0.93);
        border: 1px solid rgba(255, 176, 32, 0.6);
        border-radius: 10px;
        padding: 8px 12px 10px;
        box-shadow: 0 10px 26px rgba(0, 0, 0, 0.45);
      }
      .guide[hidden] {
        display: none;
      }
      .guide.fail {
        border-color: var(--fail);
        background: rgba(34, 10, 14, 0.94);
      }
      .guide.ok {
        border-color: var(--safe);
      }
      .g-h {
        display: flex;
        align-items: center;
        gap: 10px;
        font-family: var(--head);
        font-size: 11px;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: #ffcf70;
      }
      .guide.fail .g-h {
        color: #ffb4b4;
      }
      .guide.ok .g-h {
        color: #8ff0c8;
      }
      .g-h b {
        flex: 1;
        min-width: 0;
        font-weight: 700;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
      }
      .g-h span {
        white-space: nowrap;
      }
      .g-h button {
        cursor: pointer;
        border: 1px solid var(--line);
        background: var(--panel2);
        color: var(--mut);
        border-radius: 6px;
        font-size: 12.5px;
        font-weight: 700;
        font-family: var(--body);
        letter-spacing: 0.02em;
        text-transform: none;
        padding: 1px 9px;
      }
      .g-h button:hover {
        color: var(--txt);
        border-color: #ffb020;
      }
      .g-steps {
        display: flex;
        flex-wrap: wrap;
        gap: 4px;
        margin: 7px 0;
        padding: 0;
        list-style: none;
      }
      .g-steps li {
        font-size: 12.5px;
        font-weight: 700;
        line-height: 1;
        padding: 3px 8px 3px 3px;
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.06);
        color: var(--mut);
        border: 1px solid transparent;
        white-space: nowrap;
        display: flex;
        align-items: center;
        gap: 4px;
      }
      .g-steps li i {
        font-style: normal;
        display: inline-grid;
        place-items: center;
        width: 17px;
        height: 17px;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.12);
        font-size: 11px;
      }
      .g-steps li.done {
        color: var(--safe);
      }
      .g-steps li.done i {
        background: rgba(52, 211, 153, 0.22);
      }
      .g-steps li.now {
        color: #1a1203;
        background: #ffb020;
        box-shadow: 0 0 0 2px rgba(255, 176, 32, 0.35);
      }
      .g-steps li.now i {
        background: rgba(0, 0, 0, 0.18);
      }
      .g-steps li.fail {
        color: #fff;
        background: rgba(248, 113, 113, 0.35);
        border-color: var(--fail);
      }
      .g-now {
        font-size: 15px;
        font-weight: 600;
        line-height: 1.42;
        color: var(--txt);
      }
      .g-now b {
        color: #ffcf70;
      }
      .g-now .bad,
      .g-warn .bad {
        color: var(--fail);
      }
      .g-now .okc {
        color: var(--safe);
      }
      .g-now kbd,
      .g-warn kbd {
        color: #ffe2a6;
        border-color: rgba(255, 176, 32, 0.55);
        background: rgba(255, 176, 32, 0.12);
        font-size: 12px;
        margin: 0 1px;
      }
      .g-warn {
        margin-top: 7px;
        padding: 5px 9px;
        border-radius: 6px;
        background: rgba(248, 113, 113, 0.16);
        border-left: 3px solid var(--fail);
        font-size: 14px;
        font-weight: 700;
        line-height: 1.35;
        color: #ffd6d6;
      }
      .g-warn:empty,
      .g-sub:empty,
      .g-act:empty {
        display: none;
      }
      .g-sub {
        margin-top: 5px;
        font-family: var(--mono);
        font-size: 12.5px;
        color: var(--sky);
      }
      .g-bar {
        height: 5px;
        border-radius: 3px;
        background: rgba(255, 255, 255, 0.1);
        overflow: hidden;
        margin-top: 7px;
      }
      .g-bar[hidden] {
        display: none;
      }
      .g-bar i {
        display: block;
        height: 100%;
        width: 0;
        background: #ffb020;
        transition: width 0.2s;
      }
      .g-act {
        display: flex;
        gap: 6px;
        margin-top: 8px;
        flex-wrap: wrap;
      }
      .g-act button {
        cursor: pointer;
        border: 1px solid rgba(255, 176, 32, 0.7);
        background: rgba(255, 176, 32, 0.16);
        color: #ffe2a6;
        border-radius: 7px;
        padding: 5px 12px;
        font-family: var(--body);
        font-size: 14px;
        font-weight: 700;
      }
      .g-act button:hover {
        background: rgba(255, 176, 32, 0.3);
        color: #fff;
      }
      .g-act button.sec {
        border-color: var(--line);
        background: var(--panel2);
        color: var(--mut);
      }
      .g-act button.sec:hover {
        color: var(--txt);
      }
      .guide.min .g-steps,
      .guide.min .g-sub,
      .guide.min .g-bar {
        display: none;
      }
      .guide.min .g-now {
        margin-top: 5px;
        font-size: 14px;
      }
      /* the control the guide wants you to use next */
      .ghl {
        outline: 2px solid #ffb020 !important;
        outline-offset: 2px;
        border-radius: 8px;
        animation: ghl 1.1s infinite;
      }
      @keyframes ghl {
        50% {
          outline-color: rgba(255, 176, 32, 0.2);
        }
      }
      .dropbtn .d2 {
        display: block;
        font-family: var(--body);
        font-size: 13px;
        font-weight: 700;
        letter-spacing: 0.02em;
        margin-top: 2px;
      }
      .dropbtn.in {
        background: #15803d;
      }
      .dropbtn.in:hover {
        background: #16a34a;
      }
      .dropbtn.out {
        background: #b91c1c;
        outline: 2px solid #fca5a5;
      }
      .modechip[hidden] {
        display: none;
      }
      /* phones: the guide sits under the view, full width */
      @media (max-width: 760px) {
        .card.stage {
          height: auto !important;
        }
        .card.stage > .scene-wrap {
          flex: none;
          height: 470px;
        }
        .card.stage > .guide {
          width: 100%;
          margin-top: 8px;
        }
      }
      .startbox ol li.ovnote {
        list-style: none;
        margin: 6px 0 0 -20px;
        padding: 5px 9px;
        border-radius: 6px;
        background: rgba(248, 113, 113, 0.12);
        border-left: 3px solid var(--fail);
        color: #ffd6d6;
      }
      .startbox ol li.ovnote b {
        color: #fff;
      }
    </style>
  </head>
  <body>
    <header class="top">
      <div class="hleft vol">
        <button type="button" class="ghost" id="soundBtn" aria-pressed="false" title="Mute / unmute (M)">🔊</button>
        <label class="vl" for="volSlider">Volume</label>
        <input type="range" id="volSlider" min="0" max="100" step="5" value="70" aria-label="Sound volume" />
        <span class="vv" id="volVal">70%</span>
      </div>
      <div class="title">
        <h1>Autonomous Drone · Sky Parcel</h1>
      </div>
      <div class="helpbtns">
        <button type="button" class="helpbtn" data-tab="use">How To Use</button>
        <button type="button" class="helpbtn" data-tab="learn">What You'll Learn</button>
      </div>
      <div class="helpbar" id="helpbar">
        <div class="tabpanel" data-panel="use">
          <h4>Three ways to play</h4>
          <ul>
            <li><b>Tutorial</b> (start here): three short lessons. 1: plan a route and watch the autopilot deliver. 2: practise every stick movement. 3: fly a delivery by hand. Each step must be done in order; it ticks itself when you do it, and <b>Skip step</b> moves on if you get stuck.</li>
            <li><b>Simulator</b>: plan any delivery you like. Pick a drop zone, the drone, the payload, the wind and how it flies (Autopilot or Manual), then see how precisely the payload is set down.</li>
            <li><b>Sky Parcel missions</b>: you are on a rescue drone team. Eight missions, from <b>First Delivery</b> to the <b>Final Rescue</b>, each teach one idea. Finish a mission to unlock the next one. Some missions fix a setting (shown with a 🔒).</li>
            <li><b>Watch demo</b> (in each mode and on the mission card): the drone flies a good plan while the transmitter sticks and keys on screen show every input. Pause it, hold <b>⏪ Rewind</b> to replay a moment, or press <b>Take control</b> (or any flight key) to fly on yourself.</li>
          </ul>
          <h4>The step guide (top left of the view)</h4>
          <ul>
            <li>In every mode, an orange card lists the steps in order: <b>Zone → Route → Start → Arm → Fly out → Drop → Home</b> for the Autopilot, <b>Zone → Start → Arm → Take off → Fly there → Land in zone → Open claws → Fly home</b> when you fly by hand.</li>
            <li>The current step is orange and says exactly what to do. The <b>button, key or stick to use glows orange</b>: on the left panel, on the keyboard keys and on the transmitter. Done steps turn green ✓.</li>
            <li>Buttons on the card (Start, ARM switch, Retry, Next lesson) do the same as the panel buttons. <b>Less</b> folds the card down to one line.</li>
          </ul>
          <h4>How the delivery works</h4>
          <ul>
            <li>The payload is held under the drone by a <b>claw gripper</b>: two jaws with hooked tips grip its sides.</li>
            <li>The drone flies to the drop point, <b>stops</b>, <b>descends</b> and stands the payload on the ground. Then the claws <b>open</b>, the drone climbs away and flies home.</li>
            <li>Accuracy is where the payload stands, measured from the centre of the zone. The <b>touch-down speed</b> decides whether it arrives intact, dented or damaged.</li>
            <li><b>Failed drop:</b> if the payload ends up <b>outside the target circle</b>, in the lake or at the wrong drop zone, the mission <b>fails</b> at once and ends a few seconds later. Flying by hand, the OPEN CLAWS button turns <b>green</b> inside the zone and <b>red</b> outside it.</li>
          </ul>
          <h4>Plan the mission (on the map)</h4>
          <ol>
            <li><b>Mission target</b>: click a drop zone on the map, or pick it in the list on the left. Read the mission card: in some missions only one zone is the right one.</li>
            <li><b>Waypoints</b>: click the map to add route points. The autopilot flies from the base through each waypoint, in order, to the drop point. Drag a waypoint to move it, right-click it to remove it, or use <b>Remove last</b> / <b>Clear route</b>. In Manual flight the route is a dashed guide line for you.</li>
            <li>The route line turns <b>red</b> where it crosses a <b>no-fly zone</b> or passes too close above trees, houses or the radio mast. Fix it with waypoints or a higher altitude.</li>
            <li><b>Drop point</b> ⊕ (yellow): where the drone lands the payload. It starts at the zone centre; drag it if you want it somewhere else in the zone.</li>
            <li>Set the <b>Flight</b> mode, <b>Altitude</b>, <b>Speed</b> and <b>Payload</b>, press <b>Start</b> <kbd>Enter</kbd>, then <b>arm the motors</b>.</li>
          </ol>
          <h4>Arming the motors</h4>
          <ul>
            <li>Like a real drone, the motors only start once they are <b>armed</b>, and only on the ground with the throttle stick down.</li>
            <li><b>Arm with the sticks</b>: hold <kbd>S</kbd> + <kbd>D</kbd> together for one second (left stick down and to the right). <b>Disarm</b> on the ground: hold <kbd>S</kbd> + <kbd>A</kbd> (down and to the left).</li>
            <li>Or flip the <b>ARM switch</b> on the transmitter (<kbd>E</kbd>). It will not switch off while the drone is in the air.</li>
          </ul>
          <h4>Flight modes</h4>
          <ul>
            <li><b>Autopilot</b>: once armed, the drone flies the whole mission by itself: take-off, route, stop over the drop point, set-down, release, return and landing. Press <kbd>T</kbd> during the flight to take manual control.</li>
            <li><b>Manual</b>: you fly everything with the transmitter. Land the payload in the zone, press <kbd>Space</kbd> (or <b>OPEN CLAWS</b>) to let go of it, then fly home and land on the base pad. The motors disarm by themselves on the pad.</li>
            <li><b>Flight assist</b> (Manual, <kbd>H</kbd>): <b>GPS</b> holds the height and position when you let go, and the sticks set the speed. <b>ATTI</b> holds only the height: the stick tilts the drone, and the wind carries it away. <b>Off</b>: the throttle sets the motor power directly and nothing is held for you.</li>
          </ul>
          <h4>The transmitter (Mode 2)</h4>
          <ul>
            <li><b>Left stick up / down = Throttle</b> <kbd>W</kbd><kbd>S</kbd>. With GPS or ATTI it springs back to the middle: up climbs, middle holds the height, down descends. With assist Off it stays where you leave it (a tap moves it 5%).</li>
            <li><b>Left stick left / right = Yaw</b> <kbd>A</kbd><kbd>D</kbd>: turns the drone on the spot.</li>
            <li><b>Right stick up / down = Pitch</b> <kbd>↑</kbd><kbd>↓</kbd>: forward and back. <b>Right stick left / right = Roll</b> <kbd>←</kbd><kbd>→</kbd>: sideways.</li>
            <li>Hold <kbd>Shift</kbd> for half-stick fine control. <kbd>I</kbd><kbd>J</kbd><kbd>K</kbd><kbd>L</kbd> also work as the right stick. You can drag the sticks with the mouse or a finger, or plug in a USB transmitter or gamepad.</li>
          </ul>
          <h4>During the flight</h4>
          <ul>
            <li><b>Map / 3D</b> <kbd>V</kbd> switches between the live map and the 3D view. <b>Camera</b> <kbd>C</kbd>: Chase, Top, Drone cam and Base. Drag the 3D view to look around; double-click to reset.</li>
            <li>Along the bottom of the 3D view: motors, speed, battery, payload, distance to the drop point and, in Manual, the <b>stopping distance</b>. The altitude meter is on the left, the mini-map top right. Flying by hand with a payload, a yellow cross on the ground marks the spot right below the drone.</li>
            <li>The mission ends with a report: status, set-down accuracy, the score factors, coach feedback and a comparison with your earlier runs.</li>
          </ul>
          <h4>Other keys</h4>
          <ul>
            <li><kbd>1</kbd><kbd>2</kbd><kbd>3</kbd> altitude · <kbd>4</kbd><kbd>5</kbd><kbd>6</kbd> speed · <kbd>7</kbd><kbd>8</kbd><kbd>9</kbd> payload · <kbd>T</kbd> Autopilot / Manual · <kbd>H</kbd> flight assist · <kbd>G</kbd> drone · <kbd>E</kbd> ARM switch</li>
            <li><kbd>Backspace</kbd> remove the last waypoint · <kbd>Space</kbd> open the claws · <kbd>Enter</kbd> start / pause · <kbd>R</kbd> retry · <kbd>V</kbd> map / 3D · <kbd>C</kbd> camera · <kbd>M</kbd> mute · <kbd>−</kbd><kbd>=</kbd> volume</li>
          </ul>
        </div>
        <div class="tabpanel" data-panel="learn">
          <h4>How a delivery drone lands a payload</h4>
          <table>
            <tr><th>Part of the mission</th><th>What it controls</th><th>What goes wrong if it is off</th></tr>
            <tr><td>Route planning (waypoints)</td><td>Where the drone flies</td><td>It crosses a no-fly zone or hits an obstacle</td></tr>
            <tr><td>Altitude</td><td>Safe clearance over trees, roofs and the mast</td><td>Too low: it hits something. Higher: a longer climb and descent</td></tr>
            <tr><td>Speed and braking</td><td>How far it travels before it stops</td><td>Too fast near the target: it overshoots</td></tr>
            <tr><td>Payload weight</td><td>Thrust needed, braking and battery use</td><td>Heavy: more throttle to hover, longer stopping distance</td></tr>
            <tr><td>Set-down</td><td>Where and how gently the payload touches the ground</td><td>Off centre, or a hard touch-down that dents it</td></tr>
          </table>
          <h4>Key ideas</h4>
          <ul>
            <li>To hover, the rotors must push up with the drone's whole weight: <b>thrust = m × g</b>. A payload in the claws adds to <b>m</b>, so the drone needs more throttle and uses more battery.</li>
            <li>A drone moves sideways by <b>tilting</b>: part of the thrust then pushes it along. To stop, it tilts the other way. A heavier drone gets less deceleration from the same tilt.</li>
            <li><b>Stopping distance ≈ v² ÷ 2a</b>: twice the speed needs four times the distance. Start slowing down early.</li>
            <li>In wind, the drone must lean into the wind to stay in one place. GPS hold does this by itself; in ATTI mode the pilot must do it.</li>
            <li>An <b>autonomous</b> drone does all of this itself: it follows the waypoints, holds its height and speed, stops over the drop point, descends gently and opens its claws. A good plan still matters: it can only fly where the route takes it.</li>
          </ul>
        </div>
      </div>
    </header>

    <main class="grid">
      <section class="card controls" aria-label="Mission mode and mission plan">
        <h3>Mode</h3>
        <div class="toggle gtabs" id="gameToggle">
          <button type="button" data-v="learn">Tutorial</button>
          <button type="button" data-v="sim" class="on">Simulator</button>
          <button type="button" data-v="mission">Missions</button>
        </div>
        <div class="modepanel" id="modePanel"></div>
        <div class="actions">
          <button type="button" class="btn start" id="startBtn">▶ Start</button>
          <button type="button" class="btn reset" id="endBtn" disabled>⏹ Abort</button>
          <button type="button" class="btn reset" id="resetBtn">↺ Retry</button>
        </div>

        <h3 class="sec">Transmitter <em>Mode 2</em></h3>
        <div class="tx">
          <div class="armrow">
            <button type="button" class="armsw" id="armBtn" aria-pressed="false" title="ARM switch (E): starts and stops the motors. Only on the ground, with the throttle down."><span class="sw"><i></i></span><span class="at" id="armTxt">DISARMED</span></button>
            <div class="armbar" id="armBarBox" title="Arm gesture: hold S + D for one second"><i id="armBar"></i></div>
          </div>
          <div class="sticks">
            <div class="stickbox">
              <span class="sl">Throttle · Yaw</span>
              <div class="gimbal" id="stickL" aria-label="Left stick: throttle up and down, yaw left and right">
                <i class="ax v" id="axThr" style="background: var(--thr)"></i><i class="ax h" id="axRud" style="background: var(--rud)"></i>
                <span class="tag t">Up</span><span class="tag b">Down</span><span class="tag l">L</span><span class="tag r">R</span>
                <div class="knob" id="knobL"></div>
              </div>
            </div>
            <div class="stickbox">
              <span class="sl">Pitch · Roll</span>
              <div class="gimbal" id="stickR" aria-label="Right stick: push up to fly forward, pull down to fly back, left and right to fly sideways">
                <i class="ax v" id="axElv" style="background: var(--elv)"></i><i class="ax h" id="axAil" style="background: var(--ail)"></i>
                <span class="tag t">Fwd</span><span class="tag b">Back</span><span class="tag l">L</span><span class="tag r">R</span>
                <div class="knob" id="knobR"></div>
              </div>
            </div>
          </div>
          <div class="chan">
            <div class="ch"><span class="nm"><i style="background: var(--thr)"></i>Throttle</span><span class="cb"><i id="cbThr" style="background: var(--thr)"></i></span><span class="cv" id="cvThr">Hold</span></div>
            <div class="ch"><span class="nm"><i style="background: var(--rud)"></i>Yaw</span><span class="cb"><u></u><i id="cbRud" style="background: var(--rud)"></i></span><span class="cv" id="cvRud">Centre</span></div>
            <div class="ch"><span class="nm"><i style="background: var(--elv)"></i>Pitch</span><span class="cb"><u></u><i id="cbElv" style="background: var(--elv)"></i></span><span class="cv" id="cvElv">Neutral</span></div>
            <div class="ch"><span class="nm"><i style="background: var(--ail)"></i>Roll</span><span class="cb"><u></u><i id="cbAil" style="background: var(--ail)"></i></span><span class="cv" id="cvAil">Neutral</span></div>
          </div>
        </div>
        <p class="gpad assistline" id="assistInfo"></p>
        <p class="gpad" id="gpad">USB transmitter / gamepad: not connected</p>

        <h3 class="sec">Mission Plan <em id="planState">planning</em></h3>
        <div class="ctrl">
          <div class="row"><label>Mission target</label><span class="val" id="tgtVal">Pick a drop zone</span></div>
          <div class="zlist" id="zoneList"></div>
        </div>
        <div class="ctrl" id="wpCtrl">
          <div class="row"><label>Waypoints<kbd>⌫</kbd></label><span class="val" id="wpVal">0 points</span></div>
          <div class="wpbtns">
            <button type="button" id="wpUndo">Remove last</button>
            <button type="button" id="wpClear">Clear route</button>
          </div>
          <p class="hint">Click the map to add a waypoint. Drag to move it, right-click to remove it.</p>
          <p class="routechk" id="routeChk"></p>
        </div>
        <div class="ctrl">
          <div class="row"><label>Drone<kbd>G</kbd></label><span class="val" id="drnVal">Scout quad</span></div>
          <div class="toggle" id="drnToggle">
            <button type="button" data-v="quad" class="on">Scout quad</button>
            <button type="button" data-v="hexa">Cargo hexa</button>
          </div>
          <p class="hint" id="drnHint"></p>
        </div>
        <div class="ctrl" id="altCtrl">
          <div class="row"><label>Altitude<kbd>1 2 3</kbd></label><span class="val" id="altVal">Medium · 25 m</span></div>
          <div class="toggle" id="altToggle">
            <button type="button" data-v="low">Low</button>
            <button type="button" data-v="med" class="on">Medium</button>
            <button type="button" data-v="high">High</button>
          </div>
        </div>
        <div class="ctrl">
          <div class="row"><label>Drone speed<kbd>4 5 6</kbd></label><span class="val" id="spdVal">Medium · 7 m/s</span></div>
          <div class="toggle" id="spdToggle">
            <button type="button" data-v="slow">Slow</button>
            <button type="button" data-v="med" class="on">Medium</button>
            <button type="button" data-v="fast">Fast</button>
          </div>
        </div>
        <div class="ctrl">
          <div class="row"><label>Payload<kbd>7 8 9</kbd></label><span class="val" id="payVal">Food packet · 1.5 kg</span></div>
          <div class="toggle" id="payToggle">
            <button type="button" data-v="light">Light</button>
            <button type="button" data-v="med" class="on">Medium</button>
            <button type="button" data-v="heavy">Heavy</button>
          </div>
        </div>
        <div class="ctrl">
          <div class="row"><label>Flight<kbd>T</kbd></label><span class="val" id="modeVal">Autopilot</span></div>
          <div class="toggle" id="dropToggle">
            <button type="button" data-v="auto" class="on">Autopilot</button>
            <button type="button" data-v="manual">Manual</button>
          </div>
          <p class="hint" id="dropHint"></p>
        </div>
        <div class="ctrl" id="assistCtrl">
          <div class="row"><label>Flight assist<kbd>H</kbd></label><span class="val" id="assistVal">GPS</span></div>
          <div class="toggle" id="assistToggle">
            <button type="button" data-v="gps" class="on">GPS</button>
            <button type="button" data-v="atti">ATTI</button>
            <button type="button" data-v="off">Off</button>
          </div>
          <p class="hint" id="assistHint"></p>
        </div>
        <div class="ctrl" id="windCtrl">
          <div class="row"><label>Wind</label><span class="val" id="windVal">Calm</span></div>
          <div class="toggle" id="windToggle">
            <button type="button" data-v="none" class="on">None</button>
            <button type="button" data-v="light">Light</button>
            <button type="button" data-v="strong">Strong</button>
          </div>
          <div class="toggle dirt" id="dirToggle">
            <button type="button" data-v="0">From N</button>
            <button type="button" data-v="90">From E</button>
            <button type="button" data-v="180">From S</button>
            <button type="button" data-v="270" class="on">From W</button>
          </div>
        </div>
        <p class="hint setnote" id="lockNote" hidden></p>

        <h3 class="sec">View</h3>
        <div class="ctrl inline">
          <label>Show<kbd>V</kbd></label>
          <div class="toggle" id="viewToggle">
            <button type="button" data-v="map" class="on">Map</button>
            <button type="button" data-v="3d">3D</button>
          </div>
        </div>
        <div class="ctrl inline">
          <label>Camera<kbd>C</kbd></label>
          <div class="toggle" id="camToggle">
            <button type="button" data-v="chase" class="on">Chase</button>
            <button type="button" data-v="top">Top</button>
            <button type="button" data-v="cam">Drone cam</button>
            <button type="button" data-v="base">Base</button>
          </div>
        </div>
        <p class="hint camhint" id="camHint"></p>
        <div class="ctrl inline">
          <label>Drag view</label>
          <div class="toggle" id="dragToggle">
            <button type="button" data-v="on" class="on">On</button>
            <button type="button" data-v="off">Off</button>
          </div>
        </div>
        <div class="ctrl inline">
          <label>Time</label>
          <div class="toggle" id="todToggle">
            <button type="button" data-v="morning">Morning</button>
            <button type="button" data-v="midday" class="on">Midday</button>
            <button type="button" data-v="sunset">Sunset</button>
          </div>
        </div>

        <h3 class="sec">Keyboard <em>keys light up when pressed</em></h3>
        <div class="kb">
          <div class="kbgrp">
            <div class="kbt">Left stick</div>
            <div class="kbpad">
              <span class="kc thr" data-k="KeyW" style="grid-area: u">W</span>
              <span class="kc rud" data-k="KeyA" style="grid-area: l">A</span>
              <span class="kc thr" data-k="KeyS" style="grid-area: d">S</span>
              <span class="kc rud" data-k="KeyD" style="grid-area: r">D</span>
            </div>
            <div class="kbl"><b class="t-thr">W / S</b> throttle<br /><b class="t-rud">A / D</b> yaw</div>
          </div>
          <div class="kbgrp">
            <div class="kbt">Right stick</div>
            <div class="kbpad">
              <span class="kc elv" data-k="ArrowUp" style="grid-area: u">↑</span>
              <span class="kc ail" data-k="ArrowLeft" style="grid-area: l">←</span>
              <span class="kc elv" data-k="ArrowDown" style="grid-area: d">↓</span>
              <span class="kc ail" data-k="ArrowRight" style="grid-area: r">→</span>
            </div>
            <div class="kbl"><b class="t-elv">↑ / ↓</b> forward · back<br /><b class="t-ail">← / →</b> sideways</div>
          </div>
        </div>
        <div class="kbrows">
          <div><span><span class="kc sm" data-k="KeyS">S</span><span class="kc sm" data-k="KeyD">D</span></span>hold 1 s to arm · S + A to disarm</div>
          <div><span><span class="kc sm" data-k="KeyE">E</span></span>ARM switch on / off</div>
          <div><span><span class="kc sm wide" data-k="Space">Space</span></span>open the claws (Manual)</div>
          <div><span><span class="kc sm" data-k="KeyT">T</span></span>Autopilot / Manual · in flight: take control</div>
          <div><span><span class="kc sm" data-k="KeyH">H</span></span>flight assist GPS / ATTI / Off</div>
          <div><span><span class="kc sm wide" data-k="Shift">Shift</span></span>hold for fine control (half stick)</div>
          <div><span><span class="kc sm" data-k="Digit1">1</span><span class="kc sm" data-k="Digit2">2</span><span class="kc sm" data-k="Digit3">3</span></span>altitude Low / Medium / High</div>
          <div><span><span class="kc sm" data-k="Digit4">4</span><span class="kc sm" data-k="Digit5">5</span><span class="kc sm" data-k="Digit6">6</span></span>speed Slow / Medium / Fast</div>
          <div><span><span class="kc sm" data-k="Digit7">7</span><span class="kc sm" data-k="Digit8">8</span><span class="kc sm" data-k="Digit9">9</span></span>payload Light / Medium / Heavy</div>
          <div><span><span class="kc sm" data-k="KeyG">G</span></span>drone Scout quad / Cargo hexa</div>
          <div><span><span class="kc sm wide" data-k="Backspace">⌫</span></span>remove the last waypoint</div>
          <div><span><span class="kc sm wide" data-k="Enter">Enter</span></span>start / pause</div>
          <div><span><span class="kc sm" data-k="KeyR">R</span></span>retry the mission</div>
          <div><span><span class="kc sm" data-k="KeyV">V</span><span class="kc sm" data-k="KeyC">C</span></span>map / 3D · change camera</div>
          <div><span><span class="kc sm" data-k="KeyM">M</span><span class="kc sm" data-k="Minus">−</span><span class="kc sm" data-k="Equal">=</span></span>mute · volume down / up</div>
        </div>
      </section>

      <section class="card stage" aria-label="Mission map and 3D view">
        <div class="scene-wrap" id="sceneWrap">
          <div id="gl"></div>
          <canvas id="hud" role="img" aria-label="Altitude meter, speed, battery, payload status and mini-map"></canvas>
          <canvas id="plan" role="img" aria-label="Top-view mission map: drop zones, waypoints, route, no-fly zones and wind"></canvas>
          <div class="mapctl" id="mapCtl">
            <button type="button" id="zoomIn" title="Zoom in (mouse wheel)">+</button>
            <button type="button" id="zoomOut" title="Zoom out (mouse wheel)">−</button>
            <button type="button" id="zoomFit" title="Show the whole area">⤢</button>
          </div>
          <div class="maplegend" id="mapLegend">
            <span><i class="lg-base"></i>Base</span><span><i class="lg-zone"></i>Drop zone</span><span><i class="lg-wp"></i>Waypoint</span><span><i class="lg-aim"></i>Drop point</span><span><i class="lg-nfz"></i>No-fly zone</span><span><i class="lg-wind"></i>Wind</span>
          </div>
          <div class="ovl">
            <div class="modechip" id="modeChip" hidden>Plan your mission on the map.</div>
            <div class="guide" id="guide" aria-live="polite">
              <div class="g-h"><b id="gTitle">Simulator</b><span id="gCount"></span><button type="button" id="gMin" title="Show less or more of the guide">Less</button></div>
              <ol class="g-steps" id="gSteps"></ol>
              <div class="g-now" id="gNow"></div>
              <div class="g-warn" id="gWarn"></div>
              <div class="g-sub" id="gSub"></div>
              <div class="g-bar" id="gBarBox" hidden><i id="gBar"></i></div>
              <div class="g-act" id="gAct"></div>
            </div>
            <div class="demobar" id="demoBar" hidden>
              <div class="db-h"><span class="db-t" id="demoTitle">Autopilot demo</span><button type="button" class="rw" id="demoRew" title="Press and hold to play the mission backwards; let go to stop there, then press Resume">⏪ Hold to rewind</button><button type="button" id="demoPause" title="Pause or resume the demo (Enter)">❚❚ Pause</button><button type="button" id="demoTake" title="Stop the demo and fly on from here yourself, in Manual">✋ Take control</button><button type="button" id="demoStop" title="Stop the demo and plan your own mission">⏹ Stop</button></div>
              <div class="db-a" id="demoAct"></div>
              <div class="db-c">
                <div class="kb2" aria-label="Keyboard keys the demo pilot is pressing">
                  <figure><div class="kg"><span class="u" data-dk="KeyW">W</span><span class="l" data-dk="KeyA">A</span><span class="d" data-dk="KeyS">S</span><span class="r" data-dk="KeyD">D</span></div><figcaption>W S throttle<br />A D yaw</figcaption></figure>
                  <figure><div class="kg"><span class="u" data-dk="ArrowUp">↑</span><span class="l" data-dk="ArrowLeft">←</span><span class="d" data-dk="ArrowDown">↓</span><span class="r" data-dk="ArrowRight">→</span></div><figcaption>↑ ↓ forward · back<br />← → sideways</figcaption></figure>
                </div>
                <div class="tx2" aria-label="Transmitter sticks as the demo pilot moves them">
                  <figure><div class="gim2"><i id="dsL"></i></div><figcaption>Left stick</figcaption></figure>
                  <figure><div class="gim2"><i id="dsR"></i></div><figcaption>Right stick</figcaption></figure>
                </div>
              </div>
              <div class="db-g" id="demoGrid"></div>
              <div class="db-k" id="demoKey">Keys light up as the demo pilot presses them (brighter = held longer). The squares show the same input on the transmitter sticks.</div>
            </div>
            <div class="toasts" id="toasts" aria-live="polite"></div>
          </div>
          <button type="button" class="dropbtn" id="dropBtn" hidden>✋ OPEN CLAWS <kbd>Space</kbd><span class="d2" id="dropSub"></span></button>
          <div class="banner" id="banner" aria-live="assertive"><div class="bt" id="bannerT"></div><div class="bs" id="bannerS"></div></div>
          <div class="startov" id="startOv">
            <div class="startbox">
              <div class="kick" id="ovKick">Simulator</div>
              <h2 id="ovTitle">Plan a delivery</h2>
              <p class="story" id="ovStory"></p>
              <ol id="ovList"></ol>
              <div class="ovbtns">
                <button type="button" class="btn start" id="ovPlan">🗺 Plan the mission</button>
                <button type="button" class="btn reset" id="ovDemo">👁 Watch demo</button>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section class="card readings" aria-label="Mission status, flight data, drop physics and score">
        <div class="badges">
          <div class="badge"><small>Mission status</small><b id="bStatus" class="c-idle">Planning</b></div>
          <div class="badge"><small>Payload</small><b id="bPay" class="c-info">In the claws</b></div>
        </div>
        <h3>Flight Data</h3>
        <div class="fd">
          <div class="fd-row"><span>Phase</span><b id="dPhase">On the launch pad</b></div>
          <div class="fd-row"><span>Altitude</span><b id="dAlt">0.0 m</b></div>
          <div class="fd-row"><span>Ground speed</span><b id="dSpd">0.0 m/s</b></div>
          <div class="fd-row"><span>Thrust used</span><b id="dThr">0%</b></div>
          <div class="fd-row"><span>Claws</span><b id="dSw">Closed</b></div>
          <div class="fd-row"><span>To drop point</span><b id="dTgt">—</b></div>
          <div class="fd-row"><span>Wind at drone</span><b id="dWind">Calm</b></div>
          <div class="fd-row"><span>Battery</span><b id="dBat">100%</b></div>
          <div class="fd-row"><span>Mission time</span><b id="dTime">0:00</b></div>
        </div>

        <h3 class="sec">Delivery Physics <em id="dpTag">for this plan</em></h3>
        <div class="formula">
          <div><span class="fx">Hover thrust = m × g</span></div>
          <div id="fFall">= 6.0 kg × 9.81 ≈ 59 N</div>
          <div><span class="fx">Stopping distance ≈ v² ÷ 2a</span></div>
          <div id="fThrow">= 7² ÷ (2 × 2.6) ≈ 9 m</div>
          <div><span class="fx">Lean into wind ≈ drag ÷ weight</span></div>
          <div id="fDrift">= 0° (calm)</div>
        </div>
        <p class="hint">Numbers come from the same physics the drone uses: drone and payload mass, speed, braking and wind.</p>

        <h3 class="sec">Set-down Accuracy</h3>
        <div class="acc">
          <canvas id="accCv" width="120" height="120" aria-label="Target zone with the payload landing point"></canvas>
          <div class="acctxt">
            <b id="accVal">—</b>
            <span id="accSub">Not delivered yet</span>
          </div>
        </div>
        <p class="fb" id="accFb"></p>

        <h3 class="sec"><span id="objTitle">Mission Checklist</span> <em id="objCount">0 / 4</em></h3>
        <ul class="skills" id="objList"></ul>

        <h3 class="sec">Score <em id="scoreTot">after the mission</em></h3>
        <div class="scorebars" id="scoreBars"></div>

        <h3 class="sec">Mission Log</h3>
        <ul class="log" id="log"><li class="empty" style="display: block; border: 0">Events appear here during the mission.</li></ul>
      </section>
    </main>

    <div class="modal" id="report" hidden role="dialog" aria-modal="true" aria-labelledby="rTitle">
      <div class="rbox">
        <div class="rhead">
          <div>
            <div class="rtitle" id="rTitle">Mission Report</div>
            <div class="rsub" id="rSub"></div>
          </div>
          <div class="stars" id="rStars" aria-label="Stars"></div>
        </div>
        <div class="rstats" id="rStats"></div>
        <div class="rcols">
          <div>
            <h4>Altitude and speed over the mission</h4>
            <div class="rchart">
              <canvas id="rChart"></canvas>
              <div class="legend"><span><i style="background: var(--sky)"></i>Altitude (m)</span><span><i style="background: var(--thr)"></i>Speed (m/s)</span><span><i style="background: var(--ail)"></i>Claws opened</span></div>
            </div>
            <h4>Score factors</h4>
            <div class="scorebars" id="rScore"></div>
          </div>
          <div>
            <h4>Where the payload was set down</h4>
            <div class="rdrop"><canvas id="rDrop"></canvas></div>
            <h4>Coach feedback</h4>
            <ul class="tips" id="rTips"></ul>
          </div>
        </div>
        <div class="runwrap">
          <h4>Your missions (compare)</h4>
          <table class="runs" id="rRuns"></table>
        </div>
        <div class="ract">
          <button type="button" class="btn start" id="rNext" hidden>▶ Next Mission</button>
          <button type="button" class="btn start" id="rAgain">↺ Retry Mission</button>
          <button type="button" class="btn reset" id="rPlan">🗺 Edit the plan</button>
          <button type="button" class="btn reset" id="rClose">Close</button>
        </div>
      </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/three@0.128.0/build/three.min.js"></script>
    <script>
      (() => {
        "use strict";
        const $ = (id) => document.getElementById(id);
        const D2R = Math.PI / 180,
          R2D = 180 / Math.PI,
          TAU = Math.PI * 2;
        const clamp = (v, a, b) => Math.max(a, Math.min(b, v));
        const lerp = (a, b, t) => a + (b - a) * t;
        const smooth = (t) => {
          t = clamp(t, 0, 1);
          return t * t * (3 - 2 * t);
        };
        const wrap360 = (d) => ((d % 360) + 360) % 360;
        const wrapPi = (a) => Math.atan2(Math.sin(a), Math.cos(a));
        const fmtT = (s) => {
          s = Math.max(0, Math.floor(s));
          return Math.floor(s / 60) + ":" + String(s % 60).padStart(2, "0");
        };
        const CARD = (deg) => ["N", "NE", "E", "SE", "S", "SW", "W", "NW"][Math.round(wrap360(deg) / 45) % 8];
        const FONT_M = '"IBM Plex Mono", Consolas, monospace';
        const FONT_B = "Rajdhani, sans-serif";
        const wrapEl = $("sceneWrap");
        if (typeof THREE === "undefined") {
          const d = document.createElement("div");
          d.className = "noweb";
          d.textContent = "The 3D view needs an internet connection to load. Please connect and reload the page.";
          wrapEl.appendChild(d);
          return;
        }
        const V3 = (x, y, z) => new THREE.Vector3(x, y, z);

        /* ================= constants ================= */
        const G = 9.81,
          RHO = 1.225;
        const BASE = { x: 0, z: 0 };
        const OPER = { x: -7, z: 9 };
        const MAP_HALF = 320; // the mission area shown on the map, metres from the base
        const ALT = {
          low: { h: 10, n: "Low" },
          med: { h: 25, n: "Medium" },
          high: { h: 45, n: "High" },
        };
        // cruise speed, then the autopilot's descent speed (dn) and its final, gentle set-down speed (df)
        const SPD = {
          slow: { v: 4, n: "Slow", dn: 1.5, df: 0.45 },
          med: { v: 7, n: "Medium", dn: 2.2, df: 0.6 },
          fast: { v: 11, n: "Fast", dn: 3, df: 0.8 },
        };
        // manual flight: what the flight controller does for the pilot
        const ASSIST = {
          gps: { n: "GPS", d: "GPS hold: the sticks set the speed. Let go and the drone brakes and holds its height and position, even in wind." },
          atti: { n: "ATTI", d: "ATTI (attitude) mode: the right stick tilts the drone, and it holds only its height. Let go and it coasts on, and the wind carries it away." },
          off: { n: "Off", d: "Full manual: the throttle sets the motor power (it hovers at about half throttle), the right stick tilts the drone. Nothing is held for you." },
        };
        const VMAN = 8; // full stick in GPS mode = 8 m/s
        // same box size, different mass: drag matters much more for the light one
        const PAY = {
          // okV / dentV: touch-down speeds (m/s) up to which it arrives intact / only dented
          light: { n: "Light", item: "Medicine pouch", m: 0.4, cda: 0.075, col: 0xf4f4f2, band: 0xd62f2f, okV: 3.5, dentV: 6 },
          med: { n: "Medium", item: "Food packet", m: 1.5, cda: 0.075, col: 0xc49a62, band: 0x6b4423, okV: 2.5, dentV: 4.5 },
          heavy: { n: "Heavy", item: "Tool kit", m: 3.5, cda: 0.075, col: 0xf08a24, band: 0x2b2b2b, okV: 1.8, dentV: 3.5 },
        };
        // two airframes: an agile quad and a steady six-rotor cargo drone
        const DRONES = {
          quad: { n: "Scout quad", short: "Quad", rotors: 4, m: 4.5, thrust: 118, tilt: 32 * D2R, tau: 0.12, kv: 1.6, cda: 0.07, scale: 1.85, drain: 1.15, arm: 0.62, prop: 0.3, d: "Agile: light and quick to turn, but gusts push it around more." },
          hexa: { n: "Cargo hexa", short: "Hexa", rotors: 6, m: 7.5, thrust: 215, tilt: 26 * D2R, tau: 0.16, kv: 2.1, cda: 0.08, scale: 2.2, drain: 0.85, arm: 0.72, prop: 0.27, d: "Steady: heavier with six rotors, holds its line in wind and flies longer, but turns wider." },
        };
        // size-dependent numbers (set by droneDims): drawing scale and the height of the body above the skids
        let DSCALE = 1.85,
          LEG = 0.68;
        function droneDims(k) {
          DSCALE = DRONES[k].scale;
          LEG = 0.367 * DSCALE;
        }
        const ZONES = [
          { k: "meadow", n: "Meadow", x: 10, z: -150, ic: "🌾", d: "open grass north of the base" },
          { k: "clinic", n: "Village clinic", x: 205, z: -55, ic: "✚", d: "courtyard of the village health post" },
          { k: "farm", n: "Farmhouse", x: -185, z: -60, ic: "🏠", d: "yard beside the barn" },
          { k: "camp", n: "Forest camp", x: -120, z: -262, ic: "⛺", d: "rescue camp in a forest clearing" },
          { k: "island", n: "Lake island", x: 160, z: 175, ic: "🏝", d: "small island in the lake" },
        ];
        const zoneOf = (k) => ZONES.find((z) => z.k === k);
        const LAKE = { x: 160, z: 175, r: 62 },
          ISLAND_R = 16,
          ISLAND_H = 0.8; // the island's grassy top stands 0.8 m above the water
        const lakeR = (a) => LAKE.r * (1 + 0.1 * Math.sin(3 * a + 0.7) + 0.06 * Math.sin(5 * a + 2.1));
        // island shoreline: a slightly irregular outline, never closer than 13.6 m to the centre
        const islandR = (a) => ISLAND_R * (1 + 0.09 * Math.sin(3 * a + 1.3) + 0.06 * Math.sin(5 * a + 0.4));
        // height of the island ground: flat grass in the middle, a sandy beach sloping to the water
        function islandH(x, z) {
          const dx = x - LAKE.x,
            dz = z - LAKE.z;
          const d = Math.hypot(dx, dz);
          if (d > ISLAND_R * 1.2) return 0;
          const R = islandR(Math.atan2(dz, dx));
          if (d > R) return 0;
          const t = Math.min(1, Math.max(0, (R - d) / 3.4));
          return 0.14 + (ISLAND_H - 0.14) * t * t * (3 - 2 * t);
        }
        function inLake(x, z) {
          const dx = x - LAKE.x,
            dz = z - LAKE.z;
          const d = Math.hypot(dx, dz);
          return d < lakeR(Math.atan2(dz, dx)) && d > islandR(Math.atan2(dz, dx));
        }
        const TOWER = { x: 95, z: -110, h: 38, r: 2.2 };
        const WINDS = {
          none: { spd: 0, g: 0, n: "Calm" },
          light: { spd: 3, g: 0.8, n: "Light" },
          strong: { spd: 6.5, g: 1.8, n: "Strong" },
        };

        /* ================= state ================= */
        const settings = { sound: true, volume: 0.7, cam: "chase", view: "map", tod: "midday", drag: true, wind: "none", windFrom: 270 };
        const GAME = { mode: "sim", level: 1, lesson: 0, demo: false, demoDone: false };
        const PLAN = { target: null, aim: null, wps: [], alt: "med", spd: "med", pay: "med", mode: "auto", assist: "gps", drone: "quad" };
        droneDims(PLAN.drone);
        // the current mission: fixed by the level, or set by the simulator controls
        let MISSION = { kind: "sim", r: 8, need: null, nfz: [], wind: { spd: 0, from: 270, g: 0 }, lock: {}, item: null };
        const S = {};
        const VIEW = { yaw: 0, pitch: 0, drag: null };
        const flash = {};
        const keys = {};

        /* ---------- noise (shared with the 3D scenery) ---------- */
        let seed = 7;
        const rnd = () => ((seed = (seed * 16807) % 2147483647) - 1) / 2147483646;
        function hash2(i, j) {
          let h = (Math.imul(i, 374761393) + Math.imul(j, 668265263)) | 0;
          h = Math.imul(h ^ (h >>> 13), 1274126177);
          h ^= h >>> 16;
          return (h >>> 0) / 4294967295;
        }
        function vnoise(x, z) {
          const i = Math.floor(x),
            j = Math.floor(z),
            fx = x - i,
            fz = z - j;
          const u = fx * fx * (3 - 2 * fx),
            v = fz * fz * (3 - 2 * fz);
          const a = hash2(i, j),
            b = hash2(i + 1, j),
            c = hash2(i, j + 1),
            d = hash2(i + 1, j + 1);
          return a + (b - a) * u + (c - a) * v + (a - b - c + d) * u * v;
        }
        function fbm(x, z) {
          let s = 0,
            a = 0.5,
            f = 1;
          for (let o = 0; o < 4; o++) {
            s += a * vnoise(x * f, z * f);
            f *= 2.03;
            a *= 0.5;
          }
          return s;
        }

        // flat mission area, rolling hills further out, mountains on the horizon
        const FIELD_R = 430;
        const SURF = 0.03;
        function groundH(x, z) {
          const r = Math.hypot(x, z);
          if (r < FIELD_R) {
            const ih = islandH(x, z);
            return (ih > 0 ? ih : 0) + SURF;
          }
          return groundFar(x, z, r) + SURF;
        }
        // height for a flat marking on the ground: k from 0 (just above the ground) to 1 (just below the contact surface)
        const decalY = (x, z, k) => groundH(x, z) - SURF + 0.003 + k * (SURF - 0.006);
        // the land outside the flat mission area (also the terrain mesh, which runs under the lake and island)
        function groundFar(x, z, r) {
          if (r < FIELD_R) return 0;
          const k = smooth((r - FIELD_R) / 650);
          const hills = Math.max(0, fbm(x / 380 + 11.3, z / 380 - 4.1) - 0.3) * 250 * k;
          const m = smooth((r - 2000) / 900);
          return hills + m * (140 + fbm(x / 600 - 2, z / 600 + 5) * 620);
        }

        /* ================= world layout: obstacles the drone must clear ================= */
        const HOUSES = []; // {x, z, w, d, h (walls), roof (extra height), rot, col, kind}
        const addHouse = (x, z, w, d, h, roof, rot, col, kind) => HOUSES.push({ x, z, w, d, h, roof, rot, col, kind: kind || "house" });
        // village around the clinic
        addHouse(205, -84, 18, 10, 5.5, 2.4, 0, 0xf1efe8, "clinic");
        addHouse(178, -24, 9, 7, 4.5, 2.6, 0.2, 0xe6d3b3);
        addHouse(234, -22, 10, 7, 4.8, 2.6, -0.15, 0xd9c19a);
        addHouse(246, -64, 8, 9, 4.5, 2.4, 1.4, 0xe8dcc6);
        addHouse(170, -86, 8, 7, 4.2, 2.4, 0.1, 0xcfb18a);
        addHouse(236, -104, 9, 7, 4.6, 2.5, -0.3, 0xe1cfae);
        addHouse(262, -30, 8, 7, 4.4, 2.4, 0.5, 0xd7c4a4);
        addHouse(188, -122, 9, 7, 4.5, 2.5, 0.25, 0xe6d9bf);
        // farm
        addHouse(-212, -80, 11, 8, 5, 2.8, 0.1, 0xf0e6d4);
        addHouse(-162, -92, 15, 9, 6, 3.6, -0.05, 0xa8352c, "barn");
        // power station (inside the "Power station" no-fly zone in some missions)
        addHouse(-40, -112, 24, 14, 5, 1.0, 0.2, 0xb9c0c8, "station");
        // rescue camp tents (low, but still solid)
        addHouse(-138, -276, 4.5, 3.5, 1.6, 1.0, 0.4, 0xe07b2a, "tent");
        addHouse(-104, -279, 4.5, 3.5, 1.6, 1.0, -0.3, 0x2f6fb3, "tent");
        addHouse(-130, -244, 4.0, 3.2, 1.5, 1.0, 1.2, 0x3c8d5a, "tent");
        const SILO = { x: -146, z: -76, r: 3, h: 13 };
        // dirt tracks: base to the village square and to the farm
        const TRACKS = [
          [{ x: 12, z: 6 }, { x: 120, z: 8 }, { x: 175, z: -40 }, { x: 205, z: -55 }],
          [{ x: -12, z: 4 }, { x: -110, z: -20 }, { x: -170, z: -55 }],
        ];
        // buildings face where people come and go: village homes the square, farm buildings the farmyard, tents the camp centre
        const SQUARE = { x: 205, z: -55 },
          FARMYARD = { x: -185, z: -60 },
          CAMP = { x: -120, z: -262 };
        HOUSES.forEach((hs) => {
          const c = hs.kind === "tent" ? CAMP : hs.kind === "station" ? null : Math.hypot(hs.x - SQUARE.x, hs.z - SQUARE.z) < 90 ? SQUARE : Math.hypot(hs.x - FARMYARD.x, hs.z - FARMYARD.z) < 60 ? FARMYARD : null;
          if (c) hs.rot = hs.kind === "tent" ? Math.atan2(-(c.z - hs.z), c.x - hs.x) : Math.atan2(c.x - hs.x, c.z - hs.z);
          hs.goal = c;
          // the front door (local +z) and the spot just outside it
          hs.door = { x: hs.x + Math.sin(hs.rot) * (hs.d / 2 + 0.3), z: hs.z + Math.cos(hs.rot) * (hs.d / 2 + 0.3) };
        });
        // the paved village square, the packed-earth farmyard and camp ground
        const PLAZAS = [
          { x: SQUARE.x, z: SQUARE.z, r: 13, kind: "paved" },
          { x: FARMYARD.x, z: FARMYARD.z, r: 12, kind: "dirt" },
          { x: CAMP.x, z: CAMP.z, r: 11, kind: "dirt" },
        ];
        // a gravel footpath from every front door to its square or yard
        const PATHS = [];
        HOUSES.filter((h) => h.goal && h.kind !== "tent").forEach((h) => {
          const a = h.door,
            g = h.goal;
          const cands = [];
          // edge of the square / yard
          {
            const dx = g.x - a.x,
              dz = g.z - a.z,
              L = Math.hypot(dx, dz),
              stop = (g === SQUARE ? 13 : 12) - 0.6;
            cands.push({ x: a.x + (dx / L) * (L - stop), z: a.z + (dz / L) * (L - stop) });
          }
          // the closest point of a dirt track
          TRACKS.forEach((T) =>
            T.forEach((b, i) => {
              if (!i) return;
              const p = T[i - 1],
                ex = b.x - p.x,
                ez = b.z - p.z,
                k = clamp(((a.x - p.x) * ex + (a.z - p.z) * ez) / (ex * ex + ez * ez), 0, 1),
                qx = p.x + ex * k,
                qz = p.z + ez * k,
                d = Math.hypot(a.x - qx, a.z - qz);
              if (d > 1.5) cands.push({ x: qx + ((a.x - qx) / d) * 1.5, z: qz + ((a.z - qz) / d) * 1.5 });
            }),
          );
          // a path must not cross any building (its own included, beyond the door)
          const clear = (b) => {
            const L = Math.hypot(b.x - a.x, b.z - a.z);
            for (let s = 0.5; s < L; s += 0.7) {
              const x = a.x + ((b.x - a.x) * s) / L,
                z = a.z + ((b.z - a.z) * s) / L;
              if (HOUSES.some((o) => (o !== h || s > 3) && houseTop(o, x, z, o === h ? 0.3 : 1.0) >= 0)) return false;
            }
            return true;
          };
          const ok = cands.filter(clear).sort((p, q) => Math.hypot(p.x - a.x, p.z - a.z) - Math.hypot(q.x - a.x, q.z - a.z));
          if (ok.length && Math.hypot(ok[0].x - a.x, ok[0].z - a.z) > 1 && Math.hypot(ok[0].x - a.x, ok[0].z - a.z) < 60) PATHS.push({ a, b: ok[0], w: 1.4, h, toSquare: ok[0] === cands[0] });
        });
        // props (drawn further down): kept clear of trees and bushes
        const PROP_SPOTS = [
          { x: -157, z: -79.6, r: 3.2 }, // hay bales by the barn
          { x: -196, z: -94, r: 3 }, // tractor
          { x: -108, z: -270, r: 2 }, // campfire
          { x: -135, z: -268, r: 2 }, // supply crates
          { x: -112, z: -248, r: 1 }, // camp flag
        ];
        function houseTop(hs, x, z, pad) {
          const dx = x - hs.x,
            dz = z - hs.z;
          const c = Math.cos(hs.rot),
            s = Math.sin(hs.rot);
          const lx = dx * c - dz * s,
            lz = dx * s + dz * c;
          if (Math.abs(lx) > hs.w / 2 + pad || Math.abs(lz) > hs.d / 2 + pad) return -1;
          // gable roof: highest along the ridge (local x axis)
          const k = 1 - clamp(Math.abs(lz) / (hs.d / 2), 0, 1);
          return hs.h + hs.roof * (pad > 0.01 ? 1 : k);
        }
        // forests and single trees (all solid)
        const TREES = [];
        const CLEAR = [
          { x: BASE.x, z: BASE.z, r: 48 },
          ...ZONES.map((z) => ({ x: z.x, z: z.z, r: z.k === "camp" ? 24 : 30 })),
          { x: 210, z: -60, r: 75 }, // village
          { x: -180, z: -75, r: 50 }, // farm
          { x: TOWER.x, z: TOWER.z, r: 10 },
          { x: -40, z: -112, r: 34 }, // power station yard
          { x: -120, z: -262, r: 34 }, // the camp's clearing: tents stand in the open
        ];
        // ---------- land use ----------
        const PATCHES = [
          { x: 30, z: 150, w: 72, d: 46, rot: 0.15, type: 0 },
          { x: -95, z: 70, w: 80, d: 55, rot: -0.2, type: 2 },
          { x: 265, z: 70, w: 70, d: 70, rot: 0.3, type: 1 },
          { x: -265, z: -170, w: 60, d: 80, rot: 0.1, type: 3 },
          { x: 70, z: -195, w: 70, d: 45, rot: -0.1, type: 2 },
          { x: -260, z: 15, w: 55, d: 70, rot: 0.25, type: 0 },
          { x: 160, z: -170, w: 60, d: 40, rot: 0.05, type: 3 },
        ];
        // fenced yards: nothing grows inside them (power station, farm paddock)
        const YARDS = [
          { x0: -62, x1: -18, z0: -136, z1: -88 },
          { x0: -235, x1: -200, z0: -40, z1: -5 },
        ];
        function inPatch(p, x, z, pad) {
          const dx = x - p.x,
            dz = z - p.z,
            c = Math.cos(p.rot),
            s = Math.sin(p.rot);
          return Math.abs(dx * c - dz * s) < p.w / 2 + pad && Math.abs(dx * s + dz * c) < p.d / 2 + pad;
        }
        function onTrack(x, z, pad) {
          return TRACKS.some((T) =>
            T.some((b, i) => {
              if (!i) return false;
              const a = T[i - 1],
                ex = b.x - a.x,
                ez = b.z - a.z,
                k = clamp(((x - a.x) * ex + (z - a.z) * ez) / (ex * ex + ez * ez), 0, 1);
              return Math.hypot(x - a.x - ex * k, z - a.z - ez * k) < 1.7 + pad;
            }),
          );
        }
        // true where nothing may stand: buildings, yards, fields, tracks, the lake and its beach, the silo and the mast
        function landBlocked(x, z, pad) {
          if (HOUSES.some((hs) => Math.abs(hs.x - x) < 30 && Math.abs(hs.z - z) < 30 && houseTop(hs, x, z, pad + 1) >= 0)) return true;
          if (YARDS.some((y) => x > y.x0 - pad && x < y.x1 + pad && z > y.z0 - pad && z < y.z1 + pad)) return true;
          if (PATCHES.some((p) => inPatch(p, x, z, pad))) return true;
          if (onTrack(x, z, pad)) return true;
          const dl = Math.hypot(x - LAKE.x, z - LAKE.z);
          if (dl < LAKE.r * 1.4 + pad && dl > ISLAND_R * 1.3 && dl < lakeR(Math.atan2(z - LAKE.z, x - LAKE.x)) * 1.12 + pad) return true;
          if (Math.hypot(x - SILO.x, z - SILO.z) < SILO.r + 1 + pad || Math.hypot(x - TOWER.x, z - TOWER.z) < TOWER.r + 1 + pad) return true;
          if (PLAZAS.some((p) => Math.hypot(x - p.x, z - p.z) < p.r + pad)) return true;
          if (PROP_SPOTS.some((p) => Math.hypot(x - p.x, z - p.z) < p.r + pad)) return true;
          if (
            PATHS.some((p) => {
              const ex = p.b.x - p.a.x,
                ez = p.b.z - p.a.z,
                k = clamp(((x - p.a.x) * ex + (z - p.a.z) * ez) / (ex * ex + ez * ez), 0, 1);
              return Math.hypot(x - p.a.x - ex * k, z - p.a.z - ez * k) < p.w / 2 + pad;
            })
          )
            return true;
          return false;
        }
        // open lanes from the base to the drop zones in the open (the forest camp stays behind its forest)
        const LANES = ZONES.filter((z) => z.k !== "camp").map((z) => ({ x: z.x, z: z.z }));
        function nearLane(x, z, w) {
          return LANES.some((L) => {
            const len2 = L.x * L.x + L.z * L.z;
            const k = clamp((x * L.x + z * L.z) / len2, 0, 1.35);
            return Math.hypot(x - L.x * k, z - L.z * k) < w;
          });
        }
        const inClear = (x, z, pad) => CLEAR.some((c) => Math.hypot(x - c.x, z - c.z) < c.r + pad) || Math.hypot(x - LAKE.x, z - LAKE.z) < LAKE.r * 1.2 + pad || nearLane(x, z, 12 + pad);
        const addTree = (x, z, type, h) => TREES.push({ x, z, y: groundH(x, z), h, r: h * 0.24, type });
        const FORESTS = [
          { x: -78, z: -178, r: 64, n: 95 },
          { x: -120, z: -262, r: 66, n: 110 },
          { x: 108, z: 58, r: 40, n: 40 },
          { x: -235, z: 115, r: 62, n: 60 },
          { x: 262, z: -205, r: 58, n: 48 },
          { x: -30, z: 245, r: 46, n: 34 },
          { x: 30, z: -270, r: 50, n: 44 },
        ];
        FORESTS.forEach((f) => {
          for (let i = 0, k = 0; i < f.n * 30 && k < f.n; i++) {
            const a = rnd() * TAU,
              rr = Math.sqrt(rnd()) * f.r;
            const x = f.x + Math.cos(a) * rr,
              z = f.z + Math.sin(a) * rr;
            if (inClear(x, z, 3) || landBlocked(x, z, 4)) continue;
            if (TREES.some((t) => Math.abs(t.x - x) < 4.5 && Math.abs(t.z - z) < 4.5)) continue;
            const pine = rnd() < 0.55;
            addTree(x, z, pine ? 0 : 1, pine ? 10 + rnd() * 5 : 8 + rnd() * 4);
            k++;
          }
        });
        for (let i = 0; i < 4000 && TREES.length < 600; i++) {
          const x = (rnd() - 0.5) * 2 * MAP_HALF,
            z = (rnd() - 0.5) * 2 * MAP_HALF;
          if (inClear(x, z, 8) || Math.abs(x - 0) < 6 || landBlocked(x, z, 4)) continue;
          if (rnd() < 0.82) continue;
          addTree(x, z, rnd() < 0.5 ? 0 : 1, 7 + rnd() * 5);
        }
        // outer woods (scenery only, beyond the mission area)
        const NEAR_TREES = TREES.length;
        for (let i = 0; i < 14000 && TREES.length < NEAR_TREES + 1300; i++) {
          const a = rnd() * TAU,
            r = 380 + rnd() * 1700;
          const x = Math.cos(a) * r,
            z = Math.sin(a) * r;
          if (fbm(x / 260 + 5, z / 260) < 0.47) continue;
          if (groundH(x, z) > 420 || inClear(x, z, 10)) continue;
          const pine = rnd() < 0.62;
          addTree(x, z, pine ? 0 : 1, pine ? 10 + rnd() * 8 : 8 + rnd() * 5);
        }
        // every third broadleaf becomes a tall poplar
        TREES.forEach((t, i) => {
          if (t.type === 1 && i % 3 === 0) {
            t.type = 2;
            t.h *= 1.3;
            t.r = t.h * 0.14;
          }
        });
        // a few trees round the island's rim (outside the drop zone, clear of the jetty)
        const JETTY_A = Math.atan2(BASE.z - LAKE.z, BASE.x - LAKE.x);
        [0.9, 1.75, 2.5, 3.3, 4.2, 5.1].forEach((da, i) => {
          const a = JETTY_A + da,
            r = islandR(a) - 2.4;
          addTree(LAKE.x + Math.cos(a) * r, LAKE.z + Math.sin(a) * r, i === 2 ? 0 : 1, i === 2 ? 8 : 5 + (i % 3) * 0.9);
        });
        // crown size that matches the drawn trees: pine cone, round broadleaf, narrow poplar
        TREES.forEach((t) => {
          t.r = t.h * [0.34, 0.4, 0.13][t.type];
          t.top = t.h * [1.04, 1.0, 1.1][t.type];
        });
        // crown radius of a tree at height y (0 above and below it; the trunk below the crown)
        function treeRadiusAt(t, y) {
          const u = (y - t.y) / t.h;
          if (u < 0 || u > t.top / t.h) return 0;
          const trunk = Math.max(0.12, t.h * 0.012);
          if (t.type === 0) return u < 0.2 ? trunk : Math.max(trunk, t.h * 0.34 * (1 - (u - 0.2) / 0.84));
          const c = t.type === 1 ? 0.68 : 0.64,
            b = t.type === 1 ? 0.33 : 0.47,
            a = t.h * (t.type === 1 ? 0.4 : 0.13);
          const e = (u - c) / b;
          return Math.max(u < c ? trunk : 0, a * Math.sqrt(Math.max(0, 1 - e * e)));
        }
        // ---------- solid objects (besides trees and buildings), in a grid ----------
        const COLL_CELL = 20,
          CGRID = new Map();
        function addColl(o, x0, z0, x1, z1) {
          for (let i = Math.floor(x0 / COLL_CELL); i <= Math.floor(x1 / COLL_CELL); i++)
            for (let j = Math.floor(z0 / COLL_CELL); j <= Math.floor(z1 / COLL_CELL); j++) {
              const k = i + "," + j;
              if (!CGRID.has(k)) CGRID.set(k, []);
              CGRID.get(k).push(o);
            }
        }
        // a box turned like a mesh with rotation.y = ry
        function addBox(x, z, w, d, ry, y0, y1, what) {
          const r = Math.hypot(w, d) / 2;
          addColl({ t: "box", x, z, w, d, c: Math.cos(ry), s: Math.sin(ry), y0, y1, what }, x - r, z - r, x + r, z + r);
        }
        function addCyl(x, z, r, y0, y1, what) {
          addColl({ t: "cyl", x, z, r, y0, y1, what }, x - r, z - r, x + r, z + r);
        }
        // a straight piece (fence rail, wire) from a to b, thickness r
        function addSeg(ax, ay, az, bx, by, bz, r, what, hy) {
          addColl({ t: "seg", ax, ay, az, bx, by, bz, r, hy: hy == null ? r : hy, what }, Math.min(ax, bx) - r, Math.min(az, bz) - r, Math.max(ax, bx) + r, Math.max(az, bz) + r);
        }
        // is any part of a vertical cylinder (centre x,z, radius R, from y0 to y1) inside something solid? returns what it hit
        function hitTest(x, z, y0, y1, R) {
          // trees
          const cx = Math.floor(x / CELL),
            cz = Math.floor(z / CELL);
          for (let i = -1; i <= 1; i++)
            for (let j = -1; j <= 1; j++) {
              const L = TGRID.get(cx + i + "," + (cz + j));
              if (!L) continue;
              for (const t of L) {
                const dd = Math.hypot(t.x - x, t.z - z);
                if (dd > t.r + R + 0.5 || y0 > t.y + t.top || y1 < t.y) continue;
                const ys = [y0, y1, (y0 + y1) / 2, t.y + t.h * 0.68];
                for (const y of ys) {
                  const rad = y >= y0 && y <= y1 ? treeRadiusAt(t, y) : 0;
                  if (rad > 0 && dd < rad + R) return "tree";
                }
              }
            }
          // buildings (walls, roof and eaves)
          for (const hs of HOUSES) {
            if (Math.abs(hs.x - x) > 25 || Math.abs(hs.z - z) > 25) continue;
            const pad = R + (hs.kind === "tent" ? 0 : 0.55);
            if (houseTop(hs, x, z, R) >= y0 || (y0 > hs.h && houseTop(hs, x, z, 0) < 0 && houseTop(hs, x, z, pad) >= 0 && y0 < hs.h + 0.3)) return hs.kind === "tent" ? "tent" : "building";
          }
          if (Math.hypot(x - SILO.x, z - SILO.z) < SILO.r + R && y0 < SILO.h) return "silo";
          if (Math.hypot(x - TOWER.x, z - TOWER.z) < TOWER.r + R && y0 < TOWER.h + 1) return "mast";
          // everything else
          const gx = Math.floor(x / COLL_CELL),
            gz = Math.floor(z / COLL_CELL);
          for (let i = -1; i <= 1; i++)
            for (let j = -1; j <= 1; j++) {
              const L = CGRID.get(gx + i + "," + (gz + j));
              if (!L) continue;
              for (const o of L) {
                if (o.t === "seg") {
                  // closest approach between the drone's axis and the segment, sampled along the segment
                  const ns = Math.max(4, Math.ceil(Math.hypot(o.bx - o.ax, o.bz - o.az) / 0.5));
                  for (let k = 0; k <= ns; k++) {
                    const f = k / ns,
                      px = o.ax + (o.bx - o.ax) * f,
                      py = o.ay + (o.by - o.ay) * f,
                      pz = o.az + (o.bz - o.az) * f;
                    if (py + o.hy >= y0 && py - o.hy <= y1 && Math.hypot(px - x, pz - z) < R + o.r) return o.what;
                  }
                  continue;
                }
                if (y1 < o.y0 || y0 > o.y1) continue;
                if (o.t === "cyl") {
                  if (Math.hypot(o.x - x, o.z - z) < o.r + R) return o.what;
                } else {
                  const dx = x - o.x,
                    dz = z - o.z;
                  const lx = Math.abs(dx * o.c - dz * o.s) - o.w / 2,
                    lz = Math.abs(dx * o.s + dz * o.c) - o.d / 2;
                  if (Math.hypot(Math.max(lx, 0), Math.max(lz, 0)) < R) return o.what;
                }
              }
            }
          // the drop-zone flag poles
          for (const z of ZONES) {
            const fl = zoneMeshes[z.k] && zoneMeshes[z.k].flag.position;
            if (fl && Math.hypot(fl.x - x, fl.z - z) < 0.1 + R && y0 < fl.y + 4.2) return "flagpole";
          }
          return null;
        }
        const WHAT_HIT = { tree: "a tree", building: "a building", tent: "a tent", silo: "the grain silo", mast: "the radio mast", flagpole: "a flagpole" };
        // the drone's rotors reach out to the propeller tips
        const rotorR = () => (DRONES[PLAN.drone].arm + DRONES[PLAN.drone].prop) * DSCALE;
        // grid for fast obstacle look-ups
        const CELL = 20,
          TGRID = new Map();
        TREES.forEach((t) => {
          const k = Math.floor(t.x / CELL) + "," + Math.floor(t.z / CELL);
          if (!TGRID.has(k)) TGRID.set(k, []);
          TGRID.get(k).push(t);
        });
        // highest solid thing within `pad` metres of (x, z); returns { top, what }
        function obstacleAt(x, z, pad) {
          let top = groundH(x, z),
            what = top > 1.2 ? "hill" : "";
          const cx = Math.floor(x / CELL),
            cz = Math.floor(z / CELL);
          for (let i = -1; i <= 1; i++)
            for (let j = -1; j <= 1; j++) {
              const L = TGRID.get(cx + i + "," + (cz + j));
              if (!L) continue;
              for (const t of L) {
                if (Math.hypot(t.x - x, t.z - z) < t.r + pad && t.y + t.top > top) (top = t.y + t.top), (what = "tree");
              }
            }
          for (const hs of HOUSES) {
            if (Math.abs(hs.x - x) > 20 + pad || Math.abs(hs.z - z) > 20 + pad) continue;
            const ht = houseTop(hs, x, z, pad);
            if (ht > top) (top = ht), (what = hs.kind === "tent" ? "tent" : "building");
          }
          if (Math.hypot(x - TOWER.x, z - TOWER.z) < TOWER.r + pad && TOWER.h > top) (top = TOWER.h), (what = "mast");
          if (Math.hypot(x - SILO.x, z - SILO.z) < SILO.r + pad && SILO.h > top) (top = SILO.h), (what = "silo");
          return { top, what };
        }
        const WHAT_N = { tree: "a tree", building: "a building", tent: "a tent", mast: "the radio mast", silo: "the grain silo", hill: "the hillside" };

        /* ================= wind ================= */
        function windDir(fromDeg) {
          const a = fromDeg * D2R;
          return V3(-Math.sin(a), 0, Math.cos(a)); // blows towards the opposite side
        }
        const windProfile = (h) => Math.pow(Math.max(h, 1.5) / 10, 0.16); // wind is stronger higher up
        function windMean(h) {
          const W = MISSION.wind;
          if (!W.spd) return V3(0, 0, 0);
          return windDir(W.from).multiplyScalar(W.spd * windProfile(h));
        }
        function windAt(x, y, z, t) {
          const W = MISSION.wind;
          if (!W.spd) return V3(0, 0, 0);
          const d = windDir(W.from);
          const f = windProfile(y);
          const along = W.spd * f + W.g * f * (0.6 * Math.sin(0.9 * t + x * 0.013 + 0.4) + 0.4 * Math.sin(2.3 * t + z * 0.011 + 1.3));
          const across = W.g * f * 0.55 * Math.sin(1.4 * t + (x + z) * 0.009 + 2.1);
          return V3(d.x * along - d.z * across, 0, d.z * along + d.x * across);
        }
        const windName = (W) => (!W.spd ? "Calm" : (W.spd >= 5 ? "Strong" : "Light") + " " + W.spd.toFixed(1) + " m/s from " + CARD(W.from) + (W.g > 1.2 ? ", gusty" : ""));

        /* ================= payload fall physics ================= */
        // a = g + drag; drag = ½ ρ Cd A |v − wind| (v − wind) ÷ m
        function fallStep(p, v, pay, w, dt) {
          const rx = v.x - w.x,
            ry = v.y,
            rz = v.z - w.z;
          const sp = Math.hypot(rx, ry, rz);
          const k = (0.5 * RHO * pay.cda * sp) / pay.m;
          v.x -= k * rx * dt;
          v.y -= (G + k * ry) * dt;
          v.z -= k * rz * dt;
          p.x += v.x * dt;
          p.y += v.y * dt;
          p.z += v.z * dt;
        }
        // braking: the controller's deceleration limit drops as the payload makes the drone heavier
        const brakeA = (att) => (3.5 * DRONES[PLAN.drone].m) / (DRONES[PLAN.drone].m + (att ? PAY[PLAN.pay].m : 0));
        // numbers for the Delivery Physics panel: hover thrust, stopping distance and the tilt needed in wind
        function deliveryNumbers() {
          const D = DRONES[PLAN.drone],
            P = PAY[PLAN.pay];
          const m = D.m + P.m;
          const W = m * G;
          const v = PLAN.mode === "manual" ? VMAN : SPD[PLAN.spd].v;
          const a = brakeA(true);
          const ws = MISSION.wind.spd ? windMean(ALT[PLAN.alt].h).length() : 0;
          const F = 0.5 * RHO * (D.cda + P.cda * 0.5) * ws * ws;
          return { m, W, hov: W / D.thrust, v, a, stop: (v * v) / (2 * a), ws, tilt: Math.atan(F / W) * R2D };
        }

        /* ================= Sky Parcel missions ================= */
        const NFZ_POWER = { x: -40, z: -112, r: 44, n: "Power station" };
        const NFZ_RESERVE = { x: -168, z: -175, r: 36, n: "Wildlife reserve" };
        const NFZ_SCHOOL = { x: 120, z: -40, r: 32, n: "School" };
        const LEVELS = [
          {
            n: "First Delivery",
            learn: "Arm the drone and let the autopilot deliver.",
            story: "Your first job with the rescue drone team: deliver a food packet to the open meadow north of the base. The autopilot flies there, lands the packet on the grass, opens its claws and flies home. Your job is to plan the flight and arm the motors.",
            need: "meadow",
            r: 10,
            wind: { spd: 0, from: 270, g: 0 },
            lock: { pay: "med", mode: "auto" },
            pre: { target: "meadow" },
            tip: "Press Start, then arm the motors: hold S + D together for one second (left stick down and to the right), or flip the ARM switch (E).",
            demo: { target: "meadow", wps: [], alt: "med", spd: "med", pay: "med", mode: "auto", why: "a straight, clear route: the autopilot stops over the drop point, lands the packet and opens the claws" },
          },
          {
            n: "Medicine Run",
            learn: "Deliver medicine to a marked area.",
            story: "The village clinic is running out of medicine. Pick the right drop zone, the clinic courtyard, and set the medicine pouch down inside the marked area. Watch out for the roofs and the radio mast.",
            need: "clinic",
            r: 6,
            wind: { spd: 2, from: 200, g: 0.4 },
            lock: { pay: "light", mode: "auto" },
            pre: {},
            tip: "Select the Village clinic yourself. At Medium altitude the straight route clears the roofs; at Low it clips them.",
            demo: { target: "clinic", wps: [], alt: "med", spd: "med", pay: "light", mode: "auto", why: "Medium height clears the roofs around the courtyard" },
          },
          {
            n: "Take Control",
            learn: "Fly the drone yourself with the sticks.",
            story: "The autopilot is offline for an update, so you fly this delivery by hand. Arm the motors, take off, fly to the meadow, land the packet inside the circle, open the claws, then fly home and land on the base pad.",
            need: "meadow",
            r: 8,
            wind: { spd: 0, from: 270, g: 0 },
            lock: { mode: "manual", pay: "med" },
            pre: { target: "meadow" },
            tip: "GPS assist holds the height and position when you let go. W climbs, S descends, A / D turn, ↑ flies forward. Land in the circle, press Space to open the claws, then fly home.",
            demo: { target: "meadow", wps: [], alt: "low", spd: "med", pay: "med", mode: "manual", assist: "gps", why: "the demo pilot climbs to 10 m, flies straight at 7 m/s, slows down early, lands the packet and opens the claws" },
          },
          {
            n: "Speed Trap",
            learn: "A loaded drone needs room to stop.",
            story: "The farmer needs a heavy tool kit in the small yard beside the barn. With the kit in its claws, the drone cannot brake as hard as when it is empty, so a fast approach shoots past the yard.",
            need: "farm",
            r: 5,
            wind: { spd: 0, from: 270, g: 0 },
            lock: { mode: "manual", pay: "heavy" },
            pre: { target: "farm" },
            tip: "Watch STOP DIST at the bottom of the view: it is how far the drone still travels after you let go. Let go of ↑ when the distance to the target is about the same.",
            demo: { target: "farm", wps: [], alt: "low", spd: "med", pay: "heavy", mode: "manual", assist: "gps", why: "the demo pilot starts braking early, because the heavy kit makes the stopping distance long" },
          },
          {
            n: "Wind Drift",
            learn: "Hold position against the wind.",
            story: "A strong north wind is blowing over the clinic, and this drone's GPS hold is off (ATTI mode). It holds its height, but the wind carries it south unless you lean it into the wind.",
            need: "clinic",
            r: 6,
            wind: { spd: 5, from: 0, g: 0.6 },
            lock: { mode: "manual", assist: "atti" },
            pre: { target: "clinic" },
            tip: "Fly upwind of the target, then hold a little ↑ or ↓ into the wind (towards the north) so the drone stays put while you descend. Watch the ground spot under the drone.",
            demo: { target: "clinic", wps: [], alt: "med", spd: "med", pay: "med", mode: "manual", assist: "atti", why: "in ATTI mode the demo pilot leans the drone into the north wind to hold it over the courtyard" },
          },
          {
            n: "Obstacle Route",
            learn: "Use waypoints to avoid no-fly zones.",
            story: "The forest camp needs supplies, but a power station and a wildlife reserve are no-fly zones, and the straight line crosses both. Plan a route round them for the autopilot.",
            need: "camp",
            r: 8,
            nfz: [NFZ_POWER, NFZ_RESERVE],
            wind: { spd: 0, from: 270, g: 0 },
            lock: { mode: "auto" },
            pre: { target: "camp" },
            tip: "Add waypoints that bend the route round the red zones. The route line turns red wherever it is still inside a no-fly zone. Over the forest, fly at Medium or High.",
            demo: { target: "camp", wps: [[45, -95], [20, -205], [-55, -262]], alt: "med", spd: "med", pay: "med", mode: "auto", why: "three waypoints take the route east of the power station and round to the camp; Medium height clears the forest" },
          },
          {
            n: "Precision Set-Down",
            learn: "Land the payload in a small circle.",
            story: "Precision job: a 3 m circle in the farm yard, next to the barn and the silo, with a light east breeze. Fly it with the autopilot or by hand.",
            need: "farm",
            r: 3,
            wind: { spd: 2.5, from: 90, g: 0.3 },
            lock: {},
            pre: { target: "farm" },
            tip: "The autopilot stops over the drop point before it descends, so it is very precise. Flying by hand, come in slowly, stop right over the cross, then descend.",
            demo: { target: "farm", wps: [], alt: "low", spd: "slow", pay: "heavy", mode: "auto", why: "Low and Slow: a short descent, and the drone is steady over the cross before it goes down" },
          },
          {
            n: "Final Rescue",
            learn: "Deliver the emergency kit exactly inside the rescue zone.",
            story: "A hiker is injured near the forest camp. Land the emergency kit inside the 4 m rescue zone, avoid the no-fly zones and handle a gusty west wind. A fast, safe delivery earns a bonus.",
            need: "camp",
            r: 4,
            nfz: [NFZ_POWER, NFZ_RESERVE],
            wind: { spd: 4.5, from: 300, g: 1.0 },
            lock: {},
            pre: {},
            item: "Emergency kit",
            par: 150,
            tip: "Combine everything: waypoints round the no-fly zones, Medium height over the forest, and the Cargo hexa if the gusts push the quad around.",
            demo: { target: "camp", wps: [[45, -95], [20, -205], [-55, -262]], alt: "med", spd: "med", pay: "heavy", mode: "auto", why: "the safe route round the no-fly zones at Medium height over the trees" },
          },
        ];
        const STORE_KEY = "skyparcel.progress.v2";
        let PROG = { lv: {}, learn: {} };
        try {
          const raw = localStorage.getItem(STORE_KEY);
          if (raw) PROG = { lv: JSON.parse(raw).lv || {}, learn: JSON.parse(raw).learn || {} };
        } catch (err) {}
        // Tutorial: three lessons (the steps themselves are built by the step guide further down)
        const LESSONS = [
          { n: "Plan a route, let the autopilot fly", short: "Autopilot delivery", lock: { mode: "auto", pay: "med" }, pre: null, view: "map", intro: "Plan a delivery to the Meadow on the map: pick the zone, add a waypoint, check the route and set the height. Then arm the motors and watch the autopilot fly every phase." },
          { n: "The transmitter sticks", short: "Stick practice", lock: { mode: "manual", assist: "gps", pay: "med" }, pre: "meadow", view: "3d", endsSelf: true, intro: "Fly by hand for the first time, one stick movement at a time: climb, hover, turn left and right, fly forward, brake, fly sideways and land. GPS assist holds the drone still whenever you let go." },
          { n: "Deliver a parcel by hand", short: "Manual delivery", lock: { mode: "manual", assist: "gps", pay: "med" }, pre: "meadow", view: "3d", intro: "Fly the food packet to the Meadow yourself: take off, fly there, slow down early, land inside the circle, open the claws, then fly home and land on the base pad." },
        ];
        function saveProg() {
          try {
            localStorage.setItem(STORE_KEY, JSON.stringify(PROG));
          } catch (err) {}
        }
        const levelUnlocked = (n) => n === 1 || !!(PROG.lv[n - 1] && PROG.lv[n - 1].ok);
        const levelsDone = () => LEVELS.filter((_, i) => PROG.lv[i + 1] && PROG.lv[i + 1].ok).length;
        const RANKS = ["Trainee", "Trainee", "Drone Pilot", "Drone Pilot", "Mission Planner", "Mission Planner", "Senior Planner", "Senior Planner", "Rescue Drone Lead"];

        /* ================= the route ================= */
        const routePts = () => [{ x: BASE.x, z: BASE.z }].concat(PLAN.wps.map((w) => ({ x: w.x, z: w.z })), PLAN.aim ? [{ x: PLAN.aim.x, z: PLAN.aim.z }] : []);
        function mkPath(pts) {
          const cum = [0];
          for (let i = 1; i < pts.length; i++) cum.push(cum[i - 1] + Math.hypot(pts[i].x - pts[i - 1].x, pts[i].z - pts[i - 1].z));
          return { pts, cum, len: cum[cum.length - 1] };
        }
        function pathAt(P, s) {
          s = clamp(s, 0, P.len);
          let i = 1;
          while (i < P.pts.length - 1 && P.cum[i] < s) i++;
          const a = P.pts[i - 1],
            b = P.pts[i] || a;
          const L = Math.max(1e-6, P.cum[i] - P.cum[i - 1]);
          const k = clamp((s - P.cum[i - 1]) / L, 0, 1);
          return { x: a.x + (b.x - a.x) * k, z: a.z + (b.z - a.z) * k, dx: (b.x - a.x) / L, dz: (b.z - a.z) / L, i };
        }
        // closest point on the path near the current progress (so the route can cross itself)
        function pathProject(P, x, z, sHint, back, ahead) {
          let best = sHint,
            bd = Infinity;
          for (let i = 1; i < P.pts.length; i++) {
            if (P.cum[i] < sHint - (back || 20) || P.cum[i - 1] > sHint + (ahead || 60)) continue;
            const a = P.pts[i - 1],
              b = P.pts[i];
            const L = P.cum[i] - P.cum[i - 1];
            if (L < 1e-6) continue;
            const k = clamp(((x - a.x) * (b.x - a.x) + (z - a.z) * (b.z - a.z)) / (L * L), 0, 1);
            const px = a.x + (b.x - a.x) * k,
              pz = a.z + (b.z - a.z) * k;
            const d = Math.hypot(px - x, pz - z);
            if (d < bd) (bd = d), (best = P.cum[i - 1] + k * L);
          }
          return best;
        }
        // direction of the last leg (the drone arrives over the drop point flying this way)
        function runoutDir(pts) {
          const n = pts.length;
          if (n < 2) return { x: 0, z: -1 };
          const a = pts[n - 2],
            b = pts[n - 1];
          const L = Math.hypot(b.x - a.x, b.z - a.z) || 1;
          return { x: (b.x - a.x) / L, z: (b.z - a.z) / L };
        }
        // check the planned route at the planned height: no-fly zones and obstacle clearance
        function checkRoute() {
          const out = { segs: [], len: 0, issues: [], minClear: Infinity, ok: true, nfz: null, what: "" };
          if (!PLAN.aim) return out;
          const all = routePts();
          const h = ALT[PLAN.alt].h;
          for (let i = 1; i < all.length; i++) {
            const a = all[i - 1],
              b = all[i];
            const L = Math.hypot(b.x - a.x, b.z - a.z);
            out.len += L;
            let bad = null,
              minC = Infinity,
              what = "";
            const n = Math.max(1, Math.ceil(L / 2));
            for (let k = 0; k <= n; k++) {
              const x = a.x + ((b.x - a.x) * k) / n,
                z = a.z + ((b.z - a.z) * k) / n;
              for (const f of MISSION.nfz)
                if (Math.hypot(x - f.x, z - f.z) < f.r) {
                  bad = "nfz";
                  out.nfz = f;
                }
              if (Math.hypot(x - BASE.x, z - BASE.z) < 6) continue;
              const o = obstacleAt(x, z, 2.5);
              const c = h - o.top;
              if (c < minC) (minC = c), (what = o.what);
            }
            if (!bad && minC < 3) bad = "obst";
            out.minClear = Math.min(out.minClear, minC);
            if (minC < 3 && !out.what) out.what = what;
            out.segs.push({ a, b, bad, minC });
          }
          if (out.nfz) out.issues.push({ k: "bad", t: "✗ The route crosses the no-fly zone “" + out.nfz.n + "”. Add waypoints to go round it." });
          if (out.minClear < 0.5) out.issues.push({ k: "bad", t: "✗ At " + ALT[PLAN.alt].n + " (" + h + " m) the drone would hit " + (WHAT_N[out.what] || "an obstacle") + ". Raise the altitude or move the route." });
          else if (out.minClear < 3) out.issues.push({ k: "warn", t: "⚠ Only " + out.minClear.toFixed(1) + " m above " + (WHAT_N[out.what] || "an obstacle") + ". Raise the altitude for a safe margin." });
          // the drone lands at the drop point, so it needs open ground there
          {
            const o = obstacleAt(PLAN.aim.x, PLAN.aim.z, 0.6 * DSCALE + 0.4);
            const za = tgtZone(),
              dAim = za ? Math.hypot(PLAN.aim.x - za.x, PLAN.aim.z - za.z) : 0;
            if (dAim > MISSION.r) out.issues.push({ k: "bad", t: "✗ The drop point is " + dAim.toFixed(0) + " m from the centre, outside the " + MISSION.r + " m target zone: the drop would fail. Drag it back inside the circle." });
            else if (inLake(PLAN.aim.x, PLAN.aim.z)) out.issues.push({ k: "bad", t: "✗ The drop point is in the lake: the drone cannot land there. Drag it onto dry ground." });
            else if (o.what && o.what !== "hill" && o.top > 0.3) out.issues.push({ k: "bad", t: "✗ The drop point is too close to " + (WHAT_N[o.what] || "an obstacle") + " to land there. Drag it to open ground." });
          }
          out.ok = !out.issues.some((i) => i.k === "bad");
          return out;
        }

        /* ================= flight state ================= */
        // where the throttle stick rests: centred (spring-loaded, "hold height") unless the assist is off
        const thrRest = () => (PLAN.mode === "manual" && PLAN.assist === "off" ? 0 : 0.5);
        const approachV = (v, t, rate, dt) => (Math.abs(t - v) <= rate * dt ? t : v + Math.sign(t - v) * rate * dt);
        function resetFlight() {
          Object.assign(S, {
            phase: "pad",
            t: 0,
            pos: V3(BASE.x, LEG, BASE.z),
            vel: V3(0, 0, 0),
            ax: 0,
            az: 0,
            thr: 0,
            rpm: 0,
            psi: 0,
            tiltF: 0,
            tiltR: 0,
            bat: 1,
            vcx: 0,
            vcz: 0,
            dir: { x: 0, z: -1 },
            P: null,
            R: null,
            s: 0,
            aimS: 0,
            wPrev: V3(0, 0, 0),
            // transmitter sticks: thr 0..1 (stick down = 0), yaw / pit / rol −1..1 (pit + = forward)
            in: { thr: thrRest(), yaw: 0, pit: 0, rol: 0 },
            armed: false,
            armedOnce: false,
            flew: false,
            armHold: 0,
            disHold: 0,
            spoolT: 0,
            ground: true,
            gdT: 0,
            sdT: 0,
            touchV: 0,
            claw: 0,
            clawT: 0,
            hold: { on: false, yOn: false, x: 0, z: 0, y: 0 },
            pay: { st: "attached", pos: V3(), vel: V3(), rot: V3(), spin: V3(), land: null, roof: false, impact: null, bounced: false },
            release: null,
            override: false,
            m: { xtSum: 0, xtN: 0, xtMax: 0, minClear: Infinity, maxV: 0, maxAlt: 0, closest: Infinity, appV: null, hardest: 0 },
            crashed: false,
            reason: "",
            failed: null,
            dropFail: null, // why the drop failed (parcel outside the zone, in the lake, wrong zone)
            wreck: false, // a crashed drone has come to rest
            dropFailT: 0,
            ended: false,
            started: false,
            running: false,
            paused: false,
            trail: [],
            trailT: 0,
            samples: [],
            sampleT: 0,
            log: [],
            cool: {},
            result: null,
            doneT: 0,
            plannedLen: 0,
            gen: (S.gen || 0) + 1,
          });
        }
        resetFlight();
        const PHASE_N = {
          spool: "Motors spinning up",
          takeoff: "Taking off",
          route: "Flying the route",
          approach: "Slowing to stop",
          descend: "Descending to land",
          setdown: "Landed: claws open",
          climb: "Climbing away",
          ret: "Returning to base",
          land: "Landing at base",
          disarm: "Disarming",
          done: "Landed",
          hover: "Failsafe landing",
          crash: "Crashed",
        };
        function phaseName() {
          const ph = S.phase;
          if (ph === "pad") return S.started ? "Waiting to arm" : "On the launch pad";
          if (ph === "manual") return S.ground ? (S.armed ? "On the ground, armed" : "On the ground") : "Manual · " + ASSIST[PLAN.assist].n;
          return PHASE_N[ph] || ph;
        }
        // height of the skids (and the payload's base) above the ground
        const altNow = () => Math.max(0, S.pos.y - LEG - groundH(S.pos.x, S.pos.z));
        const flying = () => S.started && !S.ended && S.armed && S.phase !== "crash";
        const curPay = () => PAY[PLAN.pay];
        const altH = () => ALT[PLAN.alt].h;
        const tgtZone = () => (PLAN.target ? zoneOf(PLAN.target) : null);
        const itemName = () => MISSION.item || PAY[PLAN.pay].item;

        function startMission(quiet) {
          if (S.started) return true;
          if (!PLAN.target) {
            toast("Pick a drop zone first: click one on the map or in the list.", "bad", "tgt", 1);
            sfx.init();
            sfx.beep(420, 0.25);
            return false;
          }
          const chk = checkRoute();
          const pts = routePts();
          S.P = mkPath(pts);
          S.aimS = S.P.len;
          S.dir = runoutDir(pts);
          S.plannedLen = chk.len;
          S.phase = "pad";
          S.started = true;
          S.running = true;
          S.paused = false;
          S.psi = pts.length > 1 ? Math.atan2(pts[1].x - pts[0].x, -(pts[1].z - pts[0].z)) : 0;
          sfx.init();
          clearLog();
          const how = PLAN.mode === "auto" ? "Autopilot · " + ALT[PLAN.alt].n + " " + altH() + " m · " + SPD[PLAN.spd].n + " " + SPD[PLAN.spd].v + " m/s" : "Manual flight · " + ASSIST[PLAN.assist].n + " assist";
          addLog("Mission ready: " + DRONES[PLAN.drone].n + " to the " + tgtZone().n + " · " + how + " · " + itemName() + " in the claws", "");
          if (PLAN.mode === "auto" && (!chk.ok || chk.issues.length)) chk.issues.forEach((i) => addLog(i.t.replace(/^[✗⚠] /, "Plan warning: "), "warn"));
          if (MISSION.wind.spd) addLog("Wind: " + windName(MISSION.wind), "");
          setView("3d");
          hideStartCard();
          updateButtons();
          if (!quiet) toast("Arm the motors: hold S + D together for one second, or flip the ARM switch (E).", "info", "armhint", 3);
          return true;
        }

        /* ---------- arming: a real flight controller only arms on the ground with the throttle down ---------- */
        function arm(how) {
          if (S.armed || S.crashed || S.ended || !S.ground) return;
          if (!S.started && !startMission(true)) return;
          const offMode = PLAN.mode === "manual" && PLAN.assist === "off";
          if (how === "switch" && S.in.thr > (offMode ? 0.08 : 0.6)) {
            toast("Throttle stick is up: lower it (S) first. A real flight controller will not arm with the throttle up.", "bad", "arm", 2);
            sfx.beep(330, 0.2);
            return;
          }
          S.armed = true;
          S.armedOnce = true;
          S.armHold = S.disHold = 0;
          S.hold = { on: false, yOn: false, x: S.pos.x, z: S.pos.z, y: S.pos.y };
          if (S.phase === "pad" || S.phase === "done") {
            if (PLAN.mode === "auto" || GAME.demo) {
              S.phase = "spool";
              S.spoolT = 0;
            } else S.phase = "manual";
          }
          addLog("Motors armed" + (how === "switch" ? " with the ARM switch" : " with the sticks (throttle down, yaw right)") + (PLAN.mode === "auto" ? ": the autopilot takes off" : ": you have control"), "ok");
          sfx.beep(880, 0.07);
          setTimeout(() => sfx.beep(1320, 0.07), 110);
          updateButtons();
        }
        function canDisarm() {
          if (!S.armed || !S.ground) return false;
          if (PLAN.mode === "auto" || GAME.demo) return S.phase === "spool" || S.phase === "disarm" || S.phase === "done";
          return true;
        }
        function disarm(how) {
          if (!S.armed) return;
          if (!S.ground) {
            toast("Land first: switching the motors off in the air would make the drone fall.", "bad", "disarm", 2);
            return;
          }
          if (!canDisarm()) {
            toast("The autopilot is flying the mission: it disarms by itself after landing at the base.", "info", "disarm", 2);
            return;
          }
          S.armed = false;
          S.rpm = 0;
          S.armHold = S.disHold = 0;
          addLog(how === "auto" ? "Landed at the base: motors disarmed" : "Motors disarmed" + (how === "switch" ? " with the ARM switch" : " with the sticks (throttle down, yaw left)"), how === "auto" ? "ok" : "");
          sfx.beep(660, 0.07);
          setTimeout(() => sfx.beep(440, 0.09), 110);
          if (S.phase === "spool" || !S.flew) S.phase = "pad";
          else S.phase = "done";
          updateButtons();
        }
        // stick gestures: hold throttle down + yaw right to arm, throttle down + yaw left to disarm (1 s)
        function armLogic(dt) {
          const I = S.in;
          const low = I.thr <= 0.08;
          if (!S.armed) {
            if (S.ground && low && I.yaw >= 0.8 && !S.crashed) {
              S.armHold += dt;
              if (S.armHold >= 1) arm("sticks");
            } else S.armHold = 0;
          } else if (S.ground && low && I.yaw <= -0.8 && canDisarm()) {
            S.disHold += dt;
            if (S.disHold >= 1) disarm("sticks");
          } else S.disHold = 0;
        }

        // horizontal velocity the autopilot wants: follow the path, aiming at a point a little ahead
        function guide(P, speed, endStop) {
          S.s = pathProject(P, S.pos.x, S.pos.z, S.s, 25, Math.max(60, speed * 6));
          const c = pathAt(P, Math.min(P.len, S.s + Math.max(5, speed * 1.1)));
          const dx = c.x - S.pos.x,
            dz = c.z - S.pos.z;
          const d = Math.hypot(dx, dz) || 1;
          let sp = speed;
          // like a real autopilot, slow down before a sharp corner so the turn stays tight
          const iv = pathAt(P, S.s).i;
          if (iv < P.pts.length - 1) {
            const a = P.pts[iv - 1],
              b = P.pts[iv],
              c2 = P.pts[iv + 1];
            const turn = Math.abs(wrapPi(Math.atan2(c2.x - b.x, -(c2.z - b.z)) - Math.atan2(b.x - a.x, -(b.z - a.z))));
            const loaded = S.pay.st === "attached";
            const vCorner = speed * clamp(1 - ((loaded ? 0.9 : 0.6) * turn) / Math.PI, 0.25, 1);
            const dv = P.cum[iv] - S.s;
            sp = Math.min(sp, Math.sqrt(vCorner * vCorner + 2 * 1.8 * Math.max(0, dv)));
          }
          if (endStop) {
            const rem = P.len - S.s + d * 0.2;
            sp = Math.min(speed, Math.sqrt(2 * 1.1 * Math.max(0, rem)) + 0.05, d * 1.4);
          }
          return { x: (dx / d) * sp, z: (dz / d) * sp };
        }
        const holdAt = (x, z) => ({ x: clamp((x - S.pos.x) * 0.9, -3, 3), z: clamp((z - S.pos.z) * 0.9, -3, 3) });
        function beginReturn() {
          const pts = S.P.pts;
          const back = [{ x: S.pos.x, z: S.pos.z }];
          for (let i = pts.length - 2; i >= 0; i--) back.push(pts[i]);
          S.R = mkPath(back);
          S.s = 0;
          S.phase = "ret";
          addLog("Returning to base along the route", "");
        }
        function crash(reason) {
          if (S.crashed) return;
          S.crashed = true;
          S.reason = reason;
          S.phase = "crash";
          S.armed = false;
          addLog("Crashed: " + reason, "bad");
          sfx.crash();
          if (window.__vis) window.__vis.onCrash();
        }
        function geofence(f) {
          if (S.failed) return;
          S.failed = f.edge ? "Flew out of the mission area" : "Entered the no-fly zone “" + f.n + "”";
          S.phase = "hover";
          S.hold = { on: true, yOn: false, x: S.pos.x, z: S.pos.z, y: S.pos.y };
          addLog(f.edge ? "Geofence: the drone reached the edge of the mission area and lands where it is." : "Geofence: entered the no-fly zone “" + f.n + "”. The drone stops and lands where it is.", "bad");
          toast(f.edge ? "Geofence: too far from the base. The drone lands." : "No-fly zone! The drone's geofence stopped the mission.", "bad");
          sfx.beep(300, 0.4);
        }

        /* ---------- what the autopilot wants (also used by the demo pilot, who turns it into stick moves) ---------- */
        function autoCmd(dt) {
          const sp = SPD[PLAN.spd];
          const altT = altH() + LEG;
          const hb = altNow();
          const climbTo = (y) => clamp((y - S.pos.y) * 1.0, -2.2, 3.0);
          const hs = Math.hypot(S.vel.x, S.vel.z);
          const face = () => (hs > 1 ? Math.atan2(S.vel.x, -S.vel.z) : null);
          const ph = S.phase;
          const still = { x: 0, z: 0 };
          if (ph === "pad" || ph === "done" || ph === "disarm") return { vc: still, vz: -0.5, idle: true };
          if (ph === "spool") {
            S.spoolT += dt;
            if (S.spoolT > 1.2) {
              S.phase = "takeoff";
              S.hold = { on: true, yOn: false, x: S.pos.x, z: S.pos.z, y: S.pos.y };
              addLog("Taking off: climbing to " + altH() + " m", "");
            }
            return { vc: still, vz: -0.5, idle: true };
          }
          if (ph === "takeoff") {
            if (S.pos.y > altT - 1.2) {
              S.phase = "route";
              addLog("Reached " + altH() + " m: flying the route", "");
            }
            return { vc: holdAt(S.hold.x, S.hold.z), vz: S.pos.y < LEG + 1 ? 1.2 : climbTo(altT) };
          }
          if (ph === "route" || ph === "approach") {
            const vc = guide(S.P, sp.v, true);
            const dA = Math.hypot(S.pos.x - PLAN.aim.x, S.pos.z - PLAN.aim.z);
            S.phase = S.P.len - S.s > 40 ? "route" : "approach";
            if (S.s >= S.P.len - 2 && dA < 0.8 && hs < 0.35) {
              S.phase = "descend";
              S.hold = { on: true, yOn: false, x: PLAN.aim.x, z: PLAN.aim.z, y: S.pos.y };
              addLog("Stopped over the drop point: descending to land the " + itemName().toLowerCase(), "");
            }
            return { vc, vz: climbTo(altT), face: face() };
          }
          if (ph === "descend") {
            const vz = -(hb > 4 ? sp.dn : hb > 1.2 ? lerp(sp.df, sp.dn, (hb - 1.2) / 2.8) : sp.df);
            return { vc: holdAt(S.hold.x, S.hold.z), vz };
          }
          if (ph === "setdown") {
            S.sdT += dt;
            if (S.pay.st === "attached" && S.sdT > 0.4) releasePayload(PLAN.mode === "auto" ? "auto" : "demo");
            if (S.pay.st !== "attached" && S.sdT > 1.6) {
              S.phase = "climb";
              S.hold = { on: true, yOn: false, x: S.pos.x, z: S.pos.z, y: S.pos.y };
              addLog("Payload delivered, claws open: climbing away", "");
            }
            return { vc: still, vz: -0.5 };
          }
          if (ph === "climb") {
            if (S.pos.y > altT - 1.2) beginReturn();
            return { vc: holdAt(S.hold.x, S.hold.z), vz: S.pos.y < LEG + 1 ? 1.2 : climbTo(altT) };
          }
          if (ph === "ret") {
            const vc = guide(S.R, sp.v, true);
            const dB = Math.hypot(S.pos.x - BASE.x, S.pos.z - BASE.z);
            if (S.s >= S.R.len - 1 && dB < 0.8 && hs < 0.35) {
              S.phase = "land";
              S.hold = { on: true, yOn: false, x: BASE.x, z: BASE.z, y: S.pos.y };
              addLog("Over the base: landing", "");
            }
            return { vc, vz: climbTo(altT), face: face() };
          }
          if (ph === "land" || ph === "hover") return { vc: holdAt(S.hold.x, S.hold.z), vz: -(hb > 4 ? 2.2 : hb > 1.2 ? 1.0 : 0.5) };
          return { vc: still, vz: 0 };
        }

        /* ---------- manual flight: what the sticks ask for, through the chosen flight assist ---------- */
        const STICK_DZ = 0.04;
        const dzone = (v) => (Math.abs(v) < STICK_DZ ? 0 : (v - Math.sign(v) * STICK_DZ) / (1 - STICK_DZ));
        const undz = (v) => (Math.abs(v) < 1e-3 ? 0 : Math.sign(v) * Math.min(1, Math.abs(v) * (1 - STICK_DZ) + STICK_DZ));
        function stickCmd(dt) {
          const I = S.in,
            A = PLAN.assist,
            DT = DRONES[PLAN.drone];
          const ph = S.phase;
          if (ph === "pad" || ph === "done" || ph === "disarm" || ph === "spool") return { vc: { x: 0, z: 0 }, vz: -0.5, idle: true };
          const p = dzone(I.pit),
            q = dzone(I.rol),
            y = dzone(I.yaw);
          const fx = Math.sin(S.psi),
            fz = -Math.cos(S.psi),
            rx = Math.cos(S.psi),
            rz = Math.sin(S.psi);
          const out = { yawRate: y * 1.75 };
          const hs = Math.hypot(S.vel.x, S.vel.z);
          if (A === "gps") {
            if (p || q) {
              S.hold.on = false;
              out.vc = { x: (fx * p + rx * q) * VMAN, z: (fz * p + rz * q) * VMAN };
            } else {
              // sticks centred: brake, then lock onto the spot (GPS position hold)
              if (!S.hold.on && hs < 0.6) S.hold = Object.assign(S.hold, { on: true, x: S.pos.x, z: S.pos.z });
              out.vc = S.hold.on ? holdAt(S.hold.x, S.hold.z) : { x: 0, z: 0 };
            }
          } else {
            // ATTI and Off: the stick sets the tilt angle; nothing cancels the wind or the drone's momentum
            const tc = DT.tilt * 0.85;
            const ap = G * Math.tan(p * tc),
              aq = G * Math.tan(q * tc);
            out.ax = fx * ap + rx * aq;
            out.az = fz * ap + rz * aq;
          }
          if (A === "off") out.thrust = clamp(I.thr, 0, 1);
          else {
            // spring-centred throttle: centre holds the height, up climbs (3 m/s max), down descends (2.5 m/s max)
            const t = I.thr - 0.5;
            const tt = Math.abs(t) < 0.05 ? 0 : t;
            let vz;
            if (!tt) {
              if (!S.hold.yOn) Object.assign(S.hold, { yOn: true, y: S.pos.y });
              vz = clamp((S.hold.y - S.pos.y) * 1.2, -1, 1);
            } else {
              S.hold.yOn = false;
              vz = tt > 0 ? ((tt - 0.05) / 0.45) * 3 : ((tt + 0.05) / 0.45) * 2.5;
            }
            if (vz < 0 && altNow() < 2) vz = Math.max(vz, -0.8); // landing protection
            if (S.ground && !tt) vz = -0.5;
            if (vz > 0 && altNow() > 60) {
              vz = 0;
              toast("Height limit: 60 m (real drone rules set a ceiling too).", "info", "ceil", 4);
            }
            out.vz = vz;
          }
          void dt;
          return out;
        }

        /* ---------- the demo pilot flies Manual-mode demos with the sticks, the way a person would ---------- */
        function demoPilot(dt) {
          const I = S.in;
          if (S.phase === "pad" && !S.armed) {
            I.thr = approachV(I.thr, 0, 3, dt);
            I.yaw = approachV(I.yaw, I.thr < 0.08 ? 1 : 0, 4, dt);
            I.pit = I.rol = 0;
            return;
          }
          if (PLAN.mode !== "manual") {
            I.thr = approachV(I.thr, 0.5, 3, dt);
            I.yaw = approachV(I.yaw, 0, 4, dt);
            I.pit = I.rol = 0;
            return;
          }
          if (S.phase === "disarm") {
            I.thr = approachV(I.thr, 0, 3, dt);
            I.yaw = approachV(I.yaw, I.thr < 0.08 ? -1 : 0, 4, dt);
            I.pit = I.rol = 0;
            return;
          }
          const c = autoCmd(dt);
          const DT = DRONES[PLAN.drone],
            A = PLAN.assist;
          const fx = Math.sin(S.psi),
            fz = -Math.cos(S.psi),
            rx = Math.cos(S.psi),
            rz = Math.sin(S.psi);
          const err = c.face != null ? wrapPi(c.face - S.psi) : 0;
          I.yaw = Math.abs(err) > 0.03 ? undz(clamp(err * 1.5, -1, 1)) : 0;
          if (c.idle) {
            I.thr = approachV(I.thr, A === "off" ? 0 : 0.5, 3, dt);
            I.pit = I.rol = 0;
            return;
          }
          if (A === "gps") {
            I.pit = undz(clamp((c.vc.x * fx + c.vc.z * fz) / VMAN, -1, 1));
            I.rol = undz(clamp((c.vc.x * rx + c.vc.z * rz) / VMAN, -1, 1));
          } else {
            // the pilot works out the tilt: lean into the wind and against the drone's momentum
            const att = S.pay.st === "attached";
            const m = DT.m + (att ? curPay().m : 0);
            const w = windAt(S.pos.x, S.pos.y, S.pos.z, S.t);
            const rvx = S.vel.x - w.x,
              rvz = S.vel.z - w.z;
            const kdr = (0.5 * RHO * (DT.cda + (att ? curPay().cda * 0.5 : 0)) * Math.hypot(rvx, S.vel.y, rvz)) / m;
            const ax = (c.vc.x - S.vel.x) * DT.kv + kdr * rvx * 0.85,
              az = (c.vc.z - S.vel.z) * DT.kv + kdr * rvz * 0.85;
            const tc = DT.tilt * 0.85;
            I.pit = undz(clamp(Math.atan((ax * fx + az * fz) / G) / tc, -1, 1));
            I.rol = undz(clamp(Math.atan((ax * rx + az * rz) / G) / tc, -1, 1));
          }
          if (A === "off") {
            const m = DT.m + (S.pay.st === "attached" ? curPay().m : 0);
            const tilt = Math.hypot(S.tiltF, S.tiltR);
            I.thr = clamp((m * (G + (c.vz - S.vel.y) * 2.6)) / (DT.thrust * Math.cos(tilt)), 0, 1);
          } else {
            const v = c.vz;
            I.thr = Math.abs(v) < 0.05 ? 0.5 : v > 0 ? 0.55 + (Math.min(v, 3) / 3) * 0.45 : 0.45 + (Math.max(v, -2.5) / 2.5) * 0.45;
          }
        }

        /* ================= physics step (1/120 s) ================= */
        function step(dt) {
          rwRecord();
          if (!S.started || S.ended) return;
          if (S.armedOnce) S.t += dt;
          if (GAME.demo) demoPilot(dt);
          armLogic(dt);
          const pay = curPay(),
            DT = DRONES[PLAN.drone];
          const att = S.pay.st === "attached";
          const m = DT.m + (att ? pay.m : 0);
          const w = windAt(S.pos.x, S.pos.y, S.pos.z, S.t);
          if (S.armed && S.phase !== "crash") {
            const cmd = PLAN.mode === "auto" || S.phase === "hover" ? autoCmd(dt) : stickCmd(dt);
            // air drag on the drone (and the payload in its claws), from its speed through the moving air
            const cda = DT.cda + (att ? pay.cda * 0.5 : 0);
            const rvx = S.vel.x - w.x,
              rvy = S.vel.y,
              rvz = S.vel.z - w.z;
            const kdr = (0.5 * RHO * cda * Math.hypot(rvx, rvy, rvz)) / m;
            // the spinning rotors also damp vertical motion (inflow drag)
            const dgx = -kdr * rvx,
              dgy = -kdr * rvy - 0.3 * rvy,
              dgz = -kdr * rvz;
            const Tm = DT.thrust / m;
            let axw, azw;
            if (cmd.vc) {
              // the wanted speed changes gradually: a heavier drone brakes and speeds up more gently
              let vc = cmd.vc;
              const aAlong = brakeA(att) * dt,
                aTurn = (att ? 4.5 : 6) * dt;
              const cs = Math.hypot(S.vcx, S.vcz);
              const ux = cs > 0.3 ? S.vcx / cs : vc.x / (Math.hypot(vc.x, vc.z) || 1),
                uz = cs > 0.3 ? S.vcz / cs : vc.z / (Math.hypot(vc.x, vc.z) || 1);
              const dx = vc.x - S.vcx,
                dz = vc.z - S.vcz;
              const dA = clamp(dx * ux + dz * uz, -aAlong, aAlong),
                dP = clamp(dx * -uz + dz * ux, -aTurn, aTurn);
              S.vcx += ux * dA - uz * dP;
              S.vcz += uz * dA + ux * dP;
              // feed-forward: the controller also tilts for the speed change it is asking for, so it tracks the ramp
              let ffx = (ux * dA - uz * dP) / dt,
                ffz = (uz * dA + ux * dP) / dt;
              if (S.ground || S.phase === "descend" || S.phase === "land" || S.phase === "hover" || S.phase === "setdown") (S.vcx = vc.x), (S.vcz = vc.z), (ffx = ffz = 0);
              vc = { x: S.vcx, z: S.vcz };
              // flight controller: wanted acceleration from the speed error, plus its estimate of the drag to cancel
              axw = (vc.x - S.vel.x) * DT.kv - dgx * 0.85 + ffx;
              azw = (vc.z - S.vel.z) * DT.kv - dgz * 0.85 + ffz;
            } else {
              axw = cmd.ax;
              azw = cmd.az;
              S.vcx = S.vel.x;
              S.vcz = S.vel.z;
            }
            const ayw = cmd.thrust == null ? clamp((cmd.vz - S.vel.y) * 2.6 - dgy, -5, 6) : 0;
            // it moves sideways by tilting: the tilt is limited, and so is the thrust left over after holding height
            const maxA = cmd.thrust == null ? Math.min(G * Math.tan(DT.tilt), Math.sqrt(Math.max(0, Tm * Tm - (G + ayw) * (G + ayw)))) : G * Math.tan(DT.tilt);
            const am = Math.hypot(axw, azw);
            if (am > maxA) (axw *= maxA / am), (azw *= maxA / am);
            // the airframe needs a moment to tilt over; a payload in the claws makes it a little slower
            const tau = DT.tau * (1 + (0.6 * (att ? pay.m : 0)) / DT.m);
            const ka = 1 - Math.exp(-dt / tau);
            S.ax += (axw - S.ax) * ka;
            S.az += (azw - S.az) * ka;
            let lift, accX, accY, accZ, gref;
            if (cmd.idle) {
              lift = 0;
              accX = accZ = 0;
              accY = -G;
              S.ax = S.az = 0;
              gref = G;
            } else if (cmd.thrust != null) {
              // full manual: thrust = throttle × the motors' maximum, along the tilted body
              const n = Math.hypot(S.ax, G, S.az);
              lift = cmd.thrust * Tm;
              accX = (lift * S.ax) / n + dgx;
              accY = (lift * G) / n - G + dgy;
              accZ = (lift * S.az) / n + dgz;
              gref = G;
            } else {
              const need = Math.hypot(S.ax, G + ayw, S.az) || 1;
              lift = Math.min(Tm, need);
              accX = (lift * S.ax) / need + dgx;
              accY = (lift * (G + ayw)) / need - G + dgy;
              accZ = (lift * S.az) / need + dgz;
              gref = G + ayw;
            }
            S.vel.x += accX * dt;
            S.vel.y += accY * dt;
            S.vel.z += accZ * dt;
            S.pos.addScaledVector(S.vel, dt);
            S.thr = lift / Tm;
            // the body leans the way the thrust points
            const fx = Math.sin(S.psi),
              fz = -Math.cos(S.psi);
            S.tiltF = Math.atan2(S.ax * fx + S.az * fz, gref);
            S.tiltR = Math.atan2(S.ax * -fz + S.az * fx, gref);
            // heading: the yaw stick turns it; the autopilot faces the way it flies (turn rate limited)
            if (cmd.yawRate != null) S.psi = wrapPi(S.psi + cmd.yawRate * dt);
            else if (cmd.face != null) S.psi += clamp(wrapPi(cmd.face - S.psi), -1.4 * dt, 1.4 * dt);
            S.rpm = cmd.idle ? 0.3 : (lift * m) / (DT.m * G);
            // battery: power grows with thrust (payload, climbing, fighting the wind) and with speed
            const hs = Math.hypot(S.vel.x, S.vel.z);
            S.bat -= (cmd.idle ? 0.0002 : 0.0016 * DT.drain * Math.pow(Math.max(0.3, (lift * m) / (DT.m * G)), 1.5) + 0.000008 * hs * hs) * dt;
            if (S.bat <= 0 && !S.failed) {
              S.bat = 0;
              S.failed = "Battery empty";
              S.phase = "hover";
              S.hold = { on: true, yOn: false, x: S.pos.x, z: S.pos.z, y: S.pos.y };
              addLog("Battery empty: the drone lands where it is", "bad");
            }
          } else if (S.phase !== "crash") {
            // motors off: it just sits on the ground
            S.rpm = 0;
            S.thr = 0;
            S.vel.set(0, Math.min(0, S.vel.y) - G * dt, 0);
            S.pos.addScaledVector(S.vel, dt);
          }
          S.wPrev.copy(w);
          // the ground: touch down, stand, lift off
          if (S.phase !== "crash") {
            const gH = groundH(S.pos.x, S.pos.z) + LEG;
            if (S.pos.y <= gH) {
              if (!S.ground) touchdown();
              if (S.phase !== "crash") {
                S.pos.y = gH;
                S.vel.set(0, Math.max(0, S.vel.y), 0);
                S.ax = S.az = 0;
                S.tiltF = S.tiltR = 0;
                S.vcx = S.vcz = 0;
                S.ground = true;
              }
            } else if (S.pos.y > gH + 0.03 && S.ground) {
              S.ground = false;
              if (!S.flew) {
                S.flew = true;
                if (PLAN.mode === "manual" && !GAME.demo) addLog("Lift-off", "");
              }
            }
          }
          if (S.phase === "crash" && !S.wreck) {
            S.vel.y -= G * dt;
            S.vel.x *= 1 - dt * 0.8;
            S.vel.z *= 1 - dt * 0.8;
            S.pos.addScaledVector(S.vel, dt);
            // tumbling while it falls
            S.tiltF += dt * 2.2;
            S.tiltR += dt * 1.4;
            // the surface below: the ground, or a roof / tree top it fell onto
            let top = groundH(S.pos.x, S.pos.z);
            for (const hs of HOUSES) {
              if (Math.abs(hs.x - S.pos.x) > 15 || Math.abs(hs.z - S.pos.z) > 15) continue;
              top = Math.max(top, houseTop(hs, S.pos.x, S.pos.z, 0));
            }
            if (Math.hypot(S.pos.x - SILO.x, S.pos.z - SILO.z) < SILO.r) top = Math.max(top, SILO.h);
            // resting pose: lying on its side on a broken skid, the lowest arm touching the surface
            const restTF = 0.18,
              restTR = 0.55;
            const rest = top + LEG * Math.cos(restTR) * 0.62 + 0.62 * DSCALE * 0.5 * Math.sin(restTR) * 0.35;
            if (S.pos.y <= rest) {
              S.pos.y = rest;
              S.vel.set(0, 0, 0);
              S.tiltF = restTF * Math.sign(Math.sin(S.tiltF) || 1);
              S.tiltR = restTR * Math.sign(Math.sin(S.tiltR) || 1);
              S.wreck = true;
              puff(S.pos.x, top + 0.2, S.pos.z, 0x9c8a6a, 14, 1.6);
            }
            S.rpm = 0;
          }
          // collisions, the geofence and the edge of the mission area
          if (!S.ground && S.phase !== "crash") {
            const hit = hitTest(S.pos.x, S.pos.z, S.pos.y - 0.06 * DSCALE, S.pos.y + 0.2 * DSCALE, rotorR()) || hitTest(S.pos.x, S.pos.z, S.pos.y - LEG - (S.pay.st === "attached" ? 0.02 : 0), S.pos.y, 0.36 * DSCALE);
            if (hit) crash("Hit " + (WHAT_HIT[hit] || hit) + " at " + altNow().toFixed(0) + " m. " + (PLAN.mode === "auto" ? "Raise the altitude or route round it." : "Climb higher or fly round it: the propellers reach " + rotorR().toFixed(1) + " m out from the centre."));
            for (const f of MISSION.nfz) if (Math.hypot(S.pos.x - f.x, S.pos.z - f.z) < f.r) geofence(f);
            if (Math.hypot(S.pos.x - BASE.x, S.pos.z - BASE.z) > MAP_HALF + 60) geofence({ edge: true, n: "mission area" });
            const c = S.pos.y - LEG - obstacleAt(S.pos.x, S.pos.z, 3).top;
            if (S.pos.y - LEG > 4 && Math.hypot(S.pos.x - BASE.x, S.pos.z - BASE.z) > 8 && Math.hypot(S.pos.x - PLAN.aim.x, S.pos.z - PLAN.aim.z) > 6) S.m.minClear = Math.min(S.m.minClear, c);
          }
          // route accuracy (cross-track error) on the way to the drop point
          if (S.phase === "route" || S.phase === "approach") {
            const p = pathAt(S.P, S.s);
            const xt = Math.hypot(S.pos.x - p.x, S.pos.z - p.z);
            S.m.xtSum += xt * dt;
            S.m.xtN += dt;
            S.m.xtMax = Math.max(S.m.xtMax, xt);
          }
          if (att && PLAN.aim) {
            const da = Math.hypot(S.pos.x - PLAN.aim.x, S.pos.z - PLAN.aim.z);
            if (da < S.m.closest) S.m.closest = da;
            if (S.m.appV == null && da < 12 && !S.ground) S.m.appV = Math.hypot(S.vel.x, S.vel.z);
          }
          S.m.maxV = Math.max(S.m.maxV, Math.hypot(S.vel.x, S.vel.z));
          S.m.maxAlt = Math.max(S.m.maxAlt, altNow());
          // claws: open after a release, close again a little later
          if (!att && S.clawT > 0 && S.release && S.t - S.release.t > 2.4) S.clawT = 0;
          S.claw += clamp(S.clawT - S.claw, -2.6 * dt, 2.6 * dt);
          payloadStep(dt);
          // samples for the report chart and the trail on the map
          S.sampleT += dt;
          if (S.sampleT > 0.25 && S.armedOnce) {
            S.sampleT = 0;
            S.samples.push({ t: S.t, alt: altNow(), v: Math.hypot(S.vel.x, S.vel.z) });
          }
          S.trailT += dt;
          if (S.trailT > 0.2 && !S.ground && S.phase !== "crash") {
            S.trailT = 0;
            S.trail.push({ x: S.pos.x, y: S.pos.y, z: S.pos.z });
            if (S.trail.length > 4000) S.trail.shift();
          }
          // manual: back on the base pad, delivery done, throttle down: the flight controller disarms
          if (S.phase === "manual" && S.ground && S.armed && S.flew) {
            const idle = PLAN.assist === "off" ? S.in.thr <= 0.12 : S.in.thr <= 0.55;
            if (idle && !att && Math.hypot(S.pos.x - BASE.x, S.pos.z - BASE.z) < 8) {
              S.gdT += dt;
              if (S.gdT > 2) disarm("auto");
            } else S.gdT = 0;
          }
          if (S.dropFail && S.t - S.dropFailT > 3 && !S.ended) return finishMission();
          if (S.phase === "done" || (S.phase === "crash" && S.vel.lengthSq() === 0)) {
            S.doneT += dt;
            const payBusy = S.pay.st === "falling" || S.pay.st === "sliding";
            if (S.doneT > (S.phase === "crash" ? 1.6 : 0.8) && !payBusy) finishMission();
          }
        }
        // the skids reach the ground
        function touchdown() {
          const vv = Math.max(0, -S.vel.y),
            hs = Math.hypot(S.vel.x, S.vel.z);
          S.touchV = vv;
          if (S.flew) S.m.hardest = Math.max(S.m.hardest, vv);
          if (inLake(S.pos.x, S.pos.z)) return crash("Landed in the lake. Only land on dry ground.");
          if (vv > 3.5) return crash("Hard landing at " + vv.toFixed(1) + " m/s: the landing gear broke.");
          if (hs > 2.5) return crash("Touched down while moving sideways at " + hs.toFixed(1) + " m/s and tipped over.");
          if (!S.flew) return;
          sfx.thud(clamp(vv / 8, 0.08, 0.4));
          const ph = S.phase;
          if (ph === "descend") {
            S.phase = "setdown";
            S.sdT = 0;
            addLog("Payload on the ground (touch-down " + vv.toFixed(1) + " m/s): opening the claws", "");
          } else if (ph === "land" || ph === "hover") {
            if (PLAN.mode === "manual" && GAME.demo && ph === "land") S.phase = "disarm";
            else {
              S.armed = false;
              S.rpm = 0;
              S.phase = "done";
              addLog(ph === "land" ? "Landed safely at the base: motors disarmed" : "Landed in place: motors disarmed", ph === "land" ? "ok" : "warn");
            }
          } else if (ph === "manual") {
            const z = tgtZone();
            const dz = z ? Math.hypot(S.pos.x - z.x, S.pos.z - z.z) : Infinity;
            const dB = Math.hypot(S.pos.x - BASE.x, S.pos.z - BASE.z);
            addLog("Touched down at " + vv.toFixed(1) + " m/s" + (S.pay.st === "attached" && dz < MISSION.r * 2.5 ? ", " + dz.toFixed(1) + " m from the zone centre: press Space to open the claws" : dB < 8 ? " on the base pad" : ""), vv > 1.6 ? "warn" : "");
          }
        }

        /* ---------- releasing the payload: open the claws ---------- */
        function releasePayload(how) {
          const p = S.pay;
          if (p.st !== "attached") return;
          if (!S.started || !S.flew) {
            toast(S.started ? "Fly to the drop zone first, land there, then open the claws." : "Start the mission first.", "info", "dropearly", 2);
            return;
          }
          if (PLAN.mode === "auto" && how === "manual") {
            toast("The autopilot opens the claws itself once the payload is on the ground. Press T to fly by hand.", "info", "apclaw", 3);
            return;
          }
          S.clawT = 1;
          const gH = groundH(S.pos.x, S.pos.z);
          const hb = Math.max(0, S.pos.y - LEG - gH);
          const onGround = S.ground || hb < 0.05;
          S.release = { t: S.t, x: S.pos.x, y: hb, z: S.pos.z, v: Math.hypot(S.vel.x, S.vel.z), how, s: S.s, ground: onGround };
          flash.Space = performance.now();
          sfx.clunk();
          if (onGround) {
            // set down: it is already standing on the ground, so it stays exactly there
            p.pos.set(S.pos.x, gH, S.pos.z);
            p.vel.set(0, 0, 0);
            p.rot.set(0, -S.psi, 0);
            p.spin.set(0, 0, 0);
            const P = curPay(),
              v = S.touchV;
            p.impact = { x: p.pos.x, z: p.pos.z, v, t: 0, cond: v <= P.okV ? "intact" : v <= P.dentV ? "dented" : "damaged" };
            p.roof = false;
            settlePayload(false);
          } else {
            p.st = "falling";
            p.pos.set(S.pos.x, S.pos.y - LEG + 0.01, S.pos.z);
            p.vel.set(S.vel.x, S.vel.y, S.vel.z);
            p.rot.set(-S.tiltF, -S.psi, -S.tiltR);
            p.spin.set((Math.random() - 0.5) * 2, (Math.random() - 0.5) * 1.5, (Math.random() - 0.5) * 2);
            addLog("Claws opened " + hb.toFixed(1) + " m above the ground: the " + itemName().toLowerCase() + " is falling!", "warn");
            toast("Claws opened in the air: the payload falls " + hb.toFixed(1) + " m. Land first, then open the claws.", "bad", "airdrop", 2);
          }
        }
        // a payload let go in the air falls (gravity + drag + wind), may bounce once, then slides to a stop
        function payloadStep(dt) {
          const p = S.pay;
          if (p.st === "sliding") {
            const hv = Math.hypot(p.vel.x, p.vel.z);
            const dv = 0.55 * G * dt;
            if (hv <= dv) return settlePayload(false);
            p.vel.x -= (p.vel.x / hv) * dv;
            p.vel.z -= (p.vel.z / hv) * dv;
            p.pos.x += p.vel.x * dt;
            p.pos.z += p.vel.z * dt;
            p.rot.y += p.spin.y * dt;
            p.spin.y *= 1 - 3 * dt;
            if (inLake(p.pos.x, p.pos.z)) return settlePayload(true);
            return;
          }
          if (p.st !== "falling") return;
          const w = windAt(p.pos.x, p.pos.y, p.pos.z, S.t);
          fallStep(p.pos, p.vel, curPay(), w, dt);
          p.rot.x += p.spin.x * dt;
          p.rot.y += p.spin.y * dt;
          p.rot.z += p.spin.z * dt;
          let top = groundH(p.pos.x, p.pos.z),
            roof = false;
          for (const hs of HOUSES) {
            if (Math.abs(hs.x - p.pos.x) > 15 || Math.abs(hs.z - p.pos.z) > 15) continue;
            const ht = houseTop(hs, p.pos.x, p.pos.z, 0);
            if (ht > top) (top = ht), (roof = true);
          }
          if (p.pos.y > top) return;
          p.pos.y = top;
          const wet = !roof && inLake(p.pos.x, p.pos.z);
          if (!p.impact) {
            const P = curPay();
            const v = Math.hypot(p.vel.x, p.vel.y, p.vel.z);
            p.impact = { x: p.pos.x, z: p.pos.z, v, t: S.t - S.release.t, cond: v <= P.okV ? "intact" : v <= P.dentV ? "dented" : "damaged" };
            sfx.thud(clamp(v / 30, 0.15, 0.5));
            if (window.__vis) window.__vis.onPayloadLand(wet);
          }
          p.roof = roof;
          if (wet || roof) return settlePayload(wet);
          if (-p.vel.y > 2.5 && !p.bounced) {
            p.bounced = true;
            p.vel.y = -p.vel.y * 0.18;
            p.vel.x *= 0.5;
            p.vel.z *= 0.5;
            p.spin.multiplyScalar(0.4);
            p.pos.y = top + 0.01;
            return;
          }
          p.vel.y = 0;
          p.vel.x *= 0.6;
          p.vel.z *= 0.6;
          p.rot.x = p.rot.z = 0;
          p.st = "sliding";
        }
        // the payload is at rest: measure where it ended up
        function settlePayload(wet) {
          const p = S.pay;
          const z = tgtZone();
          const d = Math.hypot(p.pos.x - z.x, p.pos.z - z.z);
          const im = p.impact || { x: p.pos.x, z: p.pos.z, v: 0, t: 0, cond: "intact" };
          const slide = Math.hypot(p.pos.x - im.x, p.pos.z - im.z);
          const setd = !!(S.release && S.release.ground);
          p.st = wet ? "lost" : "landed";
          p.land = { x: p.pos.x, z: p.pos.z, d, t: im.t, wet, roof: p.roof, v: im.v, slide, cond: im.cond, setd, fall: S.release ? S.release.y : 0 };
          p.vel.set(0, 0, 0);
          p.spin.set(0, 0, 0);
          if (!wet) p.rot.x = p.rot.z = 0;
          const inZone = d <= MISSION.r && !wet;
          const right = !MISSION.need || PLAN.target === MISSION.need;
          const where = d.toFixed(1) + " m from the centre" + (p.roof ? " (on a roof)" : "") + (inZone ? (right ? ": inside the zone" : ", but at the wrong drop zone") : ": outside the zone");
          addLog(
            wet
              ? "Splash! The payload fell into the lake"
              : setd
                ? "Payload set down " + where + " · touch-down " + im.v.toFixed(1) + " m/s, " + im.cond
                : "Payload fell " + S.release.y.toFixed(1) + " m and hit the ground at " + im.v.toFixed(1) + " m/s (" + im.cond + ")" + (slide > 0.2 ? ", slid " + slide.toFixed(1) + " m" : "") + " and stopped " + where,
            inZone && right && im.cond !== "damaged" ? "ok" : "bad",
          );
          toast(wet ? "Splash: the payload is in the lake." : inZone && right ? "✓ Payload " + (setd ? "set down" : "landed") + " inside the zone: " + d.toFixed(1) + " m from the centre" : "Outside the zone: " + d.toFixed(1) + " m from the centre", inZone && right ? "ok" : "bad");
          if (inZone && right) sfx.chime();
          else {
            sfx.beep(260, 0.3);
            dropFailed(wet ? "the parcel fell into the lake" : !right ? "the parcel went to the wrong drop zone (this delivery is for the " + zoneOf(MISSION.need).n + ")" : "the parcel landed " + d.toFixed(1) + " m from the centre, outside the " + MISSION.r + " m target zone" + (p.roof ? " (on a roof)" : ""));
          }
        }
        // a parcel outside the target zone is a failed delivery: the mission ends a few seconds later
        function dropFailed(why) {
          if (S.dropFail || S.ended) return;
          S.dropFail = why;
          S.dropFailT = S.t;
          addLog("DROP FAILED: " + why + ". The mission is over.", "bad");
          sfx.beep(200, 0.6);
        }

        /* ================= result, feedback and score ================= */
        function analyse() {
          const z = tgtZone(),
            r = MISSION.r,
            L = S.pay.land;
          const out = { status: "failed", reason: "", fb: [], along: 0, cross: 0, d: null, routeMiss: false };
          const dir = S.dir || runoutDir(routePts());
          if (L) {
            const dx = L.x - z.x,
              dz = L.z - z.z;
            out.along = dx * dir.x + dz * dir.z;
            out.cross = dx * -dir.z + dz * dir.x;
            out.d = L.d;
          }
          const manual = PLAN.mode === "manual";
          const right = !MISSION.need || PLAN.target === MISSION.need;
          const item = itemName().toLowerCase();
          if (S.crashed) (out.status = "failed"), (out.reason = S.reason);
          else if (S.failed) (out.status = "failed"), (out.reason = S.failed);
          else if (S.dropFail) (out.status = "failed"), (out.reason = "Drop failed: " + S.dropFail);
          else if (S.pay.st === "attached") (out.status = "failed"), (out.reason = "The payload was never delivered: it is still in the claws");
          else if (L && L.wet) (out.status = "failed"), (out.reason = "Drop failed: the payload fell into the lake");
          else if (!right) (out.status = "failed"), (out.reason = "Drop failed: delivered to the wrong drop zone, the mission needed the " + zoneOf(MISSION.need).n);
          else if (L && L.cond === "damaged") (out.status = "failed"), (out.reason = "The " + item + " was damaged: it hit the ground at " + L.v.toFixed(1) + " m/s");
          else if (L && L.d <= r) (out.status = "success"), (out.reason = (L.setd ? "Payload set down " : "Payload landed ") + L.d.toFixed(1) + " m from the centre, inside the " + r + " m zone");
          else (out.status = "failed"), (out.reason = "Drop failed: payload " + (L && L.setd ? "set down " : "landed ") + (L ? L.d.toFixed(1) : "?") + " m from the centre, outside the " + r + " m zone");
          // coach feedback
          const F = (b, s, ok) => out.fb.push({ b, s, ok });
          const W = MISSION.wind;
          if (S.crashed) {
            if (/Hard landing/.test(S.reason)) F("Land more gently.", S.reason + " Slow the descent: for the last 2 m, come down at under 1 m/s.");
            else if (/tipped/.test(S.reason)) F("Stop before you touch down.", S.reason + " Let the drone stop moving sideways, then descend.");
            else if (/lake/.test(S.reason)) F("Land on dry ground.", S.reason);
            else F(manual ? "Climb higher before you fly over obstacles." : "Raise the altitude or change the route.", S.reason + (manual ? "" : " Red parts of the route line on the map are unsafe."));
          }
          if (S.failed && /no-fly/.test(S.failed)) F(manual ? "Fly round the no-fly zones." : "Check waypoint placement.", manual ? "The geofence stopped the drone inside a red no-fly zone. Use the map (V) or the mini-map to fly round the red circles." : "The route entered a no-fly zone. Add waypoints so the line stays outside the red circles.");
          if (S.failed && /mission area/.test(S.failed)) F("Stay inside the mission area.", "The drone flew too far from the base, and the geofence landed it.");
          if (S.failed && /Battery/.test(S.failed)) F("Plan a shorter flight.", "The battery ran out. A shorter route, a lighter payload or a lower speed uses less energy.");
          if (S.pay.st === "attached" && !S.crashed && !S.failed) F(manual ? "Land in the zone, then open the claws." : "Fly over the drop zone.", manual ? "Touch down inside the circle and press Space (or OPEN CLAWS) to let go of the payload." : "The autopilot did not reach the drop point.");
          if (S.dropFail) F("Open the claws only inside the target circle.", "A parcel outside the target zone cannot be collected by the people waiting for it, so the delivery counts as failed and the mission ends. " + (manual ? "Land with the yellow cross under the drone inside the circle, check the distance on the OPEN CLAWS button, then open the claws." : "Keep the yellow drop point inside the circle on the map; in wind, the drone drifts while it descends."));
          if (!right && L) F("Pick the right drop zone.", "Read the mission card: this delivery was for the " + zoneOf(MISSION.need).n + ".");
          if (L && !L.wet && !L.setd) F("Land before you open the claws.", "The claws opened " + L.fall.toFixed(1) + " m above the ground, so the " + item + " fell and hit the ground at " + L.v.toFixed(1) + " m/s. Touch down first, then open the claws.");
          if (L && right && !L.wet) {
            if (L.d <= r) F(L.d <= r * 0.3 ? "Excellent! Payload placed right in the middle." : "Payload delivered inside the target zone.", L.d <= r * 0.3 ? "Route, height, braking and the set-down all worked together." : "Inside the circle. For a perfect delivery, see what pushed it off centre below.", true);
            else if (manual) {
              const stop = (S.m.appV * S.m.appV) / (2 * brakeA(true));
              if (S.m.appV != null && S.m.appV > 4.5 && out.along > 0) F("Slow down earlier: a loaded drone needs room to stop.", "You arrived at " + S.m.appV.toFixed(1) + " m/s and landed " + out.along.toFixed(1) + " m past the centre. At that speed it needs about " + stop.toFixed(0) + " m to stop (v² ÷ 2a).");
              else if (W.spd > 1 && PLAN.assist !== "gps") F("The wind pushed the drone while it descended.", "In " + ASSIST[PLAN.assist].n + " mode nothing holds the drone in place: lean it into the wind (stick towards where the wind comes from) as you go down.");
              else if (L.setd) F("Line up over the centre before you descend.", "You set it down " + L.d.toFixed(1) + " m from the centre. Stop right over the cross first; the yellow cross under the drone and the Top camera (C) help.");
            } else F("The set-down was off centre.", "It landed " + L.d.toFixed(1) + " m from the centre. Keep the drop point near the middle of the zone.");
          }
          if (L && !L.wet && L.cond === "dented") F("Touch down more gently.", "The " + item + " touched the ground at " + L.v.toFixed(1) + " m/s and got dented. Below " + curPay().okV + " m/s it arrives intact.");
          if (manual && S.pay.st !== "attached" && !S.crashed && !S.failed) {
            const bd = Math.hypot(S.pos.x - BASE.x, S.pos.z - BASE.z);
            if (S.phase === "done" && bd < 8) F("Landed back at the base.", "A complete flight: out, delivered, home and disarmed.", true);
            else F("Fly home and land on the base pad.", "The flight ended " + bd.toFixed(0) + " m from the base. After the delivery, fly back and land on the H.");
          }
          if (!manual && S.m.xtMax > 6 && !S.crashed) F("Corners at speed: the drone swings wide.", "It went " + S.m.xtMax.toFixed(1) + " m off the planned line in a turn. Slower speed or gentler corners keep it on the route.");
          if (PLAN.drone === "quad" && W.g >= 1 && L && !L.wet && L.d > r * 0.5) F("Gusts push the light quad around.", "The Cargo hexa is heavier and holds its line better in gusty wind.");
          return out;
        }
        function scoreOf(res) {
          const r = MISSION.r;
          const f = [];
          const manual = PLAN.mode === "manual";
          const L = S.pay.land;
          if (manual) {
            const bd = S.phase === "done" && !S.crashed ? Math.hypot(S.pos.x - BASE.x, S.pos.z - BASE.z) : null;
            f.push({ k: "Return to Base", v: bd == null ? 0 : clamp(100 - Math.max(0, bd - 2) * 4, 0, 100), h: bd == null ? "did not land back at the base" : "landed " + bd.toFixed(1) + " m from the pad" });
          } else {
            const avgXT = S.m.xtN ? S.m.xtSum / S.m.xtN : 0;
            const routeS = S.failed && /no-fly/.test(S.failed) ? 0 : clamp(100 - avgXT * 9 - Math.max(0, S.m.xtMax - 3) * 3, 0, 100);
            f.push({ k: "Route Accuracy", v: routeS, h: "average " + avgXT.toFixed(1) + " m off the planned line" });
          }
          const dropS = !L || L.wet ? 0 : clamp(100 * (1 - (L.d - 0.25 * r) / (1.75 * r)) - (L.cond === "damaged" ? 40 : L.cond === "dented" ? 12 : 0), 0, 100);
          f.push({ k: "Set-down Accuracy", v: dropS, h: L ? L.d.toFixed(1) + " m from the centre (zone " + r + " m)" + (L.wet ? "" : " · " + L.cond) : "not delivered" });
          const hv = Math.max(L && !L.wet ? L.v : 0, S.m.hardest);
          f.push({ k: "Gentle Landing", v: S.crashed ? 0 : clamp(100 - Math.max(0, hv - 0.8) * 35, 0, 100), h: "hardest touch-down " + hv.toFixed(1) + " m/s" });
          const mc = S.m.minClear;
          const altS = S.crashed ? 0 : mc === Infinity ? 100 : clamp(40 + ((mc - 2) / 6) * 60, 0, 100);
          f.push({ k: "Altitude Control", v: altS, h: S.crashed ? "crashed" : "closest clearance " + (mc === Infinity ? "—" : mc.toFixed(1) + " m") });
          if (manual) {
            // 12 m out, the drone should be slow enough to stop within about 7 m
            const av = S.m.appV,
              vSafe = Math.sqrt(2 * brakeA(true) * 7);
            f.push({ k: "Speed Control", v: av == null ? 0 : clamp(100 - Math.max(0, av - vSafe) * 18, 0, 100), h: av == null ? "never reached the zone" : "12 m out at " + av.toFixed(1) + " m/s (safe ≤ " + vSafe.toFixed(1) + ")" });
          } else f.push({ k: "Speed Control", v: L || S.m.xtN ? clamp(100 - Math.max(0, S.m.xtMax - 2.5) * 6, 0, 100) : 0, h: "corner overshoot " + S.m.xtMax.toFixed(1) + " m" });
          if (MISSION.wind.spd > 0.5) f.push({ k: "Wind Correction", v: !L || L.wet ? 0 : clamp(100 - (L.d / r) * 55, 0, 100), h: L ? "error at set-down " + L.d.toFixed(1) + " m" : "not delivered" });
          else f.push({ k: "Wind Correction", v: null, h: "no wind on this mission" });
          const par = missionPar();
          const ok = res.status === "success";
          const tS = ok ? clamp(100 - (Math.max(0, S.t - par) / par) * 100, 30, 100) : 0;
          f.push({ k: "Mission Time", v: tS, h: fmtT(S.t) + " (par " + fmtT(par) + ")" + (ok && S.t <= par ? " · bonus!" : "") });
          let sum = 0,
            wsum = 0;
          f.forEach((x) => {
            if (x.v == null) return;
            const wt = x.k === "Set-down Accuracy" ? 2 : 1;
            sum += x.v * wt;
            wsum += wt;
          });
          const total = Math.round(sum / wsum);
          const stars = res.status !== "success" ? 0 : total >= 85 ? 3 : total >= 65 ? 2 : 1;
          return { f, total, stars };
        }
        // par time: the planned route there and back at Medium speed, plus take-off, set-down and landing
        function missionPar() {
          const L = MISSION.par;
          if (L) return L;
          return Math.round((2 * Math.max(S.plannedLen, 50)) / SPD.med.v + 50);
        }

        /* ================= 3D world ================= */
        const C = (hex) => new THREE.Color(hex).convertSRGBToLinear();
        const renderer = new THREE.WebGLRenderer({ antialias: true, preserveDrawingBuffer: true, powerPreference: "high-performance", logarithmicDepthBuffer: true });
        renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));
        renderer.outputEncoding = THREE.sRGBEncoding;
        renderer.toneMapping = THREE.ACESFilmicToneMapping;
        renderer.toneMappingExposure = 1.0;
        renderer.shadowMap.enabled = true;
        renderer.shadowMap.type = THREE.PCFSoftShadowMap;
        $("gl").appendChild(renderer.domElement);
        const scene = new THREE.Scene();
        scene.fog = new THREE.Fog(0xc9dcec, 380, 3000);
        const camera = new THREE.PerspectiveCamera(60, 1, 0.1, 8000);
        const U = { time: { value: 0 }, wind: { value: 0 } };

        function canvasTex(w, h, draw, srgb = true) {
          const c = document.createElement("canvas");
          c.width = w;
          c.height = h;
          draw(c.getContext("2d"), w, h);
          const t = new THREE.CanvasTexture(c);
          t.anisotropy = renderer.capabilities.getMaxAnisotropy();
          if (srgb) t.encoding = THREE.sRGBEncoding;
          return t;
        }
        // wind sway for trees and grass (vertex shader tweak)
        function addSway(mat, strength) {
          mat.onBeforeCompile = (sh) => {
            sh.uniforms.uTime = U.time;
            sh.uniforms.uWind = U.wind;
            sh.vertexShader =
              "uniform float uTime;\nuniform float uWind;\n" +
              sh.vertexShader.replace(
                "#include <begin_vertex>",
                `#include <begin_vertex>
                #ifdef USE_INSTANCING
                  vec2 ip = vec2(instanceMatrix[3][0], instanceMatrix[3][2]);
                #else
                  vec2 ip = vec2(0.0);
                #endif
                float sw = sin(uTime * (1.4 + uWind * 0.25) + ip.x * 0.07 + ip.y * 0.05) + 0.4 * sin(uTime * 3.1 + ip.x * 0.13);
                float k = max(position.y - 0.2, 0.0) * ${strength.toFixed(3)} * (0.25 + uWind * 0.22);
                transformed.x += sw * k;
                transformed.z += sw * k * 0.6;`,
              );
          };
        }

        // ---- sky dome with sun ----
        const skyU = { top: { value: new THREE.Color() }, hor: { value: new THREE.Color() }, sunDir: { value: new THREE.Vector3(0, 1, 0) }, sunCol: { value: new THREE.Color() } };
        const skyMesh = new THREE.Mesh(
          new THREE.SphereGeometry(5000, 32, 20),
          new THREE.ShaderMaterial({
            uniforms: skyU,
            side: THREE.BackSide,
            depthWrite: false,
            fog: false,
            vertexShader: "varying vec3 vDir; void main(){ vDir = normalize(position); gl_Position = projectionMatrix * modelViewMatrix * vec4(position,1.0); }",
            fragmentShader: `uniform vec3 top; uniform vec3 hor; uniform vec3 sunDir; uniform vec3 sunCol; varying vec3 vDir;
              void main(){
                float h = vDir.y;
                vec3 col = mix(hor, top, pow(smoothstep(-0.02, 0.75, h), 0.7));
                col = mix(col, hor * 0.85, smoothstep(0.0, -0.25, h));
                float s = max(dot(normalize(vDir), normalize(sunDir)), 0.0);
                col += sunCol * (pow(s, 900.0) * 6.0 + pow(s, 40.0) * 0.45 + pow(s, 5.0) * 0.18);
                gl_FragColor = vec4(col, 1.0);
                #include <tonemapping_fragment>
                #include <encodings_fragment>
              }`,
          }),
        );
        skyMesh.renderOrder = -1;
        scene.add(skyMesh);
        const hemi = new THREE.HemisphereLight(0xcfe3ff, 0x4f6a35, 0.6);
        scene.add(hemi);
        const sun = new THREE.DirectionalLight(0xffffff, 1.3);
        sun.castShadow = true;
        sun.shadow.mapSize.set(2048, 2048);
        Object.assign(sun.shadow.camera, { left: -26, right: 26, top: 26, bottom: -26, near: 1, far: 700 });
        sun.shadow.bias = -0.0004;
        sun.shadow.normalBias = 0.03;
        scene.add(sun, sun.target);
        const sunDir = new THREE.Vector3();
        sun.shadow.mapSize.set(3072, 3072);
        Object.assign(sun.shadow.camera, { left: -55, right: 55, top: 55, bottom: -55, near: 1, far: 900 });
        sun.shadow.camera.updateProjectionMatrix();
        sun.shadow.bias = -0.00025;
        sun.shadow.normalBias = 0.04;
        const detailTex = canvasTex(512, 512, (g, w, h) => {
          g.fillStyle = "#e3e3e3";
          g.fillRect(0, 0, w, h);
          // soft clumps
          for (let i = 0; i < 70; i++) {
            const x = Math.random() * w,
              y = Math.random() * h,
              r = 20 + Math.random() * 60;
            const gr = g.createRadialGradient(x, y, 1, x, y, r);
            const v = Math.random() < 0.5 ? "190,190,190" : "255,255,255";
            gr.addColorStop(0, "rgba(" + v + ",0.35)");
            gr.addColorStop(1, "rgba(" + v + ",0)");
            g.fillStyle = gr;
            g.fillRect(x - r, y - r, r * 2, r * 2);
          }
          // grass blades
          for (let i = 0; i < 16000; i++) {
            const v = 150 + Math.random() * 105;
            g.strokeStyle = "rgba(" + v + "," + v + "," + v + ",0.5)";
            const x = Math.random() * w,
              y = Math.random() * h,
              l = 2 + Math.random() * 5;
            g.beginPath();
            g.moveTo(x, y);
            g.lineTo(x + (Math.random() - 0.5) * 2, y - l);
            g.stroke();
          }
        });
        detailTex.wrapS = detailTex.wrapT = THREE.RepeatWrapping;
        {
          const TER = 10000,
            SEG = 250;
          const tg = new THREE.PlaneGeometry(TER, TER, SEG, SEG);
          tg.rotateX(-Math.PI / 2);
          const p = tg.attributes.position;
          const cols = [];
          const cA = C(0x4a6b2a),
            cB = C(0x67873a),
            cF = C(0x3e6534),
            cR = C(0x857f74),
            cS = C(0xf3f5f8),
            c = new THREE.Color();
          for (let i = 0; i < p.count; i++) {
            const x = p.getX(i),
              z = p.getZ(i);
            const y = groundFar(x, z, Math.hypot(x, z));
            p.setY(i, y);
            c.copy(cA).lerp(cB, fbm(x / 120, z / 120));
            if (y > 15) c.lerp(cF, smooth((y - 15) / 80) * 0.8);
            if (y > 300) c.lerp(cR, smooth((y - 300) / 140));
            if (y > 520) c.lerp(cS, smooth((y - 520) / 90));
            cols.push(c.r, c.g, c.b);
          }
          tg.setAttribute("color", new THREE.Float32BufferAttribute(cols, 3));
          tg.computeVertexNormals();
          // rock on steep slopes
          {
            const nrm = tg.attributes.normal,
              col = tg.attributes.color,
              cc = new THREE.Color();
            for (let i = 0; i < nrm.count; i++) {
              const k = smooth((0.88 - nrm.getY(i)) / 0.18);
              if (k <= 0) continue;
              cc.setRGB(col.getX(i), col.getY(i), col.getZ(i)).lerp(cR, k * 0.85);
              col.setXYZ(i, cc.r, cc.g, cc.b);
            }
          }
          detailTex.repeat.set(TER / 9, TER / 9);
          const terMat = new THREE.MeshStandardMaterial({ vertexColors: true, map: detailTex, roughness: 0.97, metalness: 0, envMapIntensity: 0.45 });
          // sample the detail texture at two scales so the repeat pattern does not show
          terMat.onBeforeCompile = (sh) => {
            sh.vertexShader = "varying vec3 vWP;\n" + sh.vertexShader.replace("#include <begin_vertex>", "#include <begin_vertex>\n vWP = (modelMatrix * vec4(transformed, 1.0)).xyz;");
            sh.fragmentShader =
              `varying vec3 vWP;
              float gh(vec2 p) { return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453); }
              float gn(vec2 p) { vec2 i = floor(p), f = fract(p); vec2 u = f * f * (3.0 - 2.0 * f);
                return mix(mix(gh(i), gh(i + vec2(1.0, 0.0)), u.x), mix(gh(i + vec2(0.0, 1.0)), gh(i + vec2(1.0, 1.0)), u.x), u.y); }
              float gf(vec2 p) { return gn(p) * 0.5 + gn(p * 2.03 + 7.1) * 0.27 + gn(p * 4.1 + 3.3) * 0.15 + gn(p * 8.3 + 1.7) * 0.08; }
              ` +
              sh.fragmentShader.replace(
                "#include <map_fragment>",
                `#ifdef USE_MAP
                  vec4 texelColor = texture2D( map, vUv ) * 0.55 + texture2D( map, vUv * 0.113 + vec2(0.37, 0.71) ) * 0.55;
                  texelColor = mapTexelToLinear( texelColor );
                  diffuseColor *= texelColor;
                #endif
                {
                  vec2 q = vWP.xz;
                  float big = gf(q * 0.011);
                  float mid = gf(q * 0.045 + 17.0);
                  float fine = gn(q * 0.6) * 0.6 + gn(q * 2.1) * 0.4;
                  float dry = smoothstep(0.5, 0.74, big) * 0.75;
                  diffuseColor.rgb = mix(diffuseColor.rgb, diffuseColor.rgb * vec3(1.55, 1.32, 0.72), dry);
                  diffuseColor.rgb *= mix(1.0, 0.7, smoothstep(0.52, 0.8, mid));
                  float soil = smoothstep(0.8, 0.88, gf(q * 0.05 + 41.0)) * step(vWP.y, 2.0);
                  diffuseColor.rgb = mix(diffuseColor.rgb, vec3(0.36, 0.29, 0.18), soil * 0.5);
                  diffuseColor.rgb *= 0.86 + 0.28 * fine;
                }`,
              );
          };
          const terrain = new THREE.Mesh(tg, terMat);
          terrain.receiveShadow = true;
          scene.add(terrain);
        }
        const flatMat = (tex, extra) =>
          new THREE.MeshStandardMaterial(Object.assign({ map: tex, roughness: 0.95, metalness: 0, polygonOffset: true, polygonOffsetFactor: -2, polygonOffsetUnits: -2 }, extra || {}));
        // crop fields (scenery)
        // crop fields
        const cropTex = [
          ["#d6b25a", "#b8923e", 0],
          ["#7c5a3c", "#5f432b", 0],
          ["#6e9f3d", "#4f7d2a", 0],
          ["#e2cf3e", "#9fb43a", 1],
        ].map(([a, b, spk]) =>
          canvasTex(256, 256, (g, w, h) => {
            g.fillStyle = a;
            g.fillRect(0, 0, w, h);
            for (let y = 0; y < h; y += 16) {
              g.fillStyle = b;
              g.fillRect(0, y, w, 6);
            }
            for (let i = 0; i < 2500; i++) {
              g.fillStyle = spk ? "rgba(80,130,40,0.4)" : "rgba(0,0,0,0.08)";
              g.fillRect(Math.random() * w, Math.random() * h, 2, 2);
            }
          }),
        );
        cropTex.forEach((t) => (t.wrapS = t.wrapT = THREE.RepeatWrapping));
        PATCHES.forEach((p) => {
          const t = cropTex[p.type].clone();
          t.needsUpdate = true;
          t.repeat.set(p.w / 22, p.d / 22);
          const m = new THREE.Mesh(new THREE.PlaneGeometry(p.w, p.d), flatMat(t));
          m.rotation.order = "YXZ";
          m.rotation.set(-Math.PI / 2, p.rot, 0);
          m.position.set(p.x, decalY(p.x, p.z, 0.25), p.z);
          m.receiveShadow = true;
          scene.add(m);
        });
        // lake with an island (the island is a drop zone)
        // lake with moving ripples
        const waterNormal = (() => {
          const N = 256,
            hgt = new Float32Array(N * N);
          for (let y = 0; y < N; y++)
            for (let x = 0; x < N; x++) {
              const u = (x / N) * TAU,
                v = (y / N) * TAU;
              hgt[y * N + x] = Math.sin(u * 3 + Math.sin(v * 2) * 1.5) + 0.6 * Math.sin(v * 5 + u * 2) + 0.35 * Math.sin(u * 9 - v * 7) + 0.25 * Math.sin(u * 13 + v * 11);
            }
          return canvasTex(
            N,
            N,
            (g) => {
              const img = g.createImageData(N, N);
              for (let y = 0; y < N; y++)
                for (let x = 0; x < N; x++) {
                  const dx = hgt[y * N + ((x + 1) % N)] - hgt[y * N + ((x - 1 + N) % N)];
                  const dy = hgt[((y + 1) % N) * N + x] - hgt[((y - 1 + N) % N) * N + x];
                  const nx = -dx * 0.35,
                    ny = -dy * 0.35,
                    l = Math.hypot(nx, ny, 1);
                  const i = (y * N + x) * 4;
                  img.data[i] = ((nx / l) * 0.5 + 0.5) * 255;
                  img.data[i + 1] = ((ny / l) * 0.5 + 0.5) * 255;
                  img.data[i + 2] = ((1 / l) * 0.5 + 0.5) * 255;
                  img.data[i + 3] = 255;
                }
              g.putImageData(img, 0, 0);
            },
            false,
          );
        })();
        waterNormal.wrapS = waterNormal.wrapT = THREE.RepeatWrapping;
        waterNormal.repeat.set(10, 10);
        function lakeShape(scale) {
          const s = new THREE.Shape();
          for (let i = 0; i <= 72; i++) {
            const a = (i / 72) * TAU,
              r = lakeR(a) * scale;
            const x = Math.cos(a) * r,
              z = Math.sin(a) * r;
            if (i === 0) s.moveTo(x, -z);
            else s.lineTo(x, -z);
          }
          return s;
        }
        const shore = new THREE.Mesh(new THREE.ShapeGeometry(lakeShape(1.12)), flatMat(null, { color: C(0xcdbb8f) }));
        shore.rotation.x = -Math.PI / 2;
        shore.position.set(LAKE.x, 0.012, LAKE.z);
        shore.receiveShadow = true;
        // the water has a hole where the island is, so the island can never be hidden under it
        const waterShape = lakeShape(1);
        {
          const hole = new THREE.Path();
          for (let i = 0; i <= 96; i++) {
            const a = (i / 96) * TAU,
              r = islandR(a);
            const x = Math.cos(a) * r,
              z = Math.sin(a) * r;
            if (i === 0) hole.moveTo(x, -z);
            else hole.lineTo(x, -z);
          }
          waterShape.holes.push(hole);
        }
        const water = new THREE.Mesh(
          new THREE.ShapeGeometry(waterShape, 48),
          new THREE.MeshStandardMaterial({ color: C(0x1d5a74), roughness: 0.07, metalness: 0.35, envMapIntensity: 1.3, normalMap: waterNormal, normalScale: new THREE.Vector2(0.55, 0.55), polygonOffset: true, polygonOffsetFactor: -4, polygonOffsetUnits: -4 }),
        );
        water.rotation.x = -Math.PI / 2;
        water.position.set(LAKE.x, 0.06, LAKE.z);
        water.receiveShadow = true;
        scene.add(shore, water);
        // the island: a real raised mound (grass on top, a sandy beach down to the water), a jetty and a moored boat
        {
          const NA = 120,
            NJ = 26;
          const pos = [],
            col = [],
            uv = [],
            idx = [];
          const cWet = C(0xa8935f),
            cSand = C(0xe3cf98),
            cG1 = C(0x6fa83f),
            cG2 = C(0x4f8a30),
            cc = new THREE.Color();
          pos.push(LAKE.x, ISLAND_H, LAKE.z);
          cc.copy(cG1);
          col.push(cc.r, cc.g, cc.b);
          uv.push(LAKE.x / 10000 + 0.5, 0.5 - LAKE.z / 10000);
          for (let i = 0; i < NA; i++) {
            const a = (i / NA) * TAU,
              R = islandR(a);
            for (let j = 1; j <= NJ; j++) {
              // rings packed tighter at the beach, where the shape changes
              const f = j / NJ,
                d = (f < 0.55 ? (f / 0.55) * 0.6 : 0.6 + ((f - 0.55) / 0.45) * 0.52) * R;
              const x = LAKE.x + Math.cos(a) * d,
                z = LAKE.z + Math.sin(a) * d;
              let y;
              if (d <= R) y = islandH(x, z);
              else y = 0.14 - (d - R) * 0.5; // runs on under the water
              pos.push(x, y, z);
              const top = (y - 0.14) / (ISLAND_H - 0.14);
              if (d > R - 0.6) cc.copy(cWet);
              else if (top < 0.55) cc.copy(cWet).lerp(cSand, Math.min(1, (R - 0.6 - d) / 1.2));
              else cc.copy(cSand).lerp(cG1, smooth((top - 0.55) / 0.3));
              if (top >= 0.55) cc.lerp(cG2, Math.max(0, fbm(x / 7, z / 7) - 0.35) * 1.6 * smooth((top - 0.55) / 0.3));
              col.push(cc.r, cc.g, cc.b);
              uv.push(x / 10000 + 0.5, 0.5 - z / 10000);
            }
          }
          const V = (i, j) => (j === 0 ? 0 : 1 + (i % NA) * NJ + (j - 1));
          for (let i = 0; i < NA; i++)
            for (let j = 0; j < NJ; j++) {
              if (j === 0) idx.push(0, V(i + 1, 1), V(i, 1));
              else idx.push(V(i, j), V(i + 1, j), V(i + 1, j + 1), V(i, j), V(i + 1, j + 1), V(i, j + 1));
            }
          const ig = new THREE.BufferGeometry();
          ig.setAttribute("position", new THREE.Float32BufferAttribute(pos, 3));
          ig.setAttribute("color", new THREE.Float32BufferAttribute(col, 3));
          ig.setAttribute("uv", new THREE.Float32BufferAttribute(uv, 2));
          ig.setIndex(idx);
          ig.computeVertexNormals();
          const island = new THREE.Mesh(ig, new THREE.MeshStandardMaterial({ vertexColors: true, map: detailTex, roughness: 0.96, metalness: 0, envMapIntensity: 0.45 }));
          island.receiveShadow = true;
          scene.add(island);
          // a light foam line where the beach meets the water: easy to spot from high up
          const foamPts = [];
          for (let i = 0; i <= 120; i++) {
            const a = (i / 120) * TAU;
            foamPts.push(new THREE.Vector2(Math.cos(a) * (islandR(a) + 0.15), -Math.sin(a) * (islandR(a) + 0.15)));
          }
          const foamShape = new THREE.Shape(foamPts.map((p) => p.clone().multiplyScalar((ISLAND_R + 1.4) / ISLAND_R)));
          foamShape.holes.push(new THREE.Path(foamPts));
          const foam = new THREE.Mesh(new THREE.ShapeGeometry(foamShape, 4), new THREE.MeshBasicMaterial({ color: 0xeaf6fb, transparent: true, opacity: 0.55, depthWrite: false, polygonOffset: true, polygonOffsetFactor: -8, polygonOffsetUnits: -8 }));
          foam.rotation.x = -Math.PI / 2;
          foam.position.set(LAKE.x, 0.075, LAKE.z);
          scene.add(foam);
          // jetty pointing towards the base
          const wood = new THREE.MeshStandardMaterial({ color: C(0x8a6744), roughness: 0.9 });
          const jg = new THREE.Group();
          const deck = new THREE.Mesh(new THREE.BoxGeometry(9, 0.14, 1.7), wood);
          deck.position.set(4.5, 0.62, 0);
          jg.add(deck);
          for (const px of [1.6, 4.6, 7.6, 8.8])
            for (const pz of [-0.78, 0.78]) {
              const post = new THREE.Mesh(new THREE.CylinderGeometry(0.09, 0.09, 1.3, 6), wood);
              post.position.set(px, 0.2, pz);
              jg.add(post);
            }
          const Rj = islandR(JETTY_A) - 1.2;
          jg.position.set(LAKE.x + Math.cos(JETTY_A) * Rj, 0, LAKE.z + Math.sin(JETTY_A) * Rj);
          jg.rotation.y = -JETTY_A;
          // a small rowing boat tied up at the end of the jetty
          const hullM = new THREE.MeshStandardMaterial({ color: C(0xc8442e), roughness: 0.6, side: THREE.DoubleSide });
          const boat = new THREE.Group();
          // half a cylinder lying along the boat, curved side down
          const hull = new THREE.Mesh(new THREE.CylinderGeometry(0.62, 0.62, 3.2, 12, 1, true, 0, Math.PI), hullM);
          hull.rotation.z = -Math.PI / 2;
          hull.scale.x = 0.7;
          const endM = new THREE.MeshStandardMaterial({ color: C(0xe9e2d4), roughness: 0.7, side: THREE.DoubleSide });
          for (const ex of [-1.6, 1.6]) {
            const cap = new THREE.Mesh(new THREE.CircleGeometry(0.62, 12, Math.PI, Math.PI), endM);
            cap.rotation.y = Math.PI / 2;
            cap.scale.y = 0.7;
            cap.position.x = ex;
            boat.add(cap);
          }
          const seat = new THREE.Mesh(new THREE.BoxGeometry(0.25, 0.06, 1.15), wood);
          seat.position.y = -0.06;
          const floor = new THREE.Mesh(new THREE.BoxGeometry(3.0, 0.04, 0.62), wood);
          floor.position.y = -0.27;
          boat.add(hull, seat, floor);
          boat.position.set(7.4, 0.42, 1.9);
          jg.add(boat);
          jg.traverse((m) => m.isMesh && ((m.castShadow = true), (m.receiveShadow = true)));
          scene.add(jg);
          {
            // jetty and boat (local x runs out over the water)
            const ry = -JETTY_A,
              wx = (lx, lz) => jg.position.x + lx * Math.cos(ry) + lz * Math.sin(ry),
              wz = (lx, lz) => jg.position.z - lx * Math.sin(ry) + lz * Math.cos(ry);
            addBox(wx(4.5, 0), wz(4.5, 0), 9, 1.8, ry, 0, 0.75, "jetty");
            addBox(wx(7.4, 1.9), wz(7.4, 1.9), 3.3, 1.0, ry, 0, 0.8, "boat");
          }
        }
        const castAll = (o) => o.traverse((m) => m.isMesh && ((m.castShadow = true), (m.receiveShadow = true)));
        function buildCar(color) {
          const g = new THREE.Group();
          const paint = new THREE.MeshPhysicalMaterial({ color: C(color), roughness: 0.3, metalness: 0.5, clearcoat: 1, clearcoatRoughness: 0.1 });
          const glass = new THREE.MeshStandardMaterial({ color: C(0x1b2633), roughness: 0.05, metalness: 0.6 });
          const tyre = new THREE.MeshStandardMaterial({ color: C(0x1a1a1a), roughness: 0.9 });
          const body = new THREE.Mesh(new THREE.BoxGeometry(4.2, 0.75, 1.8), paint);
          body.position.y = 0.65;
          const cab = new THREE.Mesh(new THREE.BoxGeometry(2.3, 0.62, 1.62), glass);
          cab.position.set(-0.2, 1.32, 0);
          const roof = new THREE.Mesh(new THREE.BoxGeometry(2.0, 0.06, 1.6), paint);
          roof.position.set(-0.25, 1.66, 0);
          g.add(body, cab, roof);
          const wg = new THREE.CylinderGeometry(0.34, 0.34, 0.25, 16);
          wg.rotateX(Math.PI / 2);
          for (const [x, z] of [[1.35, 0.85], [1.35, -0.85], [-1.35, 0.85], [-1.35, -0.85]]) {
            const w = new THREE.Mesh(wg, tyre);
            w.position.set(x, 0.34, z);
            g.add(w);
          }
          const lamp = new THREE.Mesh(new THREE.BoxGeometry(0.05, 0.14, 0.4), new THREE.MeshStandardMaterial({ color: 0xffffff, emissive: 0xfff2c0, emissiveIntensity: 0.6 }));
          lamp.position.set(2.11, 0.75, 0.6);
          const lamp2 = lamp.clone();
          lamp2.position.z = -0.6;
          g.add(lamp, lamp2);
          castAll(g);
          return g;
        }
        // dirt tracks between the base, the village and the farm
        {
          const trackTex = canvasTex(64, 512, (g, w, h) => {
            g.fillStyle = "#a08a64";
            g.fillRect(0, 0, w, h);
            for (let i = 0; i < 1600; i++) {
              const v = 120 + Math.random() * 70;
              g.fillStyle = "rgba(" + v + "," + (v * 0.88) + "," + (v * 0.66) + ",0.5)";
              g.fillRect(Math.random() * w, Math.random() * h, 2, 2);
            }
            g.fillStyle = "rgba(110,150,70,0.55)";
            g.fillRect(w * 0.44, 0, w * 0.12, h);
          });
          trackTex.wrapS = trackTex.wrapT = THREE.RepeatWrapping;
          const track = (a, b) => {
            const L = Math.hypot(b.x - a.x, b.z - a.z);
            const t = trackTex.clone();
            t.needsUpdate = true;
            t.repeat.set(1, L / 12);
            const m = new THREE.Mesh(new THREE.PlaneGeometry(3.4, L), flatMat(t));
            m.rotation.order = "YXZ";
            m.rotation.set(-Math.PI / 2, Math.atan2(-(b.x - a.x), -(b.z - a.z)), 0);
            m.position.set((a.x + b.x) / 2, decalY(0, 0, 0.45), (a.z + b.z) / 2);
            m.receiveShadow = true;
            scene.add(m);
          };
          TRACKS.forEach((T) => T.forEach((b, i) => i && track(T[i - 1], b)));
          // paved square (setts in rings) and packed-earth yards
          const pavedTex = canvasTex(512, 512, (g, w) => {
            g.fillStyle = "#8f8a80";
            g.fillRect(0, 0, w, w);
            for (let y = 0; y < w; y += 16)
              for (let x = (y / 16) % 2 ? 0 : 10; x < w; x += 20) {
                const v = 150 + Math.random() * 60;
                g.fillStyle = "rgb(" + v + "," + (v * 0.97) + "," + (v * 0.92) + ")";
                g.fillRect(x + 1, y + 1, 18, 14);
              }
          });
          pavedTex.wrapS = pavedTex.wrapT = THREE.RepeatWrapping;
          pavedTex.repeat.set(5, 5);
          const dirtTex = canvasTex(256, 256, (g, w) => {
            g.fillStyle = "#9c8460";
            g.fillRect(0, 0, w, w);
            for (let i = 0; i < 4000; i++) {
              const v = 110 + Math.random() * 80;
              g.fillStyle = "rgba(" + v + "," + v * 0.86 + "," + v * 0.64 + ",0.6)";
              g.fillRect(Math.random() * w, Math.random() * w, 2, 2);
            }
          });
          dirtTex.wrapS = dirtTex.wrapT = THREE.RepeatWrapping;
          dirtTex.repeat.set(4, 4);
          PLAZAS.forEach((p) => {
            const m = new THREE.Mesh(new THREE.CircleGeometry(p.r, 64), flatMat(p.kind === "paved" ? pavedTex : dirtTex, { roughness: p.kind === "paved" ? 0.8 : 0.97 }));
            m.rotation.x = -Math.PI / 2;
            m.position.set(p.x, decalY(p.x, p.z, 0.3), p.z);
            m.receiveShadow = true;
            scene.add(m);
            if (p.kind === "paved") {
              const kerb = new THREE.Mesh(new THREE.RingGeometry(p.r - 0.35, p.r, 64), flatMat(null, { color: C(0xb9b4aa) }));
              kerb.rotation.x = -Math.PI / 2;
              kerb.position.set(p.x, decalY(p.x, p.z, 0.32), p.z);
              kerb.receiveShadow = true;
              scene.add(kerb);
            }
          });
          const gravelTex = canvasTex(64, 256, (g, w, h) => {
            g.fillStyle = "#b3a68c";
            g.fillRect(0, 0, w, h);
            for (let i = 0; i < 900; i++) {
              const v = 140 + Math.random() * 90;
              g.fillStyle = "rgba(" + v + "," + v * 0.95 + "," + v * 0.85 + ",0.8)";
              g.fillRect(Math.random() * w, Math.random() * h, 2, 2);
            }
          });
          gravelTex.wrapS = gravelTex.wrapT = THREE.RepeatWrapping;
          PATHS.forEach((pth) => {
            const L = Math.hypot(pth.b.x - pth.a.x, pth.b.z - pth.a.z);
            const t = gravelTex.clone();
            t.needsUpdate = true;
            t.repeat.set(1, L / 6);
            const m = new THREE.Mesh(new THREE.PlaneGeometry(pth.w, L), flatMat(t));
            m.rotation.order = "YXZ";
            m.rotation.set(-Math.PI / 2, Math.atan2(-(pth.b.x - pth.a.x), -(pth.b.z - pth.a.z)), 0);
            m.position.set((pth.a.x + pth.b.x) / 2, decalY(pth.a.x, pth.a.z, 0.4), (pth.a.z + pth.b.z) / 2);
            m.receiveShadow = true;
            scene.add(m);
          });
        }

        // ---- trees and grass (instanced, swaying in the wind) ----
        // ---- trees and grass (instanced, swaying in the wind) ----
        function mergeColored(parts) {
          const pos = [],
            nor = [],
            col = [];
          for (const { g, color } of parts) {
            const ng = g.index ? g.toNonIndexed() : g;
            const c = C(color);
            const p = ng.attributes.position,
              n = ng.attributes.normal;
            for (let i = 0; i < p.count; i++) {
              pos.push(p.getX(i), p.getY(i), p.getZ(i));
              nor.push(n.getX(i), n.getY(i), n.getZ(i));
              col.push(c.r, c.g, c.b);
            }
          }
          const out = new THREE.BufferGeometry();
          out.setAttribute("position", new THREE.Float32BufferAttribute(pos, 3));
          out.setAttribute("normal", new THREE.Float32BufferAttribute(nor, 3));
          out.setAttribute("color", new THREE.Float32BufferAttribute(col, 3));
          return out;
        }
        const at = (g, x, y, z, sx, sy, sz) => {
          g.scale(sx || 1, sy || 1, sz || 1);
          g.translate(x, y, z);
          return g;
        };
        // one part of a tree with its own per-vertex colours
        function partGeo(g, colFn) {
          const ng = g.index ? g.toNonIndexed() : g;
          const p = ng.attributes.position,
            col = [];
          const c = new THREE.Color();
          for (let i = 0; i < p.count; i++) {
            colFn(c, p.getX(i), p.getY(i), p.getZ(i), i);
            col.push(c.r, c.g, c.b);
          }
          ng.setAttribute("color", new THREE.Float32BufferAttribute(col, 3));
          return ng;
        }
        function mergeParts(parts) {
          const pos = [],
            nor = [],
            col = [];
          parts.forEach((g) => {
            const p = g.attributes.position,
              n = g.attributes.normal,
              c = g.attributes.color;
            for (let i = 0; i < p.count; i++) {
              pos.push(p.getX(i), p.getY(i), p.getZ(i));
              nor.push(n.getX(i), n.getY(i), n.getZ(i));
              col.push(c.getX(i), c.getY(i), c.getZ(i));
            }
          });
          const out = new THREE.BufferGeometry();
          out.setAttribute("position", new THREE.Float32BufferAttribute(pos, 3));
          out.setAttribute("normal", new THREE.Float32BufferAttribute(nor, 3));
          out.setAttribute("color", new THREE.Float32BufferAttribute(col, 3));
          return out;
        }
        // a leafy clump: a sphere pushed in and out by noise, smooth normals, darker below and inside
        function leafClump(r, cx, cy, cz, sx, sy, sz, hex, seed, detail) {
          const g = new THREE.IcosahedronGeometry(1, detail).toNonIndexed();
          const p = g.attributes.position,
            n = g.attributes.normal;
          const base = C(hex),
            v = new THREE.Vector3();
          const col = [];
          for (let i = 0; i < p.count; i++) {
            v.set(p.getX(i), p.getY(i), p.getZ(i)).normalize();
            const k = 1 + 0.32 * (vnoise(v.x * 2.6 + seed, v.z * 2.6 + v.y * 1.9 + seed * 0.7) - 0.5) + 0.12 * (vnoise(v.x * 7 + seed, v.y * 7 - v.z * 3) - 0.5);
            p.setXYZ(i, cx + v.x * r * sx * k, cy + v.y * r * sy * k, cz + v.z * r * sz * k);
            n.setXYZ(i, v.x / sx, v.y / sy, v.z / sz);
            const shade = 0.5 + 0.5 * smooth((v.y + 0.7) / 1.5);
            const tint = 0.92 + 0.16 * vnoise(v.x * 5 + seed, v.z * 5);
            col.push(base.r * shade * tint, base.g * shade * tint, base.b * shade * (tint * 0.97));
          }
          g.setAttribute("color", new THREE.Float32BufferAttribute(col, 3));
          g.normalizeNormals();
          return g;
        }
        function trunkGeo(r0, r1, h, x, y, z, tiltX, tiltZ) {
          const g = new THREE.CylinderGeometry(r1, r0, h, 8, 3);
          g.translate(0, h / 2, 0);
          g.rotateX(tiltX || 0);
          g.rotateZ(tiltZ || 0);
          g.translate(x, y, z);
          return partGeo(g, (c, px, py) => c.copy(C(0x4a3627)).multiplyScalar(0.75 + 0.35 * clamp(py, 0, 1)));
        }
        // a conifer: drooping, ragged tiers of needles round a straight trunk
        function pineGeom(detail) {
          const parts = [trunkGeo(0.05, 0.025, 0.95, 0, 0, 0)];
          const tiers = detail ? 6 : 4;
          for (let t = 0; t < tiers; t++) {
            const f = t / (tiers - 1);
            const r = 0.38 - f * 0.27,
              hgt = 0.3 - f * 0.08,
              y = 0.2 + f * 0.62;
            const g = new THREE.ConeGeometry(r, hgt, detail ? 14 : 9, 2);
            const p = g.attributes.position;
            for (let i = 0; i < p.count; i++) {
              const x = p.getX(i),
                yy = p.getY(i),
                z = p.getZ(i);
              const a = Math.atan2(z, x),
                rim = Math.hypot(x, z) / r;
              // ragged, drooping rim
              const jag = 1 + 0.16 * Math.sin(a * 7 + t * 1.7) * rim + 0.08 * Math.sin(a * 13 + t) * rim;
              p.setXYZ(i, x * jag, yy - rim * rim * hgt * 0.22, z * jag);
            }
            g.computeVertexNormals();
            g.translate(0, y + hgt / 2, 0);
            const base = C(0x23472a);
            parts.push(
              partGeo(g, (c, px, py, pz) => {
                const rim = Math.hypot(px, pz) / r;
                const k = 0.55 + 0.45 * clamp(rim, 0, 1) * (0.8 + 0.2 * f) + (py > y + hgt * 0.3 ? 0.08 : 0);
                c.copy(base).multiplyScalar(k * (0.9 + 0.2 * vnoise(px * 30, pz * 30)));
              }),
            );
          }
          return mergeParts(parts);
        }
        // a broadleaf tree: forked trunk and several leafy clumps
        function broadGeom(detail) {
          const d = detail ? 2 : 0;
          return mergeParts([
            trunkGeo(0.055, 0.035, 0.46, 0, 0, 0),
            trunkGeo(0.03, 0.015, 0.28, 0.02, 0.36, 0, 0, -0.55),
            trunkGeo(0.03, 0.015, 0.26, -0.02, 0.38, 0, 0.35, 0.5),
            leafClump(0.3, 0, 0.66, 0, 1, 0.82, 1, 0x3f6a2c, 1.3, d),
            leafClump(0.22, 0.19, 0.55, 0.07, 1, 0.85, 1, 0x3a6328, 4.1, detail ? 1 : 0),
            leafClump(0.22, -0.17, 0.6, -0.1, 1, 0.85, 1, 0x45722f, 7.7, detail ? 1 : 0),
            leafClump(0.19, 0.05, 0.84, 0.04, 1, 0.9, 1, 0x4c7a33, 2.9, detail ? 1 : 0),
            leafClump(0.17, -0.06, 0.52, 0.2, 1, 0.8, 1, 0x3b6529, 5.5, detail ? 1 : 0),
          ]);
        }
        // a poplar: tall, narrow crown
        function poplarGeom(detail) {
          const d = detail ? 2 : 0;
          return mergeParts([
            trunkGeo(0.045, 0.025, 0.35, 0, 0, 0),
            leafClump(0.3, 0, 0.6, 0, 0.72, 1.45, 0.72, 0x46702c, 3.3, d),
            leafClump(0.2, 0.04, 0.88, 0.02, 0.68, 1.3, 0.68, 0x4e7a33, 8.1, detail ? 1 : 0),
            leafClump(0.18, -0.05, 0.42, 0.05, 0.8, 1.0, 0.8, 0x3f6828, 6.2, detail ? 1 : 0),
          ]);
        }
        const pineGeo = pineGeom(true),
          broadGeo = broadGeom(true),
          poplarGeo = poplarGeom(true);
        // simpler shapes for the far woods (thousands of trees)
        const farGeos = [pineGeom(false), broadGeom(false), poplarGeom(false)];
        const treeMat = new THREE.MeshStandardMaterial({ vertexColors: true, roughness: 0.88, envMapIntensity: 0.35 });
        addSway(treeMat, 0.05);
        const treeMeshes = [];
        function plantTrees(list, castShadow) {
          for (const type of [0, 1, 2]) {
            const L = list.filter((t) => t.type === type);
            if (!L.length) continue;
            const im = new THREE.InstancedMesh(castShadow ? [pineGeo, broadGeo, poplarGeo][type] : farGeos[type], treeMat, L.length);
            const m = new THREE.Matrix4(),
              q = new THREE.Quaternion(),
              s = new THREE.Vector3(),
              p = new THREE.Vector3(),
              c = new THREE.Color();
            L.forEach((t, i) => {
              const wdt = t.h * [0.75, 0.95, 0.5][type];
              q.setFromAxisAngle(new THREE.Vector3(0, 1, 0), hash2(Math.round(t.x), Math.round(t.z)) * TAU);
              m.compose(p.set(t.x, t.y - SURF - 0.05, t.z), q, s.set(wdt, t.h, wdt));
              im.setMatrixAt(i, m);
              const v = 0.8 + hash2(Math.round(t.z), Math.round(t.x)) * 0.4;
              im.setColorAt(i, c.setRGB(v, v * (0.95 + Math.random() * 0.1), v * 0.9));
            });
            im.castShadow = castShadow;
            im.frustumCulled = false;
            im.receiveShadow = true;
            im.instanceMatrix.needsUpdate = true;
            scene.add(im);
            treeMeshes.push(im);
          }
        }
        plantTrees(TREES.filter((t) => Math.hypot(t.x, t.z) < 460), true);
        plantTrees(TREES.filter((t) => Math.hypot(t.x, t.z) >= 460), false);
        const aoTex = canvasTex(128, 128, (g, w) => {
          const gr = g.createRadialGradient(w / 2, w / 2, 0, w / 2, w / 2, w / 2);
          gr.addColorStop(0, "rgba(0,0,0,0.55)");
          gr.addColorStop(0.45, "rgba(0,0,0,0.32)");
          gr.addColorStop(1, "rgba(0,0,0,0)");
          g.fillStyle = gr;
          g.fillRect(0, 0, w, w);
        });
        const aoMat = new THREE.MeshBasicMaterial({ map: aoTex, transparent: true, depthWrite: false, fog: true });
        // list: [x, z, size x, size z, rotation]
        function contactShadows(list) {
          const geo = new THREE.PlaneGeometry(1, 1);
          geo.rotateX(-Math.PI / 2);
          const im = new THREE.InstancedMesh(geo, aoMat, list.length);
          const m = new THREE.Matrix4(),
            q = new THREE.Quaternion(),
            s = new THREE.Vector3(),
            p = new THREE.Vector3(),
            Y = new THREE.Vector3(0, 1, 0);
          list.forEach(([x, z, sx, sz, r], i) => {
            q.setFromAxisAngle(Y, r || 0);
            m.compose(p.set(x, decalY(x, z, 0.35), z), q, s.set(sx, 1, sz));
            im.setMatrixAt(i, m);
          });
          im.renderOrder = 1;
          scene.add(im);
        }
        contactShadows(
          TREES.filter((t) => Math.hypot(t.x, t.z) < 460)
            .map((t) => [t.x, t.z, t.h * 0.62, t.h * 0.62, 0])
            .concat(HOUSES.map((hs) => [hs.x, hs.z, hs.w + 3.2, hs.d + 3.2, hs.rot]))
            .concat([[SILO.x, SILO.z, SILO.r * 2.9, SILO.r * 2.9, 0]]),
        );
        const grassGeo = (() => {
          const pos = [],
            col = [],
            nor = [];
          const lo = C(0x3a5a22),
            hi = C(0x95b257);
          for (let k = 0; k < 3; k++) {
            const a = (k / 3) * Math.PI;
            const cx = Math.cos(a) * 0.5,
              cz = Math.sin(a) * 0.5;
            const quad = [[-cx, 0, -cz, lo], [cx, 0, cz, lo], [cx * 0.3, 1, cz * 0.3, hi], [-cx, 0, -cz, lo], [cx * 0.3, 1, cz * 0.3, hi], [-cx * 0.3, 1, -cz * 0.3, hi]];
            // both faces, each lit from above (no dark back faces)
            for (const [x, y, z, c] of quad.concat(quad.slice().reverse())) {
              pos.push(x, y, z);
              col.push(c.r, c.g, c.b);
              nor.push(0, 1, 0);
            }
          }
          const g = new THREE.BufferGeometry();
          g.setAttribute("position", new THREE.Float32BufferAttribute(pos, 3));
          g.setAttribute("color", new THREE.Float32BufferAttribute(col, 3));
          g.setAttribute("normal", new THREE.Float32BufferAttribute(nor, 3));
          return g;
        })();
        const grassMat = new THREE.MeshLambertMaterial({ vertexColors: true });
        addSway(grassMat, 0.35);
        const GRASS_N = 26000;
        const grass = new THREE.InstancedMesh(grassGeo, grassMat, GRASS_N);
        {
          const m = new THREE.Matrix4(),
            q = new THREE.Quaternion(),
            s = new THREE.Vector3(),
            p = new THREE.Vector3(),
            c = new THREE.Color(),
            Y = new THREE.Vector3(0, 1, 0);
          let n = 0;
          for (let i = 0; i < 60000 && n < GRASS_N; i++) {
            // denser near the base and the drop zones, where the camera usually is
            const hub = Math.random() < 0.55 ? (Math.random() < 0.3 ? BASE : ZONES[Math.floor(Math.random() * ZONES.length)]) : null;
            const x = hub ? hub.x + (Math.random() - 0.5) * 120 : (Math.random() - 0.5) * 600,
              z = hub ? hub.z + (Math.random() - 0.5) * 120 : (Math.random() - 0.5) * 600;
            if (Math.hypot(x, z) < 9 || inLake(x, z)) continue;
            if (Math.hypot(x - LAKE.x, z - LAKE.z) > ISLAND_R * 1.3 && landBlocked(x, z, 0.2)) continue;
            // on the island: only on the grassy top, not on the beach
            if (Math.hypot(x - LAKE.x, z - LAKE.z) < ISLAND_R * 1.25 && islandH(x, z) < ISLAND_H - 0.12) continue;
            if (HOUSES.some((h) => Math.abs(h.x - x) < h.w * 0.7 && Math.abs(h.z - z) < h.d * 0.7)) continue;
            const h = 0.16 + Math.random() * 0.26;
            q.setFromAxisAngle(Y, Math.random() * TAU);
            m.compose(p.set(x, groundH(x, z), z), q, s.set(h * 1.1, h, h * 1.1));
            grass.setMatrixAt(n, m);
            const r = Math.random();
            if (r < 0.04) c.setRGB(2.2, 2.0, 0.6);
            else if (r < 0.06) c.setRGB(2.2, 2.2, 2.2);
            else c.setRGB(0.85 + Math.random() * 0.3, 0.9 + Math.random() * 0.2, 0.8);
            grass.setColorAt(n, c);
            n++;
          }
          grass.count = n;
          grass.instanceMatrix.needsUpdate = true;
        }
        grass.frustumCulled = false;
        scene.add(grass);


        // ---- scenery: mown base, bushes, rocks, flowers, reeds, fences, cars, power station details ----
        {
          const mowTex = canvasTex(512, 512, (g, w, h) => {
            for (let i = 0; i < 16; i++) {
              g.fillStyle = i % 2 ? "#7cb052" : "#6ea347";
              g.fillRect((i * w) / 16, 0, w / 16 + 1, h);
            }
            for (let i = 0; i < 5000; i++) {
              g.fillStyle = Math.random() < 0.5 ? "rgba(50,90,35,0.22)" : "rgba(160,200,110,0.18)";
              g.fillRect(Math.random() * w, Math.random() * h, 1.5, 2.5);
            }
          });
          const mown = new THREE.Mesh(new THREE.PlaneGeometry(64, 64), flatMat(mowTex));
          mown.rotation.x = -Math.PI / 2;
          mown.position.set(BASE.x, decalY(BASE.x, BASE.z, 0.05), BASE.z);
          mown.receiveShadow = true;
          scene.add(mown);
          const m4 = new THREE.Matrix4(),
            q = new THREE.Quaternion(),
            sc = new THREE.Vector3(),
            p = new THREE.Vector3(),
            c = new THREE.Color(),
            Y = new THREE.Vector3(0, 1, 0);
          const nearHouse = (x, z, pad) => HOUSES.some((h) => Math.abs(h.x - x) < h.w / 2 + pad && Math.abs(h.z - z) < h.d / 2 + pad);
          const nearZone = (x, z, pad) => ZONES.some((zz) => Math.hypot(zz.x - x, zz.z - z) < pad) || Math.hypot(x - BASE.x, z - BASE.z) < 36;
          const scatter = (geo, mat, n, place, shadow, tint, solid) => {
            const im = new THREE.InstancedMesh(geo, mat, n);
            let k = 0;
            for (let i = 0; i < n * 40 && k < n; i++) {
              const r = place();
              if (!r) continue;
              q.setFromAxisAngle(Y, Math.random() * TAU);
              m4.compose(p.set(r.x, r.y || 0, r.z), q, sc.set(r.s * (0.8 + Math.random() * 0.5), r.s * (r.sy || 1), r.s * (0.8 + Math.random() * 0.5)));
              im.setMatrixAt(k, m4);
              if (solid) addCyl(r.x, r.z, Math.max(sc.x, sc.z) * solid[1], r.y || 0, (r.y || 0) + sc.y * solid[2], solid[0]);
              if (tint) im.setColorAt(k, tint(c));
              else {
                const v = 0.75 + Math.random() * 0.45;
                im.setColorAt(k, c.setRGB(v, v, v));
              }
              k++;
            }
            im.count = k;
            im.instanceMatrix.needsUpdate = true;
            im.frustumCulled = false;
            im.castShadow = shadow;
            im.receiveShadow = true;
            scene.add(im);
          };
          const bushGeo = mergeColored([
            { g: at(new THREE.IcosahedronGeometry(0.5, 1), 0, 0.3, 0, 1, 0.65, 1), color: 0x3f6d2e },
            { g: at(new THREE.IcosahedronGeometry(0.35, 1), 0.35, 0.25, 0.1, 1, 0.7, 1), color: 0x4b7a33 },
            { g: at(new THREE.IcosahedronGeometry(0.3, 1), -0.3, 0.22, -0.15, 1, 0.7, 1), color: 0x436f2c },
          ]);
          const vegMat = new THREE.MeshStandardMaterial({ vertexColors: true, roughness: 0.9, flatShading: true, envMapIntensity: 0.4 });
          addSway(vegMat, 0.08);
          scatter(bushGeo, vegMat, 700, () => {
            const x = (Math.random() - 0.5) * 2 * (MAP_HALF + 40),
              z = (Math.random() - 0.5) * 2 * (MAP_HALF + 40);
            if (nearZone(x, z, 26) || landBlocked(x, z, 1.5) || inLake(x, z) || Math.hypot(x - LAKE.x, z - LAKE.z) < LAKE.r * 1.12 || nearLane(x, z, 6)) return null;
            // more bushes along forest edges
            const edge = FORESTS.some((f) => Math.abs(Math.hypot(x - f.x, z - f.z) - f.r) < 12);
            if (!edge && Math.random() < 0.6) return null;
            return { x, z, y: 0, s: 0.8 + Math.random() * 1.4 };
          }, true, null, ["bush", 0.62, 0.62]);
          const rockGeo = new THREE.DodecahedronGeometry(1, 0);
          const rockMat = new THREE.MeshStandardMaterial({ color: C(0x8b8a84), roughness: 0.85, flatShading: true });
          scatter(rockGeo, rockMat, 220, () => {
            const x = (Math.random() - 0.5) * 2 * MAP_HALF,
              z = (Math.random() - 0.5) * 2 * MAP_HALF;
            if (nearZone(x, z, 20) || landBlocked(x, z, 1) || inLake(x, z)) return null;
            return { x, z, y: groundH(x, z), s: 0.2 + Math.random() * 0.6, sy: 0.55 };
          }, true, null, ["rock", 0.9, 0.55]);
          // wild flowers: the meadow is full of them, a few elsewhere
          const flowerGeo = mergeColored([
            { g: at(new THREE.CylinderGeometry(0.01, 0.01, 0.3, 4), 0, 0.15, 0), color: 0x4c7a30 },
            { g: at(new THREE.IcosahedronGeometry(0.05, 0), 0, 0.31, 0), color: 0xffffff },
          ]);
          const flowerMat = new THREE.MeshLambertMaterial({ vertexColors: true });
          addSway(flowerMat, 0.4);
          const FCOL = [[2.2, 2.0, 0.5], [2.2, 2.2, 2.2], [2.0, 0.7, 1.4], [1.0, 1.1, 2.2], [2.2, 1.0, 0.4]];
          const mz = zoneOf("meadow");
          scatter(flowerGeo, flowerMat, 5000, () => {
            const inMeadow = Math.random() < 0.7;
            const a = Math.random() * TAU,
              r = inMeadow ? 4 + Math.sqrt(Math.random()) * 70 : Math.random() * MAP_HALF;
            const x = (inMeadow ? mz.x : 0) + Math.cos(a) * r,
              z = (inMeadow ? mz.z : 0) + Math.sin(a) * r;
            if (inLake(x, z) || landBlocked(x, z, 0.3) || Math.hypot(x - mz.x, z - mz.z) < 3 || Math.hypot(x - BASE.x, z - BASE.z) < 36 || nearLane(x, z, 2.5)) return null;
            return { x, z, y: groundH(x, z), s: 0.8 + Math.random() * 0.8 };
          }, false, (cc) => {
            const f = FCOL[Math.floor(Math.random() * FCOL.length)];
            return cc.setRGB(f[0], f[1], f[2]);
          });
          const reedGeo = mergeColored([
            { g: at(new THREE.ConeGeometry(0.04, 1.4, 4), 0, 0.7, 0), color: 0x7d8f45 },
            { g: at(new THREE.ConeGeometry(0.04, 1.2, 4), 0.12, 0.6, 0.05), color: 0x8c9a4c },
            { g: at(new THREE.ConeGeometry(0.04, 1.0, 4), -0.1, 0.5, -0.06), color: 0x6f8240 },
            { g: at(new THREE.CylinderGeometry(0.035, 0.035, 0.18, 6), 0, 1.35, 0), color: 0x5a3b22 },
          ]);
          const reedMat = new THREE.MeshStandardMaterial({ vertexColors: true, roughness: 0.9 });
          addSway(reedMat, 0.12);
          scatter(reedGeo, reedMat, 520, () => {
            const a = Math.random() * TAU;
            // some reeds grow in the shallows round the island (not at the jetty)
            if (Math.random() < 0.22) {
              if (Math.abs(wrapPi(a - JETTY_A)) < 0.35) return null;
              const ri = islandR(a) + 0.3 + Math.random() * 1.6;
              return { x: LAKE.x + Math.cos(a) * ri, z: LAKE.z + Math.sin(a) * ri, y: 0, s: 0.6 + Math.random() * 0.5 };
            }
            const r = lakeR(a) * (0.94 + Math.random() * 0.1);
            return { x: LAKE.x + Math.cos(a) * r, z: LAKE.z + Math.sin(a) * r, y: 0, s: 0.7 + Math.random() * 0.6 };
          }, false);
          // wooden fences: farm paddock and village gardens
          const fenceParts = [];
          const fence = (pts, closed) => {
            const L = closed ? pts.concat([pts[0]]) : pts;
            for (let i = 1; i < L.length; i++) {
              const a = L[i - 1],
                b = L[i];
              const len = Math.hypot(b[0] - a[0], b[1] - a[1]);
              const n = Math.max(1, Math.round(len / 3));
              addSeg(a[0], 0.6, a[1], b[0], 0.6, b[1], 0.1, "fence", 0.62);
              for (let k = 0; k <= n; k++) {
                const x = a[0] + ((b[0] - a[0]) * k) / n,
                  z = a[1] + ((b[1] - a[1]) * k) / n;
                fenceParts.push({ g: at(new THREE.BoxGeometry(0.12, 1.2, 0.12), x, 0.6, z), color: 0x7a5a3c });
              }
              for (const y of [0.45, 0.95]) {
                const rail = new THREE.BoxGeometry(len, 0.07, 0.05);
                rail.rotateY(-Math.atan2(b[1] - a[1], b[0] - a[0]));
                fenceParts.push({ g: at(rail, (a[0] + b[0]) / 2, y, (a[1] + b[1]) / 2), color: 0x8b6a48 });
              }
            }
          };
          fence([[-235, -40], [-200, -40], [-200, -5], [-235, -5]], true);
          fence([[-150, -110], [-150, -60]], false);
          fence([[160, -12], [196, -12], [196, -36]], false);
          fence([[222, -8], [252, -8], [252, -40]], false);
          fence([[-62, -136], [-18, -136], [-18, -88], [-62, -88]], true);
          const fm = new THREE.Mesh(mergeColored(fenceParts), new THREE.MeshStandardMaterial({ vertexColors: true, roughness: 0.85 }));
          fm.castShadow = fm.receiveShadow = true;
          scene.add(fm);
          // parked cars in the village and at the farm
          [[0x2f6fb3, 186, -46, 0.3], [0xe8e8e8, 226, -74, 1.7], [0x8e2b2b, 214, -112, -0.4], [0x3c8d5a, -196, -98, 1.2]].forEach(([col, x, z, r]) => {
            const car = buildCar(col);
            car.position.set(x, 0, z);
            car.rotation.y = r;
            addBox(x, z, 4.4, 1.95, r, 0, 1.5, "car");
            scene.add(car);
          });
          // ---- farm, camp and village details (all solid) ----
          const wood = new THREE.MeshStandardMaterial({ color: C(0x7a5a3c), roughness: 0.9 });
          const strawTex = canvasTex(128, 128, (g, w) => {
            g.fillStyle = "#cdb064";
            g.fillRect(0, 0, w, w);
            for (let i = 0; i < 1800; i++) {
              const v = 140 + Math.random() * 100;
              g.strokeStyle = "rgba(" + v + "," + v * 0.86 + "," + v * 0.45 + ",0.6)";
              const x = Math.random() * w,
                y = Math.random() * w;
              g.beginPath();
              g.moveTo(x, y);
              g.lineTo(x + (Math.random() - 0.5) * 16, y + (Math.random() - 0.5) * 4);
              g.stroke();
            }
          });
          const straw = new THREE.MeshStandardMaterial({ map: strawTex, roughness: 0.95 });
          // round hay bales by the barn: a row of four, one stacked on top
          [[-157, -82, 0], [-157, -80.4, 0], [-157, -78.8, 0], [-157, -77.2, 0], [-157, -80.4 + 0.8, 1]].forEach(([x, z, up], i) => {
            const b = new THREE.Mesh(new THREE.CylinderGeometry(0.76, 0.76, 1.25, 24), straw);
            b.rotation.set(0, 0.05 * i, Math.PI / 2);
            b.position.set(x, up ? 2.05 : 0.76, z);
            castAll(b);
            scene.add(b);
          });
          addBox(-157, -79.6, 1.4, 6.4, 0, 0, 2.85, "hay bales");
          // a tractor parked by the farmhouse
          {
            const tr = new THREE.Group();
            const paint = new THREE.MeshPhysicalMaterial({ color: C(0x2e7d32), roughness: 0.4, clearcoat: 0.6 });
            const tyre = new THREE.MeshStandardMaterial({ color: C(0x1a1a1a), roughness: 0.9 });
            const rim = new THREE.MeshStandardMaterial({ color: C(0xe8c33a), roughness: 0.5, metalness: 0.3 });
            const glassM = new THREE.MeshStandardMaterial({ color: C(0x1b2633), roughness: 0.05, metalness: 0.6, transparent: true, opacity: 0.75 });
            const box = (w, h, d, x, y, z, m) => {
              const o = new THREE.Mesh(new THREE.BoxGeometry(w, h, d), m);
              o.position.set(x, y, z);
              tr.add(o);
              return o;
            };
            box(2.2, 0.9, 1.0, 0.5, 1.1, 0, paint); // engine hood
            box(1.3, 0.25, 1.5, -0.6, 0.85, 0, paint); // chassis under the cab
            box(1.2, 1.3, 1.3, -0.6, 1.95, 0, glassM); // cab glass
            box(1.36, 0.1, 1.46, -0.6, 2.65, 0, paint); // roof
            for (const [x, z] of [[-0.6, 0.62], [-0.6, -0.62], [0.0, 0.62], [0.0, -0.62]]) box(0.06, 1.3, 0.06, x + (x < -0.5 ? -0.6 : 0) + 0.0, 1.95, z, paint);
            const exh = new THREE.Mesh(new THREE.CylinderGeometry(0.05, 0.05, 1.0, 8), new THREE.MeshStandardMaterial({ color: C(0x333333), metalness: 0.6 }));
            exh.position.set(1.1, 1.9, 0.3);
            tr.add(exh);
            for (const [x, r, w] of [[-0.75, 0.78, 0.42], [1.2, 0.46, 0.3]])
              for (const s of [-1, 1]) {
                const wh = new THREE.Mesh(new THREE.CylinderGeometry(r, r, w, 24), tyre);
                wh.rotation.x = Math.PI / 2;
                wh.position.set(x, r, s * (0.62 + w / 2));
                const hub = new THREE.Mesh(new THREE.CylinderGeometry(r * 0.55, r * 0.55, w + 0.02, 16), rim);
                hub.rotation.x = Math.PI / 2;
                hub.position.copy(wh.position);
                tr.add(wh, hub);
              }
            tr.position.set(-196, 0, -94);
            tr.rotation.y = 1.2;
            castAll(tr);
            scene.add(tr);
            addBox(-196, -94, 3.6, 2.4, 1.2, 0, 2.75, "tractor");
          }
          // camp: a campfire with a stone ring and logs, a stack of supply crates and a rescue flag
          {
            const stone = new THREE.MeshStandardMaterial({ color: C(0x8a877f), roughness: 0.95, flatShading: true });
            for (let i = 0; i < 9; i++) {
              const a = (i / 9) * TAU;
              const s = new THREE.Mesh(new THREE.DodecahedronGeometry(0.18, 0), stone);
              s.position.set(-108 + Math.cos(a) * 0.75, 0.12, -270 + Math.sin(a) * 0.75);
              s.rotation.set(a, a * 2, 0);
              scene.add(s);
            }
            for (let i = 0; i < 3; i++) {
              const lg = new THREE.Mesh(new THREE.CylinderGeometry(0.07, 0.08, 1.0, 8), wood);
              lg.rotation.set(0.35, (i / 3) * TAU, Math.PI / 2);
              lg.position.set(-108, 0.2, -270);
              scene.add(lg);
            }
            const ember = new THREE.Mesh(new THREE.ConeGeometry(0.3, 0.5, 10), new THREE.MeshBasicMaterial({ color: 0xff8a2a, transparent: true, opacity: 0.85 }));
            ember.position.set(-108, 0.35, -270);
            scene.add(ember);
            for (const [x, z, r] of [[-110.6, -270.5, 0.2], [-105.6, -269, -0.3]]) {
              const seat = new THREE.Mesh(new THREE.CylinderGeometry(0.2, 0.22, 1.6, 10), wood);
              seat.rotation.set(0, r, Math.PI / 2);
              seat.position.set(x, 0.2, z);
              castAll(seat);
              scene.add(seat);
            }
            addCyl(-108, -270, 1.1, 0, 0.6, "campfire");
            const crateM = new THREE.MeshStandardMaterial({ color: C(0x6b8e4e), roughness: 0.85 });
            const bandM = new THREE.MeshStandardMaterial({ color: C(0xff6a1a), roughness: 0.6 });
            [[-135.5, 0.4, -268.3, 0], [-134.6, 0.4, -267.6, 0.4], [-135.1, 1.2, -268, 0.2]].forEach(([x, y, z, r]) => {
              const cr = new THREE.Group();
              cr.add(new THREE.Mesh(new THREE.BoxGeometry(0.85, 0.8, 0.85), crateM));
              const band = new THREE.Mesh(new THREE.BoxGeometry(0.87, 0.14, 0.87), bandM);
              cr.add(band);
              cr.position.set(x, y, z);
              cr.rotation.y = r;
              castAll(cr);
              scene.add(cr);
            });
            addBox(-135.1, -268, 2.0, 1.6, 0.2, 0, 1.65, "crates");
            const fp = new THREE.Mesh(new THREE.CylinderGeometry(0.04, 0.05, 5, 8), new THREE.MeshStandardMaterial({ color: C(0xd8dde3), metalness: 0.6, roughness: 0.35 }));
            fp.position.set(-112, 2.5, -248);
            const cf = new THREE.Mesh(new THREE.PlaneGeometry(1.2, 0.8), new THREE.MeshStandardMaterial({ map: crossTex(), side: THREE.DoubleSide, roughness: 0.7 }));
            cf.position.set(-111.4, 4.5, -248);
            castAll(fp);
            scene.add(fp, cf);
            addCyl(-112, -248, 0.1, 0, 5, "flagpole");
          }
          // village square: street lamps and benches round the edge, a letterbox at the end of each footpath
          {
            const lampM = new THREE.MeshStandardMaterial({ color: C(0x2f343b), roughness: 0.45, metalness: 0.6 });
            const lightM = new THREE.MeshStandardMaterial({ color: C(0xfff3d0), emissive: C(0xffd98a), emissiveIntensity: 0.4 });
            const benchM = new THREE.MeshStandardMaterial({ color: C(0x8a6440), roughness: 0.85 });
            let placed = 0;
            const blocked = (x, z) => onTrack(x, z, 1.2) || PATHS.some((p) => Math.hypot(p.b.x - x, p.b.z - z) < 3) || HOUSES.some((h) => houseTop(h, x, z, 1.5) >= 0);
            for (let i = 0; i < 5; i++) {
              // five lamps evenly round the square, nudged aside where a path or the track comes in
              let a = (i / 5) * TAU + 0.35,
                x,
                z,
                tries = 0;
              do {
                x = SQUARE.x + Math.cos(a) * 12.2;
                z = SQUARE.z + Math.sin(a) * 12.2;
                a += 0.08;
              } while (blocked(x, z) && ++tries < 12);
              if (blocked(x, z)) continue;
              placed++;
              const pole = new THREE.Mesh(new THREE.CylinderGeometry(0.06, 0.09, 4.4, 10), lampM);
              pole.position.set(x, 2.2, z);
              const head = new THREE.Mesh(new THREE.CylinderGeometry(0.16, 0.26, 0.4, 6), lampM);
              head.position.set(x, 4.55, z);
              const glass = new THREE.Mesh(new THREE.CylinderGeometry(0.15, 0.2, 0.25, 6), lightM);
              glass.position.set(x, 4.3, z);
              castAll(pole);
              scene.add(pole, head, glass);
              addCyl(x, z, 0.28, 0, 4.8, "street lamp");
              // a bench beside every other lamp, facing the centre of the square
              if (placed % 2) {
                const bx = SQUARE.x + Math.cos(a + 0.16) * 11.2,
                  bz = SQUARE.z + Math.sin(a + 0.16) * 11.2;
                const bench = new THREE.Group();
                const seat = new THREE.Mesh(new THREE.BoxGeometry(1.7, 0.08, 0.45), benchM);
                seat.position.y = 0.45;
                const back = new THREE.Mesh(new THREE.BoxGeometry(1.7, 0.4, 0.06), benchM);
                back.position.set(0, 0.75, -0.22);
                bench.add(seat, back);
                for (const s of [-0.75, 0.75]) {
                  const leg = new THREE.Mesh(new THREE.BoxGeometry(0.08, 0.45, 0.42), lampM);
                  leg.position.set(s, 0.22, 0);
                  bench.add(leg);
                }
                bench.position.set(bx, 0, bz);
                bench.rotation.y = Math.atan2(SQUARE.x - bx, SQUARE.z - bz);
                castAll(bench);
                scene.add(bench);
                addBox(bx, bz, 1.8, 0.6, bench.rotation.y, 0, 0.95, "bench");
              }
            }
            PATHS.forEach((pth) => {
              if (!pth.toSquare && pth.h.kind !== "house") return;
              const ex = pth.b.x - pth.a.x,
                ez = pth.b.z - pth.a.z,
                L = Math.hypot(ex, ez);
              const x = pth.b.x - (ex / L) * 0.8 + (ez / L) * 1.3,
                z = pth.b.z - (ez / L) * 0.8 - (ex / L) * 1.3;
              const post = new THREE.Mesh(new THREE.BoxGeometry(0.08, 1.05, 0.08), wood);
              post.position.set(x, 0.52, z);
              const box = new THREE.Mesh(new THREE.BoxGeometry(0.28, 0.24, 0.42), new THREE.MeshStandardMaterial({ color: C(pth.h.kind === "clinic" ? 0xd62f2f : 0x3d5a80), roughness: 0.6 }));
              box.position.set(x, 1.15, z);
              box.rotation.y = Math.atan2(ex, ez);
              castAll(post);
              castAll(box);
              scene.add(post, box);
              addCyl(x, z, 0.25, 0, 1.3, "letterbox");
            });
          }
          // power station equipment
          const grey = new THREE.MeshStandardMaterial({ color: C(0x8e969f), roughness: 0.5, metalness: 0.5 });
          const st = new THREE.Group();
          for (let i = 0; i < 3; i++) {
            const tr = new THREE.Mesh(new THREE.BoxGeometry(3, 3.2, 2.4), grey);
            tr.position.set(-6 + i * 6, 1.6, 12);
            const ins = new THREE.Mesh(new THREE.CylinderGeometry(0.18, 0.25, 1.2, 8), new THREE.MeshStandardMaterial({ color: C(0x6b4a3a), roughness: 0.4 }));
            ins.position.set(-6 + i * 6, 3.8, 12);
            st.add(tr, ins);
          }
          st.position.set(-40, 0, -112);
          st.rotation.y = 0.2;
          for (let i = 0; i < 3; i++) {
            const lx = -6 + i * 6,
              lz = 12;
            addBox(-40 + lx * Math.cos(0.2) + lz * Math.sin(0.2), -112 - lx * Math.sin(0.2) + lz * Math.cos(0.2), 3.2, 2.6, 0.2, 0, 4.5, "equipment");
          }
          castAll(st);
          scene.add(st);
        }

        // ---- clouds that drift with the wind ----
        // ---- clouds that drift with the upper wind ----
        const cloudTex = canvasTex(256, 256, (g, w) => {
          for (let i = 0; i < 34; i++) {
            const x = w * (0.2 + Math.random() * 0.6),
              y = w * (0.35 + Math.random() * 0.35),
              r = w * (0.1 + Math.random() * 0.16);
            const gr = g.createRadialGradient(x, y, 1, x, y, r);
            gr.addColorStop(0, "rgba(255,255,255,0.75)");
            gr.addColorStop(0.6, "rgba(255,255,255,0.35)");
            gr.addColorStop(1, "rgba(255,255,255,0)");
            g.fillStyle = gr;
            g.beginPath();
            g.arc(x, y, r, 0, TAU);
            g.fill();
          }
          // light from above, shade underneath
          g.globalCompositeOperation = "source-atop";
          const sh = g.createLinearGradient(0, w * 0.25, 0, w * 0.85);
          sh.addColorStop(0, "rgba(255,255,255,0)");
          sh.addColorStop(1, "rgba(120,135,160,0.55)");
          g.fillStyle = sh;
          g.fillRect(0, 0, w, w);
        });
        const cloudMat = new THREE.SpriteMaterial({ map: cloudTex, depthWrite: false, fog: false, transparent: true, opacity: 0.92 });
        const CLOUDS = [];
        for (let i = 0; i < 30; i++) {
          const grp = new THREE.Group();
          const n = 4 + Math.floor(rnd() * 4);
          for (let j = 0; j < n; j++) {
            const s = new THREE.Sprite(cloudMat);
            const sc = 70 + rnd() * 90;
            s.scale.set(sc * 1.7, sc, 1);
            s.position.set((rnd() - 0.5) * 160, rnd() * 25, (rnd() - 0.5) * 80);
            grp.add(s);
          }
          grp.position.set((rnd() - 0.5) * 4400, 260 + rnd() * 180, (rnd() - 0.5) * 4400);
          scene.add(grp);
          CLOUDS.push(grp);
        }

        // ---- people ----
        function person(o) {
          const g = new THREE.Group();
          const M = (c) => new THREE.MeshStandardMaterial({ color: C(c), roughness: 0.8 });
          const skin = M(o.skin || 0xd9a77e),
            shirt = M(o.shirt),
            pants = M(o.pants || 0x2b3a55),
            shoe = M(0x222222);
          const limb = (r1, r2, len, mat) => {
            const gg = new THREE.CylinderGeometry(r1, r2, len, 10);
            gg.translate(0, -len / 2, 0);
            return new THREE.Mesh(gg, mat);
          };
          for (const sx of [-0.1, 0.1]) {
            const leg = limb(0.075, 0.06, 0.86, pants);
            leg.position.set(sx, 0.92, 0);
            const foot = new THREE.Mesh(new THREE.BoxGeometry(0.11, 0.07, 0.24), shoe);
            foot.position.set(sx, 0.035, -0.04);
            g.add(leg, foot);
          }
          const hips = new THREE.Mesh(new THREE.BoxGeometry(0.34, 0.14, 0.2), pants);
          hips.position.y = 0.95;
          const torso = new THREE.Mesh(new THREE.BoxGeometry(0.4, 0.56, 0.22), shirt);
          torso.position.y = 1.3;
          const neck = new THREE.Mesh(new THREE.CylinderGeometry(0.05, 0.055, 0.08, 8), skin);
          neck.position.y = 1.62;
          const head = new THREE.Mesh(new THREE.SphereGeometry(0.11, 16, 12), skin);
          head.position.y = 1.75;
          g.add(hips, torso, neck, head);
          if (o.cap) {
            const capM = M(o.cap);
            const cap = new THREE.Mesh(new THREE.SphereGeometry(0.115, 14, 8, 0, TAU, 0, Math.PI / 2), capM);
            cap.position.y = 1.78;
            const brim = new THREE.Mesh(new THREE.BoxGeometry(0.16, 0.015, 0.12), capM);
            brim.position.set(0, 1.79, -0.13);
            g.add(cap, brim);
          } else {
            const hair = new THREE.Mesh(new THREE.SphereGeometry(0.115, 14, 8, 0, TAU, 0, Math.PI / 2), M(o.hair || 0x3a2a1e));
            hair.position.y = 1.77;
            g.add(hair);
          }
          for (const sx of [-1, 1]) {
            const upper = limb(0.05, 0.045, 0.3, shirt);
            upper.position.set(sx * 0.21, 1.55, 0);
            const fore = limb(0.042, 0.038, 0.3, skin);
            if (o.tx) {
              upper.rotation.x = 0.35;
              upper.rotation.z = sx * 0.12;
              fore.position.set(sx * 0.2, 1.27, -0.1);
              fore.rotation.x = 1.25;
              fore.rotation.z = -sx * 0.35;
            } else {
              upper.rotation.z = sx * 0.1;
              fore.position.set(sx * 0.24, 1.26, 0.0);
              fore.rotation.x = 0.15;
              fore.rotation.z = sx * 0.06;
            }
            g.add(upper, fore);
          }
          if (o.tx) {
            const txM = M(0x2a2f38);
            const tx = new THREE.Mesh(new THREE.BoxGeometry(0.22, 0.14, 0.06), txM);
            tx.position.set(0, 1.2, -0.38);
            tx.rotation.x = -0.6;
            const ant = new THREE.Mesh(new THREE.CylinderGeometry(0.008, 0.008, 0.18, 6), txM);
            ant.position.set(0.08, 1.33, -0.39);
            ant.rotation.x = -0.3;
            g.add(tx, ant);
          }
          castAll(g);
          return g;
        }
        const operator = person({ shirt: 0xff6a1a, cap: 0x26364f, tx: true });
        operator.position.set(OPER.x, 0, OPER.z);
        addCyl(OPER.x, OPER.z, 0.35, 0, 1.85, "person");
        operator.rotation.y = Math.PI * 0.85;
        scene.add(operator);
        [
          [{ shirt: 0xff6a1a, pants: 0x34495e, hair: 0x2a1d14 }, -11, 12, 2.6],
          [{ shirt: 0x2f6fb3, cap: 0xffffff, skin: 0x8d5a3b }, 9, 14, -2.4],
          [{ shirt: 0xe8e8e8, pants: 0x2b3a55, hair: 0x6b4423 }, 196, -40, 2.9],
          [{ shirt: 0x3c8d5a, pants: 0x4a4a4a, skin: 0x8d5a3b }, 214, -42, -2.6],
          [{ shirt: 0xd9a03f, cap: 0x26364f }, -176, -48, 1.2],
          [{ shirt: 0xe07b2a, pants: 0x34495e, hair: 0xc9a46b }, -112, -255, 0.4],
          [{ shirt: 0x9b59b6, pants: 0x2b3a55, skin: 0x8d5a3b }, -127, -268, -0.6],
        ].forEach(([o, x, z, r]) => {
          const p = person(o);
          p.position.set(x, 0, z);
          addCyl(x, z, 0.35, 0, 1.85, "person");
          p.rotation.y = r;
          scene.add(p);
        });

        // ---- the rescue base: helipad, canopy, van, crates ----
        {
          const padTex = canvasTex(512, 512, (g, w) => {
            g.fillStyle = "#3c4048";
            g.fillRect(0, 0, w, w);
            for (let i = 0; i < 9000; i++) {
              const v = 50 + Math.random() * 40;
              g.fillStyle = "rgba(" + v + "," + v + "," + (v + 4) + ",0.5)";
              g.fillRect(Math.random() * w, Math.random() * w, 2, 2);
            }
            g.strokeStyle = "#f5f5f0";
            g.lineWidth = 18;
            g.beginPath();
            g.arc(w / 2, w / 2, w * 0.4, 0, TAU);
            g.stroke();
            g.fillStyle = "#ffcc33";
            g.font = "900 230px Arial";
            g.textAlign = "center";
            g.textBaseline = "middle";
            g.fillText("H", w / 2, w / 2 + 10);
          });
          const pad = new THREE.Mesh(new THREE.PlaneGeometry(9, 9), flatMat(padTex, { roughness: 0.85 }));
          pad.rotation.x = -Math.PI / 2;
          pad.position.set(BASE.x, decalY(BASE.x, BASE.z, 0.6), BASE.z);
          pad.receiveShadow = true;
          scene.add(pad);
          const metal = new THREE.MeshStandardMaterial({ color: C(0xcfd4da), metalness: 0.7, roughness: 0.35 });
          const canopy = new THREE.Group();
          for (const [px, pz] of [[-2, -1.6], [2, -1.6], [-2, 1.6], [2, 1.6]]) {
            const p = new THREE.Mesh(new THREE.CylinderGeometry(0.04, 0.04, 2.4, 8), metal);
            p.position.set(px, 1.2, pz);
            canopy.add(p);
          }
          const roof = new THREE.Mesh(new THREE.BoxGeometry(4.6, 0.12, 3.8), new THREE.MeshStandardMaterial({ color: C(0xff6a1a), roughness: 0.7 }));
          roof.position.y = 2.45;
          const table = new THREE.Mesh(new THREE.BoxGeometry(2.2, 0.06, 0.9), new THREE.MeshStandardMaterial({ color: C(0xe8e2d5) }));
          table.position.set(0, 0.78, -0.4);
          const laptop = new THREE.Mesh(new THREE.BoxGeometry(0.4, 0.02, 0.28), new THREE.MeshStandardMaterial({ color: C(0x222831) }));
          laptop.position.set(0.3, 0.82, -0.4);
          const screen = new THREE.Mesh(new THREE.PlaneGeometry(0.4, 0.26), new THREE.MeshStandardMaterial({ color: C(0x7cc4ff), emissive: C(0x2a6fb0), emissiveIntensity: 0.6 }));
          screen.position.set(0.3, 0.95, -0.55);
          screen.rotation.x = -0.25;
          canopy.add(roof, table, laptop, screen);
          for (let i = 0; i < 4; i++) {
            const crate = new THREE.Mesh(new THREE.BoxGeometry(0.6, 0.45, 0.45), new THREE.MeshStandardMaterial({ color: C([0xc49a62, 0xf4f4f2, 0xf08a24, 0xc49a62][i]), roughness: 0.8 }));
            crate.position.set(-1.4 + i * 0.7, 0.23, 1.2);
            canopy.add(crate);
          }
          canopy.position.set(-9, 0, 6);
          canopy.rotation.y = 0.5;
          castAll(canopy);
          scene.add(canopy);
          const van = buildCar(0xf2f2f2);
          van.position.set(12, 0, 4);
          van.rotation.y = 1.9;
          addBox(12, 4, 4.4, 1.95, 1.9, 0, 1.5, "car");
          addBox(-9, 6, 4.8, 4.0, 0.5, 0, 2.6, "canopy");
          scene.add(van);
        }

        // ---- buildings ----
        const roofMats = { house: 0x9c4a3a, clinic: 0x6e7a86, barn: 0x5a5f66, station: 0x7a838c, tent: null };
        function crossTex() {
          return canvasTex(128, 128, (g, w) => {
            g.fillStyle = "#ffffff";
            g.fillRect(0, 0, w, w);
            g.fillStyle = "#d62f2f";
            g.fillRect(w * 0.38, w * 0.12, w * 0.24, w * 0.76);
            g.fillRect(w * 0.12, w * 0.38, w * 0.76, w * 0.24);
          });
        }
        // building surfaces (canvas textures, tinted by each material's colour)
        const texRep = (t, rx, ry) => ((t.wrapS = t.wrapT = THREE.RepeatWrapping), t.repeat.set(rx, ry), t);
        const plasterTex = texRep(
          canvasTex(256, 256, (g, w) => {
            g.fillStyle = "#f4f4f4";
            g.fillRect(0, 0, w, w);
            for (let i = 0; i < 9000; i++) {
              const v = 200 + Math.random() * 55;
              g.fillStyle = "rgba(" + v + "," + v + "," + v + ",0.35)";
              g.fillRect(Math.random() * w, Math.random() * w, 2, 2);
            }
            const gr = g.createLinearGradient(0, w * 0.75, 0, w);
            gr.addColorStop(0, "rgba(120,110,95,0)");
            gr.addColorStop(1, "rgba(120,110,95,0.25)");
            g.fillStyle = gr;
            g.fillRect(0, 0, w, w);
          }),
          1,
          1,
        );
        const tileTex = texRep(
          canvasTex(256, 256, (g, w) => {
            g.fillStyle = "#e8e8e8";
            g.fillRect(0, 0, w, w);
            for (let r = 0; r < 8; r++)
              for (let c = 0; c < 8; c++) {
                const v = 170 + Math.random() * 70;
                g.fillStyle = "rgb(" + v + "," + v + "," + v + ")";
                g.fillRect(c * 32 + (r % 2) * 16 + 1, r * 32 + 1, 30, 28);
                g.fillStyle = "rgba(0,0,0,0.35)";
                g.fillRect(c * 32 + (r % 2) * 16, r * 32 + 28, 32, 4);
              }
          }),
          0.45,
          0.45,
        );
        const metalRoofTex = texRep(
          canvasTex(128, 128, (g, w) => {
            g.fillStyle = "#e6e6e6";
            g.fillRect(0, 0, w, w);
            for (let x = 0; x < w; x += 16) {
              g.fillStyle = "rgba(0,0,0,0.25)";
              g.fillRect(x, 0, 3, w);
              g.fillStyle = "rgba(255,255,255,0.4)";
              g.fillRect(x + 4, 0, 2, w);
            }
          }),
          0.5,
          0.5,
        );
        const metalTex = texRep(
          canvasTex(128, 128, (g, w) => {
            g.fillStyle = "#ececec";
            g.fillRect(0, 0, w, w);
            for (let x = 0; x < w; x += 12) {
              g.fillStyle = "rgba(0,0,0,0.16)";
              g.fillRect(x, 0, 2, w);
            }
          }),
          2,
          1,
        );
        const boardTex = texRep(
          canvasTex(128, 128, (g, w) => {
            g.fillStyle = "#eaeaea";
            g.fillRect(0, 0, w, w);
            for (let x = 0; x < w; x += 10) {
              const v = 200 + Math.random() * 50;
              g.fillStyle = "rgb(" + v + "," + v + "," + v + ")";
              g.fillRect(x, 0, 9, w);
              g.fillStyle = "rgba(0,0,0,0.35)";
              g.fillRect(x + 9, 0, 1, w);
            }
          }),
          3,
          1,
        );
        const brickTex = texRep(
          canvasTex(64, 64, (g, w) => {
            g.fillStyle = "#cfcfcf";
            g.fillRect(0, 0, w, w);
            for (let r = 0; r < 8; r++)
              for (let c = 0; c < 4; c++) {
                const v = 200 + Math.random() * 55;
                g.fillStyle = "rgb(" + v + "," + v * 0.95 + "," + v * 0.9 + ")";
                g.fillRect(c * 16 + (r % 2) * 8 + 1, r * 8 + 1, 14, 6);
              }
          }),
          1,
          2,
        );
        const stoneMat = new THREE.MeshStandardMaterial({ color: C(0x8d8a83), roughness: 0.95 });
        HOUSES.forEach((hs) => {
          const grp = new THREE.Group();
          if (hs.kind === "tent") {
            const shape = new THREE.Shape();
            shape.moveTo(-hs.d / 2, 0);
            shape.lineTo(hs.d / 2, 0);
            shape.lineTo(0, hs.h + hs.roof);
            shape.lineTo(-hs.d / 2, 0);
            const geo = new THREE.ExtrudeGeometry(shape, { depth: hs.w, bevelEnabled: false });
            geo.translate(0, 0, -hs.w / 2);
            geo.rotateY(Math.PI / 2);
            grp.add(new THREE.Mesh(geo, new THREE.MeshStandardMaterial({ color: C(hs.col), roughness: 0.75, side: THREE.DoubleSide })));
            const H = hs.h + hs.roof;
            const dShape = new THREE.Shape();
            dShape.moveTo(-hs.d * 0.24, 0);
            dShape.lineTo(hs.d * 0.24, 0);
            dShape.lineTo(0, H * 0.72);
            dShape.lineTo(-hs.d * 0.24, 0);
            const door = new THREE.Mesh(new THREE.ShapeGeometry(dShape), new THREE.MeshStandardMaterial({ color: C(0x2a2522), roughness: 0.9 }));
            door.rotation.y = Math.PI / 2;
            door.position.x = hs.w / 2 + 0.012;
            const poleM = new THREE.MeshStandardMaterial({ color: C(0xb0b6bd), metalness: 0.6, roughness: 0.4 });
            const ridge = new THREE.Mesh(new THREE.CylinderGeometry(0.025, 0.025, hs.w + 0.4, 8), poleM);
            ridge.rotation.z = Math.PI / 2;
            ridge.position.y = H + 0.02;
            grp.add(door, ridge);
            const ropeM = new THREE.LineBasicMaterial({ color: 0xd9d4c7 });
            for (const sx of [-1, 1]) {
              const up = new THREE.Mesh(new THREE.CylinderGeometry(0.025, 0.025, H, 8), poleM);
              up.position.set(sx * (hs.w / 2 + 0.15), H / 2, 0);
              const peg = V3(sx * (hs.w / 2 + 1.1), 0.02, 0);
              grp.add(up, new THREE.Line(new THREE.BufferGeometry().setFromPoints([V3(sx * (hs.w / 2 + 0.15), H, 0), peg]), ropeM));
              const pg = new THREE.Mesh(new THREE.CylinderGeometry(0.02, 0.02, 0.15, 6), poleM);
              pg.position.copy(peg);
              grp.add(pg);
            }
          } else {
            const ind = hs.kind === "station" || hs.kind === "barn";
            const wallMat = new THREE.MeshStandardMaterial({ color: C(hs.col), map: ind ? (hs.kind === "barn" ? boardTex : metalTex) : plasterTex, roughness: ind ? 0.6 : 0.92, metalness: hs.kind === "station" ? 0.25 : 0 });
            const walls = new THREE.Mesh(new THREE.BoxGeometry(hs.w, hs.h, hs.d), wallMat);
            walls.position.y = hs.h / 2;
            // stone plinth at the foot of the walls
            const plinth = new THREE.Mesh(new THREE.BoxGeometry(hs.w + 0.16, 0.5, hs.d + 0.16), stoneMat);
            plinth.position.y = 0.25;
            // gable roof with eaves overhanging the walls, and a slab under it
            const ov = 0.55;
            const shape = new THREE.Shape();
            shape.moveTo(-hs.d / 2 - ov, -0.12);
            shape.lineTo(hs.d / 2 + ov, -0.12);
            shape.lineTo(hs.d / 2 + ov, 0.05);
            shape.lineTo(0, hs.roof + 0.12);
            shape.lineTo(-hs.d / 2 - ov, 0.05);
            shape.lineTo(-hs.d / 2 - ov, -0.12);
            const rg = new THREE.ExtrudeGeometry(shape, { depth: hs.w + ov * 1.6, bevelEnabled: false });
            rg.translate(0, 0, -(hs.w + ov * 1.6) / 2);
            rg.rotateY(Math.PI / 2);
            const roofCol = roofMats[hs.kind] || roofMats.house;
            const roof = new THREE.Mesh(rg, new THREE.MeshStandardMaterial({ color: C(roofCol), map: ind ? metalRoofTex : tileTex, roughness: ind ? 0.45 : 0.78, metalness: ind ? 0.35 : 0 }));
            roof.position.y = hs.h;
            // gable ends close the triangle above the walls
            const gShape = new THREE.Shape();
            gShape.moveTo(-hs.d / 2, 0);
            gShape.lineTo(hs.d / 2, 0);
            gShape.lineTo(0, hs.roof);
            gShape.lineTo(-hs.d / 2, 0);
            for (const sx of [-1, 1]) {
              const gable = new THREE.Mesh(new THREE.ShapeGeometry(gShape), wallMat);
              gable.rotation.y = (sx * Math.PI) / 2;
              gable.position.set((sx * hs.w) / 2, hs.h, 0);
              grp.add(gable);
            }
            grp.add(walls, plinth, roof);
            // windows (frame, glass, sill) on every side, a door on the front
            const frameMat = new THREE.MeshStandardMaterial({ color: C(ind ? 0x6d747c : 0xf2efe8), roughness: 0.6 });
            const glassMat = new THREE.MeshStandardMaterial({ color: C(0x223447), roughness: 0.08, metalness: 0.6, envMapIntensity: 1.2 });
            const doorMat = new THREE.MeshStandardMaterial({ color: C(hs.kind === "barn" ? 0x6b2a22 : hs.kind === "station" ? 0x59626b : 0x5a3b26), roughness: 0.7 });
            const win = (x, y, z, ry, w, h) => {
              const g = new THREE.Group();
              const fr = new THREE.Mesh(new THREE.BoxGeometry(w + 0.16, h + 0.16, 0.08), frameMat);
              const gl = new THREE.Mesh(new THREE.BoxGeometry(w, h, 0.06), glassMat);
              gl.position.z = 0.02;
              const bar = new THREE.Mesh(new THREE.BoxGeometry(0.05, h, 0.09), frameMat);
              const sill = new THREE.Mesh(new THREE.BoxGeometry(w + 0.3, 0.06, 0.2), stoneMat);
              sill.position.set(0, -h / 2 - 0.1, 0.06);
              g.add(fr, gl, bar, sill);
              g.position.set(x, y, z);
              g.rotation.y = ry;
              grp.add(g);
            };
            const doorW = hs.kind === "barn" ? 3.2 : hs.kind === "station" ? 2.4 : 1.1,
              doorH = hs.kind === "barn" ? 3.4 : hs.kind === "station" ? 3 : 2.1;
            const door = new THREE.Mesh(new THREE.BoxGeometry(doorW, doorH, 0.1), doorMat);
            door.position.set(0, doorH / 2 + 0.02, hs.d / 2 + 0.03);
            const dFrame = new THREE.Mesh(new THREE.BoxGeometry(doorW + 0.24, doorH + 0.14, 0.06), frameMat);
            dFrame.position.set(0, doorH / 2 + 0.05, hs.d / 2 + 0.01);
            grp.add(dFrame, door);
            if (hs.kind === "barn")
              for (const s of [-1, 1]) {
                const x = new THREE.Mesh(new THREE.BoxGeometry(0.14, Math.hypot(doorW, doorH) - 0.2, 0.05), frameMat);
                x.rotation.z = s * Math.atan2(doorW, doorH);
                x.position.set(0, doorH / 2 + 0.02, hs.d / 2 + 0.1);
                grp.add(x);
              }
            const wy = Math.min(hs.h * 0.58, hs.h - 1.0),
              ww = ind ? 1.4 : 1.0,
              wh = ind ? 0.7 : 1.05;
            const nW = Math.max(1, Math.floor((hs.w - 1) / 3.2));
            for (let i = 0; i < nW; i++) {
              const x = -hs.w / 2 + (hs.w / (nW + 1)) * (i + 1);
              if (Math.abs(x) > doorW / 2 + ww / 2 + 0.3) win(x, wy, hs.d / 2 + 0.04, 0, ww, wh);
              win(x, wy, -hs.d / 2 - 0.04, Math.PI, ww, wh);
            }
            const nD = Math.max(1, Math.floor((hs.d - 1) / 3.4));
            for (let i = 0; i < nD; i++) {
              const z = -hs.d / 2 + (hs.d / (nD + 1)) * (i + 1);
              win(hs.w / 2 + 0.04, wy, z, Math.PI / 2, ww, wh);
              win(-hs.w / 2 - 0.04, wy, z, -Math.PI / 2, ww, wh);
            }
            // a chimney on homes
            if (hs.kind === "house") {
              const ch = new THREE.Mesh(new THREE.BoxGeometry(0.6, hs.roof + 1.1, 0.6), new THREE.MeshStandardMaterial({ color: C(0x8c5a46), map: brickTex, roughness: 0.85 }));
              ch.position.set(hs.w * 0.28, hs.h + (hs.roof + 1.1) / 2 - 0.2, -hs.d * 0.18);
              const cap = new THREE.Mesh(new THREE.BoxGeometry(0.78, 0.1, 0.78), stoneMat);
              cap.position.set(hs.w * 0.28, hs.h + hs.roof + 0.92, -hs.d * 0.18);
              grp.add(ch, cap);
            }
            // roof vents on the power station
            if (hs.kind === "station")
              for (let i = -1; i <= 1; i++) {
                const v = new THREE.Mesh(new THREE.CylinderGeometry(0.45, 0.45, 0.7, 12), new THREE.MeshStandardMaterial({ color: C(0x9aa2ab), metalness: 0.6, roughness: 0.4 }));
                v.position.set(i * hs.w * 0.28, hs.h + hs.roof * 0.6 + 0.3, 0);
                grp.add(v);
              }
            if (hs.kind === "clinic") {
              const sign = new THREE.Mesh(new THREE.PlaneGeometry(2.2, 2.2), new THREE.MeshStandardMaterial({ map: crossTex(), roughness: 0.6 }));
              sign.position.set(-hs.w * 0.3, hs.h + 0.5, hs.d / 2 + 0.3);
              const roofSign = new THREE.Mesh(new THREE.PlaneGeometry(3.4, 3.4), new THREE.MeshStandardMaterial({ map: crossTex(), roughness: 0.6 }));
              // lies on the roof slope (the roof rises 0.07 m to the ridge over half the depth plus the eaves)
              const run = hs.d / 2 + 0.55,
                rise = hs.roof + 0.07;
              roofSign.rotation.x = -Math.PI / 2 + Math.atan2(rise, run);
              roofSign.position.set(0, hs.h + 0.05 + rise * (1 - (hs.d * 0.24) / run) + 0.04, hs.d * 0.24);
              grp.add(sign, roofSign);
            }
          }
          grp.position.set(hs.x, 0, hs.z);
          grp.rotation.y = hs.rot;
          castAll(grp);
          scene.add(grp);
        });
        {
          // grain silo at the farm
          const silo = new THREE.Mesh(new THREE.CylinderGeometry(SILO.r, SILO.r, SILO.h - SILO.r * 0.6, 24), new THREE.MeshStandardMaterial({ color: C(0xbfc5cc), metalness: 0.6, roughness: 0.35 }));
          silo.position.set(SILO.x, (SILO.h - SILO.r * 0.6) / 2, SILO.z);
          const dome = new THREE.Mesh(new THREE.SphereGeometry(SILO.r, 24, 12, 0, TAU, 0, Math.PI / 2), silo.material);
          dome.scale.y = 0.6;
          dome.position.set(SILO.x, SILO.h - SILO.r * 0.6, SILO.z);
          castAll(silo);
          castAll(dome);
          scene.add(silo, dome);
        }
        // radio mast with a blinking light and guy wires
        const mastLight = new THREE.Mesh(new THREE.SphereGeometry(0.45, 12, 8), new THREE.MeshBasicMaterial({ color: 0xff3030 }));
        {
          const g = new THREE.Group();
          const red = new THREE.MeshStandardMaterial({ color: C(0xd23b2c), roughness: 0.5, metalness: 0.4 });
          const white = new THREE.MeshStandardMaterial({ color: C(0xf2f2f2), roughness: 0.5, metalness: 0.4 });
          const H = TOWER.h;
          for (let k = 0; k < 6; k++) {
            const seg = new THREE.Mesh(new THREE.CylinderGeometry(0.9 - k * 0.1, 1.0 - k * 0.1, H / 6, 3, 1, true), k % 2 ? white : red);
            seg.material.side = THREE.DoubleSide;
            seg.position.y = (k + 0.5) * (H / 6);
            g.add(seg);
          }
          mastLight.position.y = H + 0.5;
          g.add(mastLight);
          const wireM = new THREE.LineBasicMaterial({ color: 0x9aa3ad });
          for (let k = 0; k < 3; k++) {
            const a = (k / 3) * TAU + 0.3;
            const geo = new THREE.BufferGeometry().setFromPoints([V3(0, H * 0.8, 0), V3(Math.cos(a) * 16, 0, Math.sin(a) * 16)]);
            addSeg(TOWER.x, H * 0.8, TOWER.z, TOWER.x + Math.cos(a) * 16, 0, TOWER.z + Math.sin(a) * 16, 0.05, "wire");
            g.add(new THREE.Line(geo, wireM));
          }
          g.position.set(TOWER.x, 0, TOWER.z);
          castAll(g);
          scene.add(g);
        }

        // flag and windsock at the base (show the wind)
        // flag (shows the wind)
        const FLAG = { x: 10, z: 24 };
        const flagGeo = new THREE.PlaneGeometry(1.6, 1.0, 16, 8);
        flagGeo.translate(0.8, 0, 0);
        const flagBase = flagGeo.attributes.position.array.slice();
        const flagTex = canvasTex(256, 160, (g, w, h) => {
          g.fillStyle = "#1e3a6e";
          g.fillRect(0, 0, w, h);
          g.fillStyle = "#ffffff";
          g.fillRect(0, h * 0.4, w, h * 0.2);
          g.fillStyle = "#5b8cff";
          g.beginPath();
          g.moveTo(0, 0);
          g.lineTo(w * 0.42, h / 2);
          g.lineTo(0, h);
          g.fill();
        });
        const flag = new THREE.Mesh(flagGeo, new THREE.MeshStandardMaterial({ map: flagTex, side: THREE.DoubleSide, roughness: 0.8 }));
        const flagGroup = new THREE.Group();
        flagGroup.position.set(FLAG.x, 5.4, FLAG.z);
        flagGroup.add(flag);
        flag.castShadow = true;
        {
          const pole = new THREE.Mesh(new THREE.CylinderGeometry(0.04, 0.06, 6, 10), new THREE.MeshStandardMaterial({ color: C(0xd8dde3), metalness: 0.7, roughness: 0.3 }));
          pole.position.set(FLAG.x, 3, FLAG.z);
          addCyl(FLAG.x, FLAG.z, 0.1, 0, 6, "flagpole");
          addSeg(FLAG.x, 5.4, FLAG.z, FLAG.x + 1.6, 5.4, FLAG.z, 0.5, "flagpole", 0.5);
          pole.castShadow = true;
          scene.add(pole, flagGroup);
        }
        const sock = new THREE.Group();
        const sockArm = new THREE.Group();
        {
          const pole = new THREE.Mesh(new THREE.CylinderGeometry(0.05, 0.07, 5, 8), new THREE.MeshStandardMaterial({ color: C(0xdddddd), metalness: 0.5, roughness: 0.4 }));
          pole.position.y = 2.5;
          sock.add(pole);
          const stripes = canvasTex(64, 128, (g, w, h) => {
            for (let i = 0; i < 5; i++) {
              g.fillStyle = i % 2 ? "#ffffff" : "#ff5a1f";
              g.fillRect(0, (i * h) / 5, w, h / 5 + 1);
            }
          });
          const cone = new THREE.Mesh(new THREE.CylinderGeometry(0.18, 0.35, 2.2, 16, 1, true), new THREE.MeshStandardMaterial({ map: stripes, side: THREE.DoubleSide, roughness: 0.8 }));
          cone.rotation.z = Math.PI / 2;
          cone.position.x = 1.1;
          sockArm.add(cone);
          sockArm.position.y = 4.9;
          sock.add(sockArm);
          sock.position.set(-14, 0, 19);
          addCyl(-14, 19, 0.1, 0, 5, "flagpole");
          castAll(sock);
          scene.add(sock);
        }
        // birds
        // birds circling over the farmland
        const BIRDS = [];
        {
          const bm = new THREE.MeshLambertMaterial({ color: C(0x2a2a2e), side: THREE.DoubleSide });
          const wingG = new THREE.BufferGeometry();
          wingG.setAttribute("position", new THREE.Float32BufferAttribute([0, 0, -0.12, 0, 0, 0.12, 0.55, 0, 0.05], 3));
          wingG.computeVertexNormals();
          for (let i = 0; i < 9; i++) {
            const b = new THREE.Group();
            const body = new THREE.Mesh(new THREE.ConeGeometry(0.07, 0.45, 6), bm);
            body.rotation.x = -Math.PI / 2;
            const wl = new THREE.Mesh(wingG, bm),
              wr = new THREE.Mesh(wingG, bm);
            wr.scale.x = -1;
            b.add(body, wl, wr);
            b.scale.setScalar(1.6);
            scene.add(b);
            BIRDS.push({ b, wl, wr, r: 45 + rnd() * 50, ph: rnd() * TAU, h: 70 + rnd() * 25, sp: 0.18 + rnd() * 0.06 });
          }
        }

        /* ---------- drop zones: ground markings and flags ---------- */
        const zoneGroup = new THREE.Group();
        scene.add(zoneGroup);
        function ringTex(sel) {
          return canvasTex(512, 512, (g, w) => {
            g.clearRect(0, 0, w, w);
            const c = w / 2;
            const rings = sel ? ["#ffffff", "#ff8a1f", "#ffffff", "#ff8a1f"] : ["rgba(255,255,255,0.75)", "rgba(255,255,255,0)", "rgba(255,255,255,0.4)"];
            rings.forEach((col, i) => {
              g.strokeStyle = col;
              g.lineWidth = sel ? 14 : 9;
              g.beginPath();
              g.arc(c, c, c - 8 - i * (c / rings.length), 0, TAU);
              g.stroke();
            });
            g.strokeStyle = sel ? "#ff8a1f" : "rgba(255,255,255,0.6)";
            g.lineWidth = sel ? 12 : 8;
            g.beginPath();
            g.moveTo(c - 40, c);
            g.lineTo(c + 40, c);
            g.moveTo(c, c - 40);
            g.lineTo(c, c + 40);
            g.stroke();
          });
        }
        const ringTexSel = ringTex(true),
          ringTexDim = ringTex(false);
        const zoneMeshes = {};
        ZONES.forEach((z) => {
          const m = new THREE.Mesh(new THREE.PlaneGeometry(1, 1), new THREE.MeshStandardMaterial({ map: ringTexDim, transparent: true, depthWrite: false, roughness: 0.9, polygonOffset: true, polygonOffsetFactor: -6 }));
          m.rotation.x = -Math.PI / 2;
          m.position.set(z.x, decalY(z.x, z.z, 0.75), z.z);
          m.receiveShadow = true;
          zoneGroup.add(m);
          // flag pole at the zone
          const pole = new THREE.Mesh(new THREE.CylinderGeometry(0.05, 0.06, 4, 8), new THREE.MeshStandardMaterial({ color: C(0xe0e0e0), metalness: 0.5 }));
          const fl = new THREE.Mesh(new THREE.PlaneGeometry(1.1, 0.7), new THREE.MeshStandardMaterial({ color: C(0xff8a1f), side: THREE.DoubleSide }));
          fl.position.set(0.55, 1.6, 0);
          const fg = new THREE.Group();
          fg.add(fl);
          fg.position.y = 0;
          const grp = new THREE.Group();
          pole.position.y = 2;
          grp.add(pole, fg);
          zoneGroup.add(grp);
          zoneMeshes[z.k] = { decal: m, flag: grp, cloth: fg };
        });
        function layoutZones() {
          ZONES.forEach((z) => {
            const zm = zoneMeshes[z.k];
            const sel = PLAN.target === z.k;
            const r = sel ? MISSION.r : 6;
            zm.decal.material.map = sel ? ringTexSel : ringTexDim;
            zm.decal.material.needsUpdate = true;
            zm.decal.scale.set(r * 2.05, r * 2.05, 1);
            zm.decal.position.y = decalY(z.x, z.z, 0.75);
            zm.flag.position.set(z.x + r + 1.2, groundH(z.x + r + 1.2, z.z - 1), z.z - 1);
            zm.cloth.children[0].material.color.copy(C(sel ? 0xff8a1f : 0xd8dde3));
          });
        }

        /* ---------- no-fly zones (per mission) ---------- */
        const nfzGroup = new THREE.Group();
        scene.add(nfzGroup);
        const nfzTex = canvasTex(256, 64, (g, w, h) => {
          g.fillStyle = "rgba(248,113,113,0.0)";
          g.fillRect(0, 0, w, h);
          g.fillStyle = "rgba(248,113,113,0.55)";
          for (let x = -h; x < w; x += 28) {
            g.beginPath();
            g.moveTo(x, h);
            g.lineTo(x + 14, h);
            g.lineTo(x + 14 + h, 0);
            g.lineTo(x + h, 0);
            g.fill();
          }
        });
        nfzTex.wrapS = THREE.RepeatWrapping;
        function buildNFZ() {
          while (nfzGroup.children.length) nfzGroup.remove(nfzGroup.children[0]);
          MISSION.nfz.forEach((f) => {
            const H = 70;
            const t = nfzTex.clone();
            t.needsUpdate = true;
            t.repeat.set((TAU * f.r) / 40, 1);
            const wall = new THREE.Mesh(new THREE.CylinderGeometry(f.r, f.r, 3, 64, 1, true), new THREE.MeshBasicMaterial({ map: t, transparent: true, side: THREE.DoubleSide, depthWrite: false }));
            wall.position.set(f.x, 1.5, f.z);
            const veil = new THREE.Mesh(new THREE.CylinderGeometry(f.r, f.r, H, 64, 1, true), new THREE.MeshBasicMaterial({ color: 0xf87171, transparent: true, opacity: 0.09, side: THREE.DoubleSide, depthWrite: false }));
            veil.position.set(f.x, H / 2, f.z);
            const top = new THREE.Mesh(new THREE.TorusGeometry(f.r, 0.25, 6, 96), new THREE.MeshBasicMaterial({ color: 0xf87171, transparent: true, opacity: 0.6 }));
            top.rotation.x = Math.PI / 2;
            top.position.set(f.x, H, f.z);
            const ground = new THREE.Mesh(new THREE.RingGeometry(f.r - 0.6, f.r, 96), new THREE.MeshBasicMaterial({ color: 0xf87171, transparent: true, opacity: 0.85, side: THREE.DoubleSide, depthWrite: false, polygonOffset: true, polygonOffsetFactor: -4 }));
            ground.rotation.x = -Math.PI / 2;
            ground.position.set(f.x, decalY(f.x, f.z, 0.7), f.z);
            nfzGroup.add(wall, veil, top, ground);
          });
        }

        /* ---------- planned route in 3D: thin line at flight height, posts at the waypoints ---------- */
        const routeGroup = new THREE.Group();
        scene.add(routeGroup);
        const aimTex = canvasTex(256, 256, (g, w) => {
          const c = w / 2;
          g.strokeStyle = "#fde047";
          g.lineWidth = 14;
          g.beginPath();
          g.arc(c, c, c * 0.62, 0, TAU);
          g.stroke();
          g.beginPath();
          g.moveTo(c, 10);
          g.lineTo(c, w - 10);
          g.moveTo(10, c);
          g.lineTo(w - 10, c);
          g.stroke();
        });
        function buildRoute3D() {
          while (routeGroup.children.length) {
            const c = routeGroup.children[0];
            if (c.geometry) c.geometry.dispose();
            routeGroup.remove(c);
          }
          if (!PLAN.aim) return;
          const h = ALT[PLAN.alt].h;
          const chk = checkRoute();
          chk.segs.forEach((sg) => {
            const col = sg.bad === "nfz" || (sg.bad === "obst" && sg.minC < 0.5) ? 0xf87171 : sg.bad ? 0xfbbf24 : 0x7cc4ff;
            const geo = new THREE.BufferGeometry().setFromPoints([V3(sg.a.x, h, sg.a.z), V3(sg.b.x, h, sg.b.z)]);
            const line = new THREE.Line(geo, new THREE.LineDashedMaterial({ color: col, dashSize: sg.runout ? 1.5 : 4, gapSize: sg.runout ? 2.5 : 1.5, transparent: true, opacity: sg.runout ? 0.5 : 0.9 }));
            line.computeLineDistances();
            routeGroup.add(line);
          });
          // a small ball marks each waypoint at flight height (no vertical posts)
          const post = (x, z, col) => {
            const ball = new THREE.Mesh(new THREE.SphereGeometry(0.45, 12, 8), new THREE.MeshBasicMaterial({ color: col }));
            ball.position.set(x, h, z);
            routeGroup.add(ball);
          };
          PLAN.wps.forEach((w) => post(w.x, w.z, 0x7cc4ff));
          const aim = new THREE.Mesh(new THREE.PlaneGeometry(4, 4), new THREE.MeshBasicMaterial({ map: aimTex, transparent: true, depthWrite: false, polygonOffset: true, polygonOffsetFactor: -8 }));
          aim.rotation.x = -Math.PI / 2;
          aim.position.set(PLAN.aim.x, decalY(PLAN.aim.x, PLAN.aim.z, 0.85), PLAN.aim.z);
          aim.userData.ground = true;
          routeGroup.add(aim);
        }

        /* ---------- the delivery drone ---------- */
        const glowTex = canvasTex(64, 64, (g, w) => {
          const gr = g.createRadialGradient(w / 2, w / 2, 0, w / 2, w / 2, w / 2);
          gr.addColorStop(0, "rgba(255,255,255,1)");
          gr.addColorStop(0.3, "rgba(255,255,255,0.45)");
          gr.addColorStop(1, "rgba(255,255,255,0)");
          g.fillStyle = gr;
          g.fillRect(0, 0, w, w);
        });
        // a spinning rotor seen as a faint blurred disc with orange safety tips
        const blurTex = canvasTex(128, 128, (g, w) => {
          const c = w / 2;
          const gr = g.createRadialGradient(c, c, c * 0.1, c, c, c);
          gr.addColorStop(0, "rgba(40,44,52,0)");
          gr.addColorStop(0.22, "rgba(40,44,52,0.32)");
          gr.addColorStop(0.86, "rgba(40,44,52,0.22)");
          gr.addColorStop(0.93, "rgba(255,130,40,0.5)");
          gr.addColorStop(1, "rgba(255,130,40,0)");
          g.fillStyle = gr;
          g.beginPath();
          g.arc(c, c, c, 0, TAU);
          g.fill();
        });
        const decalTex = canvasTex(256, 64, (g, w, h) => {
          g.clearRect(0, 0, w, h);
          g.fillStyle = "#ff6a1a";
          g.fillRect(4, h * 0.2, h * 0.6, h * 0.6);
          g.fillStyle = "#ffffff";
          g.fillRect(4 + h * 0.24, h * 0.27, h * 0.12, h * 0.46);
          g.fillRect(4 + h * 0.07, h * 0.44, h * 0.46, h * 0.12);
          g.fillStyle = "#1d2026";
          g.font = "900 38px Arial";
          g.textBaseline = "middle";
          g.fillText("RESCUE", h * 0.8, h / 2 + 2);
        });
        // a tapered, slightly twisted propeller blade lying along +x
        function bladeGeo(R) {
          const sh = new THREE.Shape();
          sh.moveTo(0.03, -0.022);
          sh.quadraticCurveTo(R * 0.45, -0.036, R, -0.012);
          sh.lineTo(R, 0.006);
          sh.quadraticCurveTo(R * 0.5, 0.024, 0.03, 0.02);
          sh.lineTo(0.03, -0.022);
          const geo = new THREE.ExtrudeGeometry(sh, { depth: 0.005, bevelEnabled: false });
          geo.rotateX(-Math.PI / 2);
          const p = geo.attributes.position;
          for (let i = 0; i < p.count; i++) {
            const x = p.getX(i),
              z = p.getZ(i);
            p.setY(i, p.getY(i) + z * Math.sin(0.35 * (1 - x / R)));
          }
          geo.computeVertexNormals();
          return geo;
        }
        // An industrial delivery drone in the style of today's enterprise airframes (DJI Matrice 350 / FlyCart class):
        // a compact chassis with a light top shell, twin hot-swap batteries on top, an RTK/GNSS module with two antennas,
        // binocular vision sensors on every side, carbon arms with folding-lock sleeves, finned motors with ESC pods,
        // two-blade carbon propellers, navigation LEDs under the arms and an A-frame landing gear on shock absorbers.
        // Model units: the drawing is scaled by DRONES[k].scale; the skids touch the ground at y = -0.367.
        const carbonTex = canvasTex(64, 64, (g, w) => {
          g.fillStyle = "#2a2e35";
          g.fillRect(0, 0, w, w);
          for (let y = 0; y < w; y += 8)
            for (let x = 0; x < w; x += 8) {
              g.fillStyle = (x + y) % 16 ? "#30353d" : "#24282e";
              g.fillRect(x, y, 8, 4);
              g.fillStyle = (x + y) % 16 ? "#24282e" : "#30353d";
              g.fillRect(x, y + 4, 8, 4);
            }
        });
        carbonTex.wrapS = carbonTex.wrapT = THREE.RepeatWrapping;
        carbonTex.repeat.set(2, 6);
        // a rounded box (bevelled edges) of size w (x) × h (y) × d (z), centred
        function roundBox(w, h, d, r) {
          const s = new THREE.Shape();
          const x = -w / 2 + r,
            z = -d / 2 + r,
            W = w - 2 * r,
            D = d - 2 * r;
          s.moveTo(x, z - r);
          s.lineTo(x + W, z - r);
          s.quadraticCurveTo(x + W + r, z - r, x + W + r, z);
          s.lineTo(x + W + r, z + D);
          s.quadraticCurveTo(x + W + r, z + D + r, x + W, z + D + r);
          s.lineTo(x, z + D + r);
          s.quadraticCurveTo(x - r, z + D + r, x - r, z + D);
          s.lineTo(x - r, z);
          s.quadraticCurveTo(x - r, z - r, x, z - r);
          const bev = Math.min(r * 0.8, h * 0.3);
          const g = new THREE.ExtrudeGeometry(s, { depth: h - 2 * bev, bevelEnabled: true, bevelThickness: bev, bevelSize: bev * 0.9, bevelSegments: 3, curveSegments: 6 });
          g.rotateX(Math.PI / 2);
          g.translate(0, h / 2 - bev, 0);
          g.computeVertexNormals();
          return g;
        }
        function buildDrone(k) {
          const D = DRONES[k];
          const hexa = D.rotors === 6;
          const g = new THREE.Group();
          const shell = new THREE.MeshPhysicalMaterial({ color: C(0xe9ecef), roughness: 0.35, clearcoat: 0.8, clearcoatRoughness: 0.2 });
          const chassisM = new THREE.MeshStandardMaterial({ color: C(0x30343b), roughness: 0.55, metalness: 0.2 });
          const orange = new THREE.MeshPhysicalMaterial({ color: C(0xff6a1a), roughness: 0.35, clearcoat: 0.6 });
          const carbon = new THREE.MeshStandardMaterial({ color: C(0xffffff), map: carbonTex, roughness: 0.38, metalness: 0.3 });
          const dark = new THREE.MeshStandardMaterial({ color: C(0x1b1e23), roughness: 0.6, metalness: 0.2 });
          const metal = new THREE.MeshStandardMaterial({ color: C(0xb9c0c8), roughness: 0.22, metalness: 0.9 });
          const alu = new THREE.MeshStandardMaterial({ color: C(0x8e959e), roughness: 0.35, metalness: 0.8 });
          const batM = new THREE.MeshStandardMaterial({ color: C(0xc7ccd2), roughness: 0.5, metalness: 0.1 });
          const rubber = new THREE.MeshStandardMaterial({ color: C(0x15171a), roughness: 0.95 });
          const lensM = new THREE.MeshPhysicalMaterial({ color: C(0x0b0f14), roughness: 0.05, metalness: 0.6, clearcoat: 1 });
          const add = (geo, mat, x, y, z, rx, ry, rz) => {
            const m = new THREE.Mesh(geo, mat);
            m.position.set(x || 0, y || 0, z || 0);
            m.rotation.set(rx || 0, ry || 0, rz || 0);
            g.add(m);
            return m;
          };
          const bw = hexa ? 0.42 : 0.36,
            bd = hexa ? 0.5 : 0.5;
          // chassis (dark) and the light top shell with an orange band
          add(roundBox(bw, 0.12, bd, 0.06), chassisM, 0, -0.04);
          add(roundBox(bw - 0.02, 0.06, bd - 0.03, 0.055), shell, 0, 0.045);
          add(roundBox(bw + 0.004, 0.018, bd + 0.004, 0.062), orange, 0, 0.012);
          // vents on the chassis sides
          for (const sx of [-1, 1])
            for (let i = 0; i < 5; i++) add(new THREE.BoxGeometry(0.004, 0.012, 0.05), dark, sx * (bw / 2 + 0.001), -0.045, -0.12 + i * 0.06);
          // twin batteries on top, with handles and charge LEDs on the back
          for (const sx of [-1, 1]) {
            const bx = sx * (bw * 0.24);
            add(roundBox(bw * 0.4, 0.07, 0.3, 0.02), batM, bx, 0.105, 0.01);
            // grip ribs along the pack and a dark release latch at the back end
            for (let r = 0; r < 3; r++) add(new THREE.BoxGeometry(0.006, 0.003, 0.2), new THREE.MeshStandardMaterial({ color: C(0xaab0b7), roughness: 0.6 }), bx - 0.03 + r * 0.03, 0.1415, -0.02);
            add(roundBox(bw * 0.4 - 0.02, 0.016, 0.03, 0.008), dark, bx, 0.135, 0.145);
            for (let i = 0; i < 4; i++) add(new THREE.SphereGeometry(0.005, 6, 4), new THREE.MeshBasicMaterial({ color: i < 3 ? 0x34d399 : 0x3b4048 }), bx - 0.03 + i * 0.02, 0.105, 0.162);
          }
          // RTK / GNSS module at the back with two antenna masts
          add(roundBox(0.14, 0.035, 0.07, 0.015), chassisM, 0, 0.088, 0.21);
          for (const sx of [-1, 1]) {
            add(new THREE.CylinderGeometry(0.007, 0.009, 0.12, 8), carbon, sx * 0.13, 0.13, 0.2);
            add(new THREE.CylinderGeometry(0.034, 0.03, 0.02, 18), shell, sx * 0.13, 0.198, 0.2);
            add(new THREE.SphereGeometry(0.03, 16, 8, 0, TAU, 0, Math.PI / 2), shell, sx * 0.13, 0.207, 0.2).scale.y = 0.45;
          }
          // binocular vision sensors: a lens pair on the front, back and both sides, and one pair underneath
          const pair = (x, y, z, ry, gap) => {
            for (const s of [-1, 1]) {
              const ox = Math.cos(ry) * s * gap,
                oz = -Math.sin(ry) * s * gap;
              add(new THREE.CylinderGeometry(0.012, 0.012, 0.01, 14), lensM, x + ox, y, z + oz, Math.PI / 2, ry, 0);
            }
          };
          pair(0, -0.03, -bd / 2 - 0.004, 0, 0.06);
          pair(0, -0.03, bd / 2 + 0.004, Math.PI, 0.06);
          pair(-bw / 2 - 0.004, -0.03, 0.06, Math.PI / 2, 0.05);
          pair(bw / 2 + 0.004, -0.03, 0.06, -Math.PI / 2, 0.05);
          for (const s of [-1, 1]) add(new THREE.CylinderGeometry(0.012, 0.012, 0.01, 14), lensM, s * 0.05, -0.1, -0.16);
          // FPV camera at the nose and a status light
          add(roundBox(0.05, 0.035, 0.03, 0.01), dark, 0, 0.0, -bd / 2 - 0.012);
          add(new THREE.CylinderGeometry(0.011, 0.011, 0.01, 14), lensM, 0, 0.0, -bd / 2 - 0.028, Math.PI / 2, 0, 0);
          // RESCUE decals on the shell sides
          for (const sx of [-1, 1]) {
            const dec = new THREE.Mesh(new THREE.PlaneGeometry(0.3, 0.075), new THREE.MeshStandardMaterial({ map: decalTex, transparent: true, roughness: 0.4 }));
            dec.position.set(sx * ((bw - 0.02) / 2 + 0.003), 0.045, 0.02);
            dec.rotation.y = sx * (Math.PI / 2);
            dec.scale.setScalar(0.85);
            g.add(dec);
          }
          // arms, folding sleeves, motors and rotors
          const props = [];
          const blade = bladeGeo(D.prop);
          for (let i = 0; i < D.rotors; i++) {
            const deg = hexa ? 30 + i * 60 : 45 + i * 90;
            const a = deg * D2R;
            const ux = Math.sin(a),
              uz = -Math.cos(a);
            const mx = ux * D.arm,
              mz = uz * D.arm;
            const r0 = 0.16,
              len = D.arm - r0;
            const armG = new THREE.CylinderGeometry(0.021, 0.024, len, 12);
            armG.rotateX(Math.PI / 2);
            const arm = add(armG, carbon, ux * (r0 + len / 2), 0.005, uz * (r0 + len / 2));
            arm.rotation.y = -a;
            // root bracket and the folding sleeve with its orange lock ring
            const root = add(roundBox(0.07, 0.05, 0.08, 0.015), chassisM, ux * 0.17, 0.005, uz * 0.17);
            root.rotation.y = -a;
            const sleeveG = new THREE.CylinderGeometry(0.031, 0.031, 0.07, 16);
            sleeveG.rotateX(Math.PI / 2);
            const sleeve = add(sleeveG, alu, ux * 0.25, 0.005, uz * 0.25);
            sleeve.rotation.y = -a;
            const lockG = new THREE.CylinderGeometry(0.033, 0.033, 0.016, 16);
            lockG.rotateX(Math.PI / 2);
            const lock = add(lockG, orange, ux * 0.285, 0.005, uz * 0.285);
            lock.rotation.y = -a;
            // ESC pod under the motor, motor base with cooling fins, the spinning bell
            const esc = add(roundBox(0.05, 0.03, 0.09, 0.012), chassisM, ux * (D.arm - 0.05), -0.02, uz * (D.arm - 0.05));
            esc.rotation.y = -a;
            add(new THREE.CylinderGeometry(0.052, 0.058, 0.03, 20), dark, mx, 0.02, mz);
            for (let f = 0; f < 16; f++) {
              const fa = (f / 16) * TAU;
              add(new THREE.BoxGeometry(0.004, 0.026, 0.012), alu, mx + Math.cos(fa) * 0.056, 0.022, mz + Math.sin(fa) * 0.056, 0, -fa, 0);
            }
            add(new THREE.CylinderGeometry(0.05, 0.05, 0.038, 24), metal, mx, 0.054, mz);
            add(new THREE.CylinderGeometry(0.0505, 0.0505, 0.01, 24), dark, mx, 0.06, mz);
            const front = uz < 0;
            add(new THREE.CylinderGeometry(0.022, 0.028, 0.018, 16), front ? orange : dark, mx, 0.082, mz);
            const pg = new THREE.Group();
            pg.position.set(mx, 0.096, mz);
            for (const r of [0, Math.PI]) {
              const bm = new THREE.Mesh(blade, dark);
              bm.rotation.y = r;
              pg.add(bm);
            }
            const tipM = new THREE.MeshStandardMaterial({ color: C(0xf5f5f5), roughness: 0.4 });
            for (const r of [0, Math.PI]) {
              const tip = new THREE.Mesh(new THREE.BoxGeometry(0.03, 0.006, 0.026), tipM);
              tip.position.set(Math.cos(r) * (D.prop - 0.02), 0.003, 0);
              pg.add(tip);
            }
            g.add(pg);
            const disc = add(new THREE.CircleGeometry(D.prop + 0.01, 48), new THREE.MeshBasicMaterial({ map: blurTex, transparent: true, opacity: 0, depthWrite: false, side: THREE.DoubleSide }), mx, 0.098, mz, -Math.PI / 2);
            // navigation lights under each motor: red left, green right (front arms), white strobes at the back
            const navCol = front ? (ux > 0 ? 0x2bff6a : 0xff2a2a) : 0xffffff;
            const led = add(new THREE.SphereGeometry(0.014, 10, 6), new THREE.MeshBasicMaterial({ color: navCol }), ux * (D.arm - 0.02), -0.04, uz * (D.arm - 0.02));
            const glow = new THREE.Sprite(new THREE.SpriteMaterial({ map: glowTex, color: navCol, transparent: true, depthWrite: false, blending: THREE.AdditiveBlending, opacity: 0.8 }));
            glow.scale.setScalar(0.16);
            glow.position.copy(led.position);
            g.add(glow);
            props.push({ pg, disc, glow, dir: i % 2 ? 1 : -1, rear: !front });
          }
          // landing gear: on each side an A-frame (two struts) on a shock-absorber mount, down to a skid with rubber feet
          const LL = 0.367,
            gx = 0.27;
          const tube = (p0, p1, r, mat) => {
            const v = new THREE.Vector3().subVectors(p1, p0);
            const m = new THREE.Mesh(new THREE.CylinderGeometry(r, r, v.length(), 10), mat);
            m.position.copy(p0).addScaledVector(v, 0.5);
            m.quaternion.setFromUnitVectors(V3(0, 1, 0), v.normalize());
            g.add(m);
            return m;
          };
          for (const sx of [-1, 1]) {
            const top = V3(sx * (bw / 2 - 0.02), -0.075, 0);
            add(new THREE.SphereGeometry(0.022, 12, 8), rubber, top.x, top.y, 0);
            for (const sz of [-1, 1]) tube(V3(top.x, top.y, sz * 0.03), V3(sx * gx, -LL + 0.02, sz * 0.15), 0.011, carbon);
            // skid with end caps and rubber feet
            const sk = new THREE.Mesh(new THREE.CylinderGeometry(0.013, 0.013, 0.5, 12), carbon);
            sk.rotation.x = Math.PI / 2;
            sk.position.set(sx * gx, -LL + 0.015, 0);
            g.add(sk);
            for (const ez of [-0.25, 0.25]) add(new THREE.SphereGeometry(0.016, 10, 6), orange, sx * gx, -LL + 0.015, ez);
            for (const fz of [-0.15, 0.15]) add(new THREE.BoxGeometry(0.03, 0.012, 0.05), rubber, sx * gx, -LL + 0.004, fz);
            // a data-link antenna along the rear strut
            const ant = add(new THREE.BoxGeometry(0.004, 0.11, 0.02), new THREE.MeshStandardMaterial({ color: C(0xf2f2f2), roughness: 0.5 }), sx * (gx - 0.035), -0.2, 0.1);
            ant.rotation.z = sx * 0.33;
          }
          // a front gimbal camera hangs under the nose
          add(new THREE.BoxGeometry(0.05, 0.03, 0.03), dark, 0, -0.112, -0.2);
          add(new THREE.SphereGeometry(0.036, 18, 12), dark, 0, -0.142, -0.2);
          add(new THREE.CylinderGeometry(0.018, 0.018, 0.01, 16), lensM, 0, -0.145, -0.238, Math.PI / 2, 0, 0);
          g.scale.setScalar(D.scale);
          castAll(g);
          props.forEach((p) => {
            p.disc.castShadow = false;
            p.glow.castShadow = false;
          });
          return { g, props };
        }
        function buildParcel(k) {
          const P = PAY[k];
          const grp = new THREE.Group();
          const sz = k === "light" ? [0.24, 0.16, 0.24] : k === "med" ? [0.3, 0.22, 0.3] : [0.34, 0.2, 0.26];
          const box = new THREE.Mesh(new THREE.BoxGeometry(...sz), new THREE.MeshStandardMaterial({ color: C(P.col), roughness: 0.75 }));
          const band = new THREE.Mesh(new THREE.BoxGeometry(sz[0] + 0.006, sz[1] + 0.006, 0.05), new THREE.MeshStandardMaterial({ color: C(P.band), roughness: 0.6 }));
          grp.add(box, band);
          if (k === "light") {
            const top = new THREE.Mesh(new THREE.PlaneGeometry(sz[0] * 0.8, sz[2] * 0.8), new THREE.MeshStandardMaterial({ map: crossTex() }));
            top.rotation.x = -Math.PI / 2;
            top.position.y = sz[1] / 2 + 0.004;
            grp.add(top);
          }
          // grip strips on the two sides the claws hold
          for (const sx of [-1, 1]) {
            const strip = new THREE.Mesh(new THREE.BoxGeometry(0.006, sz[1] * 0.7, sz[2] * 0.7), new THREE.MeshStandardMaterial({ color: C(0x2b2f36), roughness: 0.9 }));
            strip.position.x = sx * (sz[0] / 2 + 0.003);
            grp.add(strip);
          }
          grp.userData.h = sz[1];
          grp.userData.sz = sz.map((v) => v * PSCALE);
          grp.scale.setScalar(PSCALE);
          castAll(grp);
          return grp;
        }
        const PSCALE = 1.7;
        let DR = buildDrone(PLAN.drone);
        scene.add(DR.g);
        let parcel = buildParcel(PLAN.pay);
        scene.add(parcel);
        function setParcel() {
          scene.remove(parcel);
          parcel = buildParcel(PLAN.pay);
          scene.add(parcel);
          if (clawM) buildClaws();
        }
        function setDroneModel() {
          scene.remove(DR.g);
          droneDims(PLAN.drone);
          DR = buildDrone(PLAN.drone);
          scene.add(DR.g);
          buildClaws();
          if (!S.started) S.pos.y = LEG;
        }
        // claw gripper under the drone: a mount, a servo and two jaws with hooked tips that hold the payload's sides
        let clawM = null;
        function buildClaws() {
          if (clawM) scene.remove(clawM);
          const g = new THREE.Group();
          const carbon = new THREE.MeshStandardMaterial({ color: C(0x22262d), roughness: 0.45, metalness: 0.35 });
          const metal = new THREE.MeshStandardMaterial({ color: C(0xb7bec7), roughness: 0.25, metalness: 0.85 });
          const orange = new THREE.MeshPhysicalMaterial({ color: C(0xff6a1a), roughness: 0.35, clearcoat: 0.6 });
          const rubber = new THREE.MeshStandardMaterial({ color: C(0x111317), roughness: 0.95 });
          const [wP, hP, dP] = parcel.userData.sz;
          const bodyBot = -0.1 * DSCALE;
          const hubY = bodyBot - 0.02;
          const botY = -LEG + 0.012;
          const mount = new THREE.Mesh(new THREE.BoxGeometry(wP + 0.1, 0.03, Math.min(dP * 0.6, 0.3)), carbon);
          mount.position.y = hubY;
          const servo = new THREE.Mesh(new THREE.BoxGeometry(0.1, 0.05, 0.075), orange);
          servo.position.y = hubY - 0.035;
          const horn = new THREE.Mesh(new THREE.CylinderGeometry(0.018, 0.018, 0.012, 12), metal);
          horn.rotation.x = Math.PI / 2;
          horn.position.set(0, hubY - 0.035, 0.044);
          g.add(mount, servo, horn);
          const pivY = hubY - 0.02;
          const Lj = pivY - botY + 0.02;
          const jaws = [-1, 1].map((sx) => {
            const pv = new THREE.Group();
            pv.position.set(sx * (wP / 2 + 0.032), pivY, 0);
            const hinge = new THREE.Mesh(new THREE.CylinderGeometry(0.014, 0.014, dP * 0.62, 10), metal);
            hinge.rotation.x = Math.PI / 2;
            pv.add(hinge);
            for (const zz of [-dP * 0.28, dP * 0.28]) {
              const prong = new THREE.Mesh(new THREE.BoxGeometry(0.03, Lj, 0.04), metal);
              prong.position.set(0, -Lj / 2, zz);
              const tip = new THREE.Mesh(new THREE.BoxGeometry(0.1, 0.032, 0.044), orange);
              tip.position.set(-sx * 0.04, -Lj + 0.012, zz);
              const pad = new THREE.Mesh(new THREE.BoxGeometry(0.008, Lj * 0.45, 0.034), rubber);
              pad.position.set(-sx * 0.014, -Lj * 0.6, zz);
              pv.add(prong, tip, pad);
            }
            const brace = new THREE.Mesh(new THREE.BoxGeometry(0.024, 0.03, dP * 0.56 + 0.04), orange);
            brace.position.set(0, -Lj * 0.3, 0);
            pv.add(brace);
            pv.userData.sx = sx;
            g.add(pv);
            return pv;
          });
          // linkage rods from the servo out to each jaw
          for (const sx of [-1, 1]) {
            const rod = new THREE.Mesh(new THREE.CylinderGeometry(0.006, 0.006, wP / 2 + 0.03, 6), metal);
            rod.rotation.z = Math.PI / 2;
            rod.position.set((sx * (wP / 2 + 0.03)) / 2, hubY - 0.035, 0.044);
            g.add(rod);
          }
          castAll(g);
          g.userData.jaws = jaws;
          clawM = g;
          scene.add(g);
        }
        buildClaws();
        // soft spots on the ground right under the drone and the falling payload (where it is over the ground)
        const blobTex = canvasTex(128, 128, (g, w) => {
          const gr = g.createRadialGradient(w / 2, w / 2, 0, w / 2, w / 2, w / 2);
          gr.addColorStop(0, "rgba(0,0,0,0.75)");
          gr.addColorStop(0.55, "rgba(0,0,0,0.35)");
          gr.addColorStop(1, "rgba(0,0,0,0)");
          g.fillStyle = gr;
          g.fillRect(0, 0, w, w);
        });
        const mkBlob = () => {
          const m = new THREE.Mesh(new THREE.PlaneGeometry(1, 1), new THREE.MeshBasicMaterial({ map: blobTex, transparent: true, depthWrite: false, polygonOffset: true, polygonOffsetFactor: -10 }));
          m.rotation.x = -Math.PI / 2;
          scene.add(m);
          return m;
        };
        const droneBlob = mkBlob(),
          payBlob = mkBlob();

        /* ---------- markers: predicted landing (auto), landing spot ---------- */
        const predTex = canvasTex(128, 128, (g, w) => {
          g.strokeStyle = "#fde047";
          g.lineWidth = 12;
          g.beginPath();
          g.moveTo(20, 20);
          g.lineTo(w - 20, w - 20);
          g.moveTo(w - 20, 20);
          g.lineTo(20, w - 20);
          g.stroke();
        });
        const predMark = new THREE.Mesh(new THREE.PlaneGeometry(2.4, 2.4), new THREE.MeshBasicMaterial({ map: predTex, transparent: true, depthWrite: false, polygonOffset: true, polygonOffsetFactor: -8 }));
        predMark.rotation.x = -Math.PI / 2;
        predMark.visible = false;
        scene.add(predMark);
        const landMark = new THREE.Group();
        {
          const ring = new THREE.Mesh(new THREE.RingGeometry(0.7, 1.0, 32), new THREE.MeshBasicMaterial({ color: 0xff3b6b, side: THREE.DoubleSide, depthWrite: false, polygonOffset: true, polygonOffsetFactor: -8 }));
          ring.rotation.x = -Math.PI / 2;
          ring.position.y = 0.2;
          landMark.add(ring);
        }
        landMark.visible = false;
        scene.add(landMark);
        let landLine = null;
        // wind streaks
        const NSTREAK = 160;
        const streakGeo = new THREE.BufferGeometry();
        streakGeo.setAttribute("position", new THREE.Float32BufferAttribute(new Float32Array(NSTREAK * 6), 3));
        const streaks = new THREE.LineSegments(streakGeo, new THREE.LineBasicMaterial({ color: 0xffffff, transparent: true, opacity: 0.5 }));
        streaks.frustumCulled = false;
        scene.add(streaks);
        const streakP = [];
        for (let i = 0; i < NSTREAK; i++) streakP.push(V3((Math.random() - 0.5) * 70, Math.random() * 30, (Math.random() - 0.5) * 70));
        // dust / splash puffs
        const PUFFS = [];
        const puffTex = canvasTex(64, 64, (g, w) => {
          const gr = g.createRadialGradient(w / 2, w / 2, 0, w / 2, w / 2, w / 2);
          gr.addColorStop(0, "rgba(255,255,255,0.9)");
          gr.addColorStop(1, "rgba(255,255,255,0)");
          g.fillStyle = gr;
          g.fillRect(0, 0, w, w);
        });
        function puff(x, y, z, col, n, spread) {
          for (let i = 0; i < n; i++) {
            const s = new THREE.Sprite(new THREE.SpriteMaterial({ map: puffTex, color: col, transparent: true, depthWrite: false, opacity: 0.8 }));
            s.position.set(x, y, z);
            scene.add(s);
            PUFFS.push({ s, v: V3((Math.random() - 0.5) * spread, 0.6 + Math.random() * spread * 0.6, (Math.random() - 0.5) * spread), life: 0, max: 1.2 + Math.random() * 0.8 });
          }
        }

        /* ================= time of day, reflections ================= */
        const TOD = {
          morning: { el: 15, az: 105, sun: 0xffcf9c, sunI: 1.5, hs: 0xbfd0ff, hg: 0x5a4a32, hi: 0.55, top: 0x4f86d0, hor: 0xf2d5b3, fog: 0xe3d1bd, exp: 1.0, cloud: 0xffe6d0 },
          midday: { el: 64, az: 160, sun: 0xfff6e8, sunI: 1.7, hs: 0xd2e5ff, hg: 0x4f6a35, hi: 0.6, top: 0x2d6bc6, hor: 0xc6dbee, fog: 0xc8dbeb, exp: 1.0, cloud: 0xffffff },
          sunset: { el: 5, az: 258, sun: 0xff8f4a, sunI: 1.35, hs: 0x8f92c9, hg: 0x4b3527, hi: 0.45, top: 0x31457f, hor: 0xffa060, fog: 0xd59a7a, exp: 0.95, cloud: 0xffb184 },
        };
        const pmrem = new THREE.PMREMGenerator(renderer);
        const envScene = new THREE.Scene();
        envScene.add(new THREE.Mesh(new THREE.SphereGeometry(100, 32, 16), skyMesh.material));
        const envGround = new THREE.Mesh(new THREE.CircleGeometry(100, 32), new THREE.MeshBasicMaterial({ color: C(0x4c6b3a) }));
        envGround.rotation.x = -Math.PI / 2;
        envGround.position.y = -4;
        envScene.add(envGround);
        let envRT = null;
        const glareTex = canvasTex(256, 256, (g, w) => {
          const gr = g.createRadialGradient(w / 2, w / 2, 0, w / 2, w / 2, w / 2);
          gr.addColorStop(0, "rgba(255,255,255,1)");
          gr.addColorStop(0.08, "rgba(255,250,235,0.85)");
          gr.addColorStop(0.25, "rgba(255,235,200,0.25)");
          gr.addColorStop(1, "rgba(255,220,180,0)");
          g.fillStyle = gr;
          g.fillRect(0, 0, w, w);
        });
        const glare = new THREE.Sprite(new THREE.SpriteMaterial({ map: glareTex, blending: THREE.AdditiveBlending, depthWrite: false, fog: false, transparent: true }));
        glare.scale.set(1100, 1100, 1);
        scene.add(glare);
        function applyTime(k) {
          const t = TOD[k];
          const el = t.el * D2R,
            az = t.az * D2R;
          sunDir.set(Math.sin(az) * Math.cos(el), Math.sin(el), -Math.cos(az) * Math.cos(el)).normalize();
          sun.color.copy(C(t.sun));
          sun.intensity = t.sunI;
          hemi.color.copy(C(t.hs));
          hemi.groundColor.copy(C(t.hg));
          hemi.intensity = t.hi * 0.7;
          skyU.top.value.copy(C(t.top));
          skyU.hor.value.copy(C(t.hor));
          skyU.sunCol.value.copy(C(t.sun));
          skyU.sunDir.value.copy(sunDir);
          scene.fog.color.copy(C(t.fog));
          renderer.toneMappingExposure = t.exp;
          cloudMat.color.copy(C(t.cloud));
          glare.material.color.copy(C(t.sun));
          glare.material.opacity = k === "midday" ? 0.55 : 0.85;
          envGround.material.color.copy(C(k === "sunset" ? 0x3a3a26 : 0x4c6b3a));
          if (envRT) envRT.dispose();
          envRT = pmrem.fromScene(envScene, 0.02);
          scene.environment = envRT.texture;
        }
        applyTime(settings.tod || "midday");

        /* ================= per-frame visuals and cameras ================= */
        const tmpV = V3(0, 0, 0);
        const UPV = V3(0, 1, 0);
        const vis = {
          snapCam: true,
          camPos: V3(0, 6, 12),
          camLook: V3(0, 1, 0),
          spin: 0,
          onCrash() {
            puff(S.pos.x, Math.max(0.5, S.pos.y), S.pos.z, 0x8a8178, 14, 3);
          },
          onPayloadLand(wet) {
            const p = S.pay.pos;
            if (wet) puff(p.x, 0.2, p.z, 0xdff3ff, 16, 3.5);
            else puff(p.x, p.y + 0.1, p.z, 0xb8a27c, 10, 2);
          },
        };
        window.__vis = vis;
        function updateVisuals(dt, live) {
          const wMean = windMean(8);
          const ws = wMean.length();
          U.time.value += dt;
          U.wind.value = ws;
          // drone body
          DR.g.position.copy(S.pos);
          DR.g.rotation.set(-S.tiltF, -S.psi, -S.tiltR, "YXZ");
          const rpm = S.rpm;
          vis.spin += rpm * 55 * dt;
          const strobe = Math.floor(performance.now() / 110) % 11 === 0;
          DR.props.forEach((p) => {
            p.pg.rotation.y = vis.spin * p.dir;
            p.disc.material.opacity = clamp((rpm - 0.25) * 1.6, 0, 1) * 0.9;
            p.pg.visible = rpm < 0.55;
            if (p.rear) p.glow.material.opacity = strobe && rpm > 0 ? 1 : 0.18;
          });
          // the claws ride under the drone; while they grip, the payload moves with the drone
          const att = S.pay.st === "attached";
          const ph = parcel.userData.h * PSCALE;
          clawM.position.copy(S.pos);
          clawM.quaternion.copy(DR.g.quaternion);
          clawM.visible = true;
          clawM.userData.jaws.forEach((j) => (j.rotation.z = j.userData.sx * S.claw * 0.75));
          if (att) {
            parcel.position.set(0, -LEG + 0.012 + ph / 2, 0).applyQuaternion(DR.g.quaternion).add(S.pos);
            parcel.quaternion.copy(DR.g.quaternion);
          } else {
            parcel.position.copy(S.pay.pos);
            parcel.position.y += S.pay.st === "lost" ? -0.45 : ph / 2;
            parcel.rotation.set(S.pay.rot.x, S.pay.rot.y, S.pay.rot.z);
          }
          // soft ground spots under the drone and the falling payload
          {
            const h = altNow();
            const bs = DSCALE * 1.8 * (1 + h * 0.02);
            droneBlob.position.set(S.pos.x, decalY(S.pos.x, S.pos.z, 0.95), S.pos.z);
            droneBlob.scale.set(bs, bs, 1);
            droneBlob.material.opacity = S.phase === "crash" ? 0 : clamp(0.6 * Math.exp(-h / 45), 0.3, 0.6);
            payBlob.visible = S.pay.st === "falling";
            if (payBlob.visible) {
              const hp = Math.max(0, S.pay.pos.y);
              const s2 = 0.9 + hp * 0.02;
              payBlob.position.set(S.pay.pos.x, decalY(S.pay.pos.x, S.pay.pos.z, 0.95), S.pay.pos.z);
              payBlob.scale.set(s2, s2, 1);
              payBlob.material.opacity = clamp(0.6 * Math.exp(-hp / 25), 0.15, 0.6);
            }
          }
          // the planned route in 3D is a planning aid: during the flight only the drop point stays
          routeGroup.children.forEach((c) => (c.visible = !S.started || !!c.userData.ground));
          // the landing spot under a loaded drone flown by hand (a cross on the ground right below it)
          predMark.visible = att && PLAN.mode === "manual" && S.started && !S.ground && altNow() < 30 && S.phase !== "crash";
          if (predMark.visible) {
            predMark.position.set(S.pos.x, decalY(S.pos.x, S.pos.z, 0.9), S.pos.z);
            predMark.scale.setScalar(0.6 + altNow() * 0.02);
          }
          // landing marker and the line to the target centre
          const L = S.pay.land;
          landMark.visible = !!L && !L.wet;
          if (L && !L.wet) {
            landMark.position.set(L.x, L.roof ? S.pay.pos.y + 0.01 : decalY(L.x, L.z, 0.9) - 0.2, L.z);
            if (!landLine || landLine.userData.key !== L.x + "," + L.z) {
              if (landLine) scene.remove(landLine);
              const z = tgtZone();
              const geo = new THREE.BufferGeometry().setFromPoints([V3(z.x, decalY(z.x, z.z, 0.9), z.z), V3(L.x, L.roof ? S.pay.pos.y + 0.01 : decalY(L.x, L.z, 0.9), L.z)]);
              landLine = new THREE.Line(geo, new THREE.LineDashedMaterial({ color: 0xff3b6b, dashSize: 0.6, gapSize: 0.4 }));
              landLine.computeLineDistances();
              landLine.userData.key = L.x + "," + L.z;
              scene.add(landLine);
            }
          } else if (landLine) {
            scene.remove(landLine);
            landLine = null;
          }
          // wind streaks around the drone
          streaks.visible = ws > 0.3 && settings.cam !== "top";
          if (streaks.visible) {
            const arr = streakGeo.attributes.position.array;
            const len = 0.5 + ws * 0.25;
            for (let i = 0; i < NSTREAK; i++) {
              const p = streakP[i];
              const w = windAt(p.x, p.y, p.z, S.t);
              p.addScaledVector(w, dt || 0.016);
              const rel = tmpV.copy(p).sub(S.pos);
              if (Math.abs(rel.x) > 35) p.x -= Math.sign(rel.x) * 70;
              if (Math.abs(rel.z) > 35) p.z -= Math.sign(rel.z) * 70;
              if (rel.y > 15 || rel.y < -15) p.y = Math.max(0.5, S.pos.y - 12 + Math.random() * 24);
              const d = w.length() || 1;
              arr[i * 6] = p.x;
              arr[i * 6 + 1] = Math.max(0.3, p.y);
              arr[i * 6 + 2] = p.z;
              arr[i * 6 + 3] = p.x + (w.x / d) * len;
              arr[i * 6 + 4] = Math.max(0.3, p.y);
              arr[i * 6 + 5] = p.z + (w.z / d) * len;
            }
            streakGeo.attributes.position.needsUpdate = true;
          }
          // windsock, flags, clouds, birds, mast light
          const yawDown = ws > 0.2 ? Math.atan2(-wMean.z, wMean.x) : 0.6;
          sock.rotation.y = yawDown;
          sockArm.rotation.z = -lerp(80, 4, clamp(ws / 6, 0, 1)) * D2R;
          {
            const t = U.time.value + performance.now() / 1000;
            const k = clamp(ws / 5, 0, 1);
            const p = flagGeo.attributes.position.array;
            for (let i = 0; i < p.length; i += 3) {
              const x0 = flagBase[i],
                y0 = flagBase[i + 1];
              const u = x0 / 1.6;
              const wave = Math.sin(x0 * 3.4 - t * (3 + ws * 1.4)) * (0.06 + 0.16 * k) * u;
              const droop = (1 - k) * u;
              p[i] = x0 * (1 - droop * 0.55);
              p[i + 1] = y0 - droop * x0 * 0.75;
              p[i + 2] = wave;
            }
            flagGeo.attributes.position.needsUpdate = true;
            flagGeo.computeVertexNormals();
            flagGroup.rotation.y = yawDown;
            ZONES.forEach((z) => (zoneMeshes[z.k].cloth.rotation.y = yawDown));
          }
          const T = performance.now() / 1000;
          waterNormal.offset.set(T * 0.012 + wMean.x * T * 0.003, T * 0.008 + wMean.z * T * 0.003);
          const cloudWind = ws > 0.2 ? wMean.clone().multiplyScalar(2.5) : V3(3, 0, 1.2);
          CLOUDS.forEach((cl) => {
            cl.position.addScaledVector(cloudWind, dt);
            if (cl.position.x > 2400) cl.position.x -= 4800;
            if (cl.position.x < -2400) cl.position.x += 4800;
            if (cl.position.z > 2400) cl.position.z -= 4800;
            if (cl.position.z < -2400) cl.position.z += 4800;
          });
          BIRDS.forEach((b, i) => {
            const a = b.ph + T * b.sp;
            const cx = 200 + Math.sin(T * 0.05) * 60,
              cz = 220;
            b.b.position.set(cx + Math.cos(a) * b.r, b.h + Math.sin(T * 0.4 + i) * 4, cz + Math.sin(a) * b.r);
            b.b.rotation.y = -a;
            const flap = Math.sin(T * 9 + i * 1.3) * (Math.sin(T * 0.7 + i) > -0.3 ? 0.7 : 0.05);
            b.wl.rotation.z = flap;
            b.wr.rotation.z = -flap;
          });
          mastLight.visible = Math.floor(T * 1.2) % 2 === 0;
          for (let i = PUFFS.length - 1; i >= 0; i--) {
            const p = PUFFS[i];
            p.life += dt || 0.016;
            p.s.position.addScaledVector(p.v, dt || 0.016);
            p.v.multiplyScalar(0.96);
            const k = p.life / p.max;
            p.s.scale.setScalar(0.6 + k * 2.4);
            p.s.material.opacity = 0.8 * (1 - k);
            if (k >= 1) {
              scene.remove(p.s);
              PUFFS.splice(i, 1);
            }
          }
          // shadows follow what the camera is looking at
          const focus = att || S.pay.st === "attached" ? S.pos : S.pay.st === "falling" ? S.pay.pos : S.pos;
          // snap the shadow area to a grid so shadow edges do not shimmer as the drone moves
          {
            const fw = tmpV.copy(sunDir).negate();
            const rt = V3(0, 0, 0).crossVectors(fw, UPV).normalize();
            const up = V3(0, 0, 0).crossVectors(rt, fw).normalize();
            const texel = (sun.shadow.camera.right - sun.shadow.camera.left) / sun.shadow.mapSize.x;
            const a = focus.dot(rt),
              b = focus.dot(up);
            const snapped = focus.clone().addScaledVector(rt, Math.round(a / texel) * texel - a).addScaledVector(up, Math.round(b / texel) * texel - b);
            sun.target.position.copy(snapped);
            sun.position.copy(snapped).addScaledVector(sunDir, 400);
          }
          updateCamera(dt);
          skyMesh.position.copy(camera.position);
          glare.position.copy(camera.position).addScaledVector(sunDir, 4200);
        }
        function updateCamera(dt) {
          const mode = settings.cam;
          const k = vis.snapCam ? 1 : 1 - Math.exp(-(dt || 0.016) * 4);
          let fov = 55;
          const watchPay = S.pay.st === "falling" || S.pay.st === "sliding";
          const look = watchPay ? S.pay.pos.clone().add(V3(0, 0.3, 0)) : S.pos.clone();
          if (mode === "chase") {
            const hs = Math.hypot(S.vel.x, S.vel.z);
            const back = 9 + hs * 0.35;
            const f = V3(Math.sin(S.psi), 0, -Math.cos(S.psi));
            const want = S.pos.clone().addScaledVector(f, -back).add(V3(0, 3.6 + hs * 0.1, 0));
            if (VIEW.yaw || VIEW.pitch) {
              const off = want.clone().sub(S.pos);
              const r = off.length();
              const el = clamp(Math.atan2(off.y, Math.hypot(off.x, off.z)) + VIEW.pitch, -0.15, 1.45);
              const az = Math.atan2(off.x, off.z) + VIEW.yaw;
              want.set(S.pos.x + Math.sin(az) * Math.cos(el) * r, S.pos.y + Math.sin(el) * r, S.pos.z + Math.cos(az) * Math.cos(el) * r);
            }
            want.y = Math.max(want.y, groundH(want.x, want.z) + 1.2);
            {
              // walk from the drone out to the camera; stop just before the first solid thing
              const from = S.pos,
                n = 14;
              for (let i = 2; i <= n; i++) {
                const f = i / n,
                  px = from.x + (want.x - from.x) * f,
                  py = from.y + (want.y - from.y) * f,
                  pz = from.z + (want.z - from.z) * f;
                if (hitTest(px, pz, py - 0.4, py + 0.4, 0.45)) {
                  const g = Math.max(0.12, (i - 1.5) / n);
                  want.set(from.x + (want.x - from.x) * g, Math.max(from.y + (want.y - from.y) * g, groundH(px, pz) + 0.8), from.z + (want.z - from.z) * g);
                  break;
                }
              }
            }
            vis.camPos.lerp(want, k);
            vis.camLook.lerp(look, vis.snapCam ? 1 : 1 - Math.exp(-(dt || 0.016) * 7));
            camera.position.copy(vis.camPos);
            camera.up.copy(UPV);
            camera.lookAt(vis.camLook);
            fov = 55;
          } else if (mode === "top") {
            const h = 55 + S.pos.y * 0.5;
            const want = look.clone().add(V3(0, h, 0.001));
            vis.camPos.lerp(want, k);
            camera.position.copy(vis.camPos);
            camera.up.set(Math.sin(VIEW.yaw), 0, -Math.cos(VIEW.yaw));
            camera.lookAt(vis.camPos.x, 0, vis.camPos.z);
            fov = 50;
          } else if (mode === "cam") {
            camera.position.copy(S.pos).add(V3(Math.sin(S.psi) * 0.62, -0.3, -Math.cos(S.psi) * 0.62));
            camera.up.copy(UPV);
            camera.rotation.set(0, 0, 0);
            camera.quaternion.setFromEuler(new THREE.Euler(-50 * D2R + VIEW.pitch * -1, -S.psi + VIEW.yaw, 0, "YXZ"));
            fov = 72;
            vis.camPos.copy(camera.position);
          } else {
            camera.position.set(OPER.x, 1.7, OPER.z);
            camera.up.copy(UPV);
            vis.camLook.lerp(look, vis.snapCam ? 1 : 1 - Math.exp(-(dt || 0.016) * 6));
            camera.lookAt(vis.camLook);
            camera.rotateOnWorldAxis(UPV, VIEW.yaw);
            camera.rotateX(-VIEW.pitch);
            const d = camera.position.distanceTo(look);
            fov = clamp(2 * Math.atan(9 / Math.max(d, 1)) * R2D, 9, 60);
            vis.camPos.copy(camera.position);
          }
          vis.snapCam = false;
          if (Math.abs(camera.fov - fov) > 0.05) {
            camera.fov = lerp(camera.fov, fov, mode === "cam" ? 1 : 0.15);
            camera.updateProjectionMatrix();
          }
        }

        /* ================= mission map (top view): base image + live overlay ================= */
        const MAPE = 360; // the base image covers ±360 m
        const MAPPX = 1800;
        const mapImg = document.createElement("canvas");
        mapImg.width = mapImg.height = MAPPX;
        {
          const g = mapImg.getContext("2d");
          const s = MAPPX / (2 * MAPE);
          const X = (x) => (x + MAPE) * s,
            Z = (z) => (z + MAPE) * s;
          g.fillStyle = "#4f7a35";
          g.fillRect(0, 0, MAPPX, MAPPX);
          for (let i = 0; i < 2600; i++) {
            const x = Math.random() * MAPPX,
              y = Math.random() * MAPPX,
              r = 10 + Math.random() * 50;
            g.fillStyle = Math.random() < 0.5 ? "rgba(98,140,62,0.18)" : "rgba(64,100,40,0.16)";
            g.beginPath();
            g.arc(x, y, r, 0, TAU);
            g.fill();
          }
          const cropCol = ["#c8a752", "#7a5a3c", "#6e9f3d", "#cdbd47"];
          PATCHES.forEach((p) => {
            g.save();
            g.translate(X(p.x), Z(p.z));
            g.rotate(-p.rot);
            g.fillStyle = cropCol[p.type];
            g.fillRect((-p.w / 2) * s, (-p.d / 2) * s, p.w * s, p.d * s);
            g.strokeStyle = "rgba(0,0,0,0.12)";
            g.lineWidth = 2;
            for (let yy = -p.d / 2; yy < p.d / 2; yy += 5) {
              g.beginPath();
              g.moveTo((-p.w / 2) * s, yy * s);
              g.lineTo((p.w / 2) * s, yy * s);
              g.stroke();
            }
            g.restore();
          });
          // tracks
          g.strokeStyle = "#a99067";
          g.lineWidth = 3.4 * s;
          g.lineCap = "round";
          g.lineJoin = "round";
          [
            [[12, 6], [120, 8], [175, -40], [205, -55]],
            [[-12, 4], [-110, -20], [-170, -55]],
          ].forEach((L) => {
            g.beginPath();
            L.forEach(([x, z], i) => (i ? g.lineTo(X(x), Z(z)) : g.moveTo(X(x), Z(z))));
            g.stroke();
          });
          // lake and island
          g.fillStyle = "#d8c48c";
          g.beginPath();
          for (let i = 0; i <= 72; i++) {
            const a = (i / 72) * TAU,
              r = lakeR(a) * 1.08;
            const x = LAKE.x + Math.cos(a) * r,
              z = LAKE.z + Math.sin(a) * r;
            i ? g.lineTo(X(x), Z(z)) : g.moveTo(X(x), Z(z));
          }
          g.fill();
          g.fillStyle = "#2f6f8f";
          g.beginPath();
          for (let i = 0; i <= 72; i++) {
            const a = (i / 72) * TAU,
              r = lakeR(a);
            const x = LAKE.x + Math.cos(a) * r,
              z = LAKE.z + Math.sin(a) * r;
            i ? g.lineTo(X(x), Z(z)) : g.moveTo(X(x), Z(z));
          }
          g.fill();
          // island: beach outline, grassy top and the jetty
          const isl = (k) => {
            g.beginPath();
            for (let i = 0; i <= 72; i++) {
              const a = (i / 72) * TAU,
                r = islandR(a) * k;
              const x = LAKE.x + Math.cos(a) * r,
                z = LAKE.z + Math.sin(a) * r;
              i ? g.lineTo(X(x), Z(z)) : g.moveTo(X(x), Z(z));
            }
            g.fill();
          };
          g.fillStyle = "#e3cf98";
          isl(1);
          g.fillStyle = "#64a03c";
          isl(0.8);
          {
            const r0 = islandR(JETTY_A) - 1.2,
              x0 = LAKE.x + Math.cos(JETTY_A) * r0,
              z0 = LAKE.z + Math.sin(JETTY_A) * r0;
            g.strokeStyle = "#8a6744";
            g.lineWidth = Math.max(1.5, 1.7 * s);
            g.beginPath();
            g.moveTo(X(x0), Z(z0));
            g.lineTo(X(x0 + Math.cos(JETTY_A) * 9), Z(z0 + Math.sin(JETTY_A) * 9));
            g.stroke();
          }
          // trees: shadow then crown
          TREES.forEach((t) => {
            if (Math.abs(t.x) > MAPE + 10 || Math.abs(t.z) > MAPE + 10) return;
            const r = Math.max(2.2, t.h * (t.type === 2 ? 0.18 : 0.3)) * s;
            g.fillStyle = "rgba(0,0,0,0.25)";
            g.beginPath();
            g.arc(X(t.x) + r * 0.35, Z(t.z) + r * 0.35, r, 0, TAU);
            g.fill();
            g.fillStyle = t.type === 0 ? "#22492a" : t.type === 2 ? "#4c7a2c" : "#3a6b2a";
            g.beginPath();
            g.arc(X(t.x), Z(t.z), r, 0, TAU);
            g.fill();
            g.fillStyle = "rgba(255,255,255,0.08)";
            g.beginPath();
            g.arc(X(t.x) - r * 0.3, Z(t.z) - r * 0.3, r * 0.5, 0, TAU);
            g.fill();
          });
          // buildings
          HOUSES.forEach((hs) => {
            g.save();
            g.translate(X(hs.x), Z(hs.z));
            g.rotate(-hs.rot);
            g.fillStyle = "rgba(0,0,0,0.3)";
            g.fillRect((-hs.w / 2) * s + 4, (-hs.d / 2) * s + 4, hs.w * s, hs.d * s);
            g.fillStyle = hs.kind === "tent" ? "#" + hs.col.toString(16).padStart(6, "0") : "#" + (roofMats[hs.kind] || roofMats.house).toString(16).padStart(6, "0");
            g.fillRect((-hs.w / 2) * s, (-hs.d / 2) * s, hs.w * s, hs.d * s);
            g.strokeStyle = "rgba(255,255,255,0.35)";
            g.lineWidth = 2;
            g.beginPath();
            g.moveTo((-hs.w / 2) * s, 0);
            g.lineTo((hs.w / 2) * s, 0);
            g.stroke();
            if (hs.kind === "clinic") {
              g.fillStyle = "#ffffff";
              g.fillRect(-9, -9, 18, 18);
              g.fillStyle = "#d62f2f";
              g.fillRect(-3, -7, 6, 14);
              g.fillRect(-7, -3, 14, 6);
            }
            g.restore();
          });
          g.fillStyle = "#bfc5cc";
          g.beginPath();
          g.arc(X(SILO.x), Z(SILO.z), SILO.r * s, 0, TAU);
          g.fill();
          // base helipad
          g.fillStyle = "#3c4048";
          g.fillRect(X(-4.5), Z(-4.5), 9 * s, 9 * s);
          g.fillStyle = "#ffcc33";
          g.font = "900 " + Math.round(7 * s) + "px Arial";
          g.textAlign = "center";
          g.textBaseline = "middle";
          g.fillText("H", X(0), Z(0) + 1);
          g.fillStyle = "#ff6a1a";
          g.fillRect(X(-11.5), Z(4), 4.6 * s, 3.8 * s);
        }

        // world ↔ screen for a map view
        function mapView(w, h, cx, cz, s) {
          return { w, h, cx, cz, s, X: (x) => w / 2 + (x - cx) * s, Y: (z) => h / 2 + (z - cz) * s, wx: (px) => cx + (px - w / 2) / s, wz: (py) => cz + (py - h / 2) / s };
        }
        function refreshEstimates() {}

        function arrow(g, x1, y1, x2, y2, col, wdt, head) {
          const a = Math.atan2(y2 - y1, x2 - x1);
          g.strokeStyle = col;
          g.fillStyle = col;
          g.lineWidth = wdt;
          g.beginPath();
          g.moveTo(x1, y1);
          g.lineTo(x2 - Math.cos(a) * head * 0.6, y2 - Math.sin(a) * head * 0.6);
          g.stroke();
          g.beginPath();
          g.moveTo(x2, y2);
          g.lineTo(x2 - Math.cos(a - 0.45) * head, y2 - Math.sin(a - 0.45) * head);
          g.lineTo(x2 - Math.cos(a + 0.45) * head, y2 - Math.sin(a + 0.45) * head);
          g.closePath();
          g.fill();
        }
        // draw the whole map scene into a view (used by the big planning map and the mini-map)
        function drawMapScene(g, V, big) {
          const sImg = MAPPX / (2 * MAPE);
          const x0 = V.wx(0),
            z0 = V.wz(0),
            x1 = V.wx(V.w),
            z1 = V.wz(V.h);
          g.fillStyle = "#3d5f2b";
          g.fillRect(0, 0, V.w, V.h);
          g.drawImage(mapImg, (x0 + MAPE) * sImg, (z0 + MAPE) * sImg, (x1 - x0) * sImg, (z1 - z0) * sImg, 0, 0, V.w, V.h);
          const R = (m) => m * V.s;
          // no-fly zones
          MISSION.nfz.forEach((f) => {
            g.save();
            g.beginPath();
            g.arc(V.X(f.x), V.Y(f.z), R(f.r), 0, TAU);
            g.fillStyle = "rgba(248,113,113,0.22)";
            g.fill();
            g.clip();
            g.strokeStyle = "rgba(248,113,113,0.45)";
            g.lineWidth = 2;
            for (let k = -R(f.r) * 2; k < R(f.r) * 2; k += 10) {
              g.beginPath();
              g.moveTo(V.X(f.x) + k - R(f.r), V.Y(f.z) - R(f.r));
              g.lineTo(V.X(f.x) + k + R(f.r), V.Y(f.z) + R(f.r));
              g.stroke();
            }
            g.restore();
            g.strokeStyle = "#f87171";
            g.lineWidth = big ? 2.5 : 1.5;
            g.beginPath();
            g.arc(V.X(f.x), V.Y(f.z), R(f.r), 0, TAU);
            g.stroke();
            if (big) {
              g.font = "700 12px " + FONT_B;
              g.textAlign = "center";
              g.fillStyle = "#fff";
              g.strokeStyle = "rgba(0,0,0,0.7)";
              g.lineWidth = 3;
              const t = "NO-FLY · " + f.n;
              g.strokeText(t, V.X(f.x), V.Y(f.z));
              g.fillText(t, V.X(f.x), V.Y(f.z));
            }
          });
          // radio mast
          {
            const x = V.X(TOWER.x),
              y = V.Y(TOWER.z);
            g.fillStyle = "#e5484d";
            g.beginPath();
            g.moveTo(x, y - 8);
            g.lineTo(x + 6, y + 5);
            g.lineTo(x - 6, y + 5);
            g.closePath();
            g.fill();
            if (big) {
              g.font = "600 11px " + FONT_B;
              g.fillStyle = "#ffd5d5";
              g.textAlign = "left";
              g.fillText("mast " + TOWER.h + " m", x + 8, y + 4);
            }
          }
          // drop zones
          ZONES.forEach((z) => {
            const sel = PLAN.target === z.k;
            const r = sel ? MISSION.r : 6;
            const x = V.X(z.x),
              y = V.Y(z.z);
            g.lineWidth = sel ? 2.5 : 1.5;
            g.strokeStyle = sel ? "#ffb020" : "rgba(255,255,255,0.75)";
            g.fillStyle = sel ? "rgba(255,176,32,0.18)" : "rgba(255,255,255,0.08)";
            g.beginPath();
            g.arc(x, y, Math.max(R(r), sel ? 5 : 4), 0, TAU);
            g.fill();
            g.stroke();
            if (sel && big) {
              g.setLineDash([4, 4]);
              g.beginPath();
              g.arc(x, y, R(r * 2), 0, TAU);
              g.stroke();
              g.setLineDash([]);
            }
            if (big || sel) {
              g.font = (sel ? "700 " : "600 ") + (big ? 13 : 10) + "px " + FONT_B;
              g.textAlign = "center";
              g.strokeStyle = "rgba(0,0,0,0.75)";
              g.lineWidth = 3;
              const lab = (big ? z.ic + " " : "") + z.n + (sel && big ? " · " + MISSION.r + " m zone" : "");
              const ly = y + Math.max(R(r), 5) + (big ? 14 : 10);
              g.strokeText(lab, x, ly);
              g.fillStyle = sel ? "#ffd27a" : "#ffffff";
              g.fillText(lab, x, ly);
              if (big && MISSION.need === z.k && PLAN.target !== z.k) {
                g.fillStyle = "#fde047";
                g.strokeText("← mission target", x, ly + 14);
                g.fillText("← mission target", x, ly + 14);
              }
            }
          });
          // route
          if (PLAN.aim) {
            const chk = ROUTECHK || checkRoute();
            chk.segs.forEach((sg) => {
              g.strokeStyle = sg.bad === "nfz" || (sg.bad === "obst" && sg.minC < 0.5) ? "#f87171" : sg.bad ? "#fbbf24" : "#7cc4ff";
              g.lineWidth = big ? 3 : 1.8;
              g.setLineDash(PLAN.mode === "manual" ? [6, 5] : []);
              g.globalAlpha = PLAN.mode === "manual" ? 0.7 : 1;
              g.beginPath();
              g.moveTo(V.X(sg.a.x), V.Y(sg.a.z));
              g.lineTo(V.X(sg.b.x), V.Y(sg.b.z));
              g.stroke();
              g.globalAlpha = 1;
              if (big) {
                const mx = (V.X(sg.a.x) + V.X(sg.b.x)) / 2,
                  my = (V.Y(sg.a.z) + V.Y(sg.b.z)) / 2;
                const a = Math.atan2(V.Y(sg.b.z) - V.Y(sg.a.z), V.X(sg.b.x) - V.X(sg.a.x));
                g.fillStyle = g.strokeStyle;
                g.beginPath();
                g.moveTo(mx + Math.cos(a) * 6, my + Math.sin(a) * 6);
                g.lineTo(mx + Math.cos(a + 2.5) * 6, my + Math.sin(a + 2.5) * 6);
                g.lineTo(mx + Math.cos(a - 2.5) * 6, my + Math.sin(a - 2.5) * 6);
                g.fill();
              }
            });
            g.setLineDash([]);
          }
          // wind arrows (big map)
          if (big && MISSION.wind.spd) {
            const wv = windMean(ALT[PLAN.alt].h);
            const sp = wv.length();
            const step = 90;
            const gx0 = Math.floor(V.wx(0) / step) * step,
              gz0 = Math.floor(V.wz(0) / step) * step;
            for (let x = gx0; x < V.wx(V.w) + step; x += step)
              for (let z = gz0; z < V.wz(V.h) + step; z += step) {
                const w = windAt(x, ALT[PLAN.alt].h, z, S.t || performance.now() / 1000);
                const L = 12 + w.length() * 5;
                const px = V.X(x + 45),
                  py = V.Y(z + 45);
                const d = w.length() || 1;
                arrow(g, px - (w.x / d) * L * 0.5, py - (w.z / d) * L * 0.5, px + (w.x / d) * L * 0.5, py + (w.z / d) * L * 0.5, "rgba(196,181,253,0.55)", 2, 8);
              }
            void sp;
          }
          // base
          {
            const x = V.X(BASE.x),
              y = V.Y(BASE.z);
            if (big) {
              g.font = "700 12px " + FONT_B;
              g.fillStyle = "#ffffff";
              g.textAlign = "center";
              g.strokeStyle = "rgba(0,0,0,0.75)";
              g.lineWidth = 3;
              g.strokeText("BASE", x, y + 16);
              g.fillText("BASE", x, y + 16);
            }
          }
          // waypoints and the drop point
          PLAN.wps.forEach((w, i) => {
            const x = V.X(w.x),
              y = V.Y(w.z);
            const hov = big && MAPUI.hover && MAPUI.hover.k === "wp" && MAPUI.hover.i === i;
            g.fillStyle = hov ? "#ffffff" : "#7cc4ff";
            g.strokeStyle = "#0b1220";
            g.lineWidth = 2;
            g.beginPath();
            g.arc(x, y, big ? 9 : 3, 0, TAU);
            g.fill();
            g.stroke();
            if (big) {
              g.fillStyle = "#0b1220";
              g.font = "700 11px " + FONT_M;
              g.textAlign = "center";
              g.textBaseline = "middle";
              g.fillText(String(i + 1), x, y + 0.5);
              g.textBaseline = "alphabetic";
            }
          });
          if (PLAN.aim) {
            const x = V.X(PLAN.aim.x),
              y = V.Y(PLAN.aim.z);
            const r = big ? 9 : 4;
            g.strokeStyle = "#fde047";
            g.lineWidth = big ? 2.5 : 1.5;
            g.beginPath();
            g.arc(x, y, r, 0, TAU);
            g.moveTo(x - r - 4, y);
            g.lineTo(x + r + 4, y);
            g.moveTo(x, y - r - 4);
            g.lineTo(x, y + r + 4);
            g.stroke();
          }
          // live: trail, payload, predicted landing, drone
          if (S.trail.length > 1) {
            g.strokeStyle = "rgba(255,255,255,0.85)";
            g.lineWidth = big ? 2 : 1.2;
            g.beginPath();
            S.trail.forEach((p, i) => (i ? g.lineTo(V.X(p.x), V.Y(p.z)) : g.moveTo(V.X(p.x), V.Y(p.z))));
            g.stroke();
          }
          if (S.release) {
            g.fillStyle = "#f472b6";
            g.beginPath();
            g.arc(V.X(S.release.x), V.Y(S.release.z), big ? 4 : 2.5, 0, TAU);
            g.fill();
          }
          if (S.pay.st === "falling" || S.pay.st === "sliding" || S.pay.st === "landed" || S.pay.st === "lost") {
            const p = S.pay.pos;
            if (S.pay.land && !S.pay.land.wet) {
              const z = tgtZone();
              g.setLineDash([4, 3]);
              g.strokeStyle = "#ff3b6b";
              g.lineWidth = 1.5;
              g.beginPath();
              g.moveTo(V.X(z.x), V.Y(z.z));
              g.lineTo(V.X(p.x), V.Y(p.z));
              g.stroke();
              g.setLineDash([]);
              if (big) {
                g.font = "700 13px " + FONT_M;
                g.fillStyle = "#ffd0dc";
                g.textAlign = "left";
                g.strokeStyle = "rgba(0,0,0,0.75)";
                g.lineWidth = 3;
                const t = S.pay.land.d.toFixed(1) + " m";
                g.strokeText(t, V.X(p.x) + 9, V.Y(p.z) - 6);
                g.fillText(t, V.X(p.x) + 9, V.Y(p.z) - 6);
              }
            }
            g.fillStyle = S.pay.st === "lost" ? "#7cc4ff" : "#ff3b6b";
            g.strokeStyle = "#ffffff";
            g.lineWidth = 1.5;
            g.beginPath();
            g.rect(V.X(p.x) - 4, V.Y(p.z) - 4, 8, 8);
            g.fill();
            g.stroke();
          }
          {
            const x = V.X(S.pos.x),
              y = V.Y(S.pos.z);
            const a = S.psi;
            const sz = big ? 11 : 7;
            g.save();
            g.translate(x, y);
            g.rotate(a);
            g.fillStyle = S.crashed ? "#f87171" : "#ffffff";
            g.strokeStyle = "#0b1220";
            g.lineWidth = 2;
            g.beginPath();
            g.moveTo(0, -sz);
            g.lineTo(sz * 0.7, sz * 0.7);
            g.lineTo(0, sz * 0.35);
            g.lineTo(-sz * 0.7, sz * 0.7);
            g.closePath();
            g.fill();
            g.stroke();
            g.restore();
          }
        }
        let ROUTECHK = null;

        /* ---------- the big planning map ---------- */
        const planCv = $("plan");
        const pg = planCv.getContext("2d");
        const MAPUI = { cx: -20, cz: -60, s: 1, fit: true, hover: null, drag: null };
        let PW = 1,
          PH = 1;
        function fitMap() {
          MAPUI.s = Math.min(PW, PH) / (2 * MAP_HALF * 1.0);
          MAPUI.cx = -10;
          MAPUI.cz = -45;
          MAPUI.fit = true;
        }
        function clampMap() {
          const minS = Math.min(PW, PH) / (2 * MAPE);
          MAPUI.s = clamp(MAPUI.s, minS, 14);
          const hx = PW / 2 / MAPUI.s,
            hz = PH / 2 / MAPUI.s;
          MAPUI.cx = clamp(MAPUI.cx, -MAPE + hx, MAPE - hx);
          MAPUI.cz = clamp(MAPUI.cz, -MAPE + hz, MAPE - hz);
        }
        function planV() {
          return mapView(PW, PH, MAPUI.cx, MAPUI.cz, MAPUI.s);
        }
        function drawPlan() {
          const dpr = Math.min(window.devicePixelRatio || 1, 2);
          pg.setTransform(dpr, 0, 0, dpr, 0, 0);
          const V = planV();
          drawMapScene(pg, V, true);
          // compass and scale
          pg.fillStyle = "rgba(8,13,26,0.82)";
          pg.fillRect(PW - 56, 10, 46, 46);
          pg.fillStyle = "#fff";
          pg.font = "700 13px " + FONT_B;
          pg.textAlign = "center";
          pg.fillText("N", PW - 33, 26);
          arrow(pg, PW - 33, 50, PW - 33, 30, "#ffffff", 2, 7);
          const sb = MAPUI.s > 3 ? 20 : MAPUI.s > 1.2 ? 50 : 100;
          pg.fillStyle = "rgba(8,13,26,0.82)";
          pg.fillRect(PW - 56 - sb * MAPUI.s - 18, 60, sb * MAPUI.s + 64, 24);
          pg.strokeStyle = "#fff";
          pg.lineWidth = 2;
          pg.beginPath();
          pg.moveTo(PW - 46 - sb * MAPUI.s, 76);
          pg.lineTo(PW - 46, 76);
          pg.stroke();
          pg.font = "600 11px " + FONT_M;
          pg.fillStyle = "#fff";
          pg.textAlign = "right";
          pg.fillText(sb + " m", PW - 12, 77);
          // wind box
          const W = MISSION.wind;
          pg.textAlign = "left";
          pg.fillStyle = "rgba(8,13,26,0.82)";
          pg.fillRect(PW - 196, 90, 186, 26);
          pg.fillStyle = W.spd ? "#e9e3ff" : "#a9b4cf";
          pg.font = "700 12.5px " + FONT_B;
          pg.fillText(W.spd ? "Wind " + windMean(ALT[PLAN.alt].h).length().toFixed(1) + " m/s at " + ALT[PLAN.alt].h + " m, from " + CARD(W.from) : "Wind: calm", PW - 186, 107);
          // hover tooltip
          const hv = MAPUI.hover;
          if (hv && hv.tip && !S.started) {
            pg.font = "600 12.5px " + FONT_B;
            const tw = pg.measureText(hv.tip).width + 14;
            const tx = clamp(hv.px + 14, 4, PW - tw - 4),
              ty = clamp(hv.py + 18, 4, PH - 26);
            pg.fillStyle = "rgba(8,13,26,0.92)";
            pg.fillRect(tx, ty, tw, 22);
            pg.fillStyle = "#edf1fb";
            pg.fillText(hv.tip, tx + 7, ty + 15);
          }
        }
        // what is under the mouse on the map?
        function mapHit(px, py) {
          const V = planV();
          for (let i = PLAN.wps.length - 1; i >= 0; i--) if (Math.hypot(V.X(PLAN.wps[i].x) - px, V.Y(PLAN.wps[i].z) - py) < 11) return { k: "wp", i, tip: "Waypoint " + (i + 1) + ": drag to move, right-click to remove" };
          if (PLAN.aim && Math.hypot(V.X(PLAN.aim.x) - px, V.Y(PLAN.aim.z) - py) < 12) return { k: "aim", tip: "Drop point: drag it (upwind in a crosswind)" };
          for (const z of ZONES) {
            const r = Math.max(14, (PLAN.target === z.k ? MISSION.r : 6) * V.s);
            if (Math.hypot(V.X(z.x) - px, V.Y(z.z) - py) < r) return { k: "zone", z, tip: PLAN.target === z.k ? z.n + " (selected)" : "Click to choose " + z.n + " as the drop zone" };
          }
          // near a route line: insert a waypoint there
          if (PLAN.aim) {
            const pts = routePts();
            for (let i = 1; i < pts.length; i++) {
              const ax = V.X(pts[i - 1].x),
                ay = V.Y(pts[i - 1].z),
                bx = V.X(pts[i].x),
                by = V.Y(pts[i].z);
              const L2 = (bx - ax) ** 2 + (by - ay) ** 2 || 1;
              const k = clamp(((px - ax) * (bx - ax) + (py - ay) * (by - ay)) / L2, 0, 1);
              if (Math.hypot(ax + (bx - ax) * k - px, ay + (by - ay) * k - py) < 7 && k > 0.05 && k < 0.95) return { k: "seg", i, tip: "Click to add a waypoint here" };
            }
          }
          return { k: "empty", tip: PLAN.target ? "Click to add waypoint " + (PLAN.wps.length + 1) : "Pick a drop zone first (click one)" };
        }
        const planLocked = () => S.started || GAME.demo;
        function planChanged() {
          ROUTECHK = checkRoute();
          refreshEstimates();
          buildRoute3D();
          updatePlanUI();
        }
        planCv.addEventListener("contextmenu", (e) => e.preventDefault());
        planCv.addEventListener("pointerdown", (e) => {
          const r = planCv.getBoundingClientRect();
          const px = e.clientX - r.left,
            py = e.clientY - r.top;
          planCv.setPointerCapture(e.pointerId);
          const hit = mapHit(px, py);
          if (e.button === 2) {
            if (hit.k === "wp" && !planLocked()) {
              PLAN.wps.splice(hit.i, 1);
              flash.Backspace = performance.now();
              planChanged();
            }
            return;
          }
          MAPUI.drag = { hit, x: px, y: py, cx: MAPUI.cx, cz: MAPUI.cz, moved: false };
        });
        planCv.addEventListener("pointermove", (e) => {
          const r = planCv.getBoundingClientRect();
          const px = e.clientX - r.left,
            py = e.clientY - r.top;
          const D = MAPUI.drag;
          if (!D) {
            const h = mapHit(px, py);
            MAPUI.hover = Object.assign(h, { px, py });
            planCv.classList.toggle("over", h.k !== "empty");
            return;
          }
          if (Math.hypot(px - D.x, py - D.y) > 4) D.moved = true;
          if (!D.moved) return;
          const V = planV();
          const locked = planLocked();
          if (D.hit.k === "wp" && !locked) {
            PLAN.wps[D.hit.i].x = clamp(V.wx(px), -MAP_HALF, MAP_HALF);
            PLAN.wps[D.hit.i].z = clamp(V.wz(py), -MAP_HALF, MAP_HALF);
            planChanged();
          } else if (D.hit.k === "aim" && !locked) {
            const z = tgtZone();
            let ax = V.wx(px) - z.x,
              az = V.wz(py) - z.z;
            const d = Math.hypot(ax, az);
            if (d > 40) (ax *= 40 / d), (az *= 40 / d);
            PLAN.aim.x = z.x + ax;
            PLAN.aim.z = z.z + az;
            planChanged();
          } else {
            planCv.classList.add("grab");
            MAPUI.cx = D.cx - (px - D.x) / MAPUI.s;
            MAPUI.cz = D.cz - (py - D.y) / MAPUI.s;
            MAPUI.fit = false;
            clampMap();
          }
          MAPUI.hover = null;
        });
        planCv.addEventListener("pointerup", (e) => {
          const D = MAPUI.drag;
          MAPUI.drag = null;
          planCv.classList.remove("grab");
          if (!D || D.moved) return;
          const r = planCv.getBoundingClientRect();
          const px = e.clientX - r.left,
            py = e.clientY - r.top;
          const V = planV();
          const h = D.hit;
          if (h.k === "zone") return selectTarget(h.z.k);
          if (planLocked()) {
            if (h.k === "empty" || h.k === "seg") toast(GAME.demo ? "The demo is flying. Stop the demo to plan your own mission." : "The plan is locked during the flight. Press Retry to change it.", "info", "lock", 2);
            return;
          }
          if (h.k === "seg") {
            PLAN.wps.splice(h.i - 0, 0, { x: V.wx(px), z: V.wz(py) });
            planChanged();
          } else if (h.k === "empty") {
            if (!PLAN.target) return toast("Pick a drop zone first: click one of the zones on the map.", "info", "pickz", 2);
            if (PLAN.wps.length >= 9) return toast("That's plenty of waypoints: 9 is the limit.", "info", "wpmax", 2);
            PLAN.wps.push({ x: clamp(V.wx(px), -MAP_HALF, MAP_HALF), z: clamp(V.wz(py), -MAP_HALF, MAP_HALF) });
            sfx.init();
            sfx.beep(990, 0.05);
            planChanged();
          }
        });
        planCv.addEventListener("pointerleave", () => (MAPUI.hover = null));
        planCv.addEventListener(
          "wheel",
          (e) => {
            e.preventDefault();
            const r = planCv.getBoundingClientRect();
            const px = e.clientX - r.left,
              py = e.clientY - r.top;
            const V = planV();
            const wx = V.wx(px),
              wz = V.wz(py);
            MAPUI.s *= e.deltaY < 0 ? 1.18 : 1 / 1.18;
            clampMap();
            MAPUI.cx = wx - (px - PW / 2) / MAPUI.s;
            MAPUI.cz = wz - (py - PH / 2) / MAPUI.s;
            MAPUI.fit = false;
            clampMap();
          },
          { passive: false },
        );
        const zoomBy = (k) => {
          MAPUI.s *= k;
          MAPUI.fit = false;
          clampMap();
        };
        $("zoomIn").addEventListener("click", () => zoomBy(1.4));
        $("zoomOut").addEventListener("click", () => zoomBy(1 / 1.4));
        $("zoomFit").addEventListener("click", () => {
          fitMap();
          clampMap();
        });

        /* ================= HUD over the 3D view: altitude meter, readouts, mini-map ================= */
        const hud = $("hud");
        const hx = hud.getContext("2d");
        let HW = 1,
          HH = 1;
        function resize() {
          const r = wrapEl.getBoundingClientRect();
          HW = Math.max(1, r.width);
          HH = Math.max(1, r.height);
          PW = HW;
          PH = HH;
          const dpr = Math.min(window.devicePixelRatio || 1, 2);
          renderer.setSize(HW, HH, false);
          camera.aspect = HW / HH;
          camera.updateProjectionMatrix();
          hud.width = Math.round(HW * dpr);
          hud.height = Math.round(HH * dpr);
          planCv.width = Math.round(PW * dpr);
          planCv.height = Math.round(PH * dpr);
          if (MAPUI.fit) fitMap();
          clampMap();
        }
        new ResizeObserver(resize).observe(wrapEl);
        function box(g, x, y, w, h) {
          g.fillStyle = "rgba(8,13,26,0.8)";
          g.strokeStyle = "rgba(190,205,255,0.16)";
          g.lineWidth = 1;
          g.beginPath();
          if (g.roundRect) g.roundRect(x, y, w, h, 9);
          else g.rect(x, y, w, h);
          g.fill();
          g.stroke();
        }
        function drawHUD() {
          const dpr = Math.min(window.devicePixelRatio || 1, 2);
          hx.setTransform(dpr, 0, 0, dpr, 0, 0);
          hx.clearRect(0, 0, HW, HH);
          if (settings.view === "map") return;
          const g = hx;
          // mini-map (top right, north up, follows the drone)
          const ms = Math.min(190, HW * 0.28);
          const mx = HW - ms - 10,
            my = 10;
          g.save();
          box(g, mx - 2, my - 2, ms + 4, ms + 4);
          g.beginPath();
          g.rect(mx, my, ms, ms);
          g.clip();
          g.translate(mx, my);
          const scale = ms / 260;
          const cx = clamp(S.pos.x, -MAPE + 130, MAPE - 130),
            cz = clamp(S.pos.z, -MAPE + 130, MAPE - 130);
          drawMapScene(g, mapView(ms, ms, cx, cz, scale), false);
          g.restore();
          g.font = "700 10.5px " + FONT_B;
          g.fillStyle = "#cfd8ee";
          g.textAlign = "left";
          g.fillText("MAP · N ↑", mx + 6, my + 14);
          if (MISSION.wind.spd) {
            const w = windMean(S.pos.y || 10);
            const d = w.length() || 1;
            arrow(g, mx + ms - 34 - (w.x / d) * 12, my + 22 - (w.z / d) * 12, mx + ms - 34 + (w.x / d) * 12, my + 22 + (w.z / d) * 12, "#c4b5fd", 2.5, 8);
            g.textAlign = "right";
            g.fillStyle = "#e9e3ff";
            g.fillText(d.toFixed(1) + " m/s", mx + ms - 6, my + 46);
          }
          // altitude meter (left)
          const ah = Math.min(230, HH * 0.42);
          const ax = 12,
            ay = HH - ah - 24;
          box(g, ax, ay - 26, 74, ah + 44);
          g.font = "700 10.5px " + FONT_B;
          g.fillStyle = "#cfd8ee";
          g.textAlign = "left";
          g.fillText("ALTITUDE", ax + 8, ay - 10);
          const top = 50;
          const AY = (m) => ay + ah - (clamp(m, 0, top) / top) * ah;
          g.fillStyle = "rgba(255,255,255,0.08)";
          g.fillRect(ax + 10, ay, 14, ah);
          g.font = "600 10px " + FONT_M;
          for (let m = 0; m <= top; m += 10) {
            g.fillStyle = "rgba(255,255,255,0.5)";
            g.fillRect(ax + 24, AY(m) - 0.5, 6, 1);
            g.fillText(String(m), ax + 33, AY(m) + 3);
          }
          for (const k of ["low", "med", "high"]) {
            const y = AY(ALT[k].h);
            g.fillStyle = PLAN.alt === k ? "#fde047" : "rgba(253,224,71,0.35)";
            g.fillRect(ax + 8, y - 1, 18, 2);
            g.font = "700 9.5px " + FONT_B;
            g.fillText(ALT[k].n[0], ax + 55, y + 3);
          }
          const ycur = AY(altNow());
          g.fillStyle = "#7cc4ff";
          g.fillRect(ax + 10, ycur, 14, ay + ah - ycur);
          g.fillStyle = "#ffffff";
          g.beginPath();
          g.moveTo(ax + 6, ycur);
          g.lineTo(ax + 0, ycur - 5);
          g.lineTo(ax + 0, ycur + 5);
          g.fill();
          g.font = "700 13px " + FONT_M;
          g.fillStyle = "#ffffff";
          g.fillText(altNow().toFixed(1) + " m", ax + 8, ay + ah + 15);
          // readouts strip (bottom)
          const manual = PLAN.mode === "manual";
          const hsNow = Math.hypot(S.vel.x, S.vel.z);
          const PAYN = { attached: "In claws", falling: "Falling", sliding: "Sliding", landed: "Delivered", lost: "Lost" };
          const items = [
            ["MOTORS", S.armed ? "ARMED" : "OFF", manual ? "Manual · " + ASSIST[PLAN.assist].n : "Autopilot"],
            ["SPEED", hsNow.toFixed(1) + " m/s", manual ? "climb " + (S.vel.y >= 0 ? "+" : "") + S.vel.y.toFixed(1) : SPD[PLAN.spd].n + " " + SPD[PLAN.spd].v],
            ["BATTERY", Math.round(S.bat * 100) + "%", S.bat < 0.25 ? "low" : "ok"],
            ["PAYLOAD", PAYN[S.pay.st], itemName()],
            ["TO DROP", PLAN.aim ? Math.round(Math.hypot(S.pos.x - PLAN.aim.x, S.pos.z - PLAN.aim.z)) + " m" : "—", "horizontal"],
          ];
          if (manual) items.push(["STOP DIST", ((hsNow * hsNow) / (2 * brakeA(S.pay.st === "attached"))).toFixed(1) + " m", "after letting go"]);
          const bw = Math.min(124, (HW - 120 - 20) / items.length - 8);
          const big2 = bw >= 100;
          const bx0 = Math.max(100, HW / 2 - (items.length * (bw + 8)) / 2);
          items.forEach(([k, v, s2], i) => {
            const x = bx0 + i * (bw + 8),
              y = HH - 64;
            box(g, x, y, bw, 54);
            g.textAlign = "left";
            g.font = "700 " + (big2 ? 10.5 : 9.5) + "px " + FONT_B;
            g.fillStyle = "#a9b4cf";
            g.fillText(k, x + 8, y + 15);
            g.font = "700 " + (big2 ? 15 : 13) + "px " + FONT_M;
            g.fillStyle =
              k === "MOTORS" ? (S.armed ? "#34d399" : "#a9b4cf") : k === "PAYLOAD" ? (S.pay.st === "attached" ? "#7cc4ff" : S.pay.st === "falling" || S.pay.st === "sliding" ? "#f472b6" : S.pay.st === "lost" ? "#f87171" : "#34d399") : k === "BATTERY" && S.bat < 0.25 ? "#f87171" : "#ffffff";
            g.fillText(v, x + 8, y + 34);
            g.font = "600 " + (big2 ? 10.5 : 9.5) + "px " + FONT_B;
            g.fillStyle = "#7f8bab";
            g.fillText(s2, x + 8, y + 48, bw - 12);
          });
          // drone cam: crosshair
          if (settings.cam === "cam") {
            g.strokeStyle = "rgba(255,255,255,0.75)";
            g.lineWidth = 1.5;
            const cx2 = HW / 2,
              cy2 = HH / 2;
            g.beginPath();
            g.arc(cx2, cy2, 22, 0, TAU);
            g.moveTo(cx2 - 36, cy2);
            g.lineTo(cx2 - 12, cy2);
            g.moveTo(cx2 + 12, cy2);
            g.lineTo(cx2 + 36, cy2);
            g.moveTo(cx2, cy2 - 36);
            g.lineTo(cx2, cy2 - 12);
            g.moveTo(cx2, cy2 + 12);
            g.lineTo(cx2, cy2 + 36);
            g.stroke();
            g.font = "700 11px " + FONT_B;
            g.fillStyle = "#fff";
            g.fillText("DRONE CAM · looking 50° down", cx2, cy2 + 56);
          }
        }

        /* ================= sound (synthesised, no files) ================= */
        const sfx = (() => {
          let ctx = null,
            master,
            motorG,
            o1,
            o2,
            lp,
            hornG,
            hornO;
          function init() {
            if (ctx) {
              ctx.resume();
              return;
            }
            try {
              ctx = new (window.AudioContext || window.webkitAudioContext)();
            } catch (e) {
              return;
            }
            master = ctx.createGain();
            master.gain.value = settings.sound ? settings.volume : 0;
            master.connect(ctx.destination);
            lp = ctx.createBiquadFilter();
            lp.type = "lowpass";
            lp.frequency.value = 900;
            motorG = ctx.createGain();
            motorG.gain.value = 0;
            o1 = ctx.createOscillator();
            o1.type = "sawtooth";
            o2 = ctx.createOscillator();
            o2.type = "square";
            o1.connect(lp);
            o2.connect(lp);
            lp.connect(motorG);
            motorG.connect(master);
            o1.start();
            o2.start();
            hornO = ctx.createOscillator();
            hornO.type = "square";
            hornO.frequency.value = 760;
            hornG = ctx.createGain();
            hornG.gain.value = 0;
            hornO.connect(hornG);
            hornG.connect(master);
            hornO.start();
            const n = ctx.sampleRate * 2,
              nb = ctx.createBuffer(1, n, ctx.sampleRate),
              d = nb.getChannelData(0);
            for (let i = 0; i < n; i++) d[i] = Math.random() * 2 - 1;
            airSrc = ctx.createBufferSource();
            airSrc.buffer = nb;
            airSrc.loop = true;
            airBp = ctx.createBiquadFilter();
            airBp.type = "bandpass";
            airBp.Q.value = 0.7;
            airG = ctx.createGain();
            airG.gain.value = 0;
            airSrc.connect(airBp);
            airBp.connect(airG);
            airG.connect(master);
            airSrc.start();
          }
          let airSrc, airBp, airG;
          function air(V, ground, on) {
            if (!ctx) return;
            const t = ctx.currentTime;
            const k = clamp(V / 22, 0, 1.2);
            airBp.frequency.setTargetAtTime(ground ? 250 + V * 30 : 500 + V * 70, t, 0.1);
            airG.gain.setTargetAtTime(on ? (ground ? (V > 0.5 ? 0.05 + k * 0.08 : 0) : k * k * 0.1) : 0, t, 0.15);
          }
          function motor(thr, V, on) {
            if (!ctx) return;
            const t = ctx.currentTime;
            const f = 60 + thr * 210 + V * 2.5;
            o1.frequency.setTargetAtTime(f, t, 0.08);
            o2.frequency.setTargetAtTime(f * 1.5, t, 0.08);
            lp.frequency.setTargetAtTime(500 + thr * 1500, t, 0.1);
            motorG.gain.setTargetAtTime(on ? 0.025 + thr * 0.05 : 0, t, 0.1);
          }
          let hornOn = false;
          function horn(on) {
            if (!ctx) return;
            const want = on && S.running && !S.paused;
            if (want === hornOn && !want) return;
            hornOn = want;
            const t = ctx.currentTime;
            const g = want ? (Math.floor(t * 4) % 2 ? 0.035 : 0) : 0;
            hornG.gain.setTargetAtTime(g, t, 0.01);
          }
          function beep(f, d) {
            if (!ctx) return;
            const o = ctx.createOscillator(),
              g = ctx.createGain(),
              t = ctx.currentTime;
            o.type = "triangle";
            o.frequency.value = f;
            g.gain.setValueAtTime(0.08, t);
            g.gain.exponentialRampToValueAtTime(0.001, t + d);
            o.connect(g);
            g.connect(master);
            o.start(t);
            o.stop(t + d);
          }
          function chime() {
            beep(880, 0.18);
            setTimeout(() => beep(1320, 0.22), 110);
          }
          function noise(d, vol, freq) {
            if (!ctx) return;
            const n = Math.floor(ctx.sampleRate * d);
            const buf = ctx.createBuffer(1, n, ctx.sampleRate);
            const a = buf.getChannelData(0);
            for (let i = 0; i < n; i++) a[i] = (Math.random() * 2 - 1) * (1 - i / n) ** 2;
            const s = ctx.createBufferSource(),
              f = ctx.createBiquadFilter(),
              g = ctx.createGain();
            s.buffer = buf;
            f.type = "lowpass";
            f.frequency.value = freq;
            g.gain.value = vol;
            s.connect(f);
            f.connect(g);
            g.connect(master);
            s.start();
          }
          return {
            init,
            air,
            motor,
            horn,
            beep,
            chime,
            crash: () => noise(1.2, 0.5, 900),
            thud: (v) => noise(0.25, v, 400),
            clunk: () => {
              noise(0.12, 0.3, 1600);
              beep(180, 0.09);
            },
            setVolume: (v) => {
              if (master) master.gain.setTargetAtTime(v, ctx.currentTime, 0.03);
            },
            suspend: (s) => {
              if (ctx) s ? ctx.suspend() : ctx.resume();
            },
          };
        })();

        /* ================= toasts, banner, log ================= */
        function toast(msg, kind, key, cooldown) {
          const now = performance.now() / 1000;
          if (key) {
            if (S.cool[key] && now - S.cool[key] < cooldown) return;
            S.cool[key] = now;
          }
          const box = $("toasts");
          const el = document.createElement("div");
          el.className = "toast " + (kind || "");
          el.textContent = msg;
          box.appendChild(el);
          while (box.children.length > 3) box.removeChild(box.firstChild);
          setTimeout(() => el.remove(), 4200);
        }
        function clearLog() {
          $("log").innerHTML = '<li class="empty" style="display:block;border:0">Events appear here during the mission.</li>';
        }
        function addLog(text, kind) {
          S.log.push({ t: S.t, text, kind });
          const ul = $("log");
          const em = ul.querySelector(".empty");
          if (em) em.remove();
          const li = document.createElement("li");
          li.className = kind || "";
          li.innerHTML = "<b>" + fmtT(S.t) + "</b><span></span>";
          li.querySelector("span").textContent = text;
          ul.prepend(li);
        }
        let bannerState = "";
        function updateBanner() {
          let k = "",
            t = "",
            s = "",
            cls = "";
          if (S.crashed) (k = "crash"), (t = "CRASHED"), (s = S.reason);
          else if (S.dropFail) (k = "drop"), (t = "DROP FAILED"), (s = S.dropFail.charAt(0).toUpperCase() + S.dropFail.slice(1) + ". Mission over.");
          else if (S.failed && !/aborted/.test(S.failed)) (k = "fail"), (t = /no-fly|area/.test(S.failed) ? "GEOFENCE" : "BATTERY EMPTY"), (s = S.failed + ". The drone is landing where it is.");
          else if (flying() && S.bat < 0.15) (k = "bat"), (t = "LOW BATTERY"), (s = "Returning soon."), (cls = "warn");
          if (k !== bannerState) {
            bannerState = k;
            $("banner").className = "banner" + (k ? " show " + cls : "");
            $("bannerT").textContent = t;
            $("bannerS").textContent = s;
          }
          wrapEl.classList.toggle("al-fail", k === "crash" || k === "fail" || k === "drop");
          wrapEl.classList.toggle("al-warn", k === "bat");
        }

        /* ================= mission set-up ================= */
        function toggleSet(id, v) {
          $(id).querySelectorAll("button").forEach((b) => b.classList.toggle("on", b.dataset.v === String(v)));
        }
        function bindToggle(id, cb) {
          $(id).addEventListener("click", (e) => {
            const b = e.target.closest("button");
            if (!b || b.disabled) return;
            cb(b.dataset.v);
          });
        }
        // set a plan value, respecting mission locks and the in-flight lock
        function setPlan(key, v, quiet) {
          if (MISSION.lock[key] && MISSION.lock[key] !== v) {
            if (!quiet) toast("This mission fixes the " + { alt: "altitude", spd: "speed", pay: "payload", mode: "flight mode", assist: "flight assist" }[key] + " 🔒", "info", "lk" + key, 1.5);
            return;
          }
          // in the air: switch to Manual takes control; the assist switch works like a real flight-mode switch
          if (key === "mode" && S.started && !S.ended && !GAME.demo && v === "manual" && PLAN.mode === "auto") return takeOver("T");
          if (key === "assist" && S.started && !S.ended && !GAME.demo) {
            PLAN.assist = v;
            S.hold.on = S.hold.yOn = false;
            if (v === "off") S.in.thr = hoverThr();
            addLog("Flight assist: " + ASSIST[v].n, "");
            planChanged();
            return;
          }
          if (planLocked() && !quiet) {
            toast(GAME.demo ? "The demo is flying. Stop the demo to change the plan." : "The plan is locked during the flight. Press Retry to change it.", "info", "lock", 2);
            return;
          }
          PLAN[key] = v;
          if (key === "pay") setParcel();
          if (key === "mode" || key === "assist") S.in.thr = thrRest();
          planChanged();
        }
        // throttle that just holds a hover with assist off (used when switching modes in the air)
        const hoverThr = () => clamp(((DRONES[PLAN.drone].m + (S.pay.st === "attached" ? curPay().m : 0)) * G) / DRONES[PLAN.drone].thrust, 0, 1);
        bindToggle("altToggle", (v) => setPlan("alt", v));
        bindToggle("spdToggle", (v) => setPlan("spd", v));
        bindToggle("payToggle", (v) => setPlan("pay", v));
        bindToggle("dropToggle", (v) => setPlan("mode", v));
        bindToggle("assistToggle", (v) => setPlan("assist", v));
        bindToggle("drnToggle", (v) => setDrone(v));
        function setDrone(v) {
          flash.KeyG = performance.now();
          if (planLocked()) return toast(GAME.demo ? "The demo is flying. Stop the demo to change the drone." : "Change the drone before the flight. Press Retry to plan again.", "info", "lock", 2);
          PLAN.drone = v;
          setDroneModel();
          vis.snapCam = true;
          planChanged();
        }
        bindToggle("windToggle", (v) => {
          if (planLocked()) return toast("Change the wind before the flight.", "info", "lock", 2);
          settings.wind = v;
          applyMission();
        });
        bindToggle("dirToggle", (v) => {
          if (planLocked()) return toast("Change the wind before the flight.", "info", "lock", 2);
          settings.windFrom = +v;
          applyMission();
        });
        bindToggle("viewToggle", (v) => setView(v));
        bindToggle("camToggle", (v) => setCam(v));
        bindToggle("dragToggle", (v) => {
          settings.drag = v === "on";
          VIEW.yaw = VIEW.pitch = 0;
          toggleSet("dragToggle", v);
        });
        bindToggle("todToggle", (v) => {
          settings.tod = v;
          toggleSet("todToggle", v);
          applyTime(v);
        });
        const CAM_HINT = {
          chase: "Chase: follows behind the drone, looking the way it faces. Best for flying by hand.",
          top: "Top: looks straight down from above. Best for lining up over the drop point.",
          cam: "Drone cam: the drone's own camera, looking 50° down at the ground ahead.",
          base: "Base: what the operator at the base sees; it zooms as the drone flies away.",
        };
        function setCam(v) {
          settings.cam = v;
          toggleSet("camToggle", v);
          $("camHint").textContent = CAM_HINT[v];
          VIEW.yaw = VIEW.pitch = 0;
          vis.snapCam = true;
          flash.KeyC = performance.now();
        }
        function setView(v) {
          settings.view = v;
          toggleSet("viewToggle", v);
          planCv.classList.toggle("hide", v !== "map");
          $("mapCtl").classList.toggle("hide", v !== "map");
          $("mapLegend").classList.toggle("hide", v !== "map");
          flash.KeyV = performance.now();
        }
        function selectTarget(k) {
          if (planLocked()) return toast(GAME.demo ? "The demo is flying. Stop the demo to plan your own mission." : "The plan is locked during the flight. Press Retry to change it.", "info", "lock", 2);
          const z = zoneOf(k);
          PLAN.target = k;
          PLAN.aim = { x: z.x, z: z.z };
          sfx.init();
          sfx.beep(740, 0.07);
          layoutZones();
          planChanged();
          if (MISSION.need && k !== MISSION.need) toast("Check the mission card: is the " + z.n + " the right drop zone?", "info", "wz", 3);
        }
        $("zoneList").addEventListener("click", (e) => {
          const b = e.target.closest("button");
          if (b) selectTarget(b.dataset.z);
        });
        $("wpUndo").addEventListener("click", () => removeLastWp());
        $("wpClear").addEventListener("click", () => {
          if (planLocked()) return toast("The plan is locked during the flight.", "info", "lock", 2);
          PLAN.wps = [];
          planChanged();
        });
        function removeLastWp() {
          flash.Backspace = performance.now();
          if (planLocked()) return toast("The plan is locked during the flight.", "info", "lock", 2);
          if (!PLAN.wps.length) return;
          PLAN.wps.pop();
          planChanged();
        }

        // build MISSION from the mode / level / simulator controls, then reset the plan to fit it
        function applyMission(fresh) {
          if (GAME.mode === "mission") {
            const L = LEVELS[GAME.level - 1];
            MISSION = { kind: "level", r: L.r, need: L.need, nfz: L.nfz || [], wind: Object.assign({}, L.wind), lock: L.lock || {}, item: L.item || null, par: L.par || 0 };
            if (fresh) {
              PLAN.wps = [];
              PLAN.target = L.pre.target || null;
              PLAN.aim = PLAN.target ? { x: zoneOf(PLAN.target).x, z: zoneOf(PLAN.target).z } : null;
              PLAN.alt = "med";
              PLAN.spd = "med";
              PLAN.pay = "med";
              PLAN.mode = "auto";
              PLAN.assist = "gps";
            }
          } else if (GAME.mode === "learn") {
            const L = LESSONS[GAME.lesson];
            MISSION = { kind: "learn", r: 8, need: "meadow", nfz: [], wind: { spd: 0, from: 270, g: 0 }, lock: L.lock, item: null, par: 0 };
            if (fresh) {
              PLAN.wps = [];
              PLAN.target = L.pre || null;
              PLAN.aim = PLAN.target ? { x: zoneOf(PLAN.target).x, z: zoneOf(PLAN.target).z } : null;
              PLAN.alt = "med";
              PLAN.spd = "med";
              PLAN.pay = "med";
              PLAN.mode = L.lock.mode;
              PLAN.assist = "gps";
            }
          } else {
            const W = WINDS[settings.wind];
            MISSION = { kind: "sim", r: 8, need: null, nfz: [], wind: { spd: W.spd, from: settings.windFrom, g: W.g }, lock: {}, item: null, par: 0 };
            if (fresh && !PLAN.target) {
              PLAN.target = "meadow";
              PLAN.aim = { x: zoneOf("meadow").x, z: zoneOf("meadow").z };
            }
          }
          for (const k of ["alt", "spd", "pay", "mode", "assist"]) if (MISSION.lock[k]) PLAN[k] = MISSION.lock[k];
          S.in.thr = thrRest();
          setParcel();
          buildNFZ();
          layoutZones();
          planChanged();
          renderZoneList();
        }
        function renderZoneList() {
          $("zoneList").innerHTML = ZONES.map((z) => '<button type="button" data-z="' + z.k + '" class="' + (PLAN.target === z.k ? "on" : "") + '" title="' + z.d + '"><span class="zi">' + z.ic + "</span><span>" + z.n + "</span></button>").join("");
        }
        function updatePlanUI() {
          toggleSet("altToggle", PLAN.alt);
          toggleSet("spdToggle", PLAN.spd);
          toggleSet("payToggle", PLAN.pay);
          toggleSet("dropToggle", PLAN.mode);
          toggleSet("assistToggle", PLAN.assist);
          toggleSet("drnToggle", PLAN.drone);
          $("drnToggle").querySelectorAll("button").forEach((b) => (b.disabled = planLocked()));
          const DD = DRONES[PLAN.drone];
          $("drnVal").textContent = DD.n + " · " + DD.rotors + " rotors · " + DD.m + " kg";
          $("drnHint").textContent = DD.d + " Max tilt " + Math.round(DD.tilt * R2D) + "°.";
          toggleSet("windToggle", settings.wind);
          toggleSet("dirToggle", settings.windFrom);
          const locked = planLocked();
          // locks: other options greyed out, the fixed one shows a padlock
          for (const [id, key] of [["altToggle", "alt"], ["spdToggle", "spd"], ["payToggle", "pay"], ["dropToggle", "mode"], ["assistToggle", "assist"]]) {
            $(id).querySelectorAll("button").forEach((b) => {
              const lk = MISSION.lock[key];
              const live = key === "assist" && S.started && !S.ended && !GAME.demo;
              b.disabled = (!!lk && b.dataset.v !== lk) || (locked && !live);
              b.classList.toggle("lk", !!lk);
            });
          }
          const manual = PLAN.mode === "manual";
          $("assistCtrl").hidden = !manual;
          $("altToggle").closest(".ctrl").classList.toggle("na", manual);
          $("spdToggle").closest(".ctrl").classList.toggle("na", manual);
          $("windCtrl").hidden = GAME.mode !== "sim";
          $("windToggle").querySelectorAll("button").forEach((b) => (b.disabled = locked));
          $("dirToggle").querySelectorAll("button").forEach((b) => (b.disabled = locked || settings.wind === "none"));
          $("altVal").textContent = ALT[PLAN.alt].n + " · " + ALT[PLAN.alt].h + " m";
          $("spdVal").textContent = SPD[PLAN.spd].n + " · " + SPD[PLAN.spd].v + " m/s";
          $("payVal").textContent = itemName() + " · " + PAY[PLAN.pay].m + " kg";
          $("modeVal").textContent = manual ? "Manual · " + ASSIST[PLAN.assist].n : "Autopilot";
          $("dropHint").textContent = manual ? "Manual: you fly it with the transmitter. Land in the zone, open the claws (Space), fly home. Altitude and speed are yours to choose." : "Autopilot: it flies the route, stops over the drop point, lands the payload, opens the claws and flies home.";
          $("assistVal").textContent = ASSIST[PLAN.assist].n;
          $("assistHint").textContent = ASSIST[PLAN.assist].d;
          $("windVal").textContent = windName(MISSION.wind);
          const z = tgtZone();
          $("tgtVal").textContent = z ? z.n : "Pick a drop zone";
          $("tgtVal").style.color = z && MISSION.need && z.k !== MISSION.need ? "var(--warn)" : "";
          $("zoneList").querySelectorAll("button").forEach((b) => {
            b.classList.toggle("on", b.dataset.z === PLAN.target);
            b.disabled = locked;
          });
          $("wpVal").textContent = PLAN.wps.length + (PLAN.wps.length === 1 ? " point" : " points");
          $("wpUndo").disabled = $("wpClear").disabled = locked || !PLAN.wps.length;
          // route check line
          const rc = $("routeChk");
          const chk = ROUTECHK;
          if (!PLAN.aim) {
            rc.className = "routechk";
            rc.textContent = "Pick a drop zone to plan the route.";
          } else if (chk && chk.issues.length) {
            const worst = chk.issues.find((i) => i.k === "bad") || chk.issues[0];
            rc.className = "routechk " + worst.k;
            rc.textContent = worst.t;
          } else if (chk) {
            rc.className = "routechk ok";
            rc.textContent = "✓ Route clear · " + Math.round(chk.len) + " m to the drop point · about " + fmtT((2 * chk.len) / SPD[PLAN.spd].v + 50) + " flight";
          }
          // lock note in missions
          const lks = Object.entries(MISSION.lock).map(([k, v]) => ({ alt: "Altitude", spd: "Speed", pay: "Payload", mode: "Flight", assist: "Assist" }[k] + " " + ({ alt: ALT, spd: SPD, pay: PAY, assist: ASSIST }[k] ? { alt: ALT, spd: SPD, pay: PAY, assist: ASSIST }[k][v].n : v === "auto" ? "Autopilot" : "Manual")));
          $("lockNote").hidden = !lks.length;
          $("lockNote").innerHTML = lks.length ? "🔒 Fixed for this mission: <b>" + lks.join(" · ") + "</b>. The other choices are yours." : "";
          // delivery physics numbers
          const dn = deliveryNumbers();
          $("fFall").textContent = "= " + dn.m.toFixed(1) + " kg × 9.81 ≈ " + dn.W.toFixed(0) + " N · " + Math.round(dn.hov * 100) + "% of max";
          $("fThrow").textContent = "= " + dn.v + "² ÷ (2 × " + dn.a.toFixed(1) + ") ≈ " + dn.stop.toFixed(0) + " m";
          $("fDrift").textContent = dn.ws ? "≈ " + dn.tilt.toFixed(1) + "° tilt in " + dn.ws.toFixed(1) + " m/s wind" : "= 0° (calm)";
          $("dpTag").textContent = DRONES[PLAN.drone].short + " + " + PAY[PLAN.pay].m + " kg payload";
          renderObjectives();
          $("startBtn").textContent = !S.started || S.ended ? "▶ Start" : S.paused ? "▶ Resume" : "❚❚ Pause";
          $("planState").textContent = S.started ? (S.ended ? "finished" : "locked in flight") : "planning";
        }
        function objectives() {
          const z = tgtZone(),
            chk = ROUTECHK;
          const L = S.pay.land;
          const need = MISSION.need ? zoneOf(MISSION.need) : null;
          const manual = PLAN.mode === "manual";
          const list = [];
          list.push({ t: need ? "Select the " + need.n + " as the drop zone" : "Select a drop zone", st: z && (!need || z.k === need.k) ? "done" : z ? "fail" : "" });
          list.push({ t: "Arm the motors (S + D, or the ARM switch)", st: S.armedOnce ? "done" : "" });
          const nfzBad = S.crashed || (S.failed && /no-fly/.test(S.failed));
          if (manual) list.push({ t: MISSION.nfz.length ? "Fly round the no-fly zones and obstacles" : "Fly clear of obstacles", st: nfzBad ? "fail" : S.pay.st !== "attached" || S.ended ? "done" : "" });
          else list.push({ t: MISSION.nfz.length ? "Route avoids the no-fly zones and obstacles" : "Route clear of obstacles", st: nfzBad ? "fail" : chk && chk.ok && z ? (S.ended || S.pay.st !== "attached" ? "done" : "ok") : z ? "fail" : "" });
          list.push({ t: "Land the payload, then open the claws", st: L ? (L.setd ? "done" : "fail") : S.ended ? "fail" : "" });
          list.push({ t: "Payload inside the " + MISSION.r + " m zone", st: L ? (L.d <= MISSION.r && !L.wet && (!need || PLAN.target === need.k) ? "done" : "fail") : S.ended ? "fail" : "" });
          list.push({ t: "Fly home and land on the base pad", st: S.phase === "done" && !S.failed && Math.hypot(S.pos.x - BASE.x, S.pos.z - BASE.z) < 8 ? "done" : S.crashed || S.failed || S.ended ? "fail" : "" });
          return list;
        }
        function renderObjectives() {
          const L = objectives();
          $("objTitle").textContent = GAME.mode === "mission" ? "Mission " + GAME.level + ": " + LEVELS[GAME.level - 1].n : "Mission Checklist";
          $("objCount").textContent = L.filter((o) => o.st === "done").length + " / " + L.length;
          const nx = L.findIndex((o) => o.st !== "done");
          const html = L.map((o, i) => '<li class="' + (o.st === "done" ? "done" : o.st === "fail" ? "fail" : i === nx ? "next" : "") + '"><span class="ck"></span><span>' + o.t + "</span></li>").join("");
          if ($("objList").innerHTML !== html) $("objList").innerHTML = html;
        }

        /* ---------- mode panel (left) and the mission card (on the view) ---------- */
        const MODE_INFO = {
          sim: ["Test any delivery.", "Pick a drop zone and a drone, plan the route, then let the Autopilot fly it or fly it yourself (Manual). Change one thing at a time and compare the runs in the report."],
          learn: ["Learn to fly a delivery, step by step.", "Three short lessons: plan a route and watch the autopilot deliver, practise each stick, then fly a delivery by hand. The orange guide on the view says what to do next, the control to use glows orange, and each step ticks itself when you do it."],
          mission: ["Sky Parcel: rescue drone missions.", "Eight missions, unlocked one by one: five with the autopilot, three flown by hand. Each one teaches one idea; a 🔒 shows a setting the mission fixes."],
        };
        function renderModePanel() {
          const m = GAME.mode;
          const a = MODE_INFO[m];
          let h = '<div class="about"><div><b>Goal:</b> ' + a[0] + "</div><div><b>How:</b> " + a[1] + "</div></div>";
          if (m === "mission") {
            const nd = levelsDone();
            h +=
              '<div class="rank">Rank: <b>' + RANKS[nd] + "</b> · " + nd + " / 8 missions</div>" +
              '<div class="mlist">' +
              LEVELS.map((l, i) => {
                const n = i + 1,
                  p = PROG.lv[n],
                  un = levelUnlocked(n);
                return '<button type="button" data-level="' + n + '" class="' + (n === GAME.level ? "on" : "") + '"' + (un ? "" : " disabled") + '><span class="n">' + n + "</span><span>" + l.n + "<small>" + l.learn + '</small></span><span class="st">' + (p ? "★".repeat(p.stars) + "☆".repeat(3 - p.stars) : un ? "" : "🔒") + "</span></button>";
              }).join("") +
              "</div>";
          }
          if (m === "learn")
            h +=
              '<div class="mlist">' +
              LESSONS.map((l, i) => '<button type="button" data-lesson="' + i + '" class="' + (i === GAME.lesson ? "on" : "") + '"><span class="n">' + (i + 1) + "</span><span>" + l.n + "<small>" + l.short + '</small></span><span class="st">' + (PROG.learn[i] ? "✓" : "") + "</span></button>").join("") +
              "</div>";
          h += '<button type="button" class="demobtn" data-demo="1">👁 Watch demo: ' + (m === "mission" ? "fly this mission" : m === "learn" ? (GAME.lesson === 0 ? "an autopilot delivery" : "a hand-flown delivery") : "a full delivery") + "</button>";
          $("modePanel").innerHTML = h;
        }
        $("modePanel").addEventListener("click", (e) => {
          const b = e.target.closest("button");
          if (!b || b.disabled) return;
          if (b.dataset.demo) return demoStart();
          if (b.dataset.level) {
            GAME.level = +b.dataset.level;
            newMission();
          }
          if (b.dataset.lesson) {
            GAME.lesson = +b.dataset.lesson;
            newMission();
          }
        });
        bindToggle("gameToggle", (v) => {
          GAME.mode = v;
          toggleSet("gameToggle", v);
          if (v === "mission") {
            // continue at the first unfinished mission
            let n = 1;
            while (n < 8 && PROG.lv[n] && PROG.lv[n].ok) n++;
            GAME.level = n;
          }
          if (v === "learn") {
            // continue at the first lesson not yet finished
            let n = 0;
            while (n < LESSONS.length - 1 && PROG.learn[n]) n++;
            GAME.lesson = n;
          }
          newMission();
        });
        function showStartCard() {
          const m = GAME.mode;
          if (m === "mission") {
            const L = LEVELS[GAME.level - 1];
            $("ovKick").textContent = "Sky Parcel · Mission " + GAME.level + " of 8";
            $("ovTitle").textContent = L.n;
            $("ovStory").textContent = L.story;
            const z = zoneOf(L.need);
            const fl = L.lock.mode === "manual" ? "<b>You fly it</b> (Manual" + (L.lock.assist ? ", " + ASSIST[L.lock.assist].n + " assist" : "") + ")" : L.lock.mode === "auto" ? "<b>Autopilot</b> flight" : "Autopilot or Manual: your choice";
            const items = ["<b>Deliver:</b> " + (L.item || (L.lock.pay ? PAY[L.lock.pay].item : "the payload of your choice")) + " to the <b>" + z.n + "</b> (" + z.d + ")" + (L.pre.target ? "" : " · <b>you</b> must select the zone"), "<b>Target zone:</b> " + L.r + " m radius" + (L.nfz && L.nfz.length ? " · <b>No-fly zones:</b> " + L.nfz.map((f) => f.n).join(", ") : "") + " · <b>Wind:</b> " + windName(L.wind) + " · " + fl, "<b>Tip:</b> " + L.tip];
            items.push("<b>Steps:</b> " + guideSteps().map((s) => s.label).join(" → ") + ". The orange guide on the view takes you through them.");
            $("ovList").innerHTML = items.map((t) => "<li>" + t + "</li>").join("");
            $("ovPlan").textContent = "🗺 Plan the mission";
          } else if (m === "learn") {
            const L = LESSONS[GAME.lesson];
            $("ovKick").textContent = "Tutorial · Lesson " + (GAME.lesson + 1) + " of " + LESSONS.length;
            $("ovTitle").textContent = L.n;
            $("ovStory").textContent = L.intro;
            $("ovList").innerHTML = [
              "The <b>orange guide</b> at the top of the view tells you what to do. The button or key to use <b>glows orange</b>, on screen and on the keyboard panel.",
              "Each step ticks itself when you have done it. <b>Skip step</b> moves on if you get stuck.",
              "<b>Steps:</b> " + guideSteps().map((s) => s.label).join(" → "),
            ].map((t) => "<li>" + t + "</li>").join("");
            $("ovPlan").textContent = "▶ Begin lesson " + (GAME.lesson + 1);
          } else {
            $("ovKick").textContent = "Simulator · " + (PLAN.mode === "manual" ? "Manual flight" : "Autopilot");
            $("ovTitle").textContent = "Plan a delivery";
            $("ovStory").textContent = "Do these steps in order. The orange guide on the view shows the current step and lights up the control to use. Switch Autopilot / Manual on the left: Manual has its own steps.";
            $("ovList").innerHTML = guideSteps().map((s) => "<li>" + s.brief + "</li>").join("") + '<li class="ovnote">A parcel that ends up <b>outside the target circle</b> is a <b>failed drop</b>: the mission ends.</li>';
            $("ovPlan").textContent = "🗺 Plan the mission";
          }
          $("startOv").hidden = false;
        }
        function hideStartCard() {
          $("startOv").hidden = true;
        }
        $("ovPlan").addEventListener("click", () => {
          hideStartCard();
          setView(GAME.mode === "learn" && !planLocked() ? LESSONS[GAME.lesson].view : "map");
        });
        $("ovDemo").addEventListener("click", () => demoStart());
        // a fresh mission (mode or level changed)
        function newMission() {
          demoStopQuiet();
          resetFlight();
          hideReport();
          clearLog();
          applyMission(true);
          renderModePanel();
          showStartCard();
          setView("map");
          vis.snapCam = true;
          updateButtons();
        }
        // fly the same plan again
        function retry() {
          demoStopQuiet();
          resetFlight();
          hideReport();
          clearLog();
          planChanged();
          setView("map");
          vis.snapCam = true;
          updateButtons();
          toast("Plan kept. Change anything you like, then press Start.", "info", "retry", 1);
        }

        /* ---------- run control ---------- */
        function startPause() {
          flash.Enter = performance.now();
          if (S.ended) retry();
          if (!S.started) {
            hideReport();
            startMission();
          } else {
            S.paused = !S.paused;
            sfx.suspend(S.paused);
          }
          updateButtons();
        }
        function updateButtons() {
          const b = $("startBtn");
          b.textContent = !S.started || S.ended ? "▶ Start" : S.paused ? "▶ Resume" : "❚❚ Pause";
          b.classList.toggle("running", S.started && !S.ended && !S.paused);
          $("endBtn").disabled = !S.started || S.ended;
          updatePlanUI();
        }
        $("startBtn").addEventListener("click", startPause);
        $("resetBtn").addEventListener("click", () => {
          flash.KeyR = performance.now();
          retry();
        });
        $("endBtn").addEventListener("click", () => {
          if (S.started && !S.ended) {
            S.failed = S.failed || "Mission aborted by the operator";
            addLog("Mission aborted", "bad");
            finishMission();
          }
        });
        $("dropBtn").addEventListener("click", () => releasePayload("manual"));

        /* ================= finish + report ================= */
        const runs = [];
        let runNo = 0;
        function finishMission() {
          if (S.ended) return;
          S.ended = true;
          S.running = false;
          const res = analyse();
          const sc = scoreOf(res);
          S.result = { res, sc };
          runNo++;
          const run = {
            n: runNo,
            mis: GAME.mode === "mission" ? "M" + GAME.level : GAME.mode === "learn" ? "L" + (GAME.lesson + 1) : "Sim",
            drn: DRONES[PLAN.drone].short,
            tgt: tgtZone() ? tgtZone().n : "—",
            alt: PLAN.mode === "manual" ? "—" : ALT[PLAN.alt].n,
            spd: PLAN.mode === "manual" ? "—" : SPD[PLAN.spd].n,
            pay: PAY[PLAN.pay].n,
            mode: PLAN.mode === "auto" ? "Auto" : "Manual " + ASSIST[PLAN.assist].n,
            wind: MISSION.wind.spd ? MISSION.wind.spd + " m/s" : "calm",
            err: S.pay.land && !S.pay.land.wet ? S.pay.land.d : null,
            status: res.status,
            score: sc.total,
            stars: sc.stars,
            demo: GAME.demo,
          };
          runs.push(run);
          addLog("Mission " + { success: "SUCCESS", missed: "MISSED", failed: "FAILED" }[res.status] + ": " + res.reason, res.status === "success" ? "ok" : "bad");
          let unlocked = false;
          if (GAME.mode === "mission" && !GAME.demo) {
            const prev = PROG.lv[GAME.level] || {};
            const ok = res.status === "success";
            if (ok && GAME.level < 8 && !(prev.ok)) unlocked = true;
            PROG.lv[GAME.level] = { ok: prev.ok || ok, stars: Math.max(prev.stars || 0, sc.stars), best: Math.max(prev.best || 0, ok ? sc.total : 0) };
            saveProg();
            renderModePanel();
          }
          if (GAME.mode === "learn" && !GAME.demo && res.status === "success") {
            PROG.learn[GAME.lesson] = true;
            saveProg();
            renderModePanel();
          }
          if (res.status === "success") sfx.chime();
          sfx.motor(0, 0, false);
          updateButtons();
          if (GAME.demo) GAME.demoDone = true;
          setTimeout(() => showReport(res, sc, run, unlocked), 600);
        }
        function showReport(res, sc, run, unlocked) {
          const STAT = { success: "Mission success", missed: "Missed", failed: "Mission failed" };
          $("rTitle").textContent = (GAME.demo ? "Demo · " : "") + (GAME.mode === "mission" ? "Mission " + GAME.level + " · " + LEVELS[GAME.level - 1].n + ": " : GAME.mode === "learn" ? "Lesson " + (GAME.lesson + 1) + ": " : "") + STAT[res.status];
          $("rSub").textContent = res.reason + (unlocked ? " · Mission " + (GAME.level + 1) + " unlocked!" : "") + (GAME.mode === "mission" && GAME.level === 8 && res.status === "success" && !GAME.demo ? " · You are now a Rescue Drone Lead!" : "");
          $("rStars").innerHTML = [0, 1, 2].map((i) => '<span class="' + (i < sc.stars ? "on" : "off") + '">★</span>').join("");
          const stat = (k, v) => '<div class="rstat"><small>' + k + "</small><b>" + v + "</b></div>";
          const L = S.pay.land;
          $("rStats").innerHTML = [
            stat("Set-down accuracy", L ? (L.wet ? "in the lake" : L.d.toFixed(1) + " m") : "not delivered"),
            stat("Target zone", tgtZone() ? tgtZone().n + " · " + MISSION.r + " m" : "—"),
            stat(PLAN.mode === "manual" ? "Highest · fastest" : "Altitude · speed", PLAN.mode === "manual" ? S.m.maxAlt.toFixed(0) + " m · " + S.m.maxV.toFixed(1) + " m/s" : ALT[PLAN.alt].h + " m · " + SPD[PLAN.spd].v + " m/s"),
            stat("Drone · payload", DRONES[PLAN.drone].short + " · " + itemName() + " " + PAY[PLAN.pay].m + " kg"),
            stat("Flight", PLAN.mode === "auto" ? (S.override ? "Autopilot, then Manual" : "Autopilot") : "Manual · " + ASSIST[PLAN.assist].n),
            stat("Touch-down", L && !L.wet ? L.v.toFixed(1) + " m/s · " + L.cond : "—"),
            stat("Wind", MISSION.wind.spd ? MISSION.wind.spd + " m/s from " + CARD(MISSION.wind.from) : "calm"),
            stat("Mission time", fmtT(S.t)),

          ].join("");
          $("rScore").innerHTML = scoreBarsHTML(sc.f);
          $("scoreBars").innerHTML = scoreBarsHTML(sc.f);
          $("scoreTot").textContent = sc.total + " / 100";
          $("rTips").innerHTML = (res.fb.length ? res.fb : [{ b: "Mission complete.", s: res.reason }]).map((t) => '<li class="' + (t.ok ? "ok" : "") + '"><b>' + t.b + "</b><span>" + t.s + "</span></li>").join("");
          const rows = runs.slice(-8);
          $("rRuns").innerHTML =
            "<tr><th>#</th><th>Mission</th><th>Drone</th><th>Target</th><th>Alt</th><th>Speed</th><th>Payload</th><th>Flight</th><th>Wind</th><th>Error</th><th>Result</th><th>Score</th><th>Stars</th></tr>" +
            rows
              .map(
                (r) =>
                  '<tr class="' + (r === run ? "cur" : "") + '"><td>' + r.n + (r.demo ? " (demo)" : "") + "</td><td>" + r.mis + "</td><td>" + r.drn + "</td><td>" + r.tgt + "</td><td>" + r.alt + "</td><td>" + r.spd + "</td><td>" + r.pay + "</td><td>" + r.mode + "</td><td>" + r.wind + "</td><td>" + (r.err != null ? r.err.toFixed(1) + " m" : "—") + "</td><td>" + { success: "Success", missed: "Missed", failed: "Failed" }[r.status] + "</td><td>" + r.score + "</td><td>" + "★".repeat(r.stars) + "☆".repeat(3 - r.stars) + "</td></tr>",
              )
              .join("");
          $("rNext").hidden = !((GAME.mode === "mission" && GAME.level < 8 && levelUnlocked(GAME.level + 1) && !GAME.demo) || (GAME.mode === "learn" && GAME.lesson < LESSONS.length - 1 && res.status === "success" && !GAME.demo));
          $("rNext").textContent = GAME.mode === "learn" ? "▶ Next Lesson" : "▶ Next Mission";
          $("report").hidden = false;
          requestAnimationFrame(() => {
            drawChart();
            drawDropView($("rDrop"), true);
          });
          $("rAgain").focus();
        }
        function scoreBarsHTML(f) {
          return f.map((x) => '<div class="sbar' + (x.v == null ? " na" : "") + '"><span>' + x.k + '</span><span class="tr"><i style="width:' + (x.v == null ? 0 : Math.round(x.v)) + "%;background:" + (x.v == null ? "transparent" : x.v >= 75 ? "var(--safe)" : x.v >= 45 ? "var(--warn)" : "var(--fail)") + '"></i></span><b>' + (x.v == null ? "—" : Math.round(x.v)) + "</b><small>" + x.h + "</small></div>").join("");
        }
        function hideReport() {
          $("report").hidden = true;
        }
        $("rClose").addEventListener("click", hideReport);
        $("rAgain").addEventListener("click", () => {
          hideReport();
          retry();
        });
        $("rPlan").addEventListener("click", () => {
          hideReport();
          retry();
        });
        $("rNext").addEventListener("click", () => {
          hideReport();
          if (GAME.mode === "learn") GAME.lesson++;
          else GAME.level++;
          newMission();
        });
        function drawChart() {
          const cv = $("rChart");
          const r = cv.getBoundingClientRect();
          const dpr = Math.min(window.devicePixelRatio || 1, 2);
          cv.width = Math.round(r.width * dpr);
          cv.height = Math.round(r.height * dpr);
          const g = cv.getContext("2d");
          g.setTransform(dpr, 0, 0, dpr, 0, 0);
          const w = r.width,
            h = r.height;
          g.clearRect(0, 0, w, h);
          const pad = { l: 36, r: 36, t: 10, b: 24 };
          const sm = S.samples;
          g.font = "600 11px " + FONT_M;
          g.fillStyle = "#7f8bab";
          if (sm.length < 2) {
            g.textAlign = "center";
            g.fillText("Not enough flight data for a chart.", w / 2, h / 2);
            return;
          }
          const t0 = sm[0].t,
            tMax = sm[sm.length - 1].t;
          const aMax = Math.max(20, Math.ceil(Math.max(...sm.map((s) => s.alt)) / 10) * 10);
          const vMax = 12;
          const X = (t) => pad.l + ((t - t0) / Math.max(1, tMax - t0)) * (w - pad.l - pad.r);
          const YA = (a) => h - pad.b - (a / aMax) * (h - pad.t - pad.b);
          const YV = (v) => h - pad.b - (v / vMax) * (h - pad.t - pad.b);
          g.strokeStyle = "rgba(190,205,255,0.1)";
          g.lineWidth = 1;
          for (let i = 0; i <= 4; i++) {
            const y = pad.t + (i * (h - pad.t - pad.b)) / 4;
            g.beginPath();
            g.moveTo(pad.l, y);
            g.lineTo(w - pad.r, y);
            g.stroke();
          }
          if (S.release) {
            g.strokeStyle = "#f472b6";
            g.lineWidth = 2;
            g.setLineDash([4, 3]);
            g.beginPath();
            g.moveTo(X(S.release.t), pad.t);
            g.lineTo(X(S.release.t), h - pad.b);
            g.stroke();
            g.setLineDash([]);
          }
          const line = (fn, col) => {
            g.strokeStyle = col;
            g.lineWidth = 2;
            g.beginPath();
            sm.forEach((s, i) => (i ? g.lineTo(X(s.t), fn(s)) : g.moveTo(X(s.t), fn(s))));
            g.stroke();
          };
          line((s) => YA(s.alt), "#7cc4ff");
          line((s) => YV(s.v), "#f5b942");
          g.textAlign = "right";
          g.textBaseline = "middle";
          g.fillStyle = "#7cc4ff";
          for (let i = 0; i <= 4; i++) g.fillText(String(Math.round((aMax * i) / 4)), pad.l - 6, YA((aMax * i) / 4));
          g.textAlign = "left";
          g.fillStyle = "#f5b942";
          for (let i = 0; i <= 4; i++) g.fillText(String(Math.round((vMax * i) / 4)), w - pad.r + 6, YV((vMax * i) / 4));
          g.fillStyle = "#7f8bab";
          g.textAlign = "center";
          g.textBaseline = "top";
          const span = tMax - t0;
          const stepT = span > 240 ? 60 : span > 100 ? 30 : span > 40 ? 10 : 5;
          for (let t = 0; t <= span; t += stepT) g.fillText(fmtT(t), X(t0 + t), h - pad.b + 6);
        }
        // top-down view of the target: zone, landing point, flight direction, wind
        function drawDropView(cv, big) {
          const r = cv.getBoundingClientRect();
          const dpr = Math.min(window.devicePixelRatio || 1, 2);
          const w = big ? r.width : cv.width,
            h = big ? r.height : cv.height;
          if (big) {
            cv.width = Math.round(w * dpr);
            cv.height = Math.round(h * dpr);
          }
          const g = cv.getContext("2d");
          g.setTransform(big ? dpr : 1, 0, 0, big ? dpr : 1, 0, 0);
          g.clearRect(0, 0, w, h);
          const z = tgtZone();
          if (!z || w < 40 || h < 40) return;
          const rr = MISSION.r;
          const L = S.pay.land;
          const span = Math.max(rr * 2.6, L && !L.wet ? L.d * 1.3 : 0, 10);
          const s = (Math.min(w, h) / 2 - 8) / span;
          const cx = w / 2,
            cy = h / 2;
          g.fillStyle = "rgba(60,95,43,0.55)";
          g.fillRect(0, 0, w, h);
          for (const [k, col] of [[2, "rgba(255,255,255,0.2)"], [1, "#ff8a1f"]]) {
            g.strokeStyle = col;
            g.lineWidth = k === 1 ? 2.5 : 1;
            g.setLineDash(k === 1 ? [] : [4, 4]);
            g.beginPath();
            g.arc(cx, cy, rr * k * s, 0, TAU);
            g.stroke();
          }
          g.setLineDash([]);
          g.fillStyle = "rgba(255,138,31,0.15)";
          g.beginPath();
          g.arc(cx, cy, rr * s, 0, TAU);
          g.fill();
          g.strokeStyle = "#ffffff";
          g.lineWidth = 1.5;
          g.beginPath();
          g.moveTo(cx - 6, cy);
          g.lineTo(cx + 6, cy);
          g.moveTo(cx, cy - 6);
          g.lineTo(cx, cy + 6);
          g.stroke();
          const dir = runoutDir(routePts());
          arrow(g, cx - dir.x * (h * 0.42), cy - dir.z * (h * 0.42), cx - dir.x * (h * 0.26), cy - dir.z * (h * 0.26), "rgba(124,196,255,0.9)", 2, 7);
          if (MISSION.wind.spd) {
            const wv = windDir(MISSION.wind.from);
            arrow(g, w - 22 - wv.x * 12, 22 - wv.z * 12, w - 22 + wv.x * 12, 22 + wv.z * 12, "#c4b5fd", 2, 7);
          }
          if (big) {
            g.font = "600 11px " + FONT_B;
            g.fillStyle = "#cfd8ee";
            g.textAlign = "left";
            g.fillText("blue arrow: flight direction" + (MISSION.wind.spd ? " · purple: wind" : ""), 8, h - 8);
          }
          if (L && !L.wet) {
            const lx = cx + (L.x - z.x) * s,
              ly = cy + (L.z - z.z) * s;
            g.setLineDash([3, 3]);
            g.strokeStyle = "#ff3b6b";
            g.beginPath();
            g.moveTo(cx, cy);
            g.lineTo(lx, ly);
            g.stroke();
            g.setLineDash([]);
            g.fillStyle = "#ff3b6b";
            g.strokeStyle = "#fff";
            g.lineWidth = 1.5;
            g.fillRect(lx - 4, ly - 4, 8, 8);
            g.strokeRect(lx - 4, ly - 4, 8, 8);
            if (big) {
              g.font = "700 12px " + FONT_M;
              g.fillStyle = "#ffd0dc";
              g.fillText(L.d.toFixed(1) + " m", lx + 7, ly - 6);
            }
          }
        }

        /* ================= side panels ================= */
        function stCls(st) {
          return st === "success" ? "c-ok" : st === "missed" ? "c-warn" : st === "failed" ? "c-bad" : "c-info";
        }
        /* ================= step guide: the sequence of operations for every mode ================= */
        // One card on the view lists the steps of the current mode, explains the current one, and makes the
        // control to use glow (panel buttons, keyboard keys and transmitter sticks). In the Tutorial each step
        // must be done in order; in the Simulator and Missions the guide follows whatever you have done so far.
        const GUIDE = { key: "", steps: [], si: 0, latch: {}, A: {}, lastT: 0, lastPsi: 0, acts: [], hlSig: "", min: false, html: {} };
        try {
          GUIDE.min = localStorage.getItem("skyparcel.guideMin") === "1";
        } catch (err) {}
        const KB = (c) => "<kbd>" + c + "</kbd>";
        const hspd = () => Math.hypot(S.vel.x, S.vel.z);
        const zDist = () => {
          const z = tgtZone();
          return z ? Math.hypot(S.pos.x - z.x, S.pos.z - z.z) : Infinity;
        };
        const baseDist = () => Math.hypot(S.pos.x - BASE.x, S.pos.z - BASE.z);
        const rightZone = () => !MISSION.need || PLAN.target === MISSION.need;
        const holding = () => S.pay.st === "attached";
        const deliveredOk = () => {
          const L = S.pay.land;
          return !!(L && !L.wet && L.d <= MISSION.r && rightZone());
        };
        const stopDist = () => (hspd() * hspd()) / (2 * brakeA(true));
        // where a point is, seen from the drone's nose
        function bearingTo(p) {
          const err = wrapPi(Math.atan2(p.x - S.pos.x, -(p.z - S.pos.z)) - S.psi),
            a = Math.abs(err);
          return { err, word: a < 0.35 ? "straight ahead" : a > 2.6 ? "behind you" : err > 0 ? (a < 1.2 ? "ahead on your right" : "to your right") : a < 1.2 ? "ahead on your left" : "to your left" };
        }
        // which key moves the drone towards a point: turn first, then forward; brake when it is time
        function steerKeys(p, dist) {
          const b = bearingTo(p),
            v = hspd();
          if (dist < stopDist() + 8 && v > 2) return ["ArrowDown"];
          if (Math.abs(b.err) > 0.35) return [b.err > 0 ? "KeyD" : "KeyA"];
          return ["ArrowUp"];
        }
        const AX_OF = { ArrowDown: "axElv", ArrowUp: "axElv", ArrowLeft: "axAil", ArrowRight: "axAil", KeyA: "axRud", KeyD: "axRud", KeyW: "axThr", KeyS: "axThr" };
        const axFor = (keys) => keys.map((k) => AX_OF[k]).filter(Boolean);
        const PH_AFTER = { route: 1, approach: 2, descend: 3, setdown: 4, climb: 5, ret: 6, land: 7, disarm: 8, done: 9 };
        const phaseAtLeast = (ph) => (PH_AFTER[S.phase] || 0) >= PH_AFTER[ph] || !holding();
        // landed (or about to land) outside the circle with the parcel still in the claws
        function outsideWarn(low) {
          const d = zDist();
          if (S.ground && S.flew && holding() && d < 80 && (d > MISSION.r || !rightZone())) return (rightZone() ? "You landed " + d.toFixed(1) + " m from the centre: <b>outside</b> the " + MISSION.r + " m zone." : "This is the wrong drop zone.") + " Opening the claws here fails the mission: take off again (" + KB("W") + ") and move into the circle.";
          if (low && !S.ground && d > MISSION.r && altNow() < 5) return "The drone is " + d.toFixed(1) + " m from the centre: outside the " + MISSION.r + " m circle. Move in before you touch down.";
          return "";
        }
        const flightSub = () => "altitude " + altNow().toFixed(1) + " m · speed " + hspd().toFixed(1) + " m/s";

        // ---------- the steps ----------
        const ST = {
          zone: () => {
            const need = MISSION.need ? zoneOf(MISSION.need) : null;
            return {
              id: "zone",
              label: "Zone",
              brief: need ? "Select the <b>" + need.n + "</b> as the drop zone" : "Pick a <b>drop zone</b> on the map",
              t: () => (need ? "Select the <b>" + need.n + "</b> as the drop zone" : "Pick a <b>drop zone</b>") + ": click its circle on the map, or choose it under <b>Mission target</b> on the left.",
              warn: () => (PLAN.target && !rightZone() ? "The " + tgtZone().n + " is the wrong drop zone: this delivery is for the " + need.n + "." : ""),
              done: () => !!PLAN.target && rightZone(),
              hl: ["#zoneList"],
              act: () => (settings.view !== "map" ? [{ txt: "🗺 Show the map (V)", fn: () => setView("map") }] : []),
            };
          },
          route: () => ({
            id: "route",
            label: "Route",
            brief: "Check the route line on the map: white is clear, <b>red</b> must be fixed (click the map to add waypoints)",
            t: () => (ROUTECHK && !ROUTECHK.ok ? "<b>Fix the route:</b> " + (ROUTECHK.issues.find((i) => i.k === "bad") || { t: "" }).t.replace(/^✗ /, "") : "<span class=okc>✓ Route clear.</span>"),
            done: () => !!(ROUTECHK && ROUTECHK.ok),
            hl: ["#wpCtrl", "#altCtrl"],
          }),
          start: (manual) => ({
            id: "start",
            label: "Start",
            brief: "Press <b>▶ Start</b> " + KB("Enter") + " to lock the plan",
            t: () => "Press <b>▶ Start</b> " + KB("Enter") + " to lock the plan." + (manual ? " You fly with the keys, or by dragging the sticks on the left." : " Before that you can still change <b>Altitude</b>, <b>Speed</b> and <b>Payload</b> on the left."),
            done: () => S.started,
            hl: ["#startBtn"],
            keys: ["Enter"],
            act: () => [{ txt: "▶ Start (Enter)", fn: startPause }],
          }),
          arm: () => ({
            id: "arm",
            label: "Arm",
            brief: "<b>Arm the motors</b>: hold " + KB("S") + "+" + KB("D") + " for 1 s, or flip the ARM switch " + KB("E"),
            t: () => "<b>Arm the motors:</b> hold " + KB("S") + " + " + KB("D") + " together for 1 second (left stick down and to the right), or flip the <b>ARM switch</b> " + KB("E") + ".",
            sub: () => (S.armHold > 0 ? "arming… keep holding S + D · " + Math.round(Math.min(1, S.armHold) * 100) + "%" : ""),
            done: () => S.armedOnce,
            hl: ["#armBtn"],
            keys: ["KeyS", "KeyD", "KeyE"],
            ax: ["axThr", "axRud"],
            act: () => [{ txt: "Flip the ARM switch (E)", fn: armSwitch }],
          }),
          // autopilot
          apFly: () => ({
            id: "fly",
            label: "Fly out",
            brief: "The <b>autopilot</b> takes off and flies the route: hands off",
            t: () => "<b>Hands off: the autopilot is flying.</b> It climbs to " + altH() + " m and follows the route to the drop point. Switch Map / 3D with " + KB("V") + " and the camera with " + KB("C") + "; " + KB("T") + " takes manual control.",
            sub: () => phaseName() + (PLAN.aim ? " · " + Math.round(Math.hypot(S.pos.x - PLAN.aim.x, S.pos.z - PLAN.aim.z)) + " m to the drop point" : "") + " · altitude " + altNow().toFixed(0) + " m",
            done: () => phaseAtLeast("descend"),
            hl: ["#viewToggle"],
            keys: ["KeyV", "KeyC"],
          }),
          apDrop: () => ({
            id: "drop",
            label: "Drop",
            brief: "It lands the parcel <b>inside the circle</b> and opens the claws (outside the circle = failed drop)",
            t: () => "<b>Set-down:</b> the drone descends over the drop point, stands the parcel on the ground and opens the claws. Inside the " + MISSION.r + " m circle it is delivered; outside, the drop <span class=bad>fails</span>.",
            sub: () => phaseName() + " · " + (holding() ? "altitude " + altNow().toFixed(1) + " m · sinking " + Math.max(0, -S.vel.y).toFixed(1) + " m/s" : S.pay.land ? "parcel " + S.pay.land.d.toFixed(1) + " m from the centre" : "parcel falling"),
            done: deliveredOk,
          }),
          apHome: () => ({
            id: "home",
            label: "Home",
            brief: "It flies home and lands on the base pad; then the report opens",
            t: () => "<b>Delivered!</b> The autopilot climbs away, flies home and lands on the base pad. The report opens when the motors stop.",
            sub: () => phaseName() + " · base " + Math.round(baseDist()) + " m away",
            done: () => S.phase === "done" || S.ended,
          }),
          // flying by hand
          takeoff: (h) => ({
            id: "takeoff",
            label: "Take off",
            brief: "Take off: hold " + KB("W") + " (left stick up) and climb to about " + h + " m",
            t: () => (PLAN.assist === "off" ? "<b>Take off:</b> tap " + KB("W") + " to raise the throttle to about 60 % until the drone lifts, climb to " + h + " m, then bring it back to about 50 % to hover." : "<b>Take off:</b> push the left stick <b>up</b>: hold " + KB("W") + " and climb to about " + h + " m. Let go and the drone holds its height."),
            sub: () => "altitude " + altNow().toFixed(1) + " of " + h + " m · throttle " + Math.round(S.in.thr * 100) + "%",
            prog: () => altNow() / h,
            done: () => S.flew && altNow() >= h - 2,
            keys: ["KeyW"],
            ax: ["axThr"],
          }),
          fly: () => ({
            id: "fly",
            label: "Fly there",
            brief: "Fly to the zone: turn with " + KB("A") + KB("D") + ", forward with " + KB("↑") + ", <b>slow down early</b>",
            t: () => {
              const z = tgtZone(),
                b = bearingTo(z),
                v = hspd(),
                d = zDist();
              if (d < stopDist() + 8 && v > 2) return "<b>Brake now!</b> Let go of " + KB("↑") + " or pull " + KB("↓") + ": at " + v.toFixed(1) + " m/s the drone needs about " + stopDist().toFixed(0) + " m to stop, and the zone is " + d.toFixed(0) + " m away.";
              return "<b>Fly to the " + z.n + "</b>: it is <b>" + b.word + "</b>, " + Math.round(d) + " m away. " + (Math.abs(b.err) > 0.35 ? "Turn to face it with " + KB(b.err > 0 ? "D" : "A") + ", then push" : "Push") + " the right stick forward " + KB("↑") + ". Slow down early: a loaded drone needs room to stop.";
            },
            sub: () => Math.round(zDist()) + " m to go · speed " + hspd().toFixed(1) + " m/s · stops in ≈ " + stopDist().toFixed(0) + " m · altitude " + altNow().toFixed(0) + " m",
            warn: () => outsideWarn(false),
            done: () => zDist() < MISSION.r * 1.6 && hspd() < 2.5,
            keys: () => (S.ground ? ["KeyW"] : steerKeys(tgtZone(), zDist())),
            ax: () => axFor(steerKeys(tgtZone(), zDist())),
          }),
          land: () => ({
            id: "land",
            label: "Land in zone",
            brief: "Stop over the circle and land <b>inside</b> it: hold " + KB("S"),
            t: () => {
              if (S.ground && S.flew) return "<b>Take off again</b> with " + KB("W") + " and move closer to the centre.";
              if (hspd() > 0.8) return "<b>Stop over the circle.</b> Let go of the right stick (GPS brakes for you), then steer with small taps of the arrows until the yellow cross under the drone is inside the circle.";
              return "<b>Descend:</b> hold " + KB("S") + " (left stick down) and touch down gently, slower than 1.5 m/s. Keep the yellow cross under the drone inside the circle.";
            },
            warn: () => outsideWarn(true),
            sub: () => zDist().toFixed(1) + " m from the centre (zone " + MISSION.r + " m) · " + flightSub() + " · sinking " + Math.max(0, -S.vel.y).toFixed(1) + " m/s",
            done: () => (S.ground && S.flew && holding() && zDist() <= MISSION.r) || !holding(),
            keys: () => (S.ground ? ["KeyW"] : hspd() > 0.8 ? ["ArrowDown"] : ["KeyS"]),
            ax: () => (S.ground ? ["axThr"] : hspd() > 0.8 ? ["axElv"] : ["axThr"]),
          }),
          release: () => ({
            id: "release",
            label: "Open claws",
            brief: "Open the claws with " + KB("Space") + ": <b>only inside the circle</b>, or the drop fails",
            t: () => (S.ground ? "<b>Open the claws:</b> press " + KB("Space") + " or the <b>OPEN CLAWS</b> button. You are " + zDist().toFixed(1) + " m from the centre: " + (zDist() <= MISSION.r && rightZone() ? "<span class=okc>inside the zone ✓</span>" : "<span class=bad>outside the zone: the drop would fail</span>") : "<b>Land first</b> (hold " + KB("S") + "), then open the claws with " + KB("Space") + "."),
            done: () => !holding(),
            hl: () => (S.ground ? ["#dropBtn"] : []),
            keys: () => (S.ground ? ["Space"] : ["KeyS"]),
            ax: () => (S.ground ? [] : ["axThr"]),
          }),
          home: () => ({
            id: "home",
            label: "Fly home",
            brief: "Fly home, land on the <b>H</b> pad and hold " + KB("S") + " until the motors stop",
            t: () => {
              const d = baseDist();
              if (S.ground && d < 8) return "<b>On the base pad.</b> Hold " + KB("S") + " (throttle down): the motors switch off after 2 seconds.";
              if (S.ground) return "<b>Delivered!</b> Take off with " + KB("W") + " and fly home to the base pad.";
              return "<b>Fly home:</b> the base pad (H) is <b>" + bearingTo(BASE).word + "</b>, " + Math.round(d) + " m away. Slow down early, land on the H and throttle down.";
            },
            sub: () => "base " + Math.round(baseDist()) + " m away · " + flightSub(),
            done: () => S.phase === "done" || S.ended,
            keys: () => (S.ground ? (baseDist() < 8 ? ["KeyS"] : ["KeyW"]) : baseDist() < 6 ? ["KeyS"] : steerKeys(BASE, baseDist())),
            ax: () => axFor(S.ground ? (baseDist() < 8 ? ["KeyS"] : ["KeyW"]) : baseDist() < 6 ? ["KeyS"] : steerKeys(BASE, baseDist())),
          }),
        };
        // tutorial-only steps
        const watch = (id, label, t, until, extra) => Object.assign({ id, label, t: () => t(), sub: () => phaseName() + " · " + flightSub(), done: until }, extra || {});
        const stillFor = (A, dt, key, ok, secs) => ((A[key] = ok ? (A[key] || 0) + dt : 0), A[key] >= secs);
        const turned = (A, T, dir) => ((A.yaw = (A.yaw || 0) + (S.in.yaw * dir > 0.3 && T.dPsi * dir > 0 ? Math.abs(T.dPsi) : 0)), A.yaw >= 80);
        function lessonSteps(n) {
          if (n === 0)
            return [
              ST.zone(),
              {
                id: "wp",
                label: "Waypoint",
                t: () => (settings.view !== "map" ? "Press " + KB("V") + " to show the map. " : "") + "<b>Add a waypoint:</b> click the map once, somewhere between the base (H) and the Meadow. The autopilot will fly through it. Drag a waypoint to move it; right-click removes it.",
                done: () => PLAN.wps.length >= 1,
                hl: ["#wpCtrl"],
                act: () => (settings.view !== "map" ? [{ txt: "🗺 Show the map (V)", fn: () => setView("map") }] : []),
              },
              {
                id: "rcheck",
                label: "Route check",
                t: () => "Read the <b>route check</b> under Waypoints. <span class=okc>✓ Route clear</span> means the drone can fly it. A <span class=bad>red line or ✗</span> means a no-fly zone or an obstacle on the way: drag the waypoint, or press <b>Remove last</b>.",
                warn: () => (ROUTECHK && !ROUTECHK.ok ? "The route is not clear yet: " + (ROUTECHK.issues.find((i) => i.k === "bad") || { t: "" }).t.replace(/^✗ /, "") : ""),
                done: (A) => !!(ROUTECHK && ROUTECHK.ok && A.next),
                next: true,
                hl: ["#wpCtrl"],
              },
              {
                id: "alt",
                label: "Altitude",
                t: () => "Set the <b>Altitude</b> to <b>High</b> (45 m): click High on the left or press " + KB("3") + ". High clears every tree and the radio mast; the climb and the descent take longer.",
                done: () => PLAN.alt === "high",
                hl: ["#altToggle"],
                keys: ["Digit3"],
              },
              ST.start(false),
              ST.arm(),
              watch("wTake", "Take-off", () => "<b>Watch the take-off:</b> the motors spin up and the drone climbs straight up to " + altH() + " m before it flies anywhere. Press " + KB("V") + " for the 3D view.", () => phaseAtLeast("route"), { keys: ["KeyV"], hl: ["#viewToggle"], prog: () => altNow() / altH() }),
              watch("wCruise", "Cruise", () => "<b>Cruise:</b> it follows the route through your waypoint at " + SPD[PLAN.spd].v + " m/s. Near the drop point it slows down early, because it needs room to stop. Try the cameras with " + KB("C") + ".", () => phaseAtLeast("descend"), { keys: ["KeyC"], hl: ["#camToggle"] }),
              watch("wDrop", "Set-down", () => "<b>Set-down:</b> it descends over the drop point, slows to about 0.6 m/s just before the parcel touches the ground, then opens the claws. The parcel must end up inside the circle.", () => !!S.pay.land),
              ST.apHome(),
            ];
          if (n === 1)
            return [
              ST.start(true),
              ST.arm(),
              ST.takeoff(12),
              {
                id: "hover",
                label: "Hover",
                t: () => "<b>Let go of " + KB("W") + ".</b> The throttle stick springs back to the middle and GPS holds the height. Hover still for 2 seconds.",
                sub: () => flightSub() + " · climb " + S.vel.y.toFixed(1) + " m/s",
                done: (A, dt) => stillFor(A, dt, "h", Math.abs(S.vel.y) < 0.4 && Math.abs(S.in.thr - 0.5) < 0.1, 2),
                prog: (A) => (A.h || 0) / 2,
                ax: ["axThr"],
              },
              { id: "yawR", label: "Turn right", t: () => "<b>Yaw right:</b> hold " + KB("D") + " (left stick right). The drone turns on the spot, without moving. Turn about 90°.", done: (A, dt, T) => turned(A, T, 1), prog: (A) => (A.yaw || 0) / 80, keys: ["KeyD"], ax: ["axRud"] },
              { id: "yawL", label: "Turn left", t: () => "<b>Yaw left:</b> hold " + KB("A") + " (left stick left) and turn back about 90°.", done: (A, dt, T) => turned(A, T, -1), prog: (A) => (A.yaw || 0) / 80, keys: ["KeyA"], ax: ["axRud"] },
              { id: "fwd", label: "Forward", t: () => "<b>Fly forward:</b> hold " + KB("↑") + " (right stick forward). The drone tilts its nose down and speeds up. Reach 4 m/s.", sub: flightSub, done: () => S.in.pit > 0.3 && hspd() >= 4, prog: () => hspd() / 4, keys: ["ArrowUp"], ax: ["axElv"] },
              { id: "brake", label: "Brake", t: () => "<b>Let go of " + KB("↑") + ".</b> GPS tilts the drone back to brake and stops it. Watch how far it still travels while it stops.", sub: flightSub, done: (A, dt) => stillFor(A, dt, "s", hspd() < 0.4 && Math.abs(S.in.pit) < 0.1, 1), ax: ["axElv"] },
              { id: "side", label: "Sideways", t: () => "<b>Fly sideways:</b> hold " + KB("→") + " (right stick right). The drone rolls and slides to the right without turning. Reach 2.5 m/s.", sub: flightSub, done: () => S.in.rol > 0.3 && hspd() >= 2.5, prog: () => hspd() / 2.5, keys: ["ArrowRight"], ax: ["axAil"] },
              { id: "stop", label: "Stop", t: () => "<b>Let go</b> and let GPS stop the drone again.", sub: flightSub, done: (A, dt) => stillFor(A, dt, "s", hspd() < 0.4 && Math.abs(S.in.rol) < 0.1, 1), ax: ["axAil"] },
              {
                id: "landL",
                label: "Land",
                t: () => "<b>Land:</b> hold " + KB("S") + " (left stick down) and touch down gently on the grass, slower than 1.5 m/s.",
                sub: () => flightSub() + " · sinking " + Math.max(0, -S.vel.y).toFixed(1) + " m/s",
                done: () => S.ground && S.flew,
                keys: ["KeyS"],
                ax: ["axThr"],
              },
            ];
          return [ST.start(true), ST.arm(), ST.takeoff(10), ST.fly(), ST.land(), ST.release(), ST.home()];
        }
        function guideSteps() {
          if (GAME.mode === "learn") return lessonSteps(GAME.lesson);
          if (PLAN.mode === "manual") return [ST.zone(), ST.start(true), ST.arm(), ST.takeoff(10), ST.fly(), ST.land(), ST.release(), ST.home()];
          return [ST.zone(), ST.route(), ST.start(false), ST.arm(), ST.apFly(), ST.apDrop(), ST.apHome()];
        }
        function guideSkip() {
          if (GAME.mode !== "learn" || S.ended) return;
          GUIDE.si++;
          GUIDE.A = {};
        }
        // the stick-practice lesson ends when the drone has landed: no delivery, no report
        function finishLesson() {
          if (S.ended) return;
          S.ended = true;
          S.running = false;
          sfx.motor(0, 0, false);
          sfx.chime();
          if (!GAME.demo) {
            PROG.learn[GAME.lesson] = true;
            saveProg();
          }
          addLog("Lesson " + (GAME.lesson + 1) + " complete: " + LESSONS[GAME.lesson].n, "ok");
          renderModePanel();
          updateButtons();
        }
        function switchGame(v) {
          const b = document.querySelector('#gameToggle [data-v="' + v + '"]');
          if (b) b.click();
        }
        const setHTML = (id, h) => {
          if (GUIDE.html[id] !== h) {
            GUIDE.html[id] = h;
            $(id).innerHTML = h;
          }
        };
        const val = (v) => (typeof v === "function" ? v() : v || []);
        function applyHL(hl, keys, ax) {
          const sig = hl.join() + "|" + keys.join() + "|" + ax.join();
          if (sig === GUIDE.hlSig) return;
          GUIDE.hlSig = sig;
          document.querySelectorAll(".ghl").forEach((e) => e.classList.remove("ghl"));
          document.querySelectorAll(".kc.pulse, .ax.pulse").forEach((e) => e.classList.remove("pulse"));
          hl.forEach((s) => document.querySelectorAll(s).forEach((e) => e.classList.add("ghl")));
          keys.forEach((k) => document.querySelectorAll('.kc[data-k="' + k + '"]').forEach((e) => e.classList.add("pulse")));
          ax.forEach((a) => $(a) && $(a).classList.add("pulse"));
          // bring a highlighted control on the left panel into view (only when that panel scrolls on its own)
          const card = document.querySelector(".card.controls");
          const el = hl.map((s) => document.querySelector(s)).find((e) => e && card.contains(e));
          if (el && card.scrollHeight > card.clientHeight + 4 && getComputedStyle(card).overflowY !== "visible") {
            const r = el.getBoundingClientRect(),
              cr = card.getBoundingClientRect();
            if (r.top < cr.top + 8 || r.bottom > cr.bottom - 8) card.scrollBy({ top: r.top - cr.top - cr.height * 0.3, behavior: "smooth" });
          }
        }
        $("gAct").addEventListener("click", (e) => {
          const b = e.target.closest("button");
          if (!b) return;
          b.blur();
          const a = GUIDE.acts[+b.dataset.i];
          if (a) a.fn();
        });
        // phones: move the guide out of the view to just below it
        function placeGuide() {
          const g = $("guide"),
            phone = innerWidth <= 760;
          const host = phone ? document.querySelector(".card.stage") : document.querySelector(".ovl");
          if (g.parentElement === host) return;
          if (phone) host.appendChild(g);
          else host.insertBefore(g, $("demoBar"));
        }
        placeGuide();
        addEventListener("resize", placeGuide);
        $("gMin").addEventListener("click", () => {
          GUIDE.min = !GUIDE.min;
          try {
            localStorage.setItem("skyparcel.guideMin", GUIDE.min ? "1" : "0");
          } catch (err) {}
        });
        function updateGuide() {
          const box = $("guide");
          const show = !GAME.demo;
          if (box.hidden === show) box.hidden = !show;
          if (!show) return applyHL([], [], []);
          const learn = GAME.mode === "learn";
          const key = [GAME.mode, GAME.level, GAME.lesson, PLAN.mode, PLAN.assist, MISSION.need, S.gen].join("|");
          if (key !== GUIDE.key) {
            Object.assign(GUIDE, { key, steps: guideSteps(), si: 0, latch: {}, A: {}, lastT: S.t, lastPsi: S.psi });
          }
          const steps = GUIDE.steps;
          const dt = Math.max(0, S.t - GUIDE.lastT);
          GUIDE.lastT = S.t;
          const T = { dPsi: wrapPi(S.psi - GUIDE.lastPsi) * R2D };
          GUIDE.lastPsi = S.psi;
          const res = S.result && S.result.res;
          const failed = S.crashed || !!S.dropFail || (!!S.failed && !/aborted/.test(S.failed)) || (res && res.status !== "success");
          let cur;
          if (learn) {
            const st = steps[GUIDE.si];
            if (st && !S.ended && !failed && !S.paused && st.done(GUIDE.A, dt, T)) {
              GUIDE.si++;
              GUIDE.A = {};
              if (GUIDE.si < steps.length) sfx.beep(880, 0.06);
            }
            if (GUIDE.si >= steps.length && !S.ended && LESSONS[GAME.lesson].endsSelf) finishLesson();
            cur = GUIDE.si;
          } else {
            // before Start: the first step not done yet. In flight: any later step done means the earlier ones are done too.
            const d = steps.map((st) => !!(GUIDE.latch[st.id] || st.done(GUIDE.A, dt, T)));
            if (S.started) {
              let hi = -1;
              d.forEach((x, i) => x && (hi = i));
              for (let i = 0; i <= hi; i++) GUIDE.latch[steps[i].id] = d[i] = true;
            }
            cur = d.indexOf(false);
            if (cur < 0) cur = steps.length;
          }
          // a failed drop: point at the step where it went wrong
          if (S.dropFail) {
            const k = steps.findIndex((s) => /^(release|drop|wDrop)$/.test(s.id));
            if (k >= 0) cur = k;
          }
          const modeName = learn ? "Tutorial · Lesson " + (GAME.lesson + 1) + " of " + LESSONS.length + ": " + LESSONS[GAME.lesson].short : (GAME.mode === "mission" ? "Mission " + GAME.level + " · " + LEVELS[GAME.level - 1].n : "Simulator") + " · " + (PLAN.mode === "manual" ? "Manual" : "Autopilot");
          let cls = "",
            title = modeName,
            count = "",
            now = "",
            warn = "",
            sub = "",
            acts = [],
            hl = [],
            keys = [],
            ax = [],
            prog = null;
          if (failed) {
            cls = "fail";
            const why = S.dropFail ? "Drop failed: " + S.dropFail : S.crashed ? "Crashed: " + S.reason : S.failed && !/aborted/.test(S.failed) ? S.failed : res ? res.reason : "";
            title = "✗ Mission failed · " + modeName;
            now = "<b>" + why + ".</b> " + (S.ended ? "Press <b>↺ Retry</b> " + KB("R") + " to fly the same plan again" + (learn ? "." : ", or change the plan first.") : "The mission ends in a moment.");
            if (S.ended) {
              acts = [{ txt: "↺ Retry (R)", fn: retry }];
              hl = ["#resetBtn"];
              keys = ["KeyR"];
            }
          } else if (S.ended && learn) {
            cls = "ok";
            const nx = GAME.lesson < LESSONS.length - 1;
            title = "✓ Lesson " + (GAME.lesson + 1) + " complete";
            now = nx ? "<b>Well done!</b> Next: <b>Lesson " + (GAME.lesson + 2) + " · " + LESSONS[GAME.lesson + 1].n + "</b>." : "<b>Tutorial complete!</b> Now try the <b>Missions</b>: eight rescue deliveries, from easy to hard.";
            acts = nx
              ? [{ txt: "▶ Next lesson", fn: () => (hideReport(), GAME.lesson++, newMission()) }, { txt: "↺ Do it again", fn: retry, sec: true }]
              : [{ txt: "▶ Go to the Missions", fn: () => (hideReport(), switchGame("mission")) }, { txt: "↺ Do it again", fn: retry, sec: true }];
          } else if (S.ended) {
            const aborted = S.failed && /aborted/.test(S.failed);
            cls = aborted ? "fail" : "ok";
            title = (aborted ? "Mission aborted · " : "✓ Mission complete · ") + modeName;
            now = aborted ? "<b>Mission aborted.</b> Press <b>↺ Retry</b> " + KB("R") + " to fly again." : "<b>Delivered and home.</b> The report shows your score. Press <b>↺ Retry</b> " + KB("R") + " to fly again, or change one setting and compare the runs.";
            acts = [{ txt: "↺ Retry (R)", fn: retry }];
            if (GAME.mode === "mission" && GAME.level < 8 && levelUnlocked(GAME.level + 1) && !aborted) acts.unshift({ txt: "▶ Next mission", fn: () => (hideReport(), GAME.level++, newMission()) });
            hl = ["#resetBtn"];
            keys = ["KeyR"];
          } else if (cur >= steps.length) {
            now = "<b>Finishing…</b> " + phaseName();
          } else {
            const st = steps[cur];
            count = "Step " + (cur + 1) + " of " + steps.length;
            now = st.t();
            warn = st.warn ? st.warn() : "";
            sub = st.sub ? st.sub() : "";
            acts = st.act ? st.act() : [];
            hl = val(st.hl);
            keys = val(st.keys);
            ax = val(st.ax);
            if (learn) {
              prog = st.prog ? clamp(st.prog(GUIDE.A), 0, 1) : null;
              if (st.next) acts.push({ txt: "Got it ›", fn: () => (GUIDE.A.next = true) });
              acts.push({ txt: "Skip step ›", fn: guideSkip, sec: true });
            }
            if (S.paused) {
              now = "<b>Paused.</b> Press <b>▶ Resume</b> " + KB("Enter") + " to carry on.";
              warn = sub = "";
              acts = [{ txt: "▶ Resume (Enter)", fn: startPause }];
              hl = ["#startBtn"];
              keys = ["Enter"];
              ax = [];
            }
          }
          const doneAll = S.ended && !failed;
          const chips = steps.map((st, i) => '<li class="' + (doneAll || i < cur ? "done" : i === cur ? (failed ? "fail" : "now") : "") + '"><i>' + (doneAll || i < cur ? "✓" : i === cur && failed ? "✗" : i + 1) + "</i>" + st.label + "</li>").join("");
          box.className = "guide" + (cls ? " " + cls : "") + (GUIDE.min ? " min" : "");
          setHTML("gTitle", title);
          setHTML("gCount", count);
          setHTML("gMin", GUIDE.min ? "More" : "Less");
          setHTML("gSteps", chips);
          setHTML("gNow", now);
          setHTML("gWarn", warn);
          setHTML("gSub", sub);
          GUIDE.acts = acts;
          setHTML("gAct", acts.map((a, i) => '<button type="button" data-i="' + i + '"' + (a.sec ? ' class="sec"' : "") + ">" + a.txt + "</button>").join(""));
          $("gBarBox").hidden = prog == null;
          if (prog != null) $("gBar").style.width = Math.round(prog * 100) + "%";
          applyHL(hl, keys, ax);
        }

        function updatePanels() {
          updateKeycaps();
          const st = S.result ? S.result.res.status : S.crashed || S.failed ? "failed" : null;
          const bs = $("bStatus");
          bs.textContent = st ? { success: "Success", missed: "Missed", failed: "Failed" }[st] : S.ended ? "Lesson done" : S.started ? (S.paused ? "Paused" : "In flight") : "Planning";
          bs.className = st ? stCls(st) : S.ended ? "c-ok" : S.started ? "c-info" : "c-idle";
          const bp = $("bPay");
          bp.textContent = { attached: "In the claws", falling: "Falling!", sliding: "Sliding", landed: "Delivered", lost: "Lost (lake)" }[S.pay.st];
          bp.className = S.pay.st === "attached" ? "c-info" : S.pay.st === "falling" || S.pay.st === "sliding" ? "c-warn" : S.pay.st === "lost" ? "c-bad" : "c-ok";
          $("dThr").textContent = S.started && S.armed && S.rpm > 0.31 ? Math.round(S.thr * 100) + "% of max" : S.armed ? "idle" : "motors off";
          $("dSw").textContent = S.claw > 0.6 ? "Open" : S.claw > 0.05 ? (S.clawT > 0 ? "Opening…" : "Closing…") : S.pay.st === "attached" ? "Closed · gripping " + curPay().m + " kg" : "Closed · empty";
          $("dPhase").textContent = phaseName();
          const manual = PLAN.mode === "manual";
          $("dAlt").textContent = altNow().toFixed(1) + " m" + (manual ? "" : " (plan " + altH() + " m)");
          $("dSpd").textContent = Math.hypot(S.vel.x, S.vel.z).toFixed(1) + " m/s" + (manual ? " · climb " + (S.vel.y >= 0 ? "+" : "") + S.vel.y.toFixed(1) : " (plan " + SPD[PLAN.spd].v + ")");
          $("dTgt").textContent = PLAN.aim ? Math.round(Math.hypot(S.pos.x - PLAN.aim.x, S.pos.z - PLAN.aim.z)) + " m" : "—";
          const w = windAt(S.pos.x, Math.max(S.pos.y, 2), S.pos.z, S.t);
          $("dWind").textContent = w.length() < 0.2 ? "Calm" : w.length().toFixed(1) + " m/s from " + CARD(Math.atan2(-w.x, w.z) * R2D);
          $("dBat").textContent = Math.round(S.bat * 100) + "%";
          $("dTime").textContent = fmtT(S.t);
          const L = S.pay.land;
          $("accVal").textContent = L ? (L.wet ? "Splash" : L.d.toFixed(1) + " m") : S.pay.st === "falling" ? "falling…" : "—";
          $("accSub").textContent = L ? (L.wet ? "Fell into the lake" : (L.d <= MISSION.r ? "inside" : "outside") + " the " + MISSION.r + " m zone · " + (L.setd ? "set down at " : "fell " + L.fall.toFixed(1) + " m, hit at ") + L.v.toFixed(1) + " m/s, " + L.cond) : S.pay.st === "falling" ? "Payload falling" : S.pay.st === "sliding" ? "Payload sliding to a stop" : "Not delivered yet";
          drawDropView($("accCv"), false);
          const fb = $("accFb");
          if (S.result) {
            const t = S.result.res.fb[0];
            fb.textContent = t ? t.b : S.result.res.reason;
            fb.className = "fb " + (S.result.res.status === "success" ? "ok" : "bad");
          } else if (L && !L.wet && L.d <= MISSION.r) {
            fb.textContent = "Inside the zone. Now fly home and land on the base pad.";
            fb.className = "fb ok";
          } else {
            fb.textContent = "";
            fb.className = "fb";
          }
          $("dropBtn").hidden = !(PLAN.mode === "manual" && !GAME.demo && S.started && !S.ended && S.pay.st === "attached" && S.flew && S.ground && S.armed);
          {
            const db = $("dropBtn");
            if (!db.hidden) {
              const d = zDist(),
                inside = d <= MISSION.r && rightZone();
              db.classList.toggle("in", inside);
              db.classList.toggle("out", !inside);
              const t = inside ? "inside the zone · " + d.toFixed(1) + " m from the centre" : !rightZone() ? "wrong drop zone: the drop will FAIL" : d.toFixed(1) + " m from the centre: outside the zone, the drop will FAIL";
              if ($("dropSub").textContent !== t) $("dropSub").textContent = t;
            }
          }
          updateGuide();
          updateBanner();
          updateDemoBar();
          renderObjectives();
          $("planState").textContent = S.started ? (S.ended ? "finished" : "locked in flight") : "planning";
        }
        function chipText() {
          if (!S.started) return PLAN.target ? "<b>Planning:</b> " + (PLAN.mode === "manual" ? "fly by hand to the " : PLAN.wps.length ? PLAN.wps.length + " waypoint" + (PLAN.wps.length > 1 ? "s" : "") + " to the " : "straight to the ") + tgtZone().n + ". Press <b>Start</b> (Enter) or arm (S + D)." : "<b>Planning:</b> pick a drop zone on the map.";
          if (S.ended) return "<b>Mission over.</b> Retry (R) or edit the plan.";
          if (S.paused) return "<b>Paused.</b> Press Resume or Enter.";
          if (!S.armed && !S.armedOnce && S.phase === "pad") return S.armHold > 0 ? "<b>Arming…</b> keep holding S + D" : "<b>Arm the motors:</b> hold <b>S + D</b> for one second, or flip the ARM switch (<b>E</b>)";
          if (S.phase === "manual" || (PLAN.mode === "manual" && S.phase === "pad")) {
            const z = tgtZone();
            const dz = Math.hypot(S.pos.x - z.x, S.pos.z - z.z);
            if (!S.armed) return "<b>Motors off.</b> Arm again (S + D) to take off.";
            if (S.pay.st === "attached") {
              if (S.ground && dz <= MISSION.r * 1.5) return "<b>On the ground in the zone</b> (" + dz.toFixed(1) + " m from the centre): press <b>Space</b> to open the claws";
              if (S.ground && !S.flew) return "<b>Armed.</b> Throttle up (<b>W</b>) to take off";
              if (dz < 30) return "<b>Over the zone:</b> " + dz.toFixed(1) + " m from the centre · stop, then descend (S) and land";
              return "<b>Fly to the " + z.n + ":</b> " + Math.round(dz) + " m · ↑ forward, A / D turn, W / S height";
            }
            const dB = Math.hypot(S.pos.x - BASE.x, S.pos.z - BASE.z);
            if (S.ground && dB < 8) return "<b>On the base pad.</b> Throttle down: the motors disarm in a moment";
            return "<b>Delivered!</b> Fly home: the base is " + Math.round(dB) + " m away";
          }
          return "<b>" + phaseName() + "</b>" + (S.phase === "route" ? " · leg " + Math.min(pathAt(S.P, S.s).i, PLAN.wps.length + 1) + " of " + (PLAN.wps.length + 1) : "");
        }
        const kcEls = [...document.querySelectorAll(".kc[data-k]")];
        function updateKeycaps() {
          const now = performance.now();
          const dk = GAME.demo && S.started ? DK.amt : {};
          for (const el of kcEls) {
            const k = el.dataset.k;
            const on = !!(keys[k] || (dk[k] || 0) > 0.15 || (flash[k] && now - flash[k] < 260));
            if (el.classList.contains("on") !== on) el.classList.toggle("on", on);
          }
        }

        /* ================= demo: a good plan, flown by the autopilot or by the demo pilot on the sticks ================= */
        function demoSpec() {
          if (GAME.mode === "mission") return LEVELS[GAME.level - 1].demo;
          if (PLAN.mode === "manual") return { target: PLAN.target || "meadow", wps: PLAN.wps.map((w) => [w.x, w.z]), alt: "low", spd: "med", pay: PLAN.pay, mode: "manual", assist: PLAN.assist, why: "the demo pilot flies it by hand with " + ASSIST[PLAN.assist].n + " assist: climb, fly over, stop, land, open the claws, fly home" };
          return MISSION.wind.spd
            ? { target: PLAN.target || "meadow", wps: [], alt: "low", spd: "slow", pay: "heavy", mode: "auto", why: "in wind, Low and Slow with a Heavy payload: a short, steady descent over the drop point" }
            : { target: PLAN.target || "meadow", wps: [], alt: "med", spd: "med", pay: "med", mode: "auto", why: "a straight, clear route at Medium height: the autopilot stops over the drop point and lands the payload" };
        }
        const DEMO = { why: "" };
        function demoStart() {
          if (S.started) retry();
          hideReport();
          hideStartCard();
          const sp = demoSpec();
          GAME.demo = false;
          PLAN.target = sp.target;
          const z = zoneOf(sp.target);
          PLAN.aim = { x: z.x, z: z.z };
          PLAN.wps = sp.wps.map(([x, zz]) => ({ x, z: zz }));
          for (const k of ["alt", "spd", "pay", "mode"]) PLAN[k] = MISSION.lock[k] || sp[k];
          PLAN.assist = MISSION.lock.assist || sp.assist || "gps";
          setParcel();
          layoutZones();
          planChanged();
          renderZoneList();
          DEMO.why = sp.why;
          RW.hist = [];
          resetFlight();
          if (!startMission(true)) return;
          GAME.demo = true;
          GAME.demoDone = false;
          setCam("chase");
          toast("Demo: " + sp.why + ".", "info");
          addLog("Demo: " + (PLAN.mode === "auto" ? "Autopilot, " + ALT[PLAN.alt].n + " altitude, " + SPD[PLAN.spd].n + " speed" : "the demo pilot flies by hand, " + ASSIST[PLAN.assist].n + " assist") + ", " + PAY[PLAN.pay].n + " payload" + (PLAN.wps.length ? ", " + PLAN.wps.length + " waypoints" : ""), "");
          updateButtons();
        }
        function demoStopQuiet() {
          if (!GAME.demo) return;
          GAME.demo = false;
          RW.on = false;
        }
        // hand the drone to the pilot, in the air or on the ground (from a demo or from the autopilot)
        function takeOver(why) {
          if (!S.started || S.ended || S.phase === "crash") return;
          if (MISSION.lock.mode === "auto") return toast("This mission is flown by the autopilot 🔒", "info", "lkmode", 2);
          if (S.phase === "hover") return toast("The failsafe is landing the drone: it cannot be flown by hand now.", "info", "hov", 2);
          const wasDemo = GAME.demo;
          demoStopQuiet();
          if (RW.on) rwStop();
          if (PLAN.mode === "auto") S.override = true;
          PLAN.mode = "manual";
          S.in.yaw = S.in.pit = S.in.rol = 0;
          S.in.thr = PLAN.assist === "off" ? hoverThr() : 0.5;
          S.hold.on = S.hold.yOn = false;
          if (S.armed) S.phase = S.phase === "done" ? "done" : "manual";
          else if (S.phase !== "done") S.phase = "pad";
          S.paused = false;
          addLog(wasDemo ? "Demo stopped: you have the controls (Manual, " + ASSIST[PLAN.assist].n + " assist)" : "Manual control: the autopilot hands the drone to you (" + ASSIST[PLAN.assist].n + " assist)", "warn");
          toast("You have control" + (why === "T" ? "" : "") + ": " + ASSIST[PLAN.assist].n + " assist. Let go of the sticks and it " + (PLAN.assist === "gps" ? "holds its position." : PLAN.assist === "atti" ? "holds its height." : "keeps the throttle you set."), "info");
          planChanged();
          updateButtons();
        }
        $("demoStop").addEventListener("click", () => {
          demoStopQuiet();
          retry();
          toast("Demo stopped. The demo's plan is still on the map: change it and fly your own.", "info");
        });
        $("demoTake").addEventListener("click", () => takeOver("button"));
        $("demoPause").addEventListener("click", () => {
          if (GAME.demo && S.started && !S.ended) startPause();
        });
        function updateDemoBar() {
          const bar = $("demoBar");
          const on = GAME.demo && S.started && !S.ended;
          if (bar.hidden !== !on) bar.hidden = !on;
          if (!on) return;
          const manual = PLAN.mode === "manual";
          $("demoTitle").textContent = manual ? "Demo pilot · Manual " + ASSIST[PLAN.assist].n : "Autopilot demo";
          $("demoTake").hidden = MISSION.lock.mode === "auto";
          $("demoPause").textContent = S.paused ? "▶ Resume" : "❚❚ Pause";
          $("demoRew").disabled = RW.hist.length < 2 && !RW.on;
          let act = "";
          const ph = S.phase;
          if (RW.on) act = "Rewinding at double speed… let go to stop here (the demo stays paused).";
          else if (S.paused) act = "Paused. Press Resume to keep watching, Take control to fly on from here, or Stop.";
          else if (ph === "pad" && !S.armed) act = "Arming: holding the left stick down and to the right (S + D) for one second.";
          else if (ph === "spool") act = "Armed: the motors spin up at idle before take-off.";
          else if (ph === "takeoff") act = (manual ? "Throttle up (W): " : "") + "climbing straight up to " + altH() + " m.";
          else if (ph === "route") act = (manual ? "Right stick forward (↑), yaw (A / D) to face the target: " : "Following the route at " + SPD[PLAN.spd].v + " m/s") + (PLAN.wps.length ? (manual ? "" : ": ") + "leg " + Math.min(pathAt(S.P, S.s).i, PLAN.wps.length + 1) + " of " + (PLAN.wps.length + 1) : manual ? "flying to the drop point." : " straight to the drop point") + ".";
          else if (ph === "approach") act = manual ? "Easing off the stick early: the loaded drone needs about " + ((S.vel.lengthSq() || 0) / (2 * brakeA(true))).toFixed(0) + " m to stop." : "Slowing down to stop exactly over the drop point.";
          else if (ph === "descend") act = (manual ? "Throttle down (S), " + (PLAN.assist === "gps" ? "GPS holds the spot" : "right stick leaning into the wind to stay put") + ": " : "Descending: ") + altNow().toFixed(1) + " m to go, slowing for a gentle touch-down.";
          else if (ph === "setdown") act = S.pay.st === "attached" ? "Touched down: the payload stands on the ground. Opening the claws" + (manual ? " (Space)." : ".") : "Claws open: the payload is delivered.";
          else if (ph === "climb") act = "Climbing away empty, back up to " + altH() + " m.";
          else if (ph === "ret") act = "Returning to base along the route.";
          else if (ph === "land") act = "Landing on the base pad.";
          else if (ph === "disarm") act = "Landed: disarming with the left stick down and to the left (S + A).";
          else act = phaseName();
          $("demoAct").textContent = act;
          const cells = [
            ["Plan", (manual ? "Manual " + ASSIST[PLAN.assist].n : "Autopilot · " + ALT[PLAN.alt].n + " · " + SPD[PLAN.spd].n) + " · " + PAY[PLAN.pay].n],
            ["Claws", S.pay.st === "attached" ? "gripping" : "open · delivered"],
            ["Why", DEMO.why],
          ];
          $("demoGrid").innerHTML = cells.map(([k, v]) => "<span>" + k + " <b>" + v + "</b></span>").join("");
        }
        // which keyboard keys the demo pilot's stick moves correspond to, and how hard (0..1)
        const DK = { amt: {} };
        function demoKeys() {
          const a = DK.amt,
            I = S.in;
          const ease = (k, v) => (a[k] = (a[k] || 0) + (clamp(v, 0, 1) - (a[k] || 0)) * 0.35);
          const off = PLAN.mode === "manual" && PLAN.assist === "off";
          const tc = off ? 0 : I.thr - 0.5;
          ease("KeyW", (tc - 0.04) * 3);
          ease("KeyS", (off ? (I.thr < 0.08 ? 1 : 0) : -tc - 0.04) * 3);
          ease("KeyD", (I.yaw - 0.06) * 1.5);
          ease("KeyA", (-I.yaw - 0.06) * 1.5);
          ease("ArrowUp", (I.pit - 0.06) * 1.5);
          ease("ArrowDown", (-I.pit - 0.06) * 1.5);
          ease("ArrowRight", (I.rol - 0.06) * 1.5);
          ease("ArrowLeft", (-I.rol - 0.06) * 1.5);
          return a;
        }
        const dkEls = [...document.querySelectorAll("#demoBar [data-dk]")];
        function updateDemoSticks() {
          if ($("demoBar").hidden) return;
          const a = demoKeys();
          dkEls.forEach((el) => {
            const v = a[el.dataset.dk] || 0;
            el.style.setProperty("--k", v.toFixed(2));
            el.classList.toggle("on", v > 0.15);
          });
          const h = 22,
            I = S.in;
          $("dsL").style.transform = "translate(" + (I.yaw * h).toFixed(1) + "px," + ((1 - 2 * I.thr) * h).toFixed(1) + "px)";
          $("dsR").style.transform = "translate(" + (I.rol * h).toFixed(1) + "px," + (-I.pit * h).toFixed(1) + "px)";
        }

        /* ---------- rewind (demo): snapshots of the flight, played back in reverse ---------- */
        const RW = { on: false, hist: [], n: 0, acc: 0 };
        const RW_ARR = ["trail", "samples", "log"];
        function rwCopy(v, d) {
          if (v && v.isVector3) return v.clone();
          if (Array.isArray(v)) return d < 4 ? v.map((x) => rwCopy(x, d + 1)) : v.slice();
          if (v && typeof v === "object" && Object.getPrototypeOf(v) === Object.prototype) {
            const o = {};
            for (const k in v) o[k] = rwCopy(v[k], d + 1);
            return o;
          }
          return v;
        }
        function rwRecord() {
          if (!GAME.demo || RW.on || !S.started || S.ended) return;
          if (++RW.n % 2) return;
          const z = {};
          for (const k in S) if (k !== "P" && k !== "R") z[k] = RW_ARR.includes(k) ? S[k].length : rwCopy(S[k], 0);
          z.P = S.P;
          z.R = S.R;
          RW.hist.push(z);
          if (RW.hist.length > 60 * 180) RW.hist.shift();
        }
        function rwRestore(z) {
          for (const k in z) {
            if (RW_ARR.includes(k)) {
              if (S[k].length > z[k]) S[k].length = z[k];
            } else if (k === "P" || k === "R") S[k] = z[k];
            else S[k] = rwCopy(z[k], 0);
          }
        }
        function rwTick(dt) {
          if (!RW.on) return;
          RW.acc += dt * 60 * 2;
          let z = null;
          while (RW.acc >= 1 && RW.hist.length > 1) {
            RW.acc -= 1;
            z = RW.hist.pop();
          }
          if (RW.hist.length <= 1) z = RW.hist[0] || z;
          if (z) rwRestore(z);
          vis.snapCam = true;
        }
        function rwStart() {
          if (!GAME.demo || !S.started || S.ended || RW.hist.length < 2) return;
          RW.on = true;
          RW.acc = 0;
          $("demoRew").classList.add("on");
        }
        function rwStop() {
          if (!RW.on) return;
          RW.on = false;
          $("demoRew").classList.remove("on");
          if (GAME.demo && S.started && !S.ended && !S.paused) {
            S.paused = true;
            updateButtons();
          }
        }
        {
          const b = $("demoRew");
          b.addEventListener("pointerdown", (e) => {
            e.preventDefault();
            b.setPointerCapture(e.pointerId);
            rwStart();
          });
          ["pointerup", "pointercancel", "lostpointercapture"].forEach((ev) => b.addEventListener(ev, rwStop));
          b.addEventListener("contextmenu", (e) => e.preventDefault());
        }

        /* ================= drag the 3D view to look around ================= */
        {
          const el = $("gl");
          const setCursor = () => {
            el.style.cursor = settings.drag ? (VIEW.drag ? "grabbing" : "grab") : "";
            el.style.touchAction = settings.drag ? "none" : "";
          };
          el.addEventListener("pointerdown", (e) => {
            if (!settings.drag || e.button !== 0) return;
            e.preventDefault();
            el.setPointerCapture(e.pointerId);
            VIEW.drag = { x: e.clientX, y: e.clientY };
            setCursor();
          });
          el.addEventListener("pointermove", (e) => {
            if (!VIEW.drag) return;
            const k = 0.005 * (settings.cam === "base" ? Math.max(camera.fov, 8) / 60 : 1);
            VIEW.yaw -= (e.clientX - VIEW.drag.x) * k;
            VIEW.pitch = clamp(VIEW.pitch + (e.clientY - VIEW.drag.y) * k, -1.4, 1.4);
            VIEW.drag.x = e.clientX;
            VIEW.drag.y = e.clientY;
          });
          const up = () => {
            VIEW.drag = null;
            setCursor();
          };
          el.addEventListener("pointerup", up);
          el.addEventListener("pointercancel", up);
          el.addEventListener("dblclick", () => (VIEW.yaw = VIEW.pitch = 0));
          setCursor();
        }

        /* ================= transmitter: keyboard, mouse-dragged sticks and USB gamepads ================= */
        const FLY = { KeyW: 1, KeyS: 1, KeyA: 1, KeyD: 1, ArrowUp: 1, ArrowDown: 1, ArrowLeft: 1, ArrowRight: 1, KeyI: 1, KeyK: 1, KeyJ: 1, KeyL: 1 };
        const ALIAS = { KeyI: "ArrowUp", KeyK: "ArrowDown", KeyJ: "ArrowLeft", KeyL: "ArrowRight" };
        const keyT = {};
        const drag = { L: false, R: false };
        const springThr = () => !(PLAN.mode === "manual" && PLAN.assist === "off");
        window.addEventListener("keydown", (e) => {
          if (e.target && (e.target.tagName === "INPUT" || e.target.tagName === "TEXTAREA")) {
            if (e.target.type !== "range") return;
            e.target.blur();
          }
          if (!$("report").hidden && e.key === "Escape") return hideReport();
          const c = e.code;
          const handled = () => e.preventDefault();
          if (e.key === "Shift") keys.Shift = true;
          if (FLY[c]) {
            e.preventDefault();
            if (GAME.demo && S.started && !S.ended && !RW.on) {
              if (MISSION.lock.mode === "auto") return toast("This mission is flown by the autopilot. Press Stop to plan your own.", "info", "lkmode", 3);
              takeOver("key");
            }
            if (!e.repeat) {
              keyT[c] = performance.now();
              // assist Off: the throttle stays where you leave it; a tap moves it 5 %
              if (!springThr() && c === "KeyW") S.in.thr = clamp(Math.round((S.in.thr + 0.05) * 20) / 20, 0, 1);
              if (!springThr() && c === "KeyS") S.in.thr = clamp(Math.round((S.in.thr - 0.05) * 20) / 20, 0, 1);
            }
            keys[ALIAS[c] || c] = true;
            if (PLAN.mode === "auto" && S.started && !S.ended && S.armed && !GAME.demo && !(c === "KeyS" || c === "KeyA" || c === "KeyD")) toast("The autopilot is flying. Press T to take manual control.", "info", "apfly", 4);
            return;
          }
          if (e.repeat && c !== "Backspace") return;
          flash[c] = performance.now();
          const map = { Digit1: ["alt", "low"], Digit2: ["alt", "med"], Digit3: ["alt", "high"], Digit4: ["spd", "slow"], Digit5: ["spd", "med"], Digit6: ["spd", "fast"], Digit7: ["pay", "light"], Digit8: ["pay", "med"], Digit9: ["pay", "heavy"] };
          const np = c.startsWith("Numpad") ? "Digit" + c.slice(6) : c;
          if (map[np]) {
            flash[np] = performance.now();
            setPlan(map[np][0], map[np][1]);
            return handled();
          }
          if (c === "KeyT") return setPlan("mode", PLAN.mode === "auto" ? "manual" : "auto"), handled();
          if (c === "KeyH") return setPlan("assist", { gps: "atti", atti: "off", off: "gps" }[PLAN.assist]), handled();
          if (c === "KeyE") return armSwitch(), handled();
          if (c === "KeyG") return setDrone(PLAN.drone === "quad" ? "hexa" : "quad"), handled();
          if (c === "Backspace") return removeLastWp(), handled();
          if (c === "Space") return releasePayload("manual"), handled();
          if (c === "Enter" || c === "NumpadEnter") {
            const ae = document.activeElement;
            if (ae && ae.closest && ae.closest("#report, .floatwin")) return;
            return startPause(), handled();
          }
          if (c === "KeyR") return retry(), handled();
          if (c === "KeyV") return setView(settings.view === "map" ? "3d" : "map"), handled();
          if (c === "KeyC") return setCam({ chase: "top", top: "cam", cam: "base", base: "chase" }[settings.cam]), handled();
          if (c === "KeyM") return toggleMute();
          if (c === "Minus" || c === "NumpadSubtract") return setVolume(settings.volume - 0.1);
          if (c === "Equal" || c === "NumpadAdd") return setVolume(settings.volume + 0.1);
        });
        window.addEventListener("keyup", (e) => {
          if (e.key === "Shift") keys.Shift = false;
          if (FLY[e.code]) keys[ALIAS[e.code] || e.code] = false;
        });
        window.addEventListener("blur", () => Object.keys(keys).forEach((k) => (keys[k] = false)));
        // the ARM switch: on arms (on the ground, throttle down), off disarms (on the ground only)
        function armSwitch() {
          flash.KeyE = performance.now();
          sfx.init();
          if (GAME.demo && S.started && !S.ended) return toast("The demo is flying. Press Take control or Stop first.", "info", "demoarm", 2);
          if (S.ended) retry();
          if (S.armed) disarm("switch");
          else arm("switch");
        }
        $("armBtn").addEventListener("click", armSwitch);
        function bindStick(el, side) {
          const move = (e) => {
            if (!drag[side]) return;
            const r = el.getBoundingClientRect();
            const half = r.width / 2 - 15;
            const nx = clamp((e.clientX - (r.left + r.width / 2)) / half, -1, 1);
            const ny = clamp((e.clientY - (r.top + r.height / 2)) / half, -1, 1);
            if (side === "L") {
              S.in.yaw = nx;
              S.in.thr = clamp((1 - ny) / 2, 0, 1);
            } else {
              S.in.rol = nx;
              S.in.pit = -ny;
            }
          };
          el.addEventListener("pointerdown", (e) => {
            e.preventDefault();
            el.setPointerCapture(e.pointerId);
            if (GAME.demo && S.started && !S.ended) {
              if (MISSION.lock.mode === "auto") return;
              takeOver("stick");
            }
            drag[side] = true;
            move(e);
          });
          el.addEventListener("pointermove", move);
          const up = () => (drag[side] = false);
          el.addEventListener("pointerup", up);
          el.addEventListener("pointercancel", up);
        }
        bindStick($("stickL"), "L");
        bindStick($("stickR"), "R");
        let gpBase = null,
          gpLive = false,
          gamepadOn = false;
        function updateInputs(dt) {
          if (GAME.demo && S.started && !S.ended) return; // the demo pilot has the sticks
          const MOVE = 2.6,
            BACK = 5;
          const fine = keys.Shift ? 0.5 : 1;
          const ax = (neg, pos) => (keys[pos] ? 1 : 0) - (keys[neg] ? 1 : 0);
          const I = S.in;
          let gp = null;
          if (navigator.getGamepads) {
            for (const g of navigator.getGamepads()) if (g && g.connected && g.axes.length >= 4) gp = g;
          }
          if (!!gp !== gamepadOn) {
            gamepadOn = !!gp;
            gpBase = gp ? gp.axes.slice() : null;
            gpLive = false;
          }
          // a gamepad only takes over once you move one of its sticks (some rest at full throttle)
          if (gp && !gpLive && gpBase && gp.axes.some((v, i) => Math.abs(v - gpBase[i]) > 0.25)) gpLive = true;
          const gpTxt = "USB transmitter / gamepad: " + (!gp ? "not connected" : gpLive ? "<b>in use</b>" : "connected (move a stick to use it)");
          if ($("gpad").innerHTML !== gpTxt) $("gpad").innerHTML = gpTxt;
          if (gp && gpLive) {
            const dz = (v) => (Math.abs(v) < 0.06 ? 0 : v);
            I.yaw = dz(gp.axes[0]);
            I.thr = clamp((1 - gp.axes[1]) / 2, 0, 1);
            I.rol = dz(gp.axes[2]);
            I.pit = -dz(gp.axes[3]);
            return;
          }
          if (!drag.L) {
            const r = ax("KeyA", "KeyD") * fine;
            I.yaw = r ? approachV(I.yaw, r, MOVE, dt) : approachV(I.yaw, 0, BACK, dt);
            if (springThr()) {
              const t = keys.KeyW ? 0.5 + 0.5 * fine : keys.KeyS ? 0.5 - 0.5 * fine : 0.5;
              I.thr = approachV(I.thr, t, keys.KeyW || keys.KeyS ? MOVE : BACK, dt);
            } else {
              const now = performance.now();
              if (keys.KeyW && now - (keyT.KeyW || 0) > 300) I.thr = clamp(I.thr + 0.3 * fine * dt, 0, 1);
              if (keys.KeyS && now - (keyT.KeyS || 0) > 300) I.thr = clamp(I.thr - 0.3 * fine * dt, 0, 1);
            }
          }
          if (!drag.R) {
            const a = ax("ArrowLeft", "ArrowRight") * fine;
            const p = ax("ArrowDown", "ArrowUp") * fine;
            I.rol = a ? approachV(I.rol, a, MOVE, dt) : approachV(I.rol, 0, BACK, dt);
            I.pit = p ? approachV(I.pit, p, MOVE, dt) : approachV(I.pit, 0, BACK, dt);
          }
        }
        // the transmitter on screen: stick positions, channel bars, ARM switch and what the assist is doing
        const setBar = (el, v) => {
          const w = Math.abs(v) * 50;
          el.style.left = (v >= 0 ? 50 : 50 - w) + "%";
          el.style.width = w + "%";
        };
        function updateTx() {
          const I = S.in;
          const gl = $("stickL").clientWidth / 2 - 15;
          $("knobL").style.transform = "translate(" + I.yaw * gl + "px," + (1 - 2 * I.thr) * gl + "px)";
          $("knobR").style.transform = "translate(" + I.rol * gl + "px," + -I.pit * gl + "px)";
          const spring = springThr();
          const tt = I.thr - 0.5;
          if (spring) setBar($("cbThr"), tt * 2);
          else {
            $("cbThr").style.left = "0";
            $("cbThr").style.width = I.thr * 100 + "%";
          }
          setBar($("cbRud"), I.yaw);
          setBar($("cbElv"), I.pit);
          setBar($("cbAil"), I.rol);
          const pct = (v) => Math.round(Math.abs(v) * 100) + "%";
          $("cvThr").textContent = spring ? (Math.abs(tt) < 0.05 ? "Hold" : (tt > 0 ? "Climb " : "Descend ") + pct(tt * 2)) : Math.round(I.thr * 100) + "%";
          $("cvRud").textContent = Math.abs(I.yaw) < 0.05 ? "Centre" : (I.yaw > 0 ? "Right " : "Left ") + pct(I.yaw);
          $("cvElv").textContent = Math.abs(I.pit) < 0.05 ? "Neutral" : (I.pit > 0 ? "Fwd " : "Back ") + pct(I.pit);
          $("cvAil").textContent = Math.abs(I.rol) < 0.05 ? "Neutral" : (I.rol > 0 ? "Right " : "Left ") + pct(I.rol);
          const ab = $("armBtn");
          if (ab.classList.contains("on") !== S.armed) {
            ab.classList.toggle("on", S.armed);
            ab.setAttribute("aria-pressed", String(S.armed));
          }
          const at = S.armed ? "ARMED" : "DISARMED";
          if ($("armTxt").textContent !== at) $("armTxt").textContent = at;
          const hold = S.armed ? S.disHold : S.armHold;
          $("armBarBox").classList.toggle("show", hold > 0);
          $("armBarBox").classList.toggle("dis", S.armed);
          $("armBar").style.width = Math.min(100, hold * 100) + "%";
          let info;
          const hs = Math.hypot(S.vel.x, S.vel.z);
          if (PLAN.mode === "auto") info = S.armed ? "<b>Autopilot in command.</b> The sticks are not used in flight. Press <b>T</b> to take manual control." : "<b>Autopilot.</b> Arm with the sticks (hold S + D) or the ARM switch (E); then it flies itself.";
          else if (!S.armed) info = "<b>" + ASSIST[PLAN.assist].n + " assist.</b> Arm first: hold S + D (left stick down-right) for one second, or press E.";
          else if (S.phase === "hover") info = "<b>Failsafe:</b> the flight controller is landing the drone.";
          else if (PLAN.assist === "gps") info = "<b>GPS:</b> " + (S.ground ? "on the ground. Throttle up (W) to take off." : S.hold.on ? "sticks centred: holding this spot and height." : "flying " + hs.toFixed(1) + " m/s. Let go to brake and hold.");
          else if (PLAN.assist === "atti") {
            const w = windAt(S.pos.x, S.pos.y, S.pos.z, S.t).length();
            info = "<b>ATTI:</b> " + (S.ground ? "on the ground. Throttle up (W) to take off." : "holding height only. Drifting " + hs.toFixed(1) + " m/s" + (w > 0.5 ? " in " + w.toFixed(1) + " m/s wind: lean into it." : "."));
          } else info = "<b>Off:</b> throttle " + Math.round(I.thr * 100) + "% · it hovers at about " + Math.round(hoverThr() * 100) + "% with this load. Nothing is held for you.";
          if ($("assistInfo").innerHTML !== info) $("assistInfo").innerHTML = info;
        }

        /* ================= volume ================= */
        function toggleMute() {
          settings.sound = !settings.sound;
          flash.KeyM = performance.now();
          refreshSound();
        }
        function setVolume(v) {
          settings.volume = clamp(Math.round(v * 20) / 20, 0, 1);
          if (settings.volume > 0) settings.sound = true;
          refreshSound();
        }
        function refreshSound() {
          const v = settings.sound ? settings.volume : 0;
          $("soundBtn").textContent = v === 0 ? "🔇" : v < 0.4 ? "🔈" : v < 0.75 ? "🔉" : "🔊";
          $("soundBtn").setAttribute("aria-pressed", String(!settings.sound));
          $("volSlider").value = Math.round(settings.volume * 100);
          $("volVal").textContent = settings.sound ? Math.round(settings.volume * 100) + "%" : "Muted";
          sfx.setVolume(v);
        }
        $("soundBtn").addEventListener("click", toggleMute);
        $("volSlider").addEventListener("input", (e) => {
          settings.volume = e.target.value / 100;
          settings.sound = settings.volume > 0;
          refreshSound();
        });

        /* ================= main loop ================= */
        refreshSound();
        setCam("chase");
        renderModePanel();
        applyMission(true);
        showStartCard();
        setView("map");
        resize();
        updateButtons();
        const H = 1 / 120;
        // physics runs at a fixed 120 steps/s; the picture is drawn between the last two steps so motion is smooth
        const PV = { ok: false, pos: V3(0, 0, 0), psi: 0, tiltF: 0, tiltR: 0, claw: 0, pay: V3(0, 0, 0), paySt: "" },
          CUR = { pos: V3(0, 0, 0), psi: 0, tiltF: 0, tiltR: 0, claw: 0, pay: V3(0, 0, 0) };
        function savePrev() {
          PV.pos.copy(S.pos);
          PV.psi = S.psi;
          PV.tiltF = S.tiltF;
          PV.tiltR = S.tiltR;
          PV.claw = S.claw;
          PV.pay.copy(S.pay.pos);
          PV.paySt = S.pay.st;
          PV.ok = true;
        }
        function applyBlend(a) {
          CUR.pos.copy(S.pos);
          CUR.psi = S.psi;
          CUR.tiltF = S.tiltF;
          CUR.tiltR = S.tiltR;
          CUR.claw = S.claw;
          CUR.pay.copy(S.pay.pos);
          S.pos.lerpVectors(PV.pos, CUR.pos, a);
          S.psi = PV.psi + wrapPi(CUR.psi - PV.psi) * a;
          S.tiltF = lerp(PV.tiltF, CUR.tiltF, a);
          S.tiltR = lerp(PV.tiltR, CUR.tiltR, a);
          S.claw = lerp(PV.claw, CUR.claw, a);
          if (PV.paySt === S.pay.st) S.pay.pos.lerpVectors(PV.pay, CUR.pay, a);
        }
        function undoBlend() {
          S.pos.copy(CUR.pos);
          S.psi = CUR.psi;
          S.tiltF = CUR.tiltF;
          S.tiltR = CUR.tiltR;
          S.claw = CUR.claw;
          S.pay.pos.copy(CUR.pay);
        }
        let last = performance.now(),
          accum = 0,
          panelT = 0,
          wasPaused = false;
        function frame(now) {
          const dt = Math.min(0.05, (now - last) / 1000);
          last = now;
          rwTick(dt);
          updateInputs(dt);
          // before the mission starts, holding the arm gesture starts it
          if (!S.started) {
            if (S.in.thr <= 0.08 && S.in.yaw >= 0.8) {
              S.armHold += dt;
              if (S.armHold >= 1) arm("sticks");
            } else S.armHold = 0;
          }
          const live = S.running && !S.paused && !RW.on;
          if (!S.started) PV.ok = false;
          if (live) {
            accum += dt;
            while (accum >= H) {
              savePrev();
              step(H);
              accum -= H;
              if (!S.running) break;
            }
          } else accum = 0;
          if (live !== !wasPaused) {
            wasPaused = !live;
            sfx.suspend(!live && S.started && !S.ended);
          }
          const on = S.started && !S.ended && S.armed;
          sfx.motor(on ? 0.35 + (S.rpm - 1) * 0.6 : 0, Math.hypot(S.vel.x, S.vel.z), on);
          sfx.air(Math.hypot(S.vel.x - S.wPrev.x, S.vel.z - S.wPrev.z), false, on);
          const blend = live && PV.ok;
          if (blend) applyBlend(accum / H);
          updateVisuals(live ? dt : 0, live);
          renderer.render(scene, camera);
          drawHUD();
          if (blend) undoBlend();
          if (settings.view === "map") drawPlan();
          updateTx();
          updateDemoSticks();
          panelT += dt;
          if (panelT > 0.08) {
            panelT = 0;
            updatePanels();
          }
          requestAnimationFrame(frame);
        }
        requestAnimationFrame(frame);

        // test hook (used for automated checks)
        window.__dr = { flash, keys, S, PLAN, GAME, LEVELS, ZONES, PROG, get MISSION() { return MISSION; }, step, startMission, startPause, finishMission, checkRoute, analyse, scoreOf, selectTarget, setPlan, newMission, retry, demoStart, setView, setCam, planChanged, applyMission, obstacleAt, windAt, RW, arm, disarm, VIEW, armSwitch, releasePayload, takeOver, phaseName, brakeA, deliveryNumbers, updatePanels, GUIDE, LESSONS, hitTest, rotorR, TREES, HOUSES, PATCHES, TRACKS, landBlocked, houseTop, groundH, renderer, get ROUTECHK() { return ROUTECHK; } };
      })();
    </script>


    <script>
      /* Floating, draggable and resizable How To Use / What You'll Learn window */
      (function initUniversalHelpFloatwin() {
        var bar = document.getElementById("helpbar");
        if (!bar) return;
        if (!bar.classList.contains("floatwin")) {
          bar.classList.add("floatwin");
          bar.setAttribute("role", "dialog");
          bar.setAttribute("aria-label", "Help Guide");
          var head = document.createElement("div");
          head.className = "fw-head";
          var title = document.createElement("span");
          title.className = "fw-title";
          title.textContent = "How To Use";
          head.appendChild(title);
          var actions = document.createElement("div");
          actions.className = "fw-head-actions";
          var origPanels = bar.querySelectorAll(".tabpanel");
          if (origPanels.length > 1) {
            origPanels.forEach(function (p) {
              var t = p.dataset.panel;
              var b = document.createElement("button");
              b.type = "button";
              b.className = "fw-tab-btn";
              b.dataset.tab = t;
              b.textContent = t === "use" ? "How To Use" : t === "learn" ? "What To Learn" : t;
              actions.appendChild(b);
            });
          }
          var closeBtn = document.createElement("button");
          closeBtn.type = "button";
          closeBtn.className = "fw-close";
          closeBtn.title = "Close Guide";
          closeBtn.setAttribute("aria-label", "Close");
          closeBtn.textContent = "✕";
          actions.appendChild(closeBtn);
          head.appendChild(actions);
          var body = document.createElement("div");
          body.className = "fw-body";
          while (bar.firstChild) body.appendChild(bar.firstChild);
          var grip = document.createElement("div");
          grip.className = "fw-grip";
          grip.title = "Drag to resize";
          bar.appendChild(head);
          bar.appendChild(body);
          bar.appendChild(grip);
          document.body.appendChild(bar);
        }
        var btns = document.querySelectorAll(".helpbtn");
        var tabBtns = bar.querySelectorAll(".fw-tab-btn");
        var titleEl = bar.querySelector(".fw-title");
        var closeBtnEl = bar.querySelector(".fw-close");
        var headEl = bar.querySelector(".fw-head");
        var gripEl = bar.querySelector(".fw-grip");
        var topZ = 10000;
        var posInit = false;
        function toFront() {
          bar.style.zIndex = ++topZ;
        }
        function closeAll() {
          bar.classList.remove("show");
          btns.forEach(function (b) {
            b.classList.remove("on");
          });
          tabBtns.forEach(function (b) {
            b.classList.remove("on");
          });
        }
        function openTab(tab) {
          toFront();
          if (!posInit) {
            var w = Math.min(480, window.innerWidth - 32);
            var h = Math.min(600, window.innerHeight - 80);
            bar.style.width = w + "px";
            bar.style.height = h + "px";
            bar.style.top = "65px";
            bar.style.left = Math.max(12, window.innerWidth - w - 24) + "px";
            posInit = true;
          }
          bar.classList.add("show");
          btns.forEach(function (b) {
            b.classList.toggle("on", b.dataset.tab === tab);
          });
          tabBtns.forEach(function (b) {
            b.classList.toggle("on", b.dataset.tab === tab);
          });
          bar.querySelectorAll(".tabpanel").forEach(function (p) {
            p.classList.toggle("on", p.dataset.panel === tab);
          });
          if (titleEl) titleEl.textContent = tab === "use" ? "How To Use" : tab === "learn" ? "What You'll Learn" : "Guide";
        }
        btns.forEach(function (btn) {
          btn.addEventListener("click", function () {
            var tab = btn.dataset.tab || "use";
            if (bar.classList.contains("show") && btn.classList.contains("on")) closeAll();
            else openTab(tab);
          });
        });
        tabBtns.forEach(function (tb) {
          tb.addEventListener("click", function (e) {
            e.stopPropagation();
            openTab(tb.dataset.tab);
          });
        });
        if (closeBtnEl) closeBtnEl.addEventListener("click", closeAll);
        bar.addEventListener("pointerdown", toFront);
        document.addEventListener("keydown", function (e) {
          if (e.key === "Escape" && bar.classList.contains("show")) closeAll();
        });
        if (headEl) {
          headEl.addEventListener("pointerdown", function (e) {
            if (e.target.closest(".fw-head-actions")) return;
            e.preventDefault();
            toFront();
            headEl.setPointerCapture(e.pointerId);
            var r = bar.getBoundingClientRect();
            var dx = e.clientX - r.left,
              dy = e.clientY - r.top;
            bar.classList.add("dragging");
            function onMove(ev) {
              bar.style.left = Math.max(8, Math.min(window.innerWidth - bar.offsetWidth - 8, ev.clientX - dx)) + "px";
              bar.style.top = Math.max(8, Math.min(window.innerHeight - 40, ev.clientY - dy)) + "px";
            }
            function onUp() {
              bar.classList.remove("dragging");
              headEl.removeEventListener("pointermove", onMove);
              headEl.removeEventListener("pointerup", onUp);
              headEl.removeEventListener("pointercancel", onUp);
            }
            headEl.addEventListener("pointermove", onMove);
            headEl.addEventListener("pointerup", onUp);
            headEl.addEventListener("pointercancel", onUp);
          });
        }
        if (gripEl) {
          gripEl.addEventListener("pointerdown", function (e) {
            e.preventDefault();
            e.stopPropagation();
            toFront();
            gripEl.setPointerCapture(e.pointerId);
            var r = bar.getBoundingClientRect();
            var sx = e.clientX,
              sy = e.clientY,
              sw = r.width,
              sh = r.height;
            function onMove(ev) {
              bar.style.width = Math.max(280, Math.min(window.innerWidth - r.left - 8, sw + (ev.clientX - sx))) + "px";
              bar.style.height = Math.max(200, Math.min(window.innerHeight - r.top - 8, sh + (ev.clientY - sy))) + "px";
            }
            function onUp() {
              gripEl.removeEventListener("pointermove", onMove);
              gripEl.removeEventListener("pointerup", onUp);
              gripEl.removeEventListener("pointercancel", onUp);
            }
            gripEl.addEventListener("pointermove", onMove);
            gripEl.addEventListener("pointerup", onUp);
            gripEl.addEventListener("pointercancel", onUp);
          });
        }
      })();
    </script>
  </body>
</html>
