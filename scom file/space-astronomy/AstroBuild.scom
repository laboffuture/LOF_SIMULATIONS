<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>Astro Build — Assemble the ISS, Then Watch It Orbit</title>
    <link rel="icon" type="image/png" href="../../../assets/logo.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800&family=Roboto+Mono:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
    <style>
      :root {
        --bg-dark: #05070f;
        --bg-stage: #060a15;
        --panel-bg: #0c1120;
        --panel-card: rgba(22, 30, 48, 0.85);
        --border-color: rgba(255, 255, 255, 0.13);
        --border-highlight: rgba(0, 242, 254, 0.5);
        --cyan: #00f2fe;
        --blue: #4facfe;
        --orange: #ff8c42;
        --purple: #a855f7;
        --pink: #ff5da2;
        --green: #34d399;
        --amber: #fbbf24;
        --gold: #f0b429;
        --text-primary: #f8fafc;
        --text-secondary: #cbd5e1;
        --text-muted: #7c8aa0;
        --mono: "Roboto Mono", ui-monospace, monospace;
        --sans: "Outfit", system-ui, sans-serif;
      }
      * { box-sizing: border-box; margin: 0; padding: 0; }
      html, body {
        height: 100%; background: var(--bg-dark); color: var(--text-primary);
        font-family: var(--sans); overflow: hidden; -webkit-font-smoothing: antialiased;
      }
      #app { display: grid; grid-template-columns: 1fr 360px; height: 100vh; }

      /* ---------- STAGE ---------- */
      #stage { position: relative; overflow: hidden; background: radial-gradient(circle at 50% 30%, #0b1224, #05070f 70%); }
      #scene { display: block; width: 100%; height: 100%; touch-action: none; }

      #titlecard {
        position: absolute; top: 14px; left: 16px; z-index: 3; pointer-events: none;
        background: rgba(7, 11, 22, 0.85); padding: 8px 14px; border-radius: 9px;
        border: 1px solid var(--border-color); backdrop-filter: blur(8px);
      }
      #titlecard h1 {
        font-size: 13px; font-weight: 800; letter-spacing: 0.12em; text-transform: uppercase;
        background: linear-gradient(90deg, #f0b429, #00f2fe);
        -webkit-background-clip: text; -webkit-text-fill-color: transparent;
      }
      #titlecard p { font-family: var(--mono); font-size: 9.5px; letter-spacing: 0.04em; margin-top: 3px; color: var(--text-secondary); }

      #phaseTag {
        position: absolute; top: 14px; right: 16px; z-index: 4;
        font-family: var(--mono); font-size: 10.5px; font-weight: 800; letter-spacing: 0.12em;
        text-transform: uppercase; padding: 8px 14px; border-radius: 9px;
        background: rgba(7, 11, 22, 0.9); border: 1px solid var(--cyan); color: var(--cyan); backdrop-filter: blur(8px);
      }
      #phaseTag.live { border-color: var(--gold); color: var(--gold); }

      #hintbar {
        position: absolute; left: 50%; transform: translateX(-50%); bottom: 16px; z-index: 4;
        font-family: var(--mono); font-size: 11px; letter-spacing: .03em; color: var(--text-secondary);
        background: rgba(7, 11, 22, 0.9); border: 1px solid var(--border-color); border-radius: 9px;
        padding: 9px 16px; backdrop-filter: blur(8px); text-align: center; max-width: 82%;
      }
      #hintbar b { color: var(--cyan); }

      /* ---------- PANEL ---------- */
      #panel { background: var(--panel-bg); border-left: 1px solid var(--border-color); overflow-y: auto; display: flex; flex-direction: column; }
      #panel::-webkit-scrollbar { width: 6px; }
      #panel::-webkit-scrollbar-thumb { background: rgba(255,255,255,.15); border-radius: 3px; }
      .pane { display: none; flex-direction: column; }
      .pane.on { display: flex; }
      .sec { padding: 14px 16px; border-bottom: 1px solid var(--border-color); }
      .sec-h {
        font-family: var(--mono); font-size: 10.5px; font-weight: 800; letter-spacing: .14em;
        text-transform: uppercase; margin-bottom: 10px; color: var(--text-primary);
        display: flex; align-items: center; justify-content: space-between; gap: 8px;
      }
      .sec-h .cnt { color: var(--cyan); }

      /* progress */
      .progbar { height: 9px; border-radius: 5px; background: rgba(255,255,255,.1); overflow: hidden; }
      .progbar > i { display: block; height: 100%; width: 0%; background: linear-gradient(90deg, var(--blue), var(--cyan)); transition: width .35s; }
      .progcap { font-family: var(--mono); font-size: 10px; color: var(--text-muted); margin-top: 6px; letter-spacing: .04em; }

      /* tray */
      #tray { display: flex; flex-direction: column; gap: 8px; padding: 12px 14px; flex: 1; overflow-y: auto; }
      .tcard {
        display: flex; gap: 10px; align-items: center; background: var(--panel-card);
        border: 1px solid var(--border-color); border-radius: 10px; padding: 9px 11px; cursor: grab;
        transition: border-color .15s, transform .12s, box-shadow .15s; user-select: none;
      }
      .tcard:hover { border-color: var(--border-highlight); transform: translateX(-2px); }
      .tcard.armed { border-color: var(--cyan); box-shadow: 0 0 0 2px rgba(0,242,254,.28), 0 0 18px rgba(0,242,254,.25); }
      .tcard.locked { opacity: .38; pointer-events: none; filter: grayscale(.6); }
      .tcard.placed { display: none; }
      .tcard.dragging { opacity: .3; }
      .tcard .flag { font-size: 20px; line-height: 1; flex: none; }
      .ccode {
        flex: none; font-family: var(--mono); font-size: 10px; font-weight: 800; letter-spacing: .04em;
        border: 1.5px solid currentColor; border-radius: 5px; padding: 3px 5px; min-width: 34px; text-align: center;
      }
      .ccode.RUS, .ccode.CAN { color: #e86a6a; }
      .ccode.USA { color: #5b9ef0; }
      .ccode.ESA { color: #f0b429; }
      .ccode.JPN { color: #ef6ba0; }
      .tcard .tinfo b { font-size: 13px; display: block; letter-spacing: .01em; }
      .tcard .tinfo small { font-family: var(--mono); font-size: 9.5px; color: var(--text-muted); }
      .tcard .tinfo .fn { display: block; font-size: 10.5px; color: var(--text-secondary); margin-top: 2px; line-height: 1.35; }

      #dragGhost {
        position: fixed; z-index: 60; pointer-events: none; display: none;
        background: rgba(9,14,26,.95); border: 1px solid var(--cyan); border-radius: 10px;
        padding: 8px 12px; font-size: 13px; font-weight: 700; box-shadow: 0 8px 24px rgba(0,0,0,.55);
      }
      #dragGhost .flag { font-size: 17px; margin-right: 6px; }

      /* live HUD */
      .hud-tile {
        background: var(--panel-card); border: 1px solid var(--border-color); border-radius: 10px;
        padding: 10px 12px; margin-bottom: 10px;
      }
      .hud-tile .tl { font-family: var(--mono); font-size: 9.5px; letter-spacing: .1em; text-transform: uppercase; color: var(--text-muted); }
      .hud-tile .tv { font-size: 17px; font-weight: 800; margin-top: 2px; font-variant-numeric: tabular-nums; }
      .hud-tile .tv small { font-size: 10px; font-weight: 600; color: var(--text-muted); }
      .meter { height: 10px; border-radius: 6px; background: rgba(255,255,255,.1); overflow: hidden; margin-top: 7px; }
      .meter > i { display: block; height: 100%; transition: width .3s, background .3s; }
      .sunstate { display: flex; align-items: center; gap: 8px; font-family: var(--mono); font-size: 11px; font-weight: 700; }
      .sunstate.sun { color: var(--amber); }
      .sunstate.shadow { color: var(--blue); }

      .factline { font-family: var(--mono); font-size: 10.5px; color: var(--text-secondary); line-height: 1.7; }
      .factline b { color: var(--text-primary); }

      .linkbtn {
        font-family: var(--mono); font-size: 11px; font-weight: 800; letter-spacing: .05em; background: var(--panel-card);
        border: 1px solid var(--border-color); color: var(--text-primary); padding: 11px 12px; border-radius: 9px;
        cursor: pointer; width: 100%; transition: .15s;
      }
      .linkbtn:hover { border-color: var(--cyan); color: var(--cyan); }
      .linkbtn.go { background: linear-gradient(135deg, var(--gold), var(--amber)); color: #1a1206; border: none; }
      .linkbtn.go:disabled { background: var(--panel-card); color: var(--text-muted); border: 1px solid var(--border-color); cursor: default; }
      .linkbtn.go:not(:disabled):hover { transform: translateY(-2px); box-shadow: 0 6px 18px rgba(240,180,41,.35); }

      /* module info pane */
      #modPane .sec { flex: 1; }
      #modBack { font-family: var(--mono); font-size: 10.5px; font-weight: 700; color: var(--cyan); background: none; border: none; cursor: pointer; padding: 0; margin-bottom: 8px; }
      #modFlag { font-size: 30px; }
      #modName { font-size: 20px; font-weight: 800; margin: 4px 0 1px; }
      #modAgency { font-family: var(--mono); font-size: 10.5px; color: var(--text-muted); letter-spacing: .04em; }
      #modText { font-size: 13px; line-height: 1.6; color: var(--text-secondary); margin: 12px 0; }
      #modScene { width: 100%; height: 150px; background: #05070f; border: 1px solid var(--border-color); border-radius: 10px; display: block; }
      #modSceneCap { font-family: var(--mono); font-size: 9.5px; color: var(--text-muted); text-align: center; margin-top: 5px; }

      /* ---------- overlays ---------- */
      .scrim { position: fixed; inset: 0; background: rgba(4,6,12,.9); backdrop-filter: blur(9px); z-index: 40; display: none; align-items: center; justify-content: center; padding: 22px; }
      .scrim.show { display: flex; }
      .ovl { background: var(--panel-bg); border: 1px solid var(--border-highlight); border-radius: 16px; max-width: 620px; width: 100%; max-height: 92vh; overflow-y: auto; padding: 24px 28px; }
      .ovl h2 { font-size: 18px; letter-spacing: .04em; text-transform: uppercase; color: var(--cyan); margin-bottom: 4px; }
      .ovl .sub { font-family: var(--mono); font-size: 11px; color: var(--text-secondary); margin-bottom: 16px; }
      .ovl p { font-size: 13.5px; line-height: 1.6; color: var(--text-secondary); margin-bottom: 12px; }
      .ovl .close { font-family: var(--mono); font-size: 11px; font-weight: 800; background: linear-gradient(135deg, var(--cyan), var(--blue)); color: #061018; border: none; border-radius: 9px; padding: 11px 22px; cursor: pointer; margin-top: 8px; }
      .ovl .close:hover { transform: translateY(-1px); }

      .partner { display: flex; gap: 12px; padding: 11px 0; border-bottom: 1px dotted rgba(255,255,255,.14); }
      .partner:last-child { border-bottom: none; }
      .partner .pf { font-size: 26px; flex: none; }
      .partner b { font-size: 13.5px; }
      .partner small { font-family: var(--mono); font-size: 10px; color: var(--text-muted); display: block; }
      .partner .pp { font-size: 12px; color: var(--text-secondary); margin-top: 3px; }

      /* station map */
      #mapScrim .ovl { max-width: 900px; }
      #mapCanvas { width: 100%; height: min(58vh, 460px); background: radial-gradient(circle at 50% 40%, #0b1224, #05070f); border: 1px solid var(--border-color); border-radius: 12px; display: block; cursor: pointer; }
      #mapHint { font-family: var(--mono); font-size: 10.5px; color: var(--text-muted); text-align: center; margin-top: 8px; }

      /* microgravity demo */
      #mgWrap { text-align: center; }
      #mgCanvas { width: 100%; max-width: 460px; height: 260px; background: #04060d; border: 1px solid var(--border-color); border-radius: 12px; display: block; margin: 0 auto; }
      #mgControls { display: flex; gap: 8px; justify-content: center; flex-wrap: wrap; margin-top: 14px; }
      .mgbtn { font-family: var(--mono); font-size: 11px; font-weight: 800; letter-spacing: .04em; border: 1px solid var(--border-color); background: var(--panel-card); color: var(--text-primary); border-radius: 9px; padding: 10px 16px; cursor: pointer; transition: .15s; }
      .mgbtn:hover { border-color: var(--cyan); }
      .mgtoggle { display: inline-flex; border: 1px solid var(--border-color); border-radius: 9px; overflow: hidden; }
      .mgtoggle button { font-family: var(--mono); font-size: 11px; font-weight: 800; border: none; background: transparent; color: var(--text-secondary); padding: 10px 16px; cursor: pointer; }
      .mgtoggle button.on { background: linear-gradient(135deg, var(--cyan), var(--blue)); color: #061018; }
      #mgCaption { font-size: 12.5px; line-height: 1.55; color: var(--text-secondary); margin-top: 12px; min-height: 34px; }
      #mgCaption b { color: var(--text-primary); }

      @media (max-width: 1000px) {
        html, body { height: auto; overflow: auto; }
        #app { grid-template-columns: 1fr; height: auto; }
        #stage { height: clamp(340px, 82vw, 560px); }
        #panel { max-height: none; }
      }
    </style>
  </head>
  <body>
    <div id="app">
      <div id="stage">
        <canvas id="scene"></canvas>
        <div id="titlecard">
          <h1>Astro Build</h1>
          <p>Build the Space Station — then fly it around Earth</p>
        </div>
        <div id="phaseTag" class="build">Build Mode</div>
        <div id="hintbar">Pick a part on the right, then drop it on a <b>glowing dot</b>. Drag the empty space to spin the view.</div>
      </div>

      <div id="panel">
        <!-- BUILD PANE -->
        <div class="pane on" id="buildPane">
          <div class="sec">
            <div class="sec-h">Station Assembly <span class="cnt" id="progText">1 / 11</span></div>
            <div class="progbar"><i id="progFill"></i></div>
            <div class="progcap" id="progCap">Zarya is already in orbit. Add the next part.</div>
          </div>
          <div class="sec" style="padding-bottom:10px">
            <div class="sec-h" style="margin:0">Parts Tray</div>
          </div>
          <div id="tray"></div>
          <div class="sec">
            <button class="linkbtn go" id="goLiveBtn" disabled>&#9654; Go Live in Orbit</button>
          </div>
        </div>

        <!-- LIVE PANE -->
        <div class="pane" id="livePane">
          <div class="sec">
            <div class="sec-h">In Orbit</div>
            <div class="sunstate" id="sunState"><span>&#9728;</span><span>In sunlight</span></div>
            <div class="hud-tile" style="margin-top:10px">
              <div class="tl">Solar Power Now</div>
              <div class="tv" id="powerVal">85 <small>kW</small></div>
              <div class="meter"><i id="powerMeter" style="width:100%;background:var(--amber)"></i></div>
            </div>
            <div class="hud-tile">
              <div class="tl">Battery Charge</div>
              <div class="tv" id="battVal">100<small>%</small></div>
              <div class="meter"><i id="battMeter" style="width:100%;background:var(--green)"></i></div>
            </div>
          </div>
          <div class="sec">
            <div class="sec-h">The Real Numbers</div>
            <div class="factline">
              Altitude <b>~420 km</b> up<br />
              Speed <b>~7.7 km/s</b> &mdash; 28,000 km/h<br />
              One lap of Earth <b>~93 min</b> &mdash; 16 a day!<br />
              Solar wings span <b>~109 m</b> &mdash; a football field<br />
              Mass <b>~420,000 kg</b>
            </div>
          </div>
          <div class="sec">
            <div class="sec-h">Explore</div>
            <div class="progcap" style="margin:0 0 10px">Tap the station in orbit, or open the map.</div>
            <button class="linkbtn" id="mapBtn" style="margin-bottom:8px">&#128301; Open Station Map</button>
            <button class="linkbtn" id="partnersBtn" style="margin-bottom:8px">&#127760; Partner Nations</button>
            <button class="linkbtn" id="backBuildBtn">&#8617; Back to Build Mode</button>
          </div>
        </div>

        <!-- MODULE INFO PANE -->
        <div class="pane" id="modPane">
          <div class="sec">
            <button id="modBack">&#8592; Back to orbit</button>
            <div id="modFlag">&#128640;</div>
            <div id="modName">Module</div>
            <div id="modAgency">Agency</div>
            <div id="modText"></div>
            <canvas id="modScene"></canvas>
            <div id="modSceneCap"></div>
            <button class="linkbtn" id="mgOpenBtn" style="margin-top:12px;display:none">&#129680; Try the Microgravity Demo</button>
          </div>
        </div>
      </div>
    </div>

    <div id="dragGhost"><span class="ccode gcode"></span> <span class="gname"></span></div>

    <!-- Station Map -->
    <div class="scrim" id="mapScrim">
      <div class="ovl">
        <h2>Station Map</h2>
        <div class="sub">Tap a module to look inside and see what astronauts do there.</div>
        <canvas id="mapCanvas"></canvas>
        <div id="mapHint">Tap any glowing part. The station keeps orbiting behind you.</div>
        <button class="close" data-close>Close</button>
      </div>
    </div>

    <!-- Partner Nations -->
    <div class="scrim" id="partnerScrim">
      <div class="ovl">
        <h2>Partner Nations</h2>
        <div class="sub">Five space agencies built the station together. You placed a piece from each one.</div>
        <div id="partnerList"></div>
        <button class="close" data-close>Got it</button>
      </div>
    </div>

    <!-- Microgravity demo -->
    <div class="scrim" id="mgScrim">
      <div class="ovl">
        <h2>Gravity vs. Microgravity</h2>
        <div class="sub">Release the same object under each setting and watch what changes.</div>
        <div id="mgWrap">
          <canvas id="mgCanvas"></canvas>
          <div id="mgControls">
            <span class="mgtoggle">
              <button id="mgGrav">Gravity</button>
              <button id="mgMicro" class="on">Microgravity</button>
            </span>
            <button class="mgbtn" id="mgRelease">Release object</button>
            <button class="mgbtn" id="mgReset">Reset</button>
          </div>
          <div id="mgCaption"></div>
        </div>
        <button class="close" data-close>Close</button>
      </div>
    </div>

    <script>
      "use strict";
      const $ = (id) => document.getElementById(id);

      /* =================================================================
         COMPONENT DATA  (real ISS parts — simplified, kid-friendly)
         pos = [x, y] in METRES in "station space"; x = along the spine,
         y = up/down. z = depth, used only to fan parts out when the view spins.
         ================================================================= */
      const COMP = {
        zarya: {
          name: "Zarya", agency: "Roscosmos", country: "Russia", flag: "\u{1F1F7}\u{1F1FA}",
          kind: "module", w: 13, h: 5.4, pos: [0, 0], z: 0, attach: null,
          fn: "The very first piece, launched in 1998. It gave the young station its early power and steering.",
          live: "Now used for storage and fuel. Its tanks hold propellant for nudging the station's orbit higher.",
          activity: "float",
        },
        zvezda: {
          name: "Zvezda", agency: "Roscosmos", country: "Russia", flag: "\u{1F1F7}\u{1F1FA}",
          kind: "module", w: 13, h: 5.4, pos: [-13, 0], z: 0, attach: "zarya", side: "left",
          fn: "The first crew home. It has a kitchen, a toilet, two sleep spots, and the systems that make air and water.",
          live: "Life support runs here — it scrubs the air clean and recycles almost every drop of water.",
          activity: "sleep",
        },
        unity: {
          name: "Unity", agency: "NASA", country: "USA", flag: "\u{1F1FA}\u{1F1F8}",
          kind: "node", w: 5.5, h: 5.5, pos: [11.7, 0], z: 0, attach: "zarya", side: "right",
          fn: "A connecting node — a hub with a hatch on every side so other modules can dock onto it.",
          live: "A busy crossroads. Doorways lead off toward the labs, the airlock, and the Russian side.",
          activity: "float",
        },
        destiny: {
          name: "Destiny", agency: "NASA", country: "USA", flag: "\u{1F1FA}\u{1F1F8}",
          kind: "lab", w: 8.5, h: 4.9, pos: [21.5, 0], z: 0, attach: "unity", side: "right",
          fn: "The main US science lab. Its walls are lined with racks of experiments.",
          live: "Crews run studies on fluids, flames, new materials, and how the body changes in space.",
          activity: "research",
        },
        harmony: {
          name: "Harmony", agency: "NASA", country: "USA", flag: "\u{1F1FA}\u{1F1F8}",
          kind: "node", w: 5.5, h: 5.5, pos: [30, 0], z: 0, attach: "destiny", side: "right",
          fn: "A node that joins the international labs together — and it holds four crew sleep pods.",
          live: "Astronauts zip into a sleep pod here, strapped loosely so they don't float into a wall.",
          activity: "sleep",
        },
        columbus: {
          name: "Columbus", agency: "ESA", country: "Europe", flag: "\u{1F1EA}\u{1F1FA}",
          kind: "lab", w: 6.9, h: 4.4, pos: [30, 9], z: -2.4, attach: "harmony", side: "down",
          fn: "Europe's science laboratory.",
          live: "Home to European experiments in biology, physics, and how metals freeze without gravity.",
          activity: "research",
        },
        kibo: {
          name: "Kibo", agency: "JAXA", country: "Japan", flag: "\u{1F1EF}\u{1F1F5}",
          kind: "lab", w: 11.2, h: 5.1, pos: [30, -9.5], z: 2.4, attach: "harmony", side: "up",
          fn: "Japan's lab — the single biggest module on the whole station.",
          live: "It has its own outdoor porch, where experiments sit exposed to open space.",
          activity: "research",
        },
        quest: {
          name: "Quest", agency: "NASA", country: "USA", flag: "\u{1F1FA}\u{1F1F8}",
          kind: "airlock", w: 4.4, h: 4, pos: [11.7, 8], z: 2.2, attach: "unity", side: "down",
          fn: "The airlock — the doorway astronauts pass through to go outside on a spacewalk.",
          live: "Crew seal in, the air is pumped out, then the outer hatch opens onto empty space.",
          activity: "spacewalk",
        },
        truss: {
          name: "Truss", agency: "NASA", country: "USA", flag: "\u{1F1FA}\u{1F1F8}",
          kind: "truss", w: 109, h: 2.1, pos: [3, -20], z: -6, attach: "destiny", side: "up",
          fn: "The long metal backbone. The solar wings and the robot arm all bolt onto this beam.",
          live: "It holds the solar wings way out in clean sunlight, clear of the modules' shadows.",
          activity: "arm",
        },
        arrays: {
          name: "Solar Arrays", agency: "NASA", country: "USA", flag: "\u{1F1FA}\u{1F1F8}",
          kind: "array", w: 0, h: 0, pos: [3, -20], z: -6, attach: "truss", side: "on",
          fn: "Eight huge wings of solar panels — the station's power plant.",
          live: "They slowly swivel to keep facing the Sun and make about 85 kW of electricity.",
          activity: "arrays",
        },
        arm: {
          name: "Canadarm2", agency: "CSA", country: "Canada", flag: "\u{1F1E8}\u{1F1E6}",
          kind: "arm", w: 0, h: 0, pos: [10, -20], z: -6, attach: "truss", side: "on",
          fn: "Canada's robot arm. It helped build the station piece by piece and still moves cargo today.",
          live: "It reaches out to grab arriving supply ships and berth them to a docking port.",
          activity: "arm",
        },
      };
      const ORDER = ["unity", "zvezda", "destiny", "harmony", "columbus", "kibo", "quest", "truss", "arrays", "arm"];
      const TOTAL = ORDER.length + 1; // + pre-placed Zarya

      const PARTNERS = [
        { flag: "\u{1F1FA}\u{1F1F8}", name: "NASA", sub: "United States", gave: "Unity & Harmony nodes, the Destiny lab, the Quest airlock, the main truss and all eight solar wings." },
        { flag: "\u{1F1F7}\u{1F1FA}", name: "Roscosmos", sub: "Russia", gave: "Zarya, the first module (built with US money), and Zvezda, the first crew living quarters." },
        { flag: "\u{1F1EA}\u{1F1FA}", name: "ESA", sub: "Europe (many countries)", gave: "The Columbus science laboratory." },
        { flag: "\u{1F1EF}\u{1F1F5}", name: "JAXA", sub: "Japan", gave: "Kibo, the largest lab, with its own external experiment porch." },
        { flag: "\u{1F1E8}\u{1F1E6}", name: "CSA", sub: "Canada", gave: "Canadarm2, the robot arm that assembled the station." },
      ];

      /* ================= STATE ================= */
      const S = {
        mode: "build",             // build | live
        placed: new Set(["zarya"]),
        armed: null,               // component key picked from tray
        drag: null,                // {key, x, y, moved}
        yaw: -0.08,                // view spin for build (drag to change)
        rotating: false,
        snap: null,                // {key, t} fly-in animation
        // live
        orbit: Math.PI,            // radians around Earth (start on the sunlit side)
        earthSpin: 0,
        openMod: null,
        modT: 0,
        mapHots: [],
        // microgravity
        mg: { mode: "micro", obj: null, t: 0, trailG: [], trailM: [] },
        hotspots: [],              // live-mode clickable module rects
        t0: performance.now(),
      };

      /* ================= CANVAS ================= */
      const cv = $("scene"), ctx = cv.getContext("2d");
      let CW = 0, CH = 0, DPR = 1;
      function fit() {
        DPR = Math.min(window.devicePixelRatio || 1, 2);
        const r = cv.getBoundingClientRect();
        CW = Math.max(320, r.width); CH = Math.max(260, r.height);
        cv.width = Math.round(CW * DPR); cv.height = Math.round(CH * DPR);
        ctx.setTransform(DPR, 0, 0, DPR, 0, 0);
      }
      window.addEventListener("resize", fit);

      /* ================= STARFIELD ================= */
      const STARS = Array.from({ length: 130 }, (_, i) => ({
        x: (i * 97.13) % 1, y: (i * 53.71) % 1, r: (i % 7 === 0) ? 1.5 : 0.8, a: 0.3 + ((i * 7) % 10) / 14,
      }));
      function drawStars() {
        ctx.fillStyle = "#fff";
        for (const s of STARS) { ctx.globalAlpha = s.a; ctx.fillRect(s.x * CW, s.y * CH, s.r, s.r); }
        ctx.globalAlpha = 1;
      }

      /* =================================================================
         BUILD MODE  — 2.5D isometric assembly
         ================================================================= */
      const PITCH = 0.14;   // near-flat side view; drag adds a little yaw for depth
      function bScale() {
        return Math.min((CW * 0.74) / 120, (CH * 0.6) / 78);
      }
      // small country badge drawn on the canvas (emoji flags don't render reliably in canvas)
      function flagChip(x, y, key) {
        const codes = { Russia: ["RUS", "#e23b3b"], USA: ["USA", "#3b7de2"], Europe: ["ESA", "#f0b429"],
                        Japan: ["JPN", "#e23b6b"], Canada: ["CAN", "#e23b3b"] };
        const c = COMP[key], cc = codes[c.country] || ["", "#888"];
        ctx.save();
        ctx.font = "700 9px 'Roboto Mono', monospace";
        ctx.textAlign = "center"; ctx.textBaseline = "middle";
        const w = 26, h = 13;
        ctx.fillStyle = "rgba(8,12,22,0.85)";
        rr(x - w / 2, y - h / 2, w, h, 3); ctx.fill();
        ctx.strokeStyle = cc[1]; ctx.lineWidth = 1; ctx.stroke();
        ctx.fillStyle = cc[1];
        ctx.beginPath(); ctx.arc(x - w / 2 + 5, y, 2.2, 0, Math.PI * 2); ctx.fill();
        ctx.fillStyle = "#e8eef7";
        ctx.fillText(cc[0], x + 3, y + 0.5);
        ctx.restore();
      }
      function proj(x, y, z) {
        const c = Math.cos(S.yaw), s = Math.sin(S.yaw);
        const rx = x * c + z * s;
        const rz = -x * s + z * c;
        const SC = bScale();
        return {
          X: CW * 0.5 + rx * SC,
          Y: CH * 0.46 + y * SC * Math.cos(PITCH) - rz * SC * Math.sin(PITCH),
          d: rz,
        };
      }

      function moduleColor(kind) {
        return {
          module: ["#c9d3e0", "#8f9bb0", "#6b7688"],
          node:   ["#b9c6d8", "#8695ab", "#5f6d80"],
          lab:    ["#d5dbe6", "#9aa6b8", "#727f92"],
          airlock:["#c2b6a0", "#9a8f79", "#6f665533".slice(0,7)],
        }[kind] || ["#c9d3e0", "#8f9bb0", "#6b7688"];
      }

      // draw a rounded "cylinder-ish" module in projected space
      function drawModule(key, opts) {
        opts = opts || {};
        const c = COMP[key];
        const SC = bScale();
        const p = proj(c.pos[0], c.pos[1], c.z);
        const w = c.w * SC, h = c.h * SC;
        const cols = moduleColor(c.kind);
        ctx.save();
        ctx.translate(p.X, p.Y);
        if (opts.alpha != null) ctx.globalAlpha = opts.alpha;

        // shadow
        ctx.fillStyle = "rgba(0,0,0,0.28)";
        ctx.beginPath();
        ctx.ellipse(4, h * 0.55 + 6, w * 0.52, h * 0.28, 0, 0, Math.PI * 2);
        ctx.fill();

        // body
        const g = ctx.createLinearGradient(0, -h / 2, 0, h / 2);
        g.addColorStop(0, cols[0]); g.addColorStop(0.45, cols[1]); g.addColorStop(1, cols[2]);
        ctx.fillStyle = g;
        rr(-w / 2, -h / 2, w, h, Math.min(h / 2, 12));
        ctx.fill();
        ctx.strokeStyle = "rgba(20,26,40,0.55)"; ctx.lineWidth = 1.4; ctx.stroke();

        // end rings
        ctx.strokeStyle = "rgba(30,40,55,0.4)"; ctx.lineWidth = 1;
        for (const fx of [-0.34, 0.34]) {
          ctx.beginPath(); ctx.moveTo(fx * w, -h / 2 + 2); ctx.lineTo(fx * w, h / 2 - 2); ctx.stroke();
        }
        // top highlight
        ctx.strokeStyle = "rgba(255,255,255,0.5)"; ctx.lineWidth = 1.6;
        ctx.beginPath(); ctx.moveTo(-w * 0.4, -h * 0.28); ctx.lineTo(w * 0.4, -h * 0.28); ctx.stroke();

        if (c.kind === "airlock") {
          ctx.fillStyle = "#3a4658";
          ctx.beginPath(); ctx.arc(w * 0.32, 0, h * 0.26, 0, Math.PI * 2); ctx.fill();
        }
        if (c.kind === "lab") {
          ctx.fillStyle = "rgba(60,90,120,0.75)";
          ctx.beginPath(); ctx.ellipse(0, 0, w * 0.12, h * 0.2, 0, 0, Math.PI * 2); ctx.fill();
          ctx.strokeStyle = "rgba(255,255,255,0.5)"; ctx.lineWidth = 1; ctx.stroke();
        }
        ctx.restore();
        if (opts.flag !== false) flagChip(p.X, p.Y - h / 2 - 12, key);
      }

      function drawTruss(opts) {
        opts = opts || {};
        const c = COMP.truss, SC = bScale();
        const a = proj(-c.w / 2 + c.pos[0], c.pos[1], c.z);
        const b = proj(c.w / 2 + c.pos[0], c.pos[1], c.z);
        ctx.save();
        if (opts.alpha != null) ctx.globalAlpha = opts.alpha;
        ctx.strokeStyle = "#8b96a8"; ctx.lineWidth = Math.max(5, c.h * SC);
        ctx.lineCap = "round";
        ctx.beginPath(); ctx.moveTo(a.X, a.Y); ctx.lineTo(b.X, b.Y); ctx.stroke();
        // lattice ticks
        ctx.strokeStyle = "rgba(30,40,55,0.5)"; ctx.lineWidth = 1;
        for (let i = 0; i <= 24; i++) {
          const t = i / 24;
          const x = a.X + (b.X - a.X) * t, y = a.Y + (b.Y - a.Y) * t;
          ctx.beginPath(); ctx.moveTo(x, y - 5); ctx.lineTo(x, y + 5); ctx.stroke();
        }
        ctx.restore();
        flagChip((a.X + b.X) / 2, a.Y - 14, "truss");
      }

      // eight solar wings: two tall blue panels hanging up and down at each truss end
      function drawArrays(opts) {
        opts = opts || {};
        const c = COMP.truss, SC = bScale();
        const alpha = opts.alpha != null ? opts.alpha : 1;
        const panelH = 33 * SC, panelW = 8 * SC, gap = 3 * SC;
        for (const endSign of [-1, 1]) {
          const end = proj(c.pos[0] + endSign * (c.w / 2 - 5), c.pos[1], c.z);
          for (const dir of [-1, 1]) {          // up / down from the truss
            for (let pair = 0; pair < 2; pair++) {
              const px = end.X + (pair - 0.5) * (panelW + gap);
              const y0 = dir < 0 ? end.Y - 5 - panelH : end.Y + 5;
              ctx.save();
              ctx.globalAlpha = alpha * 0.94;
              const g2 = ctx.createLinearGradient(px - panelW / 2, 0, px + panelW / 2, 0);
              g2.addColorStop(0, opts.dim ? "#1b1f29" : "#153356");
              g2.addColorStop(0.5, opts.dim ? "#2b3040" : "#3178b8");
              g2.addColorStop(1, opts.dim ? "#1b1f29" : "#153356");
              ctx.fillStyle = g2;
              rr(px - panelW / 2, y0, panelW, panelH, 2); ctx.fill();
              ctx.globalAlpha = alpha;
              ctx.strokeStyle = opts.dim ? "rgba(120,130,150,0.4)" : "rgba(130,190,245,0.65)";
              ctx.lineWidth = 1; ctx.stroke();
              ctx.strokeStyle = opts.dim ? "rgba(255,255,255,0.05)" : "rgba(150,200,255,0.25)";
              for (let s = 1; s < 15; s++) {
                const yy = y0 + panelH * s / 15;
                ctx.beginPath(); ctx.moveTo(px - panelW / 2, yy); ctx.lineTo(px + panelW / 2, yy); ctx.stroke();
              }
              ctx.beginPath(); ctx.moveTo(px, y0); ctx.lineTo(px, y0 + panelH); ctx.stroke();
              // little stem to the truss
              ctx.strokeStyle = "rgba(150,165,190,0.5)"; ctx.lineWidth = 2;
              ctx.beginPath(); ctx.moveTo(px, dir < 0 ? y0 + panelH : y0); ctx.lineTo(end.X, end.Y); ctx.stroke();
              ctx.restore();
            }
          }
        }
      }

      function drawArm(opts) {
        opts = opts || {};
        const SC = bScale();
        const base = proj(COMP.arm.pos[0], COMP.truss.pos[1], COMP.truss.z);
        ctx.save();
        if (opts.alpha != null) ctx.globalAlpha = opts.alpha;
        ctx.strokeStyle = "#e8e2d0"; ctx.lineWidth = Math.max(4, 1.6 * SC); ctx.lineCap = "round";
        const sway = Math.sin((performance.now() - S.t0) / 1400) * 0.35;
        const j1x = base.X + 26, j1y = base.Y + 24 + sway * 8;
        const j2x = j1x + 30 + sway * 10, j2y = j1y + 10;
        ctx.beginPath(); ctx.moveTo(base.X, base.Y); ctx.lineTo(j1x, j1y); ctx.lineTo(j2x, j2y); ctx.stroke();
        ctx.fillStyle = "#c9c2ac";
        for (const [jx, jy] of [[base.X, base.Y], [j1x, j1y], [j2x, j2y]]) {
          ctx.beginPath(); ctx.arc(jx, jy, Math.max(3, 0.5 * SC), 0, Math.PI * 2); ctx.fill();
        }
        ctx.restore();
        flagChip(j2x + 16, j2y, "arm");
      }

      function connectionPoint(key) {
        // world position where the glowing dot / piece lands
        const c = COMP[key];
        return proj(c.pos[0], c.pos[1], c.z);
      }
      function validNext() {
        return ORDER.filter((k) => !S.placed.has(k) && (COMP[k].attach == null || S.placed.has(COMP[k].attach)));
      }

      function drawFootballField() {
        const SC = bScale();
        const L = 105 * SC, W = 22 * SC;
        const cxs = CW * 0.5;
        const fy = CH * 0.46 + 43 * SC * Math.cos(PITCH);
        ctx.save();
        ctx.globalAlpha = 0.9;
        // pitch
        ctx.fillStyle = "rgba(34,120,60,0.16)";
        rr(cxs - L / 2, fy - W / 2, L, W, 4); ctx.fill();
        ctx.strokeStyle = "rgba(150,220,170,0.55)"; ctx.lineWidth = 1.5;
        rr(cxs - L / 2, fy - W / 2, L, W, 4); ctx.stroke();
        ctx.beginPath(); ctx.moveTo(cxs, fy - W / 2); ctx.lineTo(cxs, fy + W / 2); ctx.stroke();
        ctx.beginPath(); ctx.arc(cxs, fy, W * 0.16, 0, Math.PI * 2); ctx.stroke();
        for (const sgn of [-1, 1]) {
          const bw = 0.12 * L;
          ctx.strokeRect(sgn < 0 ? cxs - L / 2 : cxs + L / 2 - bw, fy - W * 0.3, bw, W * 0.6);
        }
        // length bracket
        ctx.strokeStyle = "rgba(150,220,170,0.8)"; ctx.lineWidth = 1.2;
        const by = fy + W / 2 + 14;
        ctx.beginPath();
        ctx.moveTo(cxs - L / 2, by - 4); ctx.lineTo(cxs - L / 2, by + 4);
        ctx.moveTo(cxs + L / 2, by - 4); ctx.lineTo(cxs + L / 2, by + 4);
        ctx.moveTo(cxs - L / 2, by); ctx.lineTo(cxs + L / 2, by);
        ctx.stroke();
        ctx.fillStyle = "rgba(160,230,180,0.95)"; ctx.font = "700 11px 'Roboto Mono', monospace";
        ctx.textAlign = "center"; ctx.textBaseline = "middle";
        ctx.save(); ctx.fillStyle = "#0b1526"; ctx.fillRect(cxs - 78, by - 8, 156, 16); ctx.restore();
        ctx.fillStyle = "rgba(160,230,180,0.95)";
        ctx.fillText("⚽ football field ≈ 105 m", cxs, by);
        ctx.restore();
      }

      function drawBuild() {
        ctx.clearRect(0, 0, CW, CH);
        drawStars();
        drawFootballField();
        const SC = bScale();

        // ---- structure behind the modules: truss, solar wings ----
        const hasTruss = S.placed.has("truss");
        if (hasTruss) {
          // vertical riser from Destiny straight up to the truss
          const a = proj(COMP.destiny.pos[0], COMP.destiny.pos[1], COMP.destiny.z);
          const bY = proj(COMP.destiny.pos[0], COMP.truss.pos[1], COMP.truss.z).Y;
          ctx.strokeStyle = "rgba(150,165,190,0.55)"; ctx.lineWidth = Math.max(3, 0.9 * SC);
          ctx.beginPath(); ctx.moveTo(a.X, a.Y); ctx.lineTo(a.X, bY); ctx.stroke();
          if (S.placed.has("arrays")) drawArrays({ alpha: S.snap && S.snap.key === "arrays" ? S.snap.t : 1 });
          drawTruss({ alpha: S.snap && S.snap.key === "truss" ? S.snap.t : 1 });
        }

        // ---- modules, painter-sorted by depth ----
        const drawList = [];
        for (const k of S.placed) {
          if (["truss", "arrays", "arm"].includes(k)) continue;
          drawList.push({ k, d: proj(COMP[k].pos[0], COMP[k].pos[1], COMP[k].z).d });
        }
        drawList.sort((a, b) => a.d - b.d);

        // connectors between placed modules
        ctx.strokeStyle = "rgba(200,215,235,0.4)"; ctx.lineWidth = Math.max(4, 1.1 * SC);
        for (const k of S.placed) {
          const c = COMP[k];
          if (!c.attach || !S.placed.has(c.attach) || ["truss", "array", "arm"].includes(c.kind)) continue;
          const a = proj(c.pos[0], c.pos[1], c.z);
          const b = proj(COMP[c.attach].pos[0], COMP[c.attach].pos[1], COMP[c.attach].z);
          ctx.beginPath(); ctx.moveTo(a.X, a.Y); ctx.lineTo(b.X, b.Y); ctx.stroke();
        }

        for (const it of drawList) {
          drawModule(it.k, { alpha: S.snap && S.snap.key === it.k ? S.snap.t : 1 });
        }
        if (S.placed.has("arm")) drawArm({ alpha: S.snap && S.snap.key === "arm" ? S.snap.t : 1 });

        // glowing connection points for the currently valid next pieces
        const vlist = validNext();
        const pulse = 0.5 + 0.5 * Math.sin((performance.now() - S.t0) / 260);
        for (const k of vlist) {
          const armedThis = S.armed === k || (S.drag && S.drag.key === k);
          if (S.armed && !armedThis) continue; // when a card is armed, only show its point
          const p = connectionPoint(k);
          const R = (armedThis ? 20 : 13) + pulse * 6;
          ctx.beginPath();
          ctx.strokeStyle = "rgba(0,242,254," + (0.35 + pulse * 0.45) + ")";
          ctx.lineWidth = 2.5;
          ctx.arc(p.X, p.Y, R, 0, Math.PI * 2); ctx.stroke();
          ctx.fillStyle = "rgba(0,242,254," + (0.25 + pulse * 0.35) + ")";
          ctx.beginPath(); ctx.arc(p.X, p.Y, R * 0.42, 0, Math.PI * 2); ctx.fill();
          if (armedThis) {
            ctx.fillStyle = "#00f2fe"; ctx.font = "700 11px 'Roboto Mono', monospace";
            ctx.textAlign = "center"; ctx.textBaseline = "bottom";
            ctx.fillText("drop here ↓", p.X, p.Y - R - 4);
          }
        }

        // done banner
        if (S.placed.size >= TOTAL) {
          ctx.fillStyle = "rgba(52,211,153,0.15)";
          rr(CW * 0.5 - 150, 16, 300, 40, 10); ctx.fill();
          ctx.strokeStyle = "#34d399"; ctx.lineWidth = 1.5; ctx.stroke();
          ctx.fillStyle = "#34d399"; ctx.font = "800 14px 'Outfit', sans-serif";
          ctx.textAlign = "center"; ctx.textBaseline = "middle";
          ctx.fillText("Station complete! Press ▶ Go Live in Orbit", CW * 0.5, 36);
        }
      }

      /* =================================================================
         LIVE MODE — station orbiting Earth
         ================================================================= */
      const SUN_DIR = { x: -0.72, y: -0.69 };   // where the Sun is, on screen
      function earthGeom() {
        const R = Math.min(CW, CH) * 0.235;
        return { cx: CW * 0.52, cy: CH * 0.58, R, orbitR: R * 1.44 };
      }
      function stationInShadow() {
        const a = S.orbit;
        const sx = Math.cos(a), sy = Math.sin(a);
        return sx * SUN_DIR.x + sy * SUN_DIR.y < -0.28;
      }
      function drawLive() {
        ctx.clearRect(0, 0, CW, CH);
        drawStars();
        const G = earthGeom();

        // sun rays from the corner
        ctx.save();
        ctx.globalAlpha = 0.5;
        const sunX = G.cx + SUN_DIR.x * (G.R * 2.6), sunY = G.cy + SUN_DIR.y * (G.R * 2.6);
        const rg = ctx.createRadialGradient(sunX, sunY, 4, sunX, sunY, 120);
        rg.addColorStop(0, "rgba(255,240,190,0.95)"); rg.addColorStop(1, "rgba(255,220,120,0)");
        ctx.fillStyle = rg; ctx.beginPath(); ctx.arc(sunX, sunY, 120, 0, Math.PI * 2); ctx.fill();
        ctx.strokeStyle = "rgba(255,230,160,0.35)"; ctx.lineWidth = 2;
        for (let i = 0; i < 7; i++) {
          const ang = -0.6 + i * 0.18;
          ctx.beginPath();
          ctx.moveTo(sunX + Math.cos(ang) * 30, sunY + Math.sin(ang) * 30);
          ctx.lineTo(sunX + Math.cos(ang) * 220, sunY + Math.sin(ang) * 220);
          ctx.stroke();
        }
        ctx.restore();

        // Earth
        ctx.save();
        const eg = ctx.createRadialGradient(
          G.cx - G.R * 0.4 * 1, G.cy - G.R * 0.4, G.R * 0.2,
          G.cx, G.cy, G.R
        );
        eg.addColorStop(0, "#4aa3e0"); eg.addColorStop(0.6, "#1f6fb2"); eg.addColorStop(1, "#0d3f74");
        ctx.fillStyle = eg;
        ctx.beginPath(); ctx.arc(G.cx, G.cy, G.R, 0, Math.PI * 2); ctx.fill();

        // continents + ice caps (rotate under a fixed, sun-locked terminator)
        ctx.save();
        ctx.beginPath(); ctx.arc(G.cx, G.cy, G.R, 0, Math.PI * 2); ctx.clip();
        ctx.translate(G.cx, G.cy);
        const blobs = [
          [-0.34, -0.12, 0.19, 0.15], [-0.12, 0.08, 0.24, 0.19], [0.06, -0.32, 0.15, 0.12],
          [0.32, 0.16, 0.2, 0.15], [0.52, -0.06, 0.13, 0.12], [-0.52, 0.34, 0.15, 0.1],
          [0.16, 0.46, 0.17, 0.11], [-0.02, -0.52, 0.12, 0.09], [0.62, 0.4, 0.12, 0.09],
        ];
        for (const [bx, by, bw, bh] of blobs) {
          const px = ((bx + S.earthSpin) % 2 + 2) % 2 - 1;
          ctx.fillStyle = by > 0.15 ? "#c8a15a" : "#3f9b5a";
          ctx.beginPath();
          ctx.ellipse(px * G.R, by * G.R, bw * G.R, bh * G.R, 0.3, 0, Math.PI * 2);
          ctx.fill();
        }
        ctx.fillStyle = "rgba(232,242,255,0.7)";
        ctx.beginPath(); ctx.ellipse(0, -G.R * 0.9, G.R * 0.55, G.R * 0.16, 0, 0, Math.PI * 2); ctx.fill();
        ctx.beginPath(); ctx.ellipse(0, G.R * 0.9, G.R * 0.55, G.R * 0.16, 0, 0, Math.PI * 2); ctx.fill();
        ctx.restore();

        // night side — a hard-edged shadow on the anti-sun hemisphere
        ctx.save();
        ctx.beginPath(); ctx.arc(G.cx, G.cy, G.R, 0, Math.PI * 2); ctx.clip();
        const ang = Math.atan2(SUN_DIR.y, SUN_DIR.x);
        ctx.translate(G.cx, G.cy); ctx.rotate(ang);
        const ng = ctx.createLinearGradient(-G.R, 0, G.R, 0);
        ng.addColorStop(0, "rgba(3,6,16,0.05)");
        ng.addColorStop(0.42, "rgba(3,6,16,0.05)");
        ng.addColorStop(0.5, "rgba(3,6,16,0.55)");
        ng.addColorStop(0.62, "rgba(2,4,10,0.86)");
        ng.addColorStop(1, "rgba(2,4,10,0.92)");
        ctx.fillStyle = ng;
        ctx.fillRect(-G.R, -G.R, G.R * 2, G.R * 2);
        // terminator glow line
        ctx.strokeStyle = "rgba(255,180,110,0.4)"; ctx.lineWidth = 3;
        ctx.beginPath(); ctx.moveTo(G.R * 0.06, -G.R); ctx.lineTo(G.R * 0.06, G.R); ctx.stroke();
        ctx.restore();
        // atmosphere ring
        ctx.strokeStyle = "rgba(120,200,255,0.4)"; ctx.lineWidth = 4;
        ctx.beginPath(); ctx.arc(G.cx, G.cy, G.R + 2, 0, Math.PI * 2); ctx.stroke();
        ctx.restore();

        // orbit path
        ctx.strokeStyle = "rgba(0,242,254,0.28)"; ctx.lineWidth = 1.5; ctx.setLineDash([4, 6]);
        ctx.beginPath(); ctx.arc(G.cx, G.cy, G.orbitR, 0, Math.PI * 2); ctx.stroke();
        ctx.setLineDash([]);

        // station
        const stx = G.cx + Math.cos(S.orbit) * G.orbitR;
        const sty = G.cy + Math.sin(S.orbit) * G.orbitR;
        const shadow = stationInShadow();
        // angle of arrays toward the sun, in screen space
        const sunAngle = Math.atan2(sunY - sty, sunX - stx);
        S.hotspots = drawOrbitStation(stx, sty, sunAngle, shadow);

        // eclipse marker
        if (shadow) {
          ctx.fillStyle = "rgba(120,150,220,0.9)"; ctx.font = "700 11px 'Roboto Mono', monospace";
          ctx.textAlign = "center";
          ctx.fillText("\u{1F311} in Earth's shadow", stx, sty - 44);
        } else {
          ctx.fillStyle = "rgba(251,191,36,0.95)"; ctx.font = "700 11px 'Roboto Mono', monospace";
          ctx.textAlign = "center";
          ctx.fillText("☀ in sunlight", stx, sty - 44);
        }
      }

      // returns hotspot list [{key, x, y, r}]
      function drawOrbitStation(cx, cy, sunAngle, shadow) {
        const s = Math.min(CW, CH) * 0.0016; // px per metre for the little station
        const hs = [];
        ctx.save();
        ctx.translate(cx, cy);
        // spine
        const spine = ["zvezda", "zarya", "unity", "destiny", "harmony"];
        ctx.fillStyle = shadow ? "#7f8a9c" : "#d7deea";
        ctx.strokeStyle = "rgba(20,26,40,0.6)"; ctx.lineWidth = 1;
        for (const k of spine) {
          const c = COMP[k];
          const x = c.pos[0] * s, w = c.w * s, h = c.h * s;
          rr(x - w / 2, -h / 2, w, h, Math.min(h / 2, 4)); ctx.fill(); ctx.stroke();
          hs.push({ key: k, x: cx + x, y: cy, r: Math.max(w, h) * 0.7 + 8 });
        }
        for (const k of ["columbus", "kibo", "quest"]) {
          const c = COMP[k];
          const x = c.pos[0] * s, y = c.pos[1] * s, w = c.w * s, h = c.h * s;
          rr(x - w / 2, y - h / 2, w, h, Math.min(h / 2, 4)); ctx.fill(); ctx.stroke();
          hs.push({ key: k, x: cx + x, y: cy + y, r: Math.max(w, h) * 0.7 + 8 });
        }
        // truss
        const ty = COMP.truss.pos[1] * s;
        ctx.strokeStyle = shadow ? "#5f6a7c" : "#9aa6b8"; ctx.lineWidth = Math.max(2, 2 * s);
        ctx.beginPath(); ctx.moveTo(-COMP.truss.w / 2 * s, ty); ctx.lineTo(COMP.truss.w / 2 * s, ty); ctx.stroke();
        // riser
        ctx.beginPath(); ctx.moveTo(0, 0); ctx.lineTo(0, ty); ctx.stroke();
        hs.push({ key: "truss", x: cx, y: cy + ty, r: 18 });

        // solar wings — swivel toward the sun
        for (const endSign of [-1, 1]) {
          const bx = endSign * (COMP.truss.w / 2 - 3) * s;
          for (let k = 0; k < 4; k++) {
            const off = (k - 1.5) * 4 * s;
            ctx.save();
            ctx.translate(bx, ty + off * 0.3);
            ctx.rotate(sunAngle);
            ctx.fillStyle = shadow ? "#2a2f3d" : "#c98a2c";
            ctx.strokeStyle = "rgba(20,24,34,0.6)"; ctx.lineWidth = 0.8;
            const wl = 24 * s, ww = 7 * s;
            ctx.fillRect(-wl, -ww / 2, wl * 2, ww);
            ctx.strokeRect(-wl, -ww / 2, wl * 2, ww);
            ctx.restore();
          }
        }
        hs.push({ key: "arrays", x: cx + (COMP.truss.w / 2 - 3) * s, y: cy + ty, r: 20 });

        // arm
        ctx.strokeStyle = "#e8e2d0"; ctx.lineWidth = Math.max(1.5, 1.4 * s); ctx.lineCap = "round";
        const sway = Math.sin(S.modT * 2 + performance.now() / 1600) * 6;
        ctx.beginPath();
        ctx.moveTo(COMP.arm.pos[0] * s, ty);
        ctx.lineTo(COMP.arm.pos[0] * s + 10, ty + 8 + sway);
        ctx.lineTo(COMP.arm.pos[0] * s + 18, ty + 16);
        ctx.stroke();
        hs.push({ key: "arm", x: cx + COMP.arm.pos[0] * s + 16, y: cy + ty + 14, r: 14 });

        // gentle click halo
        const pulse = 0.5 + 0.5 * Math.sin(performance.now() / 500);
        ctx.strokeStyle = "rgba(0,242,254," + (0.15 + pulse * 0.2) + ")";
        ctx.lineWidth = 2;
        ctx.beginPath(); ctx.arc(0, 0, Math.max(CW, CH) * 0.05, 0, Math.PI * 2); ctx.stroke();
        ctx.restore();
        return hs;
      }

      /* =================================================================
         MODULE INFO PANE + astronaut scene
         ================================================================= */
      const msCv = $("modScene"), msCtx = msCv.getContext("2d");
      function fitModScene() {
        const r = msCv.getBoundingClientRect();
        msCv.width = Math.round(r.width * DPR); msCv.height = Math.round(150 * DPR);
        msCtx.setTransform(DPR, 0, 0, DPR, 0, 0);
      }
      function drawAstro(activity, t) {
        const c = msCtx, W = msCv.getBoundingClientRect().width, H = 150;
        c.clearRect(0, 0, W, H);
        c.fillStyle = "#060a15"; c.fillRect(0, 0, W, H);
        // module wall hints
        c.strokeStyle = "rgba(255,255,255,0.06)"; c.lineWidth = 1;
        for (let x = 0; x < W; x += 26) { c.beginPath(); c.moveTo(x, 0); c.lineTo(x, H); c.stroke(); }
        const midX = W / 2;
        const float = Math.sin(t * 1.6) * 6;
        const spin = activity === "float" || activity === "arrays" ? t * 0.5 : 0;

        function figure(x, y, rot, scale) {
          c.save(); c.translate(x, y); c.rotate(rot); c.scale(scale, scale);
          // torso
          c.fillStyle = "#e9edf4"; c.strokeStyle = "#9aa6b8"; c.lineWidth = 2;
          rrp(c, -11, -6, 22, 30, 8); c.fill(); c.stroke();
          // helmet
          c.beginPath(); c.arc(0, -16, 12, 0, Math.PI * 2); c.fill(); c.stroke();
          c.fillStyle = "#2b4b63"; c.beginPath(); c.arc(0, -16, 8, 0, Math.PI * 2); c.fill();
          // arms & legs (simple)
          c.strokeStyle = "#e9edf4"; c.lineWidth = 6; c.lineCap = "round";
          const armSwing = Math.sin(t * 3) * 0.5;
          c.beginPath(); c.moveTo(-9, 0); c.lineTo(-20, 6 + armSwing * 10); c.stroke();
          c.beginPath(); c.moveTo(9, 0); c.lineTo(20, 6 - armSwing * 10); c.stroke();
          c.beginPath(); c.moveTo(-6, 24); c.lineTo(-9, 40); c.stroke();
          c.beginPath(); c.moveTo(6, 24); c.lineTo(9, 40); c.stroke();
          c.restore();
        }

        if (activity === "research") {
          // rack of experiments
          c.fillStyle = "#12324a"; rrp(c, W - 78, 24, 60, 100, 6); c.fill();
          c.fillStyle = "rgba(0,242,254," + (0.4 + 0.4 * Math.abs(Math.sin(t * 2))) + ")";
          c.fillRect(W - 68, 40, 40, 14); c.fillRect(W - 68, 64, 40, 14); c.fillRect(W - 68, 88, 40, 14);
          figure(midX - 20, 78 + float, -0.15, 1);
          $("modSceneCap").textContent = "Running an experiment in a rack";
        } else if (activity === "sleep") {
          c.fillStyle = "#1c2740"; rrp(c, midX - 55, 55 + float, 110, 44, 20); c.fill();
          c.strokeStyle = "#3a4a6a"; c.lineWidth = 2; c.stroke();
          figure(midX, 60 + float, Math.PI / 2, 0.82);
          c.fillStyle = "#8fa3c8"; c.font = "18px system-ui";
          c.fillText("\u{1F4A4}", midX + 40, 46 + float + Math.sin(t * 2) * 4);
          $("modSceneCap").textContent = "Zipped into a sleep pod so it can't drift";
        } else if (activity === "spacewalk") {
          c.fillStyle = "#0a0f1c"; c.fillRect(0, 0, W, H);
          c.fillStyle = "#fff";
          for (let i = 0; i < 40; i++) c.fillRect((i * 61) % W, (i * 37) % H, 1.4, 1.4);
          figure(midX + Math.sin(t) * 30, 75 + Math.cos(t * 0.7) * 12, Math.sin(t) * 0.4, 1);
          c.strokeStyle = "#ffd27a"; c.lineWidth = 2;
          c.beginPath(); c.moveTo(20, 130); c.lineTo(midX + Math.sin(t) * 30, 78); c.stroke();
          $("modSceneCap").textContent = "On a tether outside during a spacewalk";
        } else if (activity === "arm") {
          c.strokeStyle = "#e8e2d0"; c.lineWidth = 9; c.lineCap = "round";
          const a = Math.sin(t) * 0.6;
          c.beginPath(); c.moveTo(20, 120);
          const e1x = 70, e1y = 70;
          const e2x = e1x + Math.cos(a) * 60, e2y = e1y + Math.sin(a) * 40;
          c.lineTo(e1x, e1y); c.lineTo(e2x, e2y); c.stroke();
          c.fillStyle = "#c9c2ac";
          [[20, 120], [e1x, e1y], [e2x, e2y]].forEach(([x, y]) => { c.beginPath(); c.arc(x, y, 7, 0, Math.PI * 2); c.fill(); });
          c.fillStyle = "#8899bb"; rrp(c, e2x - 8, e2y - 8, 26, 20, 4); c.fill();
          $("modSceneCap").textContent = "The robot arm moving cargo outside";
        } else if (activity === "arrays") {
          for (let i = 0; i < 4; i++) {
            c.save(); c.translate(midX, H / 2); c.rotate(t * 0.4 + i * 0.02);
            c.fillStyle = "#c98a2c"; c.fillRect(-70, -8 + i * 0 - 26 + i * 17, 140, 12);
            c.restore();
          }
          c.fillStyle = "#ffe08a"; c.beginPath(); c.arc(28, 30, 12, 0, Math.PI * 2); c.fill();
          $("modSceneCap").textContent = "Solar wings turning to face the Sun";
        } else {
          figure(midX + Math.sin(t * 0.9) * 24, 70 + float, spin, 1);
          $("modSceneCap").textContent = "Floating freely — nothing pulls you to a floor";
        }
      }

      function openModule(key) {
        S.openMod = key; S.modT = 0;
        const c = COMP[key];
        $("modFlag").textContent = c.flag;
        $("modName").textContent = c.name;
        $("modAgency").textContent = c.agency + " · " + c.country;
        $("modText").textContent = c.live;
        $("mgOpenBtn").style.display = ["zvezda", "destiny", "harmony", "columbus", "kibo"].includes(key) ? "block" : "none";
        showPane("mod");
        fitModScene();
      }

      /* =================================================================
         STATION MAP  — flat schematic, big clickable modules
         ================================================================= */
      const mapCv = $("mapCanvas"), mapCtx = mapCv.getContext("2d");
      function fitMap() {
        const r = mapCv.getBoundingClientRect();
        mapCv.width = Math.round(r.width * DPR);
        mapCv.height = Math.round(r.height * DPR);
        mapCtx.setTransform(DPR, 0, 0, DPR, 0, 0);
      }
      function drawMap() {
        const W = mapCv.getBoundingClientRect().width, H = mapCv.getBoundingClientRect().height;
        mapCtx.clearRect(0, 0, W, H);
        mapCtx.fillStyle = "#fff";
        for (let i = 0; i < 60; i++) { mapCtx.globalAlpha = 0.25 + ((i * 7) % 10) / 20; mapCtx.fillRect((i * 83.3) % W, (i * 47.7) % H, 1.3, 1.3); }
        mapCtx.globalAlpha = 1;
        // scale so the MODULE cluster fills the map; the truss & wings run off the edges as context
        const SC = Math.min((W * 0.72) / 64, (H * 0.6) / 44);
        const ox = W / 2 - 8 * SC, oy = H * 0.5;
        const MX = (x) => ox + x * SC, MY = (y) => oy + y * SC;
        const hots = [];

        // truss + wings
        mapCtx.strokeStyle = "#8b96a8"; mapCtx.lineWidth = Math.max(4, 2.1 * SC); mapCtx.lineCap = "round";
        mapCtx.beginPath(); mapCtx.moveTo(MX(-54.5 + COMP.truss.pos[0]), MY(COMP.truss.pos[1])); mapCtx.lineTo(MX(54.5 + COMP.truss.pos[0]), MY(COMP.truss.pos[1])); mapCtx.stroke();
        mapCtx.strokeStyle = "rgba(150,165,190,0.5)"; mapCtx.lineWidth = Math.max(3, 0.9 * SC);
        mapCtx.beginPath(); mapCtx.moveTo(MX(COMP.destiny.pos[0]), MY(0)); mapCtx.lineTo(MX(COMP.destiny.pos[0]), MY(COMP.truss.pos[1])); mapCtx.stroke();
        for (const es of [-1, 1]) for (const dir of [-1, 1]) for (let p = 0; p < 2; p++) {
          const x = COMP.truss.pos[0] + es * 50 + (p - 0.5) * 9;
          mapCtx.fillStyle = "#2f6fae"; mapCtx.globalAlpha = 0.9;
          mapCtx.fillRect(MX(x) - 4 * SC / 2, dir < 0 ? MY(COMP.truss.pos[1] - 5 - 33) : MY(COMP.truss.pos[1] + 5), 4 * SC, 33 * SC);
          mapCtx.globalAlpha = 1;
          mapCtx.strokeStyle = "rgba(120,180,240,0.6)"; mapCtx.lineWidth = 1;
          mapCtx.strokeRect(MX(x) - 4 * SC / 2, dir < 0 ? MY(COMP.truss.pos[1] - 5 - 33) : MY(COMP.truss.pos[1] + 5), 4 * SC, 33 * SC);
        }
        hots.push({ key: "truss", x: MX(-30), y: MY(COMP.truss.pos[1]), r: 22 });
        hots.push({ key: "arrays", x: MX(COMP.truss.pos[0] + 50), y: MY(COMP.truss.pos[1] - 20), r: 30 });

        // arm
        mapCtx.strokeStyle = "#e8e2d0"; mapCtx.lineWidth = Math.max(3, 1.5 * SC); mapCtx.lineCap = "round";
        mapCtx.beginPath();
        mapCtx.moveTo(MX(COMP.arm.pos[0]), MY(COMP.truss.pos[1]));
        mapCtx.lineTo(MX(COMP.arm.pos[0] + 8), MY(COMP.truss.pos[1] + 6));
        mapCtx.lineTo(MX(COMP.arm.pos[0] + 14), MY(COMP.truss.pos[1] + 14));
        mapCtx.stroke();
        hots.push({ key: "arm", x: MX(COMP.arm.pos[0] + 12), y: MY(COMP.truss.pos[1] + 12), r: 16 });

        // modules
        const pulse = 0.5 + 0.5 * Math.sin(performance.now() / 420);
        for (const k of ["zvezda", "zarya", "unity", "destiny", "harmony", "columbus", "kibo", "quest"]) {
          const c = COMP[k];
          const w = c.w * SC, h = c.h * SC, X = MX(c.pos[0]), Y = MY(c.pos[1]);
          const cols = moduleColorMap(c.kind);
          mapCtx.save(); mapCtx.translate(X, Y);
          const g = mapCtx.createLinearGradient(0, -h / 2, 0, h / 2);
          g.addColorStop(0, cols[0]); g.addColorStop(0.5, cols[1]); g.addColorStop(1, cols[2]);
          mapCtx.fillStyle = g;
          rrp(mapCtx, -w / 2, -h / 2, w, h, Math.min(h / 2, 10)); mapCtx.fill();
          mapCtx.strokeStyle = "rgba(0,242,254," + (0.35 + pulse * 0.5) + ")"; mapCtx.lineWidth = 2;
          mapCtx.stroke();
          mapCtx.restore();
          // label — Unity's goes above (it sits between two labs); the rest below
          const above = k === "unity" || k === "destiny";
          const ly = above ? Y - h / 2 - 11 : Y + h / 2 + 12;
          mapCtx.font = "700 11px 'Outfit', sans-serif"; mapCtx.textAlign = "center"; mapCtx.textBaseline = "middle";
          const tw = mapCtx.measureText(c.name).width + 12;
          mapCtx.fillStyle = "#0b1526";
          mapCtx.fillRect(X - tw / 2, ly - 8, tw, 16);
          mapCtx.fillStyle = "#dbe6f5";
          mapCtx.fillText(c.name, X, ly);
          hots.push({ key: k, x: X, y: Y, r: Math.max(w, h) / 2 + 8 });
        }
        S.mapHots = hots;
      }
      function moduleColorMap(kind) {
        return { lab: ["#dbe0ea", "#9aa6b8", "#727f92"], node: ["#c6d1e0", "#8695ab", "#5f6d80"],
                 airlock: ["#d0c4ad", "#9a8f79", "#6f6655"], module: ["#cfd8e4", "#8f9bb0", "#6b7688"] }[kind] || ["#cfd8e4", "#8f9bb0", "#6b7688"];
      }
      $("mapCanvas").addEventListener("pointerdown", (e) => {
        const r = mapCv.getBoundingClientRect();
        const px = e.clientX - r.left, py = e.clientY - r.top;
        let best = null, bd = 1e9;
        for (const h of S.mapHots) { const d = Math.hypot(px - h.x, py - h.y); if (d < h.r && d < bd) { bd = d; best = h.key; } }
        if (best) { $("mapScrim").classList.remove("show"); openModule(best); }
      });
      function openMap() { $("mapScrim").classList.add("show"); fitMap(); }

      /* =================================================================
         MICROGRAVITY DEMO
         ================================================================= */
      const mgCv = $("mgCanvas"), mgCtx = mgCv.getContext("2d");
      function fitMg() {
        const r = mgCv.getBoundingClientRect();
        mgCv.width = Math.round(r.width * DPR); mgCv.height = Math.round(260 * DPR);
        mgCtx.setTransform(DPR, 0, 0, DPR, 0, 0);
      }
      function mgResetObj() {
        S.mg.obj = { x: 0.5, y: 0.18, vx: 0, vy: 0, released: false };
        S.mg.trailG = []; S.mg.trailM = [];
        setMgCaption("The pen is floating near the ceiling. Press <b>Release object</b>.");
      }
      function setMgCaption(html) { $("mgCaption").innerHTML = html; }
      function mgStep(dt) {
        const o = S.mg.obj; if (!o) return;
        const W = mgCv.getBoundingClientRect().width, H = 260;
        if (o.released) {
          if (S.mg.mode === "gravity") {
            o.vy += 1.15 * dt;                 // falls, accelerating
            o.x += o.vx * dt; o.y += o.vy * dt;
            if (o.y > 0.9) { o.y = 0.9; o.vy *= -0.28; o.vx *= 0.6; if (Math.abs(o.vy) < 0.03) o.vy = 0; }
          } else {
            o.x += o.vx * dt; o.y += o.vy * dt; // drifts, constant speed
            if (o.x < 0.06 || o.x > 0.94) o.vx *= -1;
            if (o.y < 0.06 || o.y > 0.94) o.vy *= -1;
          }
          const trail = S.mg.mode === "gravity" ? S.mg.trailG : S.mg.trailM;
          trail.push([o.x, o.y]); if (trail.length > 120) trail.shift();
        }
        // draw
        mgCtx.clearRect(0, 0, W, H);
        mgCtx.fillStyle = "#04060d"; mgCtx.fillRect(0, 0, W, H);
        // room
        mgCtx.strokeStyle = "rgba(255,255,255,0.12)"; mgCtx.lineWidth = 2;
        mgCtx.strokeRect(10, 10, W - 20, H - 20);
        mgCtx.fillStyle = "rgba(255,255,255,0.04)";
        for (let x = 10; x < W - 10; x += 28) mgCtx.fillRect(x, 10, 1, H - 20);
        // floor label
        mgCtx.fillStyle = "rgba(255,255,255,0.25)"; mgCtx.font = "10px 'Roboto Mono', monospace";
        mgCtx.textAlign = "left"; mgCtx.fillText(S.mg.mode === "gravity" ? "floor" : "no floor — free float", 16, H - 16);

        // faint "other mode" path
        const other = S.mg.mode === "gravity" ? S.mg.trailM : S.mg.trailG;
        if (other.length > 2) {
          mgCtx.strokeStyle = "rgba(255,255,255,0.12)"; mgCtx.setLineDash([3, 4]); mgCtx.lineWidth = 1.5;
          mgCtx.beginPath();
          other.forEach(([px, py], i) => { const X = 10 + px * (W - 20), Y = 10 + py * (H - 20); i ? mgCtx.lineTo(X, Y) : mgCtx.moveTo(X, Y); });
          mgCtx.stroke(); mgCtx.setLineDash([]);
        }
        // live trail
        const trail = S.mg.mode === "gravity" ? S.mg.trailG : S.mg.trailM;
        if (trail.length > 2) {
          mgCtx.strokeStyle = S.mg.mode === "gravity" ? "rgba(255,93,162,0.7)" : "rgba(0,242,254,0.7)";
          mgCtx.lineWidth = 2; mgCtx.beginPath();
          trail.forEach(([px, py], i) => { const X = 10 + px * (W - 20), Y = 10 + py * (H - 20); i ? mgCtx.lineTo(X, Y) : mgCtx.moveTo(X, Y); });
          mgCtx.stroke();
        }
        // object (a pen)
        const X = 10 + o.x * (W - 20), Y = 10 + o.y * (H - 20);
        mgCtx.save(); mgCtx.translate(X, Y); mgCtx.rotate(o.released && S.mg.mode === "micro" ? performance.now() / 700 : 0.5);
        mgCtx.fillStyle = "#fbbf24"; rrp(mgCtx, -3, -14, 6, 24, 2); mgCtx.fill();
        mgCtx.fillStyle = "#1a2233"; mgCtx.fillRect(-3, 8, 6, 4);
        mgCtx.restore();
        // hand at start
        if (!o.released) { mgCtx.fillStyle = "#e9edf4"; mgCtx.font = "20px system-ui"; mgCtx.textAlign = "center"; mgCtx.fillText("\u{1F91A}", X, Y + 26); }
      }

      /* ================= HELPERS ================= */
      function rr(x, y, w, h, r) {
        ctx.beginPath();
        ctx.moveTo(x + r, y);
        ctx.arcTo(x + w, y, x + w, y + h, r);
        ctx.arcTo(x + w, y + h, x, y + h, r);
        ctx.arcTo(x, y + h, x, y, r);
        ctx.arcTo(x, y, x + w, y, r);
        ctx.closePath();
      }
      function rrp(c, x, y, w, h, r) {
        c.beginPath();
        c.moveTo(x + r, y);
        c.arcTo(x + w, y, x + w, y + h, r);
        c.arcTo(x + w, y + h, x, y + h, r);
        c.arcTo(x, y + h, x, y, r);
        c.arcTo(x, y, x + w, y, r);
        c.closePath();
      }

      /* ================= PANEL / TRAY ================= */
      const CCODE = { Russia: "RUS", USA: "USA", Europe: "ESA", Japan: "JPN", Canada: "CAN" };
      function buildTray() {
        const tray = $("tray");
        tray.innerHTML = "";
        for (const key of ORDER) {
          const c = COMP[key];
          const code = CCODE[c.country] || "";
          const card = document.createElement("div");
          card.className = "tcard";
          card.dataset.key = key;
          card.innerHTML =
            '<span class="ccode ' + code + '">' + code + "</span>" +
            '<span class="tinfo"><b>' + c.name + "</b>" +
            "<small>" + labelKind(c.kind) + " · " + c.country + "</small>" +
            '<span class="fn">' + c.fn + "</span></span>";
          tray.appendChild(card);
        }
        refreshTray();
      }
      function labelKind(k) {
        return { module: "Module", node: "Connecting node", lab: "Research lab", airlock: "Airlock",
                 truss: "Truss backbone", array: "Solar arrays", arm: "Robot arm" }[k] || "Component";
      }
      function refreshTray() {
        const valid = new Set(validNext());
        for (const card of $("tray").children) {
          const k = card.dataset.key;
          card.classList.toggle("placed", S.placed.has(k));
          card.classList.toggle("locked", !S.placed.has(k) && !valid.has(k));
          card.classList.toggle("armed", S.armed === k);
        }
        const n = S.placed.size;
        $("progText").textContent = n + " / " + TOTAL;
        $("progFill").style.width = (100 * n / TOTAL) + "%";
        $("progCap").textContent = n >= TOTAL
          ? "All parts placed — ready for orbit!"
          : "Glowing dots show where the next parts can attach.";
        $("goLiveBtn").disabled = n < TOTAL;
      }

      function placeComponent(key) {
        if (S.placed.has(key)) return;
        const valid = validNext();
        if (!valid.includes(key)) return;
        S.placed.add(key);
        S.armed = null;
        S.snap = { key, t: 0 };
        refreshTray();
      }

      function showPane(which) {
        $("buildPane").classList.toggle("on", which === "build");
        $("livePane").classList.toggle("on", which === "live");
        $("modPane").classList.toggle("on", which === "mod");
      }

      function goLive() {
        S.mode = "live";
        S.openMod = null;
        $("phaseTag").textContent = "Live Mode";
        $("phaseTag").classList.add("live");
        $("hintbar").innerHTML = "Watch the solar wings turn to the Sun and the power dip in Earth's shadow. <b>Tap a module</b> to look inside.";
        showPane("live");
      }
      function backToBuild() {
        S.mode = "build"; S.openMod = null;
        $("phaseTag").textContent = "Build Mode";
        $("phaseTag").classList.remove("live");
        $("hintbar").innerHTML = "Pick a part on the right, then drop it on a <b>glowing dot</b>. Drag the empty space to spin the view.";
        showPane("build");
      }

      /* ================= EVENTS ================= */
      const ghost = $("dragGhost");
      function evPos(e) {
        const r = cv.getBoundingClientRect();
        return { x: e.clientX - r.left, y: e.clientY - r.top };
      }

      // tray: pointer down starts drag / arm
      $("tray").addEventListener("pointerdown", (e) => {
        const card = e.target.closest(".tcard");
        if (!card || card.classList.contains("locked") || card.classList.contains("placed")) return;
        const key = card.dataset.key;
        S.drag = { key, x: e.clientX, y: e.clientY, moved: false, card };
        S.armed = key;
        card.setPointerCapture(e.pointerId);
        refreshTray();
        renderGhost(e.clientX, e.clientY);
      });
      $("tray").addEventListener("pointermove", (e) => {
        if (!S.drag) return;
        if (Math.hypot(e.clientX - S.drag.x, e.clientY - S.drag.y) > 5) {
          S.drag.moved = true;
          S.drag.card.classList.add("dragging");
        }
        renderGhost(e.clientX, e.clientY);
      });
      $("tray").addEventListener("pointerup", (e) => {
        if (!S.drag) return;
        const d = S.drag; S.drag = null;
        d.card.classList.remove("dragging");
        ghost.style.display = "none";
        // dropped over the canvas near the point? OR just a tap? -> place
        const r = cv.getBoundingClientRect();
        const overCanvas = e.clientX >= r.left && e.clientX <= r.right && e.clientY >= r.top && e.clientY <= r.bottom;
        const p = connectionPoint(d.key);
        const near = overCanvas && Math.hypot(e.clientX - r.left - p.X, e.clientY - r.top - p.Y) < 110;
        if (!d.moved || near) placeComponent(d.key);
        else refreshTray();
      });
      function renderGhost(x, y) {
        if (!S.drag) return;
        ghost.style.display = "block";
        ghost.style.left = (x + 14) + "px";
        ghost.style.top = (y - 10) + "px";
        const code = CCODE[COMP[S.drag.key].country] || "";
        const gc = ghost.querySelector(".gcode");
        gc.textContent = code; gc.className = "ccode gcode " + code;
        ghost.querySelector(".gname").textContent = COMP[S.drag.key].name;
      }

      // canvas: rotate in build, drop target, click modules in live
      cv.addEventListener("pointerdown", (e) => {
        if (S.mode === "build") {
          if (S.armed) {
            const p = connectionPoint(S.armed), q = evPos(e);
            if (Math.hypot(q.x - p.X, q.y - p.Y) < 120) { placeComponent(S.armed); return; }
          }
          S.rotating = true; S._lastX = e.clientX;
          cv.setPointerCapture(e.pointerId);
        } else if (S.mode === "live") {
          // tapping anywhere near the orbiting station opens the station map
          const q = evPos(e);
          const G = earthGeom();
          const stx = G.cx + Math.cos(S.orbit) * G.orbitR;
          const sty = G.cy + Math.sin(S.orbit) * G.orbitR;
          if (Math.hypot(q.x - stx, q.y - sty) < Math.max(CW, CH) * 0.09) openMap();
        }
      });
      cv.addEventListener("pointermove", (e) => {
        if (S.rotating) {
          S.yaw += (e.clientX - S._lastX) * 0.006;
          S.yaw = Math.max(-0.5, Math.min(0.5, S.yaw));
          S._lastX = e.clientX;
        }
      });
      cv.addEventListener("pointerup", () => { S.rotating = false; });
      cv.addEventListener("pointerleave", () => { S.rotating = false; });

      $("goLiveBtn").addEventListener("click", goLive);
      $("backBuildBtn").addEventListener("click", backToBuild);
      $("modBack").addEventListener("click", () => { S.openMod = null; showPane("live"); });

      // partners
      function fillPartners() {
        $("partnerList").innerHTML = PARTNERS.map((p) =>
          '<div class="partner"><span class="pf">' + p.flag + "</span><div><b>" + p.name +
          "</b><small>" + p.sub + '</small><div class="pp">' + p.gave + "</div></div></div>"
        ).join("");
      }
      $("partnersBtn").addEventListener("click", () => { fillPartners(); $("partnerScrim").classList.add("show"); });
      $("mapBtn").addEventListener("click", openMap);

      // microgravity
      $("mgOpenBtn").addEventListener("click", () => {
        $("mgScrim").classList.add("show");
        fitMg(); mgResetObj();
        S.mg.mode = "micro"; $("mgMicro").classList.add("on"); $("mgGrav").classList.remove("on");
      });
      $("mgGrav").addEventListener("click", () => { S.mg.mode = "gravity"; $("mgGrav").classList.add("on"); $("mgMicro").classList.remove("on"); mgSwitchCaption(); });
      $("mgMicro").addEventListener("click", () => { S.mg.mode = "micro"; $("mgMicro").classList.add("on"); $("mgGrav").classList.remove("on"); mgSwitchCaption(); });
      function mgSwitchCaption() {
        if (!S.mg.obj || !S.mg.obj.released) {
          setMgCaption(S.mg.mode === "gravity"
            ? "<b>Gravity</b> is on. Released, the pen will fall straight down and land on the floor."
            : "<b>Microgravity</b>. Released, the pen just drifts — slow and straight, forever.");
        }
      }
      $("mgRelease").addEventListener("click", () => {
        if (!S.mg.obj) mgResetObj();
        const o = S.mg.obj;
        o.released = true;
        if (S.mg.mode === "gravity") {
          o.vx = (Math.random() - 0.5) * 0.06; o.vy = 0;
          setMgCaption("<b>Gravity:</b> the pen accelerates downward and hits the floor — like on Earth.");
        } else {
          const ang = Math.random() * Math.PI * 2;
          o.vx = Math.cos(ang) * 0.12; o.vy = Math.sin(ang) * 0.12;
          setMgCaption("<b>Microgravity:</b> the pen keeps the tiny push you gave it and drifts in a straight line. Nothing pulls it to a floor.");
        }
      });
      $("mgReset").addEventListener("click", () => { fitMg(); mgResetObj(); });
      document.querySelectorAll("[data-close]").forEach((b) =>
        b.addEventListener("click", () => b.closest(".scrim").classList.remove("show")));
      document.querySelectorAll(".scrim").forEach((sc) =>
        sc.addEventListener("click", (e) => { if (e.target === sc) sc.classList.remove("show"); }));

      /* ================= LOOP ================= */
      let last = performance.now();
      function loop(now) {
        const dt = Math.min(0.05, (now - last) / 1000); last = now;

        if (S.snap) { S.snap.t += dt * 4; if (S.snap.t >= 1) S.snap = null; }

        if (S.mode === "build") {
          drawBuild();
        } else {
          // one orbit in ~78 s
          S.orbit += dt * (Math.PI * 2) / 78;
          S.earthSpin += dt * 0.05;
          S.modT += dt;
          drawLive();
          // power / battery
          const shadow = stationInShadow();
          const gen = shadow ? 0 : 84 + Math.sin(now / 900) * 3;
          const load = 32;
          S._batt = (S._batt == null ? 100 : S._batt) + (gen - load) * dt * 0.10;
          S._batt = Math.max(24, Math.min(100, S._batt));
          $("powerVal").innerHTML = Math.round(gen) + ' <small>kW</small>';
          $("powerMeter").style.width = (gen / 90 * 100) + "%";
          $("powerMeter").style.background = shadow ? "var(--blue)" : "var(--amber)";
          $("battVal").innerHTML = Math.round(S._batt) + "<small>%</small>";
          $("battMeter").style.width = S._batt + "%";
          $("battMeter").style.background = S._batt > 55 ? "var(--green)" : S._batt > 35 ? "var(--amber)" : "var(--pink)";
          const ss = $("sunState");
          ss.className = "sunstate " + (shadow ? "shadow" : "sun");
          ss.innerHTML = shadow ? "<span>\u{1F311}</span><span>In Earth's shadow — running on battery</span>"
                                : "<span>☀</span><span>In sunlight — making power</span>";
        }

        if (S.openMod && $("modPane").classList.contains("on")) drawAstro(COMP[S.openMod].activity, S.modT);
        if ($("mapScrim").classList.contains("show")) drawMap();
        if ($("mgScrim").classList.contains("show")) mgStep(dt);

        requestAnimationFrame(loop);
      }

      /* ================= BOOT ================= */
      fit();
      buildTray();
      showPane("build");
      requestAnimationFrame(loop);
    </script>
  </body>
</html>
